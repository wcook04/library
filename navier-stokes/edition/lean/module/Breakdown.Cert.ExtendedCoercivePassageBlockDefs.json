"Breakdown.CoerciveWeak.Internal.PieceDensityPassageWeak.pieceBlockWith_eq","namespace":"Breakdown.CoerciveWeak.Internal.PieceDensityPassageWeak","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CoerciveWeak.Internal.PieceDensityPassageWeak.block_lower_negative_finite","Breakdown.CoerciveWeak.Internal.PieceDensityPassageWeak.split_lower_iff"],"proof_uses":["Breakdown.Coercive.pieceNorm","Breakdown.Coercive.velAmp","Breakdown.Coercive.vortAmp","Breakdown.CoerciveWeak.Internal.PieceDensityPassageWeak.vortGradSupWith_zero","Breakdown.CoerciveWeak.pieceEpsBlockWith","Breakdown.PieceWeights.epsP"],"protected":false,"short":"pieceBlockWith_eq","signature_end_line":47,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CoerciveWeak.Internal.PieceDensityPassageWeak.blockGain","Breakdown.CoerciveWeak.pieceBlockWith","Breakdown.CoerciveWeak.vortGradSupWith","Breakdown.PieceWeights","Breakdown.Space"],"used_by":["Breakdown.CoerciveWeak.Internal.PieceDensityPassageWeak.block_lower_negative_finite","Breakdown.CoerciveWeak.Internal.PieceDensityPassageWeak.split_lower_iff"],"uses":["Breakdown.Coercive.pieceNorm","Breakdown.Coercive.velAmp","Breakdown.Coercive.vortAmp","Breakdown.CoerciveWeak.Internal.PieceDensityPassageWeak.blockGain","Breakdown.CoerciveWeak.Internal.PieceDensityPassageWeak.vortGradSupWith_zero","Breakdown.CoerciveWeak.pieceBlockWith","Breakdown.CoerciveWeak.pieceEpsBlockWith","Breakdown.CoerciveWeak.vortGradSupWith","Breakdown.PieceWeights","Breakdown.PieceWeights.epsP","Breakdown.Space"],"written":"pieceBlockWith_eq"}],"imports":["Breakdown.Cert.ExtendedCoerciveMinorant"],"module":"Breakdown.Cert.ExtendedCoercivePassageBlockDefs","path":"Breakdown/Cert/ExtendedCoercivePassageBlockDefs.lean","sha256":"dc0294793d3a7efc7a426504e7f0ff0398ce8fd2d2697d03c44ce0c3bf4269ca","source":"import Breakdown.Cert.ExtendedCoerciveMinorant\n\nopen scoped ContDiff ENNReal Topology\nopen MeasureTheory Filter\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace CoerciveWeak\n\nopen PieceWeights\n\nnamespace Internal.PieceDensityPassageWeak\n\nopen Internal.Minorant\n\nsection Block\n\nvariable {C : Type} {nE nM : ℕ} (m : PieceWeights C nE nM)\n\ndef blockGain (v : ℝ → Space → Space) (G : ℝ → Space → (Space →L[ℝ] Space)) (σ : ℝ) (y : Space) : ℝ :=\n  ∑ β : Fin nE, (m.epsP β).wt y * Coercive.pieceNorm (m.epsP β).modes (fun κ => Coercive.velAmp v κ σ y)\n    * Coercive.pieceNorm (m.epsP β).modes (fun κ => Coercive.vortAmp G κ σ y)\n\ndef pieceBlockLower (W : ℝ → Space → Space) (HW : ℝ → Space → (Space →L[ℝ] Space →L[ℝ] Space))\n    (v : ℝ → Space → Space) (G : ℝ → Space → (Space →L[ℝ] Space))\n    (H : ℝ → Space → (Space →L[ℝ] Space →L[ℝ] Space)) (σ : ℝ) (y : Space) : ℝ :=\n  pieceBlockWith m W 0 v G H σ y - vortGradSupLower HW y * blockGain m v G σ y\n\ntheorem vortGradSupWith_zero (y : Space) :\n    vortGradSupWith (0 : ℝ → Space → (Space →L[ℝ] Space →L[ℝ] Space)) y = 0 := by\n  have hz : ∀ p : ℝ × ℝ, ‖vortGradMap ((0 : ℝ → Space → (Space →L[ℝ] Space →L[ℝ] Space)) p.1\n      (axialRot p.2 y))‖ = 0 := fun p => by\n    simp [vortGradMap, vortGrad]\n  unfold vortGradSupWith\n  simp only [hz, ciSup_const]\n\ntheorem blockGain_nonneg (hE : ∀ β y, 0 ≤ (m.epsP β).wt y) (v : ℝ → Space → Space)\n    (G : ℝ → Space → (Space →L[ℝ] Space)) (σ : ℝ) (y : Space) : 0 ≤ blockGain m v G σ y :=\n  Finset.sum_nonneg fun β _ => mul_nonneg (mul_nonneg (hE β y) (Real.sqrt_nonneg _)) (Real.sqrt_nonneg _)\n\ntheorem pieceBlockWith_eq (W : ℝ → Space → Space) (HW : ℝ → Space → (Space →L[ℝ] Space →L[ℝ] Space))\n    (v : ℝ → Space → Space) (G : ℝ → Space → (Space →L[ℝ] Space))\n    (H : ℝ → Space → (Space →L[ℝ] Space →L[ℝ] Space)) (σ : ℝ) (y : Space) :\n    pieceBlockWith m W HW v G H σ y\n      = -(-pieceBlockWith m W 0 v G H σ y + vortGradSupWith HW y * blockGain m v G σ y) := by\n  have e : ∀ β, pieceEpsBlockWith m W HW v G H β σ y = pieceEpsBlockWith m W 0 v G H β σ y\n      - vortGradSupWith HW y * ((m.epsP β).wt y\n        * Coercive.pieceNorm (m.epsP β).modes (fun κ => Coercive.velAmp v κ σ y)\n        * Coercive.pieceNorm (m.epsP β).modes (fun κ => Coercive.vortAmp G κ σ y)) := by\n    intro β\n    unfold pieceEpsBlockWith\n    rw [vortGradSupWith_zero]\n    ring\n  unfold pieceBlockWith blockGain\n  rw [Finset.sum_congr rfl fun β _ => e β, Finset.sum_sub_distrib, Finset.mul_sum]\n  ring\n\nend Block\n\nend Internal.PieceDensityPassageWeak\n\nend CoerciveWeak\n\nend Breakdown\n"}