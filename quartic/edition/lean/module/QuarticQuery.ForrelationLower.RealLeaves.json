ed":false,"short":"linear_bound","signature_end_line":164,"statement_used_by":[],"statement_uses":["QuarticQuery.BitInput","QuarticQuery.ForrelationLower.RealQueryTree","QuarticQuery.ForrelationLower.RealQueryTree.Bounded","QuarticQuery.ForrelationLower.RealQueryTree.answerSign","QuarticQuery.ForrelationLower.RealQueryTree.depth","QuarticQuery.ForrelationLower.RealQueryTree.eval","QuarticQuery.QueryTree","QuarticQuery.QueryTree.depth","QuarticQuery.QueryTree.eval"],"used_by":["QuarticQuery.ForrelationLower.advantage_le_sharp_real_leaves"],"uses":["QuarticQuery.BitInput","QuarticQuery.ForrelationLower.RealQueryTree","QuarticQuery.ForrelationLower.RealQueryTree.Bounded","QuarticQuery.ForrelationLower.RealQueryTree.Labels","QuarticQuery.ForrelationLower.RealQueryTree.answerSign","QuarticQuery.ForrelationLower.RealQueryTree.booleanTree","QuarticQuery.ForrelationLower.RealQueryTree.booleanTree_depth","QuarticQuery.ForrelationLower.RealQueryTree.depth","QuarticQuery.ForrelationLower.RealQueryTree.eval","QuarticQuery.ForrelationLower.RealQueryTree.eval_eq_convex_sum","QuarticQuery.ForrelationLower.RealQueryTree.labelsFintype","QuarticQuery.ForrelationLower.RealQueryTree.sum_weight","QuarticQuery.ForrelationLower.RealQueryTree.weight","QuarticQuery.ForrelationLower.RealQueryTree.weight_nonneg","QuarticQuery.QueryTree","QuarticQuery.QueryTree.depth","QuarticQuery.QueryTree.eval"],"uses_modules":{"QuarticQuery.BitInput":"QuarticQuery.Statement","QuarticQuery.QueryTree":"QuarticQuery.Statement"},"written":"linear_bound"},{"dependency_source":"lean_report","doc":"The same extension for a finite sum of absolute linear functionals.\nThis form transfers the derivative-growth estimate without a loss.","end_line":216,"kind":"theorem","line":186,"module":"QuarticQuery.ForrelationLower.RealLeaves","name":"QuarticQuery.ForrelationLower.RealQueryTree.sum_linear_bound","namespace":"QuarticQuery.ForrelationLower.RealQueryTree","noncomputable":false,"private":false,"proof_used_by":["QuarticQuery.ForrelationLower.sum_abs_ext_Dl_le_real_leaves"],"proof_uses":["QuarticQuery.ForrelationLower.RealQueryTree.Labels","QuarticQuery.ForrelationLower.RealQueryTree.booleanTree","QuarticQuery.ForrelationLower.RealQueryTree.booleanTree_depth","QuarticQuery.ForrelationLower.RealQueryTree.eval_eq_convex_sum","QuarticQuery.ForrelationLower.RealQueryTree.labelsFintype","QuarticQuery.ForrelationLower.RealQueryTree.sum_weight","QuarticQuery.ForrelationLower.RealQueryTree.weight","QuarticQuery.ForrelationLower.RealQueryTree.weight_nonneg"],"protected":false,"short":"sum_linear_bound","signature_end_line":191,"statement_used_by":[],"statement_uses":["QuarticQuery.BitInput","QuarticQuery.ForrelationLower.RealQueryTree","QuarticQuery.ForrelationLower.RealQueryTree.Bounded","QuarticQuery.ForrelationLower.RealQueryTree.answerSign","QuarticQuery.ForrelationLower.RealQueryTree.depth","QuarticQuery.ForrelationLower.RealQueryTree.eval","QuarticQuery.QueryTree","QuarticQuery.QueryTree.depth","QuarticQuery.QueryTree.eval"],"used_by":["QuarticQuery.ForrelationLower.sum_abs_ext_Dl_le_real_leaves"],"uses":["QuarticQuery.BitInput","QuarticQuery.ForrelationLower.RealQueryTree","QuarticQuery.ForrelationLower.RealQueryTree.Bounded","QuarticQuery.ForrelationLower.RealQueryTree.Labels","QuarticQuery.ForrelationLower.RealQueryTree.answerSign","QuarticQuery.ForrelationLower.RealQueryTree.booleanTree","QuarticQuery.ForrelationLower.RealQueryTree.booleanTree_depth","QuarticQuery.ForrelationLower.RealQueryTree.depth","QuarticQuery.ForrelationLower.RealQueryTree.eval","QuarticQuery.ForrelationLower.RealQueryTree.eval_eq_convex_sum","QuarticQuery.ForrelationLower.RealQueryTree.labelsFintype","QuarticQuery.ForrelationLower.RealQueryTree.sum_weight","QuarticQuery.ForrelationLower.RealQueryTree.weight","QuarticQuery.ForrelationLower.RealQueryTree.weight_nonneg","QuarticQuery.QueryTree","QuarticQuery.QueryTree.depth","QuarticQuery.QueryTree.eval"],"uses_modules":{"QuarticQuery.BitInput":"QuarticQuery.Statement","QuarticQuery.QueryTree":"QuarticQuery.Statement"},"written":"sum_linear_bound"}],"imports":["QuarticQuery.ForrelationLower.Cube"],"module":"QuarticQuery.ForrelationLower.RealLeaves","path":"QuarticQuery/ForrelationLower/RealLeaves.lean","sha256":"6f0afa1d02da6adeb5e1589013382a531cc1a110fabc64e856cb19f624666ec8","source":"module\n\npublic import QuarticQuery.ForrelationLower.Cube\n\n/-!\n# Independently specified real-valued decision trees\n\nThe maintained Boolean `QueryTree` followed by `v : Bool → ℝ` permits only\ntwo output values.  A real-valued tree can have a different value at every\nleaf.  The independent syntax below describes that larger class directly.\n\nEvery tree with leaf values in `[-1,1]` is an input-independent finite\nconvex combination of Boolean sign trees of exactly the same syntactic\ndepth.  Sampling all leaf labels in advance is essential: the mixture\ndoes not depend on the queried input or on the leaf eventually reached.\n\nZero weights are permitted here, so this is a convex representation,\nnot a value of `RandomizedProgram`, whose support weights are positive.\n-/\n\n@[expose] public section\nset_option autoImplicit false\n\nopen Finset\n\nnamespace QuarticQuery.ForrelationLower\n\ninductive RealQueryTree (ι : Type) where\n  | leaf (value : ℝ)\n  | query (index : ι) (onFalse onTrue : RealQueryTree ι)\n\nnamespace RealQueryTree\n\nvariable {ι : Type}\n\ndef eval : RealQueryTree ι → BitInput ι → ℝ\n  | .leaf a, _ => a\n  | .query i l r, x => if x i then r.eval x else l.eval x\n\ndef depth : RealQueryTree ι → ℕ\n  | .leaf _ => 0\n  | .query _ l r => 1 + max l.depth r.depth\n\ndef Bounded : RealQueryTree ι → Prop\n  | .leaf a => |a| ≤ 1\n  | .query _ l r => l.Bounded ∧ r.Bounded\n\n/-- A label is assigned to every syntactic leaf, including unreachable ones. -/\ndef Labels : RealQueryTree ι → Type\n  | .leaf _ => Bool\n  | .query _ l r => l.Labels × r.Labels\n\ninstance labelsFintype (T : RealQueryTree ι) : Fintype T.Labels :=\n  match T with\n  | .leaf _ => inferInstanceAs (Fintype Bool)\n  | .query _ l r =>\n      letI := labelsFintype l\n      letI := labelsFintype r\n      inferInstanceAs (Fintype (l.Labels × r.Labels))\n\n/-- This uses the sign convention of the independently specified output;\n`false` has value `+1`, and `true` has value `-1`. -/\ndef answerSign (b : Bool) : ℝ := if b then -1 else 1\n\n@[simp] theorem abs_answerSign (b : Bool) : |answerSign b| = 1 := by\n  cases b <;> norm_num [answerSign]\n\nnoncomputable def weight : (T : RealQueryTree ι) → T.Labels → ℝ\n  | .leaf a, b => (1 + a * answerSign b) / 2\n  | .query _ l r, b => l.weight b.1 * r.weight b.2\n\ndef booleanTree : (T : RealQueryTree ι) → T.Labels → QueryTree ι\n  | .leaf _, b => .leaf b\n  | .query i l r, b => .query i (l.booleanTree b.1) (r.booleanTree b.2)\n\ntheorem booleanTree_depth (T : RealQueryTree ι) (b : T.Labels) :\n    (T.booleanTree b).depth = T.depth := by\n  induction T with\n  | leaf a => rfl\n  | query i l r ihl ihr =>\n      simp only [booleanTree, QueryTree.depth, depth, ihl, ihr]\n\ntheorem weight_nonneg (T : RealQueryTree ι) (hT : T.Bounded) (b : T.Labels) :\n    0 ≤ T.weight b := by\n  induction T with\n  | leaf a =>\n      have ha := abs_le.mp hT\n      cases b <;> simp only [weight, answerSign] <;> norm_num <;> linarith\n  | query i l r ihl ihr =>\n      exact mul_nonneg (ihl hT.1 b.1) (ihr hT.2 b.2)\n\n/-- Normalization holds algebraically even for unbounded leaf labels. -/\ntheorem sum_weight (T : RealQueryTree ι) : ∑ b : T.Labels, T.weight b = 1 := by\n  induction T with\n  | leaf a =>\n      change (∑ b : Bool, (1 + a * answerSign b) / 2) = 1\n      simp only [Fintype.sum_bool, answerSign]\n      norm_num\n      ring\n  | query i l r ihl ihr =>\n      change (∑ b : l.Labels × r.Labels, l.weight b.1 * r.weight b.2) = 1\n      rw [Fintype.sum_prod_type]\n      simp only [← mul_sum, ihr, mul_one, ihl]\n\n/-- The all-input identity. Both the index set and every weight are fixed\nbefore the input is quantified.  This is stronger than pointwise existence\nof a convenient mixture after observing the input. -/\ntheorem eval_eq_convex_sum (T : RealQueryTree ι) (x : BitInput ι) :\n    T.eval x = ∑ b : T.Labels,\n      T.weight b * answerSign ((T.booleanTree b).eval x) := by\n  induction T with\n  | leaf a =>\n      change a = ∑ b : Bool, (1 + a * answerSign b) / 2 * answerSign b\n      simp only [Fintype.sum_bool, answerSign]\n      norm_num\n      ring\n  | query i l r ihl ihr =>\n      change (if x i then r.eval x else l.eval x) =\n        ∑ b : l.Labels × r.Labels,\n          l.weight b.1 * r.weight b.2 *\n            answerSign (if x i then (r.booleanTree b.2).eval x\n              else (l.booleanTree b.1).eval x)\n      rw [Fintype.sum_prod_type]\n      cases h : x i\n      · simp only [Bool.false_eq_true, ↓reduceIte]\n        calc\n          l.eval x = ∑ b : l.Labels, l.weight b *\n              answerSign ((l.booleanTree b).eval x) := ihl\n          _ = _ := by\n            apply sum_congr rfl\n            intro b _\n            rw [show (∑ c : r.Labels,\n                l.weight b * r.weight c * answerSign ((l.booleanTree b).eval x)) =\n                (l.weight b * answerSign ((l.booleanTree b).eval x)) *\n                  ∑ c : r.Labels, r.weight c by\n                rw [mul_sum]\n                apply sum_congr rfl\n                intro c _\n                ring, sum_weight, mul_one]\n      · simp only [↓reduceIte]\n        calc\n          r.eval x = ∑ c : r.Labels, r.weight c *\n              answerSign ((r.booleanTree c).eval x) := ihr\n          _ = _ := by\n            simp_rw [mul_assoc, ← mul_sum]\n            rw [← sum_mul, sum_weight, one_mul]\n\ntheorem abs_eval_le_one (T : RealQueryTree ι) (hT : T.Bounded) (x : BitInput ι) :\n    |T.eval x| ≤ 1 := by\n  induction T with\n  | leaf a => exact hT\n  | query i l r ihl ihr =>\n      simp only [eval]\n      split\n      · exact ihr hT.2\n      · exact ihl hT.1\n\n/-- Transfer any uniform bound for a real linear functional, without a loss\nin the bound or an extra query. -/\ntheorem linear_bound (T : RealQueryTree ι) (hT : T.Bounded)\n    (F : ((BitInput ι) → ℝ) →ₗ[ℝ] ℝ) {B : ℝ}\n    (hB : ∀ S : QueryTree ι, S.depth ≤ T.depth →\n      |F (fun x => answerSign (S.eval x))| ≤ B) :\n    |F T.eval| ≤ B := by\n  classical\n  have he : T.eval = ∑ b : T.Labels,\n      T.weight b • (fun x => answerSign ((T.booleanTree b).eval x)) := by\n    funext x\n    simpa only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul] using T.eval_eq_convex_sum x\n  rw [he, map_sum]\n  calc\n    |∑ b : T.Labels, F (T.weight b • (fun x => answerSign ((T.booleanTree b).eval x)))|\n        ≤ ∑ b : T.Labels,\n          |F (T.weight b • (fun x => answerSign ((T.booleanTree b).eval x)))| :=\n      abs_sum_le_sum_abs _ _\n    _ ≤ ∑ b : T.Labels, T.weight b * B := by\n      apply sum_le_sum\n      intro b _\n      rw [map_smul, smul_eq_mul, abs_mul, abs_of_nonneg (T.weight_nonneg hT b)]\n      exact mul_le_mul_of_nonneg_left\n        (hB (T.booleanTree b) (by rw [T.booleanTree_depth b])) (T.weight_nonneg hT b)\n    _ = B := by rw [← sum_mul, sum_weight, one_mul]\n\n/-- The same extension for a finite sum of absolute linear functionals.\nThis form transfers the derivative-growth estimate without a loss. -/\ntheorem sum_linear_bound {P : Type} [Fintype P]\n    (T : RealQueryTree ι) (hT : T.Bounded)\n    (F : P → ((BitInput ι) → ℝ) →ₗ[ℝ] ℝ) {B : ℝ}\n    (hB : ∀ S : QueryTree ι, S.depth ≤ T.depth →\n      (∑ p, |F p (fun x => answerSign (S.eval x))|) ≤ B) :\n    (∑ p, |F p T.eval|) ≤ B := by\n  classical\n  have he : T.eval = ∑ b : T.Labels,\n      T.weight b • (fun x => answerSign ((T.booleanTree b).eval x)) := by\n    funext x\n    simpa only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul] using T.eval_eq_convex_sum x\n  calc\n    (∑ p, |F p T.eval|) ≤ ∑ p, ∑ b : T.Labels,\n        T.weight b * |F p (fun x => answerSign ((T.booleanTree b).eval x))| := by\n      apply sum_le_sum\n      intro p _\n      rw [he, map_sum]\n      refine (abs_sum_le_sum_abs _ _).trans ?_\n      apply sum_le_sum\n      intro b _\n      rw [map_smul, smul_eq_mul, abs_mul, abs_of_nonneg (T.weight_nonneg hT b)]\n    _ = ∑ b : T.Labels, T.weight b *\n        ∑ p, |F p (fun x => answerSign ((T.booleanTree b).eval x))| := by\n      rw [sum_comm]\n      simp only [mul_sum]\n    _ ≤ ∑ b : T.Labels, T.weight b * B := by\n      apply sum_le_sum\n      intro b _\n      exact mul_le_mul_of_nonneg_left\n        (hB (T.booleanTree b) (by rw [T.booleanTree_depth b])) (T.weight_nonneg hT b)\n    _ = B := by rw [← sum_mul, sum_weight, one_mul]\n\nend RealQueryTree\nend QuarticQuery.ForrelationLower\n"}