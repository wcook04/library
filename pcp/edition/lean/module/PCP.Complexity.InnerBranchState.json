rivate":false,"protected":false,"short":"prepareHad","signature_end_line":66,"used_by":["PCP.Lang.InnerBranch.hadamard","PCP.Lang.InnerBranch.hadamard_cost","PCP.Lang.InnerBranch.hadamard_list","PCP.Lang.InnerBranch.hadamard_run","PCP.Lang.InnerBranch.prepareHad_cost","PCP.Lang.InnerBranch.prepareHad_histories","PCP.Lang.InnerBranch.prepareHad_payload","PCP.Lang.InnerBranch.prepareHad_sources"],"uses":["PCP.Lang.Stmt"],"written":"prepareHad"},{"dependency_source":"source_text","doc":null,"end_line":70,"kind":"def","line":69,"module":"PCP.Complexity.InnerBranchState","name":"PCP.Lang.InnerBranch.hadamard","namespace":"PCP.Lang.InnerBranch","noncomputable":false,"private":false,"protected":false,"short":"hadamard","signature_end_line":69,"used_by":["PCP.Lang.InnerBranch.hadamard_cost","PCP.Lang.InnerBranch.hadamard_list","PCP.Lang.InnerBranch.hadamard_run","PCP.Lang.InnerBranch.program","PCP.Lang.InnerBranch.program_cost"],"uses":["PCP.Lang.InnerBranch.hadCall","PCP.Lang.InnerBranch.prepareHad","PCP.Lang.Stmt"],"written":"hadamard"},{"dependency_source":"source_text","doc":null,"end_line":73,"kind":"def","line":72,"module":"PCP.Complexity.InnerBranchState","name":"PCP.Lang.InnerBranch.interpolate","namespace":"PCP.Lang.InnerBranch","noncomputable":false,"private":false,"protected":false,"short":"interpolate","signature_end_line":72,"used_by":["PCP.Lang.InnerBranch.interpolate_cost","PCP.Lang.InnerBranch.interpolate_list","PCP.Lang.InnerBranch.interpolate_run","PCP.Lang.InnerBranch.program","PCP.Lang.InnerBranch.program_cost"],"uses":["PCP.Lang.InnerBranch.interpCall","PCP.Lang.Stmt"],"written":"interpolate"},{"dependency_source":"source_text","doc":"The sole branch choice is the actual Boolean sampler coin.","end_line":76,"kind":"def","line":76,"module":"PCP.Complexity.InnerBranchState","name":"PCP.Lang.InnerBranch.program","namespace":"PCP.Lang.InnerBranch","noncomputable":false,"private":false,"protected":false,"short":"program","signature_end_line":76,"used_by":["PCP.Lang.InnerBranch.program_cost","PCP.Lang.InnerBranch.program_history","PCP.Lang.InnerBranch.program_list","PCP.Lang.InnerBranch.program_run","PCP.Lang.OuterBranch.callInner","PCP.Lang.OuterBranch.selectedInner_cost","PCP.Lang.OuterBranch.selectedInner_reg","PCP.Lang.OuterBranch.selectedInner_run"],"uses":["PCP.Lang.InnerBranch.hadamard","PCP.Lang.InnerBranch.interpolate","PCP.Lang.Stmt","PCP.Lang.Stmt.ite"],"written":"program"},{"dependency_source":"source_text","doc":null,"end_line":81,"kind":"theorem","line":78,"module":"PCP.Complexity.InnerBranchState","name":"PCP.Lang.InnerBranch.hadCall_result","namespace":"PCP.Lang.InnerBranch","noncomputable":false,"private":false,"protected":false,"short":"hadCall_result","signature_end_line":80,"used_by":["PCP.Lang.InnerBranch.hadCall_cost","PCP.Lang.InnerBranch.hadCall_run"],"uses":["PCP.Lang.HadamardRow.branch","PCP.Lang.InnerBranch.hadCall","PCP.Lang.InnerBranch.hadLists","PCP.Lang.InnerBranch.hadRegs","PCP.Lang.InnerBranch.hadRegs_injective","PCP.Lang.State","PCP.Lang.Stmt.run_rename"],"written":"hadCall_result"},{"dependency_source":"source_text","doc":null,"end_line":87,"kind":"theorem","line":83,"module":"PCP.Complexity.InnerBranchState","name":"PCP.Lang.InnerBranch.interpCall_result","namespace":"PCP.Lang.InnerBranch","noncomputable":false,"private":false,"protected":false,"short":"interpCall_result","signature_end_line":85,"used_by":["PCP.Lang.InnerBranch.interpCall_list","PCP.Lang.InnerBranch.interpolate_cost","PCP.Lang.InnerBranch.interpolate_run"],"uses":["PCP.Lang.InnerBranch.interpCall","PCP.Lang.InnerBranch.interpRegs","PCP.Lang.InterpolationBranch.program","PCP.Lang.State","PCP.Lang.Stmt.run_rename"],"written":"interpCall_result"}],"imports":["PCP.Complexity.HadamardRowBranchCost","PCP.Complexity.InterpolationBranchCost"],"module":"PCP.Complexity.InnerBranchState","path":"PCP/Complexity/InnerBranchState.lean","sha256":"c731b84881a8389d3afc85995c6b0a44635cfb8e73da4d2291a6f48f1b6c3ecd","source":"/-\nCopyright (c) 2026 Troy Lee. All rights reserved.\nReleased under Apache 2.0 license as described in the file LICENSE.\nAuthors: Troy Lee\n-/\nimport PCP.Complexity.HadamardRowBranchCost\nimport PCP.Complexity.InterpolationBranchCost\n\n/-!\n# Stored inputs for the complete inner binary low-degree selector\n\nThe Hadamard payload is relocated to registers 110--119, so both branches'\nsource data coexist. Register 100 chooses the branch, histories are lists 36/37,\nand the common outputs are forward query list 38 and verdict register 101.\n-/\n\nnamespace PCP.Lang.InnerBranch\n\nopen PCP.Algebraic BinaryPolynomialSpace InterpolationBranch\n\nvariable {t n m : ℕ} [NeZero t]\n\nabbrev Seed (t m : ℕ) :=\n  BinaryLowDegreeTest.TestRandomness (Field t) (Fin 4 × Fin m) t 1\n\ndef hadRegs (i : Fin 100) : Fin 120 :=\n  if h : 80 ≤ i.val ∧ i.val < 90 then ⟨i.val + 30, by omega⟩ else i.castLE (by decide)\n\ndef hadLists : Fin 32 → Fin 40 := Fin.castLE (by decide)\ndef interpRegs : Fin 100 → Fin 120 := Fin.castLE (by decide)\n\ntheorem hadRegs_injective : Function.Injective hadRegs := by\n  intro i j h\n  apply Fin.ext\n  have h := congrArg Fin.val h\n  simp only [hadRegs] at h\n  split_ifs at h <;> simp only [Fin.val_castLE] at h <;> omega\n\ndef location (site : StandardCorrection.Site (Field t) n) (x : Point t m) :\n    HadamardRow.Location (Field t) n m 4 1 :=\n  match site with\n  | .color uv => .colorLine uv x\n  | .valid uv => .validLine uv x\n  | .difference uv => .differenceLine uv x\n  | .proper uv => .properLine uv x\n\nomit [NeZero t] in\ntheorem location_query (site : StandardCorrection.Site (Field t) n) (x : Point t m)\n    (p : Coefficients t 1) : (location site x).query p = site.query x p := by\n  cases site <;> rfl\n\nstructure Context (a : Fin 5 → Field t) (site : StandardCorrection.Site (Field t) n)\n    (s : Seed t m) (st : State 120 40) : Prop where\n  coin : st.regs 100 = s.1.toNat\n  hadamard : HadamardRow.Sources s.2.1.2 (st.restrict hadRegs hadLists)\n  payload : HadamardRow.Payload\n    ((location site s.2.1.1).payload (t := t) (BinaryFieldCode.fieldEquiv t))\n    (st.restrict hadRegs hadLists)\n  interpolation : InterpolationBranch.Context a 0 s.2.2.1.1.1 s.2.2.1.1.2\n    s.2.2.2 site (st.restrict interpRegs id)\n\ndef hadCall : Stmt 120 40 := HadamardRow.branch.rename hadRegs hadLists\n\ndef interpCall : Stmt 120 40 := InterpolationBranch.program.rename interpRegs id\n\ndef prepareHad : Stmt 120 40 := .seq (.copy 36 30)\n  (.seq (.copy 37 31) (.copy 7 27))\n\ndef hadamard : Stmt 120 40 := .seq prepareHad\n  (.seq hadCall (.seq (.copy 26 38) (.assign 101 (.var 63))))\n\ndef interpolate : Stmt 120 40 := .seq interpCall\n  (.seq (.copy 20 38) (.assign 101 (.var 11)))\n\n/-- The sole branch choice is the actual Boolean sampler coin. -/\ndef program : Stmt 120 40 := .ite 100 interpolate hadamard\n\ntheorem hadCall_result (st : State 120 40) :\n    ((hadCall.run st).1.restrict hadRegs hadLists, (hadCall.run st).2) =\n      HadamardRow.branch.run (st.restrict hadRegs hadLists) :=\n  HadamardRow.branch.run_rename hadRegs hadLists hadRegs_injective (Fin.castLE_injective _) st\n\ntheorem interpCall_result (st : State 120 40) :\n    ((interpCall.run st).1.restrict interpRegs id, (interpCall.run st).2) =\n      InterpolationBranch.program.run (st.restrict interpRegs id) :=\n  InterpolationBranch.program.run_rename interpRegs id (Fin.castLE_injective _)\n    Function.injective_id st\n\nend PCP.Lang.InnerBranch\n"}