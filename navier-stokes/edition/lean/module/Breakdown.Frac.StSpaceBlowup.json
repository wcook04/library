"name":"Breakdown.FracOrbitRateFalseStatement","namespace":"Breakdown","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"FracOrbitRateFalseStatement","signature_end_line":19,"sorry":false,"statement_used_by":["Breakdown.fracOrbitRateFalse","Breakdown.fracSpaceUnitBreakdown_of"],"statement_uses":["Breakdown.Freq.CSpace","Breakdown.Freq.L2C","Breakdown.Freq.L6R","Breakdown.Freq.X","Breakdown.Freq.factOneLeSix","Breakdown.Freq.fracDilX","Breakdown.Freq.rotX","Breakdown.Freq.velocity","Breakdown.ScaledMildFramework","Breakdown.ScaledMildFramework.D","Breakdown.ScaledMildFramework.IsOrbit","Breakdown.Space","Breakdown.dilExponent"],"used_by":["Breakdown.fracOrbitRateFalse","Breakdown.fracSpaceUnitBreakdown_of"],"uses":["Breakdown.Freq.CSpace","Breakdown.Freq.L2C","Breakdown.Freq.L6R","Breakdown.Freq.X","Breakdown.Freq.factOneLeSix","Breakdown.Freq.fracDilX","Breakdown.Freq.rotX","Breakdown.Freq.velocity","Breakdown.ScaledMildFramework","Breakdown.ScaledMildFramework.D","Breakdown.ScaledMildFramework.IsOrbit","Breakdown.Space","Breakdown.dilExponent"],"written":"FracOrbitRateFalseStatement"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":29,"kind":"def","line":27,"module":"Breakdown.Frac.StSpaceBlowup","name":"Breakdown.FracSpaceUnitBreakdownStatement","namespace":"Breakdown","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"FracSpaceUnitBreakdownStatement","signature_end_line":27,"sorry":false,"statement_used_by":["Breakdown.FracInternal.SpaceAssembly.unitBreakdown_of_mild","Breakdown.fracSpaceUnitBreakdown_of"],"statement_uses":["Breakdown.FracNoBoundedSolution","Breakdown.RotatingFractionalProfileExists","Breakdown.Space","Breakdown.divergenceAt"],"used_by":["Breakdown.FracInternal.SpaceAssembly.unitBreakdown_of_mild","Breakdown.fracSpaceUnitBreakdown_of"],"uses":["Breakdown.FracNoBoundedSolution","Breakdown.RotatingFractionalProfileExists","Breakdown.Space","Breakdown.divergenceAt"],"written":"FracSpaceUnitBreakdownStatement"}],"imports":["Breakdown.Frac.StSpace","Breakdown.Frac.StProfile"],"module":"Breakdown.Frac.StSpaceBlowup","path":"Breakdown/Frac/StSpaceBlowup.lean","sha256":"fff49eedc33041756001796b7ab3f9f9537323a3c62c5354ed5e52ecefa887a3","source":"import Breakdown.Frac.StSpace\nimport Breakdown.Frac.StProfile\n\nopen scoped ContDiff ENNReal\nopen MeasureTheory Set Real\n\nnoncomputable section\n\nnamespace Breakdown\n\ndef FracMildRegularStatement (α : ℝ) : Prop :=\n  ∀ F : ScaledMildFramework Freq.X (dilExponent α), F.G = Freq.fracHeatX α → F.K = Freq.fracBilinX α →\n    ∀ φ, IsTestField φ → ∀ (u : ℝ → Freq.X) (T : ℝ), 0 < T → F.IsMildOnIcc u 0 T →\n    u 0 = Freq.embedX φ →\n    ∃ (U : ℝ → Space → Space) (P : ℝ → Space → ℝ), FracSolutionOn α T U P ∧ U 0 = φ ∧\n      EnergyBoundedOn T U ∧ GradientBoundedOn T U ∧\n      ∀ t ∈ Icc 0 T, (Freq.velocity (u t) : Space → Space) =ᵐ[volume] U t\n\ndef FracOrbitRateFalseStatement (α : ℝ) : Prop :=\n  ∀ F : ScaledMildFramework Freq.X (dilExponent α), F.D = Freq.fracDilX α →\n    ∀ (R : Space ≃ₗᵢ[ℝ] Space) (w : ℝ → Freq.X) (P : ℝ), F.IsOrbit (Freq.rotX R) w P →\n    ∀ (u : ℝ → Freq.X) (C κ : ℝ), 0 < κ →\n    (∀ t ∈ Ico (0 : ℝ) 1, ‖F.D (1 - t) (u t) - w (-Real.log (1 - t))‖ ≤ C * (1 - t) ^ κ) →\n    ∀ v : ℝ → Space → Space, ContinuousOn (fun z : ℝ × Space => v z.1 z.2) (Icc 0 1 ×ˢ univ) →\n    (∀ t ∈ Ico (0 : ℝ) 1, (Freq.velocity (u t) : Space → Space) =ᵐ[volume] v t) → False\n\ndef FracSpaceUnitBreakdownStatement (α : ℝ) : Prop :=\n  RotatingFractionalProfileExists α → ∃ u₀ : Space → Space, ContDiff ℝ ∞ u₀ ∧ HasCompactSupport u₀ ∧\n    (∀ x, divergenceAt u₀ x = 0) ∧ FracNoBoundedSolution α u₀\n\nend Breakdown\n"}