atement_used_by":["Breakdown.Periodic.ApproxField.Internal.contDiff_cutoffField_family","Breakdown.Periodic.CutoffDivergenceFree","Breakdown.Periodic.FracResidualCombine.Internal.field_point","Breakdown.Periodic.approxField","Breakdown.Periodic.fracApproxField"],"statement_uses":["Breakdown.Periodic.cross","Breakdown.Periodic.homotopyPotential","Breakdown.Space","Breakdown.gradientAt"],"used_by":["Breakdown.Periodic.ApproxField.Internal.contDiff_cutoffField_family","Breakdown.Periodic.ApproxSizes.Internal.cutAt_formula","Breakdown.Periodic.CutoffDivergenceFree","Breakdown.Periodic.FracResidualCombine.Internal.field_point","Breakdown.Periodic.approxField","Breakdown.Periodic.cutoffDivergenceFree","Breakdown.Periodic.fracApproxField"],"uses":["Breakdown.Periodic.cross","Breakdown.Periodic.homotopyPotential","Breakdown.Space","Breakdown.gradientAt"],"written":"cutoffField"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":31,"kind":"def","line":28,"module":"Breakdown.Torus.StatementsCutoff","name":"Breakdown.Periodic.CutoffDivergenceFree","namespace":"Breakdown.Periodic","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"CutoffDivergenceFree","signature_end_line":28,"sorry":false,"statement_used_by":["Breakdown.Periodic.approxFieldProperties","Breakdown.Periodic.cutoffDivergenceFree"],"statement_uses":["Breakdown.Periodic.cutoffField","Breakdown.Space","Breakdown.divergenceAt"],"used_by":["Breakdown.Periodic.approxFieldProperties","Breakdown.Periodic.cutoffDivergenceFree"],"uses":["Breakdown.Periodic.cutoffField","Breakdown.Space","Breakdown.divergenceAt"],"written":"CutoffDivergenceFree"}],"imports":["Breakdown.Defs"],"module":"Breakdown.Torus.StatementsCutoff","path":"Breakdown/Torus/StatementsCutoff.lean","sha256":"13385c1cd2e2c2aaab404901b2845d3212192cc751bef423706f8ef28c86f291","source":"import Breakdown.Defs\n\nopen MeasureTheory Set Real\nopen scoped ContDiff\n\nnoncomputable section\n\nnamespace Breakdown.Periodic\n\ndef cross (a b : Space) : Space := WithLp.toLp 2 (crossProduct (WithLp.ofLp a) (WithLp.ofLp b))\n\ndef partialAt (v : Space → Space) (i j : Fin 3) (x : Space) : ℝ := (fderiv ℝ v x (unitVector i)) j\n\ndef curlAt (v : Space → Space) (x : Space) : Space :=\n  WithLp.toLp 2 ![partialAt v 1 2 x - partialAt v 2 1 x, partialAt v 2 0 x - partialAt v 0 2 x,\n    partialAt v 0 1 x - partialAt v 1 0 x]\n\ndef homotopyPotential (x₀ : Space) (g : Space → Space) (x : Space) : Space :=\n  ∫ s in (0 : ℝ)..1, s • cross (g (x₀ + s • (x - x₀))) (x - x₀)\n\ndef HomotopyCurl : Prop :=\n  ∀ (x₀ : Space) (g : Space → Space), ContDiff ℝ ∞ g → (∀ x, divergenceAt g x = 0) →\n    ContDiff ℝ ∞ (homotopyPotential x₀ g) ∧ ∀ x, curlAt (homotopyPotential x₀ g) x = g x\n\ndef cutoffField (χ : Space → ℝ) (x₀ : Space) (g : Space → Space) (x : Space) : Space :=\n  χ x • g x + cross (gradientAt χ x) (homotopyPotential x₀ g x)\n\ndef CutoffDivergenceFree : Prop :=\n  ∀ (χ : Space → ℝ) (x₀ : Space) (g : Space → Space), ContDiff ℝ ∞ χ → ContDiff ℝ ∞ g →\n    (∀ x, divergenceAt g x = 0) →\n      ContDiff ℝ ∞ (cutoffField χ x₀ g) ∧ ∀ x, divergenceAt (cutoffField χ x₀ g) x = 0\n\nend Breakdown.Periodic\n"}