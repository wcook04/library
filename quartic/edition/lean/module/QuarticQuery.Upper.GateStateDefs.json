ticQuery.Upper.markWholeGate","QuarticQuery.Upper.routeFlagsGate","QuarticQuery.Upper.startTrials"],"used_by":["QuarticQuery.Upper.ampCircuit_state","QuarticQuery.Upper.assembledSuccess","QuarticQuery.Upper.assembledSuccess_apply","QuarticQuery.Upper.assembledSuccess_norm_sum","QuarticQuery.Upper.finalB_state","QuarticQuery.Upper.finalB_success_eq"],"uses":["QuarticQuery.Upper.MarkRouteBasis","QuarticQuery.Upper.Reg","QuarticQuery.Upper.RouteData","QuarticQuery.Upper.markWholeGate","QuarticQuery.Upper.routeFlagsGate","QuarticQuery.Upper.startTrials"],"written":"assembledTrials"},{"dependency_source":"lean_report","doc":"The success projection is a coordinate mask on the immutable flag record.","end_line":58,"kind":"def","line":55,"module":"QuarticQuery.Upper.GateStateDefs","name":"QuarticQuery.Upper.assembledSuccess","namespace":"QuarticQuery.Upper","noncomputable":true,"private":false,"proof_used_by":["QuarticQuery.Upper.finalB_retained_original","QuarticQuery.Upper.finalB_success_exact"],"proof_uses":[],"protected":false,"short":"assembledSuccess","signature_end_line":56,"statement_used_by":["QuarticQuery.Upper.assembledSuccess_apply","QuarticQuery.Upper.assembledSuccess_factor","QuarticQuery.Upper.assembledSuccess_norm_iid","QuarticQuery.Upper.assembledSuccess_norm_product","QuarticQuery.Upper.assembledSuccess_norm_sum","QuarticQuery.Upper.assembledSuccess_opaque_error","QuarticQuery.Upper.assembledSuccess_opaque_gain","QuarticQuery.Upper.assembledSuccess_opaque_norm","QuarticQuery.Upper.assembledSuccess_opaque_zero","QuarticQuery.Upper.assembledSuccess_original_factor","QuarticQuery.Upper.finalB_success_eq","QuarticQuery.Upper.opaqueTrials_retained_original"],"statement_uses":["QuarticQuery.Upper.MarkRouteBasis","QuarticQuery.Upper.Reg","QuarticQuery.Upper.RouteData","QuarticQuery.Upper.assembledTrials","QuarticQuery.Upper.firstSuccess"],"used_by":["QuarticQuery.Upper.assembledSuccess_apply","QuarticQuery.Upper.assembledSuccess_factor","QuarticQuery.Upper.assembledSuccess_norm_iid","QuarticQuery.Upper.assembledSuccess_norm_product","QuarticQuery.Upper.assembledSuccess_norm_sum","QuarticQuery.Upper.assembledSuccess_opaque_error","QuarticQuery.Upper.assembledSuccess_opaque_gain","QuarticQuery.Upper.assembledSuccess_opaque_norm","QuarticQuery.Upper.assembledSuccess_opaque_zero","QuarticQuery.Upper.assembledSuccess_original_factor","QuarticQuery.Upper.finalB_retained_original","QuarticQuery.Upper.finalB_success_eq","QuarticQuery.Upper.finalB_success_exact","QuarticQuery.Upper.opaqueTrials_retained_original"],"uses":["QuarticQuery.Upper.MarkRouteBasis","QuarticQuery.Upper.Reg","QuarticQuery.Upper.RouteData","QuarticQuery.Upper.assembledTrials","QuarticQuery.Upper.firstSuccess"],"written":"assembledSuccess"},{"dependency_source":"lean_report","doc":"Reassociate the immutable flags and post-route trial coordinates into the\nauxiliary subsystem; the fixed original output coordinate comes last.","end_line":67,"kind":"def","line":62,"module":"QuarticQuery.Upper.GateStateDefs","name":"QuarticQuery.Upper.retainedReassoc","namespace":"QuarticQuery.Upper","noncomputable":false,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"retainedReassoc","signature_end_line":63,"statement_used_by":["QuarticQuery.Upper.assembledSuccess_factor"],"statement_uses":["QuarticQuery.Upper.MarkRouteBasis","QuarticQuery.Upper.RouteData"],"used_by":["QuarticQuery.Upper.assembledSuccess_factor"],"uses":["QuarticQuery.Upper.MarkRouteBasis","QuarticQuery.Upper.RouteData"],"written":"retainedReassoc"},{"dependency_source":"lean_report","doc":null,"end_line":72,"kind":"def","line":69,"module":"QuarticQuery.Upper.GateStateDefs","name":"QuarticQuery.Upper.assembledAux","namespace":"QuarticQuery.Upper","noncomputable":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"assembledAux","signature_end_line":71,"statement_used_by":["QuarticQuery.Upper.assembledAux_success_support","QuarticQuery.Upper.assembledSuccess_factor"],"statement_uses":["QuarticQuery.Upper.Reg","QuarticQuery.Upper.routedAuxCoeff"],"used_by":["QuarticQuery.Upper.assembledAux_success_support","QuarticQuery.Upper.assembledSuccess_factor"],"uses":["QuarticQuery.Upper.Reg","QuarticQuery.Upper.routedAuxCoeff"],"written":"assembledAux"}],"imports":["QuarticQuery.Upper.AssemblyFormula"],"module":"QuarticQuery.Upper.GateStateDefs","path":"QuarticQuery/Upper/GateStateDefs.lean","sha256":"5a4b513bd0b7e1bbafb8e954ef40af0c2cbec6901e79c17770436a977b0fa9ce","source":"module\n\npublic import QuarticQuery.Upper.AssemblyFormula\n\n/-!\nExact gate-to-coordinate bridge for the product trial state.\nCompiled as part of the `QuarticQuery` library target.\nNo endpoint assumption or admitted proof is used.\n-/\n\n@[expose] public section\n\nnamespace QuarticQuery.Upper\n\nvariable {N : ℕ} {Z : Type} [Fintype Z]\n\nabbrev MarkRouteBasis (N : ℕ) (Z : Type) :=\n  (Fin N → Bool) × RouteData N Z\n\ndef markWhole (S : Z → Bool) (p : MarkRouteBasis N Z) :\n    MarkRouteBasis N Z :=\n  ((fun j => xor (p.1 j) (S (p.2.2 j))), p.2)\n\ntheorem markWhole_involutive (S : Z → Bool) :\n    Function.Involutive (markWhole (N := N) S) := by\n  classical\n  intro p\n  apply Prod.ext\n  · funext j\n    simp [markWhole, Bool.xor_assoc]\n  · rfl\n\nnoncomputable def markWholeGate (S : Z → Bool) :\n    Reg (MarkRouteBasis N Z) ≃ₗᵢ[ℂ]\n      Reg (MarkRouteBasis N Z) :=\n  regCongr ⟨markWhole S, markWhole S, markWhole_involutive S,\n    markWhole_involutive S⟩\n\n/-- O starts at `o`, every flag at false, and trials have independent\nunnormalised amplitude vectors `v i` (including any label amplitude). -/\nnoncomputable def startTrials (o : Z) (v : Fin N → Reg Z) :\n    Reg (MarkRouteBasis N Z) :=\n  by\n    classical\n    exact WithLp.toLp 2 fun p =>\n      if p.2.1 = o ∧ (∀ i, p.1 i = false) then\n        ∏ i, (v i).ofLp (p.2.2 i)\n      else 0\n\nnoncomputable def assembledTrials (o : Z) (S : Z → Bool)\n    (v : Fin N → Reg Z) : Reg (MarkRouteBasis N Z) :=\n  routeFlagsGate (markWholeGate S (startTrials o v))\n\n/-- The success projection is a coordinate mask on the immutable flag record. -/\nnoncomputable def assembledSuccess (o : Z) (S : Z → Bool)\n    (v : Fin N → Reg Z) : Reg (MarkRouteBasis N Z) :=\n  WithLp.toLp 2 fun p =>\n    if (firstSuccess p.1).isSome then (assembledTrials o S v).ofLp p else 0\n\n/-- Reassociate the immutable flags and post-route trial coordinates into the\nauxiliary subsystem; the fixed original output coordinate comes last. -/\ndef retainedReassoc :\n    MarkRouteBasis N Z ≃ Σ _ : ((Fin N → Bool) × (Fin N → Z)), Z where\n  toFun p := ⟨(p.1, p.2.2), p.2.1⟩\n  invFun p := (p.1.1, (p.2, p.1.2))\n  left_inv p := by cases p; rfl\n  right_inv p := by cases p; rfl\n\nnoncomputable def assembledAux (o : Z) (S : Z → Bool)\n    (v : Fin N → Reg Z) (s : Fin N → ℂ) :\n    Reg ((Fin N → Bool) × (Fin N → Z)) :=\n  WithLp.toLp 2 fun a => routedAuxCoeff o S v s a.1 a.2\n\nend QuarticQuery.Upper\n"}