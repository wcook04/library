e":28,"module":"PCP.Complexity.ArithmeticConditionals","name":"PCP.Lang.ArithmeticExpression.Term.eval_iteLt","namespace":"PCP.Lang.ArithmeticExpression.Term","noncomputable":false,"private":false,"protected":false,"short":"eval_iteLt","signature_end_line":29,"used_by":["PCP.Lang.ArithmeticExpression.Term.eval_minimum","PCP.Lang.GraphAdjacency.code_eval","PCP.Machine.TableauArithmeticTerms.cell_eval","PCP.Machine.TableauArithmeticTerms.eval_iteLtTriple","PCP.Machine.TableauArithmeticTerms.inputSelector_eval","PCP.Machine.TableauArithmeticTerms.scope_eval","PCP.Machine.TableauSourceLang.answerTerm_eval"],"uses":["PCP.Lang.ArithmeticExpression.Term","PCP.Lang.ArithmeticExpression.Term.bit_test","PCP.Lang.ArithmeticExpression.Term.iteLt"],"written":"eval_iteLt"},{"dependency_source":"source_text","doc":null,"end_line":38,"kind":"theorem","line":33,"module":"PCP.Complexity.ArithmeticConditionals","name":"PCP.Lang.ArithmeticExpression.Term.eval_minimum","namespace":"PCP.Lang.ArithmeticExpression.Term","noncomputable":false,"private":false,"protected":false,"short":"eval_minimum","signature_end_line":34,"used_by":["PCP.Machine.TableauArithmeticTerms.select_eval"],"uses":["PCP.Lang.ArithmeticExpression.Term","PCP.Lang.ArithmeticExpression.Term.eval_iteLt","PCP.Lang.ArithmeticExpression.Term.minimum"],"written":"eval_minimum"}],"imports":["PCP.Complexity.ArithmeticExpressionLang"],"module":"PCP.Complexity.ArithmeticConditionals","path":"PCP/Complexity/ArithmeticConditionals.lean","sha256":"c7d8ca78f713c759f702b6a36d08d22e9b48e831bec9fc0d2d81639e740a8b0f","source":"/-\nCopyright (c) 2026 Troy Lee. All rights reserved.\nReleased under Apache 2.0 license as described in the file LICENSE.\nAuthors: Troy Lee\n-/\nimport PCP.Complexity.ArithmeticExpressionLang\n\n/-! # Arithmetic expression helpers with direct conditional semantics -/\n\nnamespace PCP.Lang.ArithmeticExpression.Term\n\nvariable {n : ℕ}\n\ndef iteEq (a b yes no : Term n) : Term n := .cond (.bin .eq a b) yes no\n\ndef iteLt (a b yes no : Term n) : Term n := .cond (.bin .lt a b) yes no\n\ndef minimum (a b : Term n) : Term n := iteLt a b a b\n\nprivate theorem bit_test (p : Prop) [Decidable p] :\n    ((if p then 1 else 0) : ℕ) ≠ 0 ↔ p := by by_cases h : p <;> simp [h]\n\ntheorem eval_iteEq (a b yes no : Term n) (r : Fin n → ℕ) :\n    (iteEq a b yes no).eval r = if a.eval r = b.eval r then yes.eval r else no.eval r := by\n  change (if (if a.eval r = b.eval r then 1 else 0) ≠ 0 then yes.eval r else no.eval r) = _\n  simp only [bit_test]\n\ntheorem eval_iteLt (a b yes no : Term n) (r : Fin n → ℕ) :\n    (iteLt a b yes no).eval r = if a.eval r < b.eval r then yes.eval r else no.eval r := by\n  change (if (if a.eval r < b.eval r then 1 else 0) ≠ 0 then yes.eval r else no.eval r) = _\n  simp only [bit_test]\n\ntheorem eval_minimum (a b : Term n) (r : Fin n → ℕ) :\n    (minimum a b).eval r = min (a.eval r) (b.eval r) := by\n  rw [minimum, eval_iteLt]\n  split_ifs with h\n  · exact (min_eq_left h.le).symm\n  · exact (min_eq_right (by omega)).symm\n\nend PCP.Lang.ArithmeticExpression.Term\n"}