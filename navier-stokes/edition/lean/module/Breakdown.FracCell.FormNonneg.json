lit","Breakdown.CellCert.Assembly.CellSplit.cellCount","Breakdown.CellCert.Assembly.CellSplit.cellMatrix","Breakdown.CellCert.Assembly.CellSplit.delayCount","Breakdown.CellCert.Assembly.CellSplit.delayForm","Breakdown.CellCert.Assembly.CellSplit.globalMatrix","Breakdown.CellCert.Assembly.CellSplit.slots","Breakdown.CellCert.Assembly.IsFormData","Breakdown.CellCert.Assembly.QuadFormSplitStatement","Breakdown.CellCert.Finite.IsTreeCertificate","Breakdown.CellCert.Finite.TreeCertificate","Breakdown.CellCert.Finite.TreeCertificate.Cell","Breakdown.CellCert.Finite.TreeCertificate.cellForm","Breakdown.CellCert.Finite.TreeCertificate.globalForm","Breakdown.CellCert.FracCellData","Breakdown.CellCert.FracCellData.quadForm","Breakdown.Space","Breakdown.SteadyCert.FracCertData.order","Breakdown.SteadyCert.IsClassField","Breakdown.SteadyCert.IsGradientField","Breakdown.SteadyCert.IsSecondOrderField"],"used_by":["Breakdown.CellCert.Assembly.formNonneg_of_tree"],"uses":["Breakdown.CellCert.Assembly.AdmissibleLinearStatement","Breakdown.CellCert.Assembly.CellSplit","Breakdown.CellCert.Assembly.CellSplit.IsCellSplit","Breakdown.CellCert.Assembly.CellSplit.IsCellSplit.cell_bound","Breakdown.CellCert.Assembly.CellSplit.IsCellSplit.exterior_bound","Breakdown.CellCert.Assembly.CellSplit.cellCount","Breakdown.CellCert.Assembly.CellSplit.cellMatrix","Breakdown.CellCert.Assembly.CellSplit.cellPart","Breakdown.CellCert.Assembly.CellSplit.delayCount","Breakdown.CellCert.Assembly.CellSplit.delayForm","Breakdown.CellCert.Assembly.CellSplit.globalMatrix","Breakdown.CellCert.Assembly.CellSplit.slots","Breakdown.CellCert.Assembly.CellSplit.stateOf","Breakdown.CellCert.Assembly.FormNonnegInternal.admissibleSpace","Breakdown.CellCert.Assembly.FormNonnegInternal.momentMap","Breakdown.CellCert.Assembly.FormNonnegInternal.quadForm_zero","Breakdown.CellCert.Assembly.IsAdmissible","Breakdown.CellCert.Assembly.IsFormData","Breakdown.CellCert.Assembly.QuadFormSplitStatement","Breakdown.CellCert.Finite.IsTreeCertificate","Breakdown.CellCert.Finite.TreeCertificate","Breakdown.CellCert.Finite.TreeCertificate.Cell","Breakdown.CellCert.Finite.TreeCertificate.cellFintype","Breakdown.CellCert.Finite.TreeCertificate.cellForm","Breakdown.CellCert.Finite.TreeCertificate.globalForm","Breakdown.CellCert.FracCellData","Breakdown.CellCert.FracCellData.quadForm","Breakdown.Space","Breakdown.SteadyCert.FracCertData.order","Breakdown.SteadyCert.IsClassField","Breakdown.SteadyCert.IsGradientField","Breakdown.SteadyCert.IsSecondOrderField"],"written":"formNonneg_of_tree_of"}],"imports":["Breakdown.FracCell.StAssembly","Breakdown.FracCell.TreeFinal"],"module":"Breakdown.FracCell.FormNonneg","path":"Breakdown/FracCell/FormNonneg.lean","sha256":"672364ba1ce8b3f131a14833dc2ad4b87b349688a4bace408aa2c2a52aea85ac","source":"import Breakdown.FracCell.StAssembly\nimport Breakdown.FracCell.TreeFinal\n\nopen MeasureTheory Matrix\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace CellCert\n\nnamespace Assembly\n\nopen SteadyCert _root_.Breakdown.CellCert.Finite\n\nnamespace FormNonnegInternal\n\nvariable {k N : ℕ}\n\ndef admissibleSpace (c : FracCellData k N) (hadm : AdmissibleLinearStatement) :\n    Submodule ℝ (FieldTuple k) where\n  carrier := {x | IsAdmissible c x}\n  add_mem' := fun hx hy => (hadm c).2.1 _ _ hx hy\n  zero_mem' := (hadm c).1\n  smul_mem' := fun r _ hx => (hadm c).2.2 r _ hx\n\ndef momentMap (c : FracCellData k N) (hadm : AdmissibleLinearStatement) (S : CellSplit k N) {α : ℝ}\n    (hS : S.IsCellSplit c α) : admissibleSpace c hadm →ₗ[ℝ] (Fin S.slots → ℝ) where\n  toFun x := S.moment x.1\n  map_add' x y := hS.moment_additive x.1 y.1 x.2 y.2\n  map_smul' r x := hS.moment_homogeneous r x.1 x.2\n\ntheorem single_zero' (i : Fin 3) : EuclideanSpace.single i (0 : ℝ) = 0 :=\n  (PiLp.single_eq_zero_iff 2 i).mpr rfl\n\ntheorem modelField_zero (c : FracCellData k N) (α : ℝ) :\n    (fun y => c.modelFieldOf α (0 : Space → Space) 0 0 0 y + (0 : Space → Space) y) = fun _ => 0 := by\n  funext y\n  simp [FracCellData.modelFieldOf, driftField, secondTrace, crossVec, curlOf, entry, axialTurn, single_zero']\n\ntheorem quadForm_zero (c : FracCellData k N) (α : ℝ) :\n    c.quadForm α 0 0 0 0 0 ≤ 0 := by\n  rw [FracCellData.quadForm, modelField_zero]\n  simp [FracCellData.formOf, weightedEnergy, fullSecondSq, curlGradSq, jForm, curlOf, entry, entrySq,\n    FracCellData.pinOf, pinValue, entryInner, FracCertData.rows, rowSize, l2Pair, secondTrace]\n\nend FormNonnegInternal\n\ntheorem formNonneg_of_tree_of (hsplit : QuadFormSplitStatement) (hadm : AdmissibleLinearStatement) (α : ℝ) (hα₁ : 1 < α) (hα₂ : α < 5 / 4) {k N : ℕ} (c : FracCellData k N)\n    (hc : IsFormData α c) (S : CellSplit k N) (hS : S.IsCellSplit c α) (T : TreeCertificate S.slots k)\n    (hT : IsTreeCertificate T)\n    (hcells : ∃ e : T.Cell ≃ Fin S.cellCount ⊕ Fin S.delayCount,\n      ∀ K, T.cellForm K = Sum.elim S.cellMatrix S.delayForm (e K))\n    (hglobal : T.globalForm = S.globalMatrix c) :\n    ∀ v G H, IsSecondOrderField c.order v G H → ∀ κ : Fin k → ℝ, ∀ Q, IsGradientField Q →\n      IsClassField c.order Q → 0 ≤ c.quadForm α v G H κ Q := by\n  intro v G H hv κ Q hQ hQc\n  obtain ⟨e, he⟩ := hcells\n  let V := FormNonnegInternal.admissibleSpace c hadm\n  let z₀ := FormNonnegInternal.momentMap c hadm S hS\n  let q : V → ℝ := fun x => c.quadForm α x.1.1 x.1.2.1 x.1.2.2.1 x.1.2.2.2.1 x.1.2.2.2.2\n  have hq0 : q 0 ≤ 0 := FormNonnegInternal.quadForm_zero c α\n  have hx0 : (v, G, H, κ, Q) ∈ V := (⟨hv, hQ, hQc⟩ : IsAdmissible c (v, G, H, κ, Q))\n  refine tree_final V q z₀ S.freeMap T hT hq0 ?_ ⟨(v, G, H, κ, Q), hx0⟩\n  intro x u\n  let _ := T.cellFintype\n  have hx : IsAdmissible c x.1 := x.2\n  have hsum : (∑ K, T.cellForm K) = (∑ K, S.cellMatrix K) + ∑ j, S.delayForm j := by\n    rw [Finset.sum_congr rfl (fun K _ => he K), Equiv.sum_comp e (Sum.elim S.cellMatrix S.delayForm),\n      Fintype.sum_sum_type]\n    simp only [Sum.elim_inl, Sum.elim_inr]\n  have hst : (Sum.elim (z₀ x + S.freeMap *ᵥ u) u : Fin S.slots ⊕ Fin k → ℝ) = S.stateOf x.1 u := rfl\n  show quadValue ((∑ K, T.cellForm K) + T.globalForm) (Sum.elim (z₀ x + S.freeMap *ᵥ u) u) ≤\n    c.quadForm α x.1.1 x.1.2.1 x.1.2.2.1 x.1.2.2.2.1 x.1.2.2.2.2\n  rw [hst, hsum, hglobal, TreeFinalInternal.quad_add, TreeFinalInternal.quad_add,\n    TreeFinalInternal.quad_sum, TreeFinalInternal.quad_sum]\n  have h2 : ∑ j, quadValue (S.delayForm j) (S.stateOf x.1 u) = 0 :=\n    Finset.sum_eq_zero (fun j _ => hS.delay_vanish j x.1 hx u)\n  have h3 := hS.exterior_bound x.1 hx\n  have h4 := hsplit α hα₁ hα₂ c hc S hS x.1 hx u\n  have h5 : ∑ K, quadValue (S.cellMatrix K) (S.stateOf x.1 u) ≤ ∑ K, S.cellPart c α K x.1 u :=\n    Finset.sum_le_sum (fun K _ => hS.cell_bound K x.1 hx u)\n  rw [h2]\n  linarith\n\nend Assembly\n\nend CellCert\n\nend Breakdown\n"}