eLeSix","Breakdown.Freq.velocity","Breakdown.Space"],"written":"SimAdjPairingStatement"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":48,"kind":"def","line":44,"module":"Breakdown.FracCert.StWeak","name":"Breakdown.FracCert.SimAdjDerivStatement","namespace":"Breakdown.FracCert","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"SimAdjDerivStatement","signature_end_line":44,"sorry":false,"statement_used_by":["Breakdown.FracCert.mildOfWeakProfile_of","Breakdown.FracCert.simAdjDeriv","Breakdown.FracInternal.MildProfileOrbit.mild_identity","Breakdown.SteadyCert.ChainInternal.simAdjDeriv_holds"],"statement_uses":["Breakdown.FracCert.driftAdjoint","Breakdown.FracCert.simAdj","Breakdown.Freq.CSpace","Breakdown.Freq.IsNiceField","Breakdown.Freq.L2C","Breakdown.Freq.L6R","Breakdown.Freq.X","Breakdown.Freq.factOneLeSix","Breakdown.Freq.velocity","Breakdown.Space"],"used_by":["Breakdown.FracCert.mildOfWeakProfile_of","Breakdown.FracCert.simAdjDeriv","Breakdown.FracInternal.MildProfileOrbit.mild_identity","Breakdown.SteadyCert.ChainInternal.simAdjDeriv_holds"],"uses":["Breakdown.FracCert.driftAdjoint","Breakdown.FracCert.simAdj","Breakdown.Freq.CSpace","Breakdown.Freq.IsNiceField","Breakdown.Freq.L2C","Breakdown.Freq.L6R","Breakdown.Freq.X","Breakdown.Freq.factOneLeSix","Breakdown.Freq.velocity","Breakdown.Space"],"written":"SimAdjDerivStatement"}],"imports":["Breakdown.Frac.StProfile"],"module":"Breakdown.FracCert.StWeak","path":"Breakdown/FracCert/StWeak.lean","sha256":"773617761b240dd66db623a5108d0c4b515613263ba67a6d0ccbe3aa3437b9a5","source":"import Breakdown.Frac.StProfile\n\nopen MeasureTheory Set Real\nopen scoped ENNReal ContDiff\n\nnoncomputable section\n\nnamespace Breakdown.FracCert\n\nopen Breakdown.Freq\n\ndef driftAdjoint (α a : ℝ) (φ : Space → Space) (y : Space) : Space :=\n  (1 - 4 * (1 / (2 * α))) • φ y - (1 / (2 * α)) • fderiv ℝ φ y y\n    - a • (fderiv ℝ φ y (axialTurn y) - axialTurn (φ y))\n\ndef IsWeakRotatingProfile (α a : ℝ) (U : X) : Prop :=\n  U ≠ 0 ∧ ∀ φ, IsNiceField φ →\n    (∫ y, inner ℝ ((velocity U : Space → Space) y) (driftAdjoint α a φ y)) +\n      (∫ y, inner ℝ ((velocity U : Space → Space) y) (fractionalPowerAt α φ y)) +\n      trilinear U U φ = 0\n\ndef WeakRotatingProfileExists (α : ℝ) : Prop := ∃ (a : ℝ) (U : X), IsWeakRotatingProfile α a U\n\ndef WeakToProfileStatement : Prop :=\n  ∀ α : ℝ, 1 < α → α < 5 / 4 → WeakRotatingProfileExists α → RotatingFractionalProfileExists α\n\ndef simOp (α a μ : ℝ) : X →L[ℝ] X :=\n  (fracDilX α μ⁻¹).comp (rotX (axialRotation (a * Real.log μ))).toContinuousLinearEquiv.toContinuousLinearMap\n\ndef simAdj (α a μ : ℝ) (φ : Space → Space) : Space → Space :=\n  pushForward (axialRotation (-(a * Real.log μ))) (fun y => μ ^ (4 * (1 / (2 * α)) - 1) • φ (μ ^ (1 / (2 * α)) • y))\n\ndef NiceDriftClosedStatement : Prop :=\n  ∀ α a : ℝ, 0 < α → ∀ φ, IsNiceField φ → IsNiceField (driftAdjoint α a φ)\n\ndef NiceSimAdjClosedStatement : Prop :=\n  ∀ α a μ : ℝ, 0 < α → 0 < μ → ∀ φ, IsNiceField φ → IsNiceField (simAdj α a μ φ)\n\ndef SimAdjPairingStatement : Prop :=\n  ∀ α a μ : ℝ, 1 < α → 0 < μ → ∀ x : X, ∀ φ, IsNiceField φ →\n    ∫ y, inner ℝ ((velocity (simOp α a μ x) : Space → Space) y) (φ y) =\n      ∫ y, inner ℝ ((velocity x : Space → Space) y) (simAdj α a μ φ y)\n\ndef SimAdjDerivStatement : Prop :=\n  ∀ α a : ℝ, 1 < α → ∀ x : X, ∀ ψ, IsNiceField ψ → ∀ t : ℝ, t < 1 →\n    HasDerivAt (fun τ => ∫ y, inner ℝ ((velocity x : Space → Space) y) (simAdj α a (1 - τ) ψ y))\n      (∫ y, inner ℝ ((velocity x : Space → Space) y)\n        ((1 - t)⁻¹ • driftAdjoint α a (simAdj α a (1 - t) ψ) y)) t\n\nend Breakdown.FracCert\n"}