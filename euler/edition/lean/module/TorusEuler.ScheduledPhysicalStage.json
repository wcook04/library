:51,"kind":"def","line":51,"module":"TorusEuler.ScheduledPhysicalStage","name":"TorusEuler.ScheduledPhysicalStage.flow_exponent","namespace":"TorusEuler.ScheduledPhysicalStage","noncomputable":false,"parent":"TorusEuler.ScheduledPhysicalStage","private":false,"protected":false,"short":"flow_exponent","signature_end_line":51,"used_by":["TorusEuler.InductiveEulerTip.SelectedLaterInput.exists_inductiveEulerStep","TorusEuler.InductiveFirstWaveSelection.exists_base"],"uses":[],"written":"flow_exponent"},{"dependency_source":"source_text","doc":null,"end_line":52,"kind":"def","line":52,"module":"TorusEuler.ScheduledPhysicalStage","name":"TorusEuler.ScheduledPhysicalStage.flow_constant","namespace":"TorusEuler.ScheduledPhysicalStage","noncomputable":false,"parent":"TorusEuler.ScheduledPhysicalStage","private":false,"protected":false,"short":"flow_constant","signature_end_line":52,"used_by":["TorusEuler.InductiveEulerTip.SelectedLaterInput.exists_inductiveEulerStep","TorusEuler.InductiveFirstWaveSelection.exists_base"],"uses":[],"written":"flow_constant"},{"dependency_source":"source_text","doc":null,"end_line":53,"kind":"def","line":53,"module":"TorusEuler.ScheduledPhysicalStage","name":"TorusEuler.ScheduledPhysicalStage.jets","namespace":"TorusEuler.ScheduledPhysicalStage","noncomputable":false,"parent":"TorusEuler.ScheduledPhysicalStage","private":false,"protected":false,"short":"jets","signature_end_line":53,"used_by":[],"uses":[],"written":"jets"},{"dependency_source":"source_text","doc":null,"end_line":56,"kind":"def","line":54,"module":"TorusEuler.ScheduledPhysicalStage","name":"TorusEuler.ScheduledPhysicalStage.center","namespace":"TorusEuler.ScheduledPhysicalStage","noncomputable":false,"parent":"TorusEuler.ScheduledPhysicalStage","private":false,"protected":false,"short":"center","signature_end_line":54,"used_by":[],"uses":[],"written":"center"}],"imports":["TorusEuler.PhysicalWaveStageClosure","TorusEuler.InductiveStepNumericalBudgets"],"module":"TorusEuler.ScheduledPhysicalStage","path":"TorusEuler/ScheduledPhysicalStage.lean","sha256":"e25ce5f610114e187563d7171a35c141cb17e12cfdcb8b422addba9fc08e1cc5","source":"import TorusEuler.PhysicalWaveStageClosure\nimport TorusEuler.InductiveStepNumericalBudgets\n\n/-! Estimates and cutoff for one actual approximation on the common schedule. -/\n\nopen Set\nopen TorusEuler.HierarchyTwistedProfile\n\nnamespace TorusEuler\n\nnoncomputable section\n\nvariable {P : InductiveEulerParameters} {i : ℕ} {activationOld activation : ℝ}\n  {k : Vec3} {hT : 0 < P.slab (i + 1) activation}\n\nlocal notation \"D\" => P.frequency i ^ (9 : ℕ)\nlocal notation \"childFrequency\" => P.frequency (i + 1)\nlocal notation \"r\" a => ((D ^ a)⁻¹)\nlocal notation \"width\" => childFrequency ^ (-1 / 2 : ℝ)\n\n/-- The graph, pressure, and deformation estimates refer to the same\nfinite expansion and the same Fourier cutoff. -/\nstructure ScheduledPhysicalStage (parent : InductiveEulerStage P i activationOld)\n    {geom : ParentGeometry hT parent.velocity parent.flow k}\n    (b : PhysicalApproximationData geom parent.pressure (P.stepDepth i))\n    (properties : PhysicalApproximationProperties b) (a : ℕ) where\n  symbol : Vec3 → ℝ\n  cutoff : TruncatedChildStage (P.slab (i + 1) activation)\n    ((P.frequency i ^ frequencyExponent P.exponentParameter (P.order (i + 1))) ^ 5)\n    symbol b.velocity b.residual\n  C : ℝ\n  K : ℝ\n  Cmean : ℝ\n  B : ℝ\n  Γ : ℝ\n  jetPower : ℕ\n  cutoffBounds : cutoff.CutoffBounds (b.potential properties) (P.stepDepth i) C K\n  bounds : PhysicalWaveApproximationBounds parent activation b.velocity b.residual\n    b.oscillation b.meanCorrection (b.potential properties) (Γ * D ^ P.exponentParameter) Cmean\n  cutoff_nonneg : 0 ≤ C\n  tail_nonneg : 0 ≤ K\n  tail_le_parent : K ≤ P.frequency i\n  mean_le_parent : Cmean ≤ P.frequency i\n  step_le_child : Γ * D ^ P.exponentParameter ≤ childFrequency ^ (1 / 32 : ℝ)\n  cutoff_le_next : max 2 ((2 * C) ^ (2 : ℕ)) ≤ P.frequency (i + 2)\n  parent_le_scale : P.frequency i ≤ D\n  radius_pos : 0 < r a\n  jet_nonneg : 0 ≤ B\n  radius_inv : (r a)⁻¹ ≤ D ^ a\n  carrier_le : ‖k‖ ≤ D * childFrequency\n  flow_exponent : max a 1 + (max a 1 + jetPower) + 1 ≤ P.exponentParameter\n  flow_constant : 1 + 40 * B ≤ Γ\n  jets : cutoff.PulledBackProfileJetBounds parent.flow b.profileVelocity childFrequency (r a) width B D jetPower\n  center : ∀ t ∈ Icc activation (P.slab (i + 1) activation),\n    ‖fderiv ℝ (b.oscillationRemainder t) 0‖ + ‖fderiv ℝ (b.meanCorrection t) 0‖ ≤\n      (Γ * D ^ P.exponentParameter) * childFrequency ^ (-5 / 12 : ℝ)\n\nend\n\nend TorusEuler\n"}