hApprox.mollify_time_deriv"],"uses":["Breakdown.Coercive.Internal.SmoothApprox.joint","Breakdown.Coercive.Internal.SmoothApprox.kernel_contDiff","Breakdown.Coercive.Internal.SmoothApprox.kernel_hasCompactSupport","Breakdown.Coercive.Internal.SmoothApprox.mollify","Breakdown.Coercive.Internal.SmoothApprox.volume_prod_invariantClass","Breakdown.Space"],"written":"mollify_smooth"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":62,"kind":"theorem","line":55,"module":"Breakdown.Cert.CoerciveSmoothApproxKernel","name":"Breakdown.Coercive.Internal.SmoothApprox.mollify_periodic","namespace":"Breakdown.Coercive.Internal.SmoothApprox","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CertCell.Internal.ActuatorPairingGradient.mollified_actuator","Breakdown.Coercive.Internal.SmoothApprox.mollify_isSmoothPerturbation"],"proof_uses":["Breakdown.Coercive.Internal.SmoothApprox.joint"],"protected":false,"short":"mollify_periodic","signature_end_line":56,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.Coercive.Internal.SmoothApprox.mollify","Breakdown.IsTimePeriodic","Breakdown.Space"],"used_by":["Breakdown.CertCell.Internal.ActuatorPairingGradient.mollified_actuator","Breakdown.Coercive.Internal.SmoothApprox.mollify_isSmoothPerturbation"],"uses":["Breakdown.Coercive.Internal.SmoothApprox.joint","Breakdown.Coercive.Internal.SmoothApprox.mollify","Breakdown.IsTimePeriodic","Breakdown.Space"],"written":"mollify_periodic"}],"imports":["Breakdown.Cert.CoercivePerturbationFactsProof"],"module":"Breakdown.Cert.CoerciveSmoothApproxKernel","path":"Breakdown/Cert/CoerciveSmoothApproxKernel.lean","sha256":"e82a590bb4177aaa2f5b9ebc040b0a71b7e58777aa7d7e6735bf1922cb66c660","source":"import Breakdown.Cert.CoercivePerturbationFactsProof\n\nopen scoped ContDiff ENNReal Topology Convolution\nopen MeasureTheory Filter\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace Coercive\n\nnamespace Internal.SmoothApprox\n\ndef timeBump (n : ℕ) : ContDiffBump (0 : ℝ) :=\n  ⟨1 / ((n : ℝ) + 1), 2 / ((n : ℝ) + 1), by positivity,\n    div_lt_div_of_pos_right (by norm_num) (by positivity)⟩\n\ndef spaceBump (n : ℕ) : ContDiffBump (0 : Space) :=\n  ⟨1 / ((n : ℝ) + 1), 2 / ((n : ℝ) + 1), by positivity,\n    div_lt_div_of_pos_right (by norm_num) (by positivity)⟩\n\ndef kernel (n : ℕ) (z : ℝ × Space) : ℝ :=\n  (timeBump n).normed volume z.1 * (spaceBump n).normed volume z.2\n\ndef joint {β : Type*} (v : ℝ → Space → β) (z : ℝ × Space) : β := v z.1 z.2\n\ndef mollify (n : ℕ) (v : ℝ → Space → Space) (σ : ℝ) (y : Space) : Space :=\n  (kernel n ⋆[ContinuousLinearMap.lsmul ℝ ℝ, volume] joint v) (σ, y)\n\ntheorem kernel_contDiff (n : ℕ) : ContDiff ℝ ∞ (kernel n) :=\n  (((timeBump n).contDiff_normed (μ := volume) (n := ⊤)).comp contDiff_fst).mul\n    (((spaceBump n).contDiff_normed (μ := volume) (n := ⊤)).comp contDiff_snd)\n\ntheorem kernel_hasCompactSupport (n : ℕ) : HasCompactSupport (kernel n) := by\n  refine HasCompactSupport.intro\n    (((timeBump n).hasCompactSupport_normed (μ := volume)).isCompact.prod\n      ((spaceBump n).hasCompactSupport_normed (μ := volume)).isCompact) ?_\n  intro z hz\n  rw [Set.mem_prod, not_and_or] at hz\n  rcases hz with h | h\n  · simp [kernel, image_eq_zero_of_notMem_tsupport h]\n  · simp [kernel, image_eq_zero_of_notMem_tsupport h]\n\ntheorem kernel_nonneg (n : ℕ) (z : ℝ × Space) : 0 ≤ kernel n z :=\n  mul_nonneg ((timeBump n).nonneg_normed _) ((spaceBump n).nonneg_normed _)\n\ntheorem volume_prod_invariantClass : (volume : Measure (ℝ × Space)).IsAddHaarMeasure :=\n  Measure.prod.instIsAddHaarMeasure _ _\n\ntheorem mollify_smooth (n : ℕ) {v : ℝ → Space → Space} (hv : LocallyIntegrable (joint v) volume) :\n    ContDiff ℝ ∞ (fun z : ℝ × Space => mollify n v z.1 z.2) := by\n  have := volume_prod_invariantClass\n  exact (kernel_hasCompactSupport n).contDiff_convolution_left _ (kernel_contDiff n) hv\n\ntheorem mollify_periodic (n : ℕ) {v : ℝ → Space → Space} (hp : IsTimePeriodic v) :\n    IsTimePeriodic (mollify n v) := by\n  intro σ y\n  simp only [mollify, convolution_def]\n  congr 1\n  funext t\n  simp only [joint, Prod.fst_sub, Prod.snd_sub]\n  rw [show σ + 1 - t.1 = (σ - t.1) + 1 by ring, hp]\n\nend Internal.SmoothApprox\n\nend Coercive\n\nend Breakdown\n"}