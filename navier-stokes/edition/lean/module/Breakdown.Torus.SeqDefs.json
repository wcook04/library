estrict","Breakdown.Periodic.FracChainR3.Internal.piece_eq","Breakdown.Periodic.FracTorusChainTorus.Internal.fracChain_apply","Breakdown.Periodic.OpBounds.Internal.norm_sum_pieceConv_le","Breakdown.Periodic.OpBounds.Internal.sum_pieceConv_apply","Breakdown.Periodic.comparisonSmall","Breakdown.Periodic.fracOperatorNormBounds","Breakdown.Periodic.fracR3ChainEq","Breakdown.Periodic.fracR3LambdaFormula","Breakdown.Periodic.fracTorusChainEq","Breakdown.Periodic.fracTorusLambdaFormula","Breakdown.Periodic.operatorNormBounds","Breakdown.Periodic.pieceConvSpec","Breakdown.Periodic.r3ChainEq","Breakdown.Periodic.r3LambdaFormula","Breakdown.Periodic.torusChainEq","Breakdown.Periodic.torusLambdaFormula"],"statement_uses":["Breakdown.Periodic.pieceConv","Breakdown.Piece","Breakdown.extendPiece"],"used_by":["Breakdown.Periodic.ChainR3.Internal.lambda_restrict","Breakdown.Periodic.ChainR3.Internal.piece_eq","Breakdown.Periodic.ChainTorus.Internal.chain_apply","Breakdown.Periodic.FracChainR3.Internal.lambda_restrict","Breakdown.Periodic.FracChainR3.Internal.piece_eq","Breakdown.Periodic.FracTorusChainTorus.Internal.fracChain_apply","Breakdown.Periodic.OpBounds.Internal.norm_sum_pieceConv_le","Breakdown.Periodic.OpBounds.Internal.sum_pieceConv_apply","Breakdown.Periodic.comparisonSmall","Breakdown.Periodic.fracOperatorNormBounds","Breakdown.Periodic.fracR3ChainEq","Breakdown.Periodic.fracR3LambdaFormula","Breakdown.Periodic.fracTorusChainEq","Breakdown.Periodic.fracTorusLambdaFormula","Breakdown.Periodic.operatorNormBounds","Breakdown.Periodic.pieceConvSpec","Breakdown.Periodic.r3ChainEq","Breakdown.Periodic.r3LambdaFormula","Breakdown.Periodic.torusChainEq","Breakdown.Periodic.torusLambdaFormula"],"uses":["Breakdown.Periodic.pieceConv","Breakdown.Piece","Breakdown.extendPiece"],"written":"PieceConvSpec"}],"imports":["Breakdown.Transfer.StatementsDefs"],"module":"Breakdown.Torus.SeqDefs","path":"Breakdown/Torus/SeqDefs.lean","sha256":"015cc0dc71cd93e4772f180add899dea3b8eb6017acb6256beae9a3d66178082","source":"import Breakdown.Transfer.StatementsDefs\n\nopen MeasureTheory Set Real\nopen scoped ENNReal ContDiff\n\nnoncomputable section\n\nnamespace Breakdown.Periodic\n\nvariable {E Z X : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]\n  [NormedAddCommGroup Z] [NormedSpace ℝ Z] [CompleteSpace Z]\n  [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X]\n\nopen Classical in\ndef seqOp (A : ℕ → E →L[ℝ] X) : lp (fun _ : ℕ => E) ∞ →L[ℝ] lp (fun _ : ℕ => X) ∞ :=\n  if h : ∃ T : lp (fun _ : ℕ => E) ∞ →L[ℝ] lp (fun _ : ℕ => X) ∞, ∀ g n, T g n = A n (g n)\n  then h.choose else 0\n\nopen Classical in\ndef seqShift (A : ℕ → X →L[ℝ] X) : lp (fun _ : ℕ => X) ∞ →L[ℝ] lp (fun _ : ℕ => X) ∞ :=\n  if h : ∃ T : lp (fun _ : ℕ => X) ∞ →L[ℝ] lp (fun _ : ℕ => X) ∞,\n      ∀ g n, T g n = if n = 0 then 0 else A (n - 1) (g (n - 1))\n  then h.choose else 0\n\nopen Classical in\ndef seqSeed (A : E →L[ℝ] X) : E →L[ℝ] lp (fun _ : ℕ => X) ∞ :=\n  if h : ∃ T : E →L[ℝ] lp (fun _ : ℕ => X) ∞, ∀ e n, T e n = if n = 0 then A e else 0\n  then h.choose else 0\n\nopen Classical in\ndef pieceComp (L : ℝ) (A : E →L[ℝ] X) : Piece E L →L[ℝ] Piece X L :=\n  if h : ∃ T : Piece E L →L[ℝ] Piece X L, ∀ f s, T f s = A (f s) then h.choose else 0\n\nopen Classical in\ndef pieceConv (L : ℝ) (Λ : ℝ → Z →L[ℝ] X) (w : C(Icc (0 : ℝ) L, ℝ)) : Piece Z L →L[ℝ] Piece X L :=\n  if h : ∃ T : Piece Z L →L[ℝ] Piece X L, ∀ ζ (s : Icc (0 : ℝ) L),\n      T ζ s = ∫ σ in (0 : ℝ)..s, (extendPiece w σ) • Λ (s - σ) (extendPiece ζ σ)\n  then h.choose else 0\n\ndef SeqOpSpec : Prop :=\n  ∀ (E X : Type) [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]\n    [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X] (A : ℕ → E →L[ℝ] X) (C : ℝ),\n    (∀ n, ‖A n‖ ≤ C) → 0 ≤ C →\n      (∀ g n, seqOp A g n = A n (g n)) ∧ ‖seqOp A‖ ≤ C ∧\n      (∀ (B : ℕ → X →L[ℝ] X), (∀ n, ‖B n‖ ≤ C) →\n        (∀ g n, seqShift B g n = if n = 0 then 0 else B (n - 1) (g (n - 1))) ∧ ‖seqShift B‖ ≤ C) ∧\n      (∀ A₀ : E →L[ℝ] X, (∀ e n, seqSeed A₀ e n = if n = 0 then A₀ e else 0) ∧ ‖seqSeed A₀‖ ≤ ‖A₀‖)\n\ndef PieceCompSpec : Prop :=\n  ∀ (E X : Type) [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]\n    [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X] (L : ℝ) (A : E →L[ℝ] X),\n      0 ≤ L → (∀ f s, pieceComp L A f s = A (f s)) ∧ ‖pieceComp L A‖ ≤ ‖A‖\n\ndef PieceConvSpec : Prop :=\n  ∀ (Z X : Type) [NormedAddCommGroup Z] [NormedSpace ℝ Z] [CompleteSpace Z]\n    [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X]\n    (L : ℝ) (Λ : ℝ → Z →L[ℝ] X) (w : C(Icc (0 : ℝ) L, ℝ)) (C : ℝ), 0 < L → L ≤ 1 → 0 ≤ C →\n    (∀ τ, 0 < τ → τ ≤ 1 → ‖Λ τ‖ ≤ C * τ ^ (-(3 / 4 : ℝ))) →\n    (∀ ζ, ContinuousOn (fun τ => Λ τ ζ) (Ioi 0)) →\n      (∀ ζ (s : Icc (0 : ℝ) L),\n        pieceConv L Λ w ζ s = ∫ σ in (0 : ℝ)..s, (extendPiece w σ) • Λ (s - σ) (extendPiece ζ σ)) ∧\n      ‖pieceConv L Λ w‖ ≤ 4 * C * L ^ (1 / 4 : ℝ) * ‖w‖\n\nend Breakdown.Periodic\n"}