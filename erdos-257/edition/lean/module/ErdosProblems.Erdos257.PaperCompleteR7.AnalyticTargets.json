false,"noncomputable_section":true,"private":false,"protected":false,"short":"StrengthenedPositiveCoverClaim","signature_end_line":53,"used_by":[],"uses":["Erdos249257.erdosSupportSeries","ErdosProblems.Erdos257.PaperCompleteR7.PositiveCoverData","ErdosProblems.Erdos257.PaperCompleteR7.PositiveCoverData.StrengthenedCostSummable","ErdosProblems.Erdos257.PaperCompleteR7.PositiveCoverData.host"],"written":"StrengthenedPositiveCoverClaim"},{"dependency_source":"source_text","doc":"Statement interface for long `thm:257-weighted`, including the all-base\nhereditary consequence of a finite binary weighted mass. The proof is supplied\nby `PaperCompleteR8.WeightedReturn`.","end_line":66,"kind":"def","line":61,"module":"ErdosProblems.Erdos257.PaperCompleteR7.AnalyticTargets","name":"ErdosProblems.Erdos257.PaperCompleteR7.DivisibilityWeightedClaim","namespace":"ErdosProblems.Erdos257.PaperCompleteR7","noncomputable":false,"noncomputable_section":true,"private":false,"protected":false,"short":"DivisibilityWeightedClaim","signature_end_line":61,"used_by":[],"uses":["Erdos249257.erdosSupportSeries","ErdosProblems.Erdos257.PaperCompleteR7.FinitePrimeWeighted"],"written":"DivisibilityWeightedClaim"},{"dependency_source":"source_text","doc":"Statement interface for short `res:mixed-supports`. The proof is supplied by\n`PaperCompleteR8.WeightedReturn`; no separate-return premise is substituted for\nthe common observation-scale estimates used there.","end_line":75,"kind":"def","line":71,"module":"ErdosProblems.Erdos257.PaperCompleteR7.AnalyticTargets","name":"ErdosProblems.Erdos257.PaperCompleteR7.MixedSupportClaim","namespace":"ErdosProblems.Erdos257.PaperCompleteR7","noncomputable":false,"noncomputable_section":true,"private":false,"protected":false,"short":"MixedSupportClaim","signature_end_line":71,"used_by":[],"uses":["Erdos249257.erdosSupportSeries","ErdosProblems.Erdos257.PaperCompleteR7.FinitePrimeWeighted","ErdosProblems.Erdos257.PaperCompleteR7.HasStrengthenedPositiveCover"],"written":"MixedSupportClaim"}],"imports":["ErdosProblems.Erdos257.PaperCompleteR7.Displacement","ErdosProblems.Erdos257.PaperCompleteR7.PrimeWeightedDefinitions"],"module":"ErdosProblems.Erdos257.PaperCompleteR7.AnalyticTargets","path":"ErdosProblems/Erdos257/PaperCompleteR7/AnalyticTargets.lean","sha256":"7d9cbb3b225cbad70ae1f8165560dc15602525143a64dccf9457259fbbdc9d0a","source":"import ErdosProblems.Erdos257.PaperCompleteR7.Displacement\nimport ErdosProblems.Erdos257.PaperCompleteR7.PrimeWeightedDefinitions\n\n/-!\n# Exact remaining analytic goals, not admitted theorems\n\nThese definitions deliberately have type Prop. There is no theorem asserting\nany of them, no axiom, and no `sorry`. They specify the missing end-to-end Lean\nwork for the three ordinary analytic assertions in the paper campaign.\n\nThe ordinary cover index j>=1 is reindexed by j+1. Positive divisors are used;\nthe d=0 summand in a real series is zero by total division and is immaterial.\nColumn summability makes explicit the finiteness implicit in the paper's\nnonnegative double-series cost. A finite sum over n.divisors is used at n>0.\nThe structures and goals themselves have not been elaborated in this run.\n-/\n\nnoncomputable section\nnamespace ErdosProblems.Erdos257.PaperCompleteR7\nopen Erdos249257\n\n/-- Input data for the actual positive divisor-cover method. -/\nstructure PositiveCoverData where\n  frame : ℕ → Finset ℕ\n  exponent : ℕ → ℝ\n  coefficient : ℕ → ℕ → ℝ\n  frame_positive : ∀ j, 0 ∉ frame j\n  exponent_bounds : ∀ j, 0 < exponent j ∧ exponent j ≤ 1\n  coefficient_nonneg : ∀ j d, 0 < d → 0 ≤ coefficient j d\n  column_summable : ∀ j, Summable (fun d : ℕ => coefficient j d / (d : ℝ))\n  majorises : ∀ j n, 0 < n →\n    (((frame j).filter (fun a => a ∣ n)).card : ℝ) ^ exponent j ≤\n      ∑ d ∈ n.divisors, coefficient j d\n\ndef PositiveCoverData.cost (C : PositiveCoverData) (j : ℕ) : ℝ :=\n  ∑' d : ℕ, C.coefficient j d / (d : ℝ)\n\ndef PositiveCoverData.host (C : PositiveCoverData) : Set ℕ :=\n  {a | ∃ j, a ∈ C.frame j}\n\n/-- Exactly the one-inverse-power cost in short (V), after reindexing. -/\ndef PositiveCoverData.StrengthenedCostSummable (C : PositiveCoverData) : Prop :=\n  Summable (fun j : ℕ =>\n    C.cost j * (2 : ℝ) ^ (((j + 1 : ℕ) : ℝ) * C.exponent j) /\n      ((2 : ℝ) ^ C.exponent j - 1))\n\ndef HasStrengthenedPositiveCover (A : Set ℕ) : Prop :=\n  ∃ C : PositiveCoverData, A ⊆ C.host ∧ C.StrengthenedCostSummable\n\n/-- Statement interface for short `thm:variable-fractional-cover`.\nThe proof is supplied by `PaperCompleteR8.PositiveCoverReturn`; this definition\nalone is not evidence for the theorem. -/\ndef StrengthenedPositiveCoverClaim : Prop :=\n  ∀ C : PositiveCoverData, C.StrengthenedCostSummable →\n    ∀ A : Set ℕ, A ⊆ C.host → A.Infinite →\n      ∀ b : ℕ, 2 ≤ b → Irrational (erdosSupportSeries b A)\n\n/-- Statement interface for long `thm:257-weighted`, including the all-base\nhereditary consequence of a finite binary weighted mass. The proof is supplied\nby `PaperCompleteR8.WeightedReturn`. -/\ndef DivisibilityWeightedClaim : Prop :=\n  (∀ (b : ℕ) (A : Set ℕ), 2 ≤ b → 0 ∉ A → A.Infinite →\n    FinitePrimeWeighted b A → Irrational (erdosSupportSeries b A)) ∧\n  (∀ H : Set ℕ, 0 ∉ H → FinitePrimeWeighted 2 H →\n    ∀ A : Set ℕ, A ⊆ H → A.Infinite →\n      ∀ b : ℕ, 2 ≤ b → Irrational (erdosSupportSeries b A))\n\n/-- Statement interface for short `res:mixed-supports`. The proof is supplied by\n`PaperCompleteR8.WeightedReturn`; no separate-return premise is substituted for\nthe common observation-scale estimates used there. -/\ndef MixedSupportClaim : Prop :=\n  ∀ E V : Set ℕ, 0 ∉ E → FinitePrimeWeighted 2 E →\n    HasStrengthenedPositiveCover V →\n    ∀ A : Set ℕ, A ⊆ E ∪ V → A.Infinite →\n      ∀ b : ℕ, 2 ≤ b → Irrational (erdosSupportSeries b A)\n\nend ErdosProblems.Erdos257.PaperCompleteR7\nend\n"}