7661fdee98a6d01f51717c30dafd2bd0188e6e21927/papers/expository.md/sha256:0e0b8ed54de434b100596a9e6374160bfb146bc7905b31307a73825c7034dd44/papers/expository.json/passages/front","query_href":"/api/v1/papers/query?manifest=c02ee087719f86b306aeb0592c0b7c61d641c5fb7814a548b94e0b3be06311d2&paper=expository&passage=front","reading_href":"/api/v1/papers/reading?manifest=c02ee087719f86b306aeb0592c0b7c61d641c5fb7814a548b94e0b3be06311d2&paper=expository&passage=front","span":{"end_byte":1678,"end_line":12,"start_byte":23,"start_line":2},"stage":"expository"}],"lenses":{"consumers":"/api/v1/graph?manifest=c02ee087719f86b306aeb0592c0b7c61d641c5fb7814a548b94e0b3be06311d2&view=arguments&node=quartic.theorem-1&direction=consumers&assumptions=true","direct_passages":"/api/v1/papers/query?manifest=c02ee087719f86b306aeb0592c0b7c61d641c5fb7814a548b94e0b3be06311d2&node=quartic.theorem-1&relation=direct","prerequisite_uses":"/api/v1/papers/query?manifest=c02ee087719f86b306aeb0592c0b7c61d641c5fb7814a548b94e0b3be06311d2&node=quartic.theorem-1&relation=prerequisites","prerequisites":"/api/v1/graph?manifest=c02ee087719f86b306aeb0592c0b7c61d641c5fb7814a548b94e0b3be06311d2&view=arguments&node=quartic.theorem-1&assumptions=true"},"neighborhood_href":"/api/v1/neighborhood?manifest=c02ee087719f86b306aeb0592c0b7c61d641c5fb7814a548b94e0b3be06311d2&ref=sha256%3Ab01fb7dc64f90c9c1f9fb29554b974330c989197a18a158ed14e47c792db1a40%2Fnodes%2Fquartic.theorem-1","record":{"assumption_ids":[],"boundary":"A result as the authors number it. Its links to the Lean were made with AI for Proof Reader and have not been reviewed by the authors.","citation_ids":["cite.quartic.theorem-1"],"evidence_ids":["link.quartic.theorem-1"],"id":"quartic.theorem-1","kind":"goal","label":"Theorem 1","locator":"Theorem 1, Section 1","source_id":"paper","statement":"**Theorem 1** (OpenAI ([OpenAI 2026](#cite-OpenAI2026), Theorem 1.1)). *For every total Boolean function $f$, $R(f)=O((1+Q(f))^4)$. For each fixed integer $k\\ge2$ there are positive constants $c_k$, $C_k$ and $b_k$ and total Boolean functions $F_{k,m}$, defined for powers of four $m$, such that for all sufficiently large $m$, with $\\ell=\\log_2m$,*\n$$\n Q(F_{k,m})\\le C_k\\sqrt m\\,\\ell^{b_k},\n \\qquad R(F_{k,m})\\ge c_k\\,\\frac{m^{2-1/k}}{\\ell^2}.\n\\tag{1}\n$$\n*Consequently the critical exponent of $R$ relative to $Q$ is four.*","status":"unverified"},"ref":"sha256:b01fb7dc64f90c9c1f9fb29554b974330c989197a18a158ed14e47c792db1a40/nodes/quartic.theorem-1","relations":[{"derived":false,"family":"arguments","from":"sha256:b01fb7dc64f90c9c1f9fb29554b974330c989197a18a158ed14e47c792db1a40/nodes/quartic.theorem-1","id":"sha256:b01fb7dc64f90c9c1f9fb29554b974330c989197a18a158ed14e47c792db1a40/edges/%5B%22quartic.theorem-1%22%2C%22lean.QuarticQuery.theorem_1_1_unconditional%22%2C%22formalizes%22%5D","kind":"formalizes","record_ref":"sha256:b01fb7dc64f90c9c1f9fb29554b974330c989197a18a158ed14e47c792db1a40/edges/%5B%22quartic.theorem-1%22%2C%22lean.QuarticQuery.theorem_1_1_unconditional%22%2C%22formalizes%22%5D","semantic_class":"formalization_correspondence","to":"sha256:b01fb7dc64f90c9c1f9fb29554b974330c989197a18a158ed14e47c792db1a40/nodes/lean.QuarticQuery.theorem_1_1_unconditional"},{"derived":true,"family":"provenance","from":"sha256:b01fb7dc64f90c9c1f9fb29554b974330c989197a18a158ed14e47c792db1a40/nodes/quartic.theorem-1","id":"field:2e5116e253b11e45fa004d1879e30b45e72952101f48d782b57a80961904bdeb","kind":"evidence_ids","owner_ref":"sha256:b01fb7dc64f90c9c1f9fb29554b974330c989197a18a158ed14e47c792db1a40/nodes/quartic.theorem-1","semantic_class":"provenance_field_reference","source_field":"evidence_ids","to":"sha256:b01fb7dc64f90c9c1f9fb29554b974330c989197a18a158ed14e47c792db1a40/evidence/link.quartic.theorem-1"},{"derived":true,"family":"provenance","from":"sha256:b01fb7dc64f90c9c1f9fb29554b974330c989197a18a158ed14e47c792db1a40/nodes/quartic.theorem-1","id":"field:485e648030f424a0d60b676eed6214e3ef3a251f45abab9b39afca7e50f5c85c","