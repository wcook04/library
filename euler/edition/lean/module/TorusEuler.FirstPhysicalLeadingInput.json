{"declarations":[{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":"The general flow operators of the stationary shear are exactly the\nexplicit operators used to prove the first-wave equation.","end_line":39,"kind":"theorem","line":18,"module":"TorusEuler.FirstPhysicalLeadingInput","name":"TorusEuler.HierarchyTwistedProfile.ParentGeometry.firstWave_operators_eq","namespace":"TorusEuler.HierarchyTwistedProfile.ParentGeometry","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":["TorusEuler.HierarchyTwistedProfile.ParentGeometry.covector_value","TorusEuler.HierarchyTwistedProfile.ParentGeometry.inverse_value","TorusEuler.HierarchyTwistedProfile.ParentGeometry.strain_value","TorusEuler.HierarchyTwistedProfile.ext","TorusEuler.firstWaveHierarchyCovector","TorusEuler.firstWaveHierarchyCovector_eval","TorusEuler.firstWaveHierarchyInverseDeformation","TorusEuler.firstWaveHierarchyInverseDeformation_eval","TorusEuler.firstWaveHierarchyMaterialGradient","TorusEuler.firstWaveHierarchyMaterialGradient_eval","TorusEuler.firstWaveInverseDeformation","TorusEuler.firstWaveInverseDeformation_eq","TorusEuler.firstWaveMaterialGradient","TorusEuler.firstWaveMaterialGradient_eq","TorusEuler.firstWaveTransportedCovector","TorusEuler.firstWaveTransportedCovector_eq_inverseDeformation","TorusEuler.hierarchyProfileSlab","TorusEuler.labelWaveVector"],"protected":false,"short":"firstWave_operators_eq","signature_end_line":20,"sorry":false,"statement_used_by":[],"statement_uses":["TorusEuler.HierarchyOperators","TorusEuler.HierarchyPeriodicProfile","TorusEuler.HierarchyProfilePoint","TorusEuler.HierarchySmoothProfile","TorusEuler.HierarchyTwistedProfile","TorusEuler.HierarchyTwistedProfile.ParentGeometry","TorusEuler.HierarchyTwistedProfile.ParentGeometry.covector","TorusEuler.HierarchyTwistedProfile.ParentGeometry.inverse","TorusEuler.HierarchyTwistedProfile.ParentGeometry.strain","TorusEuler.Hierarch