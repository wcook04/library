sound"],"dependency_source":"lean_report","doc":"Corollary 2.10, with the necessary nonempty-alphabet hypothesis.","end_line":130,"kind":"theorem","line":119,"module":"PCP.Algebraic.VanishingCertificate","name":"PCP.Algebraic.GridVanishing.vanishesOn_iff_exists_certificate","namespace":"PCP.Algebraic.GridVanishing","noncomputable":false,"private":false,"proof_used_by":["PCP.Algebraic.ThreeColorGrid.colorable_iff_exists_certificates","PCP.Algebraic.ThreeColorVerifier.exists_proof_test_eq_true"],"proof_uses":["PCP.Algebraic.GridVanishing.IsCertificate.vanishesOn","PCP.Algebraic.GridVanishing.certificate","PCP.Algebraic.GridVanishing.certificate_isCertificate","PCP.Algebraic.GridVanishing.exists_decomposition","PCP.Algebraic.GridVanishing.totalDegree_certificate_le"],"protected":false,"short":"vanishesOn_iff_exists_certificate","signature_end_line":122,"sorry":false,"statement_used_by":[],"statement_uses":["PCP.Algebraic.GridVanishing.IsCertificate","PCP.Algebraic.GridVanishing.VanishesOn"],"used_by":["PCP.Algebraic.BinaryZeroOnGrid.exists_rejectionRate_encode_eq_zero","PCP.Algebraic.BinaryZeroOnGridCorrection.exists_rejectionRate_eval_eq_zero","PCP.Algebraic.GridCoordinateTransport.exists_certificate_after_rename","PCP.Algebraic.GridVanishing.exists_acceptanceRate_eq_one","PCP.Algebraic.ThreeColorGrid.colorable_iff_exists_certificates","PCP.Algebraic.ThreeColorVerifier.exists_proof_test_eq_true"],"uses":["PCP.Algebraic.GridVanishing.IsCertificate","PCP.Algebraic.GridVanishing.IsCertificate.vanishesOn","PCP.Algebraic.GridVanishing.VanishesOn","PCP.Algebraic.GridVanishing.certificate","PCP.Algebraic.GridVanishing.certificate_isCertificate","PCP.Algebraic.GridVanishing.exists_decomposition","PCP.Algebraic.GridVanishing.totalDegree_certificate_le"],"written":"vanishesOn_iff_exists_certificate"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":"Setting the certificate variables to zero does not increase total degree.","end_line":138,"kind":"theorem","line":134,"module":"PCP.Algebraic.VanishingCertificate","name":"PCP.Algebraic.GridVanishing.totalDegree_substitute_zero_le","namespace":"PCP.Algebraic.GridVanishing","noncomputable":false,"private":false,"proof_used_by":[],"proof_uses":["PCP.Algebraic.totalDegree_substitution_le_of_affine"],"protected":false,"short":"totalDegree_substitute_zero_le","signature_end_line":135,"sorry":false,"statement_used_by":[],"statement_uses":["PCP.Algebraic.GridVanishing.substitute"],"used_by":["PCP.Algebraic.GridVanishing.isCertificate_of_acceptanceRate_gt"],"uses":["PCP.Algebraic.GridVanishing.substitute","PCP.Algebraic.totalDegree_substitution_le_of_affine"],"written":"totalDegree_substitute_zero_le"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":"Substitution by the vanishing polynomials multiplies degree by at most `|H|`.","end_line":149,"kind":"theorem","line":142,"module":"PCP.Algebraic.VanishingCertificate","name":"PCP.Algebraic.GridVanishing.totalDegree_substitute_coordinate_le","namespace":"PCP.Algebraic.GridVanishing","noncomputable":false,"private":false,"proof_used_by":[],"proof_uses":["PCP.Algebraic.GridVanishing.totalDegree_coordinate","PCP.Algebraic.totalDegree_substitution_le"],"protected":false,"short":"totalDegree_substitute_coordinate_le","signature_end_line":144,"sorry":false,"statement_used_by":[],"statement_uses":["PCP.Algebraic.GridVanishing.coordinate","PCP.Algebraic.GridVanishing.substitute"],"used_by":["PCP.Algebraic.GridVanishing.isCertificate_of_acceptanceRate_gt"],"uses":["PCP.Algebraic.GridVanishing.coordinate","PCP.Algebraic.GridVanishing.substitute","PCP.Algebraic.GridVanishing.totalDegree_coordinate","PCP.Algebraic.totalDegree_substitution_le"],"written":"totalDegree_substitute_coordinate_le"}],"imports":["PCP.Algebraic.GridVanishing","PCP.Algebraic.PolynomialSubstitution"],"module":"PCP.Algebraic.VanishingCertificate","path":"PCP/Algebraic/VanishingCertificate.lean","sha256":"f8a240c66a7507cbfd78bfabc0e858e1342ae7ad2bf5e8bb1ded5b5b2a25add6","source":"/-\nCopyright (c) 2026 Troy Lee. All rights reserved.\nReleased under Apache 2.0 license as described in the file LICENSE.\nAuthors: Troy Lee\n-/\nimport PCP.Algebraic.GridVanishing\nimport PCP.Algebraic.PolynomialSubstitution\n\n/-!\n# A single polynomial certifying vanishing on a grid\n\nCorollary 2.10. The two blocks of variables are indexed by `σ ⊕ σ`.\nThe certificate `M(X,Y) = ∑ i, Qᵢ(X) Yᵢ` satisfies the formal identities\n`M(X,0) = 0` and `M(X,Z_H(X)) = P(X)`. Conversely, these identities force\n`P` to vanish on the grid, even for certificates nonlinear in the second block.\n\nThe grid alphabet is nonempty for the certificate's degree bound `deg M ≤ deg P`.\nThis is essential: on an empty positive-dimensional grid the constant one vanishes\nvacuously, but cannot have a degree-zero certificate with `M(X,0) = 0`.\n-/\n\nnamespace PCP.Algebraic.GridVanishing\n\nopen Finset MvPolynomial\n\nvariable {R σ : Type*} [CommRing R]\n\n/-- Substitute polynomials for the second block, keeping the first block formal. -/\nnoncomputable def substitute (Y : σ → MvPolynomial σ R) :\n    MvPolynomial (σ ⊕ σ) R →+* MvPolynomial σ R :=\n  eval₂Hom C (Sum.elim X Y)\n\n@[simp] theorem substitute_rename (Y : σ → MvPolynomial σ R) (p : MvPolynomial σ R) :\n    substitute Y (rename Sum.inl p) = p := by\n  rw [substitute, eval₂Hom_rename]\n  exact eval₂_eta p\n\n@[simp] theorem substitute_X_inl (Y : σ → MvPolynomial σ R) (i : σ) :\n    substitute Y (X (Sum.inl i)) = X i := by\n  simp [substitute]\n\n@[simp] theorem substitute_X_inr (Y : σ → MvPolynomial σ R) (i : σ) :\n    substitute Y (X (Sum.inr i)) = Y i := by\n  simp [substitute]\n\ntheorem eval_substitute (Y : σ → MvPolynomial σ R)\n    (M : MvPolynomial (σ ⊕ σ) R) (x : σ → R) :\n    eval x (substitute Y M) = eval (Sum.elim x (fun i => eval x (Y i))) M := by\n  simp only [substitute, coe_eval₂Hom, eval_eval₂]\n  congr 1\n  · ext a\n    simp\n  · funext i\n    cases i <;> simp\n\n/-- The algebraic conditions in Corollary 2.10, separate from degree bounds. -/\ndef IsCertificate (H : Finset R) (p : MvPolynomial σ R)\n    (M : MvPolynomial (σ ⊕ σ) R) : Prop :=\n  substitute (fun _ => 0) M = 0 ∧ substitute (coordinate H) M = p\n\n/-- Soundness uses the two formal identities and imposes no shape restriction on `M`. -/\ntheorem IsCertificate.vanishesOn {H : Finset R} {p : MvPolynomial σ R}\n    {M : MvPolynomial (σ ⊕ σ) R} (hM : IsCertificate H p M) : VanishesOn H p := by\n  intro x hx\n  rw [← hM.2, eval_substitute]\n  have hpoint : (fun i => eval x (coordinate H i)) = fun _ => 0 := by\n    funext i\n    exact eval_coordinate_eq_zero H i x (hx i)\n  rw [hpoint]\n  have h := congrArg (eval x) hM.1\n  simpa [eval_substitute] using h\n\nvariable [Fintype σ]\n\n/-- Package a family of coefficient polynomials into one polynomial in two blocks. -/\nnoncomputable def certificate (Q : σ → MvPolynomial σ R) : MvPolynomial (σ ⊕ σ) R :=\n  ∑ i, rename Sum.inl (Q i) * X (Sum.inr i)\n\ntheorem substitute_certificate (Y Q : σ → MvPolynomial σ R) :\n    substitute Y (certificate Q) = ∑ i, Q i * Y i := by\n  simp [certificate]\n\n@[simp] theorem substitute_zero_certificate (Q : σ → MvPolynomial σ R) :\n    substitute (fun _ => 0) (certificate Q) = 0 := by\n  simp [substitute_certificate]\n\ntheorem eval_certificate (Q : σ → MvPolynomial σ R) (x y : σ → R) :\n    eval (Sum.elim x y) (certificate Q) = ∑ i, eval x (Q i) * y i := by\n  simp [certificate, eval_rename, Function.comp_def]\n\ntheorem certificate_isCertificate (H : Finset R) (p : MvPolynomial σ R)\n    (Q : σ → MvPolynomial σ R) (hp : p = ∑ i, Q i * coordinate H i) :\n    IsCertificate H p (certificate Q) := by\n  exact ⟨substitute_zero_certificate Q, (substitute_certificate _ _).trans hp.symm⟩\n\nvariable [IsDomain R]\n\n/-- Packaging the coefficient polynomials preserves the original degree bound. -/\ntheorem totalDegree_certificate_le (H : Finset R) (hH : H.Nonempty)\n    (Q : σ → MvPolynomial σ R) (d : ℕ)\n    (hQ : ∀ i, Q i ≠ 0 → (Q i).totalDegree + H.card ≤ d) :\n    (certificate Q).totalDegree ≤ d := by\n  classical\n  apply totalDegree_finsetSum_le\n  intro i _\n  by_cases hi : Q i = 0\n  · simp [hi]\n  · calc\n      _ ≤ (rename Sum.inl (Q i)).totalDegree +\n          (X (Sum.inr i) : MvPolynomial (σ ⊕ σ) R).totalDegree :=\n        totalDegree_mul _ _\n      _ ≤ (Q i).totalDegree + 1 :=\n        add_le_add (totalDegree_rename_le _ _) (by simp)\n      _ ≤ (Q i).totalDegree + H.card := Nat.add_le_add_left (card_pos.mpr hH) _\n      _ ≤ d := hQ i hi\n\nomit [Fintype σ] in\n/-- Corollary 2.10, with the necessary nonempty-alphabet hypothesis. -/\ntheorem vanishesOn_iff_exists_certificate [Finite σ] (H : Finset R) (hH : H.Nonempty)\n    (p : MvPolynomial σ R) :\n    VanishesOn H p ↔ ∃ M : MvPolynomial (σ ⊕ σ) R,\n      M.totalDegree ≤ p.totalDegree ∧ IsCertificate H p M := by\n  let := Fintype.ofFinite σ\n  constructor\n  · intro hp\n    obtain ⟨Q, hQ, hsum⟩ := exists_decomposition H p hp\n    exact ⟨certificate Q, totalDegree_certificate_le H hH Q p.totalDegree hQ,\n      certificate_isCertificate H p Q hsum⟩\n  · rintro ⟨M, _, hM⟩\n    exact hM.vanishesOn\n\nomit [Fintype σ] in\n/-- Setting the certificate variables to zero does not increase total degree. -/\ntheorem totalDegree_substitute_zero_le (M : MvPolynomial (σ ⊕ σ) R) :\n    (substitute (fun _ => 0) M).totalDegree ≤ M.totalDegree := by\n  apply totalDegree_substitution_le_of_affine\n  intro i\n  cases i <;> simp\n\nomit [Fintype σ] in\n/-- Substitution by the vanishing polynomials multiplies degree by at most `|H|`. -/\ntheorem totalDegree_substitute_coordinate_le [Finite σ] (H : Finset R) (hH : H.Nonempty)\n    (M : MvPolynomial (σ ⊕ σ) R) :\n    (substitute (coordinate H) M).totalDegree ≤ M.totalDegree * H.card := by\n  apply totalDegree_substitution_le\n  intro i\n  cases i with\n  | inl i => simpa using card_pos.mpr hH\n  | inr i => exact (totalDegree_coordinate H i).le\n\nend PCP.Algebraic.GridVanishing\n"}