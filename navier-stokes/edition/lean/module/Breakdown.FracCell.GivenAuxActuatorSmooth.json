akdown.CellCert.GivenFields.modeFieldOf_contDiff_wave","Breakdown.Space"],"written":"fieldOf_contDiff_of_compact"}],"imports":["Breakdown.FracCell.GivenAuxActuatorOpen"],"module":"Breakdown.FracCell.GivenAuxActuatorSmooth","path":"Breakdown/FracCell/GivenAuxActuatorSmooth.lean","sha256":"454b03493cb414e6f862a2800909fe64afc05797461471942f50a8a7f01992e5","source":"import Breakdown.FracCell.GivenAuxActuatorOpen\n\nopen scoped ContDiff ENNReal\nopen MeasureTheory\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace CellCert\n\nnamespace GivenFields\n\nopen SteadyCert\n\nprivate theorem ofComponents_sum (s : Finset ℤ) (w : ℤ → Fin 3 → ℝ) :\n    ofComponents (fun i => ∑ n ∈ s, w n i) = ∑ n ∈ s, ofComponents (w n) := by\n  ext j\n  fin_cases j <;> simp [ofComponents]\n\ntheorem fieldOf_eq_sum_modes (P : ChartParams) (D : FieldData) (β : ℝ) :\n    fieldOf P D β = fun y => ∑ n ∈ D.modes, modeFieldOf P D β n y := by\n  funext y\n  unfold fieldOf modeFieldOf\n  rw [← ofComponents_sum]\n  congr 1\n  funext i\n  rw [Finset.mul_sum, Complex.re_sum]\n\ntheorem fieldOf_contDiff_of_compact (P : ChartParams) (hP : IsChartParams P) {e : ℕ} {tb : ℝ} {D : FieldData}\n    (hc : IsCompactFieldData P e tb D) (hpos : 0 < tb) (β : ℝ) : ContDiff ℝ 1 (fieldOf P D β) := by\n  rw [fieldOf_eq_sum_modes]\n  apply ContDiff.sum\n  intro n hn\n  by_cases h0 : n = 0\n  · subst h0\n    exact modeFieldOf_contDiff_mean P hP hc hpos β hn\n  · exact modeFieldOf_contDiff_wave P hP hc hpos β n hn h0\n\nend GivenFields\n\nend CellCert\n\nend Breakdown\n"}