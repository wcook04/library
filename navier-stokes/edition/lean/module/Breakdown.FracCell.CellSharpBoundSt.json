.CellCert.CellAnalysis.CellClasses","Breakdown.CellCert.CellAnalysis.CellRows","Breakdown.CellCert.CellAnalysis.CellRows.classRowWeight","Breakdown.CellCert.CellAnalysis.CellRows.rowSet","Breakdown.CellCert.CellAnalysis.CellRows.yModes","Breakdown.CellCert.CellAnalysis.CellScalars","Breakdown.CellCert.CellAnalysis.CellScalars.antiWeight","Breakdown.CellCert.CellAnalysis.CellScalars.degNear","Breakdown.CellCert.CellAnalysis.CellScalars.highCouplingField","Breakdown.CellCert.CellAnalysis.CellScalars.localCellForm","Breakdown.CellCert.CellAnalysis.CellScalars.resolved","Breakdown.CellCert.CellAnalysis.CellScalars.sharpForm","Breakdown.CellCert.CellAnalysis.CellScalars.symWeight","Breakdown.CellCert.CellAnalysis.CellScalars.velWeight","Breakdown.CellCert.CellAnalysis.IsAxisymmetricWeight","Breakdown.CellCert.CellAnalysis.IsCellData","Breakdown.CellCert.CellAnalysis.antiSq","Breakdown.CellCert.CellAnalysis.modeCoupling","Breakdown.CellCert.CellAnalysis.modeFieldPair","Breakdown.CellCert.CellAnalysis.modeLocalDensity","Breakdown.CellCert.CellAnalysis.symSq","Breakdown.CellCert.CellAnalysis.vecSq","Breakdown.CellCert.FracCellData","Breakdown.CellCert.FracCellData.modelActuatorGrad","Breakdown.CellCert.FracCellData.modelPinField","Breakdown.Space","Breakdown.SteadyCert.FracCertData.row","Breakdown.SteadyCert.l2Pair"],"used_by":["Breakdown.CellCert.CellAnalysis.cellSharpBound_of","Breakdown.CellCert.CellAnalysis.sharpCore_of","Breakdown.CellCert.CellAnalysis.sharpCore_of_leaves","Breakdown.CellCert.CellAnalysis.sharpCore_of_parts"],"uses":["Breakdown.CellCert.Assembly.FieldTuple","Breakdown.CellCert.Assembly.IsAdmissible","Breakdown.CellCert.Assembly.IsFormData","Breakdown.CellCert.CellAnalysis.CellBases","Breakdown.CellCert.CellAnalysis.CellBox","Breakdown.CellCert.CellAnalysis.CellBox.rect","Breakdown.CellCert.CellAnalysis.CellClasses","Breakdown.CellCert.CellAnalysis.CellRows","Breakdown.CellCert.CellAnalysis.CellRows.classRowWeight","Breakdown.CellCert.CellAnalysis.CellRows.rowSet","Breakdown.CellCert.CellAnalysis.CellRows.yModes","Breakdown.CellCert.CellAnalysis.CellScalars","Breakdown.CellCert.CellAnalysis.CellScalars.antiWeight","Breakdown.CellCert.CellAnalysis.CellScalars.degNear","Breakdown.CellCert.CellAnalysis.CellScalars.highCouplingField","Breakdown.CellCert.CellAnalysis.CellScalars.localCellForm","Breakdown.CellCert.CellAnalysis.CellScalars.resolved","Breakdown.CellCert.CellAnalysis.CellScalars.sharpForm","Breakdown.CellCert.CellAnalysis.CellScalars.symWeight","Breakdown.CellCert.CellAnalysis.CellScalars.velWeight","Breakdown.CellCert.CellAnalysis.IsAxisymmetricWeight","Breakdown.CellCert.CellAnalysis.IsCellData","Breakdown.CellCert.CellAnalysis.antiSq","Breakdown.CellCert.CellAnalysis.modeCoupling","Breakdown.CellCert.CellAnalysis.modeFieldPair","Breakdown.CellCert.CellAnalysis.modeLocalDensity","Breakdown.CellCert.CellAnalysis.symSq","Breakdown.CellCert.CellAnalysis.vecSq","Breakdown.CellCert.FracCellData","Breakdown.CellCert.FracCellData.modelActuatorGrad","Breakdown.CellCert.FracCellData.modelPinField","Breakdown.Space","Breakdown.SteadyCert.FracCertData.row","Breakdown.SteadyCert.l2Pair"],"written":"SharpCoreStatement"}],"imports":["Breakdown.FracCell.CellFormBoundSharpSt"],"module":"Breakdown.FracCell.CellSharpBoundSt","path":"Breakdown/FracCell/CellSharpBoundSt.lean","sha256":"0ceb17cbb178c689f1037258f317fa7161c5ce99e6539ca7b456440d25f43e51","source":"import Breakdown.FracCell.CellFormBoundSharpSt\n\nopen MeasureTheory\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace CellCert\n\nnamespace CellAnalysis\n\nopen SteadyCert Assembly\n\ndef IsWeightedSquareOn (K : CellBox) (F : ℝ × ℝ → ℂ) : Prop :=\n  AEStronglyMeasurable F (volume.restrict K.rect) ∧ IntegrableOn (fun p => K.lineWeight p.1 * ‖F p‖ ^ 2) K.rect\n\ndef SharpTargetSquareStatement : Prop :=\n  ∀ (α : ℝ), 1 < α → α < 5 / 4 → ∀ {k N : ℕ} (c : FracCellData k N), IsFormData α c →\n    ∀ (K : CellBox) (S : CellScalars) (B : CellBases) (Cl : CellClasses) {slots : ℕ}\n      (R : CellRows N slots k), IsCellData α c K S B Cl R → IsAxisymmetricWeight c K →\n    ∀ x : FieldTuple k, IsAdmissible c x → ∀ ζ : Fin k → ℝ,\n      (∀ n ∈ R.yModes, ∀ a b : Fin 3,\n          IsWeightedSquareOn K (fun p => CellScalars.yFolded c K S x.2.2.2.1 ζ x.1 x.2.1 n p a b)) ∧\n      (∀ n ∈ S.resolved, ∀ a : Fin 3,\n          IsWeightedSquareOn K (fun p => CellScalars.yVelocity c K S x.1 x.2.1 n p a)) ∧\n      (∀ r ∈ R.rowSet, ∀ n ∈ S.resolved ∪ S.band, ∀ a b : Fin 3,\n          IsWeightedSquareOn K (fun p => CellScalars.rowCouplingFolded c K S R r n p a b)) ∧\n      (∀ r ∈ R.rowSet, ∀ n ∈ S.resolved, ∀ a : Fin 3,\n          IsWeightedSquareOn K (fun p => CellScalars.rowCouplingVelocity c K R r n p a))\n\ndef SharpCoreStatement : Prop :=\n  ∀ (α : ℝ), 1 < α → α < 5 / 4 → ∀ {k N : ℕ} (c : FracCellData k N), IsFormData α c →\n    ∀ (K : CellBox) (S : CellScalars) (B : CellBases) (Cl : CellClasses) {slots : ℕ}\n      (R : CellRows N slots k), IsCellData α c K S B Cl R → IsAxisymmetricWeight c K →\n    ∀ x : FieldTuple k, IsAdmissible c x → ∀ ζ : Fin k → ℝ, ∀ μ : Fin N → ℝ, (∀ a ∉ R.rowSet, μ a = 0) →\n      ∃ (σ : ℤ → ℕ → ℕ → Fin 3 → Fin 3 → ℂ) (τ : ℤ → ℕ → ℕ → Fin 3 → ℂ),\n        Summable (fun jl : ℕ × ℕ => if S.degNear < max jl.1 jl.2 then\n            (∑ n ∈ R.yModes, (S.symWeight n jl.1 jl.2 * symSq (σ n jl.1 jl.2)\n              + S.antiWeight n jl.1 jl.2 * antiSq (σ n jl.1 jl.2)))\n            + ∑ n ∈ S.resolved, S.velWeight n jl.1 jl.2 * vecSq (τ n jl.1 jl.2)\n          else 0) ∧\n        CellScalars.localCellForm c K S Cl x.2.2.2.1 ζ x.1 x.2.1 x.2.2.1\n            + CellScalars.sharpForm c K S R B μ x.2.2.2.1 ζ x.1 x.2.1 σ τ\n            - ∑ a ∈ R.rowSet, R.classRowWeight a * μ a ^ 2\n          ≤ (∫ p in K.rect, p.1 * ((∑' n : ℤ, modeLocalDensity c α x n p) + modeCoupling c x p\n                + ∑ i, x.2.2.2.1 i * modeFieldPair c x.2.1 (c.modelActuatorGrad i) p))\n            + (∑ i, 2 * ζ i * ∫ p in K.rect, p.1 * modeFieldPair c x.2.1 (c.modelPinField i) p)\n            + 2 / (4 * Real.pi) *\n                ∑ a ∈ R.rowSet, μ a * l2Pair (CellScalars.highCouplingField c K S x.1 x.2.1) (c.row a)\n\nend CellAnalysis\n\nend CellCert\n\nend Breakdown\n"}