kdown.WeakProfile.PairingVelocity","Breakdown.WeakProfile.spaceScale"],"used_by":["Breakdown.WeakProfile.Internal.PhysicalIdentity.pairing_timeChange","Breakdown.WeakProfile.Internal.PhysicalIdentity.weakRate_timeChange","Breakdown.WeakProfile.PhysicalIdentity","Breakdown.WeakProfile.WeakOrbitOfParts","Breakdown.WeakProfile.pairingDilate_holds"],"uses":["Breakdown.Freq.CSpace","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Freq.dilX","Breakdown.Freq.embedX","Breakdown.IsTestField","Breakdown.Space","Breakdown.WeakProfile.PairingVelocity","Breakdown.WeakProfile.spaceScale"],"written":"PairingDilate"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":49,"kind":"def","line":47,"module":"Breakdown.Weak.StatementsSlice","name":"Breakdown.WeakProfile.TrilinearDilate","namespace":"Breakdown.WeakProfile","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"TrilinearDilate","signature_end_line":47,"sorry":false,"statement_used_by":["Breakdown.WeakProfile.Internal.PhysicalIdentity.trilinear_timeChange","Breakdown.WeakProfile.Internal.PhysicalIdentity.weakRate_timeChange","Breakdown.WeakProfile.PhysicalIdentity","Breakdown.WeakProfile.WeakOrbitOfParts","Breakdown.WeakProfile.trilinearDilate_holds"],"statement_uses":["Breakdown.Freq.CSpace","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Freq.dilX","Breakdown.Freq.trilinear","Breakdown.IsTestField","Breakdown.Space","Breakdown.WeakProfile.VelocityWeakGradient","Breakdown.WeakProfile.spaceScale"],"used_by":["Breakdown.WeakProfile.Internal.PhysicalIdentity.trilinear_timeChange","Breakdown.WeakProfile.Internal.PhysicalIdentity.weakRate_timeChange","Breakdown.WeakProfile.PhysicalIdentity","Breakdown.WeakProfile.WeakOrbitOfParts","Breakdown.WeakProfile.trilinearDilate_holds"],"uses":["Breakdown.Freq.CSpace","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Freq.dilX","Breakdown.Freq.trilinear","Breakdown.IsTestField","Breakdown.Space","Breakdown.WeakProfile.VelocityWeakGradient","Breakdown.WeakProfile.spaceScale"],"written":"TrilinearDilate"}],"imports":["Breakdown.Weak.Basic"],"module":"Breakdown.Weak.StatementsSlice","path":"Breakdown/Weak/StatementsSlice.lean","sha256":"42b8f78a829b0bc46d4a0cb1ea976620f646e9701fe21ea5920101c4939e5510","source":"import Breakdown.Weak.Basic\n\nopen MeasureTheory Set Real\nopen scoped ENNReal ContDiff\n\nnoncomputable section\n\nnamespace Breakdown.WeakProfile\n\nopen Freq\n\ndef PairingVelocity : Prop :=\n  ∀ (x : X) (φ : Space → Space), IsTestField φ →\n    inner ℝ x (embedX φ) = ∫ y, inner ℝ ((velocity x : Space → Space) y) (negSsp φ y)\n\ndef VelocityWeakGradient : Prop :=\n  ∀ (x : X) (φ : Space → ℝ), IsTestFunction φ → ∀ j : Fin 3,\n    ∫ y, φ y • (partialX j x : Space → Space) y =\n      -∫ y, fderiv ℝ φ y (unitVector j) • (velocity x : Space → Space) y\n\ndef ZeroGradientSix : Prop :=\n  ∀ f : Space → Space, MemLp f 6 volume →\n    (∀ φ : Space → ℝ, IsTestFunction φ → ∀ j : Fin 3,\n      ∫ y, fderiv ℝ φ y (unitVector j) • f y = 0) →\n    f =ᵐ[volume] 0\n\ndef GradientFreqTr : Prop :=\n  ∀ (f : Space → Space) (g : Space → (Space →L[ℝ] Space)) (C : ℝ), IsSlice f g C →\n    ∃ x : X, ∀ j, (partialX j x : Space → Space) =ᵐ[volume] gradComponent g j\n\ndef SliceEmbedding : Prop :=\n  PairingVelocity → VelocityWeakGradient → ZeroGradientSix → GradientFreqTr →\n  ∀ (f : Space → Space) (g : Space → (Space →L[ℝ] Space)) (C : ℝ), IsSlice f g C →\n    ∃ x : X, (velocity x : Space → Space) =ᵐ[volume] f ∧\n      (∀ j, (partialX j x : Space → Space) =ᵐ[volume] gradComponent g j) ∧\n      ‖x‖ ^ 2 ≤ 3 * max C 0\n\ndef AdvectionByParts : Prop :=\n  ∀ (x : X) (ψ : Space → Space), IsTestField ψ →\n    ∫ y, ∑ i : Fin 3, (velocity x : Space → Space) y i *\n      inner ℝ ((velocity x : Space → Space) y) (fderiv ℝ ψ y (unitVector i)) = -trilinear x x ψ\n\ndef PairingDilate : Prop :=\n  PairingVelocity → ∀ μ : ℝ, 0 < μ → ∀ (x : X) (φ : Space → Space), IsTestField φ →\n    inner ℝ (dilX μ x) (embedX φ) = inner ℝ x (embedX (spaceScale (Real.sqrt μ)⁻¹ φ))\n\ndef TrilinearDilate : Prop :=\n  VelocityWeakGradient → ∀ μ : ℝ, 0 < μ → ∀ (x : X) (ψ : Space → Space), IsTestField ψ →\n    trilinear (dilX μ x) (dilX μ x) ψ = trilinear x x (spaceScale (Real.sqrt μ)⁻¹ ψ)\n\nend Breakdown.WeakProfile\n"}