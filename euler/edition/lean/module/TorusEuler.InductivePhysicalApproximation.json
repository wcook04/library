},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":"Nonzero oscillation lies within inverse parent-frequency distance of\nsome lattice point in the actual Eulerian coordinates.","end_line":78,"kind":"theorem","line":63,"module":"TorusEuler.InductivePhysicalApproximation","name":"TorusEuler.InductiveEulerStage.OnSlab.physicalApproximation_oscillation_support","namespace":"TorusEuler.InductiveEulerStage.OnSlab","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["TorusEuler.InductiveEulerTip.SelectedLaterInput.oscillation_support","TorusEuler.InductiveFirstWaveSelection.oscillation_support"],"proof_uses":["TorusEuler.ChildFlow.DeformationOn.bounds","TorusEuler.ChildFlow.DeformationOn.flow","TorusEuler.HierarchyOperators.labelAdv","TorusEuler.HierarchyPeriodicProfile","TorusEuler.HierarchyProfilePoint","TorusEuler.HierarchyProfiles.B","TorusEuler.HierarchySmoothProfile","TorusEuler.HierarchyTwistedProfile","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.inactive","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.operators","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.profiles","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.residual","TorusEuler.HierarchyTwistedProfile.graphRead","TorusEuler.InductiveEulerStage.OnSlab.deformationOn","TorusEuler.InductiveEulerStage.OnSlab.smooth_velocity","TorusEuler.InductiveEulerStage.OnSlab.subset","TorusEuler.InductiveEulerStage.odd_velocity","TorusEuler.InductiveEulerStage.periodic_velocity","TorusEuler.IsLabelFlowOn.exists_lattice_dist_le_inv_of_inverse_mem_periodicEnvelope_tsupport","TorusEuler.hierarchyTailPairs","TorusEuler.instAddCommGroupHierarchyTwistedProfile","TorusEuler.instModuleHierarchyTwistedProfile"],"protected":false,"short":"physicalApproximation_oscillation_support","signature_end_line":69,"sorry":false,"statement_used_by":[],"statement_uses":["TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.oscillation","TorusEuler.HierarchyTwistedProfile.PhysicalLeadingInput","TorusEuler.HierarchyTwistedProfile.PhysicalLeadingInput.Inactive","TorusEuler.InductiveEulerParameters","TorusEuler.InductiveEulerParameters.frequency","TorusEuler.InductiveEulerStage","TorusEuler.InductiveEulerStage.OnSlab","TorusEuler.InductiveEulerStage.OnSlab.geometry","TorusEuler.InductiveEulerStage.OnSlab.physicalApproximationData","TorusEuler.InductiveEulerStage.flow","TorusEuler.InductiveEulerStage.pressure","TorusEuler.InductiveEulerStage.velocity","TorusEuler.Vec3","TorusEuler.latticeVector","TorusEuler.periodizeCentered","TorusEuler.radialEnvelope"],"used_by":["TorusEuler.InductiveEulerTip.SelectedLaterInput.oscillation_support","TorusEuler.InductiveFirstWaveSelection.oscillation_support"],"uses":["TorusEuler.ChildFlow.DeformationOn.bounds","TorusEuler.ChildFlow.DeformationOn.flow","TorusEuler.HierarchyOperators.labelAdv","TorusEuler.HierarchyPeriodicProfile","TorusEuler.HierarchyProfilePoint","TorusEuler.HierarchyProfiles.B","TorusEuler.HierarchySmoothProfile","TorusEuler.HierarchyTwistedProfile","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.inactive","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.operators","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.oscillation","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.profiles","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.residual","TorusEuler.HierarchyTwistedProfile.PhysicalLeadingInput","TorusEuler.HierarchyTwistedProfile.PhysicalLeadingInput.Inactive","TorusEuler.HierarchyTwistedProfile.graphRead","TorusEuler.InductiveEulerParameters","TorusEuler.InductiveEulerParameters.frequency","TorusEuler.InductiveEulerStage","TorusEuler.InductiveEulerStage.OnSlab","TorusEuler.InductiveEulerStage.OnSlab.deformationOn","TorusEuler.InductiveEulerStage.OnSlab.geometry","TorusEuler.InductiveEulerStage.OnSlab.physicalApproximationData","TorusEuler.InductiveEulerStage.OnSlab.smooth_velocity","TorusEuler.InductiveEulerStage.OnSlab.subset","TorusEuler.InductiveEulerStage.flow","TorusEuler.InductiveEulerStage.odd_velocity","TorusEuler.InductiveEulerStage.periodic_velocity","TorusEuler.InductiveEulerStage.pressure","TorusEuler.InductiveEulerStage.velocity","TorusEuler.IsLabelFlowOn.exists_lattice_dist_le_inv_of_inverse_mem_periodicEnvelope_tsupport","TorusEuler.Vec3","TorusEuler.hierarchyTailPairs","TorusEuler.instAddCommGroupHierarchyTwistedProfile","TorusEuler.instModuleHierarchyTwistedProfile","TorusEuler.latticeVector","TorusEuler.periodizeCentered","TorusEuler.radialEnvelope"],"written":"physicalApproximation_oscillation_support"}],"imports":["TorusEuler.HierarchyPhysicalApproximation","TorusEuler.InductiveParentGeometry","TorusEuler.PhysicalWaveEnvelopeSupport"],"module":"TorusEuler.InductivePhysicalApproximation","path":"TorusEuler/InductivePhysicalApproximation.lean","sha256":"ebb58ad196a3dd1ffed34649b9a806d2082f6eee9f2730f61a693ec81772d15c","source":"import TorusEuler.HierarchyPhysicalApproximation\nimport TorusEuler.InductiveParentGeometry\nimport TorusEuler.PhysicalWaveEnvelopeSupport\n\n/-! The physical hierarchy over the actual inductive parent on the next slab. -/\n\nopen Set\nopen scoped ContDiff\n\nnamespace TorusEuler.InductiveEulerStage.OnSlab\n\nopen HierarchyTwistedProfile\n\nnoncomputable section\n\nvariable {P : InductiveEulerParameters} {n : ℕ} {activation T : ℝ}\n  {s : InductiveEulerStage P n activation} {hT : 0 < T} {k : Vec3}\n\n/-- Use the same pulled-back residual furnished with the parent geometry,\nso its quantitative estimates apply to the selected hierarchy. -/\ndef physicalApproximationData (d : s.OnSlab hT k) (hT₁ : T ≤ 1)\n    (L : PhysicalLeadingInput d.geometry) (depth : ℕ) : PhysicalApproximationData d.geometry s.pressure depth where\n  time_le_one := hT₁\n  leading := L\n  parentResidual := d.residualProfile\n  parentResidual_average := d.residualProfile_mean\n  parentResidual_value z hz := (d.residualProfile_value z hz).trans\n    (congrFun (d.momentum_same z.1 hz.1) _).symm\n  parentResidual_odd := d.residualProfile_odd\n\n@[simp] theorem physicalApproximationData_leading (d : s.OnSlab hT k) (hT₁ : T ≤ 1)\n    (L : PhysicalLeadingInput d.geometry) (depth : ℕ) : (d.physicalApproximationData hT₁ L depth).leading = L :=\n  rfl\n\n@[simp] theorem physicalApproximationData_parentResidual (d : s.OnSlab hT k) (hT₁ : T ≤ 1)\n    (L : PhysicalLeadingInput d.geometry) (depth : ℕ) :\n    (d.physicalApproximationData hT₁ L depth).parentResidual = d.residualProfile :=\n  rfl\n\n/-- The physical approximation over the restricted parent has all the\nqualitative properties required as input to the actual periodic cutoff. -/\ntheorem physicalApproximationProperties (d : s.OnSlab hT k) (hT₁ : T ≤ 1)\n    (L : PhysicalLeadingInput d.geometry) {depth : ℕ} (hDepth : 2 ≤ depth) :\n    PhysicalApproximationProperties (d.physicalApproximationData hT₁ L depth) :=\n  (d.physicalApproximationData hT₁ L depth).assemble_of_parent hDepth d.deformationOn.flow\n    d.smooth_velocity d.smooth_pressure (fun t _ => s.periodic_velocity t)\n    (fun t ht => s.periodic_pressure t (d.subset ht)) (fun t ht => s.odd_velocity t (d.subset ht))\n    (fun t ht => s.divergence_free t (d.subset ht))\n\n/-- The actual oscillatory correction vanishes through positive activation. -/\ntheorem physicalApproximation_oscillation_vanishes (d : s.OnSlab hT k) (hT₁ : T ≤ 1)\n    (L : PhysicalLeadingInput d.geometry) {depth : ℕ} (hDepth : 1 ≤ depth)\n    {τ ℓ : ℝ} (hτ : 0 < τ) (hτT : τ ≤ T)\n    (hL : L.Inactive τ (tsupport (periodizeCentered (radialEnvelope ℓ)))) :\n    ∀ t ∈ Icc 0 τ, (d.physicalApproximationData hT₁ L depth).oscillation t = 0 := by\n  intro t ht\n  funext x\n  exact (d.physicalApproximationData hT₁ L depth).oscillation_eq_zero_through_activation\n    hDepth (isClosed_tsupport (periodizeCentered (radialEnvelope ℓ))) hτ hL ⟨ht.1, ht.2.trans hτT⟩ x (Or.inl ht.2)\n\n/-- Nonzero oscillation lies within inverse parent-frequency distance of\nsome lattice point in the actual Eulerian coordinates. -/\ntheorem physicalApproximation_oscillation_support (d : s.OnSlab hT k) (hT₁ : T ≤ 1)\n    (L : PhysicalLeadingInput d.geometry) {depth : ℕ} (hDepth : 1 ≤ depth)\n    {τ ℓ D : ℝ} (hℓ : 0 < ℓ) (hμ : 2 ≤ P.frequency n) (hD : P.frequency n ≤ D)\n    (hRadius : ℓ ≤ (D ^ (3 : ℕ))⁻¹)\n    (hL : L.Inactive τ (tsupport (periodizeCentered (radialEnvelope ℓ)))) :\n    ∀ t ∈ Icc 0 T, ∀ x, (d.physicalApproximationData hT₁ L depth).oscillation t x ≠ 0 →\n      ∃ z : Fin 3 → ℤ, dist (latticeVector z) x ≤ (P.frequency n)⁻¹ := by\n  let b := d.physicalApproximationData hT₁ L depth\n  intro t ht x hV\n  have hLabel : s.flow t 0 x ∈ tsupport (periodizeCentered (radialEnvelope ℓ)) := by\n    by_contra h\n    exact hV (b.inactive hDepth (isClosed_tsupport (periodizeCentered (radialEnvelope ℓ))) hL ht x (Or.inr h)).1\n  exact d.deformationOn.flow.exists_lattice_dist_le_inv_of_inverse_mem_periodicEnvelope_tsupport\n    hT hℓ (d.smooth_velocity.of_le (by simp)) (fun t _ => s.periodic_velocity t)\n    (fun t ht => s.odd_velocity t (d.subset ht)) ht hμ hD hRadius\n    (fun a => ((d.deformationOn.bounds t ht).2.1 a).2.trans hD) hLabel\n\nend\n\nend TorusEuler.InductiveEulerStage.OnSlab\n"}