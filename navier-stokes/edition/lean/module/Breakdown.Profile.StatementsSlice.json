ace"],"used_by":["Breakdown.EmbeddedOrbitOfParts","Breakdown.OrbitOfParts","Breakdown.Periodic.ApproxClose.Internal.embedContinuous","Breakdown.Periodic.ApproxClose.Internal.profileContinuous","Breakdown.physicalMild_holds","Breakdown.sliceDecay_holds"],"uses":["Breakdown.IsDecayField","Breakdown.IsSimilarityProfile","Breakdown.Space"],"written":"SliceDecay"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":25,"kind":"def","line":22,"module":"Breakdown.Profile.StatementsSlice","name":"Breakdown.SimilarityDerivBound","namespace":"Breakdown","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"SimilarityDerivBound","signature_end_line":22,"sorry":false,"statement_used_by":["Breakdown.physicalDifference_holds","Breakdown.physicalPairingDeriv_holds","Breakdown.similarityDerivBound_holds"],"statement_uses":["Breakdown.IsSimilarityProfile","Breakdown.Space"],"used_by":["Breakdown.physicalDifference_holds","Breakdown.physicalPairingDeriv_holds","Breakdown.similarityDerivBound_holds"],"uses":["Breakdown.IsSimilarityProfile","Breakdown.Space"],"written":"SimilarityDerivBound"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":31,"kind":"def","line":27,"module":"Breakdown.Profile.StatementsSlice","name":"Breakdown.SliceGradientContinuous","namespace":"Breakdown","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"SliceGradientContinuous","signature_end_line":27,"sorry":false,"statement_used_by":["Breakdown.EmbeddedOrbitOfParts","Breakdown.OrbitOfParts","Breakdown.Periodic.ApproxClose.Internal.embedContinuous","Breakdown.Periodic.ApproxClose.Internal.profileContinuous","Breakdown.Periodic.approxClose","Breakdown.sliceGradientContinuous_holds"],"statement_uses":["Breakdown.IsSimilarityProfile","Breakdown.Space","Breakdown.unitVector"],"used_by":["Breakdown.EmbeddedOrbitOfParts","Breakdown.OrbitOfParts","Breakdown.Periodic.ApproxClose.Internal.embedContinuous","Breakdown.Periodic.ApproxClose.Internal.profileContinuous","Breakdown.Periodic.approxClose","Breakdown.sliceGradientContinuous_holds"],"uses":["Breakdown.IsSimilarityProfile","Breakdown.Space","Breakdown.unitVector"],"written":"SliceGradientContinuous"}],"imports":["Breakdown.Profile.StatementsField"],"module":"Breakdown.Profile.StatementsSlice","path":"Breakdown/Profile/StatementsSlice.lean","sha256":"b7793ee002f86846aa3c7feed0c252c52d21e56bd3a8e73a3a1a2633b9436062","source":"import Breakdown.Profile.StatementsField\n\nopen scoped ContDiff\nopen MeasureTheory Set Real\n\nnoncomputable section\n\nnamespace Breakdown\n\nstructure IsSimilarityProfile (W : ℝ → Space → Space) (q : ℝ → Space → ℝ) (C : ℝ) : Prop where\n  smooth : ContDiff ℝ ∞ (fun z : ℝ × Space => W z.1 z.2)\n  smooth_pressure : ContDiff ℝ ∞ (fun z : ℝ × Space => q z.1 z.2)\n  residual : ∀ s y, SimilarityResidual W q s y = 0\n  div : ∀ s y, divergenceAt (W s) y = 0\n  decay : ∀ s y, ∀ j ≤ 2, ‖iteratedFDeriv ℝ j (W s) y‖ ≤ C / (1 + ‖y‖) ^ (j + 1)\n  decay_pressure : ∀ s y, ‖fderiv ℝ (q s) y‖ ≤ C / (1 + ‖y‖) ^ 3\n\ndef SliceDecay : Prop :=\n  ∀ (W : ℝ → Space → Space) (q : ℝ → Space → ℝ) (C : ℝ), IsSimilarityProfile W q C →\n    ∀ s, IsDecayField (W s)\n\ndef SimilarityDerivBound : Prop :=\n  ∀ (W : ℝ → Space → Space) (q : ℝ → Space → ℝ) (C : ℝ), IsSimilarityProfile W q C →\n    ∃ K : ℝ, ∀ s y, ‖deriv (fun σ => W σ y) s + (1 / 2 : ℝ) • W s y\n      + (1 / 2 : ℝ) • fderiv ℝ (W s) y y‖ ≤ K / (1 + ‖y‖) ^ 3\n\ndef SliceGradientContinuous : Prop :=\n  ∀ (W : ℝ → Space → Space) (q : ℝ → Space → ℝ) (C : ℝ), IsSimilarityProfile W q C →\n    ∀ s₀, Filter.Tendsto\n      (fun s => ∫ y, ∑ i : Fin 3, ‖fderiv ℝ (W s - W s₀) y (unitVector i)‖ ^ 2)\n      (nhds s₀) (nhds 0)\n\nend Breakdown\n"}