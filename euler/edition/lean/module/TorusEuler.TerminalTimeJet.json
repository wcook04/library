,"proof_uses":["TorusEuler.slabTimeJet_smooth","TorusEuler.slabTimeJet_succ"],"protected":false,"short":"hasDerivWithinAt_slabTimeJet","signature_end_line":58,"sorry":false,"statement_used_by":[],"statement_uses":["TorusEuler.Vec3","TorusEuler.slabTimeJet"],"used_by":["TorusEuler.TerminalMixedJetBound.slabTimeJet_apply_clm","TorusEuler.exists_slabTimeJet_torusFourierBand","TorusEuler.slabTimeJet_comp_clm","TorusEuler.slabTimeJet_eq_of_subset","TorusEuler.slabTimeJet_periodicLerayHolderLift"],"uses":["TorusEuler.Vec3","TorusEuler.slabTimeJet","TorusEuler.slabTimeJet_smooth","TorusEuler.slabTimeJet_succ"],"written":"hasDerivWithinAt_slabTimeJet"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":72,"kind":"theorem","line":64,"module":"TorusEuler.TerminalTimeJet","name":"TorusEuler.slabTimeJet_periodic","namespace":"TorusEuler","noncomputable":false,"private":false,"proof_used_by":["TorusEuler.EndpointSlabHalfHolderJets.mul_norm_terminalTimeJet_le_labelNorm","TorusEuler.HierarchyTwistedProfile.rawMean_timeJet_labelNorm_le","TorusEuler.HierarchyTwistedProfile.spatiallyPeriodic_eulerianTimeJet_graphRead","TorusEuler.InductiveEulerStage.exists_slabTimeJet_succ_velocity_bound","TorusEuler.TruncatedChildStage.slabTimeJet_cutoffVelocity_rate","TorusEuler.TruncatedChildStage.slabTimeJet_velocityTail","TorusEuler.exists_continuousTorusTimeJets","TorusEuler.exists_slabTimeJet_torusFourierBand","TorusEuler.exists_terminalTimeCutoffResidualBudget","TorusEuler.slabTimeJet_normContinuity","TorusEuler.slabTimeJet_periodicLerayHolderLift"],"proof_uses":["TorusEuler.latticeVector","TorusEuler.slabTimeJet_succ","TorusEuler.slabTimeJet_zero"],"protected":false,"short":"slabTimeJet_periodic","signature_end_line":66,"sorry":false,"statement_used_by":[],"statement_uses":["TorusEuler.SpatiallyPeriodic","TorusEuler.Vec3","TorusEuler.slabTimeJet"],"used_by":["TorusEuler.EndpointSlabHalfHolderJets.mul_norm_terminalTimeJet_le_labelNorm","TorusEuler.HierarchyTwistedProfile.rawMean_timeJet_labelNorm_le","TorusEuler.HierarchyTwistedProfile.spatiallyPeriodic_eulerianTimeJet_graphRead","TorusEuler.InductiveEulerStage.exists_slabTimeJet_succ_velocity_bound","TorusEuler.TruncatedChildStage.slabTimeJet_cutoffVelocity_rate","TorusEuler.TruncatedChildStage.slabTimeJet_velocityTail","TorusEuler.exists_continuousTorusTimeJets","TorusEuler.exists_slabTimeJet_torusFourierBand","TorusEuler.exists_terminalTimeCutoffResidualBudget","TorusEuler.slabTimeJet_normContinuity","TorusEuler.slabTimeJet_periodicLerayHolderLift"],"uses":["TorusEuler.SpatiallyPeriodic","TorusEuler.Vec3","TorusEuler.latticeVector","TorusEuler.slabTimeJet","TorusEuler.slabTimeJet_succ","TorusEuler.slabTimeJet_zero"],"written":"slabTimeJet_periodic"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":"A time jet on a smaller nondegenerate slab agrees with the parent jet, including its endpoints.","end_line":86,"kind":"theorem","line":75,"module":"TorusEuler.TerminalTimeJet","name":"TorusEuler.slabTimeJet_eq_of_subset","namespace":"TorusEuler","noncomputable":false,"private":false,"proof_used_by":["TorusEuler.ScheduledEulerConstruction.exists_scheduledParentMixedJetBounds","TorusEuler.TerminalMixedJetBound.restrict_time"],"proof_uses":["TorusEuler.hasDerivWithinAt_slabTimeJet","TorusEuler.slabTimeJet_succ","TorusEuler.slabTimeJet_zero"],"protected":false,"short":"slabTimeJet_eq_of_subset","signature_end_line":79,"sorry":false,"statement_used_by":[],"statement_uses":["TorusEuler.Vec3","TorusEuler.slabTimeJet"],"used_by":["TorusEuler.ScheduledEulerConstruction.exists_scheduledParentMixedJetBounds","TorusEuler.TerminalMixedJetBound.restrict_time"],"uses":["TorusEuler.Vec3","TorusEuler.hasDerivWithinAt_slabTimeJet","TorusEuler.slabTimeJet","TorusEuler.slabTimeJet_succ","TorusEuler.slabTimeJet_zero"],"written":"slabTimeJet_eq_of_subset"}],"imports":["Mathlib.Analysis.Calculus.IteratedDeriv.Lemmas","TorusEuler.TruncatedParentProjectedMomentum"],"module":"TorusEuler.TerminalTimeJet","path":"TorusEuler/TerminalTimeJet.lean","sha256":"1b7ef2390f3c253dc18bba435c9dc500311f0dab453881fa2fc8aa5d4eeba73a","source":"import Mathlib.Analysis.Calculus.IteratedDeriv.Lemmas\nimport TorusEuler.TruncatedParentProjectedMomentum\n\n/-! Fixed-spatial-point time derivatives on a closed Euler time slab. -/\n\nopen Set\nopen scoped ContDiff\n\nnamespace TorusEuler\n\nvariable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]\n\n/-- The Eulerian time jet evaluates the within-time derivative at a fixed spatial point. -/\nnoncomputable abbrev slabTimeJet (a b : ℝ) (q : ℕ) (f : ℝ → Vec3 → E) (t : ℝ) (x : Vec3) :=\n  iteratedDerivWithin q (fun r => f r x) (Icc a b) t\n\n@[simp] theorem slabTimeJet_zero (a b : ℝ) (f : ℝ → Vec3 → E) :\n    slabTimeJet a b 0 f = f := by\n  funext t x\n  change iteratedDerivWithin 0 (fun r => f r x) (Icc a b) t = f t x\n  simp only [iteratedDerivWithin_zero]\n\ntheorem slabTimeJet_succ (a b : ℝ) (q : ℕ) (f : ℝ → Vec3 → E) (t : ℝ) (x : Vec3) :\n    slabTimeJet a b (q + 1) f t x =\n      derivWithin (fun r => slabTimeJet a b q f r x) (Icc a b) t := by\n  rw [slabTimeJet, iteratedDerivWithin_succ]\n\ntheorem slabTimeJet_succ' (a b : ℝ) (q : ℕ) (f : ℝ → Vec3 → E) :\n    slabTimeJet a b (q + 1) f =\n      slabTimeJet a b q (fun t x => derivWithin (fun r => f r x) (Icc a b) t) := by\n  funext t x\n  exact congrFun (iteratedDerivWithin_succ' (n := q) (f := fun r => f r x) (s := Icc a b)) t\n\ntheorem slabTimeJet_smooth {a b : ℝ} {f : ℝ → Vec3 → E} (hab : a < b)\n    (hf : ContDiffOn ℝ ∞ (Function.uncurry f) (Icc a b ×ˢ (univ : Set Vec3))) (q : ℕ) :\n    ContDiffOn ℝ ∞ (Function.uncurry (slabTimeJet a b q f)) (Icc a b ×ˢ (univ : Set Vec3)) := by\n  induction q with\n  | zero => simpa only [slabTimeJet_zero] using hf\n  | succ q ih =>\n    have h : slabTimeJet a b (q + 1) f =\n      (fun t x => derivWithin (fun r => slabTimeJet a b q f r x) (Icc a b) t) :=\n      funext fun t => funext fun x => slabTimeJet_succ a b q f t x\n    rw [h]\n    exact contDiffOn_sliceTimeDerivWithin_Icc hab ih\n\ntheorem slabTimeJet_slice_smooth {a b : ℝ} {f : ℝ → Vec3 → E} (hab : a < b)\n    (hf : ContDiffOn ℝ ∞ (Function.uncurry f) (Icc a b ×ˢ (univ : Set Vec3)))\n    (q : ℕ) {t : ℝ} (ht : t ∈ Icc a b) :\n    ContDiff ℝ ∞ (slabTimeJet a b q f t) := by\n  have h := slabTimeJet_smooth hab hf q\n  exact contDiffOn_univ.mp\n    (h.comp (contDiff_const.prodMk contDiff_id).contDiffOn (fun x _ => ⟨ht, mem_univ x⟩))\n\ntheorem hasDerivWithinAt_slabTimeJet {a b : ℝ} {f : ℝ → Vec3 → E} (hab : a < b)\n    (hf : ContDiffOn ℝ ∞ (Function.uncurry f) (Icc a b ×ˢ (univ : Set Vec3)))\n    (q : ℕ) {t : ℝ} (ht : t ∈ Icc a b) (x : Vec3) :\n    HasDerivWithinAt (fun r => slabTimeJet a b q f r x)\n      (slabTimeJet a b (q + 1) f t x) (Icc a b) t := by\n  rw [slabTimeJet_succ]\n  have h := (slabTimeJet_smooth hab hf q).comp (contDiff_id.prodMk contDiff_const).contDiffOn\n    (fun r hr => ⟨hr, mem_univ x⟩)\n  exact (h.differentiableOn (by simp) t ht).hasDerivWithinAt\n\ntheorem slabTimeJet_periodic {a b : ℝ} {f : ℝ → Vec3 → E}\n    (hf : ∀ t ∈ Icc a b, SpatiallyPeriodic (f t)) (q : ℕ) {t : ℝ} (ht : t ∈ Icc a b) :\n    SpatiallyPeriodic (slabTimeJet a b q f t) := by\n  induction q generalizing t with\n  | zero => simpa only [slabTimeJet_zero] using hf t ht\n  | succ q ih =>\n    intro k x\n    simp_rw [slabTimeJet_succ]\n    exact derivWithin_congr (fun r hr => ih hr k x) (ih ht k x)\n\n/-- A time jet on a smaller nondegenerate slab agrees with the parent jet, including its endpoints. -/\ntheorem slabTimeJet_eq_of_subset {a b c d : ℝ} {f : ℝ → Vec3 → E}\n    (hcd : c < d) (hsub : Icc c d ⊆ Icc a b)\n    (hab : a < b) (hf : ContDiffOn ℝ ∞ (Function.uncurry f) (Icc a b ×ˢ (univ : Set Vec3)))\n    (q : ℕ) {t : ℝ} (ht : t ∈ Icc c d) (x : Vec3) :\n    slabTimeJet c d q f t x = slabTimeJet a b q f t x := by\n  induction q generalizing t with\n  | zero => simp\n  | succ q ih =>\n    rw [slabTimeJet_succ c d]\n    refine (derivWithin_congr (fun r hr => ih hr) (ih ht)).trans ?_\n    exact ((hasDerivWithinAt_slabTimeJet hab hf q (hsub ht) x).mono hsub).derivWithin\n      (uniqueDiffOn_Icc hcd t ht)\n\nend TorusEuler\n"}