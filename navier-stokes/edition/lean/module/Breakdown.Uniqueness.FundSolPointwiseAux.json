te","Breakdown.Internal.abs_potential_le_of_support"],"uses":["Breakdown.FundSol.Internal.ballPow","Breakdown.FundSol.Internal.integral_ballPow","Breakdown.Space"],"written":"integral_ballPow_one"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":74,"kind":"theorem","line":71,"module":"Breakdown.Uniqueness.FundSolPointwiseAux","name":"Breakdown.FundSol.Internal.integral_ballPow_two","namespace":"Breakdown.FundSol.Internal","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.FarField.integral_weight_le","Breakdown.FundSol.Internal.far_estimate"],"proof_uses":["Breakdown.FundSol.Internal.integral_ballPow"],"protected":false,"short":"integral_ballPow_two","signature_end_line":72,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.FundSol.Internal.ballPow","Breakdown.Space"],"used_by":["Breakdown.FarField.integral_weight_le","Breakdown.FundSol.Internal.far_estimate"],"uses":["Breakdown.FundSol.Internal.ballPow","Breakdown.FundSol.Internal.integral_ballPow","Breakdown.Space"],"written":"integral_ballPow_two"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":79,"kind":"theorem","line":76,"module":"Breakdown.Uniqueness.FundSolPointwiseAux","name":"Breakdown.FundSol.Internal.inv_pow_three_mul","namespace":"Breakdown.FundSol.Internal","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.FarField.abs_gradKernel_le","Breakdown.FarField.abs_smoothGrad_le","Breakdown.FundSol.Internal.abs_kernelSecondDeriv_mul_le"],"proof_uses":[],"protected":false,"short":"inv_pow_three_mul","signature_end_line":76,"sorry":false,"statement_used_by":[],"statement_uses":[],"used_by":["Breakdown.FarField.abs_gradKernel_le","Breakdown.FarField.abs_smoothGrad_le","Breakdown.FundSol.Internal.abs_kernelSecondDeriv_mul_le"],"uses":[],"written":"inv_pow_three_mul"}],"imports":["Breakdown.Uniqueness.FundSolDefs"],"module":"Breakdown.Uniqueness.FundSolPointwiseAux","path":"Breakdown/Uniqueness/FundSolPointwiseAux.lean","sha256":"ab4a705007518caa52668af773dc8f3cf26840bec339f6dfdab058bd8da9137a","source":"import Breakdown.Uniqueness.FundSolDefs\n\nopen scoped ContDiff ENNReal\nopen MeasureTheory Set Real Metric\n\nnoncomputable section\n\nnamespace Breakdown.FundSol.Internal\n\ndef radialCut (n : ℕ) (r t : ℝ) : ℝ := if t < r then t⁻¹ ^ n else 0\n\ndef ballPow (n : ℕ) (r : ℝ) (z : Space) : ℝ := radialCut n r ‖z‖\n\ntheorem ballPow_nonneg (n : ℕ) (r : ℝ) (z : Space) : 0 ≤ ballPow n r z := by\n  unfold ballPow radialCut\n  split_ifs <;> positivity\n\ntheorem ballPow_of_lt {n : ℕ} {r : ℝ} {z : Space} (h : ‖z‖ < r) : ballPow n r z = ‖z‖⁻¹ ^ n := by\n  simp [ballPow, radialCut, h]\n\ntheorem ballPow_of_le {n : ℕ} {r : ℝ} {z : Space} (h : r ≤ ‖z‖) : ballPow n r z = 0 := by\n  simp [ballPow, radialCut, not_lt.2 h]\n\ntheorem radial_eqOn {n : ℕ} (hn : n ≤ 2) (r : ℝ) :\n    EqOn (fun y : ℝ => y ^ (Module.finrank ℝ Space - 1) • radialCut n r y)\n      ((Iio r).indicator (fun y => y ^ (2 - n))) (Ioi 0) := by\n  intro y hy\n  have hy' : (0 : ℝ) < y := hy\n  simp only [finrank_euclideanSpace_fin, smul_eq_mul, radialCut, indicator, mem_Iio]\n  split_ifs with h\n  · have : y ^ 2 = y ^ (2 - n) * y ^ n := by rw [← pow_add]; congr 1; omega\n    rw [this, inv_pow, mul_assoc, mul_inv_cancel₀ (pow_ne_zero _ hy'.ne'), mul_one]\n  · simp\n\ntheorem integrable_ballPow {n : ℕ} (hn : n ≤ 2) (r : ℝ) : Integrable (ballPow n r) := by\n  unfold ballPow\n  rw [integrable_fun_norm_addHaar volume (f := radialCut n r)]\n  rw [integrableOn_congr_fun (radial_eqOn hn r) measurableSet_Ioi]\n  rw [IntegrableOn, integrable_indicator_iff measurableSet_Iio]\n  rw [IntegrableOn, Measure.restrict_restrict measurableSet_Iio]\n  rcases le_or_gt r 0 with hr | hr\n  · have : Iio r ∩ Ioi (0 : ℝ) = ∅ := by\n      ext y; simp only [mem_inter_iff, mem_Iio, mem_Ioi, mem_empty_iff_false, iff_false]\n      intro h; linarith [h.1, h.2]\n    rw [this]; simp\n  · have : Iio r ∩ Ioi (0 : ℝ) ⊆ Icc 0 r := fun y hy => ⟨le_of_lt hy.2, le_of_lt hy.1⟩\n    exact ((continuous_pow (2 - n)).integrableOn_Icc).mono_set this\n\ntheorem integral_ballPow {n : ℕ} (hn : n ≤ 2) {r : ℝ} (hr : 0 < r) :\n    ∫ z, ballPow n r z = Module.finrank ℝ Space * volume.real (ball (0 : Space) 1) *\n      (r ^ (2 - n + 1) / ((2 - n : ℕ) + 1)) := by\n  unfold ballPow\n  rw [integral_fun_norm_addHaar volume (radialCut n r)]\n  rw [setIntegral_congr_fun measurableSet_Ioi (radial_eqOn hn r)]\n  rw [setIntegral_indicator measurableSet_Iio, Ioi_inter_Iio, ← integral_Ioc_eq_integral_Ioo,\n    ← intervalIntegral.integral_of_le hr.le, integral_pow]\n  simp [nsmul_eq_mul, smul_eq_mul, mul_assoc]\n\ntheorem integral_ballPow_zero {r : ℝ} (hr : 0 < r) :\n    ∫ z, ballPow 0 r z = volume.real (ball (0 : Space) 1) * r ^ 3 := by\n  rw [integral_ballPow (by norm_num) hr]\n  simp [finrank_euclideanSpace_fin]\n  ring\n\ntheorem integral_ballPow_one {r : ℝ} (hr : 0 < r) :\n    ∫ z, ballPow 1 r z = 3 / 2 * volume.real (ball (0 : Space) 1) * r ^ 2 := by\n  rw [integral_ballPow (by norm_num) hr]\n  simp [finrank_euclideanSpace_fin]\n  ring\n\ntheorem integral_ballPow_two {r : ℝ} (hr : 0 < r) :\n    ∫ z, ballPow 2 r z = 3 * volume.real (ball (0 : Space) 1) * r := by\n  rw [integral_ballPow (by norm_num) hr]\n  simp [finrank_euclideanSpace_fin]\n\ntheorem inv_pow_three_mul (t : ℝ) : t⁻¹ ^ 3 * t = t⁻¹ ^ 2 := by\n  rcases eq_or_ne t 0 with h | h\n  · simp [h]\n  · field_simp\n\nend Breakdown.FundSol.Internal\n"}