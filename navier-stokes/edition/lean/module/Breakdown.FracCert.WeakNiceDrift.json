ll,"end_line":188,"kind":"theorem","line":184,"module":"Breakdown.FracCert.WeakNiceDrift","name":"Breakdown.FracInternal.NiceDrift.driftSym_conj","namespace":"Breakdown.FracInternal.NiceDrift","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.FracCert.ProfileMildFormInternal.nice_drift","Breakdown.FracCert.niceDriftClosed"],"proof_uses":["Breakdown.FracInternal.NiceDrift.conjVec_turnC","Breakdown.FracInternal.NiceDrift.fderiv_neg_conj"],"protected":false,"short":"driftSym_conj","signature_end_line":185,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.FracInternal.NiceDrift.driftSym","Breakdown.Freq.CSpace","Breakdown.Freq.IsNiceSymbol","Breakdown.Freq.conjVec","Breakdown.Space"],"used_by":["Breakdown.FracCert.ProfileMildFormInternal.nice_drift","Breakdown.FracCert.niceDriftClosed"],"uses":["Breakdown.FracInternal.NiceDrift.conjVec_turnC","Breakdown.FracInternal.NiceDrift.driftSym","Breakdown.FracInternal.NiceDrift.fderiv_neg_conj","Breakdown.Freq.CSpace","Breakdown.Freq.IsNiceSymbol","Breakdown.Freq.conjVec","Breakdown.Space"],"written":"driftSym_conj"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":212,"kind":"theorem","line":190,"module":"Breakdown.FracCert.WeakNiceDrift","name":"Breakdown.FracInternal.NiceDrift.div_deriv","namespace":"Breakdown.FracInternal.NiceDrift","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.FracInternal.NiceDrift.driftSym_div"],"proof_uses":[],"protected":false,"short":"div_deriv","signature_end_line":191,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.Freq.CSpace","Breakdown.Freq.IsNiceSymbol","Breakdown.Space"],"used_by":["Breakdown.FracInternal.NiceDrift.driftSym_div"],"uses":["Breakdown.Freq.CSpace","Breakdown.Freq.IsNiceSymbol","Breakdown.Space"],"written":"div_deriv"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean