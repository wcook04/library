"TorusEuler.HalfHolderData","TorusEuler.Paper.Lib.S5a.Tower.SymTower","TorusEuler.Paper.Lib.S5a.Tower.SymTower.Y","TorusEuler.Paper.Lib.S5a.Tower.Wd","TorusEuler.Vec3","TorusEuler.halfHolderSubspace","TorusEuler.spatialDerivativeWord","TorusEuler.toUnitTorus"],"used_by":[],"uses":["TorusEuler.DistinctPairs","TorusEuler.HalfHolder","TorusEuler.HalfHolder.eval","TorusEuler.HalfHolderData","TorusEuler.Paper.Lib.S5a.Tower.SymTower","TorusEuler.Paper.Lib.S5a.Tower.SymTower.Y","TorusEuler.Paper.Lib.S5a.Tower.Wd","TorusEuler.Vec3","TorusEuler.halfHolderSubspace","TorusEuler.spatialDerivativeWord","TorusEuler.toUnitTorus"],"written":"lift"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":"A jointly smooth periodic field on the slab has a symmetric derivative tower (jets of the sorted word, `sections/06d_mean_estimates.tex:46-48`: \"label derivatives preserve the constraints\").","end_line":70,"kind":"theorem","line":42,"module":"TorusEuler.Paper.Proofs.S5a.Library.TowerJets","name":"TorusEuler.Paper.Lib.S5a.Tower.exists_symTower","namespace":"TorusEuler.Paper.Lib.S5a.Tower","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["TorusEuler.Paper.Lib.S5a.Tower.exists_velocityTower","TorusEuler.Paper.Proof.Text.eq_5_14_of"],"proof_uses":["TorusEuler.EndpointSlabHalfHolderJets.eval_lift","TorusEuler.EndpointSlabHalfHolderJets.spatialDerivative","TorusEuler.HalfHolder.eval","TorusEuler.HalfHolder.ext","TorusEuler.Paper.Lib.S5a.Tower.Wd","TorusEuler.Paper.Lib.S5a.Tower.srt","TorusEuler.Paper.Lib.S5a.Tower.srt_eq_of_perm","TorusEuler.Paper.Lib.S5a.Tower.srt_perm","TorusEuler.coordinateDirection","TorusEuler.endpointSlabSpatialWord_eq_spatialDerivativeWord","TorusEuler.exists_endpointSlabHalfHolderJets","TorusEuler.phaseOperatorWord_constantDirections_perm","TorusEuler.spatialDerivativeWord","TorusEuler.toUnitTorus","TorusEuler.toUnitTorus_surjective"],"protected":false,"short":"exists_symTower","signature_end_line":44,"sorry":false,"statement_used_by":[],"statement_uses":["TorusEuler.Paper.Lib.S5a.Tower.SymTower","TorusEuler.SpatiallyPeriodic","TorusEuler.Vec3"],"used_by":["TorusEuler.Paper.Lib.S5a.Tower.exists_velocityTower","TorusEuler.Paper.Proof.Text.eq_5_14_of"],"uses":["TorusEuler.EndpointSlabHalfHolderJets.eval_lift","TorusEuler.EndpointSlabHalfHolderJets.spatialDerivative","TorusEuler.HalfHolder.eval","TorusEuler.HalfHolder.ext","TorusEuler.Paper.Lib.S5a.Tower.SymTower","TorusEuler.Paper.Lib.S5a.Tower.Wd","TorusEuler.Paper.Lib.S5a.Tower.srt","TorusEuler.Paper.Lib.S5a.Tower.srt_eq_of_perm","TorusEuler.Paper.Lib.S5a.Tower.srt_perm","TorusEuler.SpatiallyPeriodic","TorusEuler.Vec3","TorusEuler.coordinateDirection","TorusEuler.endpointSlabSpatialWord_eq_spatialDerivativeWord","TorusEuler.exists_endpointSlabHalfHolderJets","TorusEuler.phaseOperatorWord_constantDirections_perm","TorusEuler.spatialDerivativeWord","TorusEuler.toUnitTorus","TorusEuler.toUnitTorus_surjective"],"written":"exists_symTower"}],"imports":["TorusEuler.Paper.Proofs.S5a.Library.TowerDer","TorusEuler.Paper.Proofs.S5a.Library.Jets"],"module":"TorusEuler.Paper.Proofs.S5a.Library.TowerJets","path":"TorusEuler/Paper/Proofs/S5a/Library/TowerJets.lean","sha256":"77d3e4bdf09317bc80efb5bfac890a7fa796742f82180473e7ffd511bf681e91","source":"import TorusEuler.Paper.Proofs.S5a.Library.TowerDer\nimport TorusEuler.Paper.Proofs.S5a.Library.Jets\n\n/-!\n# S5a library: symmetric derivative towers of a smooth periodic field\n\n`SymTower T f`: the words of label derivatives of a jointly smooth periodic field `f` on the slab, as\ncurves in `C^{0,1/2}`, indexed by *all* words, exactly invariant under permutations of the word (jets of\nthe sorted word), smooth in time, forming a derivative tower (`IsDer`), with the lifts\n`∂^w f(t, ·)`.\n-/\n\nopen Set\nopen scoped ContDiff\n\nnamespace TorusEuler.Paper.Lib.S5a.Tower\n\nnoncomputable section\n\n/-- The sorted word. -/\ndef srt (w : Wd) : Wd := w.mergeSort (· ≤ ·)\n\n/-- Auxiliary declaration of the tower argument for (5.14) (`sections/06d_mean_estimates.tex:46-58`): `srt_perm`. -/\ntheorem srt_perm (w : Wd) : (srt w).Perm w := List.mergeSort_perm _ _\n\n/-- Auxiliary declaration of the tower argument for (5.14) (`sections/06d_mean_estimates.tex:46-58`): `srt_eq_of_perm`. -/\ntheorem srt_eq_of_perm {p q : Wd} (h : p.Perm q) : srt p = srt q :=\n  List.Perm.eq_of_pairwise' (List.pairwise_mergeSort' _ _) (List.pairwise_mergeSort' _ _)\n    ((srt_perm p).trans (h.trans (srt_perm q).symm))\n\n/-- Symmetric derivative towers of a smooth periodic field. -/\nstructure SymTower {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] (T : ℝ)\n    (f : ℝ × Vec3 → E) where\n  Y : Wd → ℝ → HalfHolder (UnitAddTorus (Fin 3)) E\n  sym : Sym Y\n  smooth : ∀ w, ContDiffOn ℝ ∞ (Y w) (Icc 0 T)\n  der : IsDer T Y\n  lift : ∀ w, ∀ t ∈ Icc 0 T, ∀ x,\n    HalfHolder.eval (toUnitTorus x) (Y w t) = spatialDerivativeWord w (fun y => f (t, y)) x\n\n/-- A jointly smooth periodic field on the slab has a symmetric derivative tower (jets of the sorted word, `sections/06d_mean_estimates.tex:46-48`: \"label derivatives preserve the constraints\"). -/\ntheorem exists_symTower {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]\n    {T : ℝ} (hT : 0 < T) (f : ℝ × Vec3 → E) (hf : ContDiffOn ℝ ∞ f (Icc 0 T ×ˢ (univ : Set Vec3)))\n    (hper : ∀ t ∈ Icc 0 T, SpatiallyPeriodic (fun x => f (t, x))) : Nonempty (SymTower T f) := by\n  obtain ⟨j⟩ := exists_endpointSlabHalfHolderJets hT coordinateDirection f hf hper\n  have hslice (t : ℝ) (ht : t ∈ Icc 0 T) : ContDiff ℝ ∞ (fun y => f (t, y)) :=\n    contDiffOn_univ.mp (hf.comp (contDiff_const.prodMk contDiff_id).contDiffOn\n      (fun x _ => ⟨ht, mem_univ x⟩))\n  have hlift (w : Wd) (t : ℝ) (ht : t ∈ Icc 0 T) (x : Vec3) :\n      HalfHolder.eval (toUnitTorus x) (j.curve w t) = spatialDerivativeWord w (fun y => f (t, y)) x :=\n    (j.eval_lift w t ht x).trans (endpointSlabSpatialWord_eq_spatialDerivativeWord hT hf w t ht x)\n  have hperm (p q : Wd) (h : p.Perm q) (t : ℝ) (ht : t ∈ Icc 0 T) : j.curve p t = j.curve q t := by\n    apply HalfHolder.ext\n    intro a\n    obtain ⟨x, rfl⟩ := toUnitTorus_surjective a\n    rw [hlift p t ht x, hlift q t ht x]\n    exact congrFun (phaseOperatorWord_constantDirections_perm coordinateDirection (hslice t ht) h) x\n  refine ⟨⟨fun w => j.curve (srt w), ?_, fun w => j.smooth _, ?_, ?_⟩⟩\n  · intro p q h\n    simp only [srt_eq_of_perm h]\n  · intro i w t ht\n    have h := j.spatialDerivative i (srt w) t ht\n    have e : j.curve (i :: srt w) t = j.curve (srt (i :: w)) t :=\n      hperm _ _ (((srt_perm w).cons i).trans (srt_perm (i :: w)).symm) t ht\n    rw [e] at h\n    exact h\n  · intro w t ht x\n    rw [hlift (srt w) t ht x]\n    exact congrFun (phaseOperatorWord_constantDirections_perm coordinateDirection (hslice t ht)\n      (srt_perm w)) x\n\nend\n\nend TorusEuler.Paper.Lib.S5a.Tower\n"}