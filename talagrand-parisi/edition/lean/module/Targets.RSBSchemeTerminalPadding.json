d","SpinGlass.Targets.exists_constrainedPhi_gap_right_outside_full","SpinGlass.Targets.exists_uniform_constrainedPhi_negative_initial_terminal_closed","SpinGlass.Targets.exists_uniform_constrainedPhi_negative_initial_terminal_padded","SpinGlass.Targets.exists_uniform_constrainedPhi_negative_terminal_padded","SpinGlass.Targets.exists_uniform_constrainedPhi_right_terminal_padded","SpinGlass.Targets.hasDerivAt_section5RightV_zero_Q_padded","SpinGlass.Targets.hasDerivWithinAt_section4RightQ_all_levels","SpinGlass.Targets.parisiCorrection_padOneLast","SpinGlass.Targets.parisiF_padOneLast_succ","SpinGlass.Targets.section4RightQ_padOneLast","SpinGlass.Targets.section4RightR_lipschitz_uniform_all_levels","SpinGlass.Targets.section4RightR_padOneLast","SpinGlass.Targets.section4VarianceQ_padOneLast","SpinGlass.Targets.section4VarianceR_padOneLast","SpinGlass.Targets.section5RightVariance_padOneLast","_private.Targets.Section4TerminalFactors.0.SpinGlass.Targets.section5Variance_padOneLast","_private.Targets.Section5NegativeTerminal.0.SpinGlass.Targets.negative_gap_with_final_trial"],"uses":["SpinGlass.Targets.RSBScheme","SpinGlass.Targets.RSBScheme.padOneLast"],"written":"RSBScheme.padOneLast_q"},{"axioms":["Classical.choice","Quot.sound","propext"],"dependency_source":"elaborated","doc":"The added innermost step has zero variance.","end_line":50,"kind":"theorem","line":38,"module":"Targets.RSBSchemeTerminalPadding","name":"SpinGlass.Targets.parisiF_padOneLast_succ","namespace":"SpinGlass.Targets","noncomputable":false,"private":false,"proof_used_by":["SpinGlass.Targets.exists_uniform_constrainedPhi_right_terminal_padded","SpinGlass.Targets.guerraPsi_padOneLast","SpinGlass.Targets.parisiFDeriv_padOneLast_succ","SpinGlass.Targets.section4VarianceQ_padOneLast","SpinGlass.Targets.section4VarianceR_padOneLast"],"proof_uses":["SpinGlass.Targets.RSBScheme.padOneLast_m","SpinGlass.Targets.RSBScheme.padOneLast_q","SpinGlass.Targets.parisiStep","SpinGlass.Targets.parisiStep_zero_var"],"protected":false,"short":"parisiF_padOneLast_succ","signature_end_line":39,"statement_used_by":[],"statement_uses":["SpinGlass.Targets.RSBScheme","SpinGlass.Targets.RSBScheme.padOneLast","SpinGlass.Targets.parisiF"],"used_by":["SpinGlass.Targets.exists_uniform_constrainedPhi_right_terminal_padded","SpinGlass.Targets.guerraPsi_padOneLast","SpinGlass.Targets.parisiFDeriv_padOneLast_succ","SpinGlass.Targets.section4VarianceQ_padOneLast","SpinGlass.Targets.section4VarianceR_padOneLast"],"uses":["SpinGlass.Targets.RSBScheme","SpinGlass.Targets.RSBScheme.padOneLast","SpinGlass.Targets.RSBScheme.padOneLast_m","SpinGlass.Targets.RSBScheme.padOneLast_q","SpinGlass.Targets.parisiF","SpinGlass.Targets.parisiStep","SpinGlass.Targets.parisiStep_zero_var"],"written":"parisiF_padOneLast_succ"},{"axioms":["Classical.choice","Quot.sound","propext"],"dependency_source":"elaborated","doc":"The genuine scalar first derivatives obey the same shift identity.","end_line":58,"kind":"theorem","line":53,"module":"Targets.RSBSchemeTerminalPadding","name":"SpinGlass.Targets.parisiFDeriv_padOneLast_succ","namespace":"SpinGlass.Targets","noncomputable":false,"private":false,"proof_used_by":["SpinGlass.Targets.parisiFSecond_padOneLast_succ","SpinGlass.Targets.section4VarianceQ_padOneLast","SpinGlass.Targets.section4VarianceR_padOneLast"],"proof_uses":["SpinGlass.HasParisiC2","SpinGlass.Targets.parisiF","SpinGlass.Targets.parisiFSecond","SpinGlass.Targets.parisiF_C2_props","SpinGlass.Targets.parisiF_padOneLast_succ"],"protected":false,"short":"parisiFDeriv_padOneLast_succ","signature_end_line":54,"statement_used_by":[],"statement_uses":["SpinGlass.Targets.RSBScheme","SpinGlass.Targets.RSBScheme.padOneLast","SpinGlass.Targets.parisiFDeriv"],"used_by":["SpinGlass.Targets.parisiFSecond_padOneLast_succ","SpinGlass.Targets.section4VarianceQ_padOneLast","SpinGlass.Targets.section4VarianceR_padOneLast"],"uses":["SpinGlass.HasParisiC2","SpinGlass.Targets.RSBScheme","SpinGlass.Targets.RSBScheme.padOneLast","SpinGlass.Targets.parisiF","SpinGlass.Targets.parisiFDeriv","SpinGlass.Targets.parisiFSecond","SpinGlass.Targets.parisiF_C2_props","SpinGlass.Targets.parisiF_padOneLast_succ"],"written":"parisiFDeriv_padOneLast_succ"},{"axioms":["Classical.choice","Quot.sound","propext"],"dependency_source":"elaborated","doc":"The genuine scalar Hessians are also unchanged by terminal padding.","end_line":66,"kind":"theorem","line":61,"module":"Targets.RSBSchemeTerminalPadding","name":"SpinGlass.Targets.parisiFSecond_padOneLast_succ","namespace":"SpinGlass.Targets","noncomputable":false,"private":false,"proof_used_by":["SpinGlass.Targets.section4VarianceR_padOneLast"],"proof_uses":["SpinGlass.HasParisiC2","SpinGlass.Targets.parisiF","SpinGlass.Targets.parisiFDeriv","SpinGlass.Targets.parisiFDeriv_padOneLast_succ","SpinGlass.Targets.parisiF_C2_props"],"protected":false,"short":"parisiFSecond_padOneLast_succ","signature_end_line":62,"statement_used_by":[],"statement_uses":["SpinGlass.Targets.RSBScheme","SpinGlass.Targets.RSBScheme.padOneLast","SpinGlass.Targets.parisiFSecond"],"used_by":["SpinGlass.Targets.section4VarianceR_padOneLast"],"uses":["SpinGlass.HasParisiC2","SpinGlass.Targets.RSBScheme","SpinGlass.Targets.RSBScheme.padOneLast","SpinGlass.Targets.parisiF","SpinGlass.Targets.parisiFDeriv","SpinGlass.Targets.parisiFDeriv_padOneLast_succ","SpinGlass.Targets.parisiFSecond","SpinGlass.Targets.parisiF_C2_props"],"written":"parisiFSecond_padOneLast_succ"}],"imports":["Targets.Section4NeighborFactors"],"module":"Targets.RSBSchemeTerminalPadding","path":"Targets/RSBSchemeTerminalPadding.lean","sha256":"c2032dd2fbface05080530a936c6f17c4034058dabeda8dd7fec40ef9c500e9e","source":"import Targets.Section4NeighborFactors\n\n/-!\n# Redundant terminal mass-one padding\n\nAppending mass one at overlap one adds a zero-variance innermost scalar\nstep. The original physical masses and overlaps are unchanged, and the\nscalar recursion is merely shifted by one level. No minimality of the\npadded scheme is asserted or needed for the terminal factor adapters.\n-/\n\nopen MeasureTheory ProbabilityTheory Real\n\nnamespace SpinGlass.Targets\n\n/-- Append a redundant mass-one level and a repeated terminal overlap one. -/\nnoncomputable def RSBScheme.padOneLast {k : ℕ} (s : RSBScheme k) : RSBScheme (k + 1) where\n  m p := s.m (min p (k + 1))\n  q p := s.q (min p (k + 2))\n  m_zero := by simp [s.m_zero]\n  m_top := by simp [s.m_top]\n  m_mono p hp := s.m_mono' (min (p + 1) (k + 1)) (by omega)\n    (min p (k + 1)) (by omega)\n  q_zero := by simp [s.q_zero]\n  q_top := by simp [s.q_top]\n  q_mono p hp := s.q_mono' (min (p + 1) (k + 2)) (by omega)\n    (min p (k + 2)) (by omega)\n\n/-- All original physical masses are preserved exactly. -/\ntheorem RSBScheme.padOneLast_m {k : ℕ} (s : RSBScheme k) {p : ℕ} (hp : p ≤ k + 1) :\n    s.padOneLast.m p = s.m p := by simp only [padOneLast, min_eq_left hp]\n\n/-- All original physical overlaps are preserved exactly. -/\ntheorem RSBScheme.padOneLast_q {k : ℕ} (s : RSBScheme k) {p : ℕ} (hp : p ≤ k + 2) :\n    s.padOneLast.q p = s.q p := by simp only [padOneLast, min_eq_left hp]\n\n/-- The added innermost step has zero variance. -/\ntheorem parisiF_padOneLast_succ {k : ℕ} (s : RSBScheme k) (β : ℝ) (j : ℕ) :\n    parisiF s.padOneLast β (j + 1) = parisiF s β j := by\n  induction j with\n  | zero =>\n    funext x\n    simp [parisiF, RSBScheme.padOneLast, s.q_top, parisiStep_zero_var]\n  | succ j ih =>\n    rw [parisiF, ih, parisiF]\n    simp only [show k + 1 + 1 - (j + 1) = k + 1 - j by omega,\n      show k + 1 + 2 - (j + 1) = k + 2 - j by omega,\n      RSBScheme.padOneLast_m s (p := k + 1 - j) (by omega),\n      RSBScheme.padOneLast_q s (p := k + 2 - j) (by omega),\n      RSBScheme.padOneLast_q s (p := k + 1 - j) (by omega)]\n\n/-- The genuine scalar first derivatives obey the same shift identity. -/\ntheorem parisiFDeriv_padOneLast_succ {k : ℕ} (s : RSBScheme k) (β : ℝ) (j : ℕ) :\n    parisiFDeriv s.padOneLast β (j + 1) = parisiFDeriv s β j := by\n  funext x\n  have H := (parisiF_C2_props s.padOneLast β (j + 1)).1.1 x\n  rw [parisiF_padOneLast_succ] at H\n  exact H.unique ((parisiF_C2_props s β j).1.1 x)\n\n/-- The genuine scalar Hessians are also unchanged by terminal padding. -/\ntheorem parisiFSecond_padOneLast_succ {k : ℕ} (s : RSBScheme k) (β : ℝ) (j : ℕ) :\n    parisiFSecond s.padOneLast β (j + 1) = parisiFSecond s β j := by\n  funext x\n  have H := (parisiF_C2_props s.padOneLast β (j + 1)).1.2.1 x\n  rw [parisiFDeriv_padOneLast_succ] at H\n  exact H.unique ((parisiF_C2_props s β j).1.2.1 x)\n\nend SpinGlass.Targets\n"}