own.CellCert.CellCoordinates.IsMeshData.path_edges","Breakdown.CellCert.CellCoordinates.MeshData.canonicalLeft","Breakdown.CellCert.CellCoordinates.MeshData.canonicalRight","Breakdown.CellCert.CellCoordinates.MeshData.classValue","Breakdown.CellCert.CellCoordinates.MeshEdgeJumpInternal.rootValue_congr"],"protected":false,"short":"meshEdgeJump","signature_end_line":34,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CellCert.CellCoordinates.MeshEdgeJumpStatement"],"used_by":["Breakdown.CellCert.CellCoordinates.MeshSkeletonInternal.deleted_zero","Breakdown.CellCert.CellCoordinates.meshCompatibility_of_slot","Breakdown.CellCert.FinalCellSystem.cellCoordsRest_of"],"uses":["Breakdown.CellCert.CellCoordinates.IsMeshData.path_edges","Breakdown.CellCert.CellCoordinates.MeshData.canonicalLeft","Breakdown.CellCert.CellCoordinates.MeshData.canonicalRight","Breakdown.CellCert.CellCoordinates.MeshData.classValue","Breakdown.CellCert.CellCoordinates.MeshEdgeJumpInternal.rootValue_congr","Breakdown.CellCert.CellCoordinates.MeshEdgeJumpStatement"],"written":"meshEdgeJump"}],"imports":["Breakdown.FracCell.StMesh"],"module":"Breakdown.FracCell.MeshEdgeJump","path":"Breakdown/FracCell/MeshEdgeJump.lean","sha256":"8b94965cdae61c474f00823cbf0bb7c81658b52b0632671b8a261722a870d777","source":"import Breakdown.FracCell.StMesh\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace CellCert\n\nnamespace CellCoordinates\n\nopen SteadyCert Assembly CellAnalysis CellFormula\n\nnamespace MeshEdgeJumpInternal\n\ntheorem dep_congr {n : ℕ} {β : Fin n → Type} (f : (K : Fin n) → β K → ℝ) {K K' : Fin n} {d : β K} {d' : β K'}\n    (h : K = K') (hd : HEq d d') : f K d = f K' d' := by\n  subst h\n  rw [eq_of_heq hd]\n\ntheorem rootValue_congr {k N : ℕ} {Sp : CellSplit k N} (M : MeshData k N Sp) (x : FieldTuple k)\n    {a b : Fin M.classCount} (h1 : M.classRoot a = M.classRoot b) (h2 : M.classRootSide a = M.classRootSide b)\n    (h3 : HEq (M.classRootDatum a) (M.classRootDatum b)) : M.rootValue x a = M.rootValue x b := by\n  unfold MeshData.rootValue\n  rw [h2]\n  exact dep_congr (β := fun K => Fin (M.coords K).layout.presCount × Fin (M.coords K).layout.degSide)\n    (fun K d => -((M.coords K).layout.pressureDatumValue x d) /\n      (if M.classRootSide b then (M.coords K).layout.shiftCoefRight d else (M.coords K).layout.shiftCoefLeft d))\n    h1 h3\n\nend MeshEdgeJumpInternal\n\nopen MeshEdgeJumpInternal\n\ntheorem meshEdgeJump : MeshEdgeJumpStatement := by\n  intro α _ _ k N c _ Sp M hM K e he x _\n  obtain ⟨⟨h1, h2, h3⟩, hp⟩ := hM.path_edges K e he\n  have hr := rootValue_congr M x h1 h2 h3\n  unfold MeshData.canonicalRight MeshData.canonicalLeft MeshData.classValue\n  rcases hp with hp | hp\n  · rw [hp, hr, List.map_append, List.sum_append]\n    simp only [List.map_cons, List.map_nil, if_true, List.sum_cons, List.sum_nil]\n    ring\n  · rw [hp, hr, List.map_append, List.sum_append]\n    simp only [List.map_cons, List.map_nil, Bool.false_eq_true, if_false, List.sum_cons, List.sum_nil]\n    ring\n\nend CellCoordinates\n\nend CellCert\n\nend Breakdown\n"}