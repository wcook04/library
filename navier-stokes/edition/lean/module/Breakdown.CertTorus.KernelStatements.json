late","Breakdown.FarField.integralEquationOfOrbit_of_kernel","Breakdown.FarField.kernelConv_dilate","Breakdown.FarField.kernelScaling_holds"],"statement_uses":["Breakdown.FarField.heatKernel","Breakdown.FarField.lerayKernel","Breakdown.Space"],"used_by":["Breakdown.FarField.duhamelChangeOfVariables_of_kernel","Breakdown.FarField.heatConv_dilate","Breakdown.FarField.integralEquationOfOrbit_of_kernel","Breakdown.FarField.kernelConv_dilate","Breakdown.FarField.kernelScaling_holds"],"uses":["Breakdown.FarField.heatKernel","Breakdown.FarField.lerayKernel","Breakdown.Space"],"written":"KernelScaling"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":54,"kind":"def","line":52,"module":"Breakdown.CertTorus.KernelStatements","name":"Breakdown.FarField.KernelL1Bound","namespace":"Breakdown.FarField","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"KernelL1Bound","signature_end_line":52,"sorry":false,"statement_used_by":["Breakdown.FarField.integralEquationOfOrbit_of_kernel","Breakdown.FarField.kernelConvSup_of_l1","Breakdown.FarField.kernelL1Bound_holds","Breakdown.FarField.kernelL1Bound_of_bound"],"statement_uses":["Breakdown.FarField.lerayKernel","Breakdown.Space"],"used_by":["Breakdown.FarField.integralEquationOfOrbit_of_kernel","Breakdown.FarField.kernelConvSup_of_l1","Breakdown.FarField.kernelL1Bound_holds","Breakdown.FarField.kernelL1Bound_of_bound"],"uses":["Breakdown.FarField.lerayKernel","Breakdown.Space"],"written":"KernelL1Bound"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":58,"kind":"def","line":56,"module":"Breakdown.CertTorus.KernelStatements","name":"Breakdown.FarField.KernelConvSup","namespace":"Breakdown.FarField","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"KernelConvSup","signature_end_line":56,"sorry":false,"statement_used_by":["Breakdown.FarField.duhamelChangeOfVariables_of_kernel","Breakdown.FarField.duhamelContinuous_of_kernel","Breakdown.FarField.duhamelVelocityAE_holds","Breakdown.FarField.farFieldDecay_of_parts","Breakdown.FarField.integralEquationOfOrbit_of_kernel","Breakdown.FarField.kernelConvSup_holds","Breakdown.FarField.kernelConvSup_of_l1","Breakdown.FarField.profileOpDeriv_holds","Breakdown.FarField.truncTendsto_of_kernel"],"statement_uses":["Breakdown.FarField.kernelConv","Breakdown.Space"],"used_by":["Breakdown.FarField.duhamelChangeOfVariables_of_kernel","Breakdown.FarField.duhamelContinuous_of_kernel","Breakdown.FarField.duhamelVelocityAE_holds","Breakdown.FarField.farFieldDecay_of_parts","Breakdown.FarField.integralEquationOfOrbit_of_kernel","Breakdown.FarField.kernelConvSup_holds","Breakdown.FarField.kernelConvSup_of_l1","Breakdown.FarField.profileOpDeriv_holds","Breakdown.FarField.truncTendsto_of_kernel"],"uses":["Breakdown.FarField.kernelConv","Breakdown.Space"],"written":"KernelConvSup"}],"imports":["Breakdown.CertTorus.Defs"],"module":"Breakdown.CertTorus.KernelStatements","path":"Breakdown/CertTorus/KernelStatements.lean","sha256":"20f18dd9f75bbc81f4155cff57599f88e78468907687ceab5bd49fc50182adc2","source":"import Breakdown.CertTorus.Defs\n\nopen MeasureTheory Set Real\nopen scoped ContDiff\n\nnoncomputable section\n\nnamespace Breakdown.FarField\n\nopen Freq\n\ndef HeatKernelBounds : Prop :=\n  ∃ C : ℝ, ∀ τ : ℝ, 0 < τ → ∀ x : Space,\n    heatKernel τ x ≤ C / (‖x‖ + Real.sqrt τ) ^ 3 ∧\n    (∀ k : Fin 3, |x k / (2 * τ) * heatKernel τ x| ≤ C / (‖x‖ + Real.sqrt τ) ^ 4) ∧\n    ∀ i j k : Fin 3, |heatKernelThird i j k τ x| ≤ C / (‖x‖ + Real.sqrt τ) ^ 6\n\ndef HeatKernelPartials : Prop :=\n  ∀ τ : ℝ, 0 < τ → ∀ x : Space,\n    HasFDerivAt (heatKernel τ)\n      (∑ k : Fin 3, (-(x k / (2 * τ)) * heatKernel τ x) • (EuclideanSpace.proj k : Space →L[ℝ] ℝ)) x ∧\n    ∀ i j k : Fin 3,\n      fderiv ℝ (fun z : Space =>\n        (z j * z k / (4 * τ ^ 2) - (if j = k then 1 / (2 * τ) else 0)) * heatKernel τ z) x (unitVector i) =\n        heatKernelThird i j k τ x\n\ndef LerayKernelBound : Prop :=\n  ∃ C : ℝ, ∀ i j k : Fin 3, ∀ τ : ℝ, ∀ x : Space, 0 < τ →\n    |lerayKernel i j k τ x| ≤ C / (‖x‖ + Real.sqrt τ) ^ 4\n\ndef LerayKernelJointContinuous : Prop :=\n  ∀ i j k : Fin 3, ContinuousOn (fun p : ℝ × Space => lerayKernel i j k p.1 p.2) (Ioi 0 ×ˢ univ)\n\ndef LerayKernelMeasurable : Prop :=\n  ∀ i j k : Fin 3, Measurable (fun p : ℝ × Space => lerayKernel i j k p.1 p.2)\n\ndef LerayKernelC1 : Prop :=\n  ∀ i j k : Fin 3, ∀ τ : ℝ, 0 < τ → ContDiff ℝ 1 (lerayKernel i j k τ)\n\ndef LerayKernelDivFree : Prop :=\n  ∀ j k : Fin 3, ∀ τ : ℝ, 0 < τ → ∀ x : Space,\n    ∑ i : Fin 3, fderiv ℝ (lerayKernel i j k τ) x (unitVector i) = 0\n\ndef LerayKernelOdd : Prop :=\n  ∀ i j k : Fin 3, ∀ τ : ℝ, ∀ x : Space, lerayKernel i j k τ (-x) = -lerayKernel i j k τ x\n\ndef KernelScaling : Prop :=\n  ∀ μ : ℝ, 0 < μ → ∀ τ : ℝ, 0 < τ → ∀ x : Space,\n    heatKernel (μ * τ) (Real.sqrt μ • x) = (μ * Real.sqrt μ)⁻¹ * heatKernel τ x ∧\n    ∀ i j k : Fin 3, lerayKernel i j k (μ * τ) (Real.sqrt μ • x) = (μ ^ 2)⁻¹ * lerayKernel i j k τ x\n\ndef KernelL1Bound : Prop :=\n  ∃ C : ℝ, ∀ i j k : Fin 3, ∀ τ : ℝ, 0 < τ →\n    Integrable (lerayKernel i j k τ) ∧ ∫ x, |lerayKernel i j k τ x| ≤ C * τ ^ (-(1 / 2 : ℝ))\n\ndef KernelConvSup : Prop :=\n  ∃ C : ℝ, ∀ τ : ℝ, 0 < τ → ∀ F : Space → Fin 3 → Fin 3 → ℝ, Measurable F → ∀ A : ℝ,\n    (∀ z, ‖F z‖ ≤ A) → ∀ y, ‖kernelConv τ F y‖ ≤ C * τ ^ (-(1 / 2 : ℝ)) * A\n\nend Breakdown.FarField\n"}