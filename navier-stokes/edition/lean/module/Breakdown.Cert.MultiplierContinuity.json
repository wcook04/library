kdown.Cert.Internal.MultiplierContinuity.heldMultiplier_continuousOn","namespace":"Breakdown.Cert.Internal.MultiplierContinuity","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.Cert.multiplierContinuityHolds_of"],"proof_uses":["Breakdown.Cert.Internal.MultiplierContinuity.heldMultiplier_spec","Breakdown.Cert.IsHeldSolution"],"protected":false,"short":"heldMultiplier_continuousOn","signature_end_line":28,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.Cert.HeldExistsUniqueHolds","Breakdown.Cert.HeldLimitHolds","Breakdown.Cert.Internal.MultiplierContinuity.heldMultiplier","Breakdown.CertificateData","Breakdown.CertificateData.box","Breakdown.IsCertificate"],"used_by":["Breakdown.Cert.multiplierContinuityHolds_of"],"uses":["Breakdown.Cert.HeldExistsUniqueHolds","Breakdown.Cert.HeldLimitHolds","Breakdown.Cert.Internal.MultiplierContinuity.heldMultiplier","Breakdown.Cert.Internal.MultiplierContinuity.heldMultiplier_spec","Breakdown.Cert.IsHeldSolution","Breakdown.CertificateData","Breakdown.CertificateData.box","Breakdown.IsCertificate"],"written":"heldMultiplier_continuousOn"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":58,"kind":"theorem","line":54,"module":"Breakdown.Cert.MultiplierContinuity","name":"Breakdown.Cert.multiplierContinuityHolds_of","namespace":"Breakdown.Cert","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.certificate_orbit_proved"],"proof_uses":["Breakdown.Cert.Internal.MultiplierContinuity.heldMultiplier_continuousOn","Breakdown.Cert.Internal.MultiplierContinuity.multiplierOf_eq"],"protected":false,"short":"multiplierContinuityHolds_of","signature_end_line":55,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.Cert.HeldExistsUniqueHolds","Breakdown.Cert.HeldLimitHolds","Breakdown.Cert.MultiplierContinuityHolds"],"used_by":["Breakdown.certificate_orbit_proved"],"uses":["Breakdown.Cert.HeldExistsUniqueHolds","Breakdown.Cert.HeldLimitHolds","Breakdown.Cert.Internal.MultiplierContinuity.heldMultiplier_continuousOn","Breakdown.Cert.Internal.MultiplierContinuity.multiplierOf_eq","Breakdown.Cert.MultiplierContinuityHolds"],"written":"multiplierContinuityHolds_of"}],"imports":["Breakdown.Cert.Nodes"],"module":"Breakdown.Cert.MultiplierContinuity","path":"Breakdown/Cert/MultiplierContinuity.lean","sha256":"89bbbb8c3990c46784ab65e9db43df579c16525c68effe331a27d0193a991b17","source":"import Breakdown.Cert.Nodes\n\nopen scoped Topology\nopen Filter\n\nnoncomputable section\n\nnamespace Breakdown.Cert\n\nnamespace Internal.MultiplierContinuity\n\nopen scoped Classical\n\ndef heldMultiplier {k : ℕ} (d : CertificateData k) (p : Fin k → ℝ) : Fin k → ℝ :=\n  if h : ∃ κ, ∃ f, IsHeldSolution d p f κ then h.choose else 0\n\ntheorem heldMultiplier_spec {k : ℕ} (d : CertificateData k) (p : Fin k → ℝ)\n    (h : ∃ κ, ∃ f, IsHeldSolution d p f κ) : ∃ f, IsHeldSolution d p f (heldMultiplier d p) := by\n  unfold heldMultiplier\n  rw [dif_pos h]\n  exact h.choose_spec\n\ntheorem multiplierOf_eq {k : ℕ} (d : CertificateData k) :\n    multiplierOf d = fun p => d.multiplier p + heldMultiplier d p := rfl\n\ntheorem heldMultiplier_continuousOn (h1 : HeldLimitHolds) (h2 : HeldExistsUniqueHolds)\n    {k : ℕ} (d : CertificateData k) (hd : IsCertificate d) :\n    ContinuousOn (heldMultiplier d) d.box := by\n  have hex : ∀ p ∈ d.box, ∃ f, IsHeldSolution d p f (heldMultiplier d p) := by\n    intro p hp\n    obtain ⟨f, κ, hf, -⟩ := h2 d hd p hp\n    exact heldMultiplier_spec d p ⟨κ, f, hf⟩\n  intro q hq\n  refine tendsto_of_subseq_tendsto fun ns hns => ?_\n  rw [tendsto_nhdsWithin_iff] at hns\n  obtain ⟨hlim, hev⟩ := hns\n  obtain ⟨N, hN⟩ := eventually_atTop.1 hev\n  have hmem : ∀ n, ns (n + N) ∈ d.box := fun n => hN _ (Nat.le_add_left N n)\n  have hlim' : Tendsto (fun n => ns (n + N)) atTop (𝓝 q) := (tendsto_add_atTop_iff_nat N).2 hlim\n  choose f hf using fun n => hex _ (hmem n)\n  obtain ⟨φ, -, f₀, κ₀, h₀, hκ⟩ := h1 d hd (fun n => ns (n + N)) q hmem hq hlim' f\n    (fun n => heldMultiplier d (ns (n + N))) hf\n  obtain ⟨fq, hfq⟩ := hex q hq\n  obtain ⟨g, μ, -, huniq⟩ := h2 d hd q hq\n  have e1 := (huniq _ _ hfq).2\n  have e2 := (huniq _ _ h₀).2\n  refine ⟨fun n => φ n + N, ?_⟩\n  rw [e1, ← e2]\n  exact hκ\n\nend Internal.MultiplierContinuity\n\nopen Internal.MultiplierContinuity in\ntheorem multiplierContinuityHolds_of (h1 : HeldLimitHolds) (h2 : HeldExistsUniqueHolds) :\n    MultiplierContinuityHolds := by\n  intro k d hd\n  rw [multiplierOf_eq]\n  exact hd.multiplier_continuous.add (heldMultiplier_continuousOn h1 h2 d hd)\n\nend Breakdown.Cert\n"}