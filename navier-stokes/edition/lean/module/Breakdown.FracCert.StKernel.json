akdown.FracCert.DyadicPieceBoundStatement","namespace":"Breakdown.FracCert","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"DyadicPieceBoundStatement","signature_end_line":85,"sorry":false,"statement_used_by":["Breakdown.FracCert.dyadicPieceBound","Breakdown.FracCert.dyadicPieceBound_of_far","Breakdown.FracCert.homogeneousMultiplier_of","Breakdown.SteadyCert.ChainInternal.dyadicPieceBound_holds"],"statement_uses":["Breakdown.FracCert.IsHomogeneousSymbol","Breakdown.FracCert.IsRingCutoff","Breakdown.FracCert.IsWeightedSmooth","Breakdown.FracCert.dyadicKernel","Breakdown.FracCert.kernelConv","Breakdown.Space"],"used_by":["Breakdown.FracCert.dyadicPieceBound","Breakdown.FracCert.dyadicPieceBound_of_far","Breakdown.FracCert.homogeneousMultiplier_of","Breakdown.SteadyCert.ChainInternal.dyadicPieceBound_holds"],"uses":["Breakdown.FracCert.IsHomogeneousSymbol","Breakdown.FracCert.IsRingCutoff","Breakdown.FracCert.IsWeightedSmooth","Breakdown.FracCert.dyadicKernel","Breakdown.FracCert.kernelConv","Breakdown.Space"],"written":"DyadicPieceBoundStatement"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":98,"kind":"def","line":94,"module":"Breakdown.FracCert.StKernel","name":"Breakdown.FracCert.HomogeneousMultiplierStatement","namespace":"Breakdown.FracCert","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"HomogeneousMultiplierStatement","signature_end_line":94,"sorry":false,"statement_used_by":["Breakdown.FracCert.DecayPressureModel.modelPressureDecay_of","Breakdown.FracCert.homogeneousMultiplier_of","Breakdown.FracCert.powerDecay_of","Breakdown.FracCert.pressureDecay_of","Breakdown.FracCert.pressureDecay_of_reduced","Breakdown.FracCert.pressureDecay_of_representation","Breakdown.SteadyCert.ChainInternal.homogeneousMultiplier_holds"],"statement_uses":["Breakdown.FracCert.HasMomentsInL1","Breakdown.FracCert.IsHomogeneousSymbol","Breakdown.FracCert.IsTransformOf","Breakdown.FracCert.IsWeightedSmooth","Breakdown.Space"],"used_by":["Breakdown.FracCert.DecayPressureModel.modelPressureDecay_of","Breakdown.FracCert.homogeneousMultiplier_of","Breakdown.FracCert.powerDecay_of","Breakdown.FracCert.pressureDecay_of","Breakdown.FracCert.pressureDecay_of_reduced","Breakdown.FracCert.pressureDecay_of_representation","Breakdown.SteadyCert.ChainInternal.homogeneousMultiplier_holds"],"uses":["Breakdown.FracCert.HasMomentsInL1","Breakdown.FracCert.IsHomogeneousSymbol","Breakdown.FracCert.IsTransformOf","Breakdown.FracCert.IsWeightedSmooth","Breakdown.Space"],"written":"HomogeneousMultiplierStatement"}],"imports":["Breakdown.Defs"],"module":"Breakdown.FracCert.StKernel","path":"Breakdown/FracCert/StKernel.lean","sha256":"a0338580390fc02ad5ae0f7f6617e015ed8fa24345c7428a13cdb9693b8e1abe","source":"import Breakdown.Defs\n\nopen scoped ContDiff\nopen MeasureTheory Real\n\nnoncomputable section\n\nnamespace Breakdown.FracCert\n\ndef IsRingCutoff (θ : Space → ℝ) : Prop :=\n  ContDiff ℝ ∞ θ ∧ (∀ ξ, 0 ≤ θ ξ ∧ θ ξ ≤ 1) ∧\n    (∀ ξ, θ ξ ≠ 0 → 1 / 2 < ‖ξ‖ ∧ ‖ξ‖ < 2) ∧\n    ∀ ξ : Space, ξ ≠ 0 → HasSum (fun l : ℤ => θ (((2 : ℝ) ^ (-(l : ℝ))) • ξ)) 1\n\ndef RingCutoffStatement : Prop := ∃ θ : Space → ℝ, IsRingCutoff θ\n\ndef DyadicSumStatement : Prop :=\n  ∀ a N : ℝ, 0 < a → a < N → ∃ C : ℝ, ∀ r : ℝ, 0 < r →\n    Summable (fun l : ℤ => (2 : ℝ) ^ (a * l) * (1 + (2 : ℝ) ^ (l : ℝ) * r) ^ (-N)) ∧\n    ∑' l : ℤ, (2 : ℝ) ^ (a * l) * (1 + (2 : ℝ) ^ (l : ℝ) * r) ^ (-N) ≤ C * r ^ (-a)\n\ndef PieceKernelStatement : Prop :=\n  ∀ N j : ℕ, ∃ C : ℝ, ∀ (m : Space → ℂ) (B : ℝ), ContDiff ℝ ∞ m →\n    (∀ ξ, m ξ ≠ 0 → 1 / 4 ≤ ‖ξ‖ ∧ ‖ξ‖ ≤ 4) →\n    (∀ i ≤ N + j + 4, ∀ ξ, ‖iteratedFDeriv ℝ i m ξ‖ ≤ B) →\n    ContDiff ℝ ∞ (FourierTransform.fourierInv m) ∧\n    ∀ x, (1 + ‖x‖) ^ N * ‖iteratedFDeriv ℝ j (FourierTransform.fourierInv m) x‖ ≤ C * B\n\ndef projDivSymbol (α t : ℝ) (i j k : Fin 3) (ξ : Space) : ℂ :=\n  ((2 * π * ξ k : ℝ) : ℂ) * Complex.I *\n    (((if i = j then (1 : ℝ) else 0) - ξ i * ξ j / ‖ξ‖ ^ 2 : ℝ) : ℂ) *\n    ((Real.exp (-(t * (2 * π * ‖ξ‖) ^ (2 * α))) : ℝ) : ℂ)\n\ndef projDivKernel (α t : ℝ) (i j k : Fin 3) (x : Space) : ℂ :=\n  FourierTransform.fourierInv (projDivSymbol α t i j k) x\n\ndef KernelDecayStatement : Prop :=\n  ∀ α : ℝ, 0 < α → ∀ i j k : Fin 3,\n    (∀ t : ℝ, 0 < t → ContDiff ℝ ∞ (projDivKernel α t i j k)) ∧\n    ∀ n : ℕ, ∃ C : ℝ, ∀ t : ℝ, 0 < t → ∀ x : Space,\n      ‖iteratedFDeriv ℝ n (projDivKernel α t i j k) x‖ ≤\n        C * (t ^ (1 / (2 * α)) + ‖x‖) ^ (-(4 + n : ℝ))\n\ndef KernelScalingStatement : Prop :=\n  ∀ α : ℝ, 0 < α → ∀ i j k : Fin 3, ∀ t : ℝ, 0 < t →\n    (∀ x : Space, projDivKernel α t i j k x =\n      ((t ^ (-(2 / α)) : ℝ) : ℂ) * projDivKernel α 1 i j k ((t ^ (-(1 / (2 * α)))) • x)) ∧\n    (∀ x : Space, (projDivKernel α t i j k x).im = 0) ∧\n    Integrable (projDivKernel α t i j k) ∧\n    (∫ x, ‖projDivKernel α t i j k x‖) = t ^ (-(1 / (2 * α))) * ∫ x, ‖projDivKernel α 1 i j k x‖ ∧\n    MemLp (projDivKernel α t i j k) (3 / 2) ∧\n    (eLpNorm (projDivKernel α t i j k) (3 / 2) volume).toReal =\n      t ^ (-(1 / α)) * (eLpNorm (projDivKernel α 1 i j k) (3 / 2) volume).toReal\n\ndef IsHomogeneousSymbol (σ : Space → ℂ) (d : ℝ) : Prop :=\n  ContDiffOn ℝ ∞ σ {ξ | ξ ≠ 0} ∧\n    ∀ c : ℝ, 0 < c → ∀ ξ : Space, ξ ≠ 0 → σ (c • ξ) = ((c ^ d : ℝ) : ℂ) * σ ξ\n\ndef IsWeightedSmooth (f : Space → ℂ) (β : ℝ) : Prop :=\n  ContDiff ℝ ∞ f ∧ ∀ i : ℕ, ∃ C : ℝ, ∀ y : Space, (1 + ‖y‖) ^ (β + i) * ‖iteratedFDeriv ℝ i f y‖ ≤ C\n\ndef IsTransformOf (F f : Space → ℂ) : Prop :=\n  LocallyIntegrable F volume ∧ ∀ φ : SchwartzMap Space ℂ,\n    (∫ x, f x * FourierTransform.fourier (φ : Space → ℂ) x) = ∫ ξ, F ξ * φ ξ\n\ndef HasMomentsInL1 (G : Space → ℂ) : Prop :=\n  AEStronglyMeasurable G volume ∧ ∀ n : ℕ, Integrable (fun ξ => ‖ξ‖ ^ n * ‖G ξ‖)\n\ndef kernelConv (k f : Space → ℂ) (x : Space) : ℂ := ∫ z, k z * f (x - z)\n\ndef dyadicKernel (σ : Space → ℂ) (θ : Space → ℝ) (d : ℝ) (l : ℤ) (z : Space) : ℂ :=\n  (((2 : ℝ) ^ ((3 + d) * l) : ℝ) : ℂ) *\n    FourierTransform.fourierInv (fun ξ => (θ ξ : ℂ) * σ ξ) (((2 : ℝ) ^ (l : ℝ)) • z)\n\ndef DyadicSplitStatement : Prop :=\n  ∀ (σ : Space → ℂ) (d β : ℝ) (θ : Space → ℝ), 0 ≤ d → 0 < β → β < 3 →\n    IsHomogeneousSymbol σ d → IsRingCutoff θ →\n    ∀ f F : Space → ℂ, IsWeightedSmooth f β → IsTransformOf F f →\n    HasMomentsInL1 (fun ξ => σ ξ * F ξ) →\n    ContDiff ℝ ∞ (FourierTransform.fourierInv (fun ξ => σ ξ * F ξ)) ∧\n    ∀ (n : ℕ) (x : Space), HasSum\n      (fun l : ℤ => iteratedFDeriv ℝ n (kernelConv (dyadicKernel σ θ d l) f) x)\n      (iteratedFDeriv ℝ n (FourierTransform.fourierInv (fun ξ => σ ξ * F ξ)) x)\n\ndef DyadicPieceBoundStatement : Prop :=\n  ∀ (σ : Space → ℂ) (d β : ℝ) (θ : Space → ℝ), 0 ≤ d → 0 < β → β < 3 →\n    IsHomogeneousSymbol σ d → IsRingCutoff θ →\n    ∀ f : Space → ℂ, IsWeightedSmooth f β → ∀ n : ℕ, ∃ C : ℝ, ∀ (l : ℤ) (x : Space), 2 ≤ ‖x‖ →\n      ‖iteratedFDeriv ℝ n (kernelConv (dyadicKernel σ θ d l) f) x‖ ≤\n        C * (if (2 : ℝ) ^ (l : ℝ) * ‖x‖ ≤ 1 then (2 : ℝ) ^ ((d + n + β) * l)\n          else (2 : ℝ) ^ ((d - 2 * (⌈d⌉₊ + 1)) * l) * ‖x‖ ^ (-(β + n + 2 * (⌈d⌉₊ + 1)))\n            + (2 : ℝ) ^ ((d - 1 - ⌈d⌉₊) * l) * ‖x‖ ^ (-(1 + β + ⌈d⌉₊ + n)))\n\ndef HomogeneousMultiplierStatement : Prop :=\n  ∀ (σ : Space → ℂ) (d β : ℝ), 0 ≤ d → 0 < β → β < 3 → IsHomogeneousSymbol σ d →\n    ∀ f F : Space → ℂ, IsWeightedSmooth f β → IsTransformOf F f →\n    HasMomentsInL1 (fun ξ => σ ξ * F ξ) →\n    IsWeightedSmooth (FourierTransform.fourierInv (fun ξ => σ ξ * F ξ)) (β + d)\n\nend Breakdown.FracCert\n"}