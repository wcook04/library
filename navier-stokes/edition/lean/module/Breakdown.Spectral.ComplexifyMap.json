n.Spectral.Complexification.continuous_mk'","Breakdown.Spectral.Complexification.map","Breakdown.Spectral.Complexification.reCLM","Breakdown.Spectral.Complexification.zero_im"],"written":"isCompactOperator_map"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":87,"kind":"theorem","line":86,"module":"Breakdown.Spectral.ComplexifyMap","name":"Breakdown.Spectral.Complexification.map_ofReal","namespace":"Breakdown.Spectral.Complexification","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.Spectral.exists_dichotomy"],"proof_uses":["Breakdown.Spectral.Complexification.ext"],"protected":false,"short":"map_ofReal","signature_end_line":86,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.Spectral.Complexification","Breakdown.Spectral.Complexification.map","Breakdown.Spectral.Complexification.ofReal"],"used_by":["Breakdown.Spectral.exists_dichotomy"],"uses":["Breakdown.Spectral.Complexification","Breakdown.Spectral.Complexification.ext","Breakdown.Spectral.Complexification.map","Breakdown.Spectral.Complexification.ofReal"],"written":"map_ofReal"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":90,"kind":"theorem","line":89,"module":"Breakdown.Spectral.ComplexifyMap","name":"Breakdown.Spectral.Complexification.conj_map","namespace":"Breakdown.Spectral.Complexification","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.Spectral.exists_dichotomy"],"proof_uses":["Breakdown.Spectral.Complexification.ext"],"protected":false,"short":"conj_map","signature_end_line":89,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.Spectral.Complexification","Breakdown.Spectral.Complexification.conj","Breakdown.Spectral.Complexification.map"],"used_by":["Breakdown.Spectral.exists_dichotomy"],"uses":["Breakdown.Spectral.Complexification","Breakdown.Spectral.Complexification.conj","Breakdown.Spectral.Complexification.ext","Breakdown.Spectral.Complexification.map"],"written":"conj_map"}],"imports":["Breakdown.Spectral.Complexify"],"module":"Breakdown.Spectral.ComplexifyMap","path":"Breakdown/Spectral/ComplexifyMap.lean","sha256":"2da0b14a64fa56b30883fe3152856583429847e6665824f64bfce71e08e67af2","source":"import Breakdown.Spectral.Complexify\n\nnoncomputable section\n\nnamespace Breakdown.Spectral\n\nnamespace Complexification\n\nvariable {X : Type*} [NormedAddCommGroup X] [InnerProductSpace ℝ X]\n\nprivate theorem norm_mk_le (T : X →L[ℝ] X) (z : Complexification X) :\n    ‖(⟨T z.re, T z.im⟩ : Complexification X)‖ ≤ ‖T‖ * ‖z‖ := by\n  have h1 := norm_sq_eq (⟨T z.re, T z.im⟩ : Complexification X)\n  have h2 := norm_sq_eq z\n  have a := T.le_opNorm z.re\n  have b := T.le_opNorm z.im\n  have hsq : ‖(⟨T z.re, T z.im⟩ : Complexification X)‖ ^ 2 ≤ (‖T‖ * ‖z‖) ^ 2 := by\n    rw [h1, mul_pow, h2]\n    simp only\n    have a2 : ‖T z.re‖ ^ 2 ≤ (‖T‖ * ‖z.re‖) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) a 2\n    have b2 : ‖T z.im‖ ^ 2 ≤ (‖T‖ * ‖z.im‖) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) b 2\n    nlinarith [a2, b2]\n  exact (sq_le_sq₀ (norm_nonneg _) (mul_nonneg (norm_nonneg _) (norm_nonneg _))).mp hsq\n\ndef map (T : X →L[ℝ] X) : Complexification X →L[ℂ] Complexification X :=\n  LinearMap.mkContinuous\n    { toFun := fun z => ⟨T z.re, T z.im⟩\n      map_add' := fun z w => by ext <;> simp\n      map_smul' := fun c z => by ext <;> simp [map_sub, map_add, map_smul] } ‖T‖\n    (fun z => norm_mk_le T z)\n\n@[simp] theorem map_re (T : X →L[ℝ] X) (z : Complexification X) : (map T z).re = T z.re := rfl\n@[simp] theorem map_im (T : X →L[ℝ] X) (z : Complexification X) : (map T z).im = T z.im := rfl\n\ntheorem map_add (S T : X →L[ℝ] X) : map (S + T) = map S + map T := by\n  ext z <;> simp\n\ntheorem map_mul (S T : X →L[ℝ] X) : map (S * T) = map S * map T := by\n  ext z <;> simp\n\ntheorem map_one : map (1 : X →L[ℝ] X) = 1 := by\n  ext z <;> simp\n\ntheorem map_pow (T : X →L[ℝ] X) (n : ℕ) : map (T ^ n) = map T ^ n := by\n  induction n with\n  | zero => rw [pow_zero, pow_zero, map_one]\n  | succ n ih => rw [pow_succ, pow_succ, map_mul, ih]\n\ntheorem norm_map_le (T : X →L[ℝ] X) : ‖map T‖ ≤ ‖T‖ :=\n  LinearMap.mkContinuous_norm_le _ (norm_nonneg T) _\n\nprivate theorem continuous_im' : Continuous (fun z : Complexification X => z.im) := by\n  have h : (fun z : Complexification X => z.im) = fun z => reCLM ((-Complex.I) • z) := by\n    funext z\n    simp [smul_re]\n  rw [h]\n  exact reCLM.continuous.comp (continuous_const_smul _)\n\nprivate theorem continuous_mk' :\n    Continuous (fun p : X × X => (⟨p.1, p.2⟩ : Complexification X)) := by\n  have h : (fun p : X × X => (⟨p.1, p.2⟩ : Complexification X)) =\n      fun p => ofReal p.1 + Complex.I • ofReal p.2 := by\n    funext p\n    ext <;> simp [smul_re, smul_im]\n  rw [h]\n  exact (ofReal.continuous.comp continuous_fst).add\n    ((continuous_const_smul Complex.I).comp (ofReal.continuous.comp continuous_snd))\n\ntheorem isCompactOperator_map {T : X →L[ℝ] X} (hT : IsCompactOperator T) :\n    IsCompactOperator (map T) := by\n  obtain ⟨K, hK, hKn⟩ := hT\n  refine ⟨(fun p : X × X => (⟨p.1, p.2⟩ : Complexification X)) '' (K ×ˢ K),\n    (hK.prod hK).image continuous_mk', ?_⟩\n  have hre : (fun z : Complexification X => z.re) ⁻¹' (T ⁻¹' K) ∈ (nhds 0 : Filter _) := by\n    have ht := (reCLM (X := X)).continuous.tendsto 0\n    simp only [map_zero] at ht\n    exact ht hKn\n  have him : (fun z : Complexification X => z.im) ⁻¹' (T ⁻¹' K) ∈ (nhds 0 : Filter _) := by\n    have ht := (continuous_im' (X := X)).tendsto 0\n    simp only [zero_im] at ht\n    exact ht hKn\n  refine Filter.mem_of_superset (Filter.inter_mem hre him) ?_\n  rintro z ⟨h1, h2⟩\n  exact ⟨(T z.re, T z.im), ⟨h1, h2⟩, rfl⟩\n\ntheorem map_ofReal (T : X →L[ℝ] X) (x : X) : map T (ofReal x) = ofReal (T x) := by\n  ext <;> simp\n\ntheorem conj_map (T : X →L[ℝ] X) (z : Complexification X) : conj (map T z) = map T (conj z) := by\n  ext <;> simp [map_neg]\n\nend Complexification\n\nend Breakdown.Spectral\n"}