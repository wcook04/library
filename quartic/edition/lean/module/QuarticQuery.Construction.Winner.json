pt"],"protected":false,"short":"winner_no_incoming_zero","signature_end_line":64,"statement_used_by":[],"statement_uses":["QuarticQuery.Address","QuarticQuery.BitInput","QuarticQuery.BitLoc","QuarticQuery.Circuit","QuarticQuery.Circuit.size","QuarticQuery.Column","QuarticQuery.PartialBool","QuarticQuery.WinsAt","QuarticQuery.pointerEquiv","QuarticQuery.readPointerBit","QuarticQuery.readX"],"used_by":["QuarticQuery.Checked.winner_no_incoming_zero"],"uses":["QuarticQuery.Address","QuarticQuery.BitInput","QuarticQuery.BitLoc","QuarticQuery.Circuit","QuarticQuery.Circuit.size","QuarticQuery.Column","QuarticQuery.GateConsistent","QuarticQuery.PartialBool","QuarticQuery.WinsAt","QuarticQuery.pointerEquiv","QuarticQuery.readA","QuarticQuery.readPointerBit","QuarticQuery.readTranscript","QuarticQuery.readX"],"uses_modules":{"QuarticQuery.Address":"QuarticQuery.Statement","QuarticQuery.Column":"QuarticQuery.Statement","QuarticQuery.WinsAt":"QuarticQuery.Statement","QuarticQuery.pointerEquiv":"QuarticQuery.Statement","QuarticQuery.readPointerBit":"QuarticQuery.Statement","QuarticQuery.readX":"QuarticQuery.Statement"},"written":"winner_no_incoming_zero"},{"dependency_source":"lean_report","doc":"Ledger: claim-winner-dominates. Boolean half: the winner's correct cell finds\na zero in every other column.","end_line":71,"kind":"theorem","line":69,"module":"QuarticQuery.Construction.Winner","name":"QuarticQuery.winner_finds_zero","namespace":"QuarticQuery","noncomputable":false,"private":false,"proof_used_by":["QuarticQuery.Upper.cmpProb_winner"],"proof_uses":["QuarticQuery.GateConsistent","QuarticQuery.readA","QuarticQuery.readTranscript"],"protected":false,"short":"winner_finds_zero","signature_end_line":70,"statement_used_by":[],"statement_uses":["QuarticQuery.Address","QuarticQuery.BitInput","QuarticQuery.BitLoc","QuarticQuery.Circuit","QuarticQuery.Circuit.size","QuarticQuery.Column","QuarticQuery.PartialBool","QuarticQuery.WinsAt","QuarticQuery.pointerEquiv","QuarticQuery.readPointerBit","QuarticQuery.readX"],"used_by":["QuarticQuery.Checked.winner_finds_zero","QuarticQuery.Upper.cmpProb_winner"],"uses":["QuarticQuery.Address","QuarticQuery.BitInput","QuarticQuery.BitLoc","QuarticQuery.Circuit","QuarticQuery.Circuit.size","QuarticQuery.Column","QuarticQuery.GateConsistent","QuarticQuery.PartialBool","QuarticQuery.WinsAt","QuarticQuery.pointerEquiv","QuarticQuery.readA","QuarticQuery.readPointerBit","QuarticQuery.readTranscript","QuarticQuery.readX"],"uses_modules":{"QuarticQuery.Column":"QuarticQuery.Statement","QuarticQuery.WinsAt":"QuarticQuery.Statement","QuarticQuery.pointerEquiv":"QuarticQuery.Statement","QuarticQuery.readPointerBit":"QuarticQuery.Statement","QuarticQuery.readX":"QuarticQuery.Statement"},"written":"winner_finds_zero"}],"imports":["QuarticQuery.Statement"],"module":"QuarticQuery.Construction.Winner","path":"QuarticQuery/Construction/Winner.lean","sha256":"3c6b894e842fc90acd7a09b9ff14ce3ae2f09bfbf2dc7f2195751a396db7017c","source":"module\n\npublic import QuarticQuery.Statement\n\n/-!\n# Winners of the addressed function\n\nThe pointer bijection, uniqueness of the winner and its address (Section 2.2),\nand the Boolean comparison facts of Section 3.3. Everything is stated for the\ngeneric `addressedF f C ℓ r` and needs no property of the circuit.\n-/\n\npublic section\n\nnamespace QuarticQuery\n\ntheorem mValue_eq (t : ℕ) : mValue t = 2 ^ (2 * t) := rfl\n\ntheorem mValue_eq_four_pow (t : ℕ) : mValue t = 4 ^ t := by\n  simp [mValue, pow_mul]\n\ntheorem card_column (ℓ : ℕ) : Fintype.card (Column ℓ) = 2 ^ ℓ :=\n  Fintype.card_fin _\n\n/-- Ledger: def-column-layout. -/\ntheorem pointerEquiv_bijective (ℓ : ℕ) : Function.Bijective (pointerEquiv ℓ) :=\n  (pointerEquiv ℓ).bijective\n\n/-- Ledger: def-column-layout. Every column has exactly one `ℓ`-bit name, so no\npointer pattern is invalid. -/\ntheorem existsUnique_pointer (ℓ : ℕ) (j : Column ℓ) :\n    ∃! w : Fin ℓ → Bool, pointerEquiv ℓ w = j :=\n  (pointerEquiv_bijective ℓ).existsUnique j\n\nsection Winners\n\nvariable {κ : Type} {f : PartialBool κ} {C : Circuit κ} {ℓ r : ℕ}\n  {x : BitInput (BitLoc ℓ r C.size κ)} {i i' : Column ℓ} {s s' : Address r}\n\n/-- Ledger: def-F. A winner's pointer (8) puts a zero in any other winner's\nall-one string. -/\ntheorem winsAt_column_unique (h : WinsAt f C ℓ r x i s) (h' : WinsAt f C ℓ r x i' s') :\n    i = i' := by\n  by_contra hne\n  have hzero := h.2.2.2 ⟨i', fun e => hne e.symm⟩\n  have hone := h'.1 (pointerEquiv ℓ (readPointerBit x i s ⟨i', fun e => hne e.symm⟩))\n  exact Bool.noConfusion (hone.symm.trans hzero)\n\n/-- Ledger: eq-7. The address of a column is forced by `f`. -/\ntheorem winsAt_address_unique (h : WinsAt f C ℓ r x i s) (h' : WinsAt f C ℓ r x i s') :\n    s = s' :=\n  funext fun a => Option.some.inj ((h.2.1 a).symm.trans (h'.2.1 a))\n\n/-- Ledger: def-F. There is at most one winning pair. -/\ntheorem winsAt_unique (h : WinsAt f C ℓ r x i s) (h' : WinsAt f C ℓ r x i' s') :\n    i = i' ∧ s = s' := by\n  obtain rfl := winsAt_column_unique h h'\n  exact ⟨rfl, winsAt_address_unique h h'⟩\n\n/-- Ledger: claim-winner-dominates. Boolean half: a winner's string is all ones,\nso no pointer, from any column at any address, finds a zero in it. -/\ntheorem winner_no_incoming_zero (h : WinsAt f C ℓ r x i s) (c : Column ℓ) (a : Address r)\n    (hne : i ≠ c) :\n    readX x i (pointerEquiv ℓ (readPointerBit x c a ⟨i, hne⟩)) = true :=\n  h.1 _\n\n/-- Ledger: claim-winner-dominates. Boolean half: the winner's correct cell finds\na zero in every other column. -/\ntheorem winner_finds_zero (h : WinsAt f C ℓ r x i s) (j : Column ℓ) (hne : j ≠ i) :\n    readX x j (pointerEquiv ℓ (readPointerBit x i s ⟨j, hne⟩)) = false :=\n  h.2.2.2 ⟨j, hne⟩\n\nend Winners\n\nend QuarticQuery\n"}