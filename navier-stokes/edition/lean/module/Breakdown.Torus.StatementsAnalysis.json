odic.Coef","Breakdown.Periodic.Lattice","Breakdown.Periodic.Seq","Breakdown.Periodic.V","Breakdown.Periodic.advCoef","Breakdown.Periodic.weight"],"written":"TrilinearBound"}],"imports":["Breakdown.Torus.Mild"],"module":"Breakdown.Torus.StatementsAnalysis","path":"Breakdown/Torus/StatementsAnalysis.lean","sha256":"7ff962326101048ed4eef89e8897a0438b60462b9d65df877905a09d6cdecef7","source":"import Breakdown.Torus.Mild\n\nopen MeasureTheory Set Real\n\nnoncomputable section\n\nnamespace Breakdown.Periodic\n\ndef KernelSharpBound : Prop :=\n  ∃ C : ℝ, 0 < C ∧ ∀ τ : ℝ, 0 < τ → τ ≤ 1 → ‖kernel τ‖ ≤ C * τ ^ (-(3 / 4 : ℝ))\n\ndef MildUniqueness : Prop :=\n  ∀ (u v : ℝ → V) (a b : ℝ), IsMildOn u a b → IsMildOnIcc v a b → u a = v a → EqOn u v (Ico a b)\n\ndef TrilinearBound : Prop :=\n  ∃ C : ℝ, 0 < C ∧ ∀ (u v : V) (φ : Lattice → Coef),\n    Summable (fun k => ‖φ k‖) → Summable (fun k => weight k * ‖φ k‖ ^ 2) →\n    ‖∑' k, inner ℂ (φ k) (advCoef u v k)‖ ≤\n      C * ‖u‖ * ‖v‖ * (∑' k, ‖φ k‖ ^ 2) ^ (1 / 4 : ℝ) * (∑' k, weight k * ‖φ k‖ ^ 2) ^ (1 / 4 : ℝ)\n\nend Breakdown.Periodic\n"}