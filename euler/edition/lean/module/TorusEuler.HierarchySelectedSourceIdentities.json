,"TorusEuler.HierarchyTwistedProfile.ParentGeometry.inverseGraph_values","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.parentResidual","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.parentResidual_average","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.parentStrain_phaseIndependent","TorusEuler.HierarchyTwistedProfile.TransverseCoefficients.covector_independent","TorusEuler.HierarchyTwistedProfile.TransverseCoefficients.covector_ne_zero","TorusEuler.HierarchyTwistedProfile.average_construct_sourceBeforeMean_eq_slowProducts","TorusEuler.HierarchyTwistedProfile.solveTransverse","TorusEuler.IsLabelFlowOn.contDiffOn_inverseLabelFlow"],"protected":false,"short":"average_selectedSourceBeforeMean_eq","signature_end_line":76,"sorry":false,"statement_used_by":[],"statement_uses":["TorusEuler.HierarchyOperators.average","TorusEuler.HierarchyOperators.labelAdv","TorusEuler.HierarchyOperators.sourceBeforeMean","TorusEuler.HierarchyPeriodicProfile","TorusEuler.HierarchyProfilePoint","TorusEuler.HierarchyProfiles.B","TorusEuler.HierarchyProfiles.V","TorusEuler.HierarchyProfiles.Y","TorusEuler.HierarchySmoothProfile","TorusEuler.HierarchyTransverseOutput.p","TorusEuler.HierarchyTwistedProfile","TorusEuler.HierarchyTwistedProfile.ParentGeometry","TorusEuler.HierarchyTwistedProfile.ParentGeometry.covector","TorusEuler.HierarchyTwistedProfile.ParentGeometry.inverse","TorusEuler.HierarchyTwistedProfile.ParentGeometry.strain","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.leading","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.operators","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.profiles","TorusEuler.HierarchyTwistedProfile.PhysicalLeadingInput.completionSwitch","TorusEuler.HierarchyTwistedProfile.PhysicalLeadingInput.output","TorusEuler.HierarchyTwistedProfile.slowLabelDivergenceProduct","TorusEuler.HierarchyTwistedProfile.twistedHierarchyOperators","TorusEuler.IsLabelFlowOn","TorusEuler.Pressure","TorusEuler.SpatiallyPeriodic","TorusEuler.Vec3","TorusEuler.Velocity","TorusEuler.hierarchyLevelPairs","TorusEuler.instAddCommGroupHierarchyTwistedProfile","TorusEuler.instModuleHierarchyTwistedProfile","TorusEuler.phaseMean"],"used_by":["TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.selectedNormRecurrence","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.selectedTimeHierarchyBounds"],"uses":["TorusEuler.HierarchyOperators.average","TorusEuler.HierarchyOperators.labelAdv","TorusEuler.HierarchyOperators.sourceBeforeMean","TorusEuler.HierarchyPeriodicProfile","TorusEuler.HierarchyProfilePoint","TorusEuler.HierarchyProfiles.B","TorusEuler.HierarchyProfiles.V","TorusEuler.HierarchyProfiles.Y","TorusEuler.HierarchySmoothProfile","TorusEuler.HierarchyTransverseOutput.p","TorusEuler.HierarchyTwistedProfile","TorusEuler.HierarchyTwistedProfile.MeanCoefficients.inverse_independent","TorusEuler.HierarchyTwistedProfile.ParentGeometry","TorusEuler.HierarchyTwistedProfile.ParentGeometry.covector","TorusEuler.HierarchyTwistedProfile.ParentGeometry.inverse","TorusEuler.HierarchyTwistedProfile.ParentGeometry.inverseGraph_values","TorusEuler.HierarchyTwistedProfile.ParentGeometry.strain","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.leading","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.operators","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.parentResidual","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.parentResidual_average","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.parentStrain_phaseIndependent","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.profiles","TorusEuler.HierarchyTwistedProfile.PhysicalLeadingInput.completionSwitch","TorusEuler.HierarchyTwistedProfile.PhysicalLeadingInput.output","TorusEuler.HierarchyTwistedProfile.TransverseCoefficients.covector_independent","TorusEuler.HierarchyTwistedProfile.TransverseCoefficients.covector_ne_zero","TorusEuler.HierarchyTwistedProfile.average_construct_sourceBeforeMean_eq_slowProducts","TorusEuler.HierarchyTwistedProfile.slowLabelDivergenceProduct","TorusEuler.HierarchyTwistedProfile.solveTransverse","TorusEuler.HierarchyTwistedProfile.twistedHierarchyOperators","TorusEuler.IsLabelFlowOn","TorusEuler.IsLabelFlowOn.contDiffOn_inverseLabelFlow","TorusEuler.Pressure","TorusEuler.SpatiallyPeriodic","TorusEuler.Vec3","TorusEuler.Velocity","TorusEuler.hierarchyLevelPairs","TorusEuler.instAddCommGroupHierarchyTwistedProfile","TorusEuler.instModuleHierarchyTwistedProfile","TorusEuler.phaseMean"],"written":"average_selectedSourceBeforeMean_eq"}],"imports":["TorusEuler.HierarchyPhysicalApproximation","TorusEuler.HierarchyTwistedSourceCancellation"],"module":"TorusEuler.HierarchySelectedSourceIdentities","path":"TorusEuler/HierarchySelectedSourceIdentities.lean","sha256":"8a7f59ee5d04abeb483bbe1d41bc3ece539c10a7abba710e3d7ba7e460446769","source":"import TorusEuler.HierarchyPhysicalApproximation\nimport TorusEuler.HierarchyTwistedSourceCancellation\n\n/-! Pressure normalization and source cancellation for the actual selected expansion. -/\n\nopen Set\nopen scoped ContDiff InnerProductSpace\n\nnamespace TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData\n\nnoncomputable section\n\nvariable {T : ℝ} {U : Velocity} {X : ℝ → Velocity} {k : Vec3} {p : Pressure}\n  {hT : 0 < T} {d : ParentGeometry hT U X k} {P : ℕ}\n\nlocal notation \"I\" => Icc (0 : ℝ) T\nlocal notation \"J\" => Set.prod I (univ : Set Vec3)\n\n/-- Every retained oscillatory pressure has zero phase mean, including the\nprescribed pressure at level one. -/\ntheorem selected_pressure_phaseMean_zero (b : PhysicalApproximationData d p P)\n    (hLeading : ∀ t ∈ I, ∀ a, phaseMean (fun s => b.leading.output.p.val.val.val (t,a,s)) = 0)\n    {i : ℕ} (hi : i ∈ Finset.Icc 1 P) (t : ℝ) (ht : t ∈ I) (a : Vec3) :\n    phaseMean (fun s => (b.profiles.p i).val.val.val (t,a,s)) = 0 := by\n  by_cases h : i = 1\n  · subst i\n    have hq : b.profiles.p 1 = b.leading.output.p :=\n      (b.solvers.construct_leading P b.leading.completionSwitch b.parentResidual\n        b.parentResidual_average b.leading.output).2.1\n    rw [hq]\n    exact hLeading t ht a\n  · obtain ⟨hl, hr⟩ := Finset.mem_Icc.mp hi\n    have hi' : i ∈ Finset.Icc 2 P := Finset.mem_Icc.mpr ⟨by omega, hr⟩\n    obtain ⟨hf, _, hq⟩ := b.solvers.construct_transverse_selected hi' b.leading.completionSwitch\n      b.parentResidual b.parentResidual_average b.leading.output\n    change b.profiles.p i = _ at hq\n    rw [hq]\n    exact (solveTransverse hT d.inverse d.strain d.covector d.oscillation _ hf).pressure_mean t ht a\n\ntheorem parentStrain_phaseIndependent : HierarchyPeriodicProfile.PhaseIndependent d.strain.val.val := by\n  intro x hx s\n  exact (d.strain_value (x.1,x.2.1,s) ⟨hx.1,mem_univ _⟩).trans (d.strain_value x hx).symm\n\n/-- The phase-centered linear relay of the actual selected expansion. -/\ntheorem average_selectedRelay_eq_zero (b : PhysicalApproximationData d p P)\n    (hLeading : ∀ t ∈ I, ∀ a, phaseMean (fun s => b.leading.output.p.val.val.val (t,a,s)) = 0)\n    (hSwitch : b.operators.average b.leading.completionSwitch = 0)\n    {i : ℕ} (hi : i ∈ Finset.Icc 2 P) :\n    b.operators.average (b.operators.relayAtLevel b.profiles b.leading.completionSwitch i) = 0 := by\n  obtain ⟨hl,hr⟩ := Finset.mem_Icc.mp hi\n  have hiprev : i - 1 ∈ Finset.Icc 1 P := Finset.mem_Icc.mpr ⟨by omega,by omega⟩\n  have hC : b.profiles.C (i-1) = b.solvers.complete (b.profiles.V (i-1)) :=\n    b.solvers.construct_completion hiprev b.leading.completionSwitch b.parentResidual\n      b.parentResidual_average b.leading.output\n  have hCmean : b.operators.average (b.profiles.C (i-1)) = 0 := by\n    rw [hC]\n    exact average_complete hT d.inverse d.strain d.covector d.mean.inverse_independent\n      d.oscillation.covector_independent d.oscillation.covector_ne_zero _\n  exact average_relayAtLevel_eq_zero hT d.inverse d.strain d.covector d.mean.inverse_independent\n    (parentStrain_phaseIndependent (d := d)) b.profiles b.leading.completionSwitch i hCmean\n    (b.selected_pressure_phaseMean_zero hLeading hiprev) hSwitch\n\nset_option maxHeartbeats 1500000 in\n/-- Apply the three-term mean-source cancellation to the actual parent\nchart and selected profiles. -/\ntheorem average_selectedSourceBeforeMean_eq (b : PhysicalApproximationData d p P)\n    (hX : IsLabelFlowOn U X I) (hU : ContDiffOn ℝ ∞ (Function.uncurry U) J)\n    (hper : ∀ t ∈ I, SpatiallyPeriodic (U t))\n    (hLeading : ∀ t ∈ I, ∀ a, phaseMean (fun s => b.leading.output.p.val.val.val (t,a,s)) = 0)\n    (hSwitch : b.operators.average b.leading.completionSwitch = 0)\n    (hP : 1 ≤ P) {i : ℕ} (hi : i ≤ P) :\n    b.operators.average (b.operators.sourceBeforeMean b.profiles P b.leading.completionSwitch i) =\n      ∑ ij ∈ hierarchyLevelPairs P 0 i,\n        (b.operators.average (b.operators.labelAdv (b.profiles.Y ij.1) (b.profiles.Y ij.2)) +\n          b.operators.average (slowLabelDivergenceProduct hT d.inverse (b.profiles.V ij.1) (b.profiles.Y ij.2)) +\n          b.operators.labelAdv (b.profiles.B ij.1) (b.profiles.B ij.2)) := by\n  obtain ⟨hsurj,hgraph⟩ := d.inverseGraph_values hX hU hper\n  have hAreg := hX.contDiffOn_inverseLabelFlow hT hU hper\n  have hA (t : ℝ) (ht : t ∈ I) : ContDiff ℝ 2 (X t 0) := by\n    have hProj : ContDiff ℝ ∞ (fun x : Vec3 => (t,x)) := contDiff_const.prodMk contDiff_id\n    exact ((hAreg.comp_contDiff hProj (fun x => ⟨ht,mem_univ x⟩)).of_le (by simp))\n  exact average_construct_sourceBeforeMean_eq_slowProducts hT d.inverse d.strain d.covector\n    d.mean.inverse_independent (parentStrain_phaseIndependent (d := d)) d.oscillation.covector_independent\n    d.oscillation.covector_ne_zero hA hsurj (fun t ht x s => (hgraph t ht x s).1)\n    (fun t ht x => (hgraph t ht x 0).2) b.solvers (fun _ => rfl) hP hi\n    b.leading.completionSwitch b.parentResidual b.parentResidual_average b.leading.output hLeading\n    (fun f hf => (solveTransverse hT d.inverse d.strain d.covector d.oscillation f hf).pressure_mean) hSwitch\n\nend\n\nend TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData\n"}