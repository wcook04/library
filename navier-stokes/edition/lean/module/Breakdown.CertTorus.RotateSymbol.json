"Breakdown.Freq.CSpace","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Freq.rotX","Breakdown.SmoothFlow.toWeightL1","Breakdown.SmoothFlow.weightL1Measure","Breakdown.Space"],"written":"weightNorm_rotX"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":230,"kind":"theorem","line":217,"module":"Breakdown.CertTorus.RotateSymbol","name":"Breakdown.FarField.Internal.RotateSymbol.physField_rotX","namespace":"Breakdown.FarField.Internal.RotateSymbol","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.FarField.rotateSymbol_holds"],"proof_uses":["Breakdown.FarField.Internal.RotateSymbol.realVec_rotC","Breakdown.FarField.Internal.RotateSymbol.rotCIsom_apply","Breakdown.FarField.Internal.RotateSymbol.rotC_complex_smul","Breakdown.FarField.Internal.RotateSymbol.velSymbol_rotX_ae","Breakdown.Freq.rotC"],"protected":false,"short":"physField_rotX","signature_end_line":218,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.FarField.velSymbol","Breakdown.Freq.CSpace","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Freq.rotX","Breakdown.SmoothFlow.physField","Breakdown.Space"],"used_by":["Breakdown.FarField.rotateSymbol_holds"],"uses":["Breakdown.FarField.Internal.RotateSymbol.realVec_rotC","Breakdown.FarField.Internal.RotateSymbol.rotCIsom_apply","Breakdown.FarField.Internal.RotateSymbol.rotC_complex_smul","Breakdown.FarField.Internal.RotateSymbol.velSymbol_rotX_ae","Breakdown.FarField.velSymbol","Breakdown.Freq.CSpace","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Freq.rotC","Breakdown.Freq.rotX","Breakdown.SmoothFlow.physField","Breakdown.Space"],"written":"physField_rotX"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":236,"kind":"theorem","line":235,"module":"Breakdown.CertTorus.RotateSymbol","name":"Breakdown.FarField.rotateSymbol_holds","namespace":"Breakdown.FarField","noncomputable":