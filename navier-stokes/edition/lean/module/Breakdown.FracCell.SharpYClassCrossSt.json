CellScalars.splitLength","Breakdown.CellCert.CellAnalysis.IsAxisymmetricWeight","Breakdown.CellCert.CellAnalysis.IsCellData","Breakdown.CellCert.CellAnalysis.SharpParts.classCrossDensity","Breakdown.CellCert.FracCellData","Breakdown.Space","Breakdown.SteadyCert.FracCertData.order"],"used_by":["Breakdown.CellCert.CellAnalysis.classCrossRegular_holds","Breakdown.CellCert.CellAnalysis.classCross_of","Breakdown.CellCert.CellAnalysis.classCross_of_ae","Breakdown.CellCert.CellAnalysis.classCross_of_pointwise","Breakdown.CellCert.CellAnalysis.classCross_of_pointwiseAe","Breakdown.CellCert.CellAnalysis.classCross_of_rest","Breakdown.CellCert.CellAnalysis.sharpYCharge_of_leafset","Breakdown.CellCert.CellCoordinates.cellBound_of_leafset"],"uses":["Breakdown.CellCert.Assembly.FieldTuple","Breakdown.CellCert.Assembly.IsAdmissible","Breakdown.CellCert.Assembly.IsFormData","Breakdown.CellCert.CellAnalysis.CellBases","Breakdown.CellCert.CellAnalysis.CellBox","Breakdown.CellCert.CellAnalysis.CellBox.lowStrainAt","Breakdown.CellCert.CellAnalysis.CellBox.lowVelocityAt","Breakdown.CellCert.CellAnalysis.CellBox.rect","Breakdown.CellCert.CellAnalysis.CellClasses","Breakdown.CellCert.CellAnalysis.CellClasses.classLoss","Breakdown.CellCert.CellAnalysis.CellClasses.count","Breakdown.CellCert.CellAnalysis.CellRows","Breakdown.CellCert.CellAnalysis.CellScalars","Breakdown.CellCert.CellAnalysis.CellScalars.band","Breakdown.CellCert.CellAnalysis.CellScalars.degHigh","Breakdown.CellCert.CellAnalysis.CellScalars.resolved","Breakdown.CellCert.CellAnalysis.CellScalars.splitLength","Breakdown.CellCert.CellAnalysis.IsAxisymmetricWeight","Breakdown.CellCert.CellAnalysis.IsCellData","Breakdown.CellCert.CellAnalysis.SharpParts.classCrossDensity","Breakdown.CellCert.FracCellData","Breakdown.Space","Breakdown.SteadyCert.FracCertData.order"],"written":"ClassCrossRegularStatement"}],"imports":["Breakdown.FracCell.SharpYChargeSt"],"module":"Breakdown.FracCell.SharpYClassCrossSt","path":"Breakdown/FracCell/SharpYClassCrossSt.lean","sha256":"d8507c1bc42c1d63258fcbc65d75828727ba7fe934ff31d516228ad2e9b3f5f5","source":"import Breakdown.FracCell.SharpYChargeSt\n\nopen MeasureTheory\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace CellCert\n\nnamespace CellAnalysis\n\nopen SteadyCert Assembly SharpParts\n\nnamespace SharpParts\n\nvariable {k N : ℕ} (c : FracCellData k N) (K : CellBox) (S : CellScalars) (x : FieldTuple k)\n\nopen Classical in\ndef classCrossDensity (T : Set ℤ) (n n' : ℤ) (p : ℝ × ℝ) : ℝ :=\n  (if n' ∈ T then\n      pairWave c n n' p (lowGrad c K S x n p) (lowVel c K S x n p) (sharpGrad c K S x n' p) (sharpVel c K S x n' p)\n        + pairWave c n' n p (sharpGrad c K S x n' p) (sharpVel c K S x n' p) (lowGrad c K S x n p) (lowVel c K S x n p)\n      else 0).re\n\nend SharpParts\n\nopen SharpParts\n\ndef ClassPointwiseStatement : Prop :=\n  ∀ (α : ℝ), 1 < α → α < 5 / 4 → ∀ {k N : ℕ} (c : FracCellData k N), IsFormData α c →\n    ∀ (K : CellBox) (S : CellScalars) (B : CellBases) (Cl : CellClasses) {slots : ℕ}\n      (R : CellRows N slots k), IsCellData α c K S B Cl R →\n    ∀ p ∈ Set.Ioo K.r₁ K.r₂ ×ˢ Set.Ioo K.z₁ K.z₂, p.1 ≠ 0 → ∀ (F : Finset ℤ) (s : ℤ → Fin 3 → Fin 3 → ℂ) (v : ℤ → Fin 3 → ℂ)\n      (s' : ℤ → Fin 3 → Fin 3 → ℂ) (v' : ℤ → Fin 3 → ℂ),\n      -(∑ n ∈ S.resolved, ∑ i : Fin Cl.count,\n          if n ∈ Cl.resolvedPart i then Cl.shareWeight i * Cl.classLoss S.splitLength i p (s n) (v n) else 0)\n        - ∑ n' ∈ F, (if n' ∈ S.resolved ∪ S.band then 0 else\n          ∑ i, Cl.classLoss S.splitLength i p (s' n') (v' n') / Cl.shareWeight i)\n      ≤ ∑ n ∈ S.resolved, ∑ n' ∈ F, (if n' ∈ S.resolved ∪ S.band then 0 else\n          pairWave c n n' p (s n) (v n) (s' n') (v' n') + pairWave c n' n p (s' n') (v' n') (s n) (v n)).re\n\ndef ClassProductSplitStatement : Prop :=\n  ∀ (α : ℝ), 1 < α → α < 5 / 4 → ∀ {k N : ℕ} (c : FracCellData k N), IsFormData α c →\n    ∀ (K : CellBox) (S : CellScalars) (B : CellBases) (Cl : CellClasses) {slots : ℕ}\n      (R : CellRows N slots k), IsCellData α c K S B Cl R →\n    ∀ p ∈ Set.Ioo K.r₁ K.r₂ ×ˢ Set.Ioo K.z₁ K.z₂, p.1 ≠ 0 → ∀ (i : Fin Cl.count) (L F : Finset ℤ) (s : ℤ → Fin 3 → Fin 3 → ℂ) (v : ℤ → Fin 3 → ℂ)\n      (s' : ℤ → Fin 3 → Fin 3 → ℂ) (v' : ℤ → Fin 3 → ℂ),\n      -(Cl.shareWeight i * ∑ n ∈ L, Cl.classLoss S.splitLength i p (s n) (v n))\n        - (∑ n' ∈ F, Cl.classLoss S.splitLength i p (s' n') (v' n')) / Cl.shareWeight i\n      ≤ ∑ n ∈ L, ∑ n' ∈ F, (if n - n' ∈ Cl.modes i then\n          (pairWave c n n' p (s n) (v n) (s' n') (v' n') + pairWave c n' n p (s' n') (v' n') (s n) (v n)).re else 0)\n\ndef ClassCrossRegularStatement : Prop :=\n  ∀ (α : ℝ), 1 < α → α < 5 / 4 → ∀ {k N : ℕ} (c : FracCellData k N), IsFormData α c →\n    ∀ (K : CellBox) (S : CellScalars) (B : CellBases) (Cl : CellClasses) {slots : ℕ}\n      (R : CellRows N slots k), IsCellData α c K S B Cl R → IsAxisymmetricWeight c K →\n    ∀ x : FieldTuple k, IsAdmissible c x →\n      (∀ n ∈ S.resolved, ∀ n', IntegrableOn (fun p : ℝ × ℝ => p.1 * classCrossDensity c K S x (↑(S.resolved ∪ S.band))ᶜ n n' p) K.rect) ∧\n      (∀ n ∈ S.resolved, ∀ i, IntegrableOn (fun p : ℝ × ℝ => p.1 * Cl.classLoss S.splitLength i p\n        (K.lowStrainAt c.order n S.degHigh x.2.1 p) (K.lowVelocityAt c.order n S.degHigh x.1 p)) K.rect)\n\nend CellAnalysis\n\nend CellCert\n\nend Breakdown\n"}