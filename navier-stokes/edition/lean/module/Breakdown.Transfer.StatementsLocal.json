"Breakdown","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"CompactPieceStatement","signature_end_line":58,"sorry":false,"statement_used_by":["Breakdown.compactPiece","Breakdown.compactPiece_of","Breakdown.monodromy_of","Breakdown.scaledMonodromy_of"],"statement_uses":["Breakdown.HeatBilinear","Breakdown.HeatBilinear.HasCompactKernel","Breakdown.HeatBilinear.pieceBil","Breakdown.Piece","Breakdown.pieceEnd"],"used_by":["Breakdown.compactPiece","Breakdown.compactPiece_of","Breakdown.monodromy_of","Breakdown.scaledMonodromy_of"],"uses":["Breakdown.HeatBilinear","Breakdown.HeatBilinear.HasCompactKernel","Breakdown.HeatBilinear.pieceBil","Breakdown.Piece","Breakdown.pieceEnd"],"written":"CompactPieceStatement"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":68,"kind":"def","line":63,"module":"Breakdown.Transfer.StatementsLocal","name":"Breakdown.PiecePerturbationStatement","namespace":"Breakdown","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"PiecePerturbationStatement","signature_end_line":63,"sorry":false,"statement_used_by":["Breakdown.piecePerturbation","Breakdown.piecePerturbation_of","Breakdown.scaledTransferHolds_of","Breakdown.transferHolds_of"],"statement_uses":["Breakdown.HeatBilinear","Breakdown.HeatBilinear.IsMildOnIcc","Breakdown.HeatBilinear.pieceBil","Breakdown.HeatBilinear.pieceFree","Breakdown.Piece","Breakdown.extendPiece"],"used_by":["Breakdown.piecePerturbation","Breakdown.piecePerturbation_of","Breakdown.scaledTransferHolds_of","Breakdown.transferHolds_of"],"uses":["Breakdown.HeatBilinear","Breakdown.HeatBilinear.IsMildOnIcc","Breakdown.HeatBilinear.pieceBil","Breakdown.HeatBilinear.pieceFree","Breakdown.Piece","Breakdown.extendPiece"],"written":"PiecePerturbationStatement"}],"imports":["Breakdown.Transfer.StatementsDefs"],"module":"Breakdown.Transfer.StatementsLocal","path":"Breakdown/Transfer/StatementsLocal.lean","sha256":"e31f5b3f8a149d60e812d570ba3fffe4537047f345679ba1e5777b0ec03b150d","source":"import Breakdown.Transfer.StatementsDefs\n\nopen MeasureTheory Set Real\n\nnoncomputable section\n\nnamespace Breakdown\n\ndef VarConstIntegralStatement : Prop :=\n  ∀ (X : Type) [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X] (H : HeatBilinear X)\n    (u v : ℝ → X) (a b M N : ℝ), a ≤ b → ContinuousOn u (Icc a b) → ContinuousOn v (Icc a b) →\n    (∀ s ∈ Icc a b, ‖u s‖ ≤ M) → (∀ s ∈ Icc a b, ‖v s‖ ≤ N) →\n    (∀ t ∈ Icc a b, IntervalIntegrable (fun s => H.K (t - s) (u s) (v s)) volume a t) ∧\n    (∀ t ∈ Icc a b, t - a ≤ 1 →\n      ‖∫ s in a..t, H.K (t - s) (u s) (v s)‖ ≤ 4 * H.CK * (t - a) ^ (1 / 4 : ℝ) * M * N) ∧\n    ContinuousOn (fun t => ∫ s in a..t, H.K (t - s) (u s) (v s)) (Icc a b)\n\ndef PieceOperatorStatement : Prop :=\n  ∀ (X : Type) [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X] (H : HeatBilinear X)\n    (T : ℝ), 0 < T →\n    (∀ (f g : Piece X T) (t : Icc (0 : ℝ) T),\n      H.pieceBil T f g t = ∫ s in (0 : ℝ)..t, H.K (t - s) (extendPiece f s) (extendPiece g s)) ∧\n    (T ≤ 1 → ‖H.pieceBil T‖ ≤ 4 * H.CK * T ^ (1 / 4 : ℝ)) ∧\n    (∀ (x : X) (t : Icc (0 : ℝ) T), H.pieceFree T x t = H.G t x) ∧\n    ‖H.pieceFree T‖ ≤ 1\n\ndef RestrictStatement : Prop :=\n  ∀ (X : Type) [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X] (H : HeatBilinear X)\n    (u : ℝ → X) (a m t : ℝ), a ≤ m → m ≤ t → ContinuousOn u (Icc a t) →\n    H.VarConst u a m → H.VarConst u a t → H.VarConst u m t\n\ndef ConcatStatement : Prop :=\n  ∀ (X : Type) [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X] (H : HeatBilinear X)\n    (u : ℝ → X) (a m t : ℝ), a ≤ m → m ≤ t → ContinuousOn u (Icc a t) →\n    H.VarConst u a m → H.VarConst u m t → H.VarConst u a t\n\ndef ShiftStatement : Prop :=\n  ∀ (X : Type) [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X] (H : HeatBilinear X)\n    (u : ℝ → X) (a t c : ℝ), H.VarConst u a t ↔ H.VarConst (fun s => u (s + c)) (a - c) (t - c)\n\ndef UniqueStatement : Prop :=\n  ∀ (X : Type) [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X] (H : HeatBilinear X)\n    (u v : ℝ → X) (a b : ℝ),\n    (H.IsMildOn u a b → H.IsMildOn v a b → u a = v a → ∀ t ∈ Ico a b, u t = v t) ∧\n    (H.IsMildOnIcc u a b → H.IsMildOnIcc v a b → u a = v a → ∀ t ∈ Icc a b, u t = v t)\n\ndef SmallDataStatement : Prop :=\n  ∀ (X : Type) [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X] (H : HeatBilinear X),\n    ∃ c > 0, ∀ x : X, ‖x‖ ≤ c → ∃ u : ℝ → X, u 0 = x ∧ H.IsMildOnIcc u 0 1 ∧\n      ∀ t ∈ Icc (0 : ℝ) 1, ‖u t‖ ≤ 2 * ‖x‖\n\ndef CompactSimpleStatement : Prop :=\n  ∀ (X : Type) [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X] (H : HeatBilinear X)\n    (T : ℝ) (y : X) (φ : C(Icc (0 : ℝ) T, ℝ)) (f : Piece X T), 0 < T → T ≤ 1 →\n    (∀ τ, 0 < τ → IsCompactOperator (H.K τ y)) → (∀ t, f t = φ t • y) →\n    IsCompactOperator ((pieceEnd T).comp (H.pieceBil T f))\n\ndef CompactPieceStatement : Prop :=\n  ∀ (X : Type) [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X] (H : HeatBilinear X)\n    (T : ℝ), 0 < T → T ≤ 1 → H.HasCompactKernel →\n    ∀ f : Piece X T, IsCompactOperator ((pieceEnd T).comp (H.pieceBil T f))\n\ndef PiecePerturbationStatement : Prop :=\n  ∀ (X : Type) [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X] (H : HeatBilinear X)\n    (T : ℝ) (ub v : Piece X T) (x : X), 0 < T → T ≤ 1 →\n    H.IsMildOnIcc (extendPiece ub) 0 T →\n    v = H.pieceFree T x + (2 : ℝ) • H.pieceBil T ub v + H.pieceBil T v v →\n    extendPiece v 0 = x ∧ H.IsMildOnIcc (extendPiece (ub + v)) 0 T\n\nend Breakdown\n"}