AdjointDefect.AzimuthalParts.Internal.weighted_norm_sq","Breakdown.AdjointDefect.componentWeight","Breakdown.Space","Breakdown.matSq"],"written":"weighted_squareSum"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":65,"kind":"theorem","line":61,"module":"Breakdown.CellReduction.AdjointRemainderAzimuthalAlgebra","name":"Breakdown.AdjointDefect.AzimuthalParts.Internal.inner_components","namespace":"Breakdown.AdjointDefect.AzimuthalParts.Internal","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.AdjointDefect.AzimuthalParts.Internal.slice_bound"],"proof_uses":[],"protected":false,"short":"inner_components","signature_end_line":63,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.AdjointDefect.complexComponent","Breakdown.AdjointDefect.componentWeight","Breakdown.Space"],"used_by":["Breakdown.AdjointDefect.AzimuthalParts.Internal.slice_bound"],"uses":["Breakdown.AdjointDefect.complexComponent","Breakdown.AdjointDefect.componentWeight","Breakdown.Space"],"written":"inner_components"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":71,"kind":"theorem","line":67,"module":"Breakdown.CellReduction.AdjointRemainderAzimuthalAlgebra","name":"Breakdown.AdjointDefect.AzimuthalParts.Internal.locallyIntegrable_clm","namespace":"Breakdown.AdjointDefect.AzimuthalParts.Internal","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.AdjointDefect.AzimuthalParts.Internal.weakGradient_comp"],"proof_uses":[],"protected":false,"short":"locallyIntegrable_clm","signature_end_line":69,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.Space"],"used_by":["Breakdown.AdjointDefect.AzimuthalParts.Internal.weakGradient_comp"],"uses":["Breakdown.Space"],"written":"locallyIntegrable_clm"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":95,"kind":"theorem","line":73,"module":"Breakdown.CellReduction.AdjointRemainderAzimuthalAlgebra","name":"Breakdown.AdjointDefect.AzimuthalParts.Internal.weakGradient_comp","namespace":"Breakdown.AdjointDefect.AzimuthalParts.Internal","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.AdjointDefect.AzimuthalParts.Internal.slice_bound"],"proof_uses":["Breakdown.AdjointDefect.AzimuthalParts.Internal.locallyIntegrable_clm","Breakdown.unitVector"],"protected":false,"short":"weakGradient_comp","signature_end_line":75,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.IsWeakGradient","Breakdown.Space"],"used_by":["Breakdown.AdjointDefect.AzimuthalParts.Internal.slice_bound"],"uses":["Breakdown.AdjointDefect.AzimuthalParts.Internal.locallyIntegrable_clm","Breakdown.IsWeakGradient","Breakdown.Space","Breakdown.unitVector"],"written":"weakGradient_comp"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":99,"kind":"theorem","line":97,"module":"Breakdown.CellReduction.AdjointRemainderAzimuthalAlgebra","name":"Breakdown.AdjointDefect.AzimuthalParts.Internal.ringPoint_rotation","namespace":"Breakdown.AdjointDefect.AzimuthalParts.Internal","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.AdjointDefect.AzimuthalParts.Internal.group_rotation"],"proof_uses":["Breakdown.unitVector"],"protected":false,"short":"ringPoint_rotation","signature_end_line":97,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.AdjointDefect.axisRotation","Breakdown.CellCert.Reduction.ringPoint","Breakdown.Space"],"used_by":["Breakdown.AdjointDefect.AzimuthalParts.Internal.group_rotation"],"uses":["Breakdown.AdjointDefect.axisRotation","Breakdown.CellCert.Reduction.ringPoint","Breakdown.Space","Breakdown.unitVector"],"written":"ringPoint_rotation"}],"imports":["Breakdown.CellReduction.AdjointRemainderAzimuthalParts","Breakdown.CellReduction.AdjointEntryDefs"],"module":"Breakdown.CellReduction.AdjointRemainderAzimuthalAlgebra","path":"Breakdown/CellReduction/AdjointRemainderAzimuthalAlgebra.lean","sha256":"c494ec7e077c486f0942005382681c156f0e35c6956cc97ab9e2787d2e9a38ff","source":"import Breakdown.CellReduction.AdjointRemainderAzimuthalParts\nimport Breakdown.CellReduction.AdjointEntryDefs\n\nopen scoped ENNReal ContDiff\nopen MeasureTheory Filter Topology\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace AdjointDefect\n\nnamespace AzimuthalParts\n\nnamespace Internal\n\nopen CellCert.Reduction\n\ndef componentMap (c : Fin 3) : Space →L[ℝ] Space :=\n  if c = 0 then\n    (EuclideanSpace.proj (0 : Fin 3) : Space →L[ℝ] ℝ).smulRight (unitVector 0)\n      + (EuclideanSpace.proj (1 : Fin 3) : Space →L[ℝ] ℝ).smulRight (unitVector 1)\n  else if c = 1 then\n    (EuclideanSpace.proj (0 : Fin 3) : Space →L[ℝ] ℝ).smulRight (unitVector 0)\n      - (EuclideanSpace.proj (1 : Fin 3) : Space →L[ℝ] ℝ).smulRight (unitVector 1)\n  else (EuclideanSpace.proj (2 : Fin 3) : Space →L[ℝ] ℝ).smulRight (unitVector 0)\n\ntheorem componentMap_coords (c : Fin 3) (x : Space) :\n    (componentMap c x) 0 = (if c = 2 then x 2 else x 0) ∧\n      (componentMap c x) 1 = (if c = 0 then x 1 else if c = 1 then -x 1 else 0) ∧\n      (componentMap c x) 2 = 0 := by\n  fin_cases c <;> simp [componentMap, unitVector]\n\ntheorem horizontal_componentMap (c : Fin 3) (W : Space → Space) :\n    horizontalPart (fun y => componentMap c (W y)) = fun y => complexComponent c (W y) := by\n  funext y\n  obtain ⟨h0, h1, -⟩ := componentMap_coords c (W y)\n  simp only [horizontalPart, h0, h1]\n  fin_cases c <;> simp [complexComponent] <;> ring\n\ntheorem componentMap_norm_sq (c : Fin 3) (x : Space) :\n    ‖componentMap c x‖ ^ 2 = ‖complexComponent c x‖ ^ 2 := by\n  obtain ⟨h0, h1, h2⟩ := componentMap_coords c x\n  rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_three, h0, h1, h2, Complex.sq_norm]\n  fin_cases c <;> simp [complexComponent, Complex.normSq_apply] <;> ring\n\ntheorem weighted_norm_sq (x : Space) :\n    ∑ c : Fin 3, componentWeight c * ‖componentMap c x‖ ^ 2 = ‖x‖ ^ 2 := by\n  rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_three, Fin.sum_univ_three]\n  simp only [componentMap_norm_sq]\n  simp [complexComponent, componentWeight, Complex.sq_norm, Complex.normSq_apply]\n  ring\n\ntheorem weighted_squareSum (M : Space →L[ℝ] Space) :\n    ∑ c : Fin 3, componentWeight c * matSq ((componentMap c).comp M) = matSq M := by\n  unfold matSq\n  simp only [ContinuousLinearMap.comp_apply, Finset.mul_sum]\n  rw [Finset.sum_comm]\n  exact Finset.sum_congr rfl fun i _ => weighted_norm_sq _\n\ntheorem inner_components (x r : Space) :\n    inner ℝ x r = ∑ c : Fin 3, componentWeight c *\n      (starRingEnd ℂ (complexComponent c x) * complexComponent c r).re := by\n  simp [PiLp.inner_apply, Fin.sum_univ_three, complexComponent, componentWeight, Complex.mul_re]\n  ring\n\ntheorem locallyIntegrable_clm {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]\n    [NormedAddCommGroup F] [NormedSpace ℝ F] (L : E →L[ℝ] F) {f : Space → E}\n    (hf : LocallyIntegrable f volume) : LocallyIntegrable (fun y => L (f y)) volume := by\n  rw [locallyIntegrable_iff] at hf ⊢\n  exact fun k hk => L.integrable_comp (hf k hk)\n\ntheorem weakGradient_comp (L : Space →L[ℝ] Space) {V : Space → Space}\n    {D : Space → (Space →L[ℝ] Space)} (h : IsWeakGradient V D) :\n    IsWeakGradient (fun y => L (V y)) (fun y => L.comp (D y)) := by\n  obtain ⟨hV, hD, hI⟩ := h\n  refine ⟨locallyIntegrable_clm L hV, locallyIntegrable_clm (ContinuousLinearMap.compL ℝ Space Space Space L) hD,\n    fun φ hφ i => ?_⟩\n  have hDi : LocallyIntegrable (fun y => D y (unitVector i)) volume :=\n    locallyIntegrable_clm (ContinuousLinearMap.apply ℝ Space (unitVector i)) hD\n  have i1 : Integrable (fun y => φ y • D y (unitVector i)) volume :=\n    hDi.integrable_smul_left_of_hasCompactSupport hφ.1.continuous hφ.2\n  have hdφ : Continuous (fun y => fderiv ℝ φ y (unitVector i)) :=\n    (hφ.1.continuous_fderiv (by simp)).clm_apply continuous_const\n  have hsφ : HasCompactSupport (fun y => fderiv ℝ φ y (unitVector i)) :=\n    (hφ.2.fderiv ℝ).comp_left (g := fun M : Space →L[ℝ] ℝ => M (unitVector i)) (by simp)\n  have i2 : Integrable (fun y => fderiv ℝ φ y (unitVector i) • V y) volume :=\n    hV.integrable_smul_left_of_hasCompactSupport hdφ hsφ\n  have e1 : (fun y => φ y • (L.comp (D y)) (unitVector i)) = fun y => L (φ y • D y (unitVector i)) := by\n    funext y\n    simp\n  have e2 : (fun y => fderiv ℝ φ y (unitVector i) • L (V y)) = fun y => L (fderiv ℝ φ y (unitVector i) • V y) := by\n    funext y\n    simp\n  rw [e1, e2, L.integral_comp_comm i1, L.integral_comp_comm i2, hI φ hφ i, map_neg]\n\ntheorem ringPoint_rotation (ρ θ z : ℝ) : axisRotation θ (ringPoint ρ 0 z) = ringPoint ρ θ z := by\n  ext i\n  fin_cases i <;> simp [axisRotation, ringPoint, unitVector] <;> ring\n\nend Internal\n\nend AzimuthalParts\n\nend AdjointDefect\n\nend Breakdown\n"}