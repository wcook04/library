ler.Paper.Lib.S5a.Tower.tower"],"used_by":["TorusEuler.Paper.Lib.S5a.Tower.Tom_leibniz","TorusEuler.Paper.Lib.S5a.Tower.Tw_continuousOn","TorusEuler.Paper.Lib.S5a.Tower.hSA","TorusEuler.Paper.Lib.S5a.Tower.hSF","TorusEuler.Paper.Lib.S5a.Tower.shift_mem_Esp"],"uses":["TorusEuler.Paper.Lib.S5a.Tower.Wd","TorusEuler.Paper.Lib.S5a.Tower.shift","TorusEuler.Paper.Lib.S5a.Tower.tower"],"written":"shift_mem"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":"Towers of solenoidal velocities `u_w` with `∫_0^T u_w = 0`.","end_line":87,"kind":"def","line":71,"module":"TorusEuler.Paper.Proofs.S5a.Library.Tower","name":"TorusEuler.Paper.Lib.S5a.Tower.Esp","namespace":"TorusEuler.Paper.Lib.S5a.Tower","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["TorusEuler.Paper.Lib.S5a.Tower.main_tower_bound"],"proof_uses":[],"protected":false,"short":"Esp","signature_end_line":71,"sorry":false,"statement_used_by":["TorusEuler.Paper.Lib.S5a.Tower.Esp_le_tower","TorusEuler.Paper.Lib.S5a.Tower.TkB","TorusEuler.Paper.Lib.S5a.Tower.TkB_val","TorusEuler.Paper.Lib.S5a.Tower.TomB","TorusEuler.Paper.Lib.S5a.Tower.TomB_val","TorusEuler.Paper.Lib.S5a.Tower.dE","TorusEuler.Paper.Lib.S5a.Tower.dE_val","TorusEuler.Paper.Lib.S5a.Tower.exists_velocityTower","TorusEuler.Paper.Lib.S5a.Tower.finiteNormE","TorusEuler.Paper.Lib.S5a.Tower.hSE","TorusEuler.Paper.Lib.S5a.Tower.leibnizK","TorusEuler.Paper.Lib.S5a.Tower.leibnizOm","TorusEuler.Paper.Lib.S5a.Tower.shift_mem_Esp","TorusEuler.Paper.Lib.S5a.Tower.tower_lifting","TorusEuler.Paper.Lib.S5a.Tower.zero_order"],"statement_uses":["TorusEuler.DistinctPairs","TorusEuler.HalfHolder","TorusEuler.HalfHolderData","TorusEuler.Paper.Lib.S5a.Tower.Wd","TorusEuler.Paper.Lib.S5a.Tower.tower","TorusEuler.Paper.Lib.S5a.Tower.towerSolenoidalNormedGroup","TorusEuler.Paper.Lib.S5a.Tower.towerSolenoidalNormedSpace","TorusEuler.Vec3","TorusEuler.endpointHalfHolderSolenoidal","TorusEuler.endpointPrimit