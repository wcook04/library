query","QuarticQuery.QueryTree.toDecisionTree"],"uses_modules":{"QuarticQuery.QueryTree":"QuarticQuery.Statement","QuarticQuery.QueryTree.leaf":"QuarticQuery.Statement","QuarticQuery.QueryTree.query":"QuarticQuery.Statement"},"written":"depth_toDecisionTree"},{"dependency_source":"lean_report","doc":"Ledger: def-D. `D` on a total function is complexitylib's decision tree\ncomplexity.","end_line":80,"kind":"theorem","line":67,"module":"QuarticQuery.Bridge.DecisionTree","name":"QuarticQuery.D_totalise_eq_complexity","namespace":"QuarticQuery","noncomputable":false,"private":false,"proof_used_by":["QuarticQuery.D_le_of_QLe","QuarticQuery.Paper.appendixA_lemmaA5"],"proof_uses":["QuarticQuery.BitInput","QuarticQuery.DLe","QuarticQuery.DLe_D","QuarticQuery.D_le_of_DLe","QuarticQuery.QueryTree","QuarticQuery.QueryTree.depth","QuarticQuery.QueryTree.depth_toDecisionTree","QuarticQuery.QueryTree.eval","QuarticQuery.QueryTree.eval_toDecisionTree","QuarticQuery.QueryTree.ofDecisionTree","QuarticQuery.QueryTree.toDecisionTree","QuarticQuery.QueryTree.toDecisionTree_ofDecisionTree"],"protected":false,"short":"D_totalise_eq_complexity","signature_end_line":68,"statement_used_by":[],"statement_uses":["QuarticQuery.D","QuarticQuery.TotalBool","QuarticQuery.totalise"],"used_by":["QuarticQuery.D_le_of_QLe","QuarticQuery.Paper.appendixA_lemmaA5"],"uses":["QuarticQuery.BitInput","QuarticQuery.D","QuarticQuery.DLe","QuarticQuery.DLe_D","QuarticQuery.D_le_of_DLe","QuarticQuery.QueryTree","QuarticQuery.QueryTree.depth","QuarticQuery.QueryTree.depth_toDecisionTree","QuarticQuery.QueryTree.eval","QuarticQuery.QueryTree.eval_toDecisionTree","QuarticQuery.QueryTree.ofDecisionTree","QuarticQuery.QueryTree.toDecisionTree","QuarticQuery.QueryTree.toDecisionTree_ofDecisionTree","QuarticQuery.TotalBool","QuarticQuery.totalise"],"uses_modules":{"QuarticQuery.D":"QuarticQuery.Statement","QuarticQuery.TotalBool":"QuarticQuery.Statement","QuarticQuery.totalise":"QuarticQuery.Statement"},"written":"D_totalise_eq_complexity"}],"imports":["QuarticQuery.Model.Quantum","Complexity.Computability.DecisionTree.Basic"],"module":"QuarticQuery.Bridge.DecisionTree","path":"QuarticQuery/Bridge/DecisionTree.lean","sha256":"f0dc14884f30cb5238b4e71a4358e43a244a45a38f655323a34b5e83af7ed13e","source":"module\n\npublic import QuarticQuery.Model.Quantum\npublic import Complexity.Computability.DecisionTree.Basic\n\n/-!\n# Decision trees: our `QueryTree` and complexitylib's `DecisionTree`\n\nThe two inductive types are the same tree with renamed constructors. The maps\nbelow are mutually inverse and preserve evaluation and depth, so `D` of a total\nfunction is `Cslib.DecisionTree.complexity`, in both directions.\n-/\n\npublic section\n\nnamespace QuarticQuery\n\nopen Cslib\n\nvariable {ι : Type}\n\nnamespace QueryTree\n\n/-- Ledger: def-D. Rename constructors. -/\ndef toDecisionTree : QueryTree ι → DecisionTree ι Bool\n  | .leaf b => .leaf b\n  | .query i l r => .node i l.toDecisionTree r.toDecisionTree\n\n/-- Ledger: def-D. Rename constructors back. -/\ndef ofDecisionTree : DecisionTree ι Bool → QueryTree ι\n  | .leaf b => .leaf b\n  | .node i l r => .query i (ofDecisionTree l) (ofDecisionTree r)\n\ntheorem ofDecisionTree_toDecisionTree (t : QueryTree ι) :\n    ofDecisionTree t.toDecisionTree = t := by\n  induction t with\n  | leaf b => rfl\n  | query i l r ihl ihr => simp only [toDecisionTree, ofDecisionTree, ihl, ihr]\n\ntheorem toDecisionTree_ofDecisionTree (t : DecisionTree ι Bool) :\n    (ofDecisionTree t).toDecisionTree = t := by\n  induction t with\n  | leaf b => rfl\n  | node i l r ihl ihr => simp only [toDecisionTree, ofDecisionTree, ihl, ihr]\n\n/-- Ledger: def-D. The translation keeps the output on every input. -/\ntheorem eval_toDecisionTree (t : QueryTree ι) (x : BitInput ι) :\n    t.toDecisionTree.eval x = t.eval x := by\n  induction t with\n  | leaf b => rfl\n  | query i l r ihl ihr =>\n    rw [toDecisionTree, DecisionTree.eval_node, ihl, ihr, eval_query]\n    cases x i <;> rfl\n\n/-- Ledger: def-D. The translation keeps the depth. -/\ntheorem depth_toDecisionTree (t : QueryTree ι) : t.toDecisionTree.depth = t.depth := by\n  induction t with\n  | leaf b => rfl\n  | query i l r ihl ihr =>\n    rw [toDecisionTree, DecisionTree.depth_node, ihl, ihr, depth_query]\n    omega\n\nend QueryTree\n\n/-- Ledger: def-D. `D` on a total function is complexitylib's decision tree\ncomplexity. -/\ntheorem D_totalise_eq_complexity [Fintype ι] (f : TotalBool ι) :\n    D (totalise f) = DecisionTree.complexity f := by\n  apply le_antisymm\n  · obtain ⟨t, ht, hd⟩ := DecisionTree.exists_computes_depth_eq_complexity f\n    refine D_le_of_DLe ⟨QueryTree.ofDecisionTree t, ?_, fun x b hx => ?_⟩\n    · rw [← QueryTree.depth_toDecisionTree, QueryTree.toDecisionTree_ofDecisionTree, hd]\n    · rw [← QueryTree.eval_toDecisionTree, QueryTree.toDecisionTree_ofDecisionTree, ht x]\n      exact Option.some.inj hx\n  · obtain ⟨T, hT, hc⟩ := DLe_D (totalise f)\n    have hcomp : T.toDecisionTree.Computes f := fun x => by\n      rw [QueryTree.eval_toDecisionTree]\n      exact hc x (f x) rfl\n    exact (DecisionTree.complexity_le_depth hcomp).trans\n      ((QueryTree.depth_toDecisionTree T).trans_le hT)\n\nend QuarticQuery\n"}