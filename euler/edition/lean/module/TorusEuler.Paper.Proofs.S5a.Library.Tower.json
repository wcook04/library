rusEuler.Vec3","TorusEuler.endpointHalfHolderSolenoidal","TorusEuler.halfHolderSubspace"],"used_by":["TorusEuler.Paper.Lib.S5a.Tower.finiteNormE","TorusEuler.Paper.Lib.S5a.Tower.tower_lifting"],"uses":["TorusEuler.DistinctPairs","TorusEuler.HalfHolder","TorusEuler.HalfHolderData","TorusEuler.Paper.Lib.S5a.Tower.Esp","TorusEuler.Paper.Lib.S5a.Tower.Wd","TorusEuler.Paper.Lib.S5a.Tower.tower","TorusEuler.Paper.Lib.S5a.Tower.towerSolenoidalNormedGroup","TorusEuler.Paper.Lib.S5a.Tower.towerSolenoidalNormedSpace","TorusEuler.Vec3","TorusEuler.endpointHalfHolderSolenoidal","TorusEuler.endpointPrimitive","TorusEuler.halfHolderSubspace"],"written":"Esp_le_tower"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":"The zero-order seminorm `sup_{t ∈ [0,T]} ‖u [] t‖` on a submodule of towers.","end_line":130,"kind":"def","line":106,"module":"TorusEuler.Paper.Proofs.S5a.Library.Tower","name":"TorusEuler.Paper.Lib.S5a.Tower.zeroSemi","namespace":"TorusEuler.Paper.Lib.S5a.Tower","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["TorusEuler.Paper.Lib.S5a.Tower.tower_lifting"],"proof_uses":[],"protected":false,"short":"zeroSemi","signature_end_line":106,"sorry":false,"statement_used_by":["TorusEuler.Paper.Lib.S5a.Tower.exactNormA","TorusEuler.Paper.Lib.S5a.Tower.exactNorm_eq","TorusEuler.Paper.Lib.S5a.Tower.finiteNormE","TorusEuler.Paper.Lib.S5a.Tower.finiteNormF","TorusEuler.Paper.Lib.S5a.Tower.finiteNorm_eq","TorusEuler.Paper.Lib.S5a.Tower.word_norm","TorusEuler.Paper.Lib.S5a.Tower.zeroSemi_apply"],"statement_uses":["TorusEuler.Paper.Lib.S5a.Tower.Wd","TorusEuler.Paper.Lib.S5a.Tower.tower","TorusEuler.endpointClosedTimeNorm"],"used_by":["TorusEuler.Paper.Lib.S5a.Tower.exactNormA","TorusEuler.Paper.Lib.S5a.Tower.exactNorm_eq","TorusEuler.Paper.Lib.S5a.Tower.finiteNormE","TorusEuler.Paper.Lib.S5a.Tower.finiteNormF","TorusEuler.Paper.Lib.S5a.Tower.finiteNorm_eq","TorusEuler.Paper.Lib.S5a.Tower.tower_lifting","TorusEuler.Paper.Lib.S5a.Tower.word_norm","TorusEuler.Paper.Lib.S5a.Tower.zeroSemi_apply"],"uses":["TorusEuler.Paper.Lib.S5a.Tower.Wd","TorusEuler.Paper.Lib.S5a.Tower.tower","TorusEuler.endpointClosedTimeNorm"],"written":"zeroSemi"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":"Auxiliary declaration of the tower argument for (5.14) (`sections/06d_mean_estimates.tex:46-58`): `zeroSemi_apply`.","end_line":134,"kind":"theorem","line":133,"module":"TorusEuler.Paper.Proofs.S5a.Library.Tower","name":"TorusEuler.Paper.Lib.S5a.Tower.zeroSemi_apply","namespace":"TorusEuler.Paper.Lib.S5a.Tower","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["TorusEuler.Paper.Lib.S5a.Tower.word_norm"],"proof_uses":[],"protected":false,"short":"zeroSemi_apply","signature_end_line":134,"sorry":false,"statement_used_by":[],"statement_uses":["TorusEuler.Paper.Lib.S5a.Tower.Wd","TorusEuler.Paper.Lib.S5a.Tower.tower","TorusEuler.Paper.Lib.S5a.Tower.zeroSemi","TorusEuler.endpointClosedTimeNorm"],"used_by":["TorusEuler.Paper.Lib.S5a.Tower.word_norm"],"uses":["TorusEuler.Paper.Lib.S5a.Tower.Wd","TorusEuler.Paper.Lib.S5a.Tower.tower","TorusEuler.Paper.Lib.S5a.Tower.zeroSemi","TorusEuler.endpointClosedTimeNorm"],"written":"zeroSemi_apply"}],"imports":["TorusEuler.Paper.Proofs.S5a.Library.MeanUnique","TorusEuler.PaperAppendixDLifting","TorusEuler.EndpointPhysicalJetEstimates"],"module":"TorusEuler.Paper.Proofs.S5a.Library.Tower","path":"TorusEuler/Paper/Proofs/S5a/Library/Tower.lean","sha256":"a44c91b44bc674a71c42fe35405529fe713ef270993e47bf1eeffb751d7db934","source":"import TorusEuler.Paper.Proofs.S5a.Library.MeanUnique\nimport TorusEuler.PaperAppendixDLifting\nimport TorusEuler.EndpointPhysicalJetEstimates\n\n/-!\n# S5a library: spaces of derivative towers for Lemma D.3 applied to the mean system (4.9)\n\nThe abstract Lemma D.3 (`Statement.lemma_D_3`) is applied (row Text eq_5_14,\n`sections/06d_mean_estimates.tex:34-58`) to the integrated mean system (4.9) in the space of\n*derivative towers*: a tower is a family `u : List (Fin 3) → ℝ → X` of curves indexed by words of label\nderivatives (`u (i :: w)` stands for `∂_i u w`), invariant under permutations of the word, and\ncontinuous in time. The spaces `E` (towers of solenoidal velocities with `∫_0^T u_w = 0`), `F`\n(towers of forcings in `C^{0,1/2}`), `A` (towers of coefficients in `C^{0,1/2}(ℝ³;𝓛(ℝ³))`) carry the\nderivations `ℓ ∂_i` = `ℓ • shift i`, and the zero-order seminorms `p u = sup_{t ∈ [0,T]} ‖u [] t‖`.\nLeibniz' rule for the coefficient action is then *definitional*: `Tw (i :: w) a u = Tw w (∂_i a) u +\nTw w a (∂_i u)`.\n-/\n\nopen Set\nopen scoped ContDiff\n\nnamespace TorusEuler.Paper.Lib.S5a.Tower\n\nnoncomputable section\n\nlocal notation \"C½\" => HalfHolder (UnitAddTorus (Fin 3)) Vec3\nlocal notation \"K½\" => HalfHolder (UnitAddTorus (Fin 3)) (Vec3 →L[ℝ] Vec3)\nlocal notation \"S\" => endpointHalfHolderSolenoidal\n\nlocal instance towerSolenoidalNormedGroup : NormedAddCommGroup S := inferInstance\nlocal instance towerSolenoidalNormedSpace : NormedSpace ℝ S := inferInstance\n\n/-- Words of label derivatives. -/\nabbrev Wd := List (Fin 3)\n\nsection Spaces\n\nvariable (T : ℝ) (X : Type*) [NormedAddCommGroup X] [NormedSpace ℝ X]\n\n/-- Permutation-invariant towers, continuous in time on `[0,T]`. -/\ndef tower : Submodule ℝ (Wd → ℝ → X) where\n  carrier := {u | (∀ p q : Wd, p.Perm q → u p = u q) ∧ ∀ w, ContinuousOn (u w) (Icc 0 T)}\n  add_mem' := by\n    rintro u v ⟨hu, hu'⟩ ⟨hv, hv'⟩\n    exact ⟨fun p q h => by simp only [Pi.add_apply, hu p q h, hv p q h],\n      fun w => (hu' w).add (hv' w)⟩\n  zero_mem' := ⟨fun _ _ _ => rfl, fun _ => continuousOn_const⟩\n  smul_mem' := by\n    rintro c u ⟨hu, hu'⟩\n    exact ⟨fun p q h => by simp only [Pi.smul_apply, hu p q h], fun w => (hu' w).const_smul c⟩\n\n/-- The derivation `∂_i` on towers. -/\ndef shift (i : Fin 3) : (Wd → ℝ → X) →ₗ[ℝ] (Wd → ℝ → X) where\n  toFun u := fun w => u (i :: w)\n  map_add' _ _ := rfl\n  map_smul' _ _ := rfl\n\nvariable {T X}\n\n/-- Auxiliary declaration of the tower argument for (5.14) (`sections/06d_mean_estimates.tex:46-58`): `shift_mem`. -/\ntheorem shift_mem (i : Fin 3) {u : Wd → ℝ → X} (hu : u ∈ tower T X) : shift X i u ∈ tower T X :=\n  ⟨fun _ _ h => hu.1 _ _ (h.cons i), fun _ => hu.2 _⟩\n\nend Spaces\n\nsection EAndF\n\nvariable (T : ℝ) (hT : 0 ≤ T)\n\n/-- Towers of solenoidal velocities `u_w` with `∫_0^T u_w = 0`. -/\ndef Esp : Submodule ℝ (Wd → ℝ → S) where\n  carrier := {u | u ∈ tower T S ∧ ∀ w, endpointPrimitive (u w) T = 0}\n  add_mem' := by\n    rintro u v ⟨hu, hu'⟩ ⟨hv, hv'⟩\n    refine ⟨add_mem hu hv, fun w => ?_⟩\n    have h1 : IntervalIntegrable (u w) MeasureTheory.volume 0 T :=\n      (hu.2 w).intervalIntegrable_of_Icc hT\n    have h2 : IntervalIntegrable (v w) MeasureTheory.volume 0 T :=\n      (hv.2 w).intervalIntegrable_of_Icc hT\n    simp only [endpointPrimitive, Pi.add_apply] at hu' hv' ⊢\n    rw [intervalIntegral.integral_add h1 h2, hu' w, hv' w, add_zero]\n  zero_mem' := ⟨zero_mem _, fun _ => by simp [endpointPrimitive]⟩\n  smul_mem' := by\n    rintro c u ⟨hu, hu'⟩\n    refine ⟨Submodule.smul_mem _ c hu, fun w => ?_⟩\n    simp only [endpointPrimitive, Pi.smul_apply] at hu' ⊢\n    rw [intervalIntegral.integral_smul, hu' w, smul_zero]\n\nvariable {T}\n\n/-- Auxiliary declaration of the tower argument for (5.14) (`sections/06d_mean_estimates.tex:46-58`): `shift_mem_Esp`. -/\ntheorem shift_mem_Esp (i : Fin 3) {u : Wd → ℝ → S} (hu : u ∈ Esp T hT) :\n    shift S i u ∈ Esp T hT :=\n  ⟨shift_mem i hu.1, fun _ => hu.2 _⟩\n\n/-- Auxiliary declaration of the tower argument for (5.14) (`sections/06d_mean_estimates.tex:46-58`): `Esp_le_tower`. -/\ntheorem Esp_le_tower : Esp T hT ≤ tower T S := fun _ hu => hu.1\n\nend EAndF\n\nsection Seminorms\n\nvariable {T : ℝ} (hT : 0 ≤ T) {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]\n\n/-- The zero-order seminorm `sup_{t ∈ [0,T]} ‖u [] t‖` on a submodule of towers. -/\ndef zeroSemi (P : Submodule ℝ (Wd → ℝ → X)) (hP : P ≤ tower T X) : Seminorm ℝ P :=\n  Seminorm.ofSMulLE (fun u => endpointClosedTimeNorm T (u.1 []))\n    (by\n      change endpointClosedTimeNorm T (fun _ : ℝ => (0 : X)) = 0\n      unfold endpointClosedTimeNorm\n      have h := (Set.nonempty_Icc.mpr hT).image_const (0 : ℝ)\n      simp only [norm_zero]\n      rw [h, csSup_singleton])\n    (fun u v => by\n      apply endpointClosedTimeNorm_le hT\n      intro t ht\n      have hu := (hP u.2).2 []\n      have hv := (hP v.2).2 []\n      calc ‖(u + v).1 [] t‖ = ‖u.1 [] t + v.1 [] t‖ := rfl\n        _ ≤ ‖u.1 [] t‖ + ‖v.1 [] t‖ := norm_add_le _ _\n        _ ≤ _ := add_le_add (norm_le_endpointClosedTimeNorm hu ht)\n          (norm_le_endpointClosedTimeNorm hv ht))\n    (fun c u => by\n      apply endpointClosedTimeNorm_le hT\n      intro t ht\n      have hu := (hP u.2).2 []\n      calc ‖(c • u).1 [] t‖ = ‖c‖ * ‖u.1 [] t‖ := by\n            change ‖c • u.1 [] t‖ = _\n            rw [norm_smul]\n        _ ≤ _ := mul_le_mul_of_nonneg_left (norm_le_endpointClosedTimeNorm hu ht) (norm_nonneg c))\n\n/-- Auxiliary declaration of the tower argument for (5.14) (`sections/06d_mean_estimates.tex:46-58`): `zeroSemi_apply`. -/\ntheorem zeroSemi_apply (P : Submodule ℝ (Wd → ℝ → X)) (hP : P ≤ tower T X) (u : P) :\n    zeroSemi hT P hP u = endpointClosedTimeNorm T (u.1 []) := rfl\n\nend Seminorms\n\nend\n\nend TorusEuler.Paper.Lib.S5a.Tower\n"}