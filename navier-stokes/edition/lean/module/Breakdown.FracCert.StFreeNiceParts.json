ses":[],"protected":false,"short":"ProfileSymbolSixStatement","signature_end_line":49,"sorry":false,"statement_used_by":["Breakdown.SteadyCert.ChainInternal.profileSymbolSix_holds","Breakdown.SteadyCert.freeExistsNice_of","Breakdown.SteadyCert.profileSymbolRealize_of","Breakdown.SteadyCert.profileSymbolSix"],"statement_uses":["Breakdown.Freq.CSpace","Breakdown.Freq.niceField","Breakdown.Space","Breakdown.SteadyCert.IsProfileSymbol"],"used_by":["Breakdown.SteadyCert.ChainInternal.profileSymbolSix_holds","Breakdown.SteadyCert.freeExistsNice_of","Breakdown.SteadyCert.profileSymbolRealize_of","Breakdown.SteadyCert.profileSymbolSix"],"uses":["Breakdown.Freq.CSpace","Breakdown.Freq.niceField","Breakdown.Space","Breakdown.SteadyCert.IsProfileSymbol"],"written":"ProfileSymbolSixStatement"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":57,"kind":"def","line":53,"module":"Breakdown.FracCert.StFreeNiceParts","name":"Breakdown.SteadyCert.ProfileSymbolEnergyStatement","namespace":"Breakdown.SteadyCert","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"ProfileSymbolEnergyStatement","signature_end_line":53,"sorry":false,"statement_used_by":["Breakdown.SteadyCert.profileSymbolEnergy","Breakdown.SteadyCert.profileSymbolRealize_of"],"statement_uses":["Breakdown.Freq.CSpace","Breakdown.Freq.niceField","Breakdown.Space","Breakdown.SteadyCert.IsProfileSymbol","Breakdown.SteadyCert.entrySq","Breakdown.unitVector"],"used_by":["Breakdown.SteadyCert.profileSymbolEnergy","Breakdown.SteadyCert.profileSymbolRealize_of"],"uses":["Breakdown.Freq.CSpace","Breakdown.Freq.niceField","Breakdown.Space","Breakdown.SteadyCert.IsProfileSymbol","Breakdown.SteadyCert.entrySq","Breakdown.unitVector"],"written":"ProfileSymbolEnergyStatement"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":61,"kind":"def","line":59,"module":"Breakdown.FracCert.StFreeNiceParts","name":"Breakdown.SteadyCert.ProfileSymbolPowerStatement","namespace":"Breakdown.SteadyCert","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"ProfileSymbolPowerStatement","signature_end_line":59,"sorry":false,"statement_used_by":["Breakdown.SteadyCert.profileSymbolPower","Breakdown.SteadyCert.profileSymbolRealize_of"],"statement_uses":["Breakdown.Freq.CSpace","Breakdown.Freq.niceField","Breakdown.Space","Breakdown.SteadyCert.IsProfileSymbol","Breakdown.SteadyCert.IsWeakFractionalPower","Breakdown.SteadyCert.freqPow"],"used_by":["Breakdown.SteadyCert.profileSymbolPower","Breakdown.SteadyCert.profileSymbolRealize_of"],"uses":["Breakdown.Freq.CSpace","Breakdown.Freq.niceField","Breakdown.Space","Breakdown.SteadyCert.IsProfileSymbol","Breakdown.SteadyCert.IsWeakFractionalPower","Breakdown.SteadyCert.freqPow"],"written":"ProfileSymbolPowerStatement"}],"imports":["Breakdown.FracCert.StFreeNice"],"module":"Breakdown.FracCert.StFreeNiceParts","path":"Breakdown/FracCert/StFreeNiceParts.lean","sha256":"accbbafbf0e606d22c12332cf0844fb40be2da9004d6ae4b89bcf12ce0841ecf","source":"import Breakdown.FracCert.StFreeNice\n\nopen scoped ContDiff ENNReal\nopen MeasureTheory Real\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace SteadyCert\n\ndef axialTurnC (z : Freq.CSpace) : Freq.CSpace :=\n  EuclideanSpace.single 0 (-(z 1)) + EuclideanSpace.single 1 (z 0)\n\ndef IsProfileSymbol (α : ℝ) (w : Space → Freq.CSpace) : Prop :=\n  ContDiffOn ℝ ∞ w {ξ | ξ ≠ 0} ∧ (∃ R : ℝ, ∀ ξ : Space, R < ‖ξ‖ → w ξ = 0) ∧\n    (∀ j : ℕ, ∃ C : ℝ, ∀ ξ : Space, ξ ≠ 0 → ‖iteratedFDeriv ℝ j w ξ‖ ≤ C * ‖ξ‖ ^ (2 * α - 4 - (j : ℝ))) ∧\n    (∀ ξ, w (-ξ) = Freq.conjVec (w ξ)) ∧ ∀ ξ, ∑ i : Fin 3, ((ξ i : ℝ) : ℂ) * w ξ i = 0\n\ndef profileSymbolLhs (α a : ℝ) (w : Space → Freq.CSpace) (ξ : Space) : Freq.CSpace :=\n  (1 - 2 / α) • w ξ - (1 / (2 * α)) • fderiv ℝ w ξ ξ\n    + a • (fderiv ℝ w ξ (axialTurn ξ) - axialTurnC (w ξ)) + freqPow (2 * α) ξ • w ξ\n\ndef FreeSymbolExistsStatement : Prop :=\n  ∀ α : ℝ, 1 < α → α < 5 / 4 → ∀ (a : ℝ) (m : ℕ) (s : Space → Freq.CSpace), Freq.IsNiceSymbol s →\n    IsClassField m (Freq.niceField s) →\n    ∃ w : Space → Freq.CSpace, IsProfileSymbol α w ∧ IsClassField m (Freq.niceField w) ∧\n      ∀ ξ : Space, ξ ≠ 0 → profileSymbolLhs α a w ξ = s ξ\n\ndef ProfileSymbolRealizeStatement : Prop :=\n  ∀ α : ℝ, 1 < α → α < 5 / 4 → ∀ (m : ℕ) (w : Space → Freq.CSpace), IsProfileSymbol α w →\n    IsClassField m (Freq.niceField w) →\n    IsSecondOrderField m (Freq.niceField w) (fun y => fderiv ℝ (Freq.niceField w) y)\n        (fun y => fderiv ℝ (fun z => fderiv ℝ (Freq.niceField w) z) y) ∧\n      IsWeakFractionalPower α (Freq.niceField w) (Freq.niceField (fun ξ => freqPow (2 * α) ξ • w ξ))\n\ndef ProfileSymbolEquationStatement : Prop :=\n  ∀ α : ℝ, 1 < α → α < 5 / 4 → ∀ (a : ℝ) (s w : Space → Freq.CSpace), Freq.IsNiceSymbol s →\n    IsProfileSymbol α w → (∀ ξ : Space, ξ ≠ 0 → profileSymbolLhs α a w ξ = s ξ) →\n    MemLp (driftField α a (Freq.niceField w) (fun y => fderiv ℝ (Freq.niceField w) y)) 2 volume ∧\n      ∀ᵐ y ∂volume, driftField α a (Freq.niceField w) (fun y => fderiv ℝ (Freq.niceField w) y) y\n        + Freq.niceField (fun ξ => freqPow (2 * α) ξ • w ξ) y = Freq.niceField s y\n\ndef ProfileSymbolSmoothStatement : Prop :=\n  ∀ α : ℝ, 1 < α → α < 5 / 4 → ∀ w : Space → Freq.CSpace, IsProfileSymbol α w →\n    ContDiff ℝ 2 (Freq.niceField w) ∧\n      ∀ y, ∑ i : Fin 3, inner ℝ (fderiv ℝ (Freq.niceField w) y (unitVector i)) (unitVector i) = 0\n\ndef ProfileSymbolSixStatement : Prop :=\n  ∀ α : ℝ, 1 < α → α < 5 / 4 → ∀ w : Space → Freq.CSpace, IsProfileSymbol α w →\n    MemLp (Freq.niceField w) 6 volume\n\ndef ProfileSymbolEnergyStatement : Prop :=\n  ∀ α : ℝ, 1 < α → α < 5 / 4 → ∀ w : Space → Freq.CSpace, IsProfileSymbol α w →\n    Integrable (fun y => entrySq (fderiv ℝ (Freq.niceField w) y)) ∧\n      Integrable (fun y => ∑ i : Fin 3, ∑ j : Fin 3,\n        ‖fderiv ℝ (fun z => fderiv ℝ (Freq.niceField w) z) y (unitVector i) (unitVector j)‖ ^ 2)\n\ndef ProfileSymbolPowerStatement : Prop :=\n  ∀ α : ℝ, 1 < α → α < 5 / 4 → ∀ w : Space → Freq.CSpace, IsProfileSymbol α w →\n    IsWeakFractionalPower α (Freq.niceField w) (Freq.niceField (fun ξ => freqPow (2 * α) ξ • w ξ))\n\nend SteadyCert\n\nend Breakdown\n"}