"short":"indicatorInput","signature_end_line":62,"used_by":["QuarticQuery.Independent.Degree.coefficients_ext","QuarticQuery.Independent.Degree.empty_coefficient_is_value_at_zero","QuarticQuery.Independent.Degree.evaluate_indicator","QuarticQuery.Independent.Degree.squarefreeMonomial_indicator"],"uses":[],"written":"indicatorInput"},{"dependency_source":"source_text","doc":null,"end_line":66,"kind":"theorem","line":64,"module":"QuarticCorpus.Independent.Degree.Spec","name":"QuarticQuery.Independent.Degree.squarefreeMonomial_empty","namespace":"QuarticQuery.Independent.Degree","noncomputable":false,"private":false,"protected":false,"short":"squarefreeMonomial_empty","signature_end_line":65,"used_by":["QuarticQuery.Independent.Degree.constant_one_expectation"],"uses":["QuarticQuery.Independent.Degree.squarefreeMonomial"],"written":"squarefreeMonomial_empty"},{"dependency_source":"source_text","doc":null,"end_line":72,"kind":"theorem","line":68,"module":"QuarticCorpus.Independent.Degree.Spec","name":"QuarticQuery.Independent.Degree.squarefreeMonomial_indicator","namespace":"QuarticQuery.Independent.Degree","noncomputable":false,"private":false,"protected":false,"short":"squarefreeMonomial_indicator","signature_end_line":69,"used_by":["QuarticQuery.Independent.Degree.evaluate_indicator"],"uses":["QuarticQuery.Independent.Degree.bit","QuarticQuery.Independent.Degree.indicatorInput","QuarticQuery.Independent.Degree.squarefreeMonomial"],"written":"squarefreeMonomial_indicator"},{"dependency_source":"source_text","doc":null,"end_line":81,"kind":"theorem","line":74,"module":"QuarticCorpus.Independent.Degree.Spec","name":"QuarticQuery.Independent.Degree.evaluate_indicator","namespace":"QuarticQuery.Independent.Degree","noncomputable":false,"private":false,"protected":false,"short":"evaluate_indicator","signature_end_line":75,"used_by":["QuarticQuery.Independent.Degree.coefficients_ext","QuarticQuery.Independent.Degree.empty_coefficient_is_value_at_zero"],"uses":["QuarticQuery.Independent.Degree.evaluate","QuarticQuery.Independent.Degree.indicatorInput","QuarticQuery.Independent.Degree.squarefreeMonomial_indicator"],"written":"evaluate_indicator"},{"dependency_source":"source_text","doc":"Distinct squarefree coefficient arrays cannot agree on every Boolean input.","end_line":115,"kind":"theorem","line":84,"module":"QuarticCorpus.Independent.Degree.Spec","name":"QuarticQuery.Independent.Degree.coefficients_ext","namespace":"QuarticQuery.Independent.Degree","noncomputable":false,"private":false,"protected":false,"short":"coefficients_ext","signature_end_line":85,"used_by":["QuarticQuery.Independent.Degree.represents_unique"],"uses":["QuarticQuery.Independent.Degree.evaluate","QuarticQuery.Independent.Degree.evaluate_indicator","QuarticQuery.Independent.Degree.indicatorInput"],"written":"coefficients_ext"},{"dependency_source":"source_text","doc":null,"end_line":119,"kind":"theorem","line":117,"module":"QuarticCorpus.Independent.Degree.Spec","name":"QuarticQuery.Independent.Degree.represents_unique","namespace":"QuarticQuery.Independent.Degree","noncomputable":false,"private":false,"protected":false,"short":"represents_unique","signature_end_line":118,"used_by":["QuarticQuery.Independent.Degree.canonical_totalDegree_le_iff","QuarticQuery.Independent.Degree.exists_unique_coefficients"],"uses":["QuarticQuery.Independent.Degree.Represents","QuarticQuery.Independent.Degree.coefficients_ext"],"written":"represents_unique"},{"dependency_source":"source_text","doc":null,"end_line":122,"kind":"theorem","line":121,"module":"QuarticCorpus.Independent.Degree.Spec","name":"QuarticQuery.Independent.Degree.evaluate_zero","namespace":"QuarticQuery.Independent.Degree","noncomputable":false,"private":false,"protected":false,"short":"evaluate_zero","signature_end_line":121,"used_by":["QuarticQuery.Independent.Degree.exists_coefficients_of_lowDegree"],"uses":["QuarticQuery.Independent.Degree.evaluate"],"written":"evaluate_zero"},{"dependency_source":"source_text","doc":null,"end_line":126,"kind":"theorem","line":124,"module":"QuarticCorpus.Independent.Degree.Spec","name":"QuarticQuery.Independent.Degree.evaluate_add","namespace":"QuarticQuery.Independent.Degree","noncomputable":false,"private":false,"protected":false,"short":"evaluate_add","signature_end_line":125,"used_by":["QuarticQuery.Independent.Degree.exists_coefficients_of_lowDegree","QuarticQuery.Independent.Degree.two_bit_xor_expectation"],"uses":["QuarticQuery.Independent.Degree.evaluate"],"written":"evaluate_add"},{"dependency_source":"source_text","doc":null,"end_line":130,"kind":"theorem","line":128,"module":"QuarticCorpus.Independent.Degree.Spec","name":"QuarticQuery.Independent.Degree.evaluate_smul","namespace":"QuarticQuery.Independent.Degree","noncomputable":false,"private":false,"protected":false,"short":"evaluate_smul","signature_end_line":129,"used_by":["QuarticQuery.Independent.Degree.exists_coefficients_of_lowDegree","QuarticQuery.Independent.Degree.two_bit_xor_expectation"],"uses":["QuarticQuery.Independent.Degree.evaluate"],"written":"evaluate_smul"},{"dependency_source":"source_text","doc":null,"end_line":135,"kind":"theorem","line":132,"module":"QuarticCorpus.Independent.Degree.Spec","name":"QuarticQuery.Independent.Degree.evaluate_single","namespace":"QuarticQuery.Independent.Degree","noncomputable":false,"private":false,"protected":false,"short":"evaluate_single","signature_end_line":133,"used_by":["QuarticQuery.Independent.Degree.constant_one_expectation","QuarticQuery.Independent.Degree.exists_coefficients_of_lowDegree","QuarticQuery.Independent.Degree.projection_expectation","QuarticQuery.Independent.Degree.two_bit_xor_expectation"],"uses":["QuarticQuery.Independent.Degree.evaluate","QuarticQuery.Independent.Degree.squarefreeMonomial"],"written":"evaluate_single"}],"imports":["Mathlib"],"module":"QuarticCorpus.Independent.Degree.Spec","path":"QuarticCorpus/Independent/Degree/Spec.lean","sha256":"046706106bf4592e8b51ab3604e2665f92999998b825ba481357a519580fdce5","source":"module\n\npublic import Mathlib\n\n/-!\n# Independent squarefree polynomial semantics on the Boolean cube\n\nThis specification does not import QuarticQuery or complexitylib. A coefficient\narray indexed by finite coordinate sets denotes the literal squarefree polynomial\n`∑ S, a S * ∏ i ∈ S, x i`, with bits interpreted as real zero and one.\nIn particular, the empty monomial is one. These meanings are not aliases of\n`BitString.monomial`, `lowDegree`, `totalDegree`, or a Fourier definition.\n\n`coefficients_ext` proves uniqueness by evaluating at the indicator inputs of\nall subsets and inducting on subset size. Its proof does not use polynomial\nuniqueness from the audited development.\n-/\n\n@[expose] public section\n\nnamespace QuarticQuery.Independent.Degree\n\nopen scoped BigOperators\nopen Finset\n\nvariable {ι : Type*} [Fintype ι] [DecidableEq ι]\n\ndef bit (b : Bool) : ℝ := if b then 1 else 0\n\ndef squarefreeMonomial (S : Finset ι) (x : ι → Bool) : ℝ :=\n  ∏ i ∈ S, bit (x i)\n\nnoncomputable def evaluate (a : Finset ι → ℝ) (x : ι → Bool) : ℝ :=\n  ∑ S, a S * squarefreeMonomial S x\n\ndef Represents (a : Finset ι → ℝ) (f : (ι → Bool) → ℝ) : Prop :=\n  ∀ x, evaluate a x = f x\n\ndef CoefficientsAtMost (a : Finset ι → ℝ) (d : ℕ) : Prop :=\n  ∀ S, d < S.card → a S = 0\n\ndef encode (useSigns : Bool) (b : Bool) : ℝ :=\n  if useSigns then (if b then -1 else 1) else bit b\n\ndef signMonomial (S : Finset ι) (x : ι → Bool) : ℝ :=\n  ∏ i ∈ S, encode true (x i)\n\nnoncomputable def signEvaluate (a : Finset ι → ℝ) (x : ι → Bool) : ℝ :=\n  ∑ S, a S * signMonomial S x\n\ndef SignRepresents (a : Finset ι → ℝ) (f : (ι → Bool) → ℝ) : Prop :=\n  ∀ x, signEvaluate a x = f x\n\nnoncomputable def evaluateWith (useSigns : Bool) (a : Finset ι → ℝ)\n    (x : ι → Bool) : ℝ :=\n  if useSigns then signEvaluate a x else evaluate a x\n\ndef RepresentsAs (inputSigns outputSigns : Bool) (a : Finset ι → ℝ)\n    (f : (ι → Bool) → Bool) : Prop :=\n  ∀ x, evaluateWith inputSigns a x = encode outputSigns (f x)\n\ndef indicatorInput (T : Finset ι) : ι → Bool := fun i => decide (i ∈ T)\n\n@[simp] theorem squarefreeMonomial_empty (x : ι → Bool) :\n    squarefreeMonomial (∅ : Finset ι) x = 1 := by\n  simp [squarefreeMonomial]\n\ntheorem squarefreeMonomial_indicator (S T : Finset ι) :\n    squarefreeMonomial S (indicatorInput T) = if S ⊆ T then 1 else 0 := by\n  simp only [squarefreeMonomial, bit, indicatorInput, decide_eq_true_eq]\n  rw [Finset.prod_boole]\n  rfl\n\ntheorem evaluate_indicator (a : Finset ι → ℝ) (T : Finset ι) :\n    evaluate a (indicatorInput T) = ∑ S ∈ T.powerset, a S := by\n  classical\n  simp only [evaluate, squarefreeMonomial_indicator, mul_ite, mul_one, mul_zero]\n  rw [← Finset.sum_filter]\n  congr 1\n  ext S\n  simp\n\n/-- Distinct squarefree coefficient arrays cannot agree on every Boolean input. -/\ntheorem coefficients_ext {a b : Finset ι → ℝ}\n    (h : ∀ x, evaluate a x = evaluate b x) : a = b := by\n  classical\n  have hsum (S : Finset ι) :\n      (∑ T ∈ S.powerset, a T) = ∑ T ∈ S.powerset, b T := by\n    simpa only [evaluate_indicator] using h (indicatorInput S)\n  have aux : ∀ m : ℕ, ∀ S : Finset ι, S.card < m → a S = b S := by\n    intro m\n    induction m with\n    | zero => intro S hS; omega\n    | succ m ih =>\n      intro S hS\n      by_cases hSm : S.card < m\n      · exact ih S hSm\n      · have hcard : S.card = m := by omega\n        have hrest : (∑ T ∈ S.powerset.erase S, a T) =\n            ∑ T ∈ S.powerset.erase S, b T := by\n          apply Finset.sum_congr rfl\n          intro T hT\n          have hproper : T ⊂ S :=\n            Finset.ssubset_iff_subset_ne.2\n              ⟨Finset.mem_powerset.1 (Finset.mem_erase.1 hT).2,\n                (Finset.mem_erase.1 hT).1⟩\n          apply ih T\n          simpa only [hcard] using Finset.card_lt_card hproper\n        have hmem : S ∈ S.powerset := Finset.mem_powerset.2 (Finset.Subset.refl S)\n        have ha := Finset.sum_erase_add (s := S.powerset) a hmem\n        have hb := Finset.sum_erase_add (s := S.powerset) b hmem\n        have ht := hsum S\n        linarith\n  funext S\n  exact aux (S.card + 1) S (Nat.lt_succ_self _)\n\ntheorem represents_unique {f : (ι → Bool) → ℝ} {a b : Finset ι → ℝ}\n    (ha : Represents a f) (hb : Represents b f) : a = b :=\n  coefficients_ext fun x => (ha x).trans (hb x).symm\n\ntheorem evaluate_zero (x : ι → Bool) : evaluate (fun _ : Finset ι => 0) x = 0 := by\n  simp [evaluate]\n\ntheorem evaluate_add (a b : Finset ι → ℝ) (x : ι → Bool) :\n    evaluate (fun S => a S + b S) x = evaluate a x + evaluate b x := by\n  simp [evaluate, add_mul, Finset.sum_add_distrib]\n\ntheorem evaluate_smul (c : ℝ) (a : Finset ι → ℝ) (x : ι → Bool) :\n    evaluate (fun S => c * a S) x = c * evaluate a x := by\n  simp [evaluate, mul_assoc, Finset.mul_sum]\n\ntheorem evaluate_single (S : Finset ι) (x : ι → Bool) :\n    evaluate (fun T => if T = S then 1 else 0) x = squarefreeMonomial S x := by\n  classical\n  simp [evaluate]\n\nend QuarticQuery.Independent.Degree\n"}