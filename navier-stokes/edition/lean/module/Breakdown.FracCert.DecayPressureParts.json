fileDecay","Breakdown.FracCert.profileField","Breakdown.Freq.CSpace","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Space","Breakdown.divergenceAt","Breakdown.fractionalPowerAt"],"used_by":["Breakdown.FracCert.powerDivergenceFree_of","Breakdown.FracCert.pressureDecay_of_model","Breakdown.FracCert.residualDivergence_of","Breakdown.SteadyCert.ChainInternal.powerDivergenceFree_holds"],"uses":["Breakdown.FracCert.HasAllMoments","Breakdown.FracCert.IsWeakRotatingProfile","Breakdown.FracCert.ProfileDecay","Breakdown.FracCert.profileField","Breakdown.Freq.CSpace","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Space","Breakdown.divergenceAt","Breakdown.fractionalPowerAt"],"written":"PowerDivergenceFreeStatement"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":58,"kind":"def","line":56,"module":"Breakdown.FracCert.DecayPressureParts","name":"Breakdown.FracCert.DecayingGradientVanishesStatement","namespace":"Breakdown.FracCert","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"DecayingGradientVanishesStatement","signature_end_line":56,"sorry":false,"statement_used_by":["Breakdown.FracCert.DecayPressureVanish.decayingGradientVanishes","Breakdown.FracCert.pressureDecay_of_parts","Breakdown.SteadyCert.ChainInternal.decayingGradientVanishes_holds"],"statement_uses":["Breakdown.FundSol.scalarSumSecondPartials","Breakdown.Space"],"used_by":["Breakdown.FracCert.DecayPressureVanish.decayingGradientVanishes","Breakdown.FracCert.pressureDecay_of_parts","Breakdown.SteadyCert.ChainInternal.decayingGradientVanishes_holds"],"uses":["Breakdown.FundSol.scalarSumSecondPartials","Breakdown.Space"],"written":"DecayingGradientVanishesStatement"}],"imports":["Breakdown.FracCert.StDecay","Breakdown.Uniqueness.FundSolDefs","Breakdown.FracCert.WeakRegularParts","Breakdown.FracCert.StKernel"],"module":"Breakdown.FracCert.DecayPressureParts","path":"Breakdown/FracCert/DecayPressureParts.lean","sha256":"293cdff960bc23d08d415a3aa117794137c7430d987eddf1519167f3d62ed12f","source":"import Breakdown.FracCert.StDecay\nimport Breakdown.Uniqueness.FundSolDefs\nimport Breakdown.FracCert.WeakRegularParts\nimport Breakdown.FracCert.StKernel\n\nopen MeasureTheory Set Real\nopen scoped ENNReal ContDiff\n\nnoncomputable section\n\nnamespace Breakdown.FracCert\n\nopen Breakdown.Freq Breakdown.FundSol\n\ndef PressureModelStatement : Prop :=\n  ∀ α : ℝ, 1 < α → α < 5 / 4 → ∀ (a : ℝ) (U : X), IsWeakRotatingProfile α a U → HasAllMoments U →\n    ProfileDecay α U → ∃ Q : Space → ℝ, ContDiff ℝ ∞ Q ∧\n      (∀ y, scalarSumSecondPartials Q y = -divergenceAt (advectionAt (profileField U)) y) ∧\n      ∀ j : ℕ, ∃ C : ℝ, ∀ y, ‖iteratedFDeriv ℝ (j + 1) Q y‖ ≤ C * (1 + ‖y‖) ^ (-(4 * α - 1 + j))\n\ndef PressureTraceStatement : Prop :=\n  ∀ α : ℝ, 1 < α → α < 5 / 4 → ∀ (a : ℝ) (U : X), IsWeakRotatingProfile α a U → HasAllMoments U →\n    ProfileDecay α U →\n      ∀ y, scalarSumSecondPartials (profilePressure U) y = -divergenceAt (advectionAt (profileField U)) y\n\ndef ModelPressureDecayStatement : Prop :=\n  ∀ α : ℝ, 1 < α → α < 5 / 4 → ∀ (a : ℝ) (U : X), IsWeakRotatingProfile α a U → HasAllMoments U →\n    ProfileDecay α U → ∀ j : ℕ, ∃ C : ℝ, ∀ y,\n      ‖iteratedFDeriv ℝ (j + 1) (profilePressure U) y‖ ≤ C * (1 + ‖y‖) ^ (-(4 * α - 1 + j))\n\ndef pressureMultiplier (i j : Fin 3) (ξ : Space) : ℂ := ((-(ξ i * ξ j / ‖ξ‖ ^ 2) : ℝ) : ℂ)\n\ndef ProductWeightedSmoothStatement : Prop :=\n  ∀ α : ℝ, 1 < α → α < 5 / 4 → ∀ (a : ℝ) (U : X), IsWeakRotatingProfile α a U → HasAllMoments U →\n    ProfileDecay α U → ∀ i j : Fin 3,\n      IsWeightedSmooth (fun y => ((profileField U y i * profileField U y j : ℝ) : ℂ)) (4 * α - 2)\n\ndef PressureRepresentationStatement : Prop :=\n  ∀ α : ℝ, 1 < α → α < 5 / 4 → ∀ (a : ℝ) (U : X), IsWeakRotatingProfile α a U → HasAllMoments U →\n    ProfileDecay α U → ∃ F : Fin 3 → Fin 3 → Space → ℂ,\n      (∀ i j, IsTransformOf (F i j) (fun y => ((profileField U y i * profileField U y j : ℝ) : ℂ))) ∧\n      (∀ i j, HasMomentsInL1 (fun ξ => pressureMultiplier i j ξ * F i j ξ)) ∧\n      ∀ y, profilePressure U y =\n        ∑ i, ∑ j, (FourierTransform.fourierInv (fun ξ => pressureMultiplier i j ξ * F i j ξ) y).re\n\ndef ResidualDivergenceStatement : Prop :=\n  ∀ α : ℝ, 1 < α → α < 5 / 4 → ∀ (a : ℝ) (U : X), IsWeakRotatingProfile α a U → HasAllMoments U →\n    ProfileDecay α U → ∀ P : Space → ℝ, ContDiff ℝ ∞ P →\n    (∀ y, rotatingProfileResidual α a 1 (profileField U) P y = 0) →\n      ∀ y, scalarSumSecondPartials P y = -divergenceAt (advectionAt (profileField U)) y\n\ndef PowerDivergenceFreeStatement : Prop :=\n  ∀ α : ℝ, 1 < α → α < 5 / 4 → ∀ (a : ℝ) (U : X), IsWeakRotatingProfile α a U → HasAllMoments U →\n    ProfileDecay α U → ∀ y, divergenceAt (fractionalPowerAt α (profileField U)) y = 0\n\ndef DecayingGradientVanishesStatement : Prop :=\n  ∀ h : Space → ℝ, ContDiff ℝ ∞ h → (∀ y, scalarSumSecondPartials h y = 0) →\n    ∀ K s : ℝ, 0 < s → (∀ y, ‖fderiv ℝ h y‖ ≤ K * (1 + ‖y‖) ^ (-s)) → ∀ y, fderiv ℝ h y = 0\n\nend Breakdown.FracCert\n"}