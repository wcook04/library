"Breakdown.Space"],"written":"norm_truncSymbol_le"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":71,"kind":"theorem","line":68,"module":"Breakdown.CertTorus.DerivIntegral","name":"Breakdown.FarField.Internal.DerivIntegral.norm_truncCut_le","namespace":"Breakdown.FarField.Internal.DerivIntegral","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.FarField.Internal.DerivIntegral.truncate_eq"],"proof_uses":[],"protected":false,"short":"norm_truncCut_le","signature_end_line":69,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.FarField.Internal.DerivIntegral.truncCut","Breakdown.Space"],"used_by":["Breakdown.FarField.Internal.DerivIntegral.truncate_eq"],"uses":["Breakdown.FarField.Internal.DerivIntegral.truncCut","Breakdown.Space"],"written":"norm_truncCut_le"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":105,"kind":"theorem","line":73,"module":"Breakdown.CertTorus.DerivIntegral","name":"Breakdown.FarField.Internal.DerivIntegral.truncate_eq","namespace":"Breakdown.FarField.Internal.DerivIntegral","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.FarField.derivIntegral_holds"],"proof_uses":["Breakdown.FarField.Internal.DerivIntegral.measurable_truncCut","Breakdown.FarField.Internal.DerivIntegral.measurable_truncSymbol","Breakdown.FarField.Internal.DerivIntegral.multOp","Breakdown.FarField.Internal.DerivIntegral.multOp_ae","Breakdown.FarField.Internal.DerivIntegral.norm_truncCut_le","Breakdown.FarField.Internal.DerivIntegral.norm_truncSymbol_le","Breakdown.Freq.Sig"],"protected":false,"short":"truncate_eq","signature_end_line":77,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.FarField.Internal.DerivIntegral.truncCut","Breakdown.FarField.Internal.DerivIntegral.truncSymbol","Breakdown.FarField.IsDerivX","Breakdown.FarField.symX","Breakdown.Freq.CSpace","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Space"],"used_by":["Breakdown.FarField.derivIntegral_holds"],"uses":["Breakdown.FarField.Internal.DerivIntegral.measurable_truncCut","Breakdown.FarField.Internal.DerivIntegral.measurable_truncSymbol","Breakdown.FarField.Internal.DerivIntegral.multOp","Breakdown.FarField.Internal.DerivIntegral.multOp_ae","Breakdown.FarField.Internal.DerivIntegral.norm_truncCut_le","Breakdown.FarField.Internal.DerivIntegral.norm_truncSymbol_le","Breakdown.FarField.Internal.DerivIntegral.truncCut","Breakdown.FarField.Internal.DerivIntegral.truncSymbol","Breakdown.FarField.IsDerivX","Breakdown.FarField.symX","Breakdown.Freq.CSpace","Breakdown.Freq.L2C","Breakdown.Freq.Sig","Breakdown.Freq.X","Breakdown.Space"],"written":"truncate_eq"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":118,"kind":"theorem","line":110,"module":"Breakdown.CertTorus.DerivIntegral","name":"Breakdown.FarField.derivIntegral_holds","namespace":"Breakdown.FarField","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.FarField.smoothFieldOfOrbit_holds"],"proof_uses":["Breakdown.FarField.Internal.DerivIntegral.truncCut","Breakdown.FarField.Internal.DerivIntegral.truncSymbol","Breakdown.FarField.Internal.DerivIntegral.truncate_eq","Breakdown.FarField.monoSymbol"],"protected":false,"short":"derivIntegral_holds","signature_end_line":110,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.FarField.DerivIntegral"],"used_by":["Breakdown.FarField.smoothFieldOfOrbit_holds"],"uses":["Breakdown.FarField.DerivIntegral","Breakdown.FarField.Internal.DerivIntegral.truncCut","Breakdown.FarField.Internal.DerivIntegral.truncSymbol","Breakdown.FarField.Internal.DerivIntegral.truncate_eq","Breakdown.FarField.monoSymbol"],"written":"derivIntegral_holds"}],"imports":["Breakdown.CertTorus.RegularStatements"],"module":"Breakdown.CertTorus.DerivIntegral","path":"Breakdown/CertTorus/DerivIntegral.lean","sha256":"103ca4c85fd5da36a6e9030a3a0a154eb489c28a7a3a85e81f4a41b909153dc1","source":"import Breakdown.CertTorus.RegularStatements\n\nopen MeasureTheory Set Real Filter\n\nnoncomputable section\n\nnamespace Breakdown.FarField\n\nopen Freq\n\nnamespace Internal.DerivIntegral\n\ntheorem cmul_apply (c : ℂ) (z : CSpace) : cmul c z = c • z := rfl\n\ntheorem norm_cmul_le (c : ℂ) : ‖cmul c‖ ≤ ‖c‖ :=\n  ContinuousLinearMap.opNorm_le_bound _ (norm_nonneg c) (fun z => by\n    rw [cmul_apply, norm_smul])\n\ntheorem cmul_sub (c d : ℂ) : cmul c - cmul d = cmul (c - d) :=\n  ContinuousLinearMap.ext fun z => by\n    simp only [sub_apply, cmul_apply, sub_smul]\n\ntheorem continuous_cmul : Continuous cmul :=\n  (LipschitzWith.of_dist_le_mul (K := 1) fun c d => by\n    rw [dist_eq_norm, dist_eq_norm, cmul_sub, NNReal.coe_one, one_mul]\n    exact norm_cmul_le _).continuous\n\ndef multOp (c : Space → ℂ) : L2C →L[ℝ] L2C :=\n  fieldOp (ContinuousLinearEquiv.refl ℝ Space) (fun ξ => cmul (c ξ))\n\ntheorem multOp_ae {c : Space → ℂ} (hc : Measurable c) {C : ℝ} (hC : ∀ ξ, ‖c ξ‖ ≤ C)\n    (f : L2C) : (multOp c f : Space → CSpace) =ᵐ[volume] fun ξ => c ξ • f ξ := by\n  have hm : AEStronglyMeasurable (fun ξ => cmul (c ξ)) volume :=\n    continuous_cmul.comp_aestronglyMeasurable hc.aestronglyMeasurable\n  have hb : ∀ ξ, ‖cmul (c ξ)‖ ≤ C := fun ξ => (norm_cmul_le _).trans (hC ξ)\n  have h := fieldOpRealized_holds (ContinuousLinearEquiv.refl ℝ Space) _ C hm hb f\n  filter_upwards [h] with ξ hξ\n  rw [multOp, hξ]\n  rfl\n\ntheorem continuous_monoSymbol {n : ℕ} (α : Fin n → Fin 3) : Continuous (monoSymbol α) := by\n  unfold monoSymbol\n  fun_prop\n\ndef truncSymbol {n : ℕ} (α : Fin n → Fin 3) (N : ℕ) (ξ : Space) : ℂ :=\n  if ‖monoSymbol α ξ‖ ≤ N then monoSymbol α ξ else 0\n\ndef truncCut {n : ℕ} (α : Fin n → Fin 3) (N : ℕ) (ξ : Space) : ℂ :=\n  if ‖monoSymbol α ξ‖ ≤ N then 1 else 0\n\ntheorem measurable_truncSymbol {n : ℕ} (α : Fin n → Fin 3) (N : ℕ) :\n    Measurable (truncSymbol α N) :=\n  Measurable.ite (measurableSet_le (continuous_monoSymbol α).measurable.norm measurable_const)\n    (continuous_monoSymbol α).measurable measurable_const\n\ntheorem measurable_truncCut {n : ℕ} (α : Fin n → Fin 3) (N : ℕ) :\n    Measurable (truncCut α N) :=\n  Measurable.ite (measurableSet_le (continuous_monoSymbol α).measurable.norm measurable_const)\n    measurable_const measurable_const\n\ntheorem norm_truncSymbol_le {n : ℕ} (α : Fin n → Fin 3) (N : ℕ) (ξ : Space) :\n    ‖truncSymbol α N ξ‖ ≤ N := by\n  unfold truncSymbol\n  split_ifs with h\n  · exact h\n  · simp\n\ntheorem norm_truncCut_le {n : ℕ} (α : Fin n → Fin 3) (N : ℕ) (ξ : Space) :\n    ‖truncCut α N ξ‖ ≤ 1 := by\n  unfold truncCut\n  split_ifs <;> simp\n\ntheorem truncate_eq {n : ℕ} (α : Fin n → Fin 3) (N : ℕ) (F G : ℝ → X) (a b : ℝ) (hab : a ≤ b)\n    (hF : IntervalIntegrable F volume a b) (hG : IntervalIntegrable G volume a b)\n    (hFG : ∀ s ∈ Ioo a b, IsDerivX α (F s) (G s)) :\n    ∀ᵐ ξ ∂volume, truncCut α N ξ • symX (∫ s in a..b, G s) ξ =\n      truncSymbol α N ξ • symX (∫ s in a..b, F s) ξ := by\n  have hP := multOp_ae (measurable_truncSymbol α N) (norm_truncSymbol_le α N)\n  have hQ := multOp_ae (measurable_truncCut α N) (norm_truncCut_le α N)\n  let P : X →L[ℝ] L2C := multOp (truncSymbol α N) ∘L Sig.subtypeL\n  let Q : X →L[ℝ] L2C := multOp (truncCut α N) ∘L Sig.subtypeL\n  have hPx : ∀ x : X, P x = multOp (truncSymbol α N) (x : L2C) := fun x => rfl\n  have hQx : ∀ x : X, Q x = multOp (truncCut α N) (x : L2C) := fun x => rfl\n  have hpt : EqOn (fun s => P (F s)) (fun s => Q (G s)) (Ioo a b) := by\n    intro s hs\n    simp only [hPx, hQx]\n    apply Lp.ext\n    filter_upwards [hP (F s : L2C), hQ (G s : L2C), hFG s hs] with ξ h1 h2 h3\n    rw [h1, h2]\n    change truncSymbol α N ξ • symX (F s) ξ = truncCut α N ξ • symX (G s) ξ\n    rw [h3]\n    unfold truncSymbol truncCut\n    split_ifs <;> simp\n  have hint : P (∫ s in a..b, F s) = Q (∫ s in a..b, G s) := by\n    rw [← ContinuousLinearMap.intervalIntegral_comp_comm P hF,\n      ← ContinuousLinearMap.intervalIntegral_comp_comm Q hG,\n      intervalIntegral.integral_of_le hab, intervalIntegral.integral_of_le hab,\n      integral_Ioc_eq_integral_Ioo, integral_Ioc_eq_integral_Ioo]\n    exact setIntegral_congr_fun measurableSet_Ioo hpt\n  rw [hPx, hQx] at hint\n  filter_upwards [hP ((∫ s in a..b, F s : X) : L2C), hQ ((∫ s in a..b, G s : X) : L2C)]\n    with ξ h1 h2\n  change truncCut α N ξ • ((∫ s in a..b, G s : X) : L2C) ξ =\n    truncSymbol α N ξ • ((∫ s in a..b, F s : X) : L2C) ξ\n  rw [← h1, ← h2, hint]\n\nend Internal.DerivIntegral\n\nopen Internal.DerivIntegral in\ntheorem derivIntegral_holds : DerivIntegral := by\n  intro n α F G a b hab hF hG hFG\n  have h := ae_all_iff.2 fun N : ℕ => truncate_eq α N F G a b hab hF hG hFG\n  filter_upwards [h] with ξ hξ\n  obtain ⟨N, hN⟩ := exists_nat_ge ‖monoSymbol α ξ‖\n  have e := hξ N\n  unfold truncSymbol truncCut at e\n  rw [if_pos hN, if_pos hN, one_smul] at e\n  exact e\n\nend Breakdown.FarField\n"}