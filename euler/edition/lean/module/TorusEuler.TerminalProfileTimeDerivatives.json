file.meanSource_timeJet_labelNorm_le","TorusEuler.HierarchyTwistedProfile.rawMean_timeJet_labelNorm_le","TorusEuler.HierarchyTwistedProfile.timeJetSeminorm_le_of_activeCellJets","TorusEuler.HierarchyTwistedProfile.timeJet_eval_of_labelField","TorusEuler.HierarchyTwistedProfile.timeJet_phaseIndependent","TorusEuler.HierarchyTwistedProfile.timeJet_phasePrimitiveProfile","TorusEuler.HierarchyTwistedProfile.timeJet_profilePhaseAverage"],"uses":["TorusEuler.HierarchyPeriodicProfile","TorusEuler.HierarchyProfilePoint","TorusEuler.HierarchySmoothProfile","TorusEuler.HierarchyTwistedProfile","TorusEuler.HierarchyTwistedProfile.timeDerivative_apply","TorusEuler.HierarchyTwistedProfile.timeJet","TorusEuler.HierarchyTwistedProfile.timeJet_succ","TorusEuler.Vec3","TorusEuler.instModuleHierarchyTwistedProfile"],"written":"timeJet_apply"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":"The second within-slab derivative commutes along any two fixed directions.","end_line":115,"kind":"theorem","line":83,"module":"TorusEuler.TerminalProfileTimeDerivatives","name":"TorusEuler.HierarchyTwistedProfile.directionDerivative_comm","namespace":"TorusEuler.HierarchyTwistedProfile","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["TorusEuler.HierarchyTwistedProfile.timeJet_directionDerivative"],"proof_uses":["TorusEuler.HierarchySmoothProfile.smooth","TorusEuler.HierarchyTwistedProfile.directionDerivative_apply","TorusEuler.HierarchyTwistedProfile.ext","TorusEuler.hierarchyProfileSlab","TorusEuler.uniqueDiffOn_hierarchyProfileSlab"],"protected":false,"short":"directionDerivative_comm","signature_end_line":86,"sorry":false,"statement_used_by":[],"statement_uses":["TorusEuler.HierarchyPeriodicProfile","TorusEuler.HierarchyProfilePoint","TorusEuler.HierarchySmoothProfile","TorusEuler.HierarchyTwistedProfile","TorusEuler.HierarchyTwistedProfile.directionDerivative","TorusEuler.Vec3","TorusEuler.instModuleHierarchyTwistedProfile"],"used_by":["TorusEuler.HierarchyTwistedProfile.timeJet_directionDerivative"],"uses":["TorusEuler.HierarchyPeriodicProfile","TorusEuler.HierarchyProfilePoint","TorusEuler.HierarchySmoothProfile","TorusEuler.HierarchySmoothProfile.smooth","TorusEuler.HierarchyTwistedProfile","TorusEuler.HierarchyTwistedProfile.directionDerivative","TorusEuler.HierarchyTwistedProfile.directionDerivative_apply","TorusEuler.HierarchyTwistedProfile.ext","TorusEuler.Vec3","TorusEuler.hierarchyProfileSlab","TorusEuler.instModuleHierarchyTwistedProfile","TorusEuler.uniqueDiffOn_hierarchyProfileSlab"],"written":"directionDerivative_comm"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":"Arbitrary time jets commute with a fixed label, phase, or time direction.","end_line":124,"kind":"theorem","line":118,"module":"TorusEuler.TerminalProfileTimeDerivatives","name":"TorusEuler.HierarchyTwistedProfile.timeJet_directionDerivative","namespace":"TorusEuler.HierarchyTwistedProfile","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["TorusEuler.HierarchyTwistedProfile.TransverseResult.timeJet_bound","TorusEuler.HierarchyTwistedProfile.timeJet_mixedWord","TorusEuler.HierarchyTwistedProfile.timeJet_scaledProfileDerivative"],"proof_uses":["TorusEuler.HierarchyTwistedProfile.directionDerivative_comm","TorusEuler.HierarchyTwistedProfile.timeJet_succ"],"protected":false,"short":"timeJet_directionDerivative","signature_end_line":120,"sorry":false,"statement_used_by":[],"statement_uses":["TorusEuler.HierarchyPeriodicProfile","TorusEuler.HierarchyProfilePoint","TorusEuler.HierarchySmoothProfile","TorusEuler.HierarchyTwistedProfile","TorusEuler.HierarchyTwistedProfile.directionDerivative","TorusEuler.HierarchyTwistedProfile.timeJet","TorusEuler.Vec3","TorusEuler.instModuleHierarchyTwistedProfile"],"used_by":["TorusEuler.HierarchyTwistedProfile.TransverseResult.timeJet_bound","TorusEuler.HierarchyTwistedProfile.timeJet_mixedWord","TorusEuler.HierarchyTwistedProfile.timeJet_scaledProfileDerivative"],"uses":["TorusEuler.HierarchyPeriodicProfile","TorusEuler.HierarchyProfilePoint","TorusEuler.HierarchySmoothProfile","TorusEuler.HierarchyTwistedProfile","TorusEuler.HierarchyTwistedProfile.directionDerivative","TorusEuler.HierarchyTwistedProfile.directionDerivative_comm","TorusEuler.HierarchyTwistedProfile.timeJet","TorusEuler.HierarchyTwistedProfile.timeJet_succ","TorusEuler.Vec3","TorusEuler.instModuleHierarchyTwistedProfile"],"written":"timeJet_directionDerivative"}],"imports":["TorusEuler.HierarchyTwistedProfiles","Mathlib.Analysis.Calculus.Deriv.Comp","Mathlib.Analysis.Calculus.FDeriv.Symmetric","Mathlib.Analysis.Calculus.IteratedDeriv.Lemmas","Mathlib.Data.Nat.Choose.Sum"],"module":"TorusEuler.TerminalProfileTimeDerivatives","path":"TorusEuler/TerminalProfileTimeDerivatives.lean","sha256":"5b291cd872a2527049b127ddaeaf0c67beed2a2e1f5662a1708bbb5285967852","source":"import TorusEuler.HierarchyTwistedProfiles\nimport Mathlib.Analysis.Calculus.Deriv.Comp\nimport Mathlib.Analysis.Calculus.FDeriv.Symmetric\nimport Mathlib.Analysis.Calculus.IteratedDeriv.Lemmas\nimport Mathlib.Data.Nat.Choose.Sum\n\n/-! Constant-direction derivatives and time jets of the actual slab profiles. -/\n\nopen Set ContinuousLinearMap\nopen scoped ContDiff\n\nnamespace TorusEuler.HierarchyTwistedProfile\n\nnoncomputable section\n\nvariable {T : ℝ} {k : Vec3} {E F G : Type*}\n  [NormedAddCommGroup E] [NormedSpace ℝ E]\n  [NormedAddCommGroup F] [NormedSpace ℝ F]\n  [NormedAddCommGroup G] [NormedSpace ℝ G]\n\n/-- A derivative in a fixed direction of the slab. -/\ndef directionDerivative (hT : 0 < T) (v : HierarchyProfilePoint) :\n    HierarchyTwistedProfile T k E →ₗ[ℝ] HierarchyTwistedProfile T k E :=\n  (map (ContinuousLinearMap.apply ℝ E v)).comp (derivative hT)\n\ntheorem directionDerivative_apply (hT : 0 < T) (v : HierarchyProfilePoint)\n    (f : HierarchyTwistedProfile T k E) {x : HierarchyProfilePoint}\n    (hx : x ∈ hierarchyProfileSlab T) :\n    (directionDerivative hT v f).val.val.val x =\n      fderivWithin ℝ f.val.val.val (hierarchyProfileSlab T) x v := by\n  simp [directionDerivative, HierarchyPeriodicProfile.map_val, HierarchySmoothProfile.map_apply,\n    HierarchyPeriodicProfile.derivative_val, HierarchySmoothProfile.derivative_apply, hx]\n\n/-- Differentiate in time with the label and independent phase fixed. -/\nabbrev timeDerivative (hT : 0 < T) :\n    HierarchyTwistedProfile T k E →ₗ[ℝ] HierarchyTwistedProfile T k E :=\n  directionDerivative hT (1, 0, 0)\n\ntheorem timeDerivative_apply (hT : 0 < T) (f : HierarchyTwistedProfile T k E)\n    {t : ℝ} (ht : t ∈ Icc 0 T) (x : Vec3 × ℝ) :\n    (timeDerivative hT f).val.val.val (t, x) =\n      derivWithin (fun u => f.val.val.val (u, x)) (Icc 0 T) t := by\n  rw [timeDerivative, directionDerivative_apply hT _ _ ⟨ht, mem_univ _⟩]\n  let j : ℝ → HierarchyProfilePoint := fun u => (u, x)\n  have hj : HasDerivAt j (1, 0, 0) t :=\n    hasDerivAt_id t |>.prodMk (hasDerivAt_const t x)\n  have hf := ((HierarchySmoothProfile.smooth f.val.val).differentiableOn (by simp)\n    (t, x) ⟨ht, mem_univ _⟩).hasFDerivWithinAt\n  exact (hf.comp_hasDerivWithinAt t hj.hasDerivWithinAt\n    (show MapsTo j (Icc 0 T) (hierarchyProfileSlab T) from fun _ hu => ⟨hu, mem_univ _⟩)).derivWithin\n      (uniqueDiffOn_Icc hT t ht) |>.symm\n\n/-- The iterated time derivative as a linear profile operator. -/\ndef timeJet (hT : 0 < T) (i : ℕ) :\n    HierarchyTwistedProfile T k E →ₗ[ℝ] HierarchyTwistedProfile T k E :=\n  (timeDerivative hT) ^ i\n\n@[simp] theorem timeJet_zero (hT : 0 < T) (f : HierarchyTwistedProfile T k E) :\n    timeJet hT 0 f = f := rfl\n\ntheorem timeJet_succ (hT : 0 < T) (i : ℕ) (f : HierarchyTwistedProfile T k E) :\n    timeJet hT (i + 1) f = timeDerivative hT (timeJet hT i f) := by\n  rw [timeJet, pow_succ']\n  rfl\n\ntheorem timeJet_succ' (hT : 0 < T) (i : ℕ) (f : HierarchyTwistedProfile T k E) :\n    timeJet hT (i + 1) f = timeJet hT i (timeDerivative hT f) := by\n  rw [timeJet, pow_succ]\n  rfl\n\n/-- The profile derivative is the genuine one-variable closed-slab derivative. -/\ntheorem timeJet_apply (hT : 0 < T) (i : ℕ) (f : HierarchyTwistedProfile T k E)\n    {t : ℝ} (ht : t ∈ Icc 0 T) (x : Vec3 × ℝ) :\n    (timeJet hT i f).val.val.val (t, x) =\n      iteratedDerivWithin i (fun u => f.val.val.val (u, x)) (Icc 0 T) t := by\n  induction i generalizing t with\n  | zero => simp\n  | succ n ih =>\n    rw [timeJet_succ, timeDerivative_apply hT _ ht, iteratedDerivWithin_succ]\n    exact derivWithin_congr (fun _ hu => ih hu) (ih ht)\n\n/-- The second within-slab derivative commutes along any two fixed directions. -/\ntheorem directionDerivative_comm (hT : 0 < T) (v w : HierarchyProfilePoint)\n    (f : HierarchyTwistedProfile T k E) :\n    directionDerivative hT v (directionDerivative hT w f) =\n      directionDerivative hT w (directionDerivative hT v f) := by\n  apply HierarchyTwistedProfile.ext\n  intro x hx\n  let S := hierarchyProfileSlab T\n  let D := fderivWithin ℝ f.val.val.val S\n  have hu := uniqueDiffOn_hierarchyProfileSlab hT\n  have hd := (HierarchySmoothProfile.smooth f.val.val).fderivWithin hu (m := ∞) (by simp)\n  have hInterior : (interior S).Nonempty := by\n    refine ⟨(T / 2, 0, 0), ?_⟩\n    change (T / 2, (0 : Vec3), (0 : ℝ)) ∈ interior (Icc 0 T ×ˢ (univ : Set (Vec3 × ℝ)))\n    rw [interior_prod_eq, interior_Icc, interior_univ]\n    exact ⟨⟨by linarith, by linarith⟩, mem_univ _⟩\n  have hConvex : Convex ℝ S := (convex_Icc 0 T).prod convex_univ\n  have hsym :=\n    hConvex.second_derivative_within_at_symmetric (f := f.val.val.val) (f' := D) hInterior\n      (fun y hy =>\n        (((HierarchySmoothProfile.smooth f.val.val).differentiableOn (by simp)\n          y (interior_subset hy)).hasFDerivWithinAt).hasFDerivAt (mem_interior_iff_mem_nhds.mp hy))\n      hx (((hd.differentiableOn (by simp) x hx).hasFDerivWithinAt).mono interior_subset) v w\n  have hDeriv (a b : HierarchyProfilePoint) :\n      (directionDerivative hT a (directionDerivative hT b f)).val.val.val x =\n        fderivWithin ℝ D S x a b := by\n    rw [directionDerivative_apply hT _ _ hx,\n      fderivWithin_congr' (show EqOn (directionDerivative hT b f).val.val.val\n        (fun y => D y b) S from fun y hy => directionDerivative_apply hT b f hy) hx]\n    exact congrArg (fun L : HierarchyProfilePoint →L[ℝ] E => L a)\n      (((ContinuousLinearMap.apply ℝ E b).hasFDerivAt.comp_hasFDerivWithinAt x\n        ((hd.differentiableOn (by simp) x hx).hasFDerivWithinAt)).fderivWithin (hu x hx))\n  rw [hDeriv, hDeriv]\n  exact hsym\n\n/-- Arbitrary time jets commute with a fixed label, phase, or time direction. -/\ntheorem timeJet_directionDerivative (hT : 0 < T) (i : ℕ) (v : HierarchyProfilePoint)\n    (f : HierarchyTwistedProfile T k E) :\n    timeJet hT i (directionDerivative hT v f) = directionDerivative hT v (timeJet hT i f) := by\n  induction i with\n  | zero => rfl\n  | succ n ih =>\n    rw [timeJet_succ, timeJet_succ, ih, directionDerivative_comm hT (1, 0, 0) v]\n\nend\n\nend TorusEuler.HierarchyTwistedProfile\n"}