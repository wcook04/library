nt_uses":["Breakdown.Space","Breakdown.SteadyCert.FracCertData","Breakdown.SteadyCert.FracCertData.IsLinearState","Breakdown.SteadyCert.FracCertData.heldResidual","Breakdown.SteadyCert.FracCertData.order","Breakdown.SteadyCert.FracCertData.radius","Breakdown.SteadyCert.IsClassField","Breakdown.SteadyCert.IsFracCert","Breakdown.SteadyCert.box"],"used_by":["Breakdown.SteadyCert.ChainInternal.heldResidualClass_holds","Breakdown.SteadyCert.heldResidualClass_of","Breakdown.SteadyCert.heldResidualSquare_of"],"uses":["Breakdown.Space","Breakdown.SteadyCert.FracCertData","Breakdown.SteadyCert.FracCertData.IsLinearState","Breakdown.SteadyCert.FracCertData.heldResidual","Breakdown.SteadyCert.FracCertData.order","Breakdown.SteadyCert.FracCertData.radius","Breakdown.SteadyCert.IsClassField","Breakdown.SteadyCert.IsFracCert","Breakdown.SteadyCert.box"],"written":"HeldResidualClassStatement"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":77,"kind":"def","line":60,"module":"Breakdown.FracCert.HeldLimitParts","name":"Breakdown.SteadyCert.HeldStateLimitStatement","namespace":"Breakdown.SteadyCert","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"HeldStateLimitStatement","signature_end_line":60,"sorry":false,"statement_used_by":["Breakdown.SteadyCert.ChainInternal.heldStateLimit_holds","Breakdown.SteadyCert.heldStateLimitProved","Breakdown.SteadyCert.heldStateLimit_b","Breakdown.SteadyCert.heldStateLimit_of_bounds","Breakdown.SteadyCert.heldWeakLimit_of"],"statement_uses":["Breakdown.Space","Breakdown.SteadyCert.FracCertData","Breakdown.SteadyCert.FracCertData.IsHeldSolution","Breakdown.SteadyCert.FracCertData.IsLinearState","Breakdown.SteadyCert.FracCertData.energy","Breakdown.SteadyCert.FracCertData.heldResidual","Breakdown.SteadyCert.FracCertData.radius","Breakdown.SteadyCert.FracCertData.size","Breakdown.SteadyCert.IsFracCert","Breakdown.SteadyCert.IsSolenoidalL2","Breakdown.SteadyCert.box","Breakdown.SteadyCert.entryInner","Breakdown.SteadyCert.entrySq"],"used_by":["Breakdown.SteadyCert.ChainInternal.heldStateLimit_holds","Breakdown.SteadyCert.heldStateLimitProved","Breakdown.SteadyCert.heldStateLimit_b","Breakdown.SteadyCert.heldStateLimit_of_bounds","Breakdown.SteadyCert.heldWeakLimit_of"],"uses":["Breakdown.Space","Breakdown.SteadyCert.FracCertData","Breakdown.SteadyCert.FracCertData.IsHeldSolution","Breakdown.SteadyCert.FracCertData.IsLinearState","Breakdown.SteadyCert.FracCertData.energy","Breakdown.SteadyCert.FracCertData.heldResidual","Breakdown.SteadyCert.FracCertData.radius","Breakdown.SteadyCert.FracCertData.size","Breakdown.SteadyCert.IsFracCert","Breakdown.SteadyCert.IsSolenoidalL2","Breakdown.SteadyCert.box","Breakdown.SteadyCert.entryInner","Breakdown.SteadyCert.entrySq"],"written":"HeldStateLimitStatement"}],"imports":["Breakdown.FracCert.StHeldParts"],"module":"Breakdown.FracCert.HeldLimitParts","path":"Breakdown/FracCert/HeldLimitParts.lean","sha256":"cbc3602dac132ce27d00b5df2fa282d8d5ad4c6fbebeffc5814fe76f09f41faf","source":"import Breakdown.FracCert.StHeldParts\n\nopen scoped ContDiff ENNReal\nopen MeasureTheory\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace SteadyCert\n\nnamespace FracCertData\n\nvariable {k N : ℕ} (d : FracCertData k N)\n\ndef heldResidual (α : ℝ) (p : Fin k → ℝ) (v : Space → Space) (G : Space → (Space →L[ℝ] Space))\n    (H : Space → (Space →L[ℝ] Space →L[ℝ] Space)) (P : Space → Space) (κ : Fin k → ℝ) (y : Space) : Space :=\n  d.fullField α p v G H P κ y + G y (v y) + d.defect α p y\n\nend FracCertData\n\ndef HeldResidualSquareStatement : Prop :=\n  ∀ α : ℝ, 1 < α → α < 5 / 4 → ∀ {k N : ℕ} (d : FracCertData k N), IsFracCert α d →\n    ∀ p ∈ box d.radius, ∀ v G H P, d.IsLinearState α p v G H P → ∀ κ : Fin k → ℝ,\n      MemLp (d.heldResidual α p v G H P κ) 2 volume ∧ IsClassField d.order (d.heldResidual α p v G H P κ)\n\ndef HeldWeakLimitStatement : Prop :=\n  ∀ α : ℝ, 1 < α → α < 5 / 4 → ∀ {k N : ℕ} (d : FracCertData k N), IsFracCert α d →\n    ∀ (p : ℕ → Fin k → ℝ) (q : Fin k → ℝ), (∀ n, p n ∈ box d.radius) → q ∈ box d.radius →\n      Filter.Tendsto p Filter.atTop (nhds q) →\n      ∀ (u : ℕ → Space → Space) (G : ℕ → Space → (Space →L[ℝ] Space))\n        (H : ℕ → Space → (Space →L[ℝ] Space →L[ℝ] Space)) (P : ℕ → Space → Space) (κ : ℕ → Fin k → ℝ)\n        (R : ℝ), (∀ n, d.IsHeldSolution α (p n) (u n) (G n) (H n) (P n) (κ n)) →\n        (∀ n, d.size (G n) (H n) (κ n) ≤ R) →\n        ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∃ u₀ G₀ H₀ P₀, ∃ κ₀ : Fin k → ℝ,\n          d.IsLinearState α q u₀ G₀ H₀ P₀ ∧ d.size G₀ H₀ κ₀ ≤ R ∧\n          Filter.Tendsto (fun n => κ (φ n)) Filter.atTop (nhds κ₀) ∧\n          Filter.Tendsto (fun n => d.pins (G (φ n))) Filter.atTop (nhds (d.pins G₀)) ∧\n          ∀ ζ : Space → Space, IsSolenoidalL2 ζ →\n            Filter.Tendsto (fun n => ∫ y, inner ℝ\n              (d.heldResidual α (p (φ n)) (u (φ n)) (G (φ n)) (H (φ n)) (P (φ n)) (κ (φ n)) y) (ζ y))\n              Filter.atTop (nhds (∫ y, inner ℝ (d.heldResidual α q u₀ G₀ H₀ P₀ κ₀ y) (ζ y)))\n\ndef WeakPowerClassStatement : Prop :=\n  ∀ α : ℝ, 1 < α → α < 5 / 4 → ∀ (m : ℕ) (v P : Space → Space), AEStronglyMeasurable v volume →\n    MemLp v 6 volume → IsClassField m v → IsWeakFractionalPower α v P → IsClassField m P\n\ndef GradientClassStatement : Prop :=\n  ∀ (m : ℕ) (v : Space → Space) (G : Space → (Space →L[ℝ] Space)), AEStronglyMeasurable v volume →\n    MemLp v 6 volume → AEStronglyMeasurable G volume → Integrable (fun y => entrySq (G y)) →\n    IsWeakGradientOf v G → IsClassField m v →\n    (∀ᵐ y ∂volume, ∀ w, G (turnStep m y) (turnStep m w) = turnStep m (G y w)) ∧\n      ∀ᵐ y ∂volume, ∀ w, G (mirror y) (mirror w) = mirror (G y w)\n\ndef HeldResidualClassStatement : Prop :=\n  ∀ α : ℝ, 1 < α → α < 5 / 4 → ∀ {k N : ℕ} (d : FracCertData k N), IsFracCert α d →\n    ∀ p ∈ box d.radius, ∀ v G H P, d.IsLinearState α p v G H P → ∀ κ : Fin k → ℝ,\n      IsClassField d.order (d.heldResidual α p v G H P κ)\n\ndef HeldStateLimitStatement : Prop :=\n  ∀ α : ℝ, 1 < α → α < 5 / 4 → ∀ {k N : ℕ} (d : FracCertData k N), IsFracCert α d →\n    ∀ (p : ℕ → Fin k → ℝ) (q : Fin k → ℝ), (∀ n, p n ∈ box d.radius) → q ∈ box d.radius →\n      Filter.Tendsto p Filter.atTop (nhds q) →\n      ∀ (u : ℕ → Space → Space) (G : ℕ → Space → (Space →L[ℝ] Space))\n        (H : ℕ → Space → (Space →L[ℝ] Space →L[ℝ] Space)) (P : ℕ → Space → Space) (κ : ℕ → Fin k → ℝ)\n        (R : ℝ), (∀ n, d.IsHeldSolution α (p n) (u n) (G n) (H n) (P n) (κ n)) →\n        (∀ n, d.size (G n) (H n) (κ n) ≤ R) →\n        ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∃ u₀ G₀ H₀ P₀, d.IsLinearState α q u₀ G₀ H₀ P₀ ∧\n          (∀ ε : ℝ, 0 < ε → ∀ᶠ n in Filter.atTop, d.energy G₀ H₀ ≤ d.energy (G (φ n)) (H (φ n)) + ε) ∧\n          (∀ E : Space → (Space →L[ℝ] Space), AEStronglyMeasurable E volume →\n            Integrable (fun y => entrySq (E y)) →\n            Filter.Tendsto (fun n => ∫ y, entryInner (G (φ n) y) (E y)) Filter.atTop\n              (nhds (∫ y, entryInner (G₀ y) (E y)))) ∧\n          ∀ ζ : Space → Space, IsSolenoidalL2 ζ →\n            Filter.Tendsto (fun n => ∫ y, inner ℝ\n              (d.heldResidual α (p (φ n)) (u (φ n)) (G (φ n)) (H (φ n)) (P (φ n)) 0 y) (ζ y))\n              Filter.atTop (nhds (∫ y, inner ℝ (d.heldResidual α q u₀ G₀ H₀ P₀ 0 y) (ζ y)))\n\n\nend SteadyCert\n\nend Breakdown\n"}