lse,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"AdjointPotentialFacts","signature_end_line":110,"sorry":false,"statement_used_by":["Breakdown.AdjointDefect.AdjointDefectBridgeHolds","Breakdown.AdjointDefect.AdjointPotentialFacts.pins","Breakdown.AdjointDefect.AdjointPotentialFacts.potentials","Breakdown.CellLayerSystem.adjointPotentialFacts_of_parts"],"statement_uses":["Breakdown.AdjointDefect.AdjointDefectEntry","Breakdown.AdjointDefect.AdjointDefectEntry.centrePotential","Breakdown.AdjointDefect.AdjointDefectEntry.fittedPotential","Breakdown.AdjointDefect.AdjointDefectEntry.fittedSet","Breakdown.AdjointDefect.IsPinData","Breakdown.AdjointDefect.IsPotentialData","Breakdown.ExtendedCertificateData"],"used_by":["Breakdown.AdjointDefect.AdjointDefectBridgeHolds","Breakdown.AdjointDefect.AdjointPotentialFacts.pins","Breakdown.AdjointDefect.AdjointPotentialFacts.potentials","Breakdown.CellLayerSystem.adjointPotentialFacts_of_parts"],"uses":["Breakdown.AdjointDefect.AdjointDefectEntry","Breakdown.AdjointDefect.AdjointDefectEntry.centrePotential","Breakdown.AdjointDefect.AdjointDefectEntry.fittedPotential","Breakdown.AdjointDefect.AdjointDefectEntry.fittedSet","Breakdown.AdjointDefect.IsPinData","Breakdown.AdjointDefect.IsPotentialData","Breakdown.ExtendedCertificateData"],"written":"AdjointPotentialFacts"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":112,"kind":"def","line":111,"module":"Breakdown.CellReduction.AdjointStatements","name":"Breakdown.AdjointDefect.AdjointPotentialFacts.potentials","namespace":"Breakdown.AdjointDefect.AdjointPotentialFacts","noncomputable":false,"parent":"Breakdown.AdjointDefect.AdjointPotentialFacts","private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"potentials","signature_end_line":111,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.AdjointDefect.AdjointDefectEntry","Breakdown.AdjointDefect.AdjointDefectEntry.centrePotential","Breakdown.AdjointDefect.AdjointDefectEntry.fittedPotential","Breakdown.AdjointDefect.AdjointDefectEntry.fittedSet","Breakdown.AdjointDefect.AdjointPotentialFacts","Breakdown.AdjointDefect.IsPotentialData","Breakdown.ExtendedCertificateData"],"used_by":[],"uses":["Breakdown.AdjointDefect.AdjointDefectEntry","Breakdown.AdjointDefect.AdjointDefectEntry.centrePotential","Breakdown.AdjointDefect.AdjointDefectEntry.fittedPotential","Breakdown.AdjointDefect.AdjointDefectEntry.fittedSet","Breakdown.AdjointDefect.AdjointPotentialFacts","Breakdown.AdjointDefect.IsPotentialData","Breakdown.ExtendedCertificateData"],"written":"potentials"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":113,"kind":"def","line":113,"module":"Breakdown.CellReduction.AdjointStatements","name":"Breakdown.AdjointDefect.AdjointPotentialFacts.pins","namespace":"Breakdown.AdjointDefect.AdjointPotentialFacts","noncomputable":false,"parent":"Breakdown.AdjointDefect.AdjointPotentialFacts","private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"pins","signature_end_line":113,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.AdjointDefect.AdjointDefectEntry","Breakdown.AdjointDefect.AdjointDefectEntry.pins","Breakdown.AdjointDefect.AdjointPotentialFacts","Breakdown.AdjointDefect.IsPinData","Breakdown.ExtendedCertificateData","Breakdown.ExtendedCertificateData.pin"],"used_by":[],"uses":["Breakdown.AdjointDefect.AdjointDefectEntry","Breakdown.AdjointDefect.AdjointDefectEntry.pins","Breakdown.AdjointDefect.AdjointPotentialFacts","Breakdown.AdjointDefect.IsPinData","Breakdown.ExtendedCertificateData","Breakdown.ExtendedCertificateData.pin"],"written":"pins"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":127,"kind":"def","line":115,"module":"Breakdown.CellReduction.AdjointStatements","name":"Breakdown.AdjointDefect.AdjointDefectBridgeHolds","namespace":"Breakdown.AdjointDefect","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"AdjointDefectBridgeHolds","signature_end_line":115,"sorry":false,"statement_used_by":["Breakdown.AdjointDefect.adjointDefectBridge_of_parts","Breakdown.AdjointDefect.adjointDefectBridge_of_pieces","Breakdown.CellLayerSystem.breakdownOnSpace_of_cell_system_condition_of_parts","Breakdown.CellLayerSystem.isExtendedCertificate_of_parts"],"statement_uses":["Breakdown.AdjointDefect.AdjointDefectBounded","Breakdown.AdjointDefect.AdjointDefectEntry","Breakdown.AdjointDefect.AdjointDefectStructure","Breakdown.AdjointDefect.AdjointPotentialFacts","Breakdown.ExtendedCertificateData","Breakdown.ExtendedCertificateData.actuator","Breakdown.ExtendedCertificateData.adjoint","Breakdown.ExtendedCertificateData.adjointDefect","Breakdown.ExtendedCertificateData.adjointSet","Breakdown.ExtendedCertificateData.coupling","Breakdown.ExtendedCertificateData.params","Breakdown.ExtendedCertificateData.period","Breakdown.ExtendedCertificateData.pin","Breakdown.ExtendedCertificateData.profile","Breakdown.ExtendedCertificateData.symmetries","Breakdown.ExtendedCertificateData.weight","Breakdown.ExtendedCertificateData.weightFn","Breakdown.IsPerturbation","Breakdown.IsRightSide","Breakdown.IsTimePeriodic","Breakdown.Space","Breakdown.periodLIntegral","Breakdown.periodPairing","Breakdown.pinValue","Breakdown.weightedEnergy"],"used_by":["Breakdown.AdjointDefect.adjointDefectBridge_of_parts","Breakdown.AdjointDefect.adjointDefectBridge_of_pieces","Breakdown.CellLayerSystem.breakdownOnSpace_of_cell_system_condition_of_parts","Breakdown.CellLayerSystem.isExtendedCertificate_of_parts"],"uses":["Breakdown.AdjointDefect.AdjointDefectBounded","Breakdown.AdjointDefect.AdjointDefectEntry","Breakdown.AdjointDefect.AdjointDefectStructure","Breakdown.AdjointDefect.AdjointPotentialFacts","Breakdown.ExtendedCertificateData","Breakdown.ExtendedCertificateData.actuator","Breakdown.ExtendedCertificateData.adjoint","Breakdown.ExtendedCertificateData.adjointDefect","Breakdown.ExtendedCertificateData.adjointSet","Breakdown.ExtendedCertificateData.coupling","Breakdown.ExtendedCertificateData.params","Breakdown.ExtendedCertificateData.period","Breakdown.ExtendedCertificateData.pin","Breakdown.ExtendedCertificateData.profile","Breakdown.ExtendedCertificateData.symmetries","Breakdown.ExtendedCertificateData.weight","Breakdown.ExtendedCertificateData.weightFn","Breakdown.IsPerturbation","Breakdown.IsRightSide","Breakdown.IsTimePeriodic","Breakdown.Space","Breakdown.periodLIntegral","Breakdown.periodPairing","Breakdown.pinValue","Breakdown.weightedEnergy"],"written":"AdjointDefectBridgeHolds"}],"imports":["Breakdown.CellReduction.AdjointEntryDefs","Breakdown.CertCell.StatementDefs"],"module":"Breakdown.CellReduction.AdjointStatements","path":"Breakdown/CellReduction/AdjointStatements.lean","sha256":"46fca1fdf8a00854351389749854d8d3b1aed2b666017b24cd3c28d42524cdf7","source":"import Breakdown.CellReduction.AdjointEntryDefs\nimport Breakdown.CertCell.StatementDefs\n\nopen scoped ContDiff ENNReal\nopen MeasureTheory Filter\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace AdjointDefect\n\ndef mixedNorm (f : ℝ → Space → Space) : ℝ≥0∞ :=\n  ∫⁻ σ, (∫⁻ y, ENNReal.ofReal (‖f σ y‖ ^ (6 / 5 : ℝ))) ^ (5 / 3 : ℝ)\n\ndef timeCutoff (ψ : ℝ → ℝ) (ζ : ℝ → Space → Space) (s : ℝ) (y : Space) : Space := ψ s • ζ s y\n\ndef CurlPotentialExistsHolds : Prop :=\n  ∀ (C γ : ℝ) (ζ : ℝ → Space → Space),\n    IsAdjointField ζ C γ → ∃ (A : ℝ → Space → Space) (C' β : ℝ), IsCurlPotential ζ A C' β\n\ndef TestFieldDensityHolds : Prop :=\n  ∀ (C γ β : ℝ) (ζ A : ℝ → Space → Space) (ψ : ℝ → ℝ),\n    IsAdjointField ζ C γ → IsCurlPotential ζ A C β → ContDiff ℝ ∞ ψ → HasCompactSupport ψ →\n    ∃ φ : ℕ → ℝ → Space → Space, (∀ n, IsSpaceTimeTestField (φ n)) ∧\n      (∃ a b : ℝ, ∀ n s y, s ∉ Set.Icc a b → φ n s y = 0) ∧\n      Tendsto (fun n => ∫⁻ z : ℝ × Space,\n        ENNReal.ofReal (‖φ n z.1 z.2 - timeCutoff ψ ζ z.1 z.2‖ ^ 2)) atTop (nhds 0) ∧\n      Tendsto (fun n => ∫⁻ z : ℝ × Space,\n        ENNReal.ofReal (matSq (fderiv ℝ (φ n z.1) z.2 - fderiv ℝ (timeCutoff ψ ζ z.1) z.2))) atTop (nhds 0) ∧\n      Tendsto (fun n => mixedNorm (fun s y => φ n s y - timeCutoff ψ ζ s y)) atTop (nhds 0) ∧\n      Tendsto (fun n => mixedNorm (fun s y =>\n        timeDerivative (φ n) s y - timeDerivative (timeCutoff ψ ζ) s y)) atTop (nhds 0) ∧\n      Tendsto (fun n => mixedNorm (fun s y =>\n        fderiv ℝ (φ n s) y y - fderiv ℝ (timeCutoff ψ ζ s) y y)) atTop (nhds 0)\n\ndef RepresentationHolds : Prop :=\n  ∀ {k : ℕ} (Γ : Set Symmetry) (P D C γ β : ℝ) (W ζ A : ℝ → Space → Space)\n    (b : Fin k → ℝ → Space → Space)\n    (v g F : ℝ → Space → Space) (G : ℝ → Space → (Space →L[ℝ] Space))\n    (H : ℝ → Space → (Space →L[ℝ] Space →L[ℝ] Space)),\n    IsFlowPiece W D → IsAdjointField ζ C γ → IsCurlPotential ζ A C β →\n    IsPerturbation Γ P v G H g →\n    AEStronglyMeasurable (fun z : ℝ × Space => F z.1 z.2) volume → IsTimePeriodic F →\n    periodLIntegral (fun σ y => ‖F σ y‖ ^ 2) < ⊤ →\n    IsRightSide W b 0 v G g F →\n    periodPairing F ζ = ∫ σ in Set.Icc (0 : ℝ) 1, ∫ y,\n      (inner ℝ (v σ y) (adjointTransport P W ζ σ y) + matInner (G σ y) (fderiv ℝ (ζ σ) y))\n\ndef PotentialBoundHolds : Prop :=\n  ∀ (Γ : Set Symmetry) (P w₀ C γ : ℝ) (v g T : ℝ → Space → Space)\n    (G : ℝ → Space → (Space →L[ℝ] Space)) (H : ℝ → Space → (Space →L[ℝ] Space →L[ℝ] Space))\n    (K : ℝ → Space → (Space →L[ℝ] Space)) (p : PotentialData) (n : PotentialNumbers),\n    0 < w₀ → IsPerturbation Γ P v G H g → IsResidualField T K C γ → IsPotentialData p C →\n    PotentialNorms p n → RemainderDualBound (remainderField w₀ T K p) n.remainder →\n    |periodInnerIntegral v T + periodMatrixIntegral G K| ≤\n      potentialDefect w₀ n * Real.sqrt (weightedEnergy (fun _ => w₀) G H)\n\ndef RemainderPlainHolds : Prop :=\n  ∀ (R : ℝ → Space → Space) (ρ : ℝ), RemainderBounded R ρ → RemainderDualBound R ρ\n\ndef RemainderAzimuthalHolds : Prop :=\n  ∀ (R : ℝ → Space → Space) (ρ : ℝ), AzimuthalBounded R ρ → RemainderDualBound R ρ\n\ndef DualBoundedBoundHolds : Prop :=\n  ∀ (R : ℝ → Space → Space) (ρ : ℝ), DualBounded R ρ → RemainderDualBound R ρ\n\ndef PinChargeHolds : Prop :=\n  ∀ {k : ℕ} (Γ : Set Symmetry) (P w₀ C R₀ ε ρ cn : ℝ) (v g : ℝ → Space → Space)\n    (G : ℝ → Space → (Space →L[ℝ] Space)) (H : ℝ → Space → (Space →L[ℝ] Space →L[ℝ] Space))\n    (χ : Fin k → ℝ → Space → (Space →L[ℝ] Space)) (pd : PinData k) (c : Fin k → ℝ),\n    0 < w₀ → IsPerturbation Γ P v G H g → IsPinData χ pd C R₀ →\n    (∀ l, periodLIntegral (fun σ y => matSq (χ l σ y)) < ⊤) → 0 ≤ ε → 0 ≤ ρ →\n    Real.sqrt (∑ l, c l ^ 2) ≤ cn →\n    periodLIntegral (fun σ y => ‖∑ l, c l • (pd.potential l σ y - pd.generator l σ y)‖ ^ 2) ≤\n      ENNReal.ofReal (ε ^ 2) →\n    periodLIntegral (fun σ y => matSq (∑ l, c l • (χ l σ y - fderiv ℝ (pd.potential l σ) y))) ≤\n      ENNReal.ofReal (ρ ^ 2 * ∑ l, c l ^ 2) →\n    |(∑ l, c l * pinValue (χ l) G)\n        - ∑ l, c l * periodMatrixIntegral G (fun σ y =>\n          fderiv ℝ (pd.generator l σ) y - ContinuousLinearMap.adjoint (fderiv ℝ (pd.generator l σ) y))| ≤\n      (ε + cn * ρ / Real.sqrt w₀) * Real.sqrt (weightedEnergy (fun _ => w₀) G H)\n\ndef FreeShiftBoundHolds : Prop :=\n  ∀ {k : ℕ} (Γ : Set Symmetry) (P D C γ : ℝ) (v g ζ : ℝ → Space → Space)\n    (G : ℝ → Space → (Space →L[ℝ] Space)) (H : ℝ → Space → (Space →L[ℝ] Space →L[ℝ] Space))\n    (S : Finset (Fin k))\n    (f : Fin k → ℝ → Space → Space) (q ϱ δ : Fin k → ℝ) (ν μ : ℝ),\n    IsPerturbation Γ P v G H g → IsAdjointField ζ C γ →\n    (∀ i ∈ S, IsFlowPiece (f i) D) → (∀ i ∈ S, 0 < ϱ i) → (∀ i ∈ S, 0 ≤ δ i) → 0 ≤ ν → 0 ≤ μ →\n    periodLIntegral (fun σ y => (∑ i ∈ S, ϱ i * ‖f i σ y‖ ^ 2) * ‖ζ σ y‖ ^ 2) ≤ ENNReal.ofReal (ν ^ 2) →\n    (∀ i ∈ S, RemainderDualBound (fun σ y => transposeApply (fderiv ℝ (f i σ) y) (ζ σ y)) (δ i)) →\n    ∑ i ∈ S, ϱ i * δ i ^ 2 ≤ μ ^ 2 →\n    |periodInnerIntegral v (advectionShift (fun σ y => ∑ i ∈ S, q i • f i σ y) ζ)| ≤\n      Real.sqrt (∑ i ∈ S, q i ^ 2 / ϱ i) * (ν + μ) * gradientNorm G\n\nstructure AdjointDefectStructure {k : ℕ} (d : ExtendedCertificateData k) (j : Fin k)\n    (r : AdjointDefectEntry k) : Prop where\n  adjoint_eq : ∀ q ∈ d.params, d.adjoint j q = r.field\n  coupling_eq : ∀ q ∈ d.params, ∀ l, d.coupling q j l = r.pinCoef l\n  field_class : ∃ C γ, IsAdjointField r.field C γ\n  field_potential : ∃ A C β, IsCurlPotential r.field A C β\n  pieces : ∃ D, (∀ q ∈ d.params, IsFlowPiece (r.centre q) D) ∧ (∀ i ∈ r.fittedSet, IsFlowPiece (r.fitted i) D) ∧\n    ∀ q ∈ d.params, ∀ i ∈ r.fittedSetᶜ, IsFlowPiece (r.free q i) D\n  profile_split : ∀ q ∈ d.params, ∀ σ y, d.profile q σ y = r.centre q σ y\n    + (∑ i ∈ r.fittedSet, q i • r.fitted i σ y) + ∑ i ∈ r.fittedSetᶜ, q i • r.free q i σ y\n  period_split : ∀ q ∈ d.params, 1 / d.period q = 1 / r.centrePeriod + ∑ i, q i * r.periodRate i\n\nstructure AdjointPotentialFacts {k : ℕ} (d : ExtendedCertificateData k) (j : Fin k)\n    (r : AdjointDefectEntry k) : Prop where\n  potentials : ∃ C, IsPotentialData r.centrePotential C ∧\n    ∀ i ∈ r.fittedSet, IsPotentialData (r.fittedPotential i) C\n  pins : ∃ C R₀, IsPinData d.pin r.pins C R₀\n\ndef AdjointDefectBridgeHolds : Prop :=\n  ∀ {k : ℕ} (d : ExtendedCertificateData k) (r : Fin k → AdjointDefectEntry k),\n    d.weightFn = (fun _ => d.weight) → 0 < d.weight →\n    (∀ j ∈ d.adjointSet, AdjointDefectStructure d j (r j)) →\n    (∀ j ∈ d.adjointSet, AdjointPotentialFacts d j (r j)) →\n    (∀ j ∈ d.adjointSet, AdjointDefectBounded d j (r j)) →\n    ∀ j ∈ d.adjointSet, ∀ q ∈ d.params, ∀ v G H g,\n      IsPerturbation d.symmetries (d.period q) v G H g → ∀ F : ℝ → Space → Space,\n        AEStronglyMeasurable (fun z : ℝ × Space => F z.1 z.2) volume → IsTimePeriodic F →\n        periodLIntegral (fun σ y => ‖F σ y‖ ^ 2) < ⊤ →\n        IsRightSide (d.profile q) d.actuator 0 v G g F →\n        |periodPairing F (d.adjoint j q) - ∑ l, d.coupling q j l * pinValue (d.pin l) G| ≤\n          d.adjointDefect j * Real.sqrt (weightedEnergy d.weightFn G H)\n\nend AdjointDefect\n\nend Breakdown\n"}