etDataValid","Breakdown.CertCell.GivenShape.Internal.conjReflectFixed_of_realCoef","Breakdown.CertCell.GivenShape.Internal.joinedSpline_of_jetClass","Breakdown.CertCell.GivenShape.Internal.label_fst_eq_zero_of_negKey_eq","Breakdown.CertCell.GivenShape.Internal.splineAgrees_conj_of_reflect_fixed","Breakdown.CertCell.GivenShape.IsGivenJetData.typeTwo_odd","Breakdown.CertCell.GivenShape.IsGivenJetData.typeTwo_start","Breakdown.CertCell.GivenShape.IsGivenJetData.typeTwo_symmetric","Breakdown.CertCell.GivenShape.IsJetClass.t_axis","Breakdown.CertCell.GivenShape.IsJetClass.x_axis","Breakdown.CertCell.GivenShape.JetConjReflection","Breakdown.CertCell.GivenShape.JetReflection","Breakdown.CertCell.GivenShape.JetSplineJoined","Breakdown.CertCell.GivenShape.JetStartVanish","Breakdown.CertCell.GivenShape.SplineAgreementRules"],"written":"givenJetDataValid_of"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":90,"kind":"theorem","line":89,"module":"Breakdown.CertCell.ShapeJetValid","name":"Breakdown.CertCell.GivenShape.givenJetDataValid_of_parts","namespace":"Breakdown.CertCell.GivenShape","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":["Breakdown.CertCell.GivenShape.ShapeParts.agreement_rules","Breakdown.CertCell.GivenShape.ShapeParts.jet_conj_reflection","Breakdown.CertCell.GivenShape.ShapeParts.jet_joined","Breakdown.CertCell.GivenShape.ShapeParts.jet_reflection","Breakdown.CertCell.GivenShape.ShapeParts.jet_start","Breakdown.CertCell.GivenShape.givenJetDataValid_of"],"protected":false,"short":"givenJetDataValid_of_parts","signature_end_line":89,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CertCell.GivenShape.GivenJetDataValid","Breakdown.CertCell.GivenShape.ShapeParts"],"used_by":[],"uses":["Breakdown.CertCell.GivenShape.GivenJetDataValid","Breakdown.CertCell.GivenShape.ShapeParts","Breakdown.CertCell.GivenShape.ShapeParts.agreement_rules","Breakdown.CertCell.GivenShape.ShapeParts.jet_conj_reflection","Breakdown.CertCell.GivenShape.ShapeParts.jet_joined","Breakdown.CertCell.GivenShape.ShapeParts.jet_reflection","Breakdown.CertCell.GivenShape.ShapeParts.jet_start","Breakdown.CertCell.GivenShape.givenJetDataValid_of"],"written":"givenJetDataValid_of_parts"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":94,"kind":"theorem","line":92,"module":"Breakdown.CertCell.ShapeJetValid","name":"Breakdown.CertCell.GivenShape.givenJetDataValid","namespace":"Breakdown.CertCell.GivenShape","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CertCell.GivenShape.jetParts_closed"],"proof_uses":["Breakdown.CertCell.GivenShape.givenJetDataValid_of","Breakdown.CertCell.GivenShape.jetConjReflection_of_jetReflection","Breakdown.CertCell.GivenShape.jetReflection","Breakdown.CertCell.GivenShape.jetSplineJoined","Breakdown.CertCell.GivenShape.jetStartVanish","Breakdown.CertCell.GivenShape.splineAgreementRules"],"protected":false,"short":"givenJetDataValid","signature_end_line":92,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CertCell.GivenShape.GivenJetDataValid"],"used_by":["Breakdown.CertCell.GivenShape.jetParts_closed"],"uses":["Breakdown.CertCell.GivenShape.GivenJetDataValid","Breakdown.CertCell.GivenShape.givenJetDataValid_of","Breakdown.CertCell.GivenShape.jetConjReflection_of_jetReflection","Breakdown.CertCell.GivenShape.jetReflection","Breakdown.CertCell.GivenShape.jetSplineJoined","Breakdown.CertCell.GivenShape.jetStartVanish","Breakdown.CertCell.GivenShape.splineAgreementRules"],"written":"givenJetDataValid"}],"imports":["Breakdown.CertCell.ShapeJetEntry","Breakdown.CertCell.ShapeJetJoin","Breakdown.CertCell.ShapeJetReflect","Breakdown.CertCell.ShapeJetConjReflect","Breakdown.CertCell.ShapeJetStart","Breakdown.CertCell.ShapeSplineAgree"],"module":"Breakdown.CertCell.ShapeJetValid","path":"Breakdown/CertCell/ShapeJetValid.lean","sha256":"8ca61e7b354682e4bd87eea6fc1506a6bf76ce220f5316b6a9df84067c108e8f","source":"import Breakdown.CertCell.ShapeJetEntry\nimport Breakdown.CertCell.ShapeJetJoin\nimport Breakdown.CertCell.ShapeJetReflect\nimport Breakdown.CertCell.ShapeJetConjReflect\nimport Breakdown.CertCell.ShapeJetStart\nimport Breakdown.CertCell.ShapeSplineAgree\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace CertCell\n\nnamespace GivenShape\n\nopen CellCert.GivenFields (Spline)\n\nnamespace Internal\n\ntheorem joinedSpline_mono_of_le {a b a' b' : ℕ} {S : Spline} (h : IsJoinedSpline a b S) (ha : a' ≤ a) (hb : b' ≤ b) :\n    IsJoinedSpline a' b' S :=\n  ⟨h.mesh, fun i hi hi' j hj o ho => h.t_joins i hi hi' j hj o (ho.trans ha),\n    fun j hj hj' i hi o ho => h.x_joins j hj hj' i hi o (ho.trans hb)⟩\n\ntheorem joinedSpline_of_jetClass (hJ : JetSplineJoined) {a b : ℕ} {H : JetSpline} (h : IsJetClass a b H) :\n    IsJoinedSpline a b H.toSpline :=\n  joinedSpline_mono_of_le (hJ H h.t_axis h.x_axis) (by have := h.t_depth; omega) (by have := h.x_depth; omega)\n\ntheorem conjReflectFixed_of_realCoef {odd : Bool} {H : JetSpline} (hr : H.HasRealCoef)\n    (h : H.IsReflectFixed odd) : H.IsConjReflectFixed odd := fun d e he => by\n  rw [h d e he, hr d e]\n\ntheorem label_fst_eq_zero_of_negKey_eq {κ : FieldKey} (h : κ.negKey = κ) : κ.label.1 = 0 := by\n  have h1 := congrArg (fun κ : FieldKey => κ.label.1) h\n  simp only [FieldKey.negKey, Prod.fst_neg] at h1\n  omega\n\ntheorem splineAgrees_conj_of_reflect_fixed (hA : SplineAgreementRules) {odd : Bool} {S : Spline}\n    (h1 : SplineAgrees S (reflectSpline odd S)) (h2 : SplineAgrees S (reflectSpline odd S.conj)) :\n    SplineAgrees S S.conj := by\n  have h3 : SplineAgrees (reflectSpline odd S) (reflectSpline odd (reflectSpline odd S.conj)) :=\n    ((hA 0 0 odd S (reflectSpline odd S.conj) S).2.2.2.1 h2).2\n  have h4 : SplineAgrees (reflectSpline odd (reflectSpline odd S.conj)) S.conj :=\n    (hA 0 0 odd S.conj S S).2.2.2.2.2.1\n  have h5 : SplineAgrees (reflectSpline odd S) S.conj :=\n    (hA 0 0 odd (reflectSpline odd S) (reflectSpline odd (reflectSpline odd S.conj)) S.conj).2.2.1 h3 h4\n  exact (hA 0 0 odd S (reflectSpline odd S) S.conj).2.2.1 h1 h5\n\nend Internal\n\ntheorem givenJetDataValid_of (hJ : JetSplineJoined) (hR : JetReflection) (hC : JetConjReflection)\n    (hS : JetStartVanish) (hA : SplineAgreementRules) : GivenJetDataValid := by\n  intro J hJd\n  exact\n    { one_per_orbit := hJd.one_per_orbit\n      radial_class := fun κ hκ h0 => Internal.joinedSpline_of_jetClass hJ (hJd.radial_class κ hκ h0)\n      polar_class := fun κ hκ h0 => Internal.joinedSpline_of_jetClass hJ (hJd.polar_class κ hκ h0)\n      lowOrder_ge := hJd.lowOrder_ge\n      stream_class := fun κ hκ h0 => Internal.joinedSpline_of_jetClass hJ (hJd.stream_class κ hκ h0)\n      swirl_class := fun κ hκ h0 => Internal.joinedSpline_of_jetClass hJ (hJd.swirl_class κ hκ h0)\n      stream_origin := fun κ hκ h0 =>\n        hS _ (hJd.stream_class κ hκ h0).t_axis (hJd.stream_class κ hκ h0).x_axis (hJd.typeTwo_start κ hκ h0).1\n      swirl_origin := fun κ hκ h0 =>\n        hS _ (hJd.swirl_class κ hκ h0).t_axis (hJd.swirl_class κ hκ h0).x_axis (hJd.typeTwo_start κ hκ h0).2\n      highOrder_pos := hJd.highOrder_pos\n      stream_odd := fun κ hκ h0 =>\n        hR true _ (hJd.stream_class κ hκ h0).t_axis (hJd.stream_class κ hκ h0).x_axis\n          (hJd.typeTwo_symmetric κ hκ h0).1 (hJd.typeTwo_odd κ hκ h0).1\n      swirl_odd := fun κ hκ h0 =>\n        hR true _ (hJd.swirl_class κ hκ h0).t_axis (hJd.swirl_class κ hκ h0).x_axis\n          (hJd.typeTwo_symmetric κ hκ h0).2 (hJd.typeTwo_odd κ hκ h0).2\n      self_conj := fun κ hκ hneg => by\n        have h0 := Internal.label_fst_eq_zero_of_negKey_eq hneg\n        obtain ⟨hrs, hrw, hax⟩ := hJd.self_conj κ hκ hneg\n        obtain ⟨hss, hsw⟩ := hJd.typeTwo_symmetric κ hκ h0\n        obtain ⟨hos, how⟩ := hJd.typeTwo_odd κ hκ h0\n        have cs := hJd.stream_class κ hκ h0\n        have cw := hJd.swirl_class κ hκ h0\n        exact ⟨Internal.splineAgrees_conj_of_reflect_fixed hA (hR true _ cs.t_axis cs.x_axis hss hos)\n            (hC true _ cs.t_axis cs.x_axis hss (Internal.conjReflectFixed_of_realCoef hrs hos)),\n          Internal.splineAgrees_conj_of_reflect_fixed hA (hR true _ cw.t_axis cw.x_axis hsw how)\n            (hC true _ cw.t_axis cw.x_axis hsw (Internal.conjReflectFixed_of_realCoef hrw how)), hax⟩\n      self_conj_flip := fun κ hκ h0 hfn => by\n        obtain ⟨hsr, hsp, hcr, hcp⟩ := hJd.self_conj_flip κ hκ h0 hfn\n        have cr := hJd.radial_class κ hκ h0\n        have cp := hJd.polar_class κ hκ h0\n        exact ⟨hC false _ cr.t_axis cr.x_axis hsr hcr, hC true _ cp.t_axis cp.x_axis hsp hcp⟩ }\n\ntheorem givenJetDataValid_of_parts (h : ShapeParts) : GivenJetDataValid :=\n  givenJetDataValid_of h.jet_joined h.jet_reflection h.jet_conj_reflection h.jet_start h.agreement_rules\n\ntheorem givenJetDataValid : GivenJetDataValid :=\n  givenJetDataValid_of jetSplineJoined jetReflection (jetConjReflection_of_jetReflection jetReflection)\n    jetStartVanish splineAgreementRules\n\nend GivenShape\n\nend CertCell\n\nend Breakdown\n"}