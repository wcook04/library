QuarticQuery.Upper.markFlags"],"used_by":["QuarticQuery.Upper.markGate"],"uses":["QuarticQuery.Upper.markFlags"],"written":"markFlags_involutive"},{"dependency_source":"lean_report","doc":"Route according to immutable flags. The flag register also serves as the\nselection record; no separate `J` register is required.","end_line":111,"kind":"def","line":89,"module":"QuarticQuery.Upper.RouteRegister","name":"QuarticQuery.Upper.routeWithFlags","namespace":"QuarticQuery.Upper","noncomputable":false,"private":false,"proof_used_by":["QuarticQuery.Upper.assembledSuccess_apply","QuarticQuery.Upper.assembledSuccess_norm_sum"],"proof_uses":[],"protected":false,"short":"routeWithFlags","signature_end_line":91,"statement_used_by":["QuarticQuery.Upper.routeFlagsGate"],"statement_uses":["QuarticQuery.Upper.RouteData","QuarticQuery.Upper.firstSuccess","QuarticQuery.Upper.routeAt"],"used_by":["QuarticQuery.Upper.assembledSuccess_apply","QuarticQuery.Upper.assembledSuccess_norm_sum","QuarticQuery.Upper.routeFlagsGate"],"uses":["QuarticQuery.Upper.RouteData","QuarticQuery.Upper.firstSuccess","QuarticQuery.Upper.routeAt"],"written":"routeWithFlags"},{"dependency_source":"lean_report","doc":"The marker is a query-free gate, as is the first-success routing.","end_line":119,"kind":"def","line":114,"module":"QuarticQuery.Upper.RouteRegister","name":"QuarticQuery.Upper.markGate","namespace":"QuarticQuery.Upper","noncomputable":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"markGate","signature_end_line":117,"statement_used_by":[],"statement_uses":["QuarticQuery.Upper.Reg","QuarticQuery.Upper.markFlags","QuarticQuery.Upper.markFlags_involutive","QuarticQuery.Upper.regCongr"],"used_by":[],"uses":["QuarticQuery.Upper.Reg","QuarticQuery.Upper.markFlags","QuarticQuery.Upper.markFlags_involutive","QuarticQuery.Upper.regCongr"],"written":"markGate"},{"dependency_source":"lean_report","doc":null,"end_line":124,"kind":"def","line":121,"module":"QuarticQuery.Upper.RouteRegister","name":"QuarticQuery.Upper.routeFlagsGate","namespace":"QuarticQuery.Upper","noncomputable":true,"private":false,"proof_used_by":["QuarticQuery.Upper.ampCircuit_isCirc","QuarticQuery.Upper.ampCircuit_state","QuarticQuery.Upper.assembledSuccess_apply"],"proof_uses":[],"protected":false,"short":"routeFlagsGate","signature_end_line":123,"statement_used_by":["QuarticQuery.Upper.ampCircuit","QuarticQuery.Upper.assembledTrials"],"statement_uses":["QuarticQuery.Upper.Reg","QuarticQuery.Upper.RouteData","QuarticQuery.Upper.regCongr","QuarticQuery.Upper.routeWithFlags"],"used_by":["QuarticQuery.Upper.ampCircuit","QuarticQuery.Upper.ampCircuit_isCirc","QuarticQuery.Upper.ampCircuit_state","QuarticQuery.Upper.assembledSuccess_apply","QuarticQuery.Upper.assembledTrials"],"uses":["QuarticQuery.Upper.Reg","QuarticQuery.Upper.RouteData","QuarticQuery.Upper.regCongr","QuarticQuery.Upper.routeWithFlags"],"written":"routeFlagsGate"},{"dependency_source":"lean_report","doc":"Routing is a query-free gate on any finite trial register basis.","end_line":130,"kind":"def","line":127,"module":"QuarticQuery.Upper.RouteRegister","name":"QuarticQuery.Upper.routeGate","namespace":"QuarticQuery.Upper","noncomputable":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"routeGate","signature_end_line":129,"statement_used_by":[],"statement_uses":["QuarticQuery.Upper.Reg","QuarticQuery.Upper.RouteData","QuarticQuery.Upper.regCongr","QuarticQuery.Upper.routeWithRecord"],"used_by":[],"uses":["QuarticQuery.Upper.Reg","QuarticQuery.Upper.RouteData","QuarticQuery.Upper.regCongr","QuarticQuery.Upper.routeWithRecord"],"written":"routeGate"}],"imports":["QuarticQuery.Upper.Circuit"],"module":"QuarticQuery.Upper.RouteRegister","path":"QuarticQuery/Upper/RouteRegister.lean","sha256":"2372fb469e3114311f73b2d31a69105f5cb32944be650358d227bbdeb025dfd6","source":"module\n\npublic import QuarticQuery.Upper.Circuit\n\n/-!\nThe fixed original register and the immutable first-success selection record.\nThe rest of the auxiliary history may be\ncarried as an additional product factor and left untouched by `regCongr`.\n-/\n\n@[expose] public section\n\nnamespace QuarticQuery.Upper\n\n/-- Designated original register followed by all complete trial registers. -/\nabbrev RouteData (N : ℕ) (Z : Type) := Z × (Fin N → Z)\n\n/-- Swap the designated original register with trial `j`. -/\ndef routeAt {N : ℕ} {Z : Type} (j : Fin N) (p : RouteData N Z) :\n    RouteData N Z :=\n  (p.2 j, Function.update p.2 j p.1)\n\ntheorem routeAt_involutive {N : ℕ} {Z : Type} (j : Fin N) :\n    Function.Involutive (routeAt (Z := Z) j) := by\n  classical\n  intro p\n  apply Prod.ext\n  · simp [routeAt]\n  · funext i\n    by_cases h : i = j\n    · subst h\n      simp [routeAt]\n    · simp [routeAt]\n\n/-- The selected index is retained, so the route is a genuine permutation. -/\ndef routeWithRecord {N : ℕ} {Z : Type} :\n    (Option (Fin N) × RouteData N Z) ≃\n      (Option (Fin N) × RouteData N Z) where\n  toFun p := (p.1, match p.1 with\n      | none => p.2\n      | some j => routeAt j p.2)\n  invFun p := (p.1, match p.1 with\n      | none => p.2\n      | some j => routeAt j p.2)\n  left_inv := by\n      classical\n      intro p\n      rcases p with ⟨j, data⟩\n      cases j with\n      | none => rfl\n      | some j => simpa using (routeAt_involutive j data)\n  right_inv := by\n    classical\n    intro p\n    rcases p with ⟨j, data⟩\n    cases j with\n    | none => rfl\n    | some j => simpa using (routeAt_involutive j data)\n\n/-- The least marked trial in the fixed Fin order. This depends on flags only,\nso routing cannot change the decision. -/\ndef firstSuccess {N : ℕ} (flags : Fin N → Bool) : Option (Fin N) :=\n  (List.finRange N).find? (fun j => flags j)\n\ntheorem firstSuccess_some {N : ℕ} {flags : Fin N → Bool} {j : Fin N}\n    (h : firstSuccess flags = some j) : flags j = true := by\n  exact List.find?_some h\n\ntheorem firstSuccess_none_iff {N : ℕ} (flags : Fin N → Bool) :\n    firstSuccess flags = none ↔ ∀ j, flags j = false := by\n  simp [firstSuccess, List.find?_eq_none]\n\n/-- Reversible XOR marker for all trial success labels. -/\ndef markFlags {N : ℕ} {Z : Type} (S : Z → Bool)\n    (p : (Fin N → Bool) × (Fin N → Z)) :\n    (Fin N → Bool) × (Fin N → Z) :=\n  (fun j => xor (p.1 j) (S (p.2 j)), p.2)\n\ntheorem markFlags_involutive {N : ℕ} {Z : Type} (S : Z → Bool) :\n    Function.Involutive (markFlags (N := N) S) := by\n  intro p\n  apply Prod.ext\n  · funext j\n    simp [markFlags]\n  · rfl\n\n/-- Route according to immutable flags. The flag register also serves as the\nselection record; no separate `J` register is required. -/\ndef routeWithFlags {N : ℕ} {Z : Type} :\n    ((Fin N → Bool) × RouteData N Z) ≃\n      ((Fin N → Bool) × RouteData N Z) where\n  toFun p := (p.1, match firstSuccess p.1 with\n      | none => p.2\n      | some j => routeAt j p.2)\n  invFun p := (p.1, match firstSuccess p.1 with\n      | none => p.2\n      | some j => routeAt j p.2)\n  left_inv := by\n      classical\n      intro p\n      rcases p with ⟨flags, data⟩\n      cases h : firstSuccess flags with\n      | none => simp [h]\n      | some j => simpa [h] using (routeAt_involutive j data)\n  right_inv := by\n    classical\n    intro p\n    rcases p with ⟨flags, data⟩\n    cases h : firstSuccess flags with\n    | none => simp [h]\n    | some j => simpa [h] using (routeAt_involutive j data)\n\n/-- The marker is a query-free gate, as is the first-success routing. -/\nnoncomputable def markGate {N : ℕ} {Z : Type} [Fintype Z]\n    (S : Z → Bool) :\n    Reg ((Fin N → Bool) × (Fin N → Z)) ≃ₗᵢ[ℂ]\n      Reg ((Fin N → Bool) × (Fin N → Z)) :=\n  regCongr ⟨markFlags S, markFlags S, markFlags_involutive S,\n    markFlags_involutive S⟩\n\nnoncomputable def routeFlagsGate {N : ℕ} {Z : Type} [Fintype Z] :\n    Reg ((Fin N → Bool) × RouteData N Z) ≃ₗᵢ[ℂ]\n      Reg ((Fin N → Bool) × RouteData N Z) :=\n  regCongr routeWithFlags\n\n/-- Routing is a query-free gate on any finite trial register basis. -/\nnoncomputable def routeGate {N : ℕ} {Z : Type} [Fintype Z] :\n    Reg (Option (Fin N) × RouteData N Z) ≃ₗᵢ[ℂ]\n      Reg (Option (Fin N) × RouteData N Z) :=\n  regCongr routeWithRecord\n\nend QuarticQuery.Upper\n"}