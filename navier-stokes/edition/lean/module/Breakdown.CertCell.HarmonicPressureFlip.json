","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":61,"kind":"theorem","line":56,"module":"Breakdown.CertCell.HarmonicPressureFlip","name":"Breakdown.CertCell.SideTrace.Internal.HarmonicFlip.ae_slices_of_ae_prod","namespace":"Breakdown.CertCell.SideTrace.Internal.HarmonicFlip","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CertCell.SideTrace.Internal.HarmonicFlip.weighted_integral_flip"],"proof_uses":[],"protected":false,"short":"ae_slices_of_ae_prod","signature_end_line":58,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CertCell.flipPoint","Breakdown.Space"],"used_by":["Breakdown.CertCell.SideTrace.Internal.HarmonicFlip.weighted_integral_flip"],"uses":["Breakdown.CertCell.flipPoint","Breakdown.Space"],"written":"ae_slices_of_ae_prod"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":72,"kind":"theorem","line":63,"module":"Breakdown.CertCell.HarmonicPressureFlip","name":"Breakdown.CertCell.SideTrace.Internal.HarmonicFlip.weighted_integral_flip","namespace":"Breakdown.CertCell.SideTrace.Internal.HarmonicFlip","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CertCell.SideTrace.harmonicPressureFlip"],"proof_uses":["Breakdown.CertCell.SideTrace.Internal.HarmonicFlip.ae_slices_of_ae_prod","Breakdown.CertCell.SideTrace.Internal.HarmonicFlip.flipLinearEquiv","Breakdown.CertCell.SideTrace.Internal.HarmonicFlip.flipLinearEquiv_apply"],"protected":false,"short":"weighted_integral_flip","signature_end_line":66,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CertCell.flipPoint","Breakdown.Space"],"used_by":["Breakdown.CertCell.SideTrace.harmonicPressureFlip"],"uses":["Breakdown.CertCell.SideTrace.Internal.HarmonicFlip.ae_slices_of_ae_prod","Breakdown.CertCell.SideTrace.Internal.HarmonicFlip.flipLinearEquiv","Breakdown.CertCell.SideTrace.Internal.HarmonicFlip.flipLinearEquiv_apply","Breakdown.CertCell.flipPoint","Breakdown.Space"],"written":"weighted_integral_flip"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":88,"kind":"theorem","line":78,"module":"Breakdown.CertCell.HarmonicPressureFlip","name":"Breakdown.CertCell.SideTrace.harmonicPressureFlip","namespace":"Breakdown.CertCell.SideTrace","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CertCell.planeTraceFacts_closed"],"proof_uses":["Breakdown.CertCell.CellCalculus.harmonicCos","Breakdown.CertCell.CellCalculus.harmonicSin","Breakdown.CertCell.SideTrace.Internal.HarmonicFlip.flipLinearEquiv_apply","Breakdown.CertCell.SideTrace.Internal.HarmonicFlip.weighted_integral_flip"],"protected":false,"short":"harmonicPressureFlip","signature_end_line":78,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CertCell.SideTrace.HarmonicPressureFlipHolds"],"used_by":["Breakdown.CertCell.planeTraceFacts_closed"],"uses":["Breakdown.CertCell.CellCalculus.harmonicCos","Breakdown.CertCell.CellCalculus.harmonicSin","Breakdown.CertCell.SideTrace.HarmonicPressureFlipHolds","Breakdown.CertCell.SideTrace.Internal.HarmonicFlip.flipLinearEquiv_apply","Breakdown.CertCell.SideTrace.Internal.HarmonicFlip.weighted_integral_flip"],"written":"harmonicPressureFlip"}],"imports":["Breakdown.CertCell.BridgeTraceStatements"],"module":"Breakdown.CertCell.HarmonicPressureFlip","path":"Breakdown/CertCell/HarmonicPressureFlip.lean","sha256":"60be7b4a0f3235f01a08a84ba4b93c8680bd74c0a1b85d0e9beec1aaf9797340","source":"import Breakdown.CertCell.BridgeTraceStatements\n\nopen MeasureTheory\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace CertCell\n\nnamespace SideTrace\n\nnamespace Internal\n\nnamespace HarmonicFlip\n\nprivate theorem flipPoint_coord_zero (y : Space) : flipPoint y 0 = y 0 := by\n  simp [flipPoint, unitVector]\n\nprivate theorem flipPoint_coord_one (y : Space) : flipPoint y 1 = -y 1 := by\n  simp [flipPoint, unitVector]\n\nprivate theorem flipPoint_coord_two (y : Space) : flipPoint y 2 = -y 2 := by\n  simp [flipPoint, unitVector]\n\nprivate theorem flipPoint_coord (y : Space) (i : Fin 3) :\n    flipPoint y i = if i = 0 then y i else -y i := by\n  fin_cases i\n  · simp [flipPoint_coord_zero]\n  · simp [flipPoint_coord_one]\n  · simp [flipPoint_coord_two]\n\ndef flipLinearEquiv : Space ≃L[ℝ] Space :=\n  LinearEquiv.toContinuousLinearEquiv\n    { toFun := flipPoint\n      invFun := flipPoint\n      map_add' := fun x z => by\n        ext i\n        simp only [flipPoint_coord, PiLp.add_apply]\n        split_ifs <;> ring\n      map_smul' := fun c x => by\n        ext i\n        simp only [flipPoint_coord, PiLp.smul_apply, RingHom.id_apply, smul_eq_mul]\n        split_ifs <;> ring\n      left_inv := fun x => by\n        ext i\n        simp only [flipPoint_coord]\n        split_ifs <;> simp\n      right_inv := fun x => by\n        ext i\n        simp only [flipPoint_coord]\n        split_ifs <;> simp }\n\ntheorem flipLinearEquiv_apply (y : Space) : flipLinearEquiv y = flipPoint y := rfl\n\ntheorem ae_slices_of_ae_prod {f : ℝ → Space → Space}\n    (h : ∀ᵐ z : ℝ × Space, f z.1 (flipPoint z.2) = flipPoint (f z.1 z.2)) :\n    ∀ᵐ y : Space, ∀ᵐ τ : ℝ, f τ (flipPoint y) = flipPoint (f τ y) := by\n  have hs : ∀ᵐ w : Space × ℝ, f w.2 (flipPoint w.1) = flipPoint (f w.2 w.1) :=\n    (Measure.measurePreserving_swap (μ := (volume : Measure Space)) (ν := (volume : Measure ℝ))).quasiMeasurePreserving.ae h\n  exact Measure.ae_ae_of_ae_prod hs\n\ntheorem weighted_integral_flip {f : ℝ → Space → Space} (w : ℝ → ℝ)\n    (h : ∀ᵐ z : ℝ × Space, f z.1 (flipPoint z.2) = flipPoint (f z.1 z.2)) :\n    ∀ᵐ y : Space, (∫ τ in Set.Icc (0 : ℝ) 1, w τ • f τ (flipPoint y))\n      = flipPoint (∫ τ in Set.Icc (0 : ℝ) 1, w τ • f τ y) := by\n  filter_upwards [ae_slices_of_ae_prod h] with y hy\n  have hr : ∀ᵐ τ ∂(volume.restrict (Set.Icc (0 : ℝ) 1)),\n      w τ • f τ (flipPoint y) = flipLinearEquiv (w τ • f τ y) := by\n    filter_upwards [ae_restrict_of_ae hy] with τ hτ\n    rw [map_smul, flipLinearEquiv_apply, hτ]\n  rw [integral_congr_ae hr, ContinuousLinearEquiv.integral_comp_comm, flipLinearEquiv_apply]\n\nend HarmonicFlip\n\nend Internal\n\ntheorem harmonicPressureFlip : HarmonicPressureFlipHolds := by\n  intro Pg _ hflip ν\n  refine ⟨?_, ?_⟩\n  · filter_upwards [Internal.HarmonicFlip.weighted_integral_flip\n      (fun τ => Real.cos (2 * Real.pi * ν * τ)) hflip] with y hy\n    simpa only [CellCalculus.harmonicCos] using hy\n  · filter_upwards [Internal.HarmonicFlip.weighted_integral_flip\n      (fun τ => Real.sin (2 * Real.pi * ν * τ)) hflip] with y hy\n    simp only [CellCalculus.harmonicSin]\n    rw [hy, ← Internal.HarmonicFlip.flipLinearEquiv_apply, ← Internal.HarmonicFlip.flipLinearEquiv_apply,\n      map_neg]\n\nend SideTrace\n\nend CertCell\n\nend Breakdown\n"}