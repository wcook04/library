ery vertex, not merely for the logarithm of its count.","end_line":55,"kind":"theorem","line":50,"module":"PCP.Algebraic.ThreeColorParameterChoice","name":"PCP.Algebraic.ThreeColorParameterChoice.size_le_grid_capacity","namespace":"PCP.Algebraic.ThreeColorParameterChoice","noncomputable":false,"private":false,"proof_used_by":["PCP.Algebraic.ThreeColorParameterChoice.choice_spec"],"proof_uses":["PCP.Algebraic.ThreeColorParameterChoice.le_volume","PCP.Algebraic.ThreeColorParameters.grid_capacity"],"protected":false,"short":"size_le_grid_capacity","signature_end_line":52,"sorry":false,"statement_used_by":[],"statement_uses":["PCP.Algebraic.ThreeColorParameterChoice.exponent","PCP.Algebraic.ThreeColorParameters.Field","PCP.Algebraic.ThreeColorParameters.grid","PCP.Algebraic.ThreeColorParameters.size"],"used_by":["PCP.Algebraic.ThreeColorBinaryVerifier.gridGraph_colorable_iff","PCP.Algebraic.ThreeColorBinaryVerifier.vertexEmbedding","PCP.Algebraic.ThreeColorParameterChoice.choice_spec"],"uses":["PCP.Algebraic.ThreeColorParameterChoice.exponent","PCP.Algebraic.ThreeColorParameterChoice.le_volume","PCP.Algebraic.ThreeColorParameters.Field","PCP.Algebraic.ThreeColorParameters.grid","PCP.Algebraic.ThreeColorParameters.grid_capacity","PCP.Algebraic.ThreeColorParameters.size"],"written":"size_le_grid_capacity"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":"The minimal exponent loses at most a factor four compared with the requested logarithm.","end_line":76,"kind":"theorem","line":58,"module":"PCP.Algebraic.ThreeColorParameterChoice","name":"PCP.Algebraic.ThreeColorParameterChoice.volume_le","namespace":"PCP.Algebraic.ThreeColorParameterChoice","noncomputable":false,"private":false,"proof_used_by":["PCP.Algebraic.ThreeColorParameterChoice.choice_spec","PCP.Algebraic.ThreeColorParameterChoice.volume_le_log_add_one"],"proof_uses":["PCP.Algebraic.ThreeColorParameterChoice.exponent","PCP.Algebraic.ThreeColorParameterChoice.exponent_