lassical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":47,"kind":"def","line":42,"module":"Breakdown.FracCell.HeightProjBoundSt","name":"Breakdown.CellCert.CellAnalysis.ProjOrthStatement","namespace":"Breakdown.CellCert.CellAnalysis","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"ProjOrthStatement","signature_end_line":42,"sorry":false,"statement_used_by":["Breakdown.CellCert.CellAnalysis.projOrth","Breakdown.CellCert.CellAnalysis.radialTopBound_of"],"statement_uses":["Breakdown.CellCert.CellAnalysis.CellBox","Breakdown.CellCert.CellAnalysis.CellBox.lineWeight","Breakdown.CellCert.CellAnalysis.CellBox.lineWeightFn","Breakdown.CellCert.CellAnalysis.CellBox.pairOn","Breakdown.CellCert.CellAnalysis.CellBox.proj","Breakdown.CellCert.CellAnalysis.CellBox.rect","Breakdown.CellCert.CellAnalysis.IsCellBox"],"used_by":["Breakdown.CellCert.CellAnalysis.projOrth","Breakdown.CellCert.CellAnalysis.radialTopBound_of"],"uses":["Breakdown.CellCert.CellAnalysis.CellBox","Breakdown.CellCert.CellAnalysis.CellBox.lineWeight","Breakdown.CellCert.CellAnalysis.CellBox.lineWeightFn","Breakdown.CellCert.CellAnalysis.CellBox.pairOn","Breakdown.CellCert.CellAnalysis.CellBox.proj","Breakdown.CellCert.CellAnalysis.CellBox.rect","Breakdown.CellCert.CellAnalysis.IsCellBox"],"written":"ProjOrthStatement"}],"imports":["Breakdown.FracCell.VelocityTailSt"],"module":"Breakdown.FracCell.HeightProjBoundSt","path":"Breakdown/FracCell/HeightProjBoundSt.lean","sha256":"24de8d59ce5705f26d619aae1cf5d446829b591986eec214378dab33ac30fca1","source":"import Breakdown.FracCell.VelocityTailSt\n\nopen MeasureTheory\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace CellCert\n\nnamespace CellAnalysis\n\nopen SteadyCert Assembly\n\ndef LineProjSpecStatement : Prop :=\n  ∀ (a b : ℝ) (ρ : ℝ → ℝ), 0 ≤ a → a < b → (ρ = (fun _ => 1) ∨ (a = 0 ∧ ρ = id)) →\n    ∀ (d : ℕ) (f : ℝ → ℂ), AEStronglyMeasurable f (volume.restrict (Set.Icc a b)) →\n      IntegrableOn (fun r => ρ r * ‖f r‖ ^ 2) (Set.Icc a b) →\n      (∀ t : Fin (d + 1), ∫ r in Set.Icc a b, (ρ r : ℂ) * (f r - lineProj ρ a b d f r)\n          * (starRingEnd ℂ) ((r : ℂ) ^ (t : ℕ)) = 0) ∧\n      ∀ c : Fin (d + 1) → ℂ, (∀ t : Fin (d + 1), ∫ r in Set.Icc a b, (ρ r : ℂ) * (f r - ∑ j, c j * (r : ℂ) ^ (j : ℕ))\n          * (starRingEnd ℂ) ((r : ℂ) ^ (t : ℕ)) = 0) →\n        ∀ x, lineProj ρ a b d f x = ∑ j, c j * (x : ℂ) ^ (j : ℕ)\n\ndef ProjRCoeffStatement : Prop :=\n  ∀ (K : CellBox), IsCellBox K → ∀ (d : ℕ) (s : ℝ × ℝ → ℂ),\n    AEStronglyMeasurable s (volume.restrict K.rect) →\n    IntegrableOn (fun p => K.lineWeight p.1 * ‖s p‖ ^ 2) K.rect →\n      ∃ c : Fin (d + 1) → ℝ → ℂ,\n        (∀ j, AEStronglyMeasurable (c j) (volume.restrict (Set.Icc K.z₁ K.z₂)) ∧\n          IntegrableOn (fun z => ‖c j z‖ ^ 2) (Set.Icc K.z₁ K.z₂)) ∧\n        ∀ᵐ z ∂(volume.restrict (Set.Icc K.z₁ K.z₂)), ∀ r : ℝ, K.projR d s (r, z) = ∑ j, c j z * (r : ℂ) ^ (j : ℕ)\n\ndef RadialTopBoundStatement : Prop :=\n  ∀ (K : CellBox), IsCellBox K → ∀ (Q : ℕ), 5 ≤ Q → ∀ s : ℝ × ℝ → ℂ,\n    AEStronglyMeasurable s (volume.restrict K.rect) →\n    IntegrableOn (fun p => K.lineWeight p.1 * ‖s p‖ ^ 2) K.rect →\n      K.normSqOn K.lineWeightFn (fun p => K.projR (Q - 1) s p - K.proj (Q - 1) (Q - 2) s p)\n        ≤ (K.normSqOn K.lineWeightFn (K.proj (Q - 1) Q s) - K.normSqOn K.lineWeightFn (K.proj (Q - 1) (Q - 2) s))\n          + K.tailNormSq Q s\n\ndef ProjOrthStatement : Prop :=\n  ∀ (K : CellBox), IsCellBox K → ∀ (d d' : ℕ) (s : ℝ × ℝ → ℂ),\n    AEStronglyMeasurable s (volume.restrict K.rect) →\n    IntegrableOn (fun p => K.lineWeight p.1 * ‖s p‖ ^ 2) K.rect →\n      ∀ j l : ℕ, j ≤ d → l ≤ d' →\n        K.pairOn K.lineWeightFn (fun p => s p - K.proj d d' s p) (fun p => (p.1 : ℂ) ^ j * (p.2 : ℂ) ^ l) = 0\n\nend CellAnalysis\n\nend CellCert\n\nend Breakdown\n"}