ata.leading","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.oscillation","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.oscillation_eq_graph_sum","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.parentResidual","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.parentResidual_average","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.profiles","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.solvers","TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.velocity_profile_initial","TorusEuler.HierarchyTwistedProfile.PhysicalLeadingInput.completionSwitch","TorusEuler.HierarchyTwistedProfile.PhysicalLeadingInput.output","TorusEuler.HierarchyTwistedProfile.TransverseCoefficients.covector_independent","TorusEuler.HierarchyTwistedProfile.TransverseCoefficients.covector_ne_zero","TorusEuler.HierarchyTwistedProfile.complete","TorusEuler.HierarchyTwistedProfile.complete_val_val_of_phaseMean_zero","TorusEuler.HierarchyTwistedProfile.graphRead","TorusEuler.HierarchyTwistedProfile.profilePhaseAverage","TorusEuler.HierarchyTwistedProfile.twistedHierarchyOperators","TorusEuler.Pressure","TorusEuler.Vec3","TorusEuler.Velocity","TorusEuler.hierarchyGraphPoint","TorusEuler.hierarchyPeriodicProfileSubmodule","TorusEuler.hierarchySmoothProfileSubmodule","TorusEuler.hierarchyTwistedProfileSubmodule","TorusEuler.instAddCommGroupHierarchyTwistedProfile","TorusEuler.instModuleHierarchyTwistedProfile"],"written":"oscillation_eq_zero_at_zero"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":"The oscillation vanishes through activation on the closed time slab,\nincluding when activation is exactly at the initial endpoint.","end_line":108,"kind":"theorem","line":97,"module":"TorusEuler.HierarchyPhysicalInitialSlice","name":"TorusEuler.HierarchyTwistedProfile.PhysicalApproximationData.oscillation_eq_zero_through_nonnegative_activation","namespace":"TorusEuler.Hier