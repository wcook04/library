lysis.CellRows","Breakdown.CellCert.CellAnalysis.CellScalars","Breakdown.CellCert.CellFormula.CellFormulaInputs","Breakdown.CellCert.CellFormula.CellFormulaInputs.Coord","Breakdown.CellCert.CellFormula.CellFormulaInputs.D","Breakdown.CellCert.CellFormula.CellFormulaInputs.coordToData","Breakdown.CellCert.CellFormula.CellFormulaInputs.formulaValue","Breakdown.CellCert.CellFormula.CellFormulaInputs.interiorCount","Breakdown.CellCert.CellFormula.CellFormulaInputs.skeletonCount","Breakdown.CellCert.CellFormula.IsRealQuadratic","Breakdown.CellCert.FracCellData"],"used_by":["Breakdown.CellCert.CellFormula.exactFormulaBound_of_leaves","Breakdown.CellCert.CellFormula.exactFormula_represents_of","Breakdown.CellCert.CellFormula.exactFormula_represents_of_quadratic","Breakdown.CellCert.CellFormula.formulaQuadratic"],"uses":["Breakdown.CellCert.CellAnalysis.CellBases","Breakdown.CellCert.CellAnalysis.CellBox","Breakdown.CellCert.CellAnalysis.CellRows","Breakdown.CellCert.CellAnalysis.CellScalars","Breakdown.CellCert.CellFormula.CellFormulaInputs","Breakdown.CellCert.CellFormula.CellFormulaInputs.Coord","Breakdown.CellCert.CellFormula.CellFormulaInputs.D","Breakdown.CellCert.CellFormula.CellFormulaInputs.coordToData","Breakdown.CellCert.CellFormula.CellFormulaInputs.formulaValue","Breakdown.CellCert.CellFormula.CellFormulaInputs.interiorCount","Breakdown.CellCert.CellFormula.CellFormulaInputs.skeletonCount","Breakdown.CellCert.CellFormula.IsRealQuadratic","Breakdown.CellCert.FracCellData"],"written":"FormulaQuadraticStatement"}],"imports":["Breakdown.FracCell.FormulaDefs"],"module":"Breakdown.FracCell.StFormulaProof","path":"Breakdown/FracCell/StFormulaProof.lean","sha256":"826a741abf1b9d0aab7132796f011d2ef6d4716d45ec56b91253fd862b055d77","source":"import Breakdown.FracCell.FormulaDefs\n\nopen MeasureTheory Matrix\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace CellCert\n\nnamespace CellFormula\n\nopen SteadyCert Assembly CellAnalysis CellAnalysis.CellScalars\n\ndef SynthesisStatement : Prop :=\n  ∀ (α : ℝ), 1 < α → α < 5 / 4 → ∀ {k N : ℕ} (c : FracCellData k N), IsFormData α c →\n    ∀ (K : CellBox) (S : CellScalars) (B : CellBases), IsCellBox K → IsCellBases K B →\n    ∀ x : FieldTuple k, IsAdmissible c x → ∀ ζ : Fin k → ℝ, ∀ n ∈ S.resolved, ∀ p ∈ K.rect,\n      K.lowStrainAt c.order n S.degHigh x.2.1 p = synthStrain S B (augVector c K S B x ζ) n p ∧\n        K.lowVelocityAt c.order n S.degHigh x.1 p = synthVelocity S B (augVector c K S B x ζ) n p\n\ndef YCoefLinearStatement : Prop :=\n  ∀ (α : ℝ), 1 < α → α < 5 / 4 → ∀ {k N slots : ℕ} (c : FracCellData k N), IsFormData α c →\n    ∀ (K : CellBox) (S : CellScalars) (B : CellBases) (Cl : CellClasses) (R : CellRows N slots k),\n    IsCellData α c K S B Cl R →\n    ∀ (U : Aug S k → ℂ) (n : ℤ) (j l : ℕ),\n      (∀ a b : Fin 3, yCoef c K S B U n j l a b = ∑ e, U e * yVec c K S B n j l a b e) ∧\n        ∀ a : Fin 3, yVelCoef c K S B U n j l a = ∑ e, U e * velVec c K S B n j l a e\n\ndef IsRealQuadratic {ι : Type} [Fintype ι] (f : (ι → ℝ) → ℝ) : Prop :=\n  ∃ M : Matrix ι ι ℝ, ∀ w, f w = w ⬝ᵥ (M *ᵥ w)\n\ndef polarized {ι : Type} [DecidableEq ι] (f : (ι → ℝ) → ℝ) : Matrix ι ι ℝ := fun e e' =>\n  (f (Pi.single e 1 + Pi.single e' 1) - f (Pi.single e 1) - f (Pi.single e' 1)) / 2\n\ndef PolarizationStatement : Prop :=\n  ∀ {ι : Type} [Fintype ι] [DecidableEq ι] (f : (ι → ℝ) → ℝ), IsRealQuadratic f →\n    ∀ w, Finite.quadValue (polarized f) w = f w\n\ndef FormulaQuadraticStatement : Prop :=\n  ∀ {k N slots : ℕ} {S : CellScalars} (F : CellFormulaInputs k N S) (c : FracCellData k N) (K : CellBox)\n    (B : CellBases) (R : CellRows N slots k), IsLinearMap ℝ F.coordToData →\n    letI := F.dataFintype; IsRealQuadratic (F.formulaValue c K B R)\n\nend CellFormula\n\nend CellCert\n\nend Breakdown\n"}