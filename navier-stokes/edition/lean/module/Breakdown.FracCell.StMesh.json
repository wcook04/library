akdown.CellCert.CellFormula.IsFaceSegment","Breakdown.CellCert.FracCellData","Breakdown.SteadyCert.FracCertData.order"],"used_by":["Breakdown.CellCert.CellCoordinates.MeshFluxHeight.fluxHeight_of","Breakdown.CellCert.CellCoordinates.fluxHeight","Breakdown.CellCert.CellCoordinates.fluxStream_of","Breakdown.CellCert.CellCoordinates.fluxStream_of_open","Breakdown.CellCert.CellCoordinates.fluxStream_of_segment","Breakdown.CellCert.CellCoordinates.fluxStream_of_stream"],"uses":["Breakdown.CellCert.Assembly.FieldTuple","Breakdown.CellCert.Assembly.IsAdmissible","Breakdown.CellCert.CellCoordinates.streamValue","Breakdown.CellCert.CellFormula.CellLayout","Breakdown.CellCert.CellFormula.CellLayout.gradModeOf","Breakdown.CellCert.CellFormula.CellLayout.order","Breakdown.CellCert.CellFormula.CellLayout.velMode","Breakdown.CellCert.CellFormula.FaceSegment","Breakdown.CellCert.CellFormula.FaceSegment.hi","Breakdown.CellCert.CellFormula.FaceSegment.level","Breakdown.CellCert.CellFormula.FaceSegment.lo","Breakdown.CellCert.CellFormula.FaceSegment.moment","Breakdown.CellCert.CellFormula.FaceSegment.radial","Breakdown.CellCert.CellFormula.FaceSegment.test","Breakdown.CellCert.CellFormula.IsFaceSegment","Breakdown.CellCert.FracCellData","Breakdown.SteadyCert.FracCertData.order"],"written":"FluxHeightStatement"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":81,"kind":"def","line":79,"module":"Breakdown.FracCell.StMesh","name":"Breakdown.CellCert.CellCoordinates.StreamPlaneStatement","namespace":"Breakdown.CellCert.CellCoordinates","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"StreamPlaneStatement","signature_end_line":79,"sorry":false,"statement_used_by":["Breakdown.CellCert.CellCoordinates.fluxStream_of","Breakdown.CellCert.CellCoordinates.streamPlane_of"],"statement_uses":["Breakdown.CellCert.Assembly.FieldTuple","Breakdown.CellCert.Assembly.IsAdmissible","Breakdown.CellCert.CellCoordinates.streamValue","Breakdown.CellCert.CellFormula.CellLayout","Breakdown.CellCert.CellFormula.CellLayout.order","Breakdown.CellCert.FracCellData","Breakdown.SteadyCert.FracCertData.order"],"used_by":["Breakdown.CellCert.CellCoordinates.fluxStream_of","Breakdown.CellCert.CellCoordinates.streamPlane_of"],"uses":["Breakdown.CellCert.Assembly.FieldTuple","Breakdown.CellCert.Assembly.IsAdmissible","Breakdown.CellCert.CellCoordinates.streamValue","Breakdown.CellCert.CellFormula.CellLayout","Breakdown.CellCert.CellFormula.CellLayout.order","Breakdown.CellCert.FracCellData","Breakdown.SteadyCert.FracCertData.order"],"written":"StreamPlaneStatement"}],"imports":["Breakdown.FracCell.MeshDefs"],"module":"Breakdown.FracCell.StMesh","path":"Breakdown/FracCell/StMesh.lean","sha256":"494f522c888e6d8e8c08b5d4e14130d3feb370ed63c7c8457b19866658e945ed","source":"import Breakdown.FracCell.MeshDefs\n\nopen MeasureTheory\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace CellCert\n\nnamespace CellCoordinates\n\nopen SteadyCert Assembly CellAnalysis CellFormula\n\ndef MeshSkeletonSlotStatement : Prop :=\n  ∀ (α : ℝ), 1 < α → α < 5 / 4 → ∀ {k N : ℕ} (c : FracCellData k N), IsFormData α c →\n    ∀ (Sp : CellSplit k N) (M : MeshData k N Sp), IsMeshData α c Sp M →\n      ∀ x, IsAdmissible c x → ∀ K j, ∑ i, (M.coords K).Tmap j i * M.canonicalMoment c x i =\n          M.localValue c K x j\n\ndef MeshRootZeroStatement : Prop :=\n  ∀ (α : ℝ), 1 < α → α < 5 / 4 → ∀ {k N : ℕ} (c : FracCellData k N), IsFormData α c →\n    ∀ (Sp : CellSplit k N) (M : MeshData k N Sp), IsMeshData α c Sp M →\n      ∀ K, ∀ r ∈ (M.coords K).gaugeSpec.roots, ∀ x, IsAdmissible c x →\n          (M.coords K).layout.rootShifted (M.canonicalLeft K) (M.canonicalRight K) x r = 0\n\ndef MeshEdgeJumpStatement : Prop :=\n  ∀ (α : ℝ), 1 < α → α < 5 / 4 → ∀ {k N : ℕ} (c : FracCellData k N), IsFormData α c →\n    ∀ (Sp : CellSplit k N) (M : MeshData k N Sp), IsMeshData α c Sp M →\n      ∀ K e, (M.coords K).gaugeSpec.edge = some e → ∀ x, IsAdmissible c x →\n          M.canonicalRight K x = M.canonicalLeft K x + (M.coords K).layout.gaugeJump (M.coords K).gaugeSpec x\n\ndef MeshGaugeLinearStatement : Prop :=\n  ∀ (α : ℝ), 1 < α → α < 5 / 4 → ∀ {k N : ℕ} (c : FracCellData k N), IsFormData α c →\n    ∀ (Sp : CellSplit k N) (M : MeshData k N Sp), IsMeshData α c Sp M →\n      ∀ K (x y : FieldTuple k) (a b : ℝ), IsAdmissible c x → IsAdmissible c y →\n          M.canonicalLeft K (a • x + b • y) = a * M.canonicalLeft K x + b * M.canonicalLeft K y ∧\n            M.canonicalRight K (a • x + b • y) = a * M.canonicalRight K x + b * M.canonicalRight K y\n\ndef MeshMomentLinearStatement : Prop :=\n  ∀ (α : ℝ), 1 < α → α < 5 / 4 → ∀ {k N : ℕ} (c : FracCellData k N), IsFormData α c →\n    ∀ (Sp : CellSplit k N) (M : MeshData k N Sp), IsMeshData α c Sp M →\n      M.canonicalMoment c 0 = 0 ∧\n      (∀ x x', IsAdmissible c x → IsAdmissible c x' →\n          M.canonicalMoment c (x + x') = M.canonicalMoment c x + M.canonicalMoment c x') ∧\n      (∀ (r : ℝ) x, IsAdmissible c x → M.canonicalMoment c (r • x) = r • M.canonicalMoment c x) ∧\n      (∀ x, IsAdmissible c x → ∀ a, M.canonicalMoment c x (Sp.kappaSlot a) = x.2.2.2.1 a)\n\nend CellCoordinates\n\nend CellCert\n\nend Breakdown\nnamespace Breakdown\n\nnamespace CellCert\n\nnamespace CellCoordinates\n\nopen SteadyCert Assembly CellAnalysis CellFormula\n\ndef FluxRadialStatement : Prop :=\n  ∀ {k N : ℕ} (c : FracCellData k N) (x : FieldTuple k), IsAdmissible c x →\n    ∀ (L : CellLayout), L.order = c.order → ∀ (S : FaceSegment), IsFaceSegment S → ∀ (o o' : ℝ),\n      S.radial = true → 0 < S.level → 0 ≤ S.lo → o ≠ S.lo → o' ≠ S.hi → ∀ c0 : ℝ,\n        (∀ z ∈ Set.Icc S.lo S.hi, (1 : ℝ) = c0 * S.test 0 z) →\n          ((S.level * c0 : ℝ) : ℂ) * S.moment false (L.velMode 0 x 0) (L.gradModeOf 0 x 0 0) (L.gradModeOf 0 x 0 2) 0\n            = streamValue L x S.level S.lo o - streamValue L x S.level S.hi o'\n\ndef FluxHeightStatement : Prop :=\n  ∀ {k N : ℕ} (c : FracCellData k N) (x : FieldTuple k), IsAdmissible c x →\n    ∀ (L : CellLayout), L.order = c.order → ∀ (S : FaceSegment), IsFaceSegment S → ∀ (o o' : ℝ),\n      S.radial = false → 0 ≤ S.lo → o ≠ S.level → o' ≠ S.level → ∀ c0 c1 : ℝ,\n        (∀ r ∈ Set.Icc S.lo S.hi, r = c0 * S.test 0 r + c1 * S.test 1 r) →\n          (c0 : ℂ) * S.moment false (L.velMode 0 x 2) (L.gradModeOf 0 x 2 0) (L.gradModeOf 0 x 2 2) 0\n            + (c1 : ℂ) * S.moment false (L.velMode 0 x 2) (L.gradModeOf 0 x 2 0) (L.gradModeOf 0 x 2 2) 1\n            = streamValue L x S.hi S.level o - streamValue L x S.lo S.level o'\n\ndef StreamPlaneStatement : Prop :=\n  ∀ {k N : ℕ} (c : FracCellData k N) (x : FieldTuple k), IsAdmissible c x →\n    ∀ (L : CellLayout), L.order = c.order → ∀ r o, 0 ≤ r → o ≠ 0 → streamValue L x r 0 o = 0\n\nend CellCoordinates\n\nend CellCert\n\nend Breakdown\n"}