d"],"dependency_source":"lean_report","doc":null,"end_line":77,"kind":"def","line":74,"module":"Breakdown.CertCell.CouplingStatements","name":"Breakdown.CertCell.Coupling.InverseFormCreditHolds","namespace":"Breakdown.CertCell.Coupling","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"InverseFormCreditHolds","signature_end_line":74,"sorry":false,"statement_used_by":["Breakdown.CertCell.Bridge.patchCredit","Breakdown.CertCell.Coupling.inverseFormCredit"],"statement_uses":["Breakdown.CertCell.Coupling.realQuadForm"],"used_by":["Breakdown.CertCell.Bridge.patchCredit","Breakdown.CertCell.Coupling.inverseFormCredit"],"uses":["Breakdown.CertCell.Coupling.realQuadForm"],"written":"InverseFormCreditHolds"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":82,"kind":"def","line":79,"module":"Breakdown.CertCell.CouplingStatements","name":"Breakdown.CertCell.Coupling.InverseFormFactorHolds","namespace":"Breakdown.CertCell.Coupling","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"InverseFormFactorHolds","signature_end_line":79,"sorry":false,"statement_used_by":["Breakdown.CertCell.Bridge.patchEntryCredit","Breakdown.CertCell.Coupling.inverseFormFactor"],"statement_uses":["Breakdown.CertCell.Coupling.realQuadForm"],"used_by":["Breakdown.CertCell.Bridge.patchEntryCredit","Breakdown.CertCell.Coupling.inverseFormFactor"],"uses":["Breakdown.CertCell.Coupling.realQuadForm"],"written":"InverseFormFactorHolds"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":88,"kind":"def","line":84,"module":"Breakdown.CertCell.CouplingStatements","name":"Breakdown.CertCell.Coupling.PairingSquareRemainderHolds","namespace":"Breakdown.CertCell.Coupling","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"PairingSquareRemainderHolds","signature_end_line":84,"sorry":false,"statement_used_by":[],"statement_uses":[],"used_by":[],"uses":[],"written":"PairingSquareRemainderHolds"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":93,"kind":"def","line":90,"module":"Breakdown.CertCell.CouplingStatements","name":"Breakdown.CertCell.Coupling.GlobalLeafHolds","namespace":"Breakdown.CertCell.Coupling","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"GlobalLeafHolds","signature_end_line":90,"sorry":false,"statement_used_by":["Breakdown.CertCell.Assembly.initialStateBound_of_split","Breakdown.CertCell.Assembly.initialStateHolds_of_split","Breakdown.CertCell.Coupling.globalLeaf"],"statement_uses":[],"used_by":["Breakdown.CertCell.Assembly.initialStateBound_of_split","Breakdown.CertCell.Assembly.initialStateHolds_of_split","Breakdown.CertCell.Coupling.globalLeaf"],"uses":[],"written":"GlobalLeafHolds"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":98,"kind":"def","line":95,"module":"Breakdown.CertCell.CouplingStatements","name":"Breakdown.CertCell.Coupling.SingleFactorBoundHolds","namespace":"Breakdown.CertCell.Coupling","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"SingleFactorBoundHolds","signature_end_line":95,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CertCell.Coupling.quadForm"],"used_by":[],"uses":["Breakdown.CertCell.Coupling.quadForm"],"written":"SingleFactorBoundHolds"}],"imports":["Mathlib","Breakdown.CertCell.StatementDefs"],"module":"Breakdown.CertCell.CouplingStatements","path":"Breakdown/CertCell/CouplingStatements.lean","sha256":"d1c5b76356951a92967340b148177d9a821fc0548a0e34e32eb6b500cf75be6d","source":"import Mathlib\nimport Breakdown.CertCell.StatementDefs\n\nopen Matrix\nopen scoped ComplexOrder\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace CertCell\n\nnamespace Coupling\n\ndef crossForm {n : Type*} [Fintype n] (A : Matrix n n ℂ) (x u : n → ℂ) : ℝ :=\n  (star x ⬝ᵥ (A *ᵥ u)).re\n\ndef signDiag {d : ℕ} (s : Fin d → ℝ) : Matrix (Fin d) (Fin d) ℂ :=\n  Matrix.diagonal (fun a => (s a : ℂ))\n\ndef sourceForm {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] {G : Type*} [Fintype G]\n    (r : G → ℕ) (Λ : E →L[ℂ] E) (Ysum : E) (a : ∀ j, Fin (r j) → ℂ) (R : ∀ j, E →ₗ[ℂ] (Fin (r j) → ℂ))\n    (D : ∀ j, Matrix (Fin (r j)) (Fin (r j)) ℂ) (σ : E) : ℝ :=\n  (inner ℂ (Λ σ) σ).re + 2 * (inner ℂ Ysum σ).re + ∑ j, inverseWeightedSq (D j) (a j + R j σ)\n\ndef sourceBracket {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] {m : ℕ}\n    (share : ℝ) (Λ : E →L[ℂ] E) (Y : E) (port : E) (a : Fin m → ℂ) (R : E →ₗ[ℂ] (Fin m → ℂ))\n    (D : Matrix (Fin m) (Fin m) ℂ) (σ : E) : ℝ :=\n  share * (inner ℂ (Λ σ) σ).re + 2 * (inner ℂ (Y + port) σ).re + inverseWeightedSq D (a + R σ)\n\ndef SourceCopiesHolds : Prop :=\n  ∀ {E : Type} [NormedAddCommGroup E] [InnerProductSpace ℂ E] {G : Type} [Fintype G]\n    {V : Type} [AddCommGroup V] [Module ℂ V]\n    (r : G → ℕ) (Λ : E →L[ℂ] E) (Y : G → E) (a : ∀ j, Fin (r j) → ℂ)\n    (R : ∀ j, E →ₗ[ℂ] (Fin (r j) → ℂ)) (D : ∀ j, Matrix (Fin (r j)) (Fin (r j)) ℂ)\n    (share : G → ℝ) (port : G → V →ₗ[ℂ] E),\n    (∀ σ, 0 ≤ (inner ℂ (Λ σ) σ).re) → (∀ j, 0 < share j) → ∑ j, share j ≤ 1 → ∑ j, port j = 0 →\n    ∀ (η : V) (lower : G → ℝ), (∀ j σ', lower j ≤ sourceBracket (share j) Λ (Y j) (port j η) (a j) (R j) (D j) σ') →\n      ∀ σ, ∑ j, lower j ≤ sourceForm r Λ (∑ j, Y j) a R D σ\n\ndef PortSplitHolds : Prop :=\n  ∀ {n : Type} [Fintype n] (T Y₁ Y₂ : Matrix n n ℂ),\n    (T + Y₁ + Y₂).PosSemidef →\n    ∀ u w : n → ℂ, -quadForm Y₁ u - quadForm Y₂ u + 2 * crossForm (T + Y₁ + Y₂) w u\n        - quadForm (T + Y₁ + Y₂) w ≤ quadForm T u\n\ndef SumSplitHolds : Prop :=\n  ∀ {E : Type} [NormedAddCommGroup E] [InnerProductSpace ℂ E] {G : Type} [Fintype G]\n    {V : Type} [AddCommGroup V] [Module ℂ V] (share : G → ℝ) (port : G → V →ₗ[ℂ] E),\n    (∀ j, 0 < share j) → ∑ j, share j ≤ 1 → ∑ j, port j = 0 →\n    ∀ (Y : G → E) (η : V), -∑ j, ‖Y j - port j η‖ ^ 2 / share j ≤ -‖∑ j, Y j‖ ^ 2\n\ndef RowSplitHolds : Prop :=\n  ∀ {n : ℕ} {G : Type} [Fintype G] (m : G → ℕ) (embed : ∀ j, Matrix (Fin n) (Fin (m j)) ℂ)\n    (D₁ D₂ : Matrix (Fin n) (Fin n) ℂ) (M : ∀ j, Matrix (Fin (m j)) (Fin (m j)) ℂ),\n    D₁.PosDef → (∀ j, (M j).PosDef) → (D₂ - D₁ - ∑ j, embed j * (M j)⁻¹ * (embed j)ᴴ).PosSemidef →\n    ∀ (a : Fin n → ℂ) (w p : ∀ j, Fin (m j) → ℂ),\n      inverseWeightedSq D₂ (a + ∑ j, embed j *ᵥ p j) - ∑ j, quadForm (M j) (w j - p j)\n        ≤ inverseWeightedSq D₁ (a + ∑ j, embed j *ᵥ w j)\n\ndef SharePortSumHolds : Prop :=\n  ∀ {V : Type} [AddCommGroup V] [Module ℝ V] {G : Type} [Fintype G] (share : G → ℝ) (base : G → V),\n    ∑ j, share j = 1 → ∑ j, (share j • ∑ j', base j' - base j) = 0\n\ndef PlanePairCancelHolds : Prop :=\n  ∀ {I : Type} [Fintype I] {d e : ℕ} (partner : I → I) (s : Fin d → ℝ)\n    (g : I → Fin d → ℂ) (B : I → Matrix (Fin d) (Fin d) ℂ) (Ξ : I → Matrix (Fin d) (Fin e) ℂ),\n    (∀ i, partner (partner i) = i) → (∀ a, s a ^ 2 = 1) →\n    (∀ i, g (partner i) = signDiag s *ᵥ g i) →\n    (∀ i, B (partner i) = -(signDiag s * B i * signDiag s)) →\n    (∑ i, star (g i) ⬝ᵥ (B i *ᵥ g i) = 0) ∧\n      ∀ χ : Fin e → ℂ, ∑ i, star ((Ξ i - signDiag s * Ξ (partner i)) *ᵥ χ) ⬝ᵥ g i = 0\n\ndef InverseFormCreditHolds : Prop :=\n  ∀ {N : ℕ} (G : Matrix (Fin N) (Fin N) ℝ) (t : Fin N → ℂ) (A : ℝ),\n    G.PosDef → 0 ≤ A → (∀ c : Fin N → ℂ, ‖star c ⬝ᵥ t‖ ^ 2 ≤ A * realQuadForm G c) →\n    realQuadForm G⁻¹ t ≤ A\n\ndef InverseFormFactorHolds : Prop :=\n  ∀ {N p : ℕ} (G : Matrix (Fin N) (Fin N) ℝ) (L : Matrix (Fin p) (Fin N) ℝ) (ε : ℝ),\n    G.PosDef → 0 ≤ ε → ((1 + ε) • (1 : Matrix (Fin p) (Fin p) ℝ) - L * G * Lᵀ).PosSemidef →\n    ∀ x : Fin N → ℂ, realQuadForm (Lᵀ * L) x / (1 + ε) ≤ realQuadForm G⁻¹ x\n\ndef PairingSquareRemainderHolds : Prop :=\n  ∀ {E : Type} [NormedAddCommGroup E] [InnerProductSpace ℂ E] {G : Type} [Fintype G]\n    (X : G → E) (ζ : G → ℂ) (s : E) (γ : ℝ), 0 < γ →\n    -γ * ‖s‖ ^ 2 - (∑ g, ∑ g', (starRingEnd ℂ) (ζ g) * ζ g' * inner ℂ (X g) (X g')).re / γ\n      ≤ 2 * (inner ℂ (∑ g, ζ g • X g) s).re\n\ndef GlobalLeafHolds : Prop :=\n  ∀ {k : ℕ} (tw cw : ℝ) (ℓ h κ ζ : Fin k → ℝ), 0 < tw →\n    ∑ i, (κ i * ℓ i + 2 * ζ i * h i) - ∑ i, ζ i ^ 2 / tw - cw * ∑ i, κ i ^ 2\n      ≤ ∑ i, κ i * ℓ i + tw * ∑ i, h i ^ 2 - cw * ∑ i, κ i ^ 2\n\ndef SingleFactorBoundHolds : Prop :=\n  ∀ {N : ℕ} (H L : Matrix (Fin N) (Fin N) ℂ) (Z : Fin N → ℂ) (ε : ℝ), H.IsHermitian → 0 ≤ ε → ε < 1 →\n    (L * H * Lᴴ - ((1 - ε : ℝ) : ℂ) • (1 : Matrix (Fin N) (Fin N) ℂ)).PosSemidef →\n    ∀ σ : Fin N → ℂ, -(star (L *ᵥ Z) ⬝ᵥ (L *ᵥ Z)).re / (1 - ε) ≤ quadForm H σ + 2 * (star σ ⬝ᵥ Z).re\n\nend Coupling\n\nend CertCell\n\nend Breakdown\n"}