ent.Controls.SharedSolution","name":"Round3.SharedBadSpec.vacuous_claim","namespace":"Round3.SharedBadSpec","noncomputable":false,"private":false,"protected":false,"short":"vacuous_claim","signature_end_line":18,"used_by":[],"uses":["Round3.SharedBadSpec.IsComparison"],"uses_modules":{"Round3.SharedBadSpec.IsComparison":"QuarticCorpus.Independent.Controls.SharedSolution"},"written":"vacuous_claim"}],"imports":["Mathlib"],"module":"QuarticCorpus.Independent.Controls.SharedSolution","path":"QuarticCorpus/Independent/Controls/SharedSolution.lean","sha256":"b9ac0f56d8981bee533f2f9969c4970a9945636670e84c5e88c7b218aefdc217","source":"module\n\npublic import Mathlib\n\n/-! This deliberately shares the impossible premise in SharedChallenge.\nExpected Comparator acceptance is a blind-spot result, not semantic success. -/\n\n@[expose] public section\nset_option autoImplicit false\n\nnamespace Round3.SharedBadSpec\n\nstructure IsComparison (a : Fin 2 → Fin 2 → ℝ) : Prop where\n  complementary : ∀ i j, i ≠ j → a i j + a j i = 1\n  self_zero : ∀ i, a i i = 0\n  impossible : False\n\ntheorem vacuous_claim (a : Fin 2 → Fin 2 → ℝ) (ha : IsComparison a) : (1 : ℝ) = 0 :=\n  ha.impossible.elim\n\nend Round3.SharedBadSpec\n"}