rt","Breakdown.Freq.CSpace","Breakdown.Freq.IsHalfSspOf","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Space"],"written":"halfSsp_of_xbar"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":93,"kind":"theorem","line":91,"module":"Breakdown.Cert.HalfOrderGraphMem","name":"Breakdown.Cert.exists_xbar_of_halfSsp","namespace":"Breakdown.Cert","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":["Breakdown.Cert.mem_halfOrderGraph_iff"],"protected":false,"short":"exists_xbar_of_halfSsp","signature_end_line":92,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.Cert.HBar","Breakdown.Cert.XBar","Breakdown.Cert.gradPart","Breakdown.Cert.halfOrderGraph","Breakdown.Cert.secondPart","Breakdown.Freq.CSpace","Breakdown.Freq.IsHalfSspOf","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Space"],"used_by":[],"uses":["Breakdown.Cert.HBar","Breakdown.Cert.XBar","Breakdown.Cert.gradPart","Breakdown.Cert.halfOrderGraph","Breakdown.Cert.mem_halfOrderGraph_iff","Breakdown.Cert.secondPart","Breakdown.Freq.CSpace","Breakdown.Freq.IsHalfSspOf","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Space"],"written":"exists_xbar_of_halfSsp"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":96,"kind":"theorem","line":95,"module":"Breakdown.Cert.HalfOrderGraphMem","name":"Breakdown.Cert.norm_xbar_sq","namespace":"Breakdown.Cert","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.Cert.Internal.BorderedInvertible.eq_zero_of_secondPart_eq_zero","Breakdown.Cert.Internal.LocalCompactness.norm_le_of_xbar","Breakdown.Cert.Internal.LocalCompactness.norm_sq_xx","Breakdown.Cert.Internal.PeriodContinuity.gradPart_eq_zero","Breakdown.Cert.Internal.PeriodContinuity.norm_sq_xx"],"proof_uses":[],"protected":false,"short":"norm_xbar_sq","signature_end_line":95,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.Cert.HBar","Breakdown.Cert.XBar","Breakdown.Cert.gradPart","Breakdown.Cert.halfOrderGraph","Breakdown.Cert.secondPart","Breakdown.Freq.CSpace","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Space"],"used_by":["Breakdown.Cert.Internal.BorderedInvertible.eq_zero_of_secondPart_eq_zero","Breakdown.Cert.Internal.LocalCompactness.norm_le_of_xbar","Breakdown.Cert.Internal.LocalCompactness.norm_sq_xx","Breakdown.Cert.Internal.PeriodContinuity.gradPart_eq_zero","Breakdown.Cert.Internal.PeriodContinuity.norm_sq_xx"],"uses":["Breakdown.Cert.HBar","Breakdown.Cert.XBar","Breakdown.Cert.gradPart","Breakdown.Cert.halfOrderGraph","Breakdown.Cert.secondPart","Breakdown.Freq.CSpace","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Space"],"written":"norm_xbar_sq"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":103,"kind":"theorem","line":98,"module":"Breakdown.Cert.HalfOrderGraphMem","name":"Breakdown.Cert.halfSsp_unique","namespace":"Breakdown.Cert","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.Cert.Internal.FreeEnergyLocal.energyCurve_of_local","Breakdown.Cert.Internal.PeriodContinuity.gradPart_eq_zero"],"proof_uses":[],"protected":false,"short":"halfSsp_unique","signature_end_line":99,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.Freq.CSpace","Breakdown.Freq.IsHalfSspOf","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Space"],"used_by":["Breakdown.Cert.Internal.FreeEnergyLocal.energyCurve_of_local","Breakdown.Cert.Internal.PeriodContinuity.gradPart_eq_zero"],"uses":["Breakdown.Freq.CSpace","Breakdown.Freq.IsHalfSspOf","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Space"],"written":"halfSsp_unique"}],"imports":["Breakdown.Cert.Basic"],"module":"Breakdown.Cert.HalfOrderGraphMem","path":"Breakdown/Cert/HalfOrderGraphMem.lean","sha256":"7d049333569258d1d9f7891c4463a8834ad99b00327411ec156f80605197cbff","source":"import Breakdown.Cert.Basic\n\nopen MeasureTheory Filter Topology\n\nnoncomputable section\n\nnamespace Breakdown.Cert\n\nopen Freq\n\nnamespace HalfOrderGraph.Internal\n\ndef halfSspSubmodule : Submodule ℝ (WithLp 2 (Freq.X × Freq.X)) where\n  carrier := {q | IsHalfSspOf (WithLp.fst q) (WithLp.snd q)}\n  zero_mem' := by\n    show ∀ᵐ ξ ∂volume, ((0 : L2C) : Space → CSpace) ξ =\n      (2 * Real.pi * ‖ξ‖) • ((0 : L2C) : Space → CSpace) ξ\n    filter_upwards [Lp.coeFn_zero (E := CSpace) (p := 2) (μ := (volume : Measure Space))] with ξ h\n    rw [h, Pi.zero_apply, smul_zero]\n  add_mem' := by\n    intro a b ha hb\n    show ∀ᵐ ξ ∂volume, ((WithLp.snd (a + b) : Freq.X) : L2C) ξ =\n      (2 * Real.pi * ‖ξ‖) • ((WithLp.fst (a + b) : Freq.X) : L2C) ξ\n    have ha' : IsHalfSspOf (WithLp.fst a) (WithLp.snd a) := ha\n    have hb' : IsHalfSspOf (WithLp.fst b) (WithLp.snd b) := hb\n    simp only [WithLp.add_fst, WithLp.add_snd, Submodule.coe_add]\n    filter_upwards [ha', hb', Lp.coeFn_add ((WithLp.snd a : Freq.X) : L2C) (WithLp.snd b : Freq.X),\n      Lp.coeFn_add ((WithLp.fst a : Freq.X) : L2C) (WithLp.fst b : Freq.X)] with ξ h1 h2 h3 h4\n    rw [h3, h4, Pi.add_apply, Pi.add_apply, h1, h2, smul_add]\n  smul_mem' := by\n    intro c a ha\n    show ∀ᵐ ξ ∂volume, ((WithLp.snd (c • a) : Freq.X) : L2C) ξ =\n      (2 * Real.pi * ‖ξ‖) • ((WithLp.fst (c • a) : Freq.X) : L2C) ξ\n    have ha' : IsHalfSspOf (WithLp.fst a) (WithLp.snd a) := ha\n    simp only [WithLp.smul_fst, WithLp.smul_snd, Submodule.coe_smul]\n    filter_upwards [ha', Lp.coeFn_smul c ((WithLp.snd a : Freq.X) : L2C),\n      Lp.coeFn_smul c ((WithLp.fst a : Freq.X) : L2C)] with ξ h1 h2 h3\n    rw [h2, h3, Pi.smul_apply, Pi.smul_apply, h1, smul_comm]\n\ntheorem mem_halfSspSubmodule (q : WithLp 2 (Freq.X × Freq.X)) :\n    q ∈ halfSspSubmodule ↔ IsHalfSspOf (WithLp.fst q) (WithLp.snd q) := Iff.rfl\n\ntheorem tendsto_fst_coe {q : ℕ → WithLp 2 (Freq.X × Freq.X)} {q₀ : WithLp 2 (Freq.X × Freq.X)}\n    (h : Tendsto q atTop (𝓝 q₀)) :\n    Tendsto (fun n => ((WithLp.fst (q n) : Freq.X) : L2C)) atTop (𝓝 ((WithLp.fst q₀ : Freq.X) : L2C)) :=\n  ((Sig.subtypeL.comp (WithLp.fstL 2 ℝ Freq.X Freq.X)).continuous.tendsto q₀).comp h\n\ntheorem tendsto_snd_coe {q : ℕ → WithLp 2 (Freq.X × Freq.X)} {q₀ : WithLp 2 (Freq.X × Freq.X)}\n    (h : Tendsto q atTop (𝓝 q₀)) :\n    Tendsto (fun n => ((WithLp.snd (q n) : Freq.X) : L2C)) atTop (𝓝 ((WithLp.snd q₀ : Freq.X) : L2C)) :=\n  ((Sig.subtypeL.comp (WithLp.sndL 2 ℝ Freq.X Freq.X)).continuous.tendsto q₀).comp h\n\ntheorem isClosed_halfSspSubmodule :\n    IsClosed (halfSspSubmodule : Set (WithLp 2 (Freq.X × Freq.X))) := by\n  refine IsSeqClosed.isClosed fun q q₀ hq hlim => ?_\n  have hq' : ∀ n, ∀ᵐ ξ ∂volume, ((WithLp.snd (q n) : Freq.X) : L2C) ξ =\n      (2 * Real.pi * ‖ξ‖) • ((WithLp.fst (q n) : Freq.X) : L2C) ξ := fun n => hq n\n  obtain ⟨φ, hφm, hφ⟩ := (tendstoInMeasure_of_tendsto_Lp (tendsto_fst_coe hlim)).exists_seq_tendsto_ae\n  obtain ⟨ψ, hψm, hψ⟩ := (tendstoInMeasure_of_tendsto_Lp\n    (tendsto_snd_coe (hlim.comp hφm.tendsto_atTop))).exists_seq_tendsto_ae\n  show ∀ᵐ ξ ∂volume, ((WithLp.snd q₀ : Freq.X) : L2C) ξ =\n    (2 * Real.pi * ‖ξ‖) • ((WithLp.fst q₀ : Freq.X) : L2C) ξ\n  filter_upwards [ae_all_iff.mpr hq', hφ, hψ] with ξ hall hx hk\n  have hx' : Tendsto (fun i => ((WithLp.fst (q (φ (ψ i))) : Freq.X) : L2C) ξ) atTop\n      (𝓝 (((WithLp.fst q₀ : Freq.X) : L2C) ξ)) := hx.comp hψm.tendsto_atTop\n  refine tendsto_nhds_unique hk ?_\n  have heq : (fun i => ((WithLp.snd ((q ∘ φ) (ψ i)) : Freq.X) : L2C) ξ) =\n      fun i => (2 * Real.pi * ‖ξ‖) • ((WithLp.fst (q (φ (ψ i))) : Freq.X) : L2C) ξ :=\n    funext fun i => hall (φ (ψ i))\n  rw [heq]\n  exact hx'.const_smul _\n\ntheorem halfOrderGraph_eq_halfSspSubmodule : halfOrderGraph = halfSspSubmodule := by\n  unfold halfOrderGraph\n  rw [show {q : WithLp 2 (Freq.X × Freq.X) | IsHalfSspOf (WithLp.fst q) (WithLp.snd q)} =\n      (halfSspSubmodule : Set (WithLp 2 (Freq.X × Freq.X))) from rfl, Submodule.span_eq,\n    isClosed_halfSspSubmodule.submodule_topologicalClosure_eq]\n\nend HalfOrderGraph.Internal\n\nopen HalfOrderGraph.Internal\n\ntheorem mem_halfOrderGraph_iff (q : WithLp 2 (Freq.X × Freq.X)) :\n    q ∈ halfOrderGraph ↔ Freq.IsHalfSspOf (WithLp.fst q) (WithLp.snd q) := by\n  rw [halfOrderGraph_eq_halfSspSubmodule]\n  exact mem_halfSspSubmodule q\n\ntheorem halfSsp_of_xbar (q : XBar) : Freq.IsHalfSspOf (gradPart q) (secondPart q) :=\n  (mem_halfOrderGraph_iff (q : WithLp 2 (Freq.X × Freq.X))).1 q.2\n\ntheorem exists_xbar_of_halfSsp (x k : Freq.X) (h : Freq.IsHalfSspOf x k) :\n    ∃ q : XBar, gradPart q = x ∧ secondPart q = k :=\n  ⟨⟨WithLp.toLp 2 (x, k), (mem_halfOrderGraph_iff (WithLp.toLp 2 (x, k))).2 h⟩, rfl, rfl⟩\n\ntheorem norm_xbar_sq (q : XBar) : ‖q‖ ^ 2 = ‖gradPart q‖ ^ 2 + ‖secondPart q‖ ^ 2 :=\n  WithLp.prod_norm_sq_eq_of_L2 (q : WithLp 2 (Freq.X × Freq.X))\n\ntheorem halfSsp_unique (x k k' : Freq.X) (h : Freq.IsHalfSspOf x k) (h' : Freq.IsHalfSspOf x k') :\n    k = k' := by\n  apply Subtype.ext\n  apply Lp.ext\n  filter_upwards [h, h'] with ξ h1 h2\n  rw [h1, h2]\n\nend Breakdown.Cert\n"}