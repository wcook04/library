terInput.carrier","TorusEuler.InductiveEulerTip.SelectedLaterInput.carrier_transport","TorusEuler.InductiveEulerTip.SelectedLaterInput.parent","TorusEuler.InductiveEulerTip.SelectedLaterInput.parent_frequency_ge_four","TorusEuler.InductiveEulerTip.SelectedLaterInput.radius","TorusEuler.InductiveEulerTip.SelectedLaterInput.regularity","TorusEuler.InductiveEulerTip.SelectedLaterInput.seed","TorusEuler.InductiveEulerTip.SelectedLaterInput.selection","TorusEuler.InductiveEulerTip.SelectedLaterInput.time_le_one","TorusEuler.InductiveEulerTip.SelectedLaterInput.time_pos","TorusEuler.InductiveEulerTip.SelectedLaterInput.width","TorusEuler.InductiveEulerTip.SelectedLaterInput.window","TorusEuler.InductiveEulerTip.activation","TorusEuler.InductiveEulerTip.laterCarrier","TorusEuler.InductiveEulerTip.nextActivation","TorusEuler.InductiveEulerTip.older","TorusEuler.InductiveEulerTip.olderActivation","TorusEuler.InductiveEulerTip.parent","TorusEuler.InductiveEulerTip.wave","TorusEuler.InductiveEulerWave.amplitude","TorusEuler.InductiveEulerWave.error","TorusEuler.InductiveEulerWave.waveVector","TorusEuler.IsLabelFlowOn","TorusEuler.LocalizedAmplitude.CenterWaveOn","TorusEuler.LocalizedAmplitude.SeedOn","TorusEuler.LocalizedAmplitude.SeedOn.HierarchyRegularity","TorusEuler.LocalizedAmplitude.SeedOn.HierarchyRegularity.nonneg_start","TorusEuler.LocalizedAmplitude.SeedOn.HierarchyRegularity.start_lt_end","TorusEuler.LocalizedAmplitude.amplitudeLabelSlope","TorusEuler.MovingWaveVector.LaterPhysicalWindow.physical","TorusEuler.MovingWaveVector.LaterWaveSelection.center","TorusEuler.MovingWaveVector.LaterWaveSelection.crossing","TorusEuler.MovingWaveVector.LaterWaveSelection.window","TorusEuler.MovingWaveVector.PhysicalAmplification.GrowingCrossing.amplitude","TorusEuler.MovingWaveVector.PhysicalAmplification.GrowingCrossing.launch_geometry","TorusEuler.MovingWaveVector.PhysicalAmplification.GrowingCrossing.waveVector","TorusEuler.MovingWaveVector.PhysicalAmplification.basis","TorusEuler.MovingWaveVector.PhysicalAmplification.rate","TorusEuler.MovingWaveVector.PhysicalAmplification.shear","TorusEuler.MovingWaveVector.Space","TorusEuler.PhaseJetBound","TorusEuler.SpatiallyPeriodic","TorusEuler.Vec3","TorusEuler.Velocity","TorusEuler.couplingRatioOfGain","TorusEuler.frequencyExponent","TorusEuler.inductionHalfLength","TorusEuler.labelWaveVector","TorusEuler.scaledPhaseProfile"],"written":"exists_activationPrimary_phaseJetBound"}],"imports":["TorusEuler.ActivationPrimaryJetBounds","TorusEuler.InductiveLaterWaveSelection","TorusEuler.HierarchyInductiveTransverseBudget"],"module":"TorusEuler.InductiveLaterActivationJetBounds","path":"TorusEuler/InductiveLaterActivationJetBounds.lean","sha256":"aed75127acbd19160892c0b51c0179f923aee705cc585b1501666b4a9f826b59","source":"import TorusEuler.ActivationPrimaryJetBounds\nimport TorusEuler.InductiveLaterWaveSelection\nimport TorusEuler.HierarchyInductiveTransverseBudget\n\n/-! The weighted activation estimate for the selected later inductive input. -/\n\nopen Set\n\nnamespace TorusEuler.InductiveEulerTip.SelectedLaterInput\n\nopen LocalizedAmplitude HierarchyTwistedProfile\n\nnoncomputable section\n\nset_option maxHeartbeats 1100000 in\n/-- The selected later wave supplies the scheduled residual's primary\ntwo-jet bound with a uniform radius threshold and coefficient. -/\ntheorem exists_activationPrimary_phaseJetBound :\n    ∃ (A : ℕ) (C : ℝ), 30 ≤ A ∧ 0 ≤ C ∧\n      ∀ {P : InductiveEulerParameters} {n : ℕ} {p : InductiveEulerTip P n}\n        {Cenv : ℝ} {a : ℕ} (d : p.SelectedLaterInput Cenv a), A ≤ a →\n      ∀ t ∈ Icc p.nextActivation (P.slab (n + 2) p.nextActivation),\n        let D := P.frequency (n + 1) ^ 9\n        let freq := P.frequency (n + 2)\n        let γ := freq ^ (3 / 4 : ℝ) * ‖d.selection.crossing.amplitude t‖\n        PhaseJetBound 2 (γ * (C * D ^ (a + 27) * freq ^ (-5 / 4 : ℝ)))\n          (scaledPhaseProfile d.radius d.width\n            (PhysicalApproximationData.activationPrimary (h := d.width) d.seed d.parent.geometry.inverse t)) := by\n  obtain ⟨W, hW, hJet⟩ := InductiveEulerStage.exists_velocity_jet_bounds\n  obtain ⟨A, C, hA, hC, hPrimary⟩ :=\n    PhysicalApproximationData.exists_parent_activationPrimary_phaseJetBound W hW\n  refine ⟨A, C, hA, hC, ?_⟩\n  intro P n p Cenv a d ha t ht D freq γ\n  let T := P.slab (n + 2) p.nextActivation\n  have hParentTwo : 2 ≤ P.frequency (n + 1) :=\n    (by norm_num : (2 : ℝ) ≤ 4).trans d.parent_frequency_ge_four\n  have hParentOne : 1 ≤ P.frequency (n + 1) := one_le_two.trans hParentTwo\n  have hFreq : 1 ≤ freq := by\n    change 1 ≤ P.frequency (n + 1 + 1)\n    rw [P.frequency_step (n + 1)]\n    exact one_le_pow₀ hParentOne\n  have hFreqPos : 0 < freq := zero_lt_one.trans_le hFreq\n  have hD : 2 ≤ D := hParentTwo.trans (by\n    dsimp only [D]\n    simpa only [pow_one] using pow_le_pow_right₀ hParentOne (show 1 ≤ (9 : ℕ) by decide))\n  have hD₁ : 1 ≤ D := one_le_two.trans hD\n  have hD₀ : 0 < D := zero_lt_one.trans_le hD₁\n  have hRadius : d.radius ≤ (D ^ A)⁻¹ :=\n    inv_anti₀ (pow_pos hD₀ _) (pow_le_pow_right₀ hD₁ ha)\n  have hRadiusInv : d.radius⁻¹ ≤ D ^ a := by\n    change ((D ^ a)⁻¹)⁻¹ ≤ D ^ a\n    rw [inv_inv]\n  have hStart : p.nextActivation ∈ Icc 0 T :=\n    ⟨d.regularity.nonneg_start, d.regularity.start_lt_end.le⟩\n  have hStart' : p.nextActivation ∈ Icc p.nextActivation T :=\n    ⟨le_rfl, d.regularity.start_lt_end.le⟩\n  have hLaunch : ‖labelWaveVector p.parent.flow 0 0 d.carrier p.nextActivation‖ = freq := by\n    rw [d.carrier_transport hStart']\n    exact (d.selection.crossing.launch_geometry hFreqPos).2.1\n  have hc := d.parent.centerWaveOn_labelWaveVector hStart (show d.carrier = _ from rfl)\n    d.selection.center\n  exact hPrimary (g := d.parent.geometry) d.time_le_one hD hRadius hRadiusInv hFreq hLaunch\n    d.parent.deformationOn.flow d.parent.smooth_velocity (fun u _ => p.parent.periodic_velocity u)\n    (fun _ hu x => (d.parent.raw_coframe_norm_le_frequency_nine hParentTwo hu x).1)\n    (fun _ hu x => (d.parent.raw_coframe_norm_le_frequency_nine hParentTwo hu x).2)\n    (fun i j hj hji u hu x => hJet p.parent hParentOne i j hj hji u (d.parent.subset hu) x)\n    hc d.seed d.regularity t ht\n\nend\nend TorusEuler.InductiveEulerTip.SelectedLaterInput\n"}