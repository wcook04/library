ellAnalysis.frameMat","Breakdown.CellCert.CellAnalysis.gradMode","Breakdown.CellCert.CellAnalysis.modeMat","Breakdown.Space"],"written":"gradMode_zero_field"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":106,"kind":"theorem","line":104,"module":"Breakdown.CertCell.GaugePlanePairBase","name":"Breakdown.CertCell.PlanePairInternal.modeThird_zero_field","namespace":"Breakdown.CertCell.PlanePairInternal","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CertCell.PlanePairInternal.lift_at_zero"],"proof_uses":["Breakdown.CellCert.CellAnalysis.frameThird"],"protected":false,"short":"modeThird_zero_field","signature_end_line":105,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CellCert.CellAnalysis.modeThird","Breakdown.Space"],"used_by":["Breakdown.CertCell.PlanePairInternal.lift_at_zero"],"uses":["Breakdown.CellCert.CellAnalysis.frameThird","Breakdown.CellCert.CellAnalysis.modeThird","Breakdown.Space"],"written":"modeThird_zero_field"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":131,"kind":"theorem","line":108,"module":"Breakdown.CertCell.GaugePlanePairBase","name":"Breakdown.CertCell.PlanePairInternal.lift_at_zero","namespace":"Breakdown.CertCell.PlanePairInternal","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CertCell.PlanePairInternal.corner_key_conj","Breakdown.CertCell.PlanePairInternal.gradient_key_conj","Breakdown.CertCell.PlanePairInternal.velocity_key_conj"],"proof_uses":["Breakdown.CertCell.PlanePairInternal.gradMode_zero_field","Breakdown.CertCell.PlanePairInternal.harmonicSin_at_zero","Breakdown.CertCell.PlanePairInternal.modeThird_zero_field","Breakdown.CertCell.PlanePairInternal.modeVec_zero_field"],"protected":false,"short":"lift_at_zero","signature_end_line":118,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CellCert.CellFormula.CellLayout","Breakdown.CellCert.CellFormula.CellLayout.gradModeOf","Breakdown.CellCert.CellFormula.CellLayout.order","Breakdown.CellCert.CellFormula.CellLayout.secondModeOf","Breakdown.CellCert.CellFormula.CellLayout.velMode","Breakdown.CertCell.CellCalculus.HarmonicLiftStatement","Breakdown.CertCell.CellCalculus.IsPeriodicSecondOrder","Breakdown.CertCell.CellCalculus.cosTuple","Breakdown.CertCell.CellCalculus.harmonicMode","Breakdown.CertCell.PlaneFlipFacts.planeGrad","Breakdown.CertCell.PlaneFlipFacts.planeSlope","Breakdown.CertCell.PlaneFlipFacts.planeVelocity","Breakdown.CertCell.labelHarmonic","Breakdown.Space"],"used_by":["Breakdown.CertCell.PlanePairInternal.corner_key_conj","Breakdown.CertCell.PlanePairInternal.gradient_key_conj","Breakdown.CertCell.PlanePairInternal.velocity_key_conj"],"uses":["Breakdown.CellCert.CellFormula.CellLayout","Breakdown.CellCert.CellFormula.CellLayout.gradModeOf","Breakdown.CellCert.CellFormula.CellLayout.order","Breakdown.CellCert.CellFormula.CellLayout.secondModeOf","Breakdown.CellCert.CellFormula.CellLayout.velMode","Breakdown.CertCell.CellCalculus.HarmonicLiftStatement","Breakdown.CertCell.CellCalculus.IsPeriodicSecondOrder","Breakdown.CertCell.CellCalculus.cosTuple","Breakdown.CertCell.CellCalculus.harmonicMode","Breakdown.CertCell.PlaneFlipFacts.planeGrad","Breakdown.CertCell.PlaneFlipFacts.planeSlope","Breakdown.CertCell.PlaneFlipFacts.planeVelocity","Breakdown.CertCell.PlanePairInternal.gradMode_zero_field","Breakdown.CertCell.PlanePairInternal.harmonicSin_at_zero","Breakdown.CertCell.PlanePairInternal.modeThird_zero_field","Breakdown.CertCell.PlanePairInternal.modeVec_zero_field","Breakdown.CertCell.labelHarmonic","Breakdown.Space"],"written":"lift_at_zero"}],"imports":["Breakdown.CertCell.GaugePlaneFlipFacts","Breakdown.CertCell.GaugePlanePairZero","Breakdown.CertCell.ModeConjugate","Breakdown.FracCell.ConjugateData"],"module":"Breakdown.CertCell.GaugePlanePairBase","path":"Breakdown/CertCell/GaugePlanePairBase.lean","sha256":"0c69cefc5bc54a0d7a22de28fa4c126b142eee6357b9ec0b228824c500b0858f","source":"import Breakdown.CertCell.GaugePlaneFlipFacts\nimport Breakdown.CertCell.GaugePlanePairZero\nimport Breakdown.CertCell.ModeConjugate\nimport Breakdown.FracCell.ConjugateData\n\nopen MeasureTheory ComplexConjugate\n\nnoncomputable section\n\nnamespace Breakdown.CertCell.PlanePairInternal\n\nopen CellCert CellCert.CellCoordinates CellCert.CellFormula CellCert.CellAnalysis PlaneFlipFacts\nopen CellCert.CellFormula.ConjugateDataInternal\n\ntheorem ae_fst_ne_zero : ∀ᵐ p : ℝ × ℝ ∂(volume : Measure (ℝ × ℝ)), p.1 ≠ 0 := by\n  rw [ae_iff]\n  have hs : {p : ℝ × ℝ | ¬ p.1 ≠ 0} = ({0} : Set ℝ) ×ˢ (Set.univ : Set ℝ) := by\n    ext p\n    simp\n  rw [hs, Measure.volume_eq_prod, Measure.prod_prod]\n  simp\n\ntheorem heightStrip_congr {c o lo hi : ℝ} (wt t : ℝ → ℝ) {F F' dF dF' : ℝ × ℝ → ℂ} (hlo : 0 ≤ lo)\n    (hF : ∀ᵐ p ∂(volume : Measure (ℝ × ℝ)), 0 < p.1 → F p = F' p)\n    (hdF : ∀ᵐ p ∂(volume : Measure (ℝ × ℝ)), 0 < p.1 → dF p = dF' p) :\n    heightStripMoment c o lo hi wt F dF t = heightStripMoment c o lo hi wt F' dF' t := by\n  unfold heightStripMoment\n  congr 1\n  refine integral_congr_ae ?_\n  rw [Filter.EventuallyEq, ae_restrict_iff' (measurableSet_Icc.prod measurableSet_Icc)]\n  filter_upwards [hF, hdF, ae_fst_ne_zero] with p h1 h2 h3 hp\n  have hpos : 0 < p.1 := lt_of_le_of_ne (le_trans hlo hp.1.1) (Ne.symm h3)\n  rw [h1 hpos, h2 hpos]\n\ntheorem corner_congr {cr orr cz oz : ℝ} {F F' Fr Fr' Fz Fz' Frz Frz' : ℝ × ℝ → ℂ} (hmin : 0 ≤ min cr orr)\n    (hF : ∀ᵐ p ∂(volume : Measure (ℝ × ℝ)), 0 < p.1 → F p = F' p)\n    (hFr : ∀ᵐ p ∂(volume : Measure (ℝ × ℝ)), 0 < p.1 → Fr p = Fr' p)\n    (hFz : ∀ᵐ p ∂(volume : Measure (ℝ × ℝ)), 0 < p.1 → Fz p = Fz' p)\n    (hFrz : ∀ᵐ p ∂(volume : Measure (ℝ × ℝ)), 0 < p.1 → Frz p = Frz' p) :\n    cornerMoment cr orr cz oz F Fr Fz Frz = cornerMoment cr orr cz oz F' Fr' Fz' Frz' := by\n  unfold cornerMoment\n  congr 1\n  refine integral_congr_ae ?_\n  rw [Filter.EventuallyEq, ae_restrict_iff' (measurableSet_Icc.prod measurableSet_Icc)]\n  filter_upwards [hF, hFr, hFz, hFrz, ae_fst_ne_zero] with p h1 h2 h3 h4 h5 hp\n  have hpos : 0 < p.1 := lt_of_le_of_ne (le_trans hmin hp.1.1) (Ne.symm h5)\n  rw [h1 hpos, h2 hpos, h3 hpos, h4 hpos]\n\ntheorem heightStrip_of_le {c o lo hi : ℝ} (wt t : ℝ → ℝ) (F dF : ℝ × ℝ → ℂ) (h : hi ≤ lo) :\n    heightStripMoment c o lo hi wt F dF t = 0 := by\n  have hz : (volume : Measure (ℝ × ℝ)) (Set.Icc lo hi ×ˢ Set.Icc (min c o) (max c o)) = 0 := by\n    rw [Measure.volume_eq_prod, Measure.prod_prod, Real.volume_Icc, ENNReal.ofReal_of_nonpos (by linarith),\n      zero_mul]\n  unfold heightStripMoment\n  rw [Measure.restrict_eq_zero.mpr hz, integral_zero_measure, mul_zero]\n\ntheorem segTest_continuous (S : FaceSegment) (d : ℕ) : Continuous (S.test d) := by\n  unfold FaceSegment.test\n  exact continuous_finsetSum _ fun i _ => continuous_const.mul (continuous_pow i)\n\ntheorem flipLabel_of_fst {ξ : ℤ × ℤ} (h : ξ.1 = 0) : flipLabel ξ = -ξ := by\n  ext <;> simp [flipLabel, h]\n\ntheorem planeLabel_fst (m : ℕ) (l : ℤ) : (labelHarmonic m (CellCalculus.harmonicMode 0 (2 * l))).1 = 0 := by\n  have h : (2 * l + 0) / 2 = l := by omega\n  simp only [labelHarmonic, labelTime, CellCalculus.harmonicMode, h]\n  ring\n\nsection Conjugates\n\nvariable (ξ : ℤ × ℤ)\n\ntheorem planeVelocity_conj (v : ℝ → Space → Space) (a : Fin 3) :\n    planeVelocity (-ξ) v a = fun p => conj (planeVelocity ξ v a p) := by\n  funext p\n  unfold planeVelocity\n  rw [(Bridge.modeConjugate v (fun _ _ => 0) (fun _ _ => 0) ξ 0 (planePoint p)).1]\n  rfl\n\ntheorem planeGrad_conj (G : ℝ → Space → (Space →L[ℝ] Space)) (a b : Fin 3) :\n    planeGrad (-ξ) G a b = fun p => conj (planeGrad ξ G a b p) := by\n  funext p\n  unfold planeGrad\n  rw [(Bridge.modeConjugate (fun _ _ => 0) G (fun _ _ => 0) ξ 0 (planePoint p)).2.1]\n  rfl\n\ntheorem planeSlope_conj (H : ℝ → Space → (Space →L[ℝ] Space →L[ℝ] Space)) (a b c : Fin 3) :\n    planeSlope (-ξ) H a b c = fun p => conj (planeSlope ξ H a b c p) := by\n  funext p\n  unfold planeSlope\n  rw [(Bridge.modeConjugate (fun _ _ => 0) (fun _ _ => 0) H ξ 0 (planePoint p)).2.2]\n  rfl\n\nend Conjugates\n\ntheorem modeVec_zero_field (m : ℕ) (n : ℤ) (r z : ℝ) (a : Fin 3) :\n    modeVec m n (0 : Space → Space) r z a = 0 := by\n  fin_cases a <;> simp [modeVec, frameVec]\n\ntheorem gradMode_zero_field (m : ℕ) (n : ℤ) (a b : Fin 3) (p : ℝ × ℝ) :\n    gradMode m n (0 : Space → (Space →L[ℝ] Space)) a b p = 0 := by\n  simp [gradMode, modeMat, frameMat]\n\ntheorem modeThird_zero_field (m : ℕ) (n : ℤ) (a b c : Fin 3) (p : ℝ × ℝ) :\n    modeThird m n (0 : Space → (Space →L[ℝ] Space →L[ℝ] Space)) a b c p = 0 := by\n  simp [modeThird, frameThird]\n\ntheorem lift_at_zero (hLift : CellCalculus.HarmonicLiftStatement) {v : ℝ → Space → Space}\n    {G : ℝ → Space → (Space →L[ℝ] Space)} {H : ℝ → Space → (Space →L[ℝ] Space →L[ℝ] Space)}\n    (hv : CellCalculus.IsPeriodicSecondOrder v G H) (Pg : ℝ → Space → Space) (L : CellLayout) (n : ℤ)\n    (hn : Even n) :\n    ∀ᵐ p ∂(volume : Measure (ℝ × ℝ)), 0 < p.1 →\n      (∀ a, planeVelocity (labelHarmonic L.order (CellCalculus.harmonicMode 0 n)) v a p\n          = L.velMode n (CellCalculus.cosTuple 0 v G H Pg) a p) ∧\n      (∀ a b, planeGrad (labelHarmonic L.order (CellCalculus.harmonicMode 0 n)) G a b p\n          = L.gradModeOf n (CellCalculus.cosTuple 0 v G H Pg) a b p) ∧\n      (∀ a b c, planeSlope (labelHarmonic L.order (CellCalculus.harmonicMode 0 n)) H a b c p\n          = L.secondModeOf n (CellCalculus.cosTuple 0 v G H Pg) a b c p) := by\n  have h := (hLift L.order v G H hv 0).2.2 n (by simpa using hn)\n  filter_upwards [h] with p hp hpos\n  obtain ⟨h1, h2, h3⟩ := hp hpos\n  refine ⟨fun a => ?_, fun a b => ?_, fun a b c => ?_⟩\n  · have e := h1 a\n    rw [harmonicSin_at_zero, modeVec_zero_field, mul_zero, add_zero] at e\n    exact e\n  · have e := h2 a b\n    rw [harmonicSin_at_zero, gradMode_zero_field, mul_zero, add_zero] at e\n    exact e\n  · have e := h3 a b c\n    rw [harmonicSin_at_zero, modeThird_zero_field, mul_zero, add_zero] at e\n    exact e\n\nend Breakdown.CertCell.PlanePairInternal\n\n"}