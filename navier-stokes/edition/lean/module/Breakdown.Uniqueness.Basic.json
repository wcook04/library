radialCutoff_eq_scale","Breakdown.SpaceLowerBound.Internal.scalar_term_bound","Breakdown.SteadyCert.GradientOrthogonalInternal.cut_pair","Breakdown.SteadyCert.HeldWeakProfilePartsInternal.weak_component","Breakdown.SteadyCert.cutoff_bounds","Breakdown.SteadyCert.driftEnergy_of","Breakdown.SteadyCert.fderiv_cutoff_far","Breakdown.SteadyCert.fderiv_cutoff_near","Breakdown.abs_radialCutoff_sub_le","Breakdown.contDiff_radialCutoff","Breakdown.cubic_term_le","Breakdown.cutoffFlux","Breakdown.cutoffFracDissipation","Breakdown.cutoffPow","Breakdown.cutoffPow_mono","Breakdown.cutoffSixthNorm","Breakdown.cutoffSixthNorm_le","Breakdown.cutoffSource_eq","Breakdown.cutoffSource_fun_eq","Breakdown.differentiable_radialCutoff","Breakdown.far_stress_le","Breakdown.fderiv_bound_one","Breakdown.fderiv_cutoffPow","Breakdown.fracCutoffLowerBound_of","Breakdown.fracDifference_of","Breakdown.fracSixthNorm_of","Breakdown.hasCompactSupport_of_cutoff","Breakdown.hasCompactSupport_radialCutoff","Breakdown.integrable_near_part","Breakdown.lpProd_step","Breakdown.memLp_cutoff_rpow","Breakdown.near_stress_le","Breakdown.norm_fderiv_cutoffSq_smul_le","Breakdown.norm_fderiv_radialCutoff_le","Breakdown.norm_gradient_cutoffPow_le","Breakdown.radialCutoff_eq_one","Breakdown.radialCutoff_eq_one_aux","Breakdown.radialCutoff_eq_zero","Breakdown.radialCutoff_le_one","Breakdown.radialCutoff_nonneg","Breakdown.radialCutoff_scale","Breakdown.secondPartial_source_split","Breakdown.self_stress_le","Breakdown.sq_cutoffSource_le","Breakdown.transport_term_le"],"uses":["Breakdown.Space"],"written":"radialCutoff"}],"imports":["Breakdown.Base.Realization"],"module":"Breakdown.Uniqueness.Basic","path":"Breakdown/Uniqueness/Basic.lean","sha256":"22f2eaaf174e8de3a0eb14bb180c0580b286665720d632e81d3c650e72745177","source":"import Breakdown.Base.Realization\n\nopen scoped ContDiff ENNReal\nopen MeasureTheory Set\n\nnoncomputable section\n\nnamespace Breakdown\n\ninstance factOneLeSixExponent : Fact ((1 : ℝ≥0∞) ≤ 6) := ⟨by norm_num⟩\n\nstructure IsSolutionOn (T : ℝ) (u : ℝ → Space → Space) (p : ℝ → Space → ℝ) : Prop where\n  smooth_velocity : ContDiffOn ℝ ∞ (fun z : ℝ × Space => u z.1 z.2) (Icc 0 T ×ˢ univ)\n  smooth_pressure : ContDiffOn ℝ ∞ (fun z : ℝ × Space => p z.1 z.2) (Icc 0 T ×ˢ univ)\n  momentum : ∀ t ∈ Ioo 0 T, ∀ x,\n    deriv (fun τ => u τ x) t + advectionAt (u t) x = sumSecondPartialsAt (u t) x - gradientAt (p t) x\n  incompressible : ∀ t ∈ Icc 0 T, ∀ x, divergenceAt (u t) x = 0\n\ndef EnergyBoundedOn (T : ℝ) (u : ℝ → Space → Space) : Prop :=\n  ∃ A : ℝ, ∀ t ∈ Icc 0 T, ∫⁻ x, ENNReal.ofReal (‖u t x‖ ^ 2) ≤ ENNReal.ofReal A\n\ndef GradientBoundedOn (T : ℝ) (u : ℝ → Space → Space) : Prop :=\n  ∃ B : ℝ, ∀ t ∈ Icc 0 T, ∀ x, ‖u t x‖ ≤ B ∧ ‖fderiv ℝ (u t) x‖ ≤ B\n\ndef HasBoundedEnergy (u : ℝ → Space → Space) : Prop :=\n  ∃ C : ℝ, ∀ t ≥ 0, ∫⁻ x, ENNReal.ofReal (‖u t x‖ ^ 2) ≤ ENNReal.ofReal C\n\ndef NoBoundedSmoothSolution (ν : ℝ) (u₀ : Space → Space) : Prop :=\n  ¬ ∃ (u : ℝ → Space → Space) (p : ℝ → Space → ℝ), IsSmoothSolution ν u₀ u p ∧ HasBoundedEnergy u\n\nstructure FieldReading {X : Type*} [NormedAddCommGroup X] [InnerProductSpace ℝ X] [CompleteSpace X]\n    (Rlz : Realization X) (vel : X →L[ℝ] Lp (α := Space) Space 6) : Prop where\n  injective : ∀ x, (vel x : Space → Space) =ᵐ[volume] 0 → x = 0\n  rot : ∀ R x, (vel (Rlz.rot R x) : Space → Space) =ᵐ[volume] pushForward R (vel x)\n  dil : ∀ μ, 0 < μ → ∀ x, (vel (Rlz.F.D μ x) : Space → Space) =ᵐ[volume] dilateField μ (vel x)\n\ndef MildRegular {X : Type*} [NormedAddCommGroup X] [InnerProductSpace ℝ X] [CompleteSpace X]\n    (Rlz : Realization X) (vel : X →L[ℝ] Lp (α := Space) Space 6) : Prop :=\n  ∀ φ, IsTestField φ → ∀ (u : ℝ → X) (T : ℝ), 0 < T → Rlz.F.IsMildOnIcc u 0 T → u 0 = Rlz.embed φ →\n    ∃ (U : ℝ → Space → Space) (P : ℝ → Space → ℝ), IsSolutionOn T U P ∧ U 0 = φ ∧\n      EnergyBoundedOn T U ∧ GradientBoundedOn T U ∧\n      ∀ t ∈ Icc 0 T, (vel (u t) : Space → Space) =ᵐ[volume] U t\n\ndef radialCutoff (r : ℝ) (x : Space) : ℝ := Real.smoothTransition (2 - ‖x‖ / r)\n\nend Breakdown\n"}