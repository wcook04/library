wn.PotentialShape.PotentialSeries"],"written":"isPotentialPick_phi"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":60,"kind":"theorem","line":52,"module":"Breakdown.CellReduction.PotThetaScalar","name":"Breakdown.PotentialShape.axisAdmissible_of_pick","namespace":"Breakdown.PotentialShape","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.PotentialShape.componentDifferentiable_of_smooth","Breakdown.PotentialShape.componentSecond_ae_of_smooth","Breakdown.PotentialShape.component_smooth_of","Breakdown.PotentialShape.potentialDecay_of_pick"],"proof_uses":["Breakdown.PotentialShape.IsPotentialPick.axis"],"protected":false,"short":"axisAdmissible_of_pick","signature_end_line":54,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CertCell.GivenShape.FieldKey","Breakdown.CertCell.GivenShape.FieldKey.label","Breakdown.CertCell.labelAzimuth","Breakdown.PotentialShape.AxisAdmissible","Breakdown.PotentialShape.IsPotentialPick","Breakdown.PotentialShape.PotComponent","Breakdown.PotentialShape.PotComponent.carriesSine","Breakdown.PotentialShape.PotComponent.shift","Breakdown.PotentialShape.PotKeyData","Breakdown.PotentialShape.PotScalar","Breakdown.PotentialShape.PotentialSeries","Breakdown.PotentialShape.PotentialSeries.data","Breakdown.PotentialShape.PotentialSeries.keys"],"used_by":["Breakdown.PotentialShape.componentDifferentiable_of_smooth","Breakdown.PotentialShape.componentSecond_ae_of_smooth","Breakdown.PotentialShape.component_smooth_of","Breakdown.PotentialShape.potentialDecay_of_pick"],"uses":["Breakdown.CertCell.GivenShape.FieldKey","Breakdown.CertCell.GivenShape.FieldKey.label","Breakdown.CertCell.labelAzimuth","Breakdown.PotentialShape.AxisAdmissible","Breakdown.PotentialShape.IsPotentialPick","Breakdown.PotentialShape.IsPotentialPick.axis","Breakdown.PotentialShape.PotComponent","Breakdown.PotentialShape.PotComponent.carriesSine","Breakdown.PotentialShape.PotComponent.shift","Breakdown.PotentialShape.PotKeyData","Breakdown.PotentialShape.PotScalar","Breakdown.PotentialShape.PotentialSeries","Breakdown.PotentialShape.PotentialSeries.data","Breakdown.PotentialShape.PotentialSeries.keys"],"written":"axisAdmissible_of_pick"}],"imports":["Breakdown.CellReduction.PotentialShape"],"module":"Breakdown.CellReduction.PotThetaScalar","path":"Breakdown/CellReduction/PotThetaScalar.lean","sha256":"9d0e40d8205be44bf079036e3d20c9891e1fc30f38959d69bde2cac0774f3c05","source":"import Breakdown.CellReduction.PotentialShape\n\nopen scoped ContDiff\nopen MeasureTheory\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace PotentialShape\n\nopen CertCell CertCell.GivenShape AdjointDefect\n\ndef AxisAdmissible (M : ℤ) (withSine : Bool) (S : PotScalar) : Prop :=\n  (M ≠ 0 → withSine = false → 1 ≤ S.axisPower ∨ AxisCellsVanish S.amp) ∧\n    (withSine = true → |M| ≠ 1 → 1 ≤ S.axisPower ∨ AxisCellsVanish S.amp)\n\ndef ScalarSmoothAwayFromOrigin : Prop :=\n  ∀ (P : ShapeParams) (κ : FieldKey) (M : ℤ) (withSine : Bool) (S : PotScalar) (σ : ℝ),\n    IsShapeParams P → IsJetClass 1 1 S.amp → AxisAdmissible M withSine S →\n    (∀ y : Space, y ≠ 0 → ContDiffAt ℝ 1 (scalarValue P κ M withSine S σ) y) ∧\n    ∀ r R : ℝ, 0 < r → ∃ L : NNReal,\n      LipschitzOnWith L (fderiv ℝ (scalarValue P κ M withSine S σ)) {y : Space | r ≤ ‖y‖ ∧ ‖y‖ ≤ R}\n\ndef ScalarSmoothNearOrigin : Prop :=\n  ∀ (P : ShapeParams) (κ : FieldKey) (M : ℤ) (withSine : Bool) (S : PotScalar) (σ : ℝ),\n    IsShapeParams P → IsJetClass 1 1 S.amp → AxisAdmissible M withSine S →\n    (∃ z ≤ S.amp.tAxis.depth, 2 ≤ S.lowOrder + z ∧ StartVanishOrder S.amp z) →\n    ContDiffAt ℝ 1 (scalarValue P κ M withSine S σ) 0 ∧\n    ∃ δ > (0 : ℝ), ∃ L : NNReal, LipschitzOnWith L (fderiv ℝ (scalarValue P κ M withSine S σ)) (Metric.closedBall 0 δ)\n\ndef ScalarDecayOrder (h : ℕ) : Prop :=\n  ∀ (P : ShapeParams) (κ : FieldKey) (M : ℤ) (withSine : Bool) (S : PotScalar),\n    IsShapeParams P → IsPotentialScalar 2 h S → AxisAdmissible M withSine S → ∃ C : ℝ,\n    (∀ σ y, ‖scalarValue P κ M withSine S σ y‖ ≤ C / (1 + ‖y‖) ^ h ∧\n      ‖fderiv ℝ (scalarValue P κ M withSine S σ) y‖ ≤ C / (1 + ‖y‖) ^ (h + 1)) ∧\n    ∀ σ, ∀ᵐ y, ‖fderiv ℝ (fun x => fderiv ℝ (scalarValue P κ M withSine S σ) x) y‖ ≤ C / (1 + ‖y‖) ^ (h + 2)\n\nstructure IsPotentialPick (h : ℕ) (F : PotentialSeries) (pick : PotKeyData → PotComponent → PotScalar) : Prop where\n  scalar : ∀ κ ∈ F.keys, ∀ c, IsPotentialScalar 2 h (pick (F.data κ) c)\n  axis : ∀ κ ∈ F.keys, κ.label.1 ≠ 0 → ∀ c,\n    1 ≤ (pick (F.data κ) c).axisPower ∨ AxisCellsVanish (pick (F.data κ) c).amp\n\ntheorem isPotentialPick_theta {F : PotentialSeries} (hF : IsPotentialSeries F) :\n    IsPotentialPick 2 F PotKeyData.theta :=\n  ⟨hF.theta_scalar, hF.theta_axis⟩\n\ntheorem isPotentialPick_phi {F : PotentialSeries} (hF : IsPotentialSeries F) :\n    IsPotentialPick 1 F PotKeyData.phi :=\n  ⟨hF.phi_scalar, hF.phi_axis⟩\n\ntheorem axisAdmissible_of_pick {h : ℕ} {F : PotentialSeries} {pick : PotKeyData → PotComponent → PotScalar}\n    (hF : IsPotentialPick h F pick) (m : ℕ) {κ : FieldKey} (hκ : κ ∈ F.keys) (c : PotComponent) :\n    AxisAdmissible (labelAzimuth m κ.label + c.shift) c.carriesSine (pick (F.data κ) c) := by\n  by_cases h0 : κ.label.1 = 0\n  · have hz : labelAzimuth m κ.label = 0 := by simp [labelAzimuth, h0]\n    rw [hz, zero_add]\n    cases c <;> refine ⟨fun hM hw => ?_, fun hw hM => ?_⟩ <;>\n      simp_all [PotComponent.shift, PotComponent.carriesSine]\n  · exact ⟨fun _ _ => hF.axis κ hκ h0 c, fun _ _ => hF.axis κ hκ h0 c⟩\n\nend PotentialShape\n\nend Breakdown\n"}