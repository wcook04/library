sEuler.InductiveEulerConstruction.stages","TorusEuler.InductiveEulerParameters","TorusEuler.InductiveEulerStages.activation","TorusEuler.InductiveEulerStages.oscillation","TorusEuler.PaperTheorem71Conclusions","TorusEuler.Vec3"],"written":"oscillation_before_activation"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":84,"kind":"theorem","line":82,"module":"TorusEuler.PaperSequenceStatements","name":"TorusEuler.paperSequence_older_velocity","namespace":"TorusEuler","noncomputable":false,"noncomputable_section":true,"private":true,"proof_used_by":["TorusEuler.paperTheorem71_of_construction"],"proof_uses":[],"protected":false,"short":"paperSequence_older_velocity","signature_end_line":83,"sorry":false,"statement_used_by":[],"statement_uses":["TorusEuler.InductiveEulerConstruction","TorusEuler.InductiveEulerConstruction.stages","TorusEuler.InductiveEulerConstruction.tip","TorusEuler.InductiveEulerParameters","TorusEuler.InductiveEulerStage.velocity","TorusEuler.InductiveEulerStages.velocity","TorusEuler.InductiveEulerTip.older","TorusEuler.InductiveEulerTip.olderActivation","TorusEuler.Velocity"],"used_by":["TorusEuler.paperTheorem71_of_construction"],"uses":["TorusEuler.InductiveEulerConstruction","TorusEuler.InductiveEulerConstruction.stages","TorusEuler.InductiveEulerConstruction.tip","TorusEuler.InductiveEulerParameters","TorusEuler.InductiveEulerStage.velocity","TorusEuler.InductiveEulerStages.velocity","TorusEuler.InductiveEulerTip.older","TorusEuler.InductiveEulerTip.olderActivation","TorusEuler.Velocity"],"written":"paperSequence_older_velocity"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":89,"kind":"theorem","line":86,"module":"TorusEuler.PaperSequenceStatements","name":"TorusEuler.paperSequence_activation_strict","namespace":"TorusEuler","noncomputable":false,"noncomputable_section":true,"private":true,"proof_used_by":["TorusEuler.paperTheorem71_of_construction"],"proof_uses":["TorusEuler.InductiveEulerCentralWaves.crossing_time","TorusEuler.MovingWaveVector.PhysicalAmplification.GrowingCrossing.crossing_after_switch","TorusEuler.MovingWaveVector.PhysicalAmplification.rate_pos"],"protected":false,"short":"paperSequence_activation_strict","signature_end_line":86,"sorry":false,"statement_used_by":[],"statement_uses":["TorusEuler.InductiveEulerConstruction","TorusEuler.InductiveEulerConstruction.stages","TorusEuler.InductiveEulerParameters","TorusEuler.InductiveEulerStages.activation"],"used_by":["TorusEuler.paperTheorem71_of_construction"],"uses":["TorusEuler.InductiveEulerCentralWaves.crossing_time","TorusEuler.InductiveEulerConstruction","TorusEuler.InductiveEulerConstruction.stages","TorusEuler.InductiveEulerParameters","TorusEuler.InductiveEulerStages.activation","TorusEuler.MovingWaveVector.PhysicalAmplification.GrowingCrossing.crossing_after_switch","TorusEuler.MovingWaveVector.PhysicalAmplification.rate_pos"],"written":"paperSequence_activation_strict"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":"A physical construction certifies every quantitative clause of Theorem 7.1,\nincluding the inverse deformation and the prescribed exit ratio.","end_line":142,"kind":"theorem","line":93,"module":"TorusEuler.PaperSequenceStatements","name":"TorusEuler.paperTheorem71_of_construction","namespace":"TorusEuler","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["TorusEuler.Paper.Lib.S678a.conclusions_of_construction","TorusEuler.paperTheorem71"],"proof_uses":["TorusEuler.ChildFlow.DeformationOn.fderiv_inverse","TorusEuler.InductiveEulerStages.first_activation","TorusEuler.InductiveEulerStages.second_activation","TorusEuler.InductiveEulerStages.slab_base","TorusEuler.InductiveEulerStages.slab_step","TorusEuler.InductiveEulerWave.ratio_at_crossing","TorusEuler.frequencySchedule_commonLifetime_of_halfLength_bounds","TorusEuler.frequencySchedule_frequency_mono","TorusEuler.paperSequence_activation_strict","TorusEuler.paperSequence_older_velocity"],"protected":false,"short":"paperTheorem71_of_construction","signature_end_line":97,"sorry":false,"statement_used_by":[],"statement_uses":["TorusEuler.InductiveEulerBase.stationary","TorusEuler.InductiveEulerConstruction","TorusEuler.InductiveEulerConstruction.base","TorusEuler.InductiveEulerParameters","TorusEuler.InductiveEulerParameters.frequency","TorusEuler.InductiveEulerStage.velocity","TorusEuler.PaperTheorem71Conclusions","TorusEuler.Velocity","TorusEuler.couplingRatioOfGain","TorusEuler.stationaryShear"],"used_by":["TorusEuler.Paper.Lib.S678a.conclusions_of_construction","TorusEuler.paperTheorem71"],"uses":["TorusEuler.ChildFlow.DeformationOn.fderiv_inverse","TorusEuler.InductiveEulerBase.stationary","TorusEuler.InductiveEulerConstruction","TorusEuler.InductiveEulerConstruction.base","TorusEuler.InductiveEulerParameters","TorusEuler.InductiveEulerParameters.frequency","TorusEuler.InductiveEulerStage.velocity","TorusEuler.InductiveEulerStages.first_activation","TorusEuler.InductiveEulerStages.second_activation","TorusEuler.InductiveEulerStages.slab_base","TorusEuler.InductiveEulerStages.slab_step","TorusEuler.InductiveEulerWave.ratio_at_crossing","TorusEuler.PaperTheorem71Conclusions","TorusEuler.Velocity","TorusEuler.couplingRatioOfGain","TorusEuler.frequencySchedule_commonLifetime_of_halfLength_bounds","TorusEuler.frequencySchedule_frequency_mono","TorusEuler.paperSequence_activation_strict","TorusEuler.paperSequence_older_velocity","TorusEuler.stationaryShear"],"written":"paperTheorem71_of_construction"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":"The fixed parameter and threshold yield the full common sequence for\neach sufficiently large initial frequency in frozen Theorem 7.1.","end_line":174,"kind":"theorem","line":148,"module":"TorusEuler.PaperSequenceStatements","name":"TorusEuler.paperTheorem71","namespace":"TorusEuler","noncomputable":false,"private":false,"proof_used_by":[],"proof_uses":["TorusEuler.InductiveEulerStage","TorusEuler.InductiveFirstWaveSelection.parent_velocity","TorusEuler.ScheduledEulerBase.parent_eq","TorusEuler.couplingRatioOfGain","TorusEuler.exists_scheduledEulerConstruction_of_uniformPhysicalEstimates","TorusEuler.nonempty_laterPrimaryCosts","TorusEuler.paperTheorem71_of_construction","TorusEuler.stationaryShear","TorusEuler.uniformPhysicalEstimates_of_laterPrimaryCosts"],"protected":false,"short":"paperTheorem71","signature_end_line":155,"sorry":false,"statement_used_by":[],"statement_uses":["TorusEuler.InductiveEulerParameters","TorusEuler.InductiveEulerParameters.exponentParameter","TorusEuler.InductiveEulerParameters.frequency","TorusEuler.InductiveEulerParameters.strengthConstant","TorusEuler.InductiveEulerParameters.threshold","TorusEuler.PaperTheorem71Conclusions","TorusEuler.ScheduledEulerConstruction","TorusEuler.ScheduledEulerConstruction.construction","TorusEuler.frequencyExponent"],"used_by":[],"uses":["TorusEuler.InductiveEulerParameters","TorusEuler.InductiveEulerParameters.exponentParameter","TorusEuler.InductiveEulerParameters.frequency","TorusEuler.InductiveEulerParameters.strengthConstant","TorusEuler.InductiveEulerParameters.threshold","TorusEuler.InductiveEulerStage","TorusEuler.InductiveFirstWaveSelection.parent_velocity","TorusEuler.PaperTheorem71Conclusions","TorusEuler.ScheduledEulerBase.parent_eq","TorusEuler.ScheduledEulerConstruction","TorusEuler.ScheduledEulerConstruction.construction","TorusEuler.couplingRatioOfGain","TorusEuler.exists_scheduledEulerConstruction_of_uniformPhysicalEstimates","TorusEuler.frequencyExponent","TorusEuler.nonempty_laterPrimaryCosts","TorusEuler.paperTheorem71_of_construction","TorusEuler.stationaryShear","TorusEuler.uniformPhysicalEstimates_of_laterPrimaryCosts"],"written":"paperTheorem71"}],"imports":["TorusEuler.Theorem11"],"module":"TorusEuler.PaperSequenceStatements","path":"TorusEuler/PaperSequenceStatements.lean","sha256":"bf572f3f6cc38b4394a57b42ccac46c84d42c4304f3dd75fe346265460833743","source":"import TorusEuler.Theorem11\n\n/-! The common sequence and its quantitative predicates from frozen Theorem 7.1. -/\n\nopen Filter Set\nopen scoped ContDiff InnerProductSpace Topology\n\nnamespace TorusEuler\n\nopen MovingWaveVector (entry frame)\n\nnoncomputable section\n\nvariable {P : InductiveEulerParameters} (c : InductiveEulerConstruction P)\n\nlocal notation \"U\" => c.stages.velocity\nlocal notation \"time\" => c.stages.activation\nlocal notation \"S\" => c.stages.slab\nlocal notation \"freq\" => c.stages.frequency\nlocal notation \"O\" => c.stages.oscillation\n\n/-- The fields of the common sequence, with the indexing of frozen Theorem 7.1.\nAt index `j`, the paper's positive wave index is `j+1`. -/\nstructure PaperTheorem71Conclusions (T : ℝ) : Prop where\n  startup :\n    U 0 = fun _ => stationaryShear (couplingRatioOfGain (4 * Real.log (freq 3)))\n  initial_activations : time 1 = 0 ∧ time 2 = 0\n  activation_strict : ∀ j : ℕ, time (j + 2) < time (j + 3)\n  stage_slab : S 0 = 1 ∧ ∀ j : ℕ,\n    S (j + 1) = time (j + 1) + 2 * (freq j ^ (-1 / 8 : ℝ) * (4 * Real.log (freq (j + 3))) ^ 3)\n  stage_regular : ∀ n : ℕ,\n    ContDiffOn ℝ ∞ (Function.uncurry (U n)) (Icc 0 (S n) ×ˢ (univ : Set Vec3)) ∧\n      IsLabelFlowOn (U n) (c.stage n).flow (Icc 0 (S n)) ∧\n      ∀ t ∈ Icc 0 (S n), SpatiallyPeriodic (U n t) ∧ Function.Odd (U n t) ∧\n        (∀ x, divergence (U n t) x = 0) ∧\n        RealTorusFourierBand (2 * freq n ^ 5) (c.stages.torusVelocity n t)\n  stage_size : ∀ n : ℕ, ∀ t ∈ Icc 0 (S n),\n    ‖c.stages.torusVelocity n t‖ ≤ freq n ∧\n      (∀ x, ‖c.stages.residual n t x‖ ≤ freq (n + 1) ^ (-3 : ℝ)) ∧\n      ∀ x : Vec3,\n        let F := fderiv ℝ ((c.stage n).flow 0 t) x\n        let G := fderiv ℝ ((c.stage n).flow t 0) ((c.stage n).flow 0 t x)\n        ‖F‖ ≤ freq n ∧ ‖G‖ ≤ freq n ∧\n          G.comp F = .id ℝ Vec3 ∧ F.comp G = .id ℝ Vec3\n  pressure_upper : ∀ n : ℕ, ∀ t ∈ Icc 0 (S n), ∀ x v : Vec3,\n    ⟪v, fderiv ℝ (gradient ((c.stage n).pressure t)) x v⟫_ℝ ≤\n      (∑ i ∈ Finset.range n, (freq i)⁻¹) * ‖v‖ ^ 2\n  central_gradient : ∀ j : ℕ, ∀ t ∈ Icc (time (j + 1)) (S (j + 1)),\n    fderiv ℝ (U (j + 1) t) 0 =\n      fderiv ℝ (U j t) 0 +\n        c.centralWaves.cutoff (j + 1) t •\n          (innerSL ℝ (c.centralWaves.waveVector (j + 1) t)).smulRight (c.centralWaves.amplitude (j + 1) t) +\n        c.centralWaves.error (j + 1) t ∧\n      ‖c.centralWaves.error (j + 1) t‖ ≤ freq (j + 1) ^ (-1 / 4 : ℝ)\n  crossing_window : ∀ j : ℕ,\n    0 ≤ time (j + 2) - time (j + 1) ∧\n      time (j + 2) - time (j + 1) ≤ inductionHalfLength freq j ∧\n      ∀ t ∈ Icc (time (j + 2)) (S (j + 1)), c.centralWaves.cutoff (j + 1) t = 1\n  strength_constant : 2 ≤ c.centralWaves.strengthConstant\n  crossing_values : ∀ j : ℕ,\n    let t := time (j + 2)\n    let E := frame (c.centralWaves.waveVector (j + 1)) (c.centralWaves.amplitude (j + 1)) t\n    let B := fderiv ℝ (U j t) (0 : Vec3)\n    let ν := entry E B 0 1\n    let η := entry E B 2 1\n    let σ := ‖c.centralWaves.amplitude (j + 1) t‖ * ‖c.centralWaves.waveVector (j + 1) t‖\n    η / ν = couplingRatioOfGain (4 * Real.log (freq (j + 3))) ∧\n      Real.pi ≤ ν ∧ ν ≤ 4 * Real.pi ∧\n      c.centralWaves.strengthConstant⁻¹ * freq (j + 1) ^ (1 / 4 : ℝ) ≤ σ ∧\n      σ ≤ c.centralWaves.strengthConstant * freq (j + 1) ^ (1 / 4 : ℝ) *\n        (4 * Real.log (freq (j + 3))) ^ 2\n  lifetime : 0 < T ∧ Tendsto time atTop (𝓝 T) ∧ ∀ j, T < S j\n  oscillation_support : ∀ j : ℕ, ∀ t ∈ Icc 0 (S (j + 1)), ∀ x,\n    O (j + 1) t x ≠ 0 → ∃ n : Fin 3 → ℤ, dist (latticeVector n) x ≤ (freq j)⁻¹\n  oscillation_small : ∀ j : ℕ, ∀ t ∈ Icc 0 (S (j + 1)), ∀ x,\n    ‖O (j + 1) t x‖ ≤ (freq (j + 1))⁻¹\n  increment : ∀ j m : ℕ, m ≤ c.stages.order (j + 1) → ∀ t ∈ Icc 0 (S (j + 1)),\n    let V := U (j + 1) t - U j t - O (j + 1) t\n    SpatialHolderHalf m V ∧ spatialHolderHalfNorm m V ≤ (freq (j + 1))⁻¹\n  oscillation_before_activation : ∀ j ≥ 2, ∀ t ∈ Icc 0 (time j), O j t = 0\n\nprivate theorem paperSequence_older_velocity (j : ℕ) :\n    (c.tip j).older.velocity = U j := by\n  cases j <;> rfl\n\nprivate theorem paperSequence_activation_strict (j : ℕ) : time (j + 2) < time (j + 3) := by\n  have h := (c.centralWaves.crossing j).crossing_after_switch\n  rw [c.centralWaves.crossing_time j] at h\n  exact (lt_add_of_pos_right _ (one_div_pos.mpr (c.centralWaves.physical j).rate_pos)).trans h\n\n/-- A physical construction certifies every quantitative clause of Theorem 7.1,\nincluding the inverse deformation and the prescribed exit ratio. -/\ntheorem paperTheorem71_of_construction\n    (hFrequency : (4 : ℝ) ^ (16 : ℕ) ≤ P.frequency 0)\n    (hStartup : c.base.stationary.velocity =\n      fun _ => stationaryShear (couplingRatioOfGain (4 * Real.log (P.frequency 3)))) :\n    ∃ T : ℝ, PaperTheorem71Conclusions c T := by\n  obtain ⟨T, hT, hActivation, _, hSlab, _⟩ :=\n    frequencySchedule_commonLifetime_of_halfLength_bounds hFrequency c.lifetime.step\n      c.stages.activation_zero c.stages.first_activation c.stages.second_activation (fun j => (c.stages.activation_step j).2)\n      (paperSequence_activation_strict c) c.stages.slab_base c.stages.slab_step\n  have hBase : 2 ≤ P.frequency 0 :=\n    (by norm_num : (2 : ℝ) ≤ 4 ^ (16 : ℕ)).trans hFrequency\n  have hMono : Monotone P.frequency := frequencySchedule_frequency_mono P.exponentParameter\n    P.order P.frequency P.exponentParameter_ge (one_le_two.trans hBase) P.frequency_step\n  refine ⟨T, { startup := hStartup\n               initial_activations := ⟨c.stages.first_activation, c.stages.second_activation⟩\n               activation_strict := paperSequence_activation_strict c\n               stage_slab := ⟨c.stages.slab_base, c.stages.slab_step⟩\n               stage_regular := ?_\n               stage_size := ?_\n               pressure_upper := fun n => (c.stage n).pressure_hessian\n               central_gradient := fun j t ht => ⟨c.centralWaves.gradient_split j t ht, c.centralWaves.error_bound j t ht⟩\n               crossing_window := ?_\n               strength_constant := c.centralWaves.strengthConstant_ge\n               crossing_values := ?_\n               lifetime := ⟨hT, hActivation, hSlab⟩\n               oscillation_support := c.stages.oscillation_support\n               oscillation_small := c.stages.oscillation_bound\n               increment := c.stages.correction_bound\n               oscillation_before_activation := c.stages.oscillation_vanishes }⟩\n  · exact fun n => ⟨c.stages.smooth n, (c.stage n).deformation.flow, fun t ht =>\n      ⟨c.stages.periodic_velocity n t, c.stages.odd n t ht, c.stages.divergence_free n t ht, c.stages.velocity_band n t ht⟩⟩\n  · intro n t ht\n    refine ⟨c.stages.velocity_bound n t ht, ?_, ?_⟩\n    · intro x\n      have hn : 0 ≤ freq (n + 1) := zero_le_two.trans (hBase.trans (hMono (Nat.zero_le _)))\n      have hr : freq (n + 1) ^ (-3 : ℝ) = ((freq (n + 1))⁻¹) ^ (3 : ℕ) := by\n        rw [Real.rpow_neg hn, show (3 : ℝ) = ((3 : ℕ) : ℝ) by norm_num, Real.rpow_natCast, inv_pow]\n      rw [hr]\n      exact c.stages.residual_bound n t ht x\n    · intro x\n      have hd := (c.stage n).deformation\n      exact ⟨((hd.bounds t ht).2.1 x).2,\n        ((hd.bounds t ht).2.2 ((c.stage n).flow 0 t x)).2, hd.fderiv_inverse ht x⟩\n  · exact fun j => ⟨(c.stages.activation_step j).1, (c.stages.activation_step j).2, c.centralWaves.cutoff_complete j⟩\n  · intro j\n    dsimp only\n    have hr := (c.tip j).wave.ratio_at_crossing\n    rw [paperSequence_older_velocity c j] at hr\n    refine ⟨hr, (c.centralWaves.coupling_at_crossing j).1, (c.centralWaves.coupling_at_crossing j).2, ?_⟩\n    simpa only [mul_comm ‖c.centralWaves.waveVector (j + 1) (time (j + 2))‖] using c.centralWaves.strength_at_crossing j\n\nend\n\n/-- The fixed parameter and threshold yield the full common sequence for\neach sufficiently large initial frequency in frozen Theorem 7.1. -/\ntheorem paperTheorem71 :\n    ∃ (b : ℕ) (threshold : ℕ → ℝ) (N₁ : ℝ),\n      1 ≤ b ∧ Monotone threshold ∧ threshold 1 ≤ N₁ ∧\n      (∀ q ≥ 1, 0 < threshold q ∧\n        4 * (frequencyExponent b (q + 1) : ℝ) ^ 3 ≤ Real.log (threshold q)) ∧\n      ∀ N ≥ N₁, ∃ (P : InductiveEulerParameters) (c : ScheduledEulerConstruction P) (T : ℝ),\n        P.exponentParameter = b ∧ P.threshold = threshold ∧ P.frequency 0 = N ∧\n          P.strengthConstant = 18 * Real.exp 3 ∧ PaperTheorem71Conclusions c.construction T := by\n  obtain ⟨b, threshold, N₁, hMono, hSchedule⟩ :=\n    exists_scheduledEulerConstruction_of_uniformPhysicalEstimates\n      (uniformPhysicalEstimates_of_laterPrimaryCosts (Classical.choice nonempty_laterPrimaryCosts))\n      ((4 : ℝ) ^ (16 : ℕ))\n  obtain ⟨P₁, _, hb₁, ht₁, hf₁, _, _⟩ := hSchedule N₁ le_rfl\n  refine ⟨b, threshold, N₁, hb₁ ▸ P₁.exponentParameter_ge, hMono, ?_, ?_, ?_⟩\n  · rw [← ht₁, ← hf₁]\n    exact P₁.initial_threshold\n  · intro q hq\n    rw [← ht₁, ← hb₁]\n    exact ⟨P₁.threshold_pos q hq, P₁.threshold_floor q hq⟩\n  · intro N hN\n    obtain ⟨P, c, hb, ht, hf, hFloor, hStrength⟩ := hSchedule N hN\n    have hStartup : c.construction.base.stationary.velocity =\n        fun _ => stationaryShear (couplingRatioOfGain (4 * Real.log (P.frequency 3))) :=\n      (congrArg (fun d : InductiveEulerStage P 0 0 => d.velocity) c.base.parent_eq).trans\n        c.base.selected.parent_velocity\n    obtain ⟨T, hT⟩ := paperTheorem71_of_construction c.construction hFloor hStartup\n    exact ⟨P, c, T, hb, ht, hf, hStrength, hT⟩\n\nend TorusEuler\n"}