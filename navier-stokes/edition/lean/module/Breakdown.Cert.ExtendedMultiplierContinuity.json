,"Breakdown.ExtendedCertificateData","Breakdown.ExtendedCertificateData.multiplier","Breakdown.ExtendedCertificateData.multiplierOf"],"written":"multiplierOf_eq"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":50,"kind":"theorem","line":26,"module":"Breakdown.Cert.ExtendedMultiplierContinuity","name":"Breakdown.Cert.Internal.ExtendedMultiplierContinuity.heldMultiplier_continuousOn","namespace":"Breakdown.Cert.Internal.ExtendedMultiplierContinuity","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.Cert.extendedMultiplierContinuityHolds_of"],"proof_uses":["Breakdown.Cert.Internal.ExtendedMultiplierContinuity.heldMultiplier_spec"],"protected":false,"short":"heldMultiplier_continuousOn","signature_end_line":29,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.Cert.ExtendedHeldExistsUniqueHolds","Breakdown.Cert.ExtendedHeldLimitHolds","Breakdown.Cert.Internal.ExtendedMultiplierContinuity.heldMultiplier","Breakdown.ExtendedCertificateData","Breakdown.ExtendedCertificateData.params","Breakdown.IsNormalExtendedCertificate"],"used_by":["Breakdown.Cert.extendedMultiplierContinuityHolds_of"],"uses":["Breakdown.Cert.ExtendedHeldExistsUniqueHolds","Breakdown.Cert.ExtendedHeldLimitHolds","Breakdown.Cert.Internal.ExtendedMultiplierContinuity.heldMultiplier","Breakdown.Cert.Internal.ExtendedMultiplierContinuity.heldMultiplier_spec","Breakdown.ExtendedCertificateData","Breakdown.ExtendedCertificateData.params","Breakdown.IsNormalExtendedCertificate"],"written":"heldMultiplier_continuousOn"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":59,"kind":"theorem","line":55,"module":"Breakdown.Cert.ExtendedMultiplierContinuity","name":"Breakdown.Cert.extendedMultiplierContinuityHolds_of","namespace":"Breakdown.Cert","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.extended_certificate_orbit_proved"],"proof_uses":["Breakdown.Cert.Internal.ExtendedMultiplierContinuity.heldMultiplier_continuousOn","Breakdown.Cert.Internal.ExtendedMultiplierContinuity.multiplierOf_eq"],"protected":false,"short":"extendedMultiplierContinuityHolds_of","signature_end_line":56,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.Cert.ExtendedHeldExistsUniqueHolds","Breakdown.Cert.ExtendedHeldLimitHolds","Breakdown.Cert.ExtendedMultiplierContinuityHolds"],"used_by":["Breakdown.extended_certificate_orbit_proved"],"uses":["Breakdown.Cert.ExtendedHeldExistsUniqueHolds","Breakdown.Cert.ExtendedHeldLimitHolds","Breakdown.Cert.ExtendedMultiplierContinuityHolds","Breakdown.Cert.Internal.ExtendedMultiplierContinuity.heldMultiplier_continuousOn","Breakdown.Cert.Internal.ExtendedMultiplierContinuity.multiplierOf_eq"],"written":"extendedMultiplierContinuityHolds_of"}],"imports":["Breakdown.Cert.ExtendedNodes"],"module":"Breakdown.Cert.ExtendedMultiplierContinuity","path":"Breakdown/Cert/ExtendedMultiplierContinuity.lean","sha256":"095711cee1573f5e21f5f79539c22f2310fa076c7ce858eb617db2547dd98284","source":"import Breakdown.Cert.ExtendedNodes\n\nopen scoped Topology\nopen Filter\n\nnoncomputable section\n\nnamespace Breakdown.Cert\n\nnamespace Internal.ExtendedMultiplierContinuity\n\nopen scoped Classical\n\ndef heldMultiplier {k : ℕ} (d : ExtendedCertificateData k) (p : Fin k → ℝ) : Fin k → ℝ :=\n  if h : ∃ κ, ∃ f, d.IsHeldSolution p f κ then h.choose else 0\n\ntheorem heldMultiplier_spec {k : ℕ} (d : ExtendedCertificateData k) (p : Fin k → ℝ)\n    (h : ∃ κ, ∃ f, d.IsHeldSolution p f κ) : ∃ f, d.IsHeldSolution p f (heldMultiplier d p) := by\n  unfold heldMultiplier\n  rw [dif_pos h]\n  exact h.choose_spec\n\ntheorem multiplierOf_eq {k : ℕ} (d : ExtendedCertificateData k) :\n    d.multiplierOf = fun p => d.multiplier p + heldMultiplier d p := rfl\n\ntheorem heldMultiplier_continuousOn (h1 : ExtendedHeldLimitHolds)\n    (h2 : ExtendedHeldExistsUniqueHolds) {k : ℕ} (d : ExtendedCertificateData k)\n    (hd : IsNormalExtendedCertificate d) :\n    ContinuousOn (heldMultiplier d) d.params := by\n  have hex : ∀ p ∈ d.params, ∃ f, d.IsHeldSolution p f (heldMultiplier d p) := by\n    intro p hp\n    obtain ⟨f, κ, hf, -⟩ := h2 d hd p hp\n    exact heldMultiplier_spec d p ⟨κ, f, hf⟩\n  intro q hq\n  refine tendsto_of_subseq_tendsto fun ns hns => ?_\n  rw [tendsto_nhdsWithin_iff] at hns\n  obtain ⟨hlim, hev⟩ := hns\n  obtain ⟨N, hN⟩ := eventually_atTop.1 hev\n  have hmem : ∀ n, ns (n + N) ∈ d.params := fun n => hN _ (Nat.le_add_left N n)\n  have hlim' : Tendsto (fun n => ns (n + N)) atTop (𝓝 q) := (tendsto_add_atTop_iff_nat N).2 hlim\n  choose f hf using fun n => hex _ (hmem n)\n  obtain ⟨φ, -, f₀, κ₀, h₀, hκ⟩ := h1 d hd.certificate (fun n => ns (n + N)) q hmem hq hlim' f\n    (fun n => heldMultiplier d (ns (n + N))) hf\n  obtain ⟨fq, hfq⟩ := hex q hq\n  obtain ⟨g, μ, -, huniq⟩ := h2 d hd q hq\n  have e1 := (huniq _ _ hfq).2\n  have e2 := (huniq _ _ h₀).2\n  refine ⟨fun n => φ n + N, ?_⟩\n  rw [e1, ← e2]\n  exact hκ\n\nend Internal.ExtendedMultiplierContinuity\n\nopen Internal.ExtendedMultiplierContinuity in\ntheorem extendedMultiplierContinuityHolds_of (h1 : ExtendedHeldLimitHolds)\n    (h2 : ExtendedHeldExistsUniqueHolds) : ExtendedMultiplierContinuityHolds := by\n  intro k d hd\n  rw [multiplierOf_eq]\n  exact hd.certificate.multiplier_continuous.add (heldMultiplier_continuousOn h1 h2 d hd)\n\nend Breakdown.Cert\n"}