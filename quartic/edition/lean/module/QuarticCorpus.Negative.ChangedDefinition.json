{"declarations":[{"dependency_source":"source_text","doc":null,"end_line":18,"kind":"structure","line":15,"module":"QuarticCorpus.Negative.ChangedDefinition","name":"QuarticQuery.Tournament.IsComparison","namespace":"QuarticQuery.Tournament","noncomputable":false,"private":false,"protected":false,"short":"IsComparison","signature_end_line":15,"used_by":["QuarticQuery.Checked.expected_weight_eq","QuarticQuery.Checked.expected_weight_le_half"],"uses":[],"written":"IsComparison"},{"dependency_source":"source_text","doc":null,"end_line":16,"kind":"def","line":16,"module":"QuarticCorpus.Negative.ChangedDefinition","name":"QuarticQuery.Tournament.IsComparison.complementary","namespace":"QuarticQuery.Tournament.IsComparison","noncomputable":false,"parent":"QuarticQuery.Tournament.IsComparison","private":false,"protected":false,"short":"complementary","signature_end_line":16,"used_by":[],"uses":[],"written":"complementary"},{"dependency_source":"source_text","doc":null,"end_line":17,"kind":"def","line":17,"module":"QuarticCorpus.Negative.ChangedDefinition","name":"QuarticQuery.Tournament.IsComparison.self_zero","namespace":"QuarticQuery.Tournament.IsComparison","noncomputable":false,"parent":"QuarticQuery.Tournament.IsComparison","private":false,"protected":false,"short":"self_zero","signature_end_line":17,"used_by":[],"uses":[],"written":"self_zero"},{"dependency_source":"source_text","doc":null,"end_line":18,"kind":"def","line":18,"module":"QuarticCorpus.Negative.ChangedDefinition","name":"QuarticQuery.Tournament.IsComparison.impossible","namespace":"QuarticQuery.Tournament.IsComparison","noncomputable":false,"parent":"QuarticQuery.Tournament.IsComparison","private":false,"protected":false,"short":"impossible","signature_end_line":18,"used_by":[],"uses":[],"written":"impossible"},{"dependency_source":"source_text","doc":null,"end_line":28,"kind":"theorem","line":24,"module":"QuarticCorpus.Negative.ChangedDefinition","name":"QuarticQuery.Checked.expected_weight_eq","namespace":"QuarticQuery.Checked","noncomputable":false,"private":false,"protected":false,"short":"expected_weight_eq","signature_end_line":27,"used_by":[],"uses":["QuarticQuery.Tournament.IsComparison"],"uses_modules":{"QuarticQuery.Tournament.IsComparison":"QuarticCorpus.Negative.ChangedDefinition"},"written":"expected_weight_eq"},{"dependency_source":"source_text","doc":null,"end_line":34,"kind":"theorem","line":30,"module":"QuarticCorpus.Negative.ChangedDefinition","name":"QuarticQuery.Checked.expected_weight_le_half","namespace":"QuarticQuery.Checked","noncomputable":false,"private":false,"protected":false,"short":"expected_weight_le_half","signature_end_line":33,"used_by":[],"uses":["QuarticQuery.Tournament.IsComparison"],"uses_modules":{"QuarticQuery.Tournament.IsComparison":"QuarticCorpus.Negative.ChangedDefinition"},"written":"expected_weight_le_half"}],"imports":["Mathlib"],"module":"QuarticCorpus.Negative.ChangedDefinition","path":"QuarticCorpus/Negative/ChangedDefinition.lean","sha256":"4a3b0a97b2fd35e6c8e31fdd8fa8017b0e428cc8b6b41eccaa36f9e2cf445264","source":"module\n\npublic import Mathlib\n\n/-!\nMust be rejected: `IsComparison` is redefined with an impossible field, which\nmakes both theorems vacuous while leaving their displayed text unchanged. This is\nthe attack a statement-only check would miss.\n-/\n\npublic section\n\nnamespace QuarticQuery.Tournament\n\nstructure IsComparison {ι : Type} (a : ι → ι → ℝ) : Prop where\n  complementary : ∀ i j, i ≠ j → a i j + a j i = 1\n  self_zero : ∀ i, a i i = 0\n  impossible : False\n\nend QuarticQuery.Tournament\n\nnamespace QuarticQuery.Checked\n\ntheorem expected_weight_eq {ι : Type} [Fintype ι] [DecidableEq ι] (w : ι → ℝ)\n    {a : ι → ι → ℝ} (ha : Tournament.IsComparison a)\n    {W : ℝ} (hW : W = ∑ i, w i) (hpos : 0 < W) :\n    ∑ p, (w p / W) * ∑ i, w i * a i p = (W ^ 2 - ∑ i, w i ^ 2) / (2 * W) :=\n  ha.impossible.elim\n\ntheorem expected_weight_le_half {ι : Type} [Fintype ι] [DecidableEq ι] (w : ι → ℝ)\n    {a : ι → ι → ℝ} (ha : Tournament.IsComparison a)\n    {W : ℝ} (hW : W = ∑ i, w i) (hpos : 0 < W) :\n    ∑ p, (w p / W) * ∑ i, w i * a i p ≤ W / 2 :=\n  ha.impossible.elim\n\nend QuarticQuery.Checked\n"}