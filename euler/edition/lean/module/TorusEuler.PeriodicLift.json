,"TorusEuler.IsEulerSolution.hasSmoothOffOriginExtension","TorusEuler.Paper.Lib.Aux.smoothTerminalExtension_of_hasSmoothOffOriginExtension","TorusEuler.Paper.Lib.Aux.smoothTerminalExtension_of_mixed","TorusEuler.Paper.Lib.Rem12.smoothTerminalExtension_of_hasSmoothOffOriginExtension","TorusEuler.contDiffOn_dyadicPeriodicMultiplierKernel","TorusEuler.contDiff_cutoff_smul_of_contDiffOn_offOrigin","TorusEuler.continuousOn_iteratedFDeriv_dyadicPeriodicMultiplierKernel","TorusEuler.exists_lattice_separation_of_isCompact_offOrigin","TorusEuler.exists_offOrigin_compact_neighborhood","TorusEuler.exists_spatiallyPeriodic_contDiffOn_extension","TorusEuler.exists_tendstoUniformlyOn_pressureGradient_of_velocity_jets","TorusEuler.hasFDerivAt_periodicFarMultiplierJet","TorusEuler.norm_iteratedFDeriv_velocityPressureTensor_bilinear_le","TorusEuler.tendstoUniformlyOn_cutoff_smul_spatial_jets","TorusEuler.tendstoUniformlyOn_iteratedFDeriv_pressureVelocityTensor"],"uses":["TorusEuler.Vec3","TorusEuler.isClosed_range_latticeVector","TorusEuler.latticeVector","TorusEuler.offOrigin"],"written":"isOpen_offOrigin"}],"imports":["TorusEuler.Statement"],"module":"TorusEuler.PeriodicLift","path":"TorusEuler/PeriodicLift.lean","sha256":"3c0aabf12489cee14942b274cdaa6a24ba517976c3c4e13dc2a24281ad2ceaaf","source":"import TorusEuler.Statement\n\nopen Set\n\nnamespace TorusEuler\n\ntheorem isCompact_centeredCell : IsCompact centeredCell := by\n  let box : Set (Fin 3 → ℝ) := pi univ fun _ => Icc (-(1 / 2 : ℝ)) (1 / 2)\n  have hbox : IsCompact box := isCompact_univ_pi fun _ => isCompact_Icc\n  have himage : WithLp.toLp 2 '' box = centeredCell := by\n    ext x\n    constructor\n    · rintro ⟨y, hy, rfl⟩ i\n      exact hy i (mem_univ i)\n    · intro hx\n      exact ⟨WithLp.ofLp x, fun i _ => hx i, rfl⟩\n  rw [← himage]\n  exact hbox.image (PiLp.continuous_toLp 2 fun _ => ℝ)\n\n/-- Every point of the lift has a representative in the centered cell. -/\ntheorem exists_sub_latticeVector_mem_centeredCell (x : Vec3) :\n    ∃ n : Fin 3 → ℤ, x - latticeVector n ∈ centeredCell := by\n  refine ⟨fun i => ⌊x i + 1 / 2⌋, fun i => ?_⟩\n  change -(1 / 2 : ℝ) ≤ x i - (⌊x i + 1 / 2⌋ : ℤ) ∧\n    x i - (⌊x i + 1 / 2⌋ : ℤ) ≤ 1 / 2\n  exact ⟨by linarith [Int.floor_le (x i + 1 / 2)],\n    by linarith [Int.lt_floor_add_one (x i + 1 / 2)]⟩\n\ntheorem isClosed_range_latticeVector : IsClosed (range latticeVector) := by\n  have hrange : range latticeVector =\n      ⋂ i : Fin 3, (fun x : Vec3 => x i) ⁻¹' range (Int.cast : ℤ → ℝ) := by\n    ext x\n    rw [mem_iInter]\n    constructor\n    · rintro ⟨n, rfl⟩ i\n      exact ⟨n i, rfl⟩\n    · intro hx\n      choose n hn using hx\n      refine ⟨n, ?_⟩\n      exact PiLp.ext fun i => hn i\n  rw [hrange]\n  exact isClosed_iInter fun i =>\n    Real.isClosed_range_intCast.preimage (PiLp.continuous_apply 2 (fun _ => ℝ) i)\n\ntheorem isOpen_offOrigin : IsOpen offOrigin :=\n  isClosed_range_latticeVector.isOpen_compl\n\nend TorusEuler\n"}