7661fdee98a6d01f51717c30dafd2bd0188e6e21927/papers/expository.md/sha256:ab0435111b9b88c88a311e4c8ae3a4bf87da34b693e13b740dfbd612d5817571/papers/expository.json/passages/front","query_href":"/api/v1/papers/query?manifest=3d5c85f58611f385ef28c31d799a75b188e968103507f5e4151ff299aa0801d0&paper=expository&passage=front","reading_href":"/api/v1/papers/reading?manifest=3d5c85f58611f385ef28c31d799a75b188e968103507f5e4151ff299aa0801d0&paper=expository&passage=front","span":{"end_byte":1678,"end_line":12,"start_byte":23,"start_line":2},"stage":"expository"}],"lenses":{"consumers":"/api/v1/graph?manifest=3d5c85f58611f385ef28c31d799a75b188e968103507f5e4151ff299aa0801d0&view=arguments&node=quartic.theorem-1&direction=consumers&assumptions=true","direct_passages":"/api/v1/papers/query?manifest=3d5c85f58611f385ef28c31d799a75b188e968103507f5e4151ff299aa0801d0&node=quartic.theorem-1&relation=direct","prerequisite_uses":"/api/v1/papers/query?manifest=3d5c85f58611f385ef28c31d799a75b188e968103507f5e4151ff299aa0801d0&node=quartic.theorem-1&relation=prerequisites","prerequisites":"/api/v1/graph?manifest=3d5c85f58611f385ef28c31d799a75b188e968103507f5e4151ff299aa0801d0&view=arguments&node=quartic.theorem-1&assumptions=true"},"neighborhood_href":"/api/v1/neighborhood?manifest=3d5c85f58611f385ef28c31d799a75b188e968103507f5e4151ff299aa0801d0&ref=sha256%3A64b4bff49f4a37d69616e0b90f4914305cfb20c7c3287b1bc972500c7b211f5d%2Fnodes%2Fquartic.theorem-1","record":{"assumption_ids":[],"boundary":"A result as the authors number it. Its links to the Lean were made with AI for Proof Reader and have not been reviewed by the authors.","citation_ids":["cite.quartic.theorem-1"],"evidence_ids":["link.quartic.theorem-1"],"id":"quartic.theorem-1","kind":"goal","label":"Theorem 1","locator":"Theorem 1, Section 1","source_id":"paper","statement":"**Theorem 1** (OpenAI ([OpenAI 2026](#cite-OpenAI2026), Theorem 1.1)). *For every total Boolean function $f$, $R(f)=O((1+Q(f))^4)$. For each fixed integer $k\\ge2$ there are positive constants $c_k$, $C_k$ and $b_k$ and total Boolean functions $F_{k,m}$, defined for powers of four $m$, such that for all sufficiently large $m$, with $\\ell=\\log_2m$,*\n$$\n Q(F_{k,m})\\le C_k\\sqrt m\\,\\ell^{b_k},\n \\qquad R(F_{k,m})\\ge c_k\\,\\frac{m^{2-1/k}}{\\ell^2}.\n\\tag{1}\n$$\n*Consequently the critical exponent of $R$ relative to $Q$ is four.*","status":"unverified"},"ref":"sha256:64b4bff49f4a37d69616e0b90f4914305cfb20c7c3287b1bc972500c7b211f5d/nodes/quartic.theorem-1","relations":[{"derived":false,"family":"arguments","from":"sha256:64b4bff49f4a37d69616e0b90f4914305cfb20c7c3287b1bc972500c7b211f5d/nodes/quartic.theorem-1","id":"sha256:64b4bff49f4a37d69616e0b90f4914305cfb20c7c3287b1bc972500c7b211f5d/edges/%5B%22quartic.theorem-1%22%2C%22lean.QuarticQuery.theorem_1_1_unconditional%22%2C%22formalizes%22%5D","kind":"formalizes","record_ref":"sha256:64b4bff49f4a37d69616e0b90f4914305cfb20c7c3287b1bc972500c7b211f5d/edges/%5B%22quartic.theorem-1%22%2C%22lean.QuarticQuery.theorem_1_1_unconditional%22%2C%22formalizes%22%5D","semantic_class":"formalization_correspondence","to":"sha256:64b4bff49f4a37d69616e0b90f4914305cfb20c7c3287b1bc972500c7b211f5d/nodes/lean.QuarticQuery.theorem_1_1_unconditional"},{"derived":true,"family":"provenance","from":"sha256:64b4bff49f4a37d69616e0b90f4914305cfb20c7c3287b1bc972500c7b211f5d/nodes/quartic.theorem-1","id":"field:1d0c35416b554a8a7df4bbe9767b57b01740169a8f5da6971b522a5bf38b8b6b","kind":"citation_ids","owner_ref":"sha256:64b4bff49f4a37d69616e0b90f4914305cfb20c7c3287b1bc972500c7b211f5d/nodes/quartic.theorem-1","semantic_class":"provenance_field_reference","source_field":"citation_ids","to":"sha256:64b4bff49f4a37d69616e0b90f4914305cfb20c7c3287b1bc972500c7b211f5d/citations/cite.quartic.theorem-1"},{"derived":true,"family":"provenance","from":"sha256:64b4bff49f4a37d69616e0b90f4914305cfb20c7c3287b1bc972500c7b211f5d/nodes/quartic.theorem-1","id":"field:4a2c2569d5be3839a8b0b0b7a2c1e3c1084f26c6855cedea12dc719c41d34919",