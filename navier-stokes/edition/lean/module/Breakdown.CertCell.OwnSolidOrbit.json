ertCell.CellCalculus","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CertCell.Assembly.Internal.LongPart.label_coefficient_measurable","Breakdown.CertCell.Assembly.Internal.LongPart.long_parseval","Breakdown.CertCell.Assembly.Internal.ModelPart.modelStage_of_point","Breakdown.CertCell.Assembly.Internal.error_pointwise","Breakdown.CertCell.Assembly.Internal.labelVel_measurable_of_offAxis","Breakdown.CertCell.Assembly.rowIdentity_entry"],"proof_uses":["Breakdown.CellCert.CellAnalysis.IsCellBox.r_order","Breakdown.CertCell.IsCellMesh.boxes_apart"],"protected":false,"short":"ae_own_point","signature_end_line":47,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CellCert.CellAnalysis.CellBox.rect","Breakdown.CertCell.CellMesh","Breakdown.CertCell.CellMesh.box","Breakdown.CertCell.CellMesh.count","Breakdown.CertCell.IsCellMesh"],"used_by":["Breakdown.CertCell.Assembly.Internal.LongPart.label_coefficient_measurable","Breakdown.CertCell.Assembly.Internal.LongPart.long_parseval","Breakdown.CertCell.Assembly.Internal.ModelPart.modelStage_of_point","Breakdown.CertCell.Assembly.Internal.error_pointwise","Breakdown.CertCell.Assembly.Internal.labelVel_measurable_of_offAxis","Breakdown.CertCell.Assembly.rowIdentity_entry"],"uses":["Breakdown.CellCert.CellAnalysis.CellBox.rect","Breakdown.CellCert.CellAnalysis.IsCellBox.r_order","Breakdown.CertCell.CellMesh","Breakdown.CertCell.CellMesh.box","Breakdown.CertCell.CellMesh.count","Breakdown.CertCell.IsCellMesh","Breakdown.CertCell.IsCellMesh.boxes_apart"],"written":"ae_own_point"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":78,"kind":"theorem","line":70,"module":"Breakdown.CertCell.OwnSolidOrbit","name":"Breakdown.CertCell.CellCalculus.ae_off_plane","namespace":"Breakdown.CertCell.CellCalculus","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CertCell.Assembly.Internal.LongPart.label_coefficient_measurable","Breakdown.CertCell.Assembly.Internal.LongPart.long_parseval","Breakdown.CertCell.Assembly.Internal.error_pointwise","Breakdown.CertCell.Assembly.Internal.labelVel_measurable_of_offAxis"],"proof_uses":[],"protected":false,"short":"ae_off_plane","signature_end_line":70,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CellCert.CellAnalysis.CellBox","Breakdown.CellCert.CellAnalysis.CellBox.rect"],"used_by":["Breakdown.CertCell.Assembly.Internal.LongPart.label_coefficient_measurable","Breakdown.CertCell.Assembly.Internal.LongPart.long_parseval","Breakdown.CertCell.Assembly.Internal.error_pointwise","Breakdown.CertCell.Assembly.Internal.labelVel_measurable_of_offAxis"],"uses":["Breakdown.CellCert.CellAnalysis.CellBox","Breakdown.CellCert.CellAnalysis.CellBox.rect"],"written":"ae_off_plane"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":81,"kind":"theorem","line":80,"module":"Breakdown.CertCell.OwnSolidOrbit","name":"Breakdown.CertCell.CellCalculus.orbit_height","namespace":"Breakdown.CertCell.CellCalculus","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CertCell.Assembly.Internal.LongPart.orbit_offAxis","Breakdown.CertCell.Assembly.Internal.orbit_offAxis_mem"],"proof_uses":["Breakdown.CertCell.CellCalculus.orbit_coords"],"protected":false,"short":"orbit_height","signature_end_line":80,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CellCert.CellAnalysis.cylHeight","Breakdown.CertCell.planePoint","Breakdown.axialRot"],"used_by":["Breakdown.CertCell.Assembly.Internal.LongPart.orbit_offAxis","Breakdown.CertCell.Assembly.Internal.orbit_offAxis_mem"],"uses":["Breakdown.CellCert.CellAnalysis.cylHeight","Breakdown.CertCell.CellCalculus.orbit_coords","Breakdown.CertCell.planePoint","Breakdown.axialRot"],"written":"orbit_height"}],"imports":["Breakdown.CertCell.CellCalculusStatements","Breakdown.CertCell.AssemblyPotentialModelFrameFactsAlgebra"],"module":"Breakdown.CertCell.OwnSolidOrbit","path":"Breakdown/CertCell/OwnSolidOrbit.lean","sha256":"a1998be4f7d6fbb1d72c91b674e320c175abfded93a38223528c38b58179692c","source":"import Breakdown.CertCell.CellCalculusStatements\nimport Breakdown.CertCell.AssemblyPotentialModelFrameFactsAlgebra\n\nopen MeasureTheory\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace CertCell\n\nnamespace CellCalculus\n\nopen CellCert.CellAnalysis Assembly.Internal Bridge.Internal.MeanStretch Coercive.Internal.ModeRotation\n  Coercive.StretchInternal Coercive.RotationInternal\n\ntheorem orbit_coords (φ : ℝ) (p : ℝ × ℝ) :\n    axialRot φ (planePoint p) 0 = Real.cos φ * p.1 ∧ axialRot φ (planePoint p) 1 = Real.sin φ * p.1 ∧\n      axialRot φ (planePoint p) 2 = p.2 := by\n  refine ⟨?_, ?_, ?_⟩ <;> simp [axialRot, planePoint, cylPoint, unitVector]\n\ntheorem orbit_radius (φ : ℝ) (p : ℝ × ℝ) (h1 : 0 ≤ p.1) :\n    CellCert.CellAnalysis.cylRadius (axialRot φ (planePoint p)) = p.1 := by\n  obtain ⟨c0, c1, _⟩ := orbit_coords φ p\n  unfold CellCert.CellAnalysis.cylRadius\n  rw [c0, c1, show (Real.cos φ * p.1) ^ 2 + (Real.sin φ * p.1) ^ 2 = p.1 ^ 2 by\n    nlinarith [Real.sin_sq_add_cos_sq φ], Real.sqrt_sq h1]\n\ntheorem orbit_mem_solid_iff (L : CellBox) (φ : ℝ) (p : ℝ × ℝ) (h1 : 0 ≤ p.1) (h2 : 0 ≤ p.2) :\n    axialRot φ (planePoint p) ∈ L.solid ↔ p ∈ L.rect := by\n  obtain ⟨_, _, c2⟩ := orbit_coords φ p\n  have hr := orbit_radius φ p h1\n  unfold CellBox.solid CellBox.rect\n  simp only [Set.mem_ofPred_eq, Set.mem_prod, Set.mem_Icc]\n  rw [hr, show CellCert.CellAnalysis.cylHeight (axialRot φ (planePoint p)) = p.2 from c2, abs_of_nonneg h2]\n  tauto\n\ntheorem orbit_mem_ownSolid {count : ℕ} (box : Fin count → CellBox) (K : Fin count) (hK : IsCellBox (box K))\n    (p : ℝ × ℝ) (hp : p ∈ (box K).rect) (hpos : 0 < p.1) (hL : ∀ L, L ≠ K → p ∉ (box L).rect) (φ : ℝ) :\n    axialRot φ (planePoint p) ∈ ownSolid box K := by\n  have h2 : 0 ≤ p.2 := hK.z_order.1.trans hp.2.1\n  refine ⟨(orbit_mem_solid_iff _ φ p hpos.le h2).2 hp, ?_, fun L hLK h => hL L hLK ?_⟩\n  · rw [orbit_radius φ p hpos.le]; exact hpos\n  · exact (orbit_mem_solid_iff _ φ p hpos.le h2).1 h\n\ntheorem ae_own_point (M : CellMesh) (hM : IsCellMesh M) (K : Fin M.count) :\n    ∀ᵐ p ∂(volume.restrict (M.box K).rect), 0 < p.1 ∧ ∀ L, L ≠ K → p ∉ (M.box L).rect := by\n  have hbox := hM.box_valid K\n  have hmeas : ∀ L, MeasurableSet (M.box L).rect := fun L => measurableSet_Icc.prod measurableSet_Icc\n  have hax : ∀ᵐ p ∂(volume : Measure (ℝ × ℝ)), p.1 ≠ 0 := by\n    rw [ae_iff]\n    simp only [not_not]\n    have e : {p : ℝ × ℝ | p.1 = 0} = {0} ×ˢ Set.univ := by\n      ext\n      simp\n    rw [e, Measure.volume_eq_prod, Measure.prod_prod]\n    simp\n  have hapart : ∀ᵐ p ∂(volume.restrict (M.box K).rect), ∀ L, L ≠ K → p ∉ (M.box L).rect := by\n    rw [ae_all_iff]\n    intro L\n    by_cases hLK : L = K\n    · exact Filter.Eventually.of_forall fun p h => absurd hLK h\n    · have h0 : volume.restrict (M.box K).rect (M.box L).rect = 0 := by\n        rw [Measure.restrict_apply (hmeas L), Set.inter_comm]\n        exact hM.boxes_apart K L (Ne.symm hLK)\n      filter_upwards [measure_eq_zero_iff_ae_notMem.1 h0] with p hp _ using hp\n  filter_upwards [ae_restrict_mem (hmeas K), ae_restrict_of_ae hax, hapart] with p hpK hp0 hpL\n  exact ⟨lt_of_le_of_ne (hbox.r_order.1.trans hpK.1.1) (Ne.symm hp0), hpL⟩\n\ntheorem ae_off_plane (B : CellBox) : ∀ᵐ p ∂(volume.restrict B.rect), p.2 ≠ 0 := by\n  refine ae_restrict_of_ae ?_\n  rw [ae_iff]\n  simp only [not_not]\n  have e : {p : ℝ × ℝ | p.2 = 0} = Set.univ ×ˢ {0} := by\n    ext\n    simp\n  rw [e, Measure.volume_eq_prod, Measure.prod_prod]\n  simp\n\ntheorem orbit_height (φ : ℝ) (p : ℝ × ℝ) : CellCert.CellAnalysis.cylHeight (axialRot φ (planePoint p)) = p.2 :=\n  (orbit_coords φ p).2.2\n\nend CellCalculus\n\nend CertCell\n\nend Breakdown\n"}