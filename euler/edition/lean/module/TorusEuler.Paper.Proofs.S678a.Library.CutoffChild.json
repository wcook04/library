uler.Paper.Lib.S678a.isTruncation_of_cutoffChild","TorusEuler.Paper.Lib.S678a.scheduled_T2_T3'","TorusEuler.Paper.Lib.S678a.scheduled_bounds_of_5_11","TorusEuler.Paper.Lib.S678a.scheduled_increment'","TorusEuler.Paper.Lib.S678a.tailTwo_of_tails","TorusEuler.Paper.Lib.S678a.tails_of_lemma_B_1"],"uses":["TorusEuler.Paper.Lib.S678a.CutoffChild","TorusEuler.Paper.Lib.S678a.CutoffChild.torusVelocity","TorusEuler.Vec3","TorusEuler.Velocity","TorusEuler.toUnitTorus"],"written":"velocity"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":"The true momentum residual computed using the selected pressure.","end_line":62,"kind":"def","line":61,"module":"TorusEuler.Paper.Proofs.S678a.Library.CutoffChild","name":"TorusEuler.Paper.Lib.S678a.CutoffChild.residual","namespace":"TorusEuler.Paper.Lib.S678a.CutoffChild","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"residual","signature_end_line":61,"sorry":false,"statement_used_by":["TorusEuler.Paper.Lib.S678a.InductiveEulerStage.ofCutoffChild","TorusEuler.Paper.Lib.S678a.InductiveEulerStage.ofCutoffChild_pressure","TorusEuler.Paper.Lib.S678a.InductiveEulerStage.ofCutoffChild_velocity","TorusEuler.Paper.Lib.S678a.exists_inductiveEulerChild_of_physicalCutoff'","TorusEuler.Paper.Lib.S678a.scheduled_T2_T3'","TorusEuler.Paper.Lib.S678a.scheduled_bounds_of_5_11"],"statement_uses":["TorusEuler.Paper.Lib.S678a.CutoffChild","TorusEuler.Paper.Lib.S678a.CutoffChild.pressure","TorusEuler.Paper.Lib.S678a.CutoffChild.velocity","TorusEuler.Vec3","TorusEuler.Velocity","TorusEuler.momentumResidual"],"used_by":["TorusEuler.Paper.Lib.S678a.InductiveEulerStage.ofCutoffChild","TorusEuler.Paper.Lib.S678a.InductiveEulerStage.ofCutoffChild_pressure","TorusEuler.Paper.Lib.S678a.InductiveEulerStage.ofCutoffChild_velocity","TorusEuler.Paper.Lib.S678a.exists_inductiveEulerChild_of_physicalCutoff'","TorusEuler.Paper.Lib.S678a.scheduled_T2_T3'","TorusEuler.Paper.Lib.S678a.scheduled_bounds_of_5_11"],"uses":["TorusEuler.Paper.Lib.S678a.CutoffChild","TorusEuler.Paper.Lib.S678a.CutoffChild.pressure","TorusEuler.Paper.Lib.S678a.CutoffChild.velocity","TorusEuler.Vec3","TorusEuler.Velocity","TorusEuler.momentumResidual"],"written":"residual"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":"The velocity of a cutoff child is spatially periodic at every time.","end_line":67,"kind":"theorem","line":65,"module":"TorusEuler.Paper.Proofs.S678a.Library.CutoffChild","name":"TorusEuler.Paper.Lib.S678a.CutoffChild.periodic_velocity","namespace":"TorusEuler.Paper.Lib.S678a.CutoffChild","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":["TorusEuler.toUnitTorus_eq_iff"],"protected":false,"short":"periodic_velocity","signature_end_line":65,"sorry":false,"statement_used_by":[],"statement_uses":["TorusEuler.Paper.Lib.S678a.CutoffChild","TorusEuler.Paper.Lib.S678a.CutoffChild.velocity","TorusEuler.SpatiallyPeriodic","TorusEuler.Vec3","TorusEuler.Velocity"],"used_by":[],"uses":["TorusEuler.Paper.Lib.S678a.CutoffChild","TorusEuler.Paper.Lib.S678a.CutoffChild.velocity","TorusEuler.SpatiallyPeriodic","TorusEuler.Vec3","TorusEuler.Velocity","TorusEuler.toUnitTorus_eq_iff"],"written":"periodic_velocity"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":"The velocity of a cutoff child is the real Fourier cutoff of its approximate torus field.","end_line":72,"kind":"theorem","line":70,"module":"TorusEuler.Paper.Proofs.S678a.Library.CutoffChild","name":"TorusEuler.Paper.Lib.S678a.CutoffChild.velocity_eq_cutoff","namespace":"TorusEuler.Paper.Lib.S678a.CutoffChild","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"velocity_eq_cutoff","signature_end_line":71,"sorry":false,"statement_used_by":[],"statement_uses":["TorusEuler.Paper.Lib.S678a.CutoffChild","TorusEuler.Paper.Lib.S678a.CutoffChild.approximateTorus","TorusEuler.Paper.Lib.S678a.CutoffChild.velocity","TorusEuler.Vec3","TorusEuler.Velocity","TorusEuler.realVectorFourierCutoff","TorusEuler.toUnitTorus"],"used_by":[],"uses":["TorusEuler.Paper.Lib.S678a.CutoffChild","TorusEuler.Paper.Lib.S678a.CutoffChild.approximateTorus","TorusEuler.Paper.Lib.S678a.CutoffChild.velocity","TorusEuler.Vec3","TorusEuler.Velocity","TorusEuler.realVectorFourierCutoff","TorusEuler.toUnitTorus"],"written":"velocity_eq_cutoff"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":"**The cutoff child exists** (the construction of `u = S_Λ V` and of its zero-mean pressure in\nProposition 5.11, sections/08_exact_wave.tex:379-416, without the display (5.58)). The facts (T1) of\n`u` (smooth, odd, divergence free, frequencies at most `2Λ`) are the first conclusion clause of\nProposition 5.11 (`hT1`), applied to a truncation `(u₀, p₀)` obtained from its existence clause\n(`hex`); the remaining glue is the torus lift of `V`, the identification of the lifted cutoff with\n`u₀`, the joint smoothness of the Poisson pressure (`exists_truncatedParentPoissonPressure`) and the\nLeray identity.","end_line":147,"kind":"theorem","line":83,"module":"TorusEuler.Paper.Proofs.S678a.Library.CutoffChild","name":"TorusEuler.Paper.Lib.S678a.exists_cutoffChild","namespace":"TorusEuler.Paper.Lib.S678a","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["TorusEuler.Paper.Lib.S678a.exists_child_of_section5"],"proof_uses":["TorusEuler.Paper.Bridge.torusField_eq_of_lift","TorusEuler.SpatiallyPeriodic.exists_continuousTorusFunction","TorusEuler.exists_truncatedParentPoissonPressure","TorusEuler.finiteFourierSum","TorusEuler.periodicRealPartVector","TorusEuler.realVectorFourierCutoff","TorusEuler.smoothFourierCutoff"],"protected":false,"short":"exists_cutoffChild","signature_end_line":93,"sorry":false,"statement_used_by":[],"statement_uses":["TorusEuler.Paper.Lib.S678a.CutoffChild","TorusEuler.Paper.S5.IsTruncation","TorusEuler.Pressure","TorusEuler.RealTorusFourierBand","TorusEuler.SpatiallyPeriodic","TorusEuler.Vec3","TorusEuler.Velocity","TorusEuler.divergence","TorusEuler.toUnitTorus"],"used_by":["TorusEuler.Paper.Lib.S678a.exists_child_of_section5"],"uses":["TorusEuler.Paper.Bridge.torusField_eq_of_lift","TorusEuler.Paper.Lib.S678a.CutoffChild","TorusEuler.Paper.S5.IsTruncation","TorusEuler.Pressure","TorusEuler.RealTorusFourierBand","TorusEuler.SpatiallyPeriodic","TorusEuler.SpatiallyPeriodic.exists_continuousTorusFunction","TorusEuler.Vec3","TorusEuler.Velocity","TorusEuler.divergence","TorusEuler.exists_truncatedParentPoissonPressure","TorusEuler.finiteFourierSum","TorusEuler.periodicRealPartVector","TorusEuler.realVectorFourierCutoff","TorusEuler.smoothFourierCutoff","TorusEuler.toUnitTorus"],"written":"exists_cutoffChild"}],"imports":["TorusEuler.TruncatedParentAdmissibility","TorusEuler.TruncatedParentPoissonPressure","TorusEuler.Paper.SBD.Statements","TorusEuler.Paper.Proofs.S5Bridge.Norms","TorusEuler.Paper.Proofs.S5Bridge.Children","TorusEuler.TruncatedChildStage"],"module":"TorusEuler.Paper.Proofs.S678a.Library.CutoffChild","path":"TorusEuler/Paper/Proofs/S678a/Library/CutoffChild.lean","sha256":"098050de1c5d03e7f6679d79d7d352353b93e5623a0abefb9a2d17a5c09fc4c6","source":"import TorusEuler.TruncatedParentAdmissibility\nimport TorusEuler.TruncatedParentPoissonPressure\nimport TorusEuler.Paper.SBD.Statements\nimport TorusEuler.Paper.Proofs.S5Bridge.Norms\nimport TorusEuler.Paper.Proofs.S5Bridge.Children\nimport TorusEuler.TruncatedChildStage\n\n/-! # The cutoff child of a step (package S678a)\n\nOwn glue of row 7.1 (item 4 of the proof, sections/08b_induction.tex:376-381; the truncation (5.55) of\nProposition 5.11, sections/08_exact_wave.tex:379-416).\n\n`CutoffChild` is `TruncatedChildStage` (TruncatedChildStage.lean:234) without its three fields about\nthe residual of the approximate velocity (`approximateResidualTorus`, `approximateResidual_rep` and\n`residual_cutoff`, the identity (5.58) of the proof of Proposition 5.11, which the proof of Theorem 7.1\ndoes not use). `exists_cutoffChild` builds it from the clauses (T1) of Proposition 5.11 (hypotheses) and\n`exists_truncatedParentPoissonPressure`, which reaches no content lemma. -/\n\nopen Filter MeasureTheory Set UnitAddTorus\nopen scoped ContDiff InnerProductSpace\n\nlocal notation \"Labels\" => UnitAddTorus (Fin 3)\n\nnamespace TorusEuler.Paper.Lib.S678a\n\nopen TorusEuler\n\nnoncomputable section\n\n/-- `TruncatedChildStage` without the fields `approximateResidualTorus`, `approximateResidual_rep`,\n`residual_cutoff`. -/\nstructure CutoffChild (T Λ : ℝ) (ψ : Vec3 → ℝ) (V : Velocity) where\n  approximateTorus : ℝ → C(Labels, Vec3)\n  torusVelocity : ℝ → C(Labels, Vec3)\n  pressure : Pressure\n  approximate_rep : ∀ t ∈ Icc 0 T, ∀ x, approximateTorus t (toUnitTorus x) = V t x\n  cutoff : ∀ t z, torusVelocity t z = realVectorFourierCutoff ψ Λ (approximateTorus t) z\n  smooth_velocity : ContDiffOn ℝ ∞ (fun z : ℝ × Vec3 => torusVelocity z.1 (toUnitTorus z.2))\n    (Icc 0 T ×ˢ (univ : Set Vec3))\n  odd_velocity : ∀ t ∈ Icc 0 T, Function.Odd (fun x => torusVelocity t (toUnitTorus x))\n  divergence_free : ∀ t ∈ Icc 0 T, ∀ x, divergence (fun y => torusVelocity t (toUnitTorus y)) x = 0\n  velocity_band : ∀ t ∈ Icc 0 T, RealTorusFourierBand (2 * Λ) (torusVelocity t)\n  smooth_pressure : ContDiffOn ℝ ∞ (Function.uncurry pressure) (Icc 0 T ×ˢ (univ : Set Vec3))\n  periodic_pressure : ∀ t ∈ Icc 0 T, SpatiallyPeriodic (pressure t)\n  mean_zero_pressure : ∀ t ∈ Icc 0 T, (∫ x in centeredCell, pressure t x) = 0\n  poisson : ∀ t ∈ Icc 0 T, ∀ x, divergence (gradient (pressure t)) x =\n    -LinearMap.trace ℝ Vec3 ((fderiv ℝ (fun y => torusVelocity t (toUnitTorus y)) x).comp\n      (fderiv ℝ (fun y => torusVelocity t (toUnitTorus y)) x)).toLinearMap\n  projected_eq : ∀ t ∈ Icc 0 T,\n    momentumResidual (Icc 0 T) (fun r x => torusVelocity r (toUnitTorus x)) pressure t =\n      closedSlabLerayMomentum 0 T (fun r x => torusVelocity r (toUnitTorus x)) t\n\nnamespace CutoffChild\n\nvariable {T Λ : ℝ} {ψ : Vec3 → ℝ} {V : Velocity}\n\n/-- Real velocity on the Euclidean lift. -/\ndef velocity (s : CutoffChild T Λ ψ V) : Velocity := fun t x => s.torusVelocity t (toUnitTorus x)\n\n/-- The true momentum residual computed using the selected pressure. -/\ndef residual (s : CutoffChild T Λ ψ V) : Velocity :=\n  momentumResidual (Icc 0 T) s.velocity s.pressure\n\n/-- The velocity of a cutoff child is spatially periodic at every time. -/\ntheorem periodic_velocity (s : CutoffChild T Λ ψ V) (t : ℝ) : SpatiallyPeriodic (s.velocity t) := by\n  intro n x\n  exact congrArg (s.torusVelocity t) ((toUnitTorus_eq_iff _ _).mpr ⟨n, rfl⟩)\n\n/-- The velocity of a cutoff child is the real Fourier cutoff of its approximate torus field. -/\ntheorem velocity_eq_cutoff (s : CutoffChild T Λ ψ V) (t : ℝ) :\n    s.velocity t = fun x => realVectorFourierCutoff ψ Λ (s.approximateTorus t) (toUnitTorus x) :=\n  funext fun x => s.cutoff t (toUnitTorus x)\n\nend CutoffChild\n\n/-- **The cutoff child exists** (the construction of `u = S_Λ V` and of its zero-mean pressure in\nProposition 5.11, sections/08_exact_wave.tex:379-416, without the display (5.58)). The facts (T1) of\n`u` (smooth, odd, divergence free, frequencies at most `2Λ`) are the first conclusion clause of\nProposition 5.11 (`hT1`), applied to a truncation `(u₀, p₀)` obtained from its existence clause\n(`hex`); the remaining glue is the torus lift of `V`, the identification of the lifted cutoff with\n`u₀`, the joint smoothness of the Poisson pressure (`exists_truncatedParentPoissonPressure`) and the\nLeray identity. -/\ntheorem exists_cutoffChild {T Λ : ℝ} (hT : 0 < T) {V : Velocity}\n    (hV : ContDiffOn ℝ ∞ (Function.uncurry V) (Icc 0 T ×ˢ (univ : Set Vec3)))\n    (hVper : ∀ t ∈ Icc 0 T, SpatiallyPeriodic (V t))\n    {ψ : Vec3 → ℝ}\n    (hex : ∃ (u : Velocity) (p : Pressure), S5.IsTruncation T ψ Λ V u p)\n    (hT1 : ∀ (u : Velocity) (p : Pressure), S5.IsTruncation T ψ Λ V u p →\n      ContDiffOn ℝ ∞ (Function.uncurry u) (Icc 0 T ×ˢ (univ : Set Vec3)) ∧\n        ∀ t ∈ Icc 0 T, Function.Odd (u t) ∧ (∀ x, divergence (u t) x = 0) ∧\n          ∃ c : C(UnitAddTorus (Fin 3), Vec3),\n            (∀ x, c (toUnitTorus x) = u t x) ∧ RealTorusFourierBand (2 * Λ) c) :\n    Nonempty (CutoffChild T Λ ψ V) := by\n  classical\n  have hslice (t : ℝ) (ht : t ∈ Icc 0 T) : ContDiff ℝ ∞ (V t) := by\n    have hj : ContDiff ℝ ∞ (fun x : Vec3 => (t, x)) := contDiff_const.prodMk contDiff_id\n    exact contDiffOn_univ.1 (hV.comp hj.contDiffOn (fun x _ => ⟨ht, mem_univ x⟩))\n  have hExists (t : ℝ) (ht : t ∈ Icc 0 T) :\n      ∃ u : C(UnitAddTorus (Fin 3), Vec3), ∀ x, u (toUnitTorus x) = V t x :=\n    (hVper t ht).exists_continuousTorusFunction (hslice t ht).continuous\n  let gV (t : ℝ) : C(UnitAddTorus (Fin 3), Vec3) :=\n    if ht : t ∈ Icc 0 T then (hExists t ht).choose else 0\n  have hgV (t : ℝ) (ht : t ∈ Icc 0 T) (x : Vec3) : gV t (toUnitTorus x) = V t x := by\n    simp only [gV, dite_eq_left ht]\n    exact (hExists t ht).choose_spec x\n  let U (t : ℝ) : C(Labels, Vec3) := by\n    refine ⟨realVectorFourierCutoff ψ Λ (gV t), periodicRealPartVector.continuous.comp ?_⟩\n    unfold smoothFourierCutoff finiteFourierSum\n    exact continuous_finsetSum _ fun k _ => (mFourier k).continuous.smul continuous_const\n  obtain ⟨u₀, p₀, hTr⟩ := hex\n  have hu₀ (t : ℝ) (ht : t ∈ Icc 0 T) (x : Vec3) : u₀ t x = U t (toUnitTorus x) :=\n    hTr.cutoff t ht (gV t) (hgV t ht) x\n  obtain ⟨hs₀, hprop⟩ := hT1 u₀ p₀ hTr\n  have hs : ContDiffOn ℝ ∞ (fun z : ℝ × Vec3 => U z.1 (toUnitTorus z.2))\n      (Icc 0 T ×ˢ (univ : Set Vec3)) :=\n    hs₀.congr fun z hz => (hu₀ z.1 hz.1 z.2).symm\n  have hBand : ∀ t ∈ Icc 0 T, RealTorusFourierBand (2 * Λ) (U t) := by\n    intro t ht\n    obtain ⟨-, -, c, hc, hband⟩ := hprop t ht\n    have hceq : c = U t :=\n      Bridge.torusField_eq_of_lift fun y => (hc y).trans (hu₀ t ht y)\n    rw [← hceq]\n    exact hband\n  have hDiv : ∀ t ∈ Icc 0 T, ∀ x, divergence (fun y => U t (toUnitTorus y)) x = 0 := by\n    intro t ht x\n    have : (fun y => U t (toUnitTorus y)) = u₀ t := funext fun y => (hu₀ t ht y).symm\n    rw [this]\n    exact (hprop t ht).2.1 x\n  obtain ⟨p, hp, hP⟩ := exists_truncatedParentPoissonPressure hT U hs hBand hDiv\n  exact ⟨{\n    approximateTorus := gV\n    torusVelocity := U\n    pressure := p\n    approximate_rep := hgV\n    cutoff := fun _ _ => rfl\n    smooth_velocity := hs\n    odd_velocity := fun t ht => by\n      have : (fun y => U t (toUnitTorus y)) = u₀ t := funext fun y => (hu₀ t ht y).symm\n      rw [this]\n      exact (hprop t ht).1\n    divergence_free := hDiv\n    velocity_band := hBand\n    smooth_pressure := hp\n    periodic_pressure := fun t ht => (hP t ht).1\n    mean_zero_pressure := fun t ht => (hP t ht).2.1\n    poisson := fun t ht => (hP t ht).2.2.1\n    projected_eq := fun t ht => (hP t ht).2.2.2 }⟩\n\nend\n\nend TorusEuler.Paper.Lib.S678a\n"}