null,"end_line":62,"kind":"def","line":58,"module":"Breakdown.Torus.StatementsShell","name":"Breakdown.Periodic.FreeHeatComparison","namespace":"Breakdown.Periodic","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"FreeHeatComparison","signature_end_line":58,"sorry":false,"statement_used_by":["Breakdown.Periodic.CompareSeedAssembly.Internal.slot_bound","Breakdown.Periodic.comparisonSmall","Breakdown.Periodic.freeHeatComparison","Breakdown.Periodic.freeHeatComparison_of","Breakdown.Periodic.seedComparison"],"statement_uses":["Breakdown.Freq.CSpace","Breakdown.Freq.L2C","Breakdown.Freq.L2R","Breakdown.Freq.L6R","Breakdown.Freq.X","Breakdown.Freq.embedX","Breakdown.Freq.factOneLeSix","Breakdown.Freq.heatX","Breakdown.IsTestField","Breakdown.Periodic.Coef","Breakdown.Periodic.Lattice","Breakdown.Periodic.Seq","Breakdown.Periodic.ShellData","Breakdown.Periodic.V","Breakdown.Periodic.heat","Breakdown.Periodic.restrictR3","Breakdown.Periodic.restrictTorus","Breakdown.Periodic.toV","Breakdown.Periodic.transplantField","Breakdown.Space"],"used_by":["Breakdown.Periodic.CompareSeedAssembly.Internal.slot_bound","Breakdown.Periodic.comparisonSmall","Breakdown.Periodic.freeHeatComparison","Breakdown.Periodic.freeHeatComparison_of","Breakdown.Periodic.seedComparison"],"uses":["Breakdown.Freq.CSpace","Breakdown.Freq.L2C","Breakdown.Freq.L2R","Breakdown.Freq.L6R","Breakdown.Freq.X","Breakdown.Freq.embedX","Breakdown.Freq.factOneLeSix","Breakdown.Freq.heatX","Breakdown.IsTestField","Breakdown.Periodic.Coef","Breakdown.Periodic.Lattice","Breakdown.Periodic.Seq","Breakdown.Periodic.ShellData","Breakdown.Periodic.V","Breakdown.Periodic.heat","Breakdown.Periodic.restrictR3","Breakdown.Periodic.restrictTorus","Breakdown.Periodic.toV","Breakdown.Periodic.transplantField","Breakdown.Space"],"written":"FreeHeatComparison"}],"imports":["Breakdown.Torus.ShellDefs"],"module":"Breakdown.Torus.StatementsShell","path":"Breakdown/Torus/StatementsShell.lean","sha256":"e399ae20aa421e424dd7d7139ff1e378fdb3dc25260f6282ac44964e182cb542","source":"import Breakdown.Torus.ShellDefs\n\nopen MeasureTheory Set Real\nopen scoped ENNReal ContDiff\n\nnoncomputable section\n\nnamespace Breakdown.Periodic\n\ndef TorusSeriesSmooth : Prop :=\n  ∀ f : Space → Space, ContDiff ℝ ∞ f → IsPeriodic f → (∀ x, divergenceAt f x = 0) →\n    (torusSeries 2 (coeff (toV f)) : Space → Coef) =ᵐ[volume.restrict cell] (fun x => complexify (f x)) ∧\n    (torusSeries 6 (coeff (toV f)) : Space → Coef) =ᵐ[volume.restrict cell] (fun x => complexify (f x)) ∧\n    ∀ j, (torusSeries 2 (gradCoef j (toV f)) : Space → Coef) =ᵐ[volume.restrict cell]\n      (fun x => complexify (fderiv ℝ f x (unitVector j)))\n\ndef RestrictR3Bound : Prop := ∃ C : ℝ, 0 ≤ C ∧ ∀ b : ℝ, ‖restrictR3 b‖ ≤ C\n\ndef R3Factor : Prop :=\n  ∀ (φ : Space → Space) (hφ : IsTestField φ) (b : ℝ), tsupport φ ⊆ Metric.closedBall 0 b →\n    ∀ τ : ℝ, 0 < τ → ∀ v : Freq.X,\n      (2 : ℝ) • Freq.bilinX τ (Freq.embedX φ) v = lambdaR3 φ hφ b τ (restrictR3 b v)\n\ndef R3LambdaBound : Prop :=\n  ∃ C : ℝ, 0 ≤ C ∧ ∀ (φ : Space → Space) (hφ : IsTestField φ) (b τ : ℝ), 0 < τ → ∀ ζ : ShellData,\n    ‖lambdaR3 φ hφ b τ ζ‖ ≤ C * τ ^ (-(3 / 4 : ℝ)) * ‖Freq.embedX φ‖ * ‖ζ‖\n\ndef TorusFactor : Prop :=\n  ∀ (φ : Space → Space) (hφ : IsTestField φ) (b μ : ℝ), IsShellScale μ b →\n    tsupport φ ⊆ Metric.closedBall 0 b → ∀ τ : ℝ, 0 < τ → ∀ z : V,\n      (2 * μ ^ (3 / 4 : ℝ)) • kernel (μ * τ) ((μ ^ (1 / 4 : ℝ)) • toV (transplantField μ φ)) z =\n        lambdaTorus φ hφ b μ τ (restrictTorus μ b z)\n\ndef TorusLambdaBound : Prop :=\n  ∃ C : ℝ, 0 ≤ C ∧ ∀ (φ : Space → Space) (hφ : IsTestField φ) (b μ τ : ℝ), IsShellScale μ b →\n    0 < τ → μ * τ ≤ 1 → ∀ ζ : ShellData,\n      ‖lambdaTorus φ hφ b μ τ ζ‖ ≤ C * τ ^ (-(3 / 4 : ℝ)) * ‖Freq.embedX φ‖ * ‖ζ‖\n\ndef TransplantNorm : Prop :=\n  ∀ (g : Space → Space) (μ b : ℝ), ContDiff ℝ ∞ g → (∀ x, divergenceAt g x = 0) → IsShellScale μ b →\n    tsupport g ⊆ Metric.closedBall 0 b →\n      ‖(μ ^ (1 / 4 : ℝ)) • toV (transplantField μ g)‖ ^ 2 =\n        (∫ y, ∑ i : Fin 3, ‖fderiv ℝ g y (unitVector i)‖ ^ 2) + μ * ∫ y, ‖g y‖ ^ 2\n\ndef TransplantSmooth : Prop :=\n  ∀ (g : Space → Space) (μ b : ℝ), ContDiff ℝ ∞ g → (∀ x, divergenceAt g x = 0) → IsShellScale μ b →\n    tsupport g ⊆ Metric.closedBall 0 b →\n      ContDiff ℝ ∞ (transplantField μ g) ∧ IsPeriodic (transplantField μ g) ∧\n        (∀ x, divergenceAt (transplantField μ g) x = 0) ∧\n        ∀ x, dist x center ≤ 1 / 4 → transplantField μ g x = (Real.sqrt μ)⁻¹ • g ((Real.sqrt μ)⁻¹ • (x - center))\n\ndef HeatDivFreeComparison : Prop :=\n  ∀ b b' ε δ : ℝ, 0 < b → 0 < b' → 0 < ε → 0 < δ → ∃ μ₀ : ℝ, 0 < μ₀ ∧ ∀ μ : ℝ, 0 < μ → μ < μ₀ →\n    ∀ τ ∈ Icc ε ε⁻¹, ∀ A : Freq.L2R, (∀ᵐ y ∂volume, y ∉ Metric.closedBall (0 : Space) b' → A y = 0) →\n      ‖restrictTorus μ b ((μ ^ (-(1 / 4 : ℝ))) • sourceOp μ τ A) - restrictR3 b (Freq.heatDivFree τ A)‖ ≤\n        δ * (eLpNorm (A : Space → Space) (3 / 2) volume).toReal\n\ndef FreeHeatComparison : Prop :=\n  ∀ (φ : Space → Space), IsTestField φ → ∀ b ε δ : ℝ, 0 < b → 0 < ε → 0 < δ →\n    ∃ μ₀ : ℝ, 0 < μ₀ ∧ ∀ μ : ℝ, 0 < μ → μ < μ₀ → ∀ τ ∈ Icc 0 ε⁻¹,\n      ‖restrictTorus μ b ((μ ^ (1 / 4 : ℝ)) • heat (μ * τ) (toV (transplantField μ φ))) -\n        restrictR3 b (Freq.heatX τ (Freq.embedX φ))‖ ≤ δ\n\nend Breakdown.Periodic\n"}