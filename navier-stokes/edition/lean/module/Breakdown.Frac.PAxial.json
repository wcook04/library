"doc":null,"end_line":161,"kind":"theorem","line":149,"module":"Breakdown.Frac.PAxial","name":"Breakdown.axialRotationSpec","namespace":"Breakdown","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.FracCert.DecayFarField.Internal.rot_clm_cont","Breakdown.FracCert.DecayFarField.Internal.rot_symm_clm_cont","Breakdown.FracCert.FarFieldAddInternal.integrand_measurable","Breakdown.FracCert.FarFieldAddInternal.meas_rot","Breakdown.FracCert.FarFieldGradientFreeInternal.joint_measurable","Breakdown.FracCert.FarFieldGradientFreeInternal.meas_rot","Breakdown.FracCert.FarFieldPairingInternal.change_vars","Breakdown.FracCert.FarFieldWeightedInternal.arg_cont","Breakdown.FracCert.FarFieldWeightedInternal.gform_meas","Breakdown.FracCert.FarFieldWeightedInternal.rot_symm","Breakdown.FracCert.Internal.SimDeriv.drift_simAdj","Breakdown.FracCert.Internal.SimDeriv.hasDerivAt_simAdj","Breakdown.FracCert.Internal.SimDeriv.simAdj_eq","Breakdown.FracCert.ProfileMildFormInternal.driftSym_orbit","Breakdown.FracCert.ProfileMildFormInternal.orbit_hasDeriv","Breakdown.FracCert.ProfileMildFormInternal.rot_decomp","Breakdown.FracCert.ProfileMildFormInternal.rot_turn","Breakdown.FracCert.ProfileMildFormInternal.simAdj_one","Breakdown.FracCert.ProfileMildFormInternal.turnC_rotC","Breakdown.FracCert.simAdjPairing","Breakdown.FracCert.simOpCompose","Breakdown.FracInternal.MildProfileOrbit.simOp_coe","Breakdown.FracInternal.MildProfileOrbit.tri_sim","Breakdown.FracInternal.RowTurnPair.rot_eq","Breakdown.FracInternal.RowTurnPair.rot_zero","Breakdown.FracInternal.RowTurnPair.turn_deriv","Breakdown.FracInternal.SpaceAssembly.selfSimilarWeak","Breakdown.FracInternal.rotatingSlice_zero","Breakdown.Periodic.TorusBlowupAssembly.Internal.fracSelfSimilarDecay_holds","Breakdown.Periodic.TorusBlowupAssembly.Internal.fracSelfSimilarSolves_holds","Breakdown.Periodic.TorusBlowupAssembly.Internal.selfSimilarWeak_holds","Breakdown.SteadyCert.Internal.FlowDeriv.hasDerivAt_