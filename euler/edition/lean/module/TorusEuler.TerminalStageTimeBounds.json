an_report","doc":"Successive estimates on a fixed sequence give the two quantified\nauxiliary lemmas, with a starting index for each requested pair of orders.","end_line":89,"kind":"theorem","line":60,"module":"TorusEuler.TerminalStageTimeBounds","name":"TorusEuler.InductiveEulerStages.terminalTimeBounds_of_step","namespace":"TorusEuler.InductiveEulerStages","noncomputable":false,"private":false,"proof_used_by":["TorusEuler.auxiliaryTerminalSmoothness_of_localTimeStep"],"proof_uses":["TorusEuler.InductiveEulerStages.StageMixedIncrementBound","TorusEuler.InductiveEulerStages.TerminalTimeStep.increment","TorusEuler.InductiveEulerStages.TerminalTimeStep.time","TorusEuler.InductiveEulerStages.oscillation","TorusEuler.InductiveEulerStages.slab","TorusEuler.InductiveEulerStages.stageMixedIncrementBound_zero","TorusEuler.InductiveEulerStages.stageTimeBounds_zero","TorusEuler.InductiveEulerStages.velocity","TorusEuler.SpatialHolderHalf","TorusEuler.Vec3","TorusEuler.spatialHolderHalfNorm"],"protected":false,"short":"terminalTimeBounds_of_step","signature_end_line":63,"sorry":false,"statement_used_by":[],"statement_uses":["TorusEuler.InductiveEulerStages","TorusEuler.InductiveEulerStages.HasTerminalMixedIncrementBounds","TorusEuler.InductiveEulerStages.StageTimeBounds","TorusEuler.InductiveEulerStages.TerminalTimeStep","TorusEuler.InductiveEulerStages.frequency","TorusEuler.InductiveEulerStages.order"],"used_by":["TorusEuler.auxiliaryTerminalSmoothness_of_localTimeStep"],"uses":["TorusEuler.InductiveEulerStages","TorusEuler.InductiveEulerStages.HasTerminalMixedIncrementBounds","TorusEuler.InductiveEulerStages.StageMixedIncrementBound","TorusEuler.InductiveEulerStages.StageTimeBounds","TorusEuler.InductiveEulerStages.TerminalTimeStep","TorusEuler.InductiveEulerStages.TerminalTimeStep.increment","TorusEuler.InductiveEulerStages.TerminalTimeStep.time","TorusEuler.InductiveEulerStages.frequency","TorusEuler.InductiveEulerStages.order","TorusEuler.InductiveEulerStages.oscillation","TorusEuler.InductiveEulerStages.slab","TorusEuler.InductiveEulerStages.stageMixedIncrementBound_zero","TorusEuler.InductiveEulerStages.stageTimeBounds_zero","TorusEuler.InductiveEulerStages.velocity","TorusEuler.SpatialHolderHalf","TorusEuler.Vec3","TorusEuler.spatialHolderHalfNorm"],"written":"terminalTimeBounds_of_step"}],"imports":["TorusEuler.TerminalTimeJet","TorusEuler.TerminalMixedLimits"],"module":"TorusEuler.TerminalStageTimeBounds","path":"TorusEuler/TerminalStageTimeBounds.lean","sha256":"9d6b6528481e526e92a3cf9b8251d3bf272da1d6dbb37ca8004831b23a66e081","source":"import TorusEuler.TerminalTimeJet\nimport TorusEuler.TerminalMixedLimits\n\n/-! Time-order induction on one common sequence of physical stages. -/\n\nopen Filter Set\nopen scoped Topology\n\nnamespace TorusEuler.InductiveEulerStages\n\nvariable (s : InductiveEulerStages)\n\n/-- The velocity and residual estimates at a stage, up to a common\ntime order, in the auxiliary note's fixed-spatial-point derivatives. -/\ndef StageTimeBounds (q ψ n : ℕ) : Prop :=\n  ∀ i ≤ q, ∀ t ∈ Icc 0 (s.slab n), ∀ x,\n    ‖slabTimeJet 0 (s.slab n) i (s.velocity n) t x‖ ≤ s.frequency n ^ ψ ∧\n      ‖slabTimeJet 0 (s.slab n) i (s.residual n) t x‖ ≤ s.frequency (n + 1) ^ (-(5 / 2) : ℝ)\n\ntheorem stageTimeBounds_zero (hfreq : ∀ n, 1 ≤ s.frequency n) (n : ℕ) :\n    s.StageTimeBounds 0 1 n := by\n  intro i hi t ht x\n  obtain rfl := Nat.eq_zero_of_le_zero hi\n  simp only [pow_one]\n  refine ⟨((s.torusVelocity n t).norm_coe_le_norm _).trans (s.velocity_bound n t ht), ?_⟩\n  refine (s.residual_bound n t ht x).trans ?_\n  have hf := hfreq (n + 1)\n  rw [inv_pow, ← Real.rpow_natCast, ← Real.rpow_neg (zero_le_one.trans hf)]\n  exact Real.rpow_le_rpow_of_exponent_le hf (by norm_num)\n\n/-- The exact mixed increment of the same physical stage. -/\ndef StageMixedIncrementBound (q m n : ℕ) : Prop :=\n  ∀ t ∈ Icc 0 (s.slab (n + 1)),\n    let v := slabTimeJet 0 (s.slab (n + 1)) q\n      (fun r x => s.velocity (n + 1) r x - s.velocity n r x - s.oscillation (n + 1) r x) t\n    SpatialHolderHalf m v ∧ spatialHolderHalfNorm m v ≤ (s.frequency (n + 1))⁻¹\n\ntheorem stageMixedIncrementBound_zero {m n : ℕ} (hm : m ≤ s.order (n + 1)) :\n    s.StageMixedIncrementBound 0 m n := by\n  intro t ht\n  let v := s.velocity (n + 1) t - s.velocity n t - s.oscillation (n + 1) t\n  have h : SpatialHolderHalf m v ∧ spatialHolderHalfNorm m v ≤ (s.frequency (n + 1))⁻¹ :=\n    s.correction_bound n m hm t ht\n  have hv : v = fun x => s.velocity (n + 1) t x - s.velocity n t x - s.oscillation (n + 1) t x := by\n    funext x\n    simp only [v, Pi.sub_apply]\n  rw [hv] at h\n  exact h\n\n/-- A local time step may use all velocity and residual jets through\nthe preceding time order at the parent. -/\nstructure TerminalTimeStep : Prop where\n  time : ∀ q ψ, ∃ Ψ : ℕ, ∀ᶠ n in atTop,\n    s.StageTimeBounds q ψ n → s.StageTimeBounds (q + 1) Ψ (n + 1)\n  increment : ∀ q m ψ, ∀ᶠ n in atTop,\n    s.StageTimeBounds q ψ n → s.StageMixedIncrementBound (q + 1) m n\n\n/-- Successive estimates on a fixed sequence give the two quantified\nauxiliary lemmas, with a starting index for each requested pair of orders. -/\ntheorem terminalTimeBounds_of_step (hfreq : ∀ n, 1 ≤ s.frequency n)\n    (horder : Tendsto s.order atTop atTop) (step : s.TerminalTimeStep) :\n    (∀ q, ∃ ψ : ℕ, ∀ᶠ n in atTop, s.StageTimeBounds q ψ n) ∧\n      s.HasTerminalMixedIncrementBounds := by\n  have hTime (q : ℕ) : ∃ ψ : ℕ, ∀ᶠ n in atTop, s.StageTimeBounds q ψ n := by\n    induction q with\n    | zero =>\n      exact ⟨1, Eventually.of_forall (s.stageTimeBounds_zero hfreq)⟩\n    | succ q ih =>\n      obtain ⟨ψ, hψ⟩ := ih\n      obtain ⟨Ψ, hΨ⟩ := step.time q ψ\n      have hnext : ∀ᶠ n in atTop, s.StageTimeBounds (q + 1) Ψ (n + 1) :=\n        (hΨ.and hψ).mono fun _ h => h.1 h.2\n      obtain ⟨n₀, hn₀⟩ := eventually_atTop.1 hnext\n      refine ⟨Ψ, eventually_atTop.2 ⟨n₀ + 1, ?_⟩⟩\n      intro n hn\n      cases n with\n      | zero => omega\n      | succ j => exact hn₀ j (by omega)\n  refine ⟨hTime, ?_⟩\n  intro q m\n  change ∀ᶠ n in atTop, s.StageMixedIncrementBound q m n\n  cases q with\n  | zero =>\n    have h : ∀ᶠ n in atTop, m ≤ s.order (n + 1) :=\n      (horder.comp (tendsto_add_atTop_nat 1)).eventually (eventually_ge_atTop m)\n    exact h.mono fun _ hn => s.stageMixedIncrementBound_zero hn\n  | succ q =>\n    obtain ⟨ψ, hψ⟩ := hTime q\n    exact ((step.increment q m ψ).and hψ).mono fun _ h => h.1 h.2\n\nend TorusEuler.InductiveEulerStages\n"}