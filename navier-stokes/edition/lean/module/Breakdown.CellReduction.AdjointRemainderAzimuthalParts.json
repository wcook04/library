duction.ringPoint","Breakdown.Space"],"used_by":["Breakdown.AdjointDefect.AzimuthalParts.Internal.slice_bound","Breakdown.AdjointDefect.AzimuthalParts.modePairing","Breakdown.AdjointDefect.AzimuthalParts.remainderAzimuthalHolds_of"],"uses":["Breakdown.AdjointDefect.AzimuthalParts.modeInverseSquare","Breakdown.CellCert.Reduction.ringPoint","Breakdown.Space"],"written":"ModePairingHolds"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":53,"kind":"def","line":48,"module":"Breakdown.CellReduction.AdjointRemainderAzimuthalParts","name":"Breakdown.AdjointDefect.AzimuthalParts.TimeModeSumHolds","namespace":"Breakdown.AdjointDefect.AzimuthalParts","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"TimeModeSumHolds","signature_end_line":48,"sorry":false,"statement_used_by":["Breakdown.AdjointDefect.AzimuthalParts.remainderAzimuthalHolds_of","Breakdown.AdjointDefect.AzimuthalParts.timeModeSum"],"statement_uses":["Breakdown.Space"],"used_by":["Breakdown.AdjointDefect.AzimuthalParts.remainderAzimuthalHolds_of","Breakdown.AdjointDefect.AzimuthalParts.timeModeSum"],"uses":["Breakdown.Space"],"written":"TimeModeSumHolds"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":60,"kind":"def","line":55,"module":"Breakdown.CellReduction.AdjointRemainderAzimuthalParts","name":"Breakdown.AdjointDefect.AzimuthalParts.ModeInverseSquareWeakHolds","namespace":"Breakdown.AdjointDefect.AzimuthalParts","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"ModeInverseSquareWeakHolds","signature_end_line":55,"sorry":false,"statement_used_by":["Breakdown.AdjointDefect.AzimuthalParts.Internal.slice_bound","Breakdown.AdjointDefect.AzimuthalParts.modeInverseSquareWeak_of","Breakdown.AdjointDefect.AzimuthalParts.remainderAzimuthalHolds_of"],"statement_uses":["Breakdown.AdjointDefect.AzimuthalParts.modeInverseSquare","Breakdown.AdjointDefect.AzimuthalParts.modeWeight","Breakdown.CellCert.Reduction.horizontalPart","Breakdown.IsWeakGradient","Breakdown.Space","Breakdown.matSq"],"used_by":["Breakdown.AdjointDefect.AzimuthalParts.Internal.slice_bound","Breakdown.AdjointDefect.AzimuthalParts.modeInverseSquareWeak_of","Breakdown.AdjointDefect.AzimuthalParts.remainderAzimuthalHolds_of"],"uses":["Breakdown.AdjointDefect.AzimuthalParts.modeInverseSquare","Breakdown.AdjointDefect.AzimuthalParts.modeWeight","Breakdown.CellCert.Reduction.horizontalPart","Breakdown.IsWeakGradient","Breakdown.Space","Breakdown.matSq"],"written":"ModeInverseSquareWeakHolds"}],"imports":["Breakdown.Cert.Statement","Breakdown.FracCell.ReductionAdjointFrameInverseSquare","Breakdown.FracCell.ReductionAdjointWeightedInverseSquare"],"module":"Breakdown.CellReduction.AdjointRemainderAzimuthalParts","path":"Breakdown/CellReduction/AdjointRemainderAzimuthalParts.lean","sha256":"1fc78c4ff2dcb34ba5cafcb9c126034a1dd8c1ce70d988d3324a79873b7a968a","source":"import Breakdown.Cert.Statement\nimport Breakdown.FracCell.ReductionAdjointFrameInverseSquare\nimport Breakdown.FracCell.ReductionAdjointWeightedInverseSquare\n\nopen scoped ENNReal ContDiff\nopen MeasureTheory Filter Topology\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace AdjointDefect\n\nnamespace AzimuthalParts\n\nopen CellCert.Reduction FracInternal.FrameInverseSquareParts\n\ndef modeWeight (k : ℤ) : ℝ := |(k : ℝ)| + 1 / 2\n\ndef modeInverseSquare (u : Space → ℂ) (k : ℤ) : ℝ≥0∞ :=\n  ∫⁻ q in Set.Ioi (0 : ℝ) ×ˢ (Set.univ : Set ℝ),\n    ENNReal.ofReal (2 * Real.pi * q.1 * ‖angularMode u k q.1 q.2‖ ^ 2 / (q.1 ^ 2 + q.2 ^ 2))\n\ndef SmoothModeInverseSquareHolds : Prop :=\n  ∀ u : Space → Space, ContDiff ℝ ∞ u → HasCompactSupport u → ∀ k : ℤ,\n    ENNReal.ofReal (modeWeight k ^ 2) * modeInverseSquare (horizontalPart u) k ≤\n      modeGradientSide (fun y => fderiv ℝ u y) k\n\ndef WeakClassApproxHolds : Prop :=\n  ∀ (V : Space → Space) (D : Space → (Space →L[ℝ] Space)),\n    AEStronglyMeasurable V volume → AEStronglyMeasurable D volume → IsWeakGradient V D →\n    ∫⁻ y, ENNReal.ofReal (‖V y‖ ^ 6) < ⊤ → ∫⁻ y, ENNReal.ofReal (matSq (D y)) < ⊤ →\n    ∃ u : ℕ → Space → Space, (∀ n, ContDiff ℝ ∞ (u n) ∧ HasCompactSupport (u n)) ∧\n      Tendsto (fun n => ∫⁻ y, ENNReal.ofReal (matSq (fderiv ℝ (u n) y - D y))) atTop (𝓝 0) ∧\n      ∀ R : ℝ, Tendsto (fun n => ∫⁻ y in Metric.ball (0 : Space) R,\n        ENNReal.ofReal (‖u n y - V y‖ ^ 2)) atTop (𝓝 0)\n\ndef GradientModeTotalHolds : Prop :=\n  ∀ D : Space → (Space →L[ℝ] Space), AEStronglyMeasurable D volume →\n    ∑' k : ℤ, modeGradientSide D k ≤ ∫⁻ y, ENNReal.ofReal (matSq (D y))\n\ndef ModePairingHolds : Prop :=\n  ∀ (u B : Space → ℂ) (k : ℤ), AEStronglyMeasurable u volume → AEStronglyMeasurable B volume →\n    (∀ ρ θ z : ℝ, B (ringPoint ρ θ z) = Complex.exp ((k : ℂ) * (θ : ℂ) * Complex.I) * B (ringPoint ρ 0 z)) →\n    ENNReal.ofReal ‖∫ y, starRingEnd ℂ (u y) * B y‖ ^ 2 ≤\n      modeInverseSquare u k * ∫⁻ y, ENNReal.ofReal (‖y‖ ^ 2 * ‖B y‖ ^ 2)\n\ndef TimeModeSumHolds : Prop :=\n  ∀ {N : ℕ} (a : Fin N → Space → ℂ) (f : Fin N → ℤ) (S : Finset (Fin N)), Set.InjOn f S →\n    (∀ p, AEStronglyMeasurable (a p) volume) →\n    (∫⁻ σ in Set.Icc (0 : ℝ) 1, ∫⁻ y, ENNReal.ofReal (‖y‖ ^ 2 *\n        ‖∑ p ∈ S, Complex.exp (2 * (Real.pi : ℂ) * (f p : ℂ) * (σ : ℂ) * Complex.I) * a p y‖ ^ 2)) ≤\n      ∑ p ∈ S, ∫⁻ y, ENNReal.ofReal (‖y‖ ^ 2 * ‖a p y‖ ^ 2)\n\ndef ModeInverseSquareWeakHolds : Prop :=\n  ∀ (V : Space → Space) (D : Space → (Space →L[ℝ] Space)),\n    AEStronglyMeasurable V volume → AEStronglyMeasurable D volume → IsWeakGradient V D →\n    ∫⁻ y, ENNReal.ofReal (‖V y‖ ^ 6) < ⊤ → ∫⁻ y, ENNReal.ofReal (matSq (D y)) < ⊤ →\n    ∑' k : ℤ, ENNReal.ofReal (modeWeight k ^ 2) * modeInverseSquare (horizontalPart V) k ≤\n      ∫⁻ y, ENNReal.ofReal (matSq (D y))\n\nend AzimuthalParts\n\nend AdjointDefect\n\nend Breakdown\n"}