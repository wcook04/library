mputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CellCert.Spectral.modeOrth_of_same"],"proof_uses":[],"protected":false,"short":"apart_ae","signature_end_line":41,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CellCert.Spectral.CellBlock","Breakdown.CellCert.Spectral.cellSolid","Breakdown.Space"],"used_by":["Breakdown.CellCert.Spectral.modeOrth_of_same"],"uses":["Breakdown.CellCert.Spectral.CellBlock","Breakdown.CellCert.Spectral.cellSolid","Breakdown.Space"],"written":"apart_ae"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":65,"kind":"theorem","line":51,"module":"Breakdown.FracCell.SpectralBlocksOrth","name":"Breakdown.CellCert.Spectral.modeOrth_of_same","namespace":"Breakdown.CellCert.Spectral","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":["Breakdown.CellCert.Spectral.Internal.SpectralBlocksOrth.apart_ae","Breakdown.CellCert.Spectral.Internal.SpectralBlocksOrth.field_outside","Breakdown.CellCert.Spectral.Internal.SpectralBlocksOrth.grad_outside","Breakdown.SteadyCert.entryInner"],"protected":false,"short":"modeOrth_of_same","signature_end_line":51,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CellCert.Spectral.ModeOrthSameStatement","Breakdown.CellCert.Spectral.ModeOrthStatement"],"used_by":[],"uses":["Breakdown.CellCert.Spectral.Internal.SpectralBlocksOrth.apart_ae","Breakdown.CellCert.Spectral.Internal.SpectralBlocksOrth.field_outside","Breakdown.CellCert.Spectral.Internal.SpectralBlocksOrth.grad_outside","Breakdown.CellCert.Spectral.ModeOrthSameStatement","Breakdown.CellCert.Spectral.ModeOrthStatement","Breakdown.SteadyCert.entryInner"],"written":"modeOrth_of_same"}],"imports":["Breakdown.FracCell.SpectralBlocksFamily"],"module":"Breakdown.FracCell.SpectralBlocksOrth","path":"Breakdown/FracCell/SpectralBlocksOrth.lean","sha256":"988f85e966358ee5ff00db9ec78f93eee69cba2d5f62af13f44f76939d3bd8cf","source":"import Breakdown.FracCell.SpectralBlocksFamily\n\nopen MeasureTheory\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace CellCert\n\nnamespace Spectral\n\nopen SteadyCert\n\ndef ModeOrthSameStatement : Prop :=\n  ∀ g g' : CellBlock,\n    g.innerRadius = g'.innerRadius → g.outerRadius = g'.outerRadius → g.lowerHeight = g'.lowerHeight →\n      g.upperHeight = g'.upperHeight → g.mode ≠ g'.mode →\n    (∀ F G : Space → Space, ModeField g F → ModeField g' G → MemLp F 2 volume → MemLp G 2 volume →\n      ∫ y, inner ℝ (F y) (G y) = 0) ∧\n    (∀ D D' : Space → (Space →L[ℝ] Space), ModeGradient g D → ModeGradient g' D' →\n      AEStronglyMeasurable D volume → AEStronglyMeasurable D' volume →\n      Integrable (fun y => entrySq (D y)) volume → Integrable (fun y => entrySq (D' y)) volume →\n      ∫ y, entryInner (D y) (D' y) = 0)\n\nnamespace Internal.SpectralBlocksOrth\n\ntheorem field_outside {g : CellBlock} {F : Space → Space} (h : ModeField g F) {y : Space}\n    (hy : ∀ s, y ∉ cellSolid g s) : F y = 0 := by\n  obtain ⟨f, -, hf⟩ := h\n  rw [hf y]\n  exact Finset.sum_eq_zero fun s _ => Set.indicator_of_notMem (hy s) _\n\ntheorem grad_outside {g : CellBlock} {D : Space → (Space →L[ℝ] Space)} (h : ModeGradient g D) {y : Space}\n    (hy : ∀ s, y ∉ cellSolid g s) : D y = 0 := by\n  obtain ⟨f, -, hf⟩ := h\n  rw [hf y]\n  exact Finset.sum_eq_zero fun s _ => Set.indicator_of_notMem (hy s) _\n\ntheorem apart_ae {g g' : CellBlock} (h : volume (⋃ s, cellSolid g s ∩ ⋃ s, cellSolid g' s) = 0) :\n    ∀ᵐ y ∂volume, (∀ s, y ∉ cellSolid g s) ∨ (∀ s, y ∉ cellSolid g' s) := by\n  filter_upwards [measure_eq_zero_iff_ae_notMem.1 h] with y hy\n  by_contra hc\n  push Not at hc\n  obtain ⟨⟨s, hs⟩, ⟨s', hs'⟩⟩ := hc\n  exact hy (Set.mem_iUnion.2 ⟨s, hs, Set.mem_iUnion.2 ⟨s', hs'⟩⟩)\n\nend Internal.SpectralBlocksOrth\n\nopen Internal.SpectralBlocksOrth in\ntheorem modeOrth_of_same (hS : ModeOrthSameStatement) : ModeOrthStatement := by\n  intro g g' hap\n  rcases hap with h | ⟨e1, e2, e3, e4, e5⟩\n  · refine ⟨fun F G hF hG _ _ => ?_, fun D D' hD hD' _ _ _ _ => ?_⟩\n    · refine integral_eq_zero_of_ae ?_\n      filter_upwards [apart_ae h] with y hy\n      rcases hy with hy | hy\n      · simp [field_outside hF hy]\n      · simp [field_outside hG hy]\n    · refine integral_eq_zero_of_ae ?_\n      filter_upwards [apart_ae h] with y hy\n      rcases hy with hy | hy\n      · simp [grad_outside hD hy, entryInner]\n      · simp [grad_outside hD' hy, entryInner]\n  · exact hS g g' e1 e2 e3 e4 e5\n"}