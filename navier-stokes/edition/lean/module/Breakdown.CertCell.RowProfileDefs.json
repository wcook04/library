wn.CertCell.CellCalculus.RowLow.Internal.rowLow_core","Breakdown.CertCell.CellCalculus.RowLow.Internal.volume_data","Breakdown.CertCell.CellCalculus.labelRowProfile_holds","Breakdown.CertCell.CellCalculus.labelRowProfile_pressure","Breakdown.CertCell.CellCalculus.labelRowProfile_sumSecondPartials","Breakdown.CertCell.CellCalculus.labelRowProfile_valid","Breakdown.CertCell.CellCalculus.rowLowPart_of_parts"],"uses":["Breakdown.CellCert.CellAnalysis.CellBox","Breakdown.CertCell.CellCalculus.RowProfile","Breakdown.CertCell.CellCalculus.gradArray","Breakdown.CertCell.CellCalculus.gradAt","Breakdown.CertCell.CellCalculus.heightStripTrace","Breakdown.CertCell.CellCalculus.labelPressure","Breakdown.CertCell.CellCalculus.otherHeight","Breakdown.CertCell.CellCalculus.otherRadius","Breakdown.CertCell.CellCalculus.radialStripTrace","Breakdown.CertCell.CellCalculus.sideHeight","Breakdown.CertCell.CellCalculus.sideRadius","Breakdown.CertCell.CellCalculus.slopeAt","Breakdown.CertCell.CellCalculus.velArray","Breakdown.CertCell.CellCalculus.velAt","Breakdown.Space"],"written":"labelRowProfile"}],"imports":["Breakdown.CertCell.CellCalculusStatements"],"module":"Breakdown.CertCell.RowProfileDefs","path":"Breakdown/CertCell/RowProfileDefs.lean","sha256":"10de7d2f0391c76e021dd18cbe8d0f12f6df90590875a45a6ffe17211cbe8872","source":"import Breakdown.CertCell.CellCalculusStatements\n\nopen MeasureTheory Matrix\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace CertCell\n\nnamespace CellCalculus\n\nopen SteadyCert CellCert CellCert.CellAnalysis CellCert.CellFormula CellCert.Assembly CellCert.CellEnergy LocalField\n\ndef radialStripTrace (c o : ℝ) (F dF : ℝ × ℝ → ℂ) (z : ℝ) : ℂ :=\n  edgeSign c o * ∫ r in Set.Icc (min c o) (max c o),\n    ((((1 / (c - o) : ℝ)) : ℂ) * F (r, z) + (((r - o) / (c - o) : ℝ) : ℂ) * dF (r, z))\n\ndef heightStripTrace (c o : ℝ) (F dF : ℝ × ℝ → ℂ) (r : ℝ) : ℂ :=\n  edgeSign c o * ∫ z in Set.Icc (min c o) (max c o),\n    ((((1 / (c - o) : ℝ)) : ℂ) * F (r, z) + (((z - o) / (c - o) : ℝ) : ℂ) * dF (r, z))\n\ndef otherRadius (K : CellBox) (e : Fin 2) : ℝ := if e = 0 then K.r₂ else K.r₁\n\ndef otherHeight (K : CellBox) (e : Fin 2) : ℝ := if e = 0 then K.z₂ else K.z₁\n\ndef labelPressure (m : ℕ) (ι : ℤ × ℤ) (Pg : ℝ → Space → Space) (p : ℝ × ℝ) : ℂ :=\n  presMode m ι.1 (potentialOf (harmonicCos (labelTime ι) Pg)) p.1 p.2\n    + Complex.I * presMode m ι.1 (potentialOf (harmonicSin (labelTime ι) Pg)) p.1 p.2\n\ndef labelRowProfile (K : CellBox) (m : ℕ) (ι : ℤ × ℤ) (v : ℝ → Space → Space)\n    (G : ℝ → Space → (Space →L[ℝ] Space)) (H : ℝ → Space → (Space →L[ℝ] Space →L[ℝ] Space))\n    (Pg : ℝ → Space → Space) : RowProfile where\n  vel := velArray m ι v\n  grad := gradArray m ι G\n  lap := fun p a => ∑ c : Fin 3, slopeAt m ι H a c c p\n  presGrad := velArray m ι Pg\n  radialSide := fun e z a => radialStripTrace (sideRadius K e) (otherRadius K e) (gradAt m ι G a 0)\n    (slopeAt m ι H a 0 0) z\n  heightSide := fun e r a => heightStripTrace (sideHeight K e) (otherHeight K e) (gradAt m ι G a 2)\n    (slopeAt m ι H a 2 2) r\n  radialPres := fun e z => radialStripTrace (sideRadius K e) (otherRadius K e) (labelPressure m ι Pg)\n    (fun p => velAt m ι Pg 0 p) z\n  heightPres := fun e r => heightStripTrace (sideHeight K e) (otherHeight K e) (labelPressure m ι Pg)\n    (fun p => velAt m ι Pg 2 p) r\n\nend CellCalculus\n\nend CertCell\n\nend Breakdown\n"}