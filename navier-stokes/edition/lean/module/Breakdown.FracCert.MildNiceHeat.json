l","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.FracCert.ProfileMildFormInternal.pairing_symbol","Breakdown.FracCert.niceHeat"],"proof_uses":["Breakdown.Freq.Internal.VelocityInjective.isDecayField_of_test","Breakdown.Freq.embedNormLinear_holds","Breakdown.Freq.niceFieldProps","Breakdown.Freq.nicePairingByParts","Breakdown.Freq.pairingEmbed","Breakdown.Freq.testDense_holds","Breakdown.Freq.testSpan_holds","Breakdown.Freq.velocityDecay_holds","Breakdown.WeakProfile.Internal.PairingVelocity.pairing_eq_lp","Breakdown.fieldPairing"],"protected":false,"short":"pairing_nice","signature_end_line":66,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.Freq.CSpace","Breakdown.Freq.IsNiceField","Breakdown.Freq.L2C","Breakdown.Freq.L6R","Breakdown.Freq.X","Breakdown.Freq.embedX","Breakdown.Freq.factOneLeSix","Breakdown.Freq.negSsp","Breakdown.Freq.velocity","Breakdown.Space"],"used_by":["Breakdown.FracCert.ProfileMildFormInternal.pairing_symbol","Breakdown.FracCert.niceHeat"],"uses":["Breakdown.Freq.CSpace","Breakdown.Freq.Internal.VelocityInjective.isDecayField_of_test","Breakdown.Freq.IsNiceField","Breakdown.Freq.L2C","Breakdown.Freq.L6R","Breakdown.Freq.X","Breakdown.Freq.embedNormLinear_holds","Breakdown.Freq.embedX","Breakdown.Freq.factOneLeSix","Breakdown.Freq.negSsp","Breakdown.Freq.niceFieldProps","Breakdown.Freq.nicePairingByParts","Breakdown.Freq.pairingEmbed","Breakdown.Freq.testDense_holds","Breakdown.Freq.testSpan_holds","Breakdown.Freq.velocity","Breakdown.Freq.velocityDecay_holds","Breakdown.Space","Breakdown.WeakProfile.Internal.PairingVelocity.pairing_eq_lp","Breakdown.fieldPairing"],"written":"pairing_nice"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":96,"kind":"theorem","line":88,"module":"Breakdown.FracCert.MildNiceHeat","name":"Breakdown.FracCert.MildNiceHeatInternal.heat_embed","namespace":"Breakdown.FracCert.MildNiceHeatInternal","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.FracCert.niceHeat"],"proof_uses":["Breakdown.FracCert.MildNiceHeatInternal.isNiceSymbol_heat","Breakdown.FracInternal.RHeat.opX_coe","Breakdown.FracInternal.RHeat.op_ae","Breakdown.Freq.fracHeatFactor","Breakdown.Freq.niceEmbedSymbol"],"protected":false,"short":"heat_embed","signature_end_line":89,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.FracCert.MildNiceHeatInternal.heatSym","Breakdown.Freq.CSpace","Breakdown.Freq.IsNiceSymbol","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Freq.embedX","Breakdown.Freq.fracHeatX","Breakdown.Freq.niceField","Breakdown.Space"],"used_by":["Breakdown.FracCert.niceHeat"],"uses":["Breakdown.FracCert.MildNiceHeatInternal.heatSym","Breakdown.FracCert.MildNiceHeatInternal.isNiceSymbol_heat","Breakdown.FracInternal.RHeat.opX_coe","Breakdown.FracInternal.RHeat.op_ae","Breakdown.Freq.CSpace","Breakdown.Freq.IsNiceSymbol","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Freq.embedX","Breakdown.Freq.fracHeatFactor","Breakdown.Freq.fracHeatX","Breakdown.Freq.niceEmbedSymbol","Breakdown.Freq.niceField","Breakdown.Space"],"written":"heat_embed"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":112,"kind":"theorem","line":101,"module":"Breakdown.FracCert.MildNiceHeat","name":"Breakdown.FracCert.niceHeat","namespace":"Breakdown.FracCert","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.FracCert.ProfileMildFormInternal.nice_orbit","Breakdown.FracCert.heatDivPairing_of","Breakdown.SteadyCert.ChainInternal.niceHeat_holds"],"proof_uses":["Breakdown.FracCert.MildNiceHeatInternal.heatField_niceField","Breakdown.FracCert.MildNiceHeatInternal.heat_embed","Breakdown.FracCert.MildNiceHeatInternal.isNiceSymbol_heat","Breakdown.FracCert.MildNiceHeatInternal.isNiceSymbol_traceInv","Breakdown.FracCert.MildNiceHeatInternal.negTrace_traceInv","Breakdown.FracCert.MildNiceHeatInternal.pairing_nice","Breakdown.Freq.fracHeatSemigroup"],"protected":false,"short":"niceHeat","signature_end_line":101,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.FracCert.NiceHeatStatement"],"used_by":["Breakdown.FracCert.ProfileMildFormInternal.nice_orbit","Breakdown.FracCert.heatDivPairing_of","Breakdown.SteadyCert.ChainInternal.niceHeat_holds"],"uses":["Breakdown.FracCert.MildNiceHeatInternal.heatField_niceField","Breakdown.FracCert.MildNiceHeatInternal.heat_embed","Breakdown.FracCert.MildNiceHeatInternal.isNiceSymbol_heat","Breakdown.FracCert.MildNiceHeatInternal.isNiceSymbol_traceInv","Breakdown.FracCert.MildNiceHeatInternal.negTrace_traceInv","Breakdown.FracCert.MildNiceHeatInternal.pairing_nice","Breakdown.FracCert.NiceHeatStatement","Breakdown.Freq.fracHeatSemigroup"],"written":"niceHeat"}],"imports":["Breakdown.FracCert.StMildProfile","Breakdown.Frac.NNiceField","Breakdown.Frac.NNicePairing","Breakdown.Frac.RHeat","Breakdown.Weak.PairingVelocity","Breakdown.FreqTr.PairingEmbed","Breakdown.FreqTr.VelocityInjective"],"module":"Breakdown.FracCert.MildNiceHeat","path":"Breakdown/FracCert/MildNiceHeat.lean","sha256":"c14a6848af4229870a3fa646097d9b063fd879c9380550eac2ae8de76ab02fcf","source":"import Breakdown.FracCert.StMildProfile\nimport Breakdown.Frac.NNiceField\nimport Breakdown.Frac.NNicePairing\nimport Breakdown.Frac.RHeat\nimport Breakdown.Weak.PairingVelocity\nimport Breakdown.FreqTr.PairingEmbed\nimport Breakdown.FreqTr.VelocityInjective\n\nopen MeasureTheory Set Real\nopen scoped ENNReal ContDiff\n\nnoncomputable section\n\nnamespace Breakdown.FracCert\n\nopen Breakdown.Freq\n\nnamespace MildNiceHeatInternal\n\ndef heatSym (α τ : ℝ) (ξ : Space) : ℝ := Real.exp (-(τ * (2 * π * ‖ξ‖) ^ (2 * α)))\n\ndef traceInv (ξ : Space) : ℝ := (sspFactor ξ)⁻¹\n\ntheorem isNiceSymbol_heat (α τ : ℝ) {m : Space → CSpace} (hm : IsNiceSymbol m) :\n    IsNiceSymbol (fun ξ => heatSym α τ ξ • m ξ) :=\n  Freq.FracInternal.NiceEmbed.isNiceSymbol_smul hm (heatSym α τ)\n    (fun ξ hξ => by\n      have hp : 0 < ‖ξ‖ := norm_pos_iff.2 hξ\n      have hne : 2 * π * ‖ξ‖ ≠ 0 := by positivity\n      exact (contDiffAt_const.mul\n        ((contDiffAt_const.mul (contDiffAt_norm ℝ hξ)).rpow_const_of_ne hne)).neg.exp)\n    (fun ξ => by simp [heatSym])\n\ntheorem isNiceSymbol_traceInv {m : Space → CSpace} (hm : IsNiceSymbol m) :\n    IsNiceSymbol (fun ξ => traceInv ξ • m ξ) :=\n  Freq.FracInternal.NiceEmbed.isNiceSymbol_smul hm traceInv\n    (fun ξ hξ => by\n      have hp : 0 < ‖ξ‖ := norm_pos_iff.2 hξ\n      have hne : 4 * π ^ 2 * ‖ξ‖ ^ 2 ≠ 0 := by positivity\n      exact (contDiffAt_const.mul ((contDiffAt_norm ℝ hξ).pow 2)).inv hne)\n    (fun ξ => by simp [traceInv, sspFactor])\n\ntheorem negTrace_traceInv {m : Space → CSpace} (hm : IsNiceSymbol m) :\n    negSsp (niceField (fun ξ => traceInv ξ • m ξ)) = niceField m := by\n  rw [Freq.FracInternal.NiceEmbed.negTraceSecondDeriv_niceField (isNiceSymbol_traceInv hm)]\n  congr 1\n  funext ξ\n  by_cases h : ξ = 0\n  · obtain ⟨r, hr, hz⟩ := hm.2.2.1\n    have h0 : m ξ = 0 := hz ξ (by rw [h, norm_zero]; exact hr)\n    simp [h0]\n  · have hp : 0 < ‖ξ‖ := norm_pos_iff.2 h\n    have hne : sspFactor ξ ≠ 0 := by unfold sspFactor; positivity\n    rw [smul_smul, traceInv, mul_inv_cancel₀ hne, one_smul]\n\ntheorem heatField_niceField (α τ : ℝ) {m : Space → CSpace} (hm : IsNiceSymbol m) :\n    heatField α τ (niceField m) = niceField (fun ξ => heatSym α τ ξ • m ξ) := by\n  funext y\n  rw [← Breakdown.FracInternal.NiceField.fieldS_coe hm]\n  unfold heatField\n  rw [Breakdown.FracInternal.NiceField.transform_fieldS hm]\n  rfl\n\nopen Freq.Internal.VelocityInjective in\ntheorem pairing_nice {ψ : Space → Space} (hψ : IsNiceField ψ) (x : X) :\n    inner ℝ x (embedX ψ) = ∫ y, inner ℝ ((velocity x : Space → Space) y) (negSsp ψ y) := by\n  have hN := Freq.niceFieldProps (5 / 4) (by norm_num) (by norm_num)\n  obtain ⟨-, hψd, hψn, -, -⟩ := hN ψ hψ\n  obtain ⟨⟨S, hS⟩, -, -, -, -⟩ := hN _ hψn\n  have hG : MemLp (negSsp ψ) (6 / 5) volume := by rw [← hS]; exact S.memLp _ _\n  have hE : PairingEmbed := pairingEmbed embedNormLinear_holds.1 embedNormLinear_holds.2\n  let P := (innerSL ℝ : Space →L[ℝ] Space →L[ℝ] ℝ).lpPairing (volume : Measure Space) 6 (6 / 5)\n  have heq : (fun y : X => inner ℝ y (embedX ψ)) = fun y => P (velocity y) (hG.toLp _) := by\n    apply Continuous.ext_on testDense_holds.2 (by fun_prop)\n      ((P.flip (hG.toLp _)).continuous.comp velocity.continuous)\n    intro y hy\n    obtain ⟨f, hf, rfl⟩ := testSpan_holds y hy\n    show inner ℝ (embedX f) (embedX ψ) = P (velocity (embedX f)) (hG.toLp _)\n    have hfd := Internal.VelocityInjective.isDecayField_of_test f hf\n    rw [hE f ψ hfd hψd, nicePairingByParts f ψ hfd hψ,\n      ← WeakProfile.Internal.PairingVelocity.pairing_eq_lp ψ hG]\n    unfold fieldPairing\n    apply integral_congr_ae\n    filter_upwards [velocityDecay_holds f hfd] with z hz\n    rw [hz]\n  rw [congrFun heq x, WeakProfile.Internal.PairingVelocity.pairing_eq_lp ψ hG]\n\ntheorem heat_embed (α : ℝ) {τ : ℝ} (hτ : 0 ≤ τ) {n : Space → CSpace} (hn : IsNiceSymbol n) :\n    fracHeatX α τ (embedX (niceField n)) = embedX (niceField (fun ξ => heatSym α τ ξ • n ξ)) := by\n  apply Subtype.ext\n  show (fracHeatX α τ (embedX (niceField n)) : L2C) = (embedX (niceField _) : L2C)\n  rw [Breakdown.FracInternal.RHeat.opX_coe]\n  apply Lp.ext\n  filter_upwards [Breakdown.FracInternal.RHeat.op_ae α τ (embedX (niceField n) : L2C),\n    niceEmbedSymbol n hn, niceEmbedSymbol _ (isNiceSymbol_heat α τ hn)] with ξ h1 h2 h3\n  rw [h1, h2, h3, fracHeatFactor, max_eq_left hτ, heatSym, smul_comm]\n\nend MildNiceHeatInternal\n\nopen MildNiceHeatInternal in\ntheorem niceHeat : NiceHeatStatement := by\n  intro α τ _ hτ φ hφ\n  obtain ⟨m, hm, rfl⟩ := hφ\n  have hem := isNiceSymbol_heat α τ hm\n  refine ⟨⟨_, hem, heatField_niceField α τ hm⟩, fun x => ?_⟩\n  rw [heatField_niceField α τ hm, ← negTrace_traceInv hm, ← negTrace_traceInv hem,\n    ← pairing_nice ⟨_, isNiceSymbol_traceInv hm, rfl⟩,\n    ← pairing_nice ⟨_, isNiceSymbol_traceInv hem, rfl⟩, (fracHeatSemigroup α).2.2.2.2.1,\n    heat_embed α hτ (isNiceSymbol_traceInv hm)]\n  congr 3\n  funext ξ\n  exact smul_comm _ _ _\n\nend Breakdown.FracCert\n"}