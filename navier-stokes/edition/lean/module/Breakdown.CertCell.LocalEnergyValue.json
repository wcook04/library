ernal.value_add","Breakdown.CellCert.CellEnergy.LowIndex","Breakdown.CellCert.CellEnergy.componentForm","Breakdown.CellCert.CellFormula.LowIndex","Breakdown.CellCert.CellFormula.quadFormValue","Breakdown.CertCell.LocalField.IsModeData","Breakdown.CertCell.LocalField.LocalComponentAngularStatement","Breakdown.CertCell.LocalField.LocalComponentHeightStatement","Breakdown.CertCell.LocalField.LocalComponentRadialStatement","Breakdown.CertCell.LocalField.modeSum"],"written":"component_value"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":50,"kind":"theorem","line":42,"module":"Breakdown.CertCell.LocalEnergyValue","name":"Breakdown.CertCell.LocalField.localEnergyValue_of","namespace":"Breakdown.CertCell.LocalField","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CertCell.CellCalculus.harmonicEnergyFormValue_of_lift"],"proof_uses":["Breakdown.CellCert.CellEnergy.EnergyAssemblyInternal.component_value","Breakdown.CellCert.CellEnergy.EnergyAssemblyInternal.value_add","Breakdown.CellCert.CellEnergy.EnergyAssemblyInternal.value_smul","Breakdown.CellCert.CellEnergy.EnergyAssemblyInternal.value_sub","Breakdown.CellCert.CellEnergy.EnergyAssemblyInternal.value_sum","Breakdown.CellCert.CellEnergy.energyForm","Breakdown.CertCell.LocalField.Internal.EnergyValue.component_value","Breakdown.CertCell.LocalField.Internal.EnergyValue.modeSum_curl","Breakdown.CertCell.LocalField.Internal.EnergyValue.modeSum_unit"],"protected":false,"short":"localEnergyValue_of","signature_end_line":43,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CertCell.LocalField.LocalComponentAngularStatement","Breakdown.CertCell.LocalField.LocalComponentHeightStatement","Breakdown.CertCell.LocalField.LocalComponentRadialStatement","Breakdown.CertCell.LocalField.LocalEnergyValueStatement"],"used_by":["Breakdown.CertCell.CellCalculus.harmonicEnergyFormValue_of_lift"],"uses":["Breakdown.CellC