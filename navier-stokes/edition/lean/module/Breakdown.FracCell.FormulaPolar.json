,"proof_uses":["Breakdown.CellCert.CellFormula.FormulaPolar.polarized_eq","Breakdown.CellCert.CellFormula.FormulaPolar.quad_transpose","Breakdown.CellCert.Finite.quadValue"],"protected":false,"short":"polarization","signature_end_line":31,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CellCert.CellFormula.PolarizationStatement"],"used_by":["Breakdown.CellCert.CellFormula.exactFormulaBound_of_leaves","Breakdown.CellCert.CellFormula.exactFormula_represents","Breakdown.CellCert.CellFormula.exactFormula_represents_of_quadratic"],"uses":["Breakdown.CellCert.CellFormula.FormulaPolar.polarized_eq","Breakdown.CellCert.CellFormula.FormulaPolar.quad_transpose","Breakdown.CellCert.CellFormula.PolarizationStatement","Breakdown.CellCert.Finite.quadValue"],"written":"polarization"}],"imports":["Breakdown.FracCell.StFormulaProof"],"module":"Breakdown.FracCell.FormulaPolar","path":"Breakdown/FracCell/FormulaPolar.lean","sha256":"b27d28484bc231e8008040c5f5e04632823bb04c01721222a6d8de2b4df1f223","source":"import Breakdown.FracCell.StFormulaProof\n\nopen Matrix\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace CellCert\n\nnamespace CellFormula\n\nnamespace FormulaPolar\n\ntheorem quad_transpose {ι : Type} [Fintype ι] (M : Matrix ι ι ℝ) (w : ι → ℝ) :\n    w ⬝ᵥ (Mᵀ *ᵥ w) = w ⬝ᵥ (M *ᵥ w) := by\n  rw [mulVec_transpose, dotProduct_comm, ← dotProduct_mulVec]\n\ntheorem polarized_eq {ι : Type} [Fintype ι] [DecidableEq ι] (f : (ι → ℝ) → ℝ) (M : Matrix ι ι ℝ)\n    (hM : ∀ w, f w = w ⬝ᵥ (M *ᵥ w)) : polarized f = (1 / 2 : ℝ) • (M + Mᵀ) := by\n  ext e e'\n  simp only [polarized, hM, mulVec_add, dotProduct_add, add_dotProduct, mulVec_single,\n    single_dotProduct, Matrix.smul_apply, Matrix.add_apply, transpose_apply, smul_eq_mul,\n    Pi.smul_apply, col_apply, MulOpposite.smul_eq_mul_unop, MulOpposite.unop_op, mul_one, one_mul]\n  ring\n\nend FormulaPolar\n\nopen FormulaPolar\n\ntheorem polarization : PolarizationStatement := by\n  intro ι _ _ f hf w\n  obtain ⟨M, hM⟩ := hf\n  rw [polarized_eq f M hM, hM]\n  simp only [Finite.quadValue, smul_mulVec, add_mulVec, dotProduct_smul, dotProduct_add,\n    quad_transpose, smul_eq_mul]\n  ring\n\nend CellFormula\n\nend CellCert\n\nend Breakdown\n"}