,"TorusEuler.MovingAmplitude.referenceScaledStrainEntries_eq","TorusEuler.MovingAmplitude.scaledEntries_abs_le_two","TorusEuler.MovingAmplitude.scaledMatrix_reference","TorusEuler.MovingAmplitude.scaledOlderEntries_sub_ref_le","TorusEuler.MovingAmplitude.scaledOlderStrainEntries_sub_ref_le","TorusEuler.MovingAmplitude.scaledStrainEntries_sub_ref_le"],"uses":["TorusEuler.MovingAmplitude.Entries"],"written":"referenceScaledOlderEntries"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":76,"kind":"def","line":75,"module":"TorusEuler.AmplitudeReferenceRows","name":"TorusEuler.MovingAmplitude.referenceScaledStrainEntries","namespace":"TorusEuler.MovingAmplitude","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["TorusEuler.GrowingCoupling.normalized_couplings_sub_reference_le","TorusEuler.MovingAmplitude.errorOperator_le_on_normalized_window","TorusEuler.MovingAmplitude.scaledEntries_abs_le_two"],"proof_uses":[],"protected":false,"short":"referenceScaledStrainEntries","signature_end_line":75,"sorry":false,"statement_used_by":["TorusEuler.GrowingCoupling.forcing_sub_reference_le","TorusEuler.MovingAmplitude.errorOperator_le_of_scaled_input_bounds","TorusEuler.MovingAmplitude.referenceScaledEntries_abs_le_one","TorusEuler.MovingAmplitude.referenceScaledStrainEntries_eq","TorusEuler.MovingAmplitude.scaledMatrix_reference","TorusEuler.MovingAmplitude.scaledPressure_reference","TorusEuler.MovingAmplitude.scaledStrainEntries_sub_ref_le"],"statement_uses":["TorusEuler.MovingAmplitude.Entries"],"used_by":["TorusEuler.GrowingCoupling.forcing_sub_reference_le","TorusEuler.GrowingCoupling.normalized_couplings_sub_reference_le","TorusEuler.MovingAmplitude.errorOperator_le_of_scaled_input_bounds","TorusEuler.MovingAmplitude.errorOperator_le_on_normalized_window","TorusEuler.MovingAmplitude.referenceScaledEntries_abs_le_one","TorusEuler.MovingAmplitude.referenceScaledStrainEntries_eq","Torus