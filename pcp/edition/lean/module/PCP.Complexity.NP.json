,"statement_uses":["PCP.Language","PCP.NPCertificate","PCP.NPCertificate.check"],"used_by":["PCP.Machine.NPCellTableau.of_certificate","PCP.Machine.NPTableau.of_certificate","PCP.Reduction.NPThreeColor.of_certificate","PCP.Reduction.NPThreeColorRuntime.of_certificate","PCP.Reduction.NPThreeColorRuntime.of_certificate_program","PCP.ReferenceNP.of_inNP"],"uses":["PCP.Language","PCP.NPCertificate","PCP.NPCertificate.check"],"written":"check_polyTime"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":"The relation defines `L`.","end_line":39,"kind":"def","line":38,"module":"PCP.Complexity.NP","name":"PCP.NPCertificate.spec","namespace":"PCP.NPCertificate","noncomputable":false,"parent":"PCP.NPCertificate","private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"spec","signature_end_line":38,"sorry":false,"statement_used_by":[],"statement_uses":["PCP.Language","PCP.NPCertificate","PCP.NPCertificate.check","PCP.NPCertificate.witnessBound"],"used_by":[],"uses":["PCP.Language","PCP.NPCertificate","PCP.NPCertificate.check","PCP.NPCertificate.witnessBound"],"written":"spec"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":"`L` is in NP relative to the polynomial-time-checkability notion `P`.","end_line":43,"kind":"def","line":42,"module":"PCP.Complexity.NP","name":"PCP.InNP","namespace":"PCP","noncomputable":false,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"InNP","signature_end_line":42,"sorry":false,"statement_used_by":["PCP.Reduction.NPThreeColorRuntime.of_inNP","PCP.Reduction.NPThreeColorRuntime.of_inNP_program","PCP.ReferenceNP.inNP_iff_mem","PCP.ReferenceNP.mem_iff_inNP","PCP.ReferenceNP.of_inNP","PCP.np_subset_pcp","PCP.pcp_subset_np","PCP.pcp_subset_np_concrete"],"statement_uses":["PCP.Language","PCP.NPCertificate"],"used_by":["PCP.Algebraic.ThreeColorFinalAssembly.assemble","PCP.Algebraic.ThreeColorFinalAssembly.of_runtime","PCP.Audit.ReferenceNP.IntendedConverseType","PCP.Audit.ReferenceNP.IntendedEquivalenceType","PCP.Audit.ReferenceNP.IntendedInclusionType","PCP.Machine.NPCellTableau.of_inNP","PCP.Machine.NPTableau.of_inNP","PCP.Reduction.NPThreeColor.of_inNP","PCP.Reduction.NPThreeColorRuntime.of_inNP","PCP.Reduction.NPThreeColorRuntime.of_inNP_program","PCP.ReferenceNP.inNP_iff_mem","PCP.ReferenceNP.mem_iff_inNP","PCP.ReferenceNP.of_inNP","PCP.ReferenceNP.to_inNP","PCP.np_subset_pcp","PCP.pcp_subset_np","PCP.pcp_subset_np_concrete"],"uses":["PCP.Language","PCP.NPCertificate"],"written":"InNP"}],"imports":["PCP.Complexity.CostModel"],"module":"PCP.Complexity.NP","path":"PCP/Complexity/NP.lean","sha256":"b23701ce674baccb03d4333ce8327e81119f55e7c1a2f02488db7787b51ee861","source":"import PCP.Complexity.CostModel\n\n/-!\n# Binary languages and polynomial witness certificates\n\n`NPCertificate` records a polynomial witness bound and a checking relation.\nThe forward PCP theorem instantiates it with `Machine.PolyTimeRel`; the reverse\ninclusion uses a `CostModel`. `ReferenceNPConverse` proves equivalence with the\npinned ComplexityLib definition of NP.\n-/\n\nnamespace PCP\n\n/-- A language over the binary alphabet: inputs are bit strings. -/\ndef Language : Type := List Bool → Prop\n\n/-- A certificate that `L` is in NP relative to a notion `P` of polynomial-time checkability: a\npolynomial witness bound and a witness-checking relation that `P` accepts.\n\n`P` is a plain parameter here, and that is safe *because nothing is proved by quantifying over it*.\n`InNP` is a definition, not a theorem. The two consumers each pin it down:\n\n* `pcp_subset_np` instantiates `P := M.PolyTimeRel` for a `CostModel` `M`, whose closure field is\n  what makes the conclusion non-vacuous;\n* `np_subset_pcp` instantiates `P := PCP.Machine.PolyTimeRel`, the concrete machine definition.\n\nNeither quantifies over an arbitrary `P`. The distinction matters:\na *theorem* over an unconstrained interface is refutable by choosing a degenerate instance; a\n*definition* parameterised by one is just a definition. -/\nstructure NPCertificate (P : (List Bool → List Bool → Bool) → Prop) (L : Language) where\n  /-- Polynomial bound on witness length. -/\n  witnessBound : Polynomial ℕ\n  /-- The witness-checking relation. -/\n  check : List Bool → List Bool → Bool\n  /-- The relation is polynomial-time checkable. -/\n  check_polyTime : P check\n  /-- The relation defines `L`. -/\n  spec : ∀ x : List Bool, L x ↔\n    ∃ w : List Bool, w.length ≤ witnessBound.eval x.length ∧ check x w = true\n\n/-- `L` is in NP relative to the polynomial-time-checkability notion `P`. -/\ndef InNP (P : (List Bool → List Bool → Bool) → Prop) (L : Language) : Prop :=\n  Nonempty (NPCertificate P L)\n\n\n\nend PCP\n"}