lOdd_holds","namespace":"Breakdown.FarField","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.FarField.integralEquationOfOrbit_holds"],"proof_uses":["Breakdown.FarField.Internal.LerayOdd.heatKernelThird_neg","Breakdown.FarField.Internal.LerayOdd.heatKernel_neg","Breakdown.FarField.heatKernelThird","Breakdown.FarField.lerayKernel"],"protected":false,"short":"lerayKernelOdd_holds","signature_end_line":28,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.FarField.LerayKernelOdd"],"used_by":["Breakdown.FarField.integralEquationOfOrbit_holds"],"uses":["Breakdown.FarField.Internal.LerayOdd.heatKernelThird_neg","Breakdown.FarField.Internal.LerayOdd.heatKernel_neg","Breakdown.FarField.LerayKernelOdd","Breakdown.FarField.heatKernelThird","Breakdown.FarField.lerayKernel"],"written":"lerayKernelOdd_holds"}],"imports":["Breakdown.CertTorus.KernelStatements"],"module":"Breakdown.CertTorus.LerayKernelOdd","path":"Breakdown/CertTorus/LerayKernelOdd.lean","sha256":"a493f0f00ea4823e38eb088513e7b929820b89dd70e4196c418d0a02a21cb1a2","source":"import Breakdown.CertTorus.KernelStatements\n\nopen MeasureTheory Set Real\n\nnoncomputable section\n\nnamespace Breakdown.FarField.Internal.LerayOdd\n\nopen Breakdown Breakdown.FarField\n\ntheorem heatKernel_neg (τ : ℝ) (x : Space) : heatKernel τ (-x) = heatKernel τ x := by\n  unfold heatKernel\n  rw [norm_neg]\n\ntheorem heatKernelThird_neg (i j k : Fin 3) (ρ : ℝ) (x : Space) :\n    heatKernelThird i j k ρ (-x) = -heatKernelThird i j k ρ x := by\n  unfold heatKernelThird\n  rw [heatKernel_neg]\n  simp only [PiLp.neg_apply]\n  split_ifs <;> ring\n\nend Breakdown.FarField.Internal.LerayOdd\n\nnamespace Breakdown.FarField\n\nopen Breakdown.FarField.Internal.LerayOdd\n\ntheorem lerayKernelOdd_holds : LerayKernelOdd := by\n  intro i j k τ x\n  unfold lerayKernel\n  have hI : (∫ ρ in Ioi τ, heatKernelThird i j k ρ (-x)) = -∫ ρ in Ioi τ, heatKernelThird i j k ρ x := by\n    simp_rw [heatKernelThird_neg]\n    exact integral_neg _\n  rw [hI, heatKernel_neg]\n  simp only [PiLp.neg_apply]\n  split_ifs <;> ring\n\nend Breakdown.FarField\n"}