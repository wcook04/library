"Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":113,"kind":"theorem","line":97,"module":"Breakdown.FracCell.AdmissibleLinear","name":"Breakdown.CellCert.Assembly.AdmissibleLinearInternal.second_zero","namespace":"Breakdown.CellCert.Assembly.AdmissibleLinearInternal","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CellCert.Assembly.admissibleLinear"],"proof_uses":["Breakdown.CellCert.Assembly.AdmissibleLinearInternal.class_zero","Breakdown.SteadyCert.entrySq"],"protected":false,"short":"second_zero","signature_end_line":99,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.Space","Breakdown.SteadyCert.IsSecondOrderField"],"used_by":["Breakdown.CellCert.Assembly.admissibleLinear"],"uses":["Breakdown.CellCert.Assembly.AdmissibleLinearInternal.class_zero","Breakdown.Space","Breakdown.SteadyCert.IsSecondOrderField","Breakdown.SteadyCert.entrySq"],"written":"second_zero"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":133,"kind":"theorem","line":119,"module":"Breakdown.FracCell.AdmissibleLinear","name":"Breakdown.CellCert.Assembly.admissibleLinear","namespace":"Breakdown.CellCert.Assembly","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CellCert.Assembly.formNonneg_of_tree","Breakdown.CellCert.CellCoordinates.meshMomentLinear"],"proof_uses":["Breakdown.CellCert.Assembly.AdmissibleLinearInternal.class_add","Breakdown.CellCert.Assembly.AdmissibleLinearInternal.class_smul","Breakdown.CellCert.Assembly.AdmissibleLinearInternal.class_zero","Breakdown.CellCert.Assembly.AdmissibleLinearInternal.gradient_smul","Breakdown.CellCert.Assembly.AdmissibleLinearInternal.gradient_zero","Breakdown.CellCert.Assembly.AdmissibleLinearInternal.second_zero","Breakdown.SteadyCert.gradientAdd","Breakdown.SteadyCert.secondOrderLinear"],"protected":false,"short":"admissibleLinear","signature_end_line":119,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CellCert.Assembly.AdmissibleLinearStatement"],"used_by":["Breakdown.CellCert.Assembly.formNonneg_of_tree","Breakdown.CellCert.CellCoordinates.meshMomentLinear"],"uses":["Breakdown.CellCert.Assembly.AdmissibleLinearInternal.class_add","Breakdown.CellCert.Assembly.AdmissibleLinearInternal.class_smul","Breakdown.CellCert.Assembly.AdmissibleLinearInternal.class_zero","Breakdown.CellCert.Assembly.AdmissibleLinearInternal.gradient_smul","Breakdown.CellCert.Assembly.AdmissibleLinearInternal.gradient_zero","Breakdown.CellCert.Assembly.AdmissibleLinearInternal.second_zero","Breakdown.CellCert.Assembly.AdmissibleLinearStatement","Breakdown.SteadyCert.gradientAdd","Breakdown.SteadyCert.secondOrderLinear"],"written":"admissibleLinear"}],"imports":["Breakdown.FracCell.StAssembly","Breakdown.FracCert.SecondOrderComplete","Breakdown.FracCert.GradientAdd"],"module":"Breakdown.FracCell.AdmissibleLinear","path":"Breakdown/FracCell/AdmissibleLinear.lean","sha256":"067bc24ecc1a391d68494cb26b33513734e06b740c1935d0009e670403d3c1f3","source":"import Breakdown.FracCell.StAssembly\nimport Breakdown.FracCert.SecondOrderComplete\nimport Breakdown.FracCert.GradientAdd\n\nopen MeasureTheory\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace CellCert\n\nnamespace Assembly\n\nopen SteadyCert\n\nnamespace AdmissibleLinearInternal\n\ntheorem turnStep_zero (m : ℕ) : turnStep m 0 = 0 := by\n  ext i\n  fin_cases i <;> simp [turnStep]\n\ntheorem mirror_zero : mirror 0 = 0 := by\n  ext i\n  fin_cases i <;> simp [mirror]\n\ntheorem turnStep_add (m : ℕ) (a b : Space) : turnStep m (a + b) = turnStep m a + turnStep m b := by\n  ext i\n  fin_cases i <;> simp [turnStep] <;> ring\n\ntheorem mirror_add (a b : Space) : mirror (a + b) = mirror a + mirror b := by\n  ext i\n  fin_cases i <;> simp [mirror]\n  ring\n\ntheorem turnStep_smul (m : ℕ) (r : ℝ) (a : Space) : turnStep m (r • a) = r • turnStep m a := by\n  ext i\n  fin_cases i <;> simp [turnStep] <;> ring\n\ntheorem mirror_smul (r : ℝ) (a : Space) : mirror (r • a) = r • mirror a := by\n  ext i\n  fin_cases i <;> simp [mirror]\n\ntheorem class_zero (m : ℕ) : IsClassField m (0 : Space → Space) := by\n  refine ⟨Filter.Eventually.of_forall fun y => ?_, Filter.Eventually.of_forall fun y => ?_⟩\n  · simp [turnStep_zero]\n  · simp [mirror_zero]\n\ntheorem class_add {m : ℕ} {v u : Space → Space} (hv : IsClassField m v) (hu : IsClassField m u) :\n    IsClassField m (v + u) := by\n  refine ⟨?_, ?_⟩\n  · filter_upwards [hv.1, hu.1] with y h1 h2\n    simp [Pi.add_apply, h1, h2, turnStep_add]\n  · filter_upwards [hv.2, hu.2] with y h1 h2\n    simp [Pi.add_apply, h1, h2, mirror_add]\n\ntheorem class_smul {m : ℕ} (r : ℝ) {v : Space → Space} (hv : IsClassField m v) :\n    IsClassField m (r • v) := by\n  refine ⟨?_, ?_⟩\n  · filter_upwards [hv.1] with y h1\n    simp [Pi.smul_apply, h1, turnStep_smul]\n  · filter_upwards [hv.2] with y h1\n    simp [Pi.smul_apply, h1, mirror_smul]\n\ntheorem gradient_zero : IsGradientField (0 : Space → Space) := by\n  refine ⟨fun _ => 0, ?_, ?_, aestronglyMeasurable_const, ?_⟩\n  · intro K _\n    simp\n  · intro K _\n    simp\n  · intro φ _ j\n    simp\n\ntheorem gradient_smul (r : ℝ) {Q : Space → Space} (hQ : IsGradientField Q) :\n    IsGradientField (r • Q) := by\n  obtain ⟨q, hq, hQ2, hQm, hid⟩ := hQ\n  refine ⟨fun y => r * q y, ?_, ?_, hQm.const_smul r, ?_⟩\n  · intro K hK\n    have h := (hq K hK).const_mul (r ^ 2)\n    refine IntegrableOn.congr_fun h (fun y _ => ?_) hK.measurableSet\n    ring\n  · intro K hK\n    have h := (hQ2 K hK).const_mul (r ^ 2)\n    refine IntegrableOn.congr_fun h (fun y _ => ?_) hK.measurableSet\n    rw [Pi.smul_apply, norm_smul, Real.norm_eq_abs, mul_pow, sq_abs]\n  · intro φ hφ j\n    have h := hid φ hφ j\n    have e1 : (fun y => fderiv ℝ φ y (unitVector j) * (r * q y)) =\n        fun y => r * (fderiv ℝ φ y (unitVector j) * q y) := by\n      funext y; ring\n    have e2 : (fun y => φ y * inner ℝ ((r • Q) y) (unitVector j)) =\n        fun y => r * (φ y * inner ℝ (Q y) (unitVector j)) := by\n      funext y; simp only [Pi.smul_apply, real_inner_smul_left]; ring\n    rw [e1, e2, integral_const_mul, integral_const_mul, h]\n    ring\n\ntheorem second_zero (m : ℕ) :\n    IsSecondOrderField m (0 : Space → Space) (0 : Space → (Space →L[ℝ] Space))\n      (0 : Space → (Space →L[ℝ] Space →L[ℝ] Space)) where\n  measurable_velocity := aestronglyMeasurable_const\n  measurable_gradient := aestronglyMeasurable_const\n  measurable_second := aestronglyMeasurable_const\n  velocity_six := MemLp.zero\n  gradient_two := by simp [entrySq]\n  second_two := by simp\n  weak_gradient := by\n    intro φ _ j\n    simp\n  weak_second := by\n    intro φ _ i j\n    simp\n  divergence := Filter.Eventually.of_forall fun y => by simp\n  symmetric := class_zero m\n\nend AdmissibleLinearInternal\n\nopen AdmissibleLinearInternal\n\ntheorem admissibleLinear : AdmissibleLinearStatement := by\n  intro k N c\n  refine ⟨?_, ?_, ?_⟩\n  · exact ⟨second_zero c.order, gradient_zero, class_zero c.order⟩\n  · rintro x x' ⟨h1, h2, h3⟩ ⟨h1', h2', h3'⟩\n    refine ⟨?_, ?_, class_add h3 h3'⟩\n    · have h := secondOrderLinear c.order _ _ _ _ _ _ 1 h1 h1'\n      simp only [one_smul] at h\n      exact h\n    · exact gradientAdd _ _ h2 h2'\n  · rintro r x ⟨h1, h2, h3⟩\n    refine ⟨?_, gradient_smul r h2, class_smul r h3⟩\n    have h := secondOrderLinear c.order _ _ _ _ _ _ r (second_zero c.order) h1\n    simp only [Pi.zero_apply, zero_add] at h\n    exact h\n\nend Assembly\n\nend CellCert\n\nend Breakdown\n"}