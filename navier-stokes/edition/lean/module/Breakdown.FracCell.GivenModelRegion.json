s":["Breakdown.CellCert.GivenModel.GivenModelRegionInternal.boxMax","Breakdown.CellCert.GivenModel.boxRadius","Breakdown.Space"],"written":"boxRadius_eq"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":145,"kind":"theorem","line":123,"module":"Breakdown.FracCell.GivenModelRegion","name":"Breakdown.CellCert.GivenModel.cellRegion_clauses","namespace":"Breakdown.CellCert.GivenModel","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CellCert.CellSystem.SumWeightsCellInternal.curlError_bound"],"proof_uses":["Breakdown.CellCert.GivenModel.CellMesh.outerSize","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.boxMax","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.boxMax_nonneg","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.cylHeight_mirror","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.cylHeight_turnStep","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.cylRadius_mirror","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.cylRadius_turnStep","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.measurableSet_solid","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.norm_le_boxMax","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.region_eq"],"protected":false,"short":"cellRegion_clauses","signature_end_line":126,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CellCert.FracCellData","Breakdown.CellCert.FracCellData.cellRegion","Breakdown.CellCert.GivenModel.CellMesh","Breakdown.CellCert.GivenModel.CellMesh.region","Breakdown.CellCert.GivenModel.IsCellMesh","Breakdown.Space","Breakdown.SteadyCert.FracCertData.order","Breakdown.SteadyCert.mirror","Breakdown.SteadyCert.turnStep"],"used_by":["Breakdown.CellCert.CellSystem.SumWeightsCellInternal.curlError_bound"],"uses":["Breakdown.CellCert.FracCellData","Breakdown.CellCert.FracCellData.cellRegion","Breakdown.CellCert.GivenModel.CellMesh","Breakdown.CellCert.GivenModel.CellMesh.outerSize","Breakdown.CellCert.GivenModel.CellMesh.region","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.boxMax","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.boxMax_nonneg","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.cylHeight_mirror","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.cylHeight_turnStep","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.cylRadius_mirror","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.cylRadius_turnStep","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.measurableSet_solid","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.norm_le_boxMax","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.region_eq","Breakdown.CellCert.GivenModel.IsCellMesh","Breakdown.Space","Breakdown.SteadyCert.FracCertData.order","Breakdown.SteadyCert.mirror","Breakdown.SteadyCert.turnStep"],"written":"cellRegion_clauses"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":202,"kind":"theorem","line":147,"module":"Breakdown.FracCell.GivenModelRegion","name":"Breakdown.CellCert.GivenModel.exterior_clauses","namespace":"Breakdown.CellCert.GivenModel","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":["Breakdown.CellCert.CellAnalysis.cylHeight","Breakdown.CellCert.CellAnalysis.cylRadius","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.boxMax","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.boxMax_le_norm","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.boxMax_nonneg","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.boxMax_smul","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.continuous_boxMax","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.norm_le_boxMax","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.one_le_sqrt_two","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.region_eq","Breakdown.CellCert.GivenModel.IsCellMesh.outerSize_pos"],"protected":false,"short":"exterior_clauses","signature_end_line":152,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CellCert.Exterior.ExteriorData","Breakdown.CellCert.Exterior.ExteriorData.radius","Breakdown.CellCert.Exterior.ExteriorData.radiusMax","Breakdown.CellCert.Exterior.ExteriorData.radiusMin","Breakdown.CellCert.FracCellData","Breakdown.CellCert.FracCellData.cellRegion","Breakdown.CellCert.GivenModel.CellMesh","Breakdown.CellCert.GivenModel.CellMesh.outerSize","Breakdown.CellCert.GivenModel.CellMesh.region","Breakdown.CellCert.GivenModel.IsCellMesh","Breakdown.CellCert.GivenModel.boxRadius","Breakdown.Space"],"used_by":[],"uses":["Breakdown.CellCert.CellAnalysis.cylHeight","Breakdown.CellCert.CellAnalysis.cylRadius","Breakdown.CellCert.Exterior.ExteriorData","Breakdown.CellCert.Exterior.ExteriorData.radius","Breakdown.CellCert.Exterior.ExteriorData.radiusMax","Breakdown.CellCert.Exterior.ExteriorData.radiusMin","Breakdown.CellCert.FracCellData","Breakdown.CellCert.FracCellData.cellRegion","Breakdown.CellCert.GivenModel.CellMesh","Breakdown.CellCert.GivenModel.CellMesh.outerSize","Breakdown.CellCert.GivenModel.CellMesh.region","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.boxMax","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.boxMax_le_norm","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.boxMax_nonneg","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.boxMax_smul","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.continuous_boxMax","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.norm_le_boxMax","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.one_le_sqrt_two","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.region_eq","Breakdown.CellCert.GivenModel.IsCellMesh","Breakdown.CellCert.GivenModel.IsCellMesh.outerSize_pos","Breakdown.CellCert.GivenModel.boxRadius","Breakdown.Space"],"written":"exterior_clauses"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":214,"kind":"theorem","line":210,"module":"Breakdown.FracCell.GivenModelRegion","name":"Breakdown.CellCert.GivenModel.ball_subset_region","namespace":"Breakdown.CellCert.GivenModel","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":["Breakdown.CellCert.GivenModel.GivenModelRegionInternal.abs_cylHeight_le_norm","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.cylRadius_le_norm","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.region_eq"],"protected":false,"short":"ball_subset_region","signature_end_line":211,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CellCert.GivenModel.CellMesh","Breakdown.CellCert.GivenModel.CellMesh.outerSize","Breakdown.CellCert.GivenModel.CellMesh.region","Breakdown.CellCert.GivenModel.IsCellMesh","Breakdown.Space"],"used_by":[],"uses":["Breakdown.CellCert.GivenModel.CellMesh","Breakdown.CellCert.GivenModel.CellMesh.outerSize","Breakdown.CellCert.GivenModel.CellMesh.region","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.abs_cylHeight_le_norm","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.cylRadius_le_norm","Breakdown.CellCert.GivenModel.GivenModelRegionInternal.region_eq","Breakdown.CellCert.GivenModel.IsCellMesh","Breakdown.Space"],"written":"ball_subset_region"}],"imports":["Breakdown.FracCell.GivenModelDefs"],"module":"Breakdown.FracCell.GivenModelRegion","path":"Breakdown/FracCell/GivenModelRegion.lean","sha256":"990eadce085caf78e6d5f50d665cbcae1bb7e2dec848428cec955f719d9e49ee","source":"import Breakdown.FracCell.GivenModelDefs\n\nopen MeasureTheory\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace CellCert\n\nnamespace GivenModel\n\nopen SteadyCert CellAnalysis\n\nnamespace GivenModelRegionInternal\n\ntheorem cylRadius_nonneg (y : Space) : 0 ≤ cylRadius y := Real.sqrt_nonneg _\n\ntheorem cylRadius_sq (y : Space) : cylRadius y ^ 2 = y 0 ^ 2 + y 1 ^ 2 :=\n  Real.sq_sqrt (by positivity)\n\ntheorem norm_sq_eq (y : Space) : ‖y‖ ^ 2 = cylRadius y ^ 2 + cylHeight y ^ 2 := by\n  rw [EuclideanSpace.norm_eq, Real.sq_sqrt (by positivity), cylRadius_sq, cylHeight, Fin.sum_univ_three]\n  simp [Real.norm_eq_abs, sq_abs]\n\ntheorem continuous_cylRadius : Continuous cylRadius := by\n  unfold cylRadius\n  fun_prop\n\ntheorem continuous_cylHeight : Continuous cylHeight := by\n  unfold cylHeight\n  fun_prop\n\ntheorem le_of_sq_le {a b : ℝ} (hb : 0 ≤ b) (h : a ^ 2 ≤ b ^ 2) : a ≤ b := by\n  have h1 := Real.sqrt_le_sqrt h\n  rw [Real.sqrt_sq_eq_abs, Real.sqrt_sq hb] at h1\n  exact (le_abs_self a).trans h1\n\ntheorem cylRadius_le_norm (y : Space) : cylRadius y ≤ ‖y‖ :=\n  le_of_sq_le (norm_nonneg y) (by rw [norm_sq_eq]; nlinarith [sq_nonneg (cylHeight y)])\n\ntheorem abs_cylHeight_le_norm (y : Space) : |cylHeight y| ≤ ‖y‖ :=\n  le_of_sq_le (norm_nonneg y) (by rw [norm_sq_eq, sq_abs]; nlinarith [sq_nonneg (cylRadius y)])\n\ntheorem measurableSet_solid (K : CellBox) : MeasurableSet K.solid := by\n  have hρ := continuous_cylRadius.measurable\n  have hh := (continuous_abs.comp continuous_cylHeight).measurable\n  exact (measurableSet_le measurable_const hρ).inter ((measurableSet_le hρ measurable_const).inter\n    ((measurableSet_le measurable_const hh).inter (measurableSet_le hh measurable_const)))\n\ntheorem region_eq (M : CellMesh) (hM : IsCellMesh M) :\n    M.region = {y | cylRadius y ≤ M.outerSize ∧ |cylHeight y| ≤ M.outerSize} := by\n  ext y\n  simp only [CellMesh.region, Set.mem_iUnion, Set.mem_ofPred_eq]\n  constructor\n  · rintro ⟨K, hK⟩\n    simp only [CellBox.solid, Set.mem_ofPred_eq] at hK\n    exact ⟨hK.2.1.trans (hM.boxes_inside K).1, hK.2.2.2.trans (hM.boxes_inside K).2⟩\n  · rintro ⟨h1, h2⟩\n    obtain ⟨K, hK⟩ := hM.boxes_cover (cylRadius y, |cylHeight y|) (cylRadius_nonneg y) h1 (abs_nonneg _) h2\n    refine ⟨K, ?_⟩\n    simp only [CellBox.rect, Set.mem_prod, Set.mem_Icc] at hK\n    simp only [CellBox.solid, Set.mem_ofPred_eq]\n    exact ⟨hK.1.1, hK.1.2, hK.2.1, hK.2.2⟩\n\ntheorem cylRadius_turnStep (m : ℕ) (y : Space) : cylRadius (turnStep m y) = cylRadius y := by\n  unfold cylRadius\n  congr 1\n  simp only [turnStep, PiLp.add_apply, PiLp.single_apply]\n  simp\n  linear_combination (y 0 ^ 2 + y 1 ^ 2) * Real.sin_sq_add_cos_sq (2 * Real.pi / m)\n\ntheorem cylHeight_turnStep (m : ℕ) (y : Space) : cylHeight (turnStep m y) = cylHeight y := by\n  simp [cylHeight, turnStep]\n\ntheorem cylRadius_mirror (y : Space) : cylRadius (mirror y) = cylRadius y := by\n  simp [cylRadius, mirror]\n\ntheorem cylHeight_mirror (y : Space) : cylHeight (mirror y) = -cylHeight y := by\n  simp [cylHeight, mirror]\n\ndef boxMax (y : Space) : ℝ := max (cylRadius y) |cylHeight y|\n\ntheorem continuous_boxMax : Continuous boxMax :=\n  continuous_cylRadius.max (continuous_abs.comp continuous_cylHeight)\n\ntheorem boxMax_nonneg (y : Space) : 0 ≤ boxMax y := (cylRadius_nonneg y).trans (le_max_left _ _)\n\ntheorem boxMax_le_norm (y : Space) : boxMax y ≤ ‖y‖ :=\n  max_le (cylRadius_le_norm y) (abs_cylHeight_le_norm y)\n\ntheorem norm_le_boxMax (y : Space) : ‖y‖ ≤ Real.sqrt 2 * boxMax y := by\n  have h2 : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)\n  have hρ : cylRadius y ≤ boxMax y := le_max_left _ _\n  have hh : |cylHeight y| ≤ boxMax y := le_max_right _ _\n  refine le_of_sq_le (mul_nonneg (Real.sqrt_nonneg 2) (boxMax_nonneg y)) ?_\n  rw [norm_sq_eq, mul_pow, h2, ← sq_abs (cylHeight y)]\n  have := cylRadius_nonneg y\n  have := abs_nonneg (cylHeight y)\n  nlinarith\n\ntheorem one_le_sqrt_two : (1 : ℝ) ≤ Real.sqrt 2 := by\n  have := Real.sqrt_le_sqrt (show (1 : ℝ) ≤ 2 by norm_num)\n  rwa [Real.sqrt_one] at this\n\ntheorem boxMax_smul (t : ℝ) (ht : 0 < t) (y : Space) : boxMax (t • y) = t * boxMax y := by\n  have hρ : cylRadius (t • y) = t * cylRadius y := by\n    unfold cylRadius\n    simp only [PiLp.smul_apply, smul_eq_mul]\n    rw [show (t * y 0) ^ 2 + (t * y 1) ^ 2 = t ^ 2 * (y 0 ^ 2 + y 1 ^ 2) by ring,\n      Real.sqrt_mul (sq_nonneg t), Real.sqrt_sq ht.le]\n  have hh : |cylHeight (t • y)| = t * |cylHeight y| := by\n    simp only [cylHeight, PiLp.smul_apply, smul_eq_mul, abs_mul, abs_of_pos ht]\n  rw [boxMax, boxMax, hρ, hh, mul_max_of_nonneg _ _ ht.le]\n\ntheorem boxRadius_eq (L : ℝ) (y : Space) :\n    boxRadius L y = if boxMax y = 0 then L else L * ‖y‖ / boxMax y := rfl\n\nend GivenModelRegionInternal\n\nopen GivenModelRegionInternal\n\ntheorem cellRegion_clauses {k N : ℕ} (c : FracCellData k N) (M : CellMesh) (hM : IsCellMesh M)\n    (hR : c.cellRegion = M.region) :\n    MeasurableSet c.cellRegion ∧ Bornology.IsBounded c.cellRegion ∧\n      ∀ y ∈ c.cellRegion, turnStep c.order y ∈ c.cellRegion ∧ mirror y ∈ c.cellRegion := by\n  rw [hR]\n  refine ⟨MeasurableSet.iUnion fun K => measurableSet_solid _, ?_, ?_⟩\n  · rw [region_eq M hM]\n    refine (Metric.isBounded_closedBall (x := (0 : Space)) (r := 2 * M.outerSize)).subset ?_\n    rintro y ⟨h1, h2⟩\n    rw [Metric.mem_closedBall, dist_zero_right]\n    have := norm_le_boxMax y\n    have h3 : boxMax y ≤ M.outerSize := max_le h1 h2\n    have h4 : Real.sqrt 2 ≤ 2 := by\n      rw [show (2 : ℝ) = Real.sqrt 4 by rw [show (4 : ℝ) = 2 ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]]\n      exact Real.sqrt_le_sqrt (by norm_num)\n    nlinarith [boxMax_nonneg y, Real.sqrt_nonneg 2]\n  · rw [region_eq M hM]\n    rintro y ⟨h1, h2⟩\n    refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩\n    · rwa [cylRadius_turnStep]\n    · rwa [cylHeight_turnStep]\n    · rwa [cylRadius_mirror]\n    · rwa [cylHeight_mirror, abs_neg]\n\ntheorem exterior_clauses {k N : ℕ} (c : FracCellData k N) (M : CellMesh) (hM : IsCellMesh M)\n    (hR : c.cellRegion = M.region) (e : Exterior.ExteriorData) (he : e.radius = boxRadius M.outerSize)\n    (hmin : e.radiusMin = M.outerSize) (hmax : e.radiusMax = Real.sqrt 2 * M.outerSize) :\n    Measurable e.radius ∧ 0 < e.radiusMin ∧ (∀ y, e.radiusMin ≤ e.radius y ∧ e.radius y ≤ e.radiusMax) ∧\n      (∀ (t : ℝ) (y : Space), 0 < t → e.radius (t • y) = e.radius y) ∧\n      c.cellRegionᶜ =ᵐ[volume] {y : Space | e.radius y < ‖y‖} := by\n  have hL := hM.outerSize_pos\n  rw [he, hmin, hmax]\n  refine ⟨?_, hL, ?_, ?_, ?_⟩\n  · have hDm := continuous_boxMax.measurable\n    have : boxRadius M.outerSize = fun y => if boxMax y = 0 then M.outerSize else M.outerSize * ‖y‖ / boxMax y :=\n      funext (boxRadius_eq _)\n    rw [this]\n    exact Measurable.ite (measurableSet_eq_fun hDm measurable_const) measurable_const\n      ((measurable_const.mul measurable_norm).div hDm)\n  · intro y\n    rw [boxRadius_eq]\n    split_ifs with hD\n    · exact ⟨le_rfl, le_mul_of_one_le_left hL.le one_le_sqrt_two⟩\n    · have hDp : 0 < boxMax y := lt_of_le_of_ne (boxMax_nonneg y) (Ne.symm hD)\n      constructor\n      · rw [le_div_iff₀ hDp]\n        exact mul_le_mul_of_nonneg_left (boxMax_le_norm y) hL.le\n      · rw [div_le_iff₀ hDp]\n        have := mul_le_mul_of_nonneg_left (norm_le_boxMax y) hL.le\n        nlinarith\n  · intro t y ht\n    rw [boxRadius_eq, boxRadius_eq, boxMax_smul t ht y, norm_smul, Real.norm_of_nonneg ht.le]\n    by_cases hD : boxMax y = 0\n    · simp [hD]\n    · have ht0 : t ≠ 0 := ht.ne'\n      rw [if_neg (mul_ne_zero ht0 hD), if_neg hD]\n      field_simp\n  · have hset : (M.region)ᶜ = {y : Space | boxRadius M.outerSize y < ‖y‖} := by\n      ext y\n      rw [region_eq M hM]\n      simp only [Set.mem_compl_iff, Set.mem_ofPred_eq]\n      rw [boxRadius_eq]\n      have hiff : ¬(cylRadius y ≤ M.outerSize ∧ |cylHeight y| ≤ M.outerSize) ↔ M.outerSize < boxMax y := by\n        rw [boxMax, lt_max_iff, not_and_or, not_le, not_le]\n      rw [hiff]\n      split_ifs with hD\n      · have h0 : ‖y‖ ≤ 0 := by have := norm_le_boxMax y; rw [hD, mul_zero] at this; exact this\n        rw [hD]\n        constructor\n        · intro h; linarith\n        · intro h; linarith [norm_nonneg y]\n      · have hDp : 0 < boxMax y := lt_of_le_of_ne (boxMax_nonneg y) (Ne.symm hD)\n        have hn : 0 < ‖y‖ := hDp.trans_le (boxMax_le_norm y)\n        rw [div_lt_iff₀ hDp]\n        constructor\n        · intro h; nlinarith\n        · intro h; nlinarith\n    refine Filter.Eventually.of_forall fun y => ?_\n    show (y ∈ c.cellRegionᶜ) = (y ∈ {y : Space | boxRadius M.outerSize y < ‖y‖})\n    rw [hR, hset]\n\nend GivenModel\n\nnamespace GivenModel\n\nopen SteadyCert CellAnalysis CellFormula\n\ntheorem ball_subset_region (M : CellMesh) (hM : IsCellMesh M) :\n    ∀ y : Space, ‖y‖ ≤ M.outerSize → y ∈ M.region := by\n  intro y hy\n  rw [GivenModelRegionInternal.region_eq M hM]\n  exact ⟨(GivenModelRegionInternal.cylRadius_le_norm y).trans hy, (GivenModelRegionInternal.abs_cylHeight_le_norm y).trans hy⟩\n\nend GivenModel\n\nend CellCert\n\nend Breakdown\n"}