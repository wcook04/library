"citation_ids":["cite.pcp-reading-guide.claim-pcp-theorem"],"evidence_ids":["link.pcp-reading-guide.claim-pcp-theorem"],"id":"pcp-reading-guide.claim-pcp-theorem","kind":"goal","label":"NP ⊆ PCP(O(log n), O(1))","locator":"NP ⊆ PCP(O(log n), O(1)), Section 4","source_id":"paper","statement":"theorem np_subset_pcp (L : Language) (hL : InNP Machine.PolyTimeRel L) :\n    ∃ (V : Verifier) (alg : VerifierAlg) (a b q : ℕ) (p : Polynomial ℕ),\n      Machine.PolyTimeAlg alg ∧\n      V.ImplementedBy alg ∧\n      V.queries = q ∧\n      V.CanonicalRandomness a b ∧\n      (∀ x : List Bool, V.ReadsBelow x (p.eval x.length)) ∧\n      (∀ x : List Bool, L x → V.CompleteAt x) ∧\n      (∀ x : List Bool, ¬ L x → V.SoundAt x (1 / 2))","status":"unverified"},"ref":"sha256:4f9b3505272050648bb61ab83f4692e97db56924f4f80098e9bfa2698ccafdb5/nodes/pcp-reading-guide.claim-pcp-theorem","table":"nodes","usage":{"direct_passages":[{"anchor":"sec-4","mapping_field":"claim_ids","mapping_ref":"sha256:56c88dc58dc542c29ceb0d90a3aa437c3b23d1863603f56716f496e7b183f359/papers/short.json","passage_ref":"sha256:b508f1874c9f50630ac7a077957360bc7650b8eea2c6234c9e96f78d1d627e6f/papers/short.md/sha256:56c88dc58dc542c29ceb0d90a3aa437c3b23d1863603f56716f496e7b183f359/papers/short.json/passages/sec-4","stage":"short"}],"paper_focus":[{"mapping_ref":"sha256:5328c59d251f022930a573dd41f68b62e95c168d157e2749eac2ab6f8ded9770/papers/long.json","stage":"long"},{"mapping_ref":"sha256:56c88dc58dc542c29ceb0d90a3aa437c3b23d1863603f56716f496e7b183f359/papers/short.json","stage":"short"},{"mapping_ref":"sha256:fa7f524232a98f0197aa2f292b0ecb2ef87e1b1399765f46055bed2c18d98a7a/papers/expository.json","stage":"expository"}],"paper_memberships":[{"roles":["mapped_claim"],"stage":"short","subgraph_ref":"sha256:56c88dc58dc542c29ceb0d90a3aa437c3b23d1863603f56716f496e7b183f359/papers/short.json/support/0.3.1/4385b21b0046f56861e5c10b325b78802c32cf172afea944bdaa772e50a5165f"}],"record_ref":"sha256:4f9b3505272050648bb61ab83f4692e97db5692