le":false,"private":false,"protected":false,"short":"vacuous_claim","signature_end_line":18,"used_by":[],"uses":["Round3.SharedBadSpec.IsComparison"],"uses_modules":{"Round3.SharedBadSpec.IsComparison":"QuarticCorpus.Independent.Controls.SharedChallenge"},"written":"vacuous_claim"}],"imports":["Mathlib"],"module":"QuarticCorpus.Independent.Controls.SharedChallenge","path":"QuarticCorpus/Independent/Controls/SharedChallenge.lean","sha256":"df4b12ec080e645245f65e6102b9537d21455cb962da0b4f9c56c77e9370608f","source":"module\n\npublic import Mathlib\n\n/-! Deliberately shared bad specification, handwritten as a blind-spot\ndemonstration. Agreement with SharedSolution would not establish meaning. -/\n\n@[expose] public section\nset_option autoImplicit false\n\nnamespace Round3.SharedBadSpec\n\nstructure IsComparison (a : Fin 2 → Fin 2 → ℝ) : Prop where\n  complementary : ∀ i j, i ≠ j → a i j + a j i = 1\n  self_zero : ∀ i, a i i = 0\n  impossible : False\n\ntheorem vacuous_claim (a : Fin 2 → Fin 2 → ℝ) (ha : IsComparison a) : (1 : ℝ) = 0 := by\n  sorry\n\nend Round3.SharedBadSpec\n"}