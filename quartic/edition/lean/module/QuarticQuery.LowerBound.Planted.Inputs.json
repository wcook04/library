owerBound.Planted.Inputs","name":"QuarticQuery.addressedF_dummy","namespace":"QuarticQuery","noncomputable":false,"private":false,"proof_used_by":["QuarticQuery.Paper.dummy_planted_values_on_support","QuarticQuery.addressedF_not_RLe"],"proof_uses":["QuarticQuery.Address","QuarticQuery.GateConsistent","QuarticQuery.WinsAt","QuarticQuery.pointerEquiv","QuarticQuery.readA","QuarticQuery.readPointerBit","QuarticQuery.readTranscript","QuarticQuery.readX"],"protected":false,"short":"addressedF_dummy","signature_end_line":98,"statement_used_by":[],"statement_uses":["QuarticQuery.BitInput","QuarticQuery.Circuit","QuarticQuery.Circuit.size","QuarticQuery.Column","QuarticQuery.PartialBool","QuarticQuery.addressedF","QuarticQuery.dummy"],"used_by":["QuarticQuery.Paper.dummy_planted_values_on_support","QuarticQuery.addressedF_not_RLe"],"uses":["QuarticQuery.Address","QuarticQuery.BitInput","QuarticQuery.Circuit","QuarticQuery.Circuit.size","QuarticQuery.Column","QuarticQuery.GateConsistent","QuarticQuery.PartialBool","QuarticQuery.WinsAt","QuarticQuery.addressedF","QuarticQuery.dummy","QuarticQuery.pointerEquiv","QuarticQuery.readA","QuarticQuery.readPointerBit","QuarticQuery.readTranscript","QuarticQuery.readX"],"uses_modules":{"QuarticQuery.BitInput":"QuarticQuery.Statement","QuarticQuery.Column":"QuarticQuery.Statement","QuarticQuery.addressedF":"QuarticQuery.Statement","QuarticQuery.readX":"QuarticQuery.Statement"},"written":"addressedF_dummy"},{"dependency_source":"lean_report","doc":"Ledger: claim-Y-values. On strings in the domain, column `I` of `Y⁽¹⁾` wins at\nits true address.","end_line":128,"kind":"theorem","line":106,"module":"QuarticQuery.LowerBound.Planted.Inputs","name":"QuarticQuery.addressedF_planted","namespace":"QuarticQuery","noncomputable":false,"private":false,"proof_used_by":["QuarticQuery.Paper.dummy_planted_values_on_support","QuarticQuery.addressedF_not_RLe"],"proof_uses":["QuarticQuery.Address","QuarticQuery.WinsAt","QuarticQuery.f_eq_trueAddr","QuarticQuery.pointerEquiv","QuarticQuery.readA","QuarticQuery.readPointerBit","QuarticQuery.readTranscript","QuarticQuery.readX","QuarticQuery.trueAddr"],"protected":false,"short":"addressedF_planted","signature_end_line":109,"statement_used_by":[],"statement_uses":["QuarticQuery.BitInput","QuarticQuery.Circuit","QuarticQuery.Circuit.size","QuarticQuery.Column","QuarticQuery.GateConsistent","QuarticQuery.PartialBool","QuarticQuery.addressedF","QuarticQuery.planted","QuarticQuery.promised"],"used_by":["QuarticQuery.Paper.dummy_planted_values_on_support","QuarticQuery.addressedF_not_RLe"],"uses":["QuarticQuery.Address","QuarticQuery.BitInput","QuarticQuery.Circuit","QuarticQuery.Circuit.size","QuarticQuery.Column","QuarticQuery.GateConsistent","QuarticQuery.PartialBool","QuarticQuery.WinsAt","QuarticQuery.addressedF","QuarticQuery.f_eq_trueAddr","QuarticQuery.planted","QuarticQuery.pointerEquiv","QuarticQuery.promised","QuarticQuery.readA","QuarticQuery.readPointerBit","QuarticQuery.readTranscript","QuarticQuery.readX","QuarticQuery.trueAddr"],"uses_modules":{"QuarticQuery.BitInput":"QuarticQuery.Statement","QuarticQuery.Column":"QuarticQuery.Statement","QuarticQuery.GateConsistent":"QuarticQuery.Statement","QuarticQuery.WinsAt":"QuarticQuery.Statement","QuarticQuery.addressedF":"QuarticQuery.Statement","QuarticQuery.pointerEquiv":"QuarticQuery.Statement","QuarticQuery.promised":"QuarticQuery.Statement","QuarticQuery.readA":"QuarticQuery.Statement","QuarticQuery.readPointerBit":"QuarticQuery.Statement","QuarticQuery.readTranscript":"QuarticQuery.Statement","QuarticQuery.readX":"QuarticQuery.Statement"},"written":"addressedF_planted"}],"imports":["QuarticQuery.Statement"],"module":"QuarticQuery.LowerBound.Planted.Inputs","path":"QuarticQuery/LowerBound/Planted/Inputs.lean","sha256":"8a51b7b7696acdda52b0762b65c2f9e8bec13da8d896c47102c447195509411f","source":"module\n\npublic import QuarticQuery.Statement\n\n/-!\n# The coupled dummy and planted inputs\n\nThe dummy input has one zero in every column and blank cells. The planted input\nfills in one column as a true winner. The two differ only at the removed zero and\ninside the planted cell. The address of a column is a total function here: on\nstrings off the promise it takes a default value, and such strings have weight\nzero under the hard distribution.\n-/\n\n@[expose] public section\n\nnamespace QuarticQuery\n\nvariable {κ : Type} {ℓ r S : ℕ}\n\n/-- Ledger: def-planted. `s_i` of equation (7) as a total function: the default\n`false` is used only off the promise. -/\ndef trueAddr (f : PartialBool κ) (U : Fin r → BitInput κ) : Address r :=\n  fun h => (f (U h)).getD false\n\ntheorem f_eq_trueAddr {f : PartialBool κ} {U : Fin r → BitInput κ} {h : Fin r}\n    (hU : promised f (U h)) : f (U h) = some (trueAddr f U h) := by\n  obtain ⟨b, hb⟩ := hU\n  simp [trueAddr, hb]\n\n/-- The column and address of a cell bit, either pointer or transcript. -/\ndef cellOf : BitLoc ℓ r S κ → Option (Column ℓ × Address r)\n  | .inl _ => none\n  | .inr (.inl _) => none\n  | .inr (.inr (.inl ⟨i, (s, _, _)⟩)) => some (i, s)\n  | .inr (.inr (.inr (i, s, _, _))) => some (i, s)\n\n/-- Whether a location is a bit of `X_i`. -/\ndef xColumn (i : Column ℓ) : BitLoc ℓ r S κ → Bool\n  | .inl (c, _) => decide (c = i)\n  | .inr _ => false\n\n/-- The instance and coordinate of a location inside `A_{i,1}, …, A_{i,r}`. -/\ndef aTarget [DecidableEq κ] (i : Column ℓ) : BitLoc ℓ r S κ → Option (Fin r × κ)\n  | .inr (.inl (c, h, q)) => if c = i then some (h, q) else none\n  | _ => none\n\n/-- Ledger: def-dummy. `Y⁽⁰⁾`: one zero in `X_i`, at `J i`; the given `A`; blank\ncells. -/\ndef dummy (J : Column ℓ → Column ℓ) (A : Column ℓ → Fin r → BitInput κ) :\n    BitInput (BitLoc ℓ r S κ)\n  | .inl (i, j) => decide (j ≠ J i)\n  | .inr (.inl (i, h, q)) => A i h q\n  | .inr (.inr _) => false\n\n/-- Ledger: def-planted. `Y⁽¹⁾`: `X_I` is all ones and the cell of `I` at its true\naddress holds the transcripts `tr` and pointers to the zeros of the other columns. -/\ndef planted (f : PartialBool κ) (tr : BitInput κ → Fin S → Bool)\n    (J : Column ℓ → Column ℓ) (A : Column ℓ → Fin r → BitInput κ) (I : Column ℓ) :\n    BitInput (BitLoc ℓ r S κ)\n  | .inl (i, j) => if i = I then true else decide (j ≠ J i)\n  | .inr (.inl (i, h, q)) => A i h q\n  | .inr (.inr (.inl ⟨i, (s, j, b)⟩)) =>\n      if i = I ∧ s = trueAddr f (A I) then (pointerEquiv ℓ).symm (J j.val) b else false\n  | .inr (.inr (.inr (i, s, h, g))) =>\n      if i = I ∧ s = trueAddr f (A I) then tr (A I h) g else false\n\n/-- Ledger: eq-18. The coupled inputs differ only at `X_I[J_I]` and inside the cell\n`B_{I, s_I}`. -/\ntheorem eq_of_dummy_ne_planted {f : PartialBool κ} {tr : BitInput κ → Fin S → Bool}\n    {J : Column ℓ → Column ℓ} {A : Column ℓ → Fin r → BitInput κ} {I : Column ℓ}\n    {q : BitLoc ℓ r S κ} (h : dummy J A q ≠ planted f tr J A I q) :\n    q = .inl (I, J I) ∨ cellOf q = some (I, trueAddr f (A I)) := by\n  rcases q with ⟨i, j⟩ | ⟨i, a, q⟩ | ⟨i, s, j, b⟩ | ⟨i, s, a, g⟩\n  · left\n    by_cases hi : i = I\n    · subst hi\n      by_cases hj : j = J i\n      · rw [hj]\n      · simp [dummy, planted, hj] at h\n    · simp [dummy, planted, hi] at h\n  · exact absurd rfl h\n  · right\n    by_cases hc : i = I ∧ s = trueAddr f (A I)\n    · obtain ⟨rfl, rfl⟩ := hc\n      rfl\n    · simp [dummy, planted, hc] at h\n  · right\n    by_cases hc : i = I ∧ s = trueAddr f (A I)\n    · obtain ⟨rfl, rfl⟩ := hc\n      rfl\n    · simp [dummy, planted, hc] at h\n\nvariable {f : PartialBool κ} {C : Circuit κ}\n\n/-- Ledger: claim-Y-values. Every column of `Y⁽⁰⁾` has a zero, so nothing wins. -/\ntheorem addressedF_dummy (J : Column ℓ → Column ℓ) (A : Column ℓ → Fin r → BitInput κ) :\n    addressedF f C ℓ r (dummy J A) = false := by\n  simp only [addressedF, decide_eq_false_iff_not]\n  rintro ⟨i, s, hX, -⟩\n  have := hX (J i)\n  simp [readX, dummy] at this\n\n/-- Ledger: claim-Y-values. On strings in the domain, column `I` of `Y⁽¹⁾` wins at\nits true address. -/\ntheorem addressedF_planted {tr : BitInput κ → Fin C.size → Bool}\n    (htr : ∀ x, GateConsistent C x (tr x)) (J : Column ℓ → Column ℓ)\n    (A : Column ℓ → Fin r → BitInput κ) (I : Column ℓ) (hA : ∀ h, promised f (A I h)) :\n    addressedF f C ℓ r (planted f tr J A I) = true := by\n  have hw : WinsAt f C ℓ r (planted f tr J A I) I (trueAddr f (A I)) := by\n    refine ⟨fun j => ?_, fun h => ?_, fun h => ?_, fun j => ?_⟩\n    · simp [readX, planted]\n    · have : readA (planted f tr J A I) I h = A I h := rfl\n      rw [this]\n      exact f_eq_trueAddr (hA h)\n    · have : readTranscript (planted f tr J A I) I (trueAddr f (A I)) h = tr (A I h) := by\n        funext g\n        simp [readTranscript, planted]\n      rw [this]\n      exact htr _\n    · have hp : readPointerBit (planted f tr J A I) I (trueAddr f (A I)) j =\n          (pointerEquiv ℓ).symm (J j.val) := by\n        funext b\n        simp [readPointerBit, planted]\n      rw [hp, Equiv.apply_symm_apply]\n      simp [readX, planted, j.2]\n  simp only [addressedF, decide_eq_true_eq]\n  exact ⟨I, _, hw⟩\n\nend QuarticQuery\n"}