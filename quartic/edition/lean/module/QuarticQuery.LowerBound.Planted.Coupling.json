:43,"module":"QuarticQuery.LowerBound.Planted.Coupling","name":"QuarticQuery.QueryTree.exists_mem_path_ne","namespace":"QuarticQuery.QueryTree","noncomputable":false,"private":false,"proof_used_by":["QuarticQuery.Paper.output_gap_abs_le_unsplit","QuarticQuery.output_gap_le"],"proof_uses":["QuarticQuery.QueryTree.leaf","QuarticQuery.QueryTree.query"],"protected":false,"short":"exists_mem_path_ne","signature_end_line":44,"statement_used_by":[],"statement_uses":["QuarticQuery.BitInput","QuarticQuery.QueryTree","QuarticQuery.QueryTree.eval","QuarticQuery.QueryTree.path"],"used_by":["QuarticQuery.Paper.output_gap_abs_le_unsplit","QuarticQuery.output_gap_le"],"uses":["QuarticQuery.BitInput","QuarticQuery.QueryTree","QuarticQuery.QueryTree.eval","QuarticQuery.QueryTree.leaf","QuarticQuery.QueryTree.path","QuarticQuery.QueryTree.query"],"uses_modules":{"QuarticQuery.BitInput":"QuarticQuery.Statement","QuarticQuery.QueryTree":"QuarticQuery.Statement","QuarticQuery.QueryTree.eval":"QuarticQuery.Statement","QuarticQuery.QueryTree.leaf":"QuarticQuery.Statement","QuarticQuery.QueryTree.query":"QuarticQuery.Statement"},"written":"exists_mem_path_ne"},{"dependency_source":"lean_report","doc":"If each location belongs to at most one class `a`, the class counts of a list\nadd up to at most its length.","end_line":71,"kind":"theorem","line":61,"module":"QuarticQuery.LowerBound.Planted.Coupling","name":"QuarticQuery.sum_countP_le_length","namespace":"QuarticQuery","noncomputable":false,"private":false,"proof_used_by":["QuarticQuery.sum_aQueries_le","QuarticQuery.sum_xQueries_le"],"proof_uses":[],"protected":false,"short":"sum_countP_le_length","signature_end_line":63,"statement_used_by":[],"statement_uses":[],"used_by":["QuarticQuery.sum_aQueries_le","QuarticQuery.sum_xQueries_le"],"uses":[],"written":"sum_countP_le_length"}],"imports":["QuarticQuery.Statement"],"module":"QuarticQuery.LowerBound.Planted.Coupling","path":"QuarticQuery/LowerBound/Planted/Coupling.lean","sha256":"35d0f76652f6aa52acb73dfe3b5c01eb70eefdf9397cc83f4b4469017de61824","source":"module\n\npublic import QuarticQuery.Statement\n\n/-!\n# Runs of a decision tree\n\n`T.path x` is the list of locations `T` queries on `x`, repeats included. Two\ninputs that agree along the run on the first have the same output: this is the\ncoupling step of equation (18). The last lemma charges each query to at most one\ncolumn, which both counting bounds use.\n-/\n\n@[expose] public section\n\nopen Finset\n\nnamespace QuarticQuery\n\nvariable {ι : Type}\n\nnamespace QueryTree\n\n/-- The locations queried on `x`, in order, repeats included. -/\ndef path : QueryTree ι → BitInput ι → List ι\n  | .leaf _, _ => []\n  | .query i l r, x => i :: (if x i then r.path x else l.path x)\n\n@[simp] theorem path_leaf (b : Bool) (x : BitInput ι) : (leaf b : QueryTree ι).path x = [] := rfl\n\ntheorem path_query (i : ι) (l r : QueryTree ι) (x : BitInput ι) :\n    (query i l r).path x = i :: (if x i then r.path x else l.path x) := rfl\n\ntheorem length_path_le (T : QueryTree ι) (x : BitInput ι) : (T.path x).length ≤ T.depth := by\n  induction T with\n  | leaf b => simp\n  | query i l r ihl ihr =>\n    simp only [path_query, depth, List.length_cons]\n    split_ifs <;> omega\n\n/-- Ledger: eq-18. Different outputs force a query at a location where the two\ninputs differ, on the run of the first input. -/\ntheorem exists_mem_path_ne (T : QueryTree ι) {x y : BitInput ι} (h : T.eval x ≠ T.eval y) :\n    ∃ q ∈ T.path x, x q ≠ y q := by\n  induction T with\n  | leaf b => exact absurd rfl h\n  | query i l r ihl ihr =>\n    by_cases hi : x i = y i\n    · simp only [QueryTree.eval, ← hi] at h\n      cases hx : x i\n      · obtain ⟨q, hq, hne⟩ := ihl (by simpa [hx] using h)\n        exact ⟨q, by simp [path_query, hx, hq], hne⟩\n      · obtain ⟨q, hq, hne⟩ := ihr (by simpa [hx] using h)\n        exact ⟨q, by simp [path_query, hx, hq], hne⟩\n    · exact ⟨i, by simp [path_query], hi⟩\n\nend QueryTree\n\n/-- If each location belongs to at most one class `a`, the class counts of a list\nadd up to at most its length. -/\ntheorem sum_countP_le_length {γ : Type} [Fintype γ] (c : γ → ι → Bool)\n    (hc : ∀ a b q, c a q = true → c b q = true → a = b) (l : List ι) :\n    ∑ a, l.countP (c a) ≤ l.length := by\n  induction l with\n  | nil => simp\n  | cons q l ih =>\n    have hone : ∑ a, (if c a q = true then 1 else 0) ≤ 1 := by\n      rw [← card_filter]\n      exact card_le_one.mpr fun a ha b hb => hc a b q (by simpa using ha) (by simpa using hb)\n    simp only [List.countP_cons, sum_add_distrib, List.length_cons]\n    omega\n\nend QuarticQuery\n"}