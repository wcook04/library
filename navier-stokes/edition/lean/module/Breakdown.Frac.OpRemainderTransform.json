d":false,"short":"transform_translate","signature_end_line":46,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.Freq.CSpace","Breakdown.Space"],"used_by":["Breakdown.remainderTransform"],"uses":["Breakdown.Freq.CSpace","Breakdown.Space"],"written":"transform_translate"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":54,"kind":"theorem","line":50,"module":"Breakdown.Frac.OpRemainderTransform","name":"Breakdown.FracInternal.RemainderTransform.transform_deriv_apply","namespace":"Breakdown.FracInternal.RemainderTransform","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.FracInternal.RemainderTransform.transform_lincomb"],"proof_uses":[],"protected":false,"short":"transform_deriv_apply","signature_end_line":51,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.Freq.CSpace","Breakdown.Space"],"used_by":["Breakdown.FracInternal.RemainderTransform.transform_lincomb"],"uses":["Breakdown.Freq.CSpace","Breakdown.Space"],"written":"transform_deriv_apply"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":61,"kind":"theorem","line":56,"module":"Breakdown.Frac.OpRemainderTransform","name":"Breakdown.FracInternal.RemainderTransform.transform_lincomb","namespace":"Breakdown.FracInternal.RemainderTransform","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.remainderTransform"],"proof_uses":["Breakdown.FracInternal.RemainderTransform.transform_deriv_apply"],"protected":false,"short":"transform_lincomb","signature_end_line":59,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.Freq.CSpace","Breakdown.Space"],"used_by":["Breakdown.remainderTransform"],"uses":["Breakdown.FracInternal.RemainderTransform.transform_deriv_apply","Breakdown.Freq.CSpace","Breakdown.Space"],"written":"transform_lincomb"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":83,"kind":"theorem","line":63,"module":"Breakdown.Frac.OpRemainderTransform","name":"Breakdown.FracInternal.RemainderTransform.scalar_identity","namespace":"Breakdown.FracInternal.RemainderTransform","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.remainderTransform"],"proof_uses":[],"protected":false,"short":"scalar_identity","signature_end_line":66,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.Freq.CSpace","Breakdown.Space","Breakdown.phaseRemainder"],"used_by":["Breakdown.remainderTransform"],"uses":["Breakdown.Freq.CSpace","Breakdown.Space","Breakdown.phaseRemainder"],"written":"scalar_identity"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":103,"kind":"theorem","line":88,"module":"Breakdown.Frac.OpRemainderTransform","name":"Breakdown.remainderTransform","namespace":"Breakdown","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.symbolExchange"],"proof_uses":["Breakdown.FracInternal.RemainderTransform.lift","Breakdown.FracInternal.RemainderTransform.pointwise","Breakdown.FracInternal.RemainderTransform.scalar_identity","Breakdown.FracInternal.RemainderTransform.transform_lincomb","Breakdown.FracInternal.RemainderTransform.transform_translate","Breakdown.Freq.CSpace","Breakdown.Freq.complexifyVec","Breakdown.Space","Breakdown.secondOrderRemainder"],"protected":false,"short":"remainderTransform","signature_end_line":88,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.RemainderTransformStatement"],"used_by":["Breakdown.symbolExchange"],"uses":["Breakdown.FracInternal.RemainderTransform.lift","Breakdown.FracInternal.RemainderTransform.pointwise","Breakdown.FracInternal.RemainderTransform.scalar_identity","Breakdown.FracInternal.RemainderTransform.transform_lincomb","Breakdown.FracInternal.RemainderTransform.transform_translate","Breakdown.Freq.CSpace","Breakdown.Freq.complexifyVec","Breakdown.RemainderTransformStatement","Breakdown.Space","Breakdown.secondOrderRemainder"],"written":"remainderTransform"}],"imports":["Breakdown.Frac.StSymbol"],"module":"Breakdown.Frac.OpRemainderTransform","path":"Breakdown/Frac/OpRemainderTransform.lean","sha256":"45002961e4a2574ecc8493377157c0d0e9500967af1f57191df7a9cba9e9d35e","source":"import Breakdown.Frac.StSymbol\n\nopen MeasureTheory Real LineDeriv FourierTransform SchwartzMap\nopen scoped RealInnerProductSpace\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace FracInternal.RemainderTransform\n\ndef lift (φ : 𝓢(Space, Space)) : 𝓢(Space, Freq.CSpace) :=\n  SchwartzMap.postcompCLM (𝕜 := ℝ) Freq.complexifyVec φ\n\ntheorem lift_apply (φ : 𝓢(Space, Space)) (x : Space) :\n    lift φ x = Freq.complexifyVec (φ x) := rfl\n\ntheorem coe_lift (φ : 𝓢(Space, Space)) : (⇑(lift φ)) = Freq.complexifyVec ∘ ⇑φ := rfl\n\ntheorem fderiv_lift (φ : 𝓢(Space, Space)) (x z : Space) :\n    fderiv ℝ (lift φ) x z = Freq.complexifyVec (fderiv ℝ φ x z) := by\n  rw [coe_lift, ((Freq.complexifyVec.hasFDerivAt).comp x (φ.differentiableAt.hasFDerivAt)).fderiv]\n  rfl\n\ntheorem iteratedFDeriv_lift (φ : 𝓢(Space, Space)) (x z : Space) :\n    iteratedFDeriv ℝ 2 (lift φ) x ![z, z] =\n      Freq.complexifyVec (iteratedFDeriv ℝ 2 φ x ![z, z]) := by\n  rw [coe_lift, Freq.complexifyVec.iteratedFDeriv_comp_left (f := ⇑φ) (φ.smooth ⊤).contDiffAt\n    (WithTop.coe_le_coe.2 le_top)]\n  rfl\n\ntheorem second_eq (S : 𝓢(Space, Freq.CSpace)) (x z : Space) :\n    (∂_{z} (∂_{z} S)) x = iteratedFDeriv ℝ 2 S x ![z, z] := by\n  rw [← iteratedLineDerivOp_eq_iteratedFDeriv]\n  simp [iteratedLineDerivOp_succ_left]\n\ntheorem pointwise (φ : 𝓢(Space, Space)) (x z : Space) :\n    Freq.complexifyVec (secondOrderRemainder φ x z) =\n      lift φ (x + z) - (lift φ + ∂_{z} (lift φ) + (1 / 2 : ℝ) • ∂_{z} (∂_{z} (lift φ))) x := by\n  rw [_root_.add_apply, _root_.add_apply, _root_.smul_apply, second_eq,\n    iteratedFDeriv_lift, lineDerivOp_apply_eq_fderiv, fderiv_lift, lift_apply, lift_apply]\n  simp only [secondOrderRemainder, map_sub, map_smul]\n  abel\n\ntheorem transform_translate (S : 𝓢(Space, Freq.CSpace)) (z ξ : Space) :\n    𝓕 (fun x => S (x + z)) ξ = 𝐞 (⟪z, ξ⟫) • 𝓕 (⇑S) ξ := by\n  have h := congrFun (VectorFourier.fourierIntegral_comp_add_right 𝐞 volume (innerₗ Space) (⇑S) z) ξ\n  exact h\n\ntheorem transform_deriv_apply (S : 𝓢(Space, Freq.CSpace)) (z ξ : Space) :\n    𝓕 (⇑(∂_{z} S : 𝓢(Space, Freq.CSpace))) ξ = (2 * π * Complex.I) • (⟪ξ, z⟫ • 𝓕 (⇑S) ξ) := by\n  have : (inner ℝ · z).HasTemperateGrowth := ((innerSL ℝ).flip z).hasTemperateGrowth\n  rw [← fourier_coe, fourier_lineDerivOp_eq, _root_.smul_apply, smulLeftCLM_apply_apply this,\n    fourier_coe]\n\ntheorem transform_lincomb (S : 𝓢(Space, Freq.CSpace)) (z ξ : Space) :\n    𝓕 (⇑(S + ∂_{z} S + (1 / 2 : ℝ) • ∂_{z} (∂_{z} S))) ξ =\n      𝓕 (⇑S) ξ + (2 * π * Complex.I) • (⟪ξ, z⟫ • 𝓕 (⇑S) ξ) +\n        (1 / 2 : ℝ) • ((2 * π * Complex.I) • (⟪ξ, z⟫ • ((2 * π * Complex.I) • (⟪ξ, z⟫ • 𝓕 (⇑S) ξ)))) := by\n  rw [← fourier_coe, FourierAdd.fourier_add, FourierAdd.fourier_add, FourierSMul.fourier_smul]\n  simp only [_root_.add_apply, _root_.smul_apply, fourier_coe, transform_deriv_apply]\n\ntheorem scalar_identity (ξ z : Space) (v : Freq.CSpace) :\n    𝐞 (⟪z, ξ⟫) • v - (v + (2 * π * Complex.I) • (⟪ξ, z⟫ • v) +\n      (1 / 2 : ℝ) • ((2 * π * Complex.I) • (⟪ξ, z⟫ • ((2 * π * Complex.I) • (⟪ξ, z⟫ • v))))) =\n    phaseRemainder ξ z • v := by\n  have hc : 𝐞 (⟪z, ξ⟫) • v - (v + (2 * π * Complex.I) • (⟪ξ, z⟫ • v) +\n      (1 / 2 : ℝ) • ((2 * π * Complex.I) • (⟪ξ, z⟫ • ((2 * π * Complex.I) • (⟪ξ, z⟫ • v))))) =\n      ((𝐞 (⟪z, ξ⟫) : ℂ) - 1 - (2 * π * Complex.I) * (⟪ξ, z⟫ : ℂ) -\n        (1 / 2 : ℂ) * ((2 * π * Complex.I) * (⟪ξ, z⟫ : ℂ)) ^ 2) • v := by\n    rw [Circle.smul_def]\n    simp only [← Complex.coe_smul, smul_smul]\n    push_cast\n    module\n  rw [hc]\n  congr 1\n  rw [Real.fourierChar_apply]\n  unfold phaseRemainder\n  rw [real_inner_comm ξ z]\n  push_cast\n  ring_nf\n  rw [Complex.I_sq]\n  ring\n\nend FracInternal.RemainderTransform\n\nopen FracInternal.RemainderTransform in\ntheorem remainderTransform : RemainderTransformStatement := by\n  intro φ z ξ\n  have hf : (fun x => Freq.complexifyVec (secondOrderRemainder φ x z)) =\n      fun x => lift φ (x + z) -\n        (lift φ + ∂_{z} (lift φ) + (1 / 2 : ℝ) • ∂_{z} (∂_{z} (lift φ))) x :=\n    funext fun x => pointwise φ x z\n  have h1 : Integrable (fun x => lift φ (x + z)) := (lift φ).integrable.comp_add_right z\n  have h2 : Integrable\n      ⇑(lift φ + ∂_{z} (lift φ) + (1 / 2 : ℝ) • ∂_{z} (∂_{z} (lift φ)) : 𝓢(Space, Freq.CSpace)) :=\n    SchwartzMap.integrable _\n  have hS : (fun x => Freq.complexifyVec (φ x)) = ⇑(lift φ) := rfl\n  rw [hf, hS, Real.fourier_eq]\n  simp_rw [smul_sub]\n  rw [integral_sub ((Real.fourierIntegral_convergent_iff ξ).2 h1)\n    ((Real.fourierIntegral_convergent_iff ξ).2 h2), ← Real.fourier_eq, ← Real.fourier_eq,\n    transform_translate, transform_lincomb, scalar_identity]\n\nend Breakdown\n"}