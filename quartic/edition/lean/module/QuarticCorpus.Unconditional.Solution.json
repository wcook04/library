nconditional.Solution","name":"QuarticQuery.Checked.cubic_bound_fails","namespace":"QuarticQuery.Checked","noncomputable":false,"private":false,"protected":false,"short":"cubic_bound_fails","signature_end_line":34,"used_by":[],"uses":["QuarticQuery.Q","QuarticQuery.R","QuarticQuery.TotalBool","QuarticQuery.cubic_bound_fails_unconditional","QuarticQuery.totalise"],"uses_modules":{"QuarticQuery.Q":"QuarticQuery.Statement","QuarticQuery.R":"QuarticQuery.Statement","QuarticQuery.TotalBool":"QuarticQuery.Statement","QuarticQuery.totalise":"QuarticQuery.Statement"},"written":"cubic_bound_fails"},{"dependency_source":"source_text","doc":null,"end_line":40,"kind":"theorem","line":38,"module":"QuarticCorpus.Unconditional.Solution","name":"QuarticQuery.Checked.forrelation_lower_bound","namespace":"QuarticQuery.Checked","noncomputable":false,"private":false,"protected":false,"short":"forrelation_lower_bound","signature_end_line":38,"used_by":[],"uses":["QuarticQuery.ForrelationLower.bansalSinhaLower"],"written":"forrelation_lower_bound"}],"imports":["QuarticQuery.Statement","QuarticQuery.Results.Unconditional"],"module":"QuarticCorpus.Unconditional.Solution","path":"QuarticCorpus/Unconditional/Solution.lean","sha256":"19725ad42b615a8881db00417ee6375c8982b0de08e618f06f901fe4db2e2cd3","source":"module\n\npublic import QuarticQuery.Statement\nimport QuarticQuery.Results.Unconditional\n\n/-!\n# Unconditional bundle\n\nTheorem 1.1 of the preprint with no hypothesis, and the Forrelation lower bound in\nthe form it uses. The statements use only the public vocabulary.\n-/\n\npublic section\n\nnamespace QuarticQuery.Checked\n\n-- CHALLENGE-BEGIN\ntheorem alpha_tot_eq_four : alphaTot = 4 := by\n  -- proof\n  exact QuarticQuery.alphaTot_eq_four_unconditional\n\ntheorem theorem_one_one :\n    alphaTot = 4 ∧ UniversalPower 4 ∧\n      ∀ k : ℕ, 2 ≤ k → ∃ (S A : ℕ) (b : ℕ) (t₀ : ℕ), 0 < A ∧ ∀ t, max 1 t₀ ≤ t →\n        ∃ C : Circuit (ForrelationCoord k t), CircuitRealises C (P k t) ∧\n          C.size ≤ S * mValue t * (2 * t) ^ 2 ∧\n          (Q (totalise (Fkm k t C)) : ℝ) ≤ (A : ℝ) * 2 ^ t * (2 * (t : ℝ)) ^ b ∧\n          Gvalue (mValue t) (Lvalue k t) < R (totalise (Fkm k t C)) := by\n  -- proof\n  exact QuarticQuery.theorem_1_1_unconditional\n\ntheorem cubic_bound_fails :\n    ¬ ∃ C : ℝ, ∀ n : ℕ, 1 ≤ n → ∀ f : TotalBool (Fin n),\n      (R (totalise f) : ℝ) ≤ C * (Q (totalise f) : ℝ) ^ 3 := by\n  -- proof\n  exact QuarticQuery.cubic_bound_fails_unconditional\n\ntheorem forrelation_lower_bound : BansalSinhaLower := by\n  -- proof\n  exact QuarticQuery.ForrelationLower.bansalSinhaLower\n-- CHALLENGE-END\n\nend QuarticQuery.Checked\n"}