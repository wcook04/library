File.Mode","BSmtLibSpec.Grammar.File.Mode.unparsed","BSmtLibSpec.Grammar.Script","BSmtLibSpec.Grammar.Tree.Command","BSmtLibSpec.Grammar.Tree.Command.Valid","BSmtLibSpec.Grammar.Tree.Command.modeAfter","BSmtLibSpec.Lexicon.Version"],"used_by":["BSmtLibSpec.Grammar.Script"],"uses":["BSmtLibSpec.Grammar.File.Mode","BSmtLibSpec.Grammar.File.Mode.unparsed","BSmtLibSpec.Grammar.Script","BSmtLibSpec.Grammar.Tree.Command","BSmtLibSpec.Grammar.Tree.Command.Valid","BSmtLibSpec.Grammar.Tree.Command.modeAfter","BSmtLibSpec.Lexicon.Version"],"written":"stop"}],"imports":["BSmtLibSpec.Grammar.File"],"module":"BSmtLibSpec.Grammar.Script","path":"BSmtLibSpec/Grammar/Script.lean","sha256":"635e3a5f710627ee280989b9a4da46165ea5ac415277755b1e0b28e270bd86a9","source":"module\n\npublic import BSmtLibSpec.Grammar.File\n\n@[expose] public section\n\n/-!\n# Scripts\n\n`Script` states the same as `File` on the level of tokens: which sequences of commands, each in\nits version, make a script.\n-/\n\nnamespace BSmtLibSpec.Grammar\n\nopen BSmtLibSpec.Lexicon\n\n/--\n`Script version commands`: with the initial version `version`, the commands make a script: each is\nvalid in the version in force where it starts, and only the last one may stop the reading.\n\nThe commands of a file make a script (`File`); a script is what a parser of tokens is given.\n\nStandard: 2.7 §3.11 Scripts. Readings M1, M2 and M3, as `Tree.Command.modeAfter`.\n-/\ninductive Script : Version → List Tree.Command → Prop\n  /-- No more commands. -/\n  | done : Script version []\n\n  /-- A command after which the script goes on in a version. -/\n  | command : command.Valid version → command.modeAfter version = some (.read next) →\n      Script next commands → Script version (command :: commands)\n\n  /-- A command after which nothing is read. -/\n  | stop : command.Valid version → command.modeAfter version = some .unparsed →\n      Script version [command]\n\nend BSmtLibSpec.Grammar\n"}