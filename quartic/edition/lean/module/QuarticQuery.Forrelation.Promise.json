","QuarticQuery.Forrelation.P_eq_none_iff","QuarticQuery.Forrelation.promise_nonempty_two_one","QuarticQuery.Forrelation.promised_P_iff","QuarticQuery.Forrelation.successProb_of_false","QuarticQuery.Paper.construction_equation_4"],"proof_uses":["QuarticQuery.Forrelation.abs_Phi_le_iff","QuarticQuery.Forrelation.cases_disjoint","QuarticQuery.Forrelation.delta_le_Phi_iff","QuarticQuery.forrelationDenominator","QuarticQuery.forrelationNumerator"],"protected":false,"short":"P_eq_some_false_iff","signature_end_line":71,"statement_used_by":[],"statement_uses":["QuarticQuery.BitInput","QuarticQuery.Forrelation.delta","QuarticQuery.ForrelationCoord","QuarticQuery.P","QuarticQuery.Phi"],"used_by":["QuarticQuery.Forrelation.P_eq_cases","QuarticQuery.Forrelation.P_eq_none_iff","QuarticQuery.Forrelation.promise_nonempty_two_one","QuarticQuery.Forrelation.promised_P_iff","QuarticQuery.Forrelation.successProb_of_false","QuarticQuery.Paper.construction_equation_4"],"uses":["QuarticQuery.BitInput","QuarticQuery.Forrelation.abs_Phi_le_iff","QuarticQuery.Forrelation.cases_disjoint","QuarticQuery.Forrelation.delta","QuarticQuery.Forrelation.delta_le_Phi_iff","QuarticQuery.ForrelationCoord","QuarticQuery.P","QuarticQuery.Phi","QuarticQuery.forrelationDenominator","QuarticQuery.forrelationNumerator"],"uses_modules":{"QuarticQuery.BitInput":"QuarticQuery.Statement","QuarticQuery.ForrelationCoord":"QuarticQuery.Statement","QuarticQuery.P":"QuarticQuery.Statement","QuarticQuery.Phi":"QuarticQuery.Statement"},"written":"P_eq_some_false_iff"},{"dependency_source":"lean_report","doc":"Ledger: eq-4, def-P. Everything else is outside the promise, including large\nnegative `Φ`.","end_line":92,"kind":"theorem","line":87,"module":"QuarticQuery.Forrelation.Promise","name":"QuarticQuery.Forrelation.P_eq_none_iff","namespace":"QuarticQuery.Forrelation","noncomputable":false,"private":false,"proof_used_by":["QuarticQuery.Forrelation.P_eq_cases","QuarticQuery.Forrelation.promise_nonempty_two_one","QuarticQuery.Paper.construction_equation_4"],"proof_uses":["QuarticQuery.Forrelation.P_eq_some_false_iff","QuarticQuery.Forrelation.P_eq_some_true_iff"],"protected":false,"short":"P_eq_none_iff","signature_end_line":88,"statement_used_by":[],"statement_uses":["QuarticQuery.BitInput","QuarticQuery.Forrelation.delta","QuarticQuery.ForrelationCoord","QuarticQuery.P","QuarticQuery.Phi"],"used_by":["QuarticQuery.Forrelation.P_eq_cases","QuarticQuery.Forrelation.promise_nonempty_two_one","QuarticQuery.Paper.construction_equation_4"],"uses":["QuarticQuery.BitInput","QuarticQuery.Forrelation.P_eq_some_false_iff","QuarticQuery.Forrelation.P_eq_some_true_iff","QuarticQuery.Forrelation.delta","QuarticQuery.ForrelationCoord","QuarticQuery.P","QuarticQuery.Phi"],"uses_modules":{"QuarticQuery.BitInput":"QuarticQuery.Statement","QuarticQuery.ForrelationCoord":"QuarticQuery.Statement","QuarticQuery.P":"QuarticQuery.Statement","QuarticQuery.Phi":"QuarticQuery.Statement"},"written":"P_eq_none_iff"},{"dependency_source":"lean_report","doc":"Ledger: eq-4. `P` as a single statement: the value of `P` at every input.","end_line":104,"kind":"theorem","line":95,"module":"QuarticQuery.Forrelation.Promise","name":"QuarticQuery.Forrelation.P_eq_cases","namespace":"QuarticQuery.Forrelation","noncomputable":false,"private":false,"proof_used_by":[],"proof_uses":["QuarticQuery.Forrelation.P_eq_none_iff","QuarticQuery.Forrelation.P_eq_some_false_iff","QuarticQuery.Forrelation.P_eq_some_true_iff"],"protected":false,"short":"P_eq_cases","signature_end_line":100,"statement_used_by":[],"statement_uses":["QuarticQuery.BitInput","QuarticQuery.Forrelation.delta","QuarticQuery.ForrelationCoord","QuarticQuery.P","QuarticQuery.Phi"],"used_by":[],"uses":["QuarticQuery.BitInput","QuarticQuery.Forrelation.P_eq_none_iff","QuarticQuery.Forrelation.P_eq_some_false_iff","QuarticQuery.Forrelation.P_eq_some_true_iff","QuarticQuery.Forrelation.delta","QuarticQuery.ForrelationCoord","QuarticQuery.P","QuarticQuery.Phi"],"uses_modules":{"QuarticQuery.BitInput":"QuarticQuery.Statement","QuarticQuery.ForrelationCoord":"QuarticQuery.Statement","QuarticQuery.P":"QuarticQuery.Statement","QuarticQuery.Phi":"QuarticQuery.Statement"},"written":"P_eq_cases"},{"dependency_source":"lean_report","doc":null,"end_line":115,"kind":"theorem","line":106,"module":"QuarticQuery.Forrelation.Promise","name":"QuarticQuery.Forrelation.promised_P_iff","namespace":"QuarticQuery.Forrelation","noncomputable":false,"private":false,"proof_used_by":["QuarticQuery.Paper.construction_integer_tests"],"proof_uses":["QuarticQuery.Forrelation.P_eq_some_false_iff","QuarticQuery.Forrelation.P_eq_some_true_iff"],"protected":false,"short":"promised_P_iff","signature_end_line":107,"statement_used_by":[],"statement_uses":["QuarticQuery.BitInput","QuarticQuery.Forrelation.delta","QuarticQuery.ForrelationCoord","QuarticQuery.P","QuarticQuery.Phi","QuarticQuery.promised"],"used_by":["QuarticQuery.Paper.construction_integer_tests"],"uses":["QuarticQuery.BitInput","QuarticQuery.Forrelation.P_eq_some_false_iff","QuarticQuery.Forrelation.P_eq_some_true_iff","QuarticQuery.Forrelation.delta","QuarticQuery.ForrelationCoord","QuarticQuery.P","QuarticQuery.Phi","QuarticQuery.promised"],"uses_modules":{"QuarticQuery.BitInput":"QuarticQuery.Statement","QuarticQuery.ForrelationCoord":"QuarticQuery.Statement","QuarticQuery.P":"QuarticQuery.Statement","QuarticQuery.Phi":"QuarticQuery.Statement","QuarticQuery.promised":"QuarticQuery.Statement"},"written":"promised_P_iff"}],"imports":["QuarticQuery.Forrelation.Product"],"module":"QuarticQuery.Forrelation.Promise","path":"QuarticQuery/Forrelation/Promise.lean","sha256":"96b967a27458107549e38ce4fe001d707a4c240ad4e4b582729a6ce9526d2cf1","source":"module\n\npublic import QuarticQuery.Forrelation.Product\n\n/-!\n# `P` is the partial function of equation (4)\n\n`P` is defined in `Statement` by integer tests. Here the tests are shown to be the\nreal thresholds `Φ ≥ δ` and `|Φ| ≤ δ/2`, so `P` is exactly the partial function of\n(4), and the smallest interesting instance is checked to have inputs on each side.\n-/\n\n@[expose] public section\n\nnamespace QuarticQuery.Forrelation\n\n/-- Ledger: eq-3. `δ = 2^(-5k)`. -/\nnoncomputable def delta (k : ℕ) : ℝ := (2 : ℝ) ^ (-(5 * (k : ℤ)))\n\ntheorem delta_eq (k : ℕ) : delta k = ((2 : ℝ) ^ (5 * k))⁻¹ := by\n  rw [delta, zpow_neg]\n  norm_cast\n\ntheorem delta_pos (k : ℕ) : 0 < delta k := by\n  rw [delta_eq]\n  positivity\n\ntheorem forrelationDenominator_pos (k t : ℕ) : 0 < forrelationDenominator k t := by\n  unfold forrelationDenominator\n  positivity\n\n/-- Ledger: claim-integer-tests. The first test of (4). -/\ntheorem delta_le_Phi_iff (k t : ℕ) (z : BitInput (ForrelationCoord k t)) :\n    delta k ≤ Phi k t z ↔\n      (2 : ℤ) ^ (5 * k) * forrelationNumerator k t z ≥ forrelationDenominator k t := by\n  have hM : (0 : ℝ) < forrelationDenominator k t := by\n    exact_mod_cast forrelationDenominator_pos k t\n  have hA : (0 : ℝ) < (2 : ℝ) ^ (5 * k) := by positivity\n  rw [Phi, delta_eq, inv_eq_one_div, div_le_div_iff₀ hA hM, one_mul, ge_iff_le, mul_comm]\n  exact_mod_cast Iff.rfl\n\n/-- Ledger: claim-integer-tests. The second test of (4). -/\ntheorem abs_Phi_le_iff (k t : ℕ) (z : BitInput (ForrelationCoord k t)) :\n    |Phi k t z| ≤ delta k / 2 ↔\n      (2 : ℤ) ^ (5 * k + 1) * |forrelationNumerator k t z| ≤ forrelationDenominator k t := by\n  have hM : (0 : ℝ) < forrelationDenominator k t := by\n    exact_mod_cast forrelationDenominator_pos k t\n  have hA : (0 : ℝ) < (2 : ℝ) ^ (5 * k + 1) := by positivity\n  have hδ : delta k / 2 = 1 / (2 : ℝ) ^ (5 * k + 1) := by\n    rw [delta_eq, pow_succ, inv_eq_one_div, div_div]\n  rw [Phi, abs_div, abs_of_pos hM, hδ, div_le_div_iff₀ hM hA, one_mul, mul_comm]\n  exact_mod_cast Iff.rfl\n\n/-- Ledger: eq-4. The two cases cannot both hold, for any `k`. -/\ntheorem cases_disjoint (k t : ℕ) (z : BitInput (ForrelationCoord k t)) :\n    ¬ (delta k ≤ Phi k t z ∧ |Phi k t z| ≤ delta k / 2) := by\n  rintro ⟨h1, h2⟩\n  have := delta_pos k\n  have := le_abs_self (Phi k t z)\n  linarith\n\n/-- Ledger: eq-4, def-P. The 1-inputs. -/\ntheorem P_eq_some_true_iff (k t : ℕ) (z : BitInput (ForrelationCoord k t)) :\n    P k t z = some true ↔ delta k ≤ Phi k t z := by\n  rw [delta_le_Phi_iff]\n  simp only [P]\n  split_ifs <;> simp_all\n\n/-- Ledger: eq-4, def-P. The 0-inputs. -/\ntheorem P_eq_some_false_iff (k t : ℕ) (z : BitInput (ForrelationCoord k t)) :\n    P k t z = some false ↔ |Phi k t z| ≤ delta k / 2 := by\n  have hd := cases_disjoint k t z\n  constructor\n  · intro h\n    rw [abs_Phi_le_iff]\n    simp only [P] at h\n    split_ifs at h <;> first | assumption | simp at h\n  · intro h\n    have h1 : ¬ delta k ≤ Phi k t z := fun e => hd ⟨e, h⟩\n    rw [delta_le_Phi_iff] at h1\n    rw [abs_Phi_le_iff] at h\n    simp only [P]\n    split_ifs <;> first | rfl | contradiction\n\n/-- Ledger: eq-4, def-P. Everything else is outside the promise, including large\nnegative `Φ`. -/\ntheorem P_eq_none_iff (k t : ℕ) (z : BitInput (ForrelationCoord k t)) :\n    P k t z = none ↔ ¬ delta k ≤ Phi k t z ∧ ¬ |Phi k t z| ≤ delta k / 2 := by\n  rw [← P_eq_some_true_iff, ← P_eq_some_false_iff]\n  cases P k t z with\n  | none => simp\n  | some b => cases b <;> simp\n\n/-- Ledger: eq-4. `P` as a single statement: the value of `P` at every input. -/\ntheorem P_eq_cases (k t : ℕ) (z : BitInput (ForrelationCoord k t)) :\n    P k t z =\n      open Classical in\n      if delta k ≤ Phi k t z then some true\n      else if |Phi k t z| ≤ delta k / 2 then some false\n      else none := by\n  split_ifs with h1 h2\n  · exact (P_eq_some_true_iff k t z).2 h1\n  · exact (P_eq_some_false_iff k t z).2 h2\n  · exact (P_eq_none_iff k t z).2 ⟨h1, h2⟩\n\ntheorem promised_P_iff (k t : ℕ) (z : BitInput (ForrelationCoord k t)) :\n    promised (P k t) z ↔ delta k ≤ Phi k t z ∨ |Phi k t z| ≤ delta k / 2 := by\n  rw [promised, ← P_eq_some_true_iff, ← P_eq_some_false_iff]\n  constructor\n  · rintro ⟨b, hb⟩\n    cases b\n    · exact Or.inr hb\n    · exact Or.inl hb\n  · rintro (h | h)\n    exacts [⟨_, h⟩, ⟨_, h⟩]\n\nend QuarticQuery.Forrelation\n"}