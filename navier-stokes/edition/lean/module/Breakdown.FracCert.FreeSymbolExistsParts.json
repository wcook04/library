nd":"def","line":42,"module":"Breakdown.FracCert.FreeSymbolExistsParts","name":"Breakdown.SteadyCert.FreeSolutionClassStatement","namespace":"Breakdown.SteadyCert","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"FreeSolutionClassStatement","signature_end_line":42,"sorry":false,"statement_used_by":["Breakdown.SteadyCert.freeSolutionClass","Breakdown.SteadyCert.freeSymbolExists_of"],"statement_uses":["Breakdown.Freq.CSpace","Breakdown.Freq.IsNiceSymbol","Breakdown.Freq.niceField","Breakdown.Space","Breakdown.SteadyCert.IsClassField","Breakdown.SteadyCert.freeSolution"],"used_by":["Breakdown.SteadyCert.freeSolutionClass","Breakdown.SteadyCert.freeSymbolExists_of"],"uses":["Breakdown.Freq.CSpace","Breakdown.Freq.IsNiceSymbol","Breakdown.Freq.niceField","Breakdown.Space","Breakdown.SteadyCert.IsClassField","Breakdown.SteadyCert.freeSolution"],"written":"FreeSolutionClassStatement"}],"imports":["Breakdown.FracCert.StFreeNiceParts","Breakdown.Frac.StProfile"],"module":"Breakdown.FracCert.FreeSymbolExistsParts","path":"Breakdown/FracCert/FreeSymbolExistsParts.lean","sha256":"bcb02627d00dca15dcb06678e9120847ffa324adfccb13f61a620b4e3cdedf3b","source":"import Breakdown.FracCert.StFreeNiceParts\nimport Breakdown.Frac.StProfile\n\nopen scoped ContDiff ENNReal\nopen MeasureTheory Real\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace SteadyCert\n\ndef axialRotationC (θ : ℝ) (z : Freq.CSpace) : Freq.CSpace :=\n  EuclideanSpace.single 0 ((Real.cos θ : ℂ) * z 0 - (Real.sin θ : ℂ) * z 1) +\n    EuclideanSpace.single 1 ((Real.sin θ : ℂ) * z 0 + (Real.cos θ : ℂ) * z 1) + EuclideanSpace.single 2 (z 2)\n\ndef freeWeight (α : ℝ) (τ : ℝ) (ξ : Space) : ℝ :=\n  Real.exp (-((1 - 2 / α) * τ)) * Real.exp (-((Real.exp τ - 1) * freqPow (2 * α) ξ))\n\ndef freeSolution (α a : ℝ) (s : Space → Freq.CSpace) (ξ : Space) : Freq.CSpace :=\n  ∫ τ in Set.Ioi (0 : ℝ), freeWeight α τ ξ •\n    axialRotationC (a * τ) (s (Real.exp (τ / (2 * α)) • axialRotationFormula (-(a * τ)) ξ))\n\ndef FreeSolutionSmoothStatement : Prop :=\n  ∀ α : ℝ, 1 < α → α < 5 / 4 → ∀ (a : ℝ) (s : Space → Freq.CSpace), Freq.IsNiceSymbol s →\n    ContDiffOn ℝ ∞ (freeSolution α a s) {ξ | ξ ≠ 0}\n\ndef FreeSolutionBoundStatement : Prop :=\n  ∀ α : ℝ, 1 < α → α < 5 / 4 → ∀ (a : ℝ) (s : Space → Freq.CSpace), Freq.IsNiceSymbol s →\n    ∀ j : ℕ, ∃ C : ℝ, ∀ ξ : Space, ξ ≠ 0 →\n      ‖iteratedFDeriv ℝ j (freeSolution α a s) ξ‖ ≤ C * ‖ξ‖ ^ (2 * α - 4 - (j : ℝ))\n\ndef FreeSolutionSmallBoundStatement : Prop :=\n  ∀ α : ℝ, 1 < α → α < 5 / 4 → ∀ (a : ℝ) (s : Space → Freq.CSpace), Freq.IsNiceSymbol s →\n    ∀ j : ℕ, ∃ ρ : ℝ, 0 < ρ ∧ ∃ C : ℝ, ∀ ξ : Space, ξ ≠ 0 → ‖ξ‖ < ρ →\n      ‖iteratedFDeriv ℝ j (freeSolution α a s) ξ‖ ≤ C * ‖ξ‖ ^ (2 * α - 4 - (j : ℝ))\n\ndef FreeSolutionEquationStatement : Prop :=\n  ∀ α : ℝ, 1 < α → α < 5 / 4 → ∀ (a : ℝ) (s : Space → Freq.CSpace), Freq.IsNiceSymbol s →\n    ∀ ξ : Space, ξ ≠ 0 → profileSymbolLhs α a (freeSolution α a s) ξ = s ξ\n\ndef FreeSolutionClassStatement : Prop :=\n  ∀ α : ℝ, 1 < α → α < 5 / 4 → ∀ (a : ℝ) (m : ℕ) (s : Space → Freq.CSpace), Freq.IsNiceSymbol s →\n    IsClassField m (Freq.niceField s) → IsClassField m (Freq.niceField (freeSolution α a s))\n\nend SteadyCert\n\nend Breakdown\n"}