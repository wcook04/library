e","Breakdown.CellCert.CellFormula.CellLayout","Breakdown.CellCert.CellFormula.CellLayout.Datum","Breakdown.CellCert.CellFormula.CellLayout.IsPlaneDeleted","Breakdown.CellCert.CellFormula.CellLayout.pressureShift","Breakdown.CellCert.CellFormula.GaugeShift"],"used_by":["Breakdown.CellCert.CellFormula.shiftedRealReduction_of"],"uses":["Breakdown.CellCert.Assembly.FieldTuple","Breakdown.CellCert.CellFormula.CellLayout","Breakdown.CellCert.CellFormula.CellLayout.Datum","Breakdown.CellCert.CellFormula.CellLayout.IsPlaneDeleted","Breakdown.CellCert.CellFormula.CellLayout.pressureShift","Breakdown.CellCert.CellFormula.GaugeShift"],"written":"shift_of_plane"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":114,"kind":"theorem","line":67,"module":"Breakdown.FracCell.ShiftedRealReduction","name":"Breakdown.CellCert.CellFormula.shiftedRealReduction_of","namespace":"Breakdown.CellCert.CellFormula","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CellCert.CellFormula.shiftedRealReduction_of_leaves","Breakdown.CellCert.CellFormula.shiftedRealReduction_of_plane"],"proof_uses":["Breakdown.CellCert.CellFormula.CellLayout.IsGaugeDeleted","Breakdown.CellCert.CellFormula.CellLayout.IsPlaneDeleted","Breakdown.CellCert.CellFormula.CellLayout.conjDatum","Breakdown.CellCert.CellFormula.CellLayout.expandSystem","Breakdown.CellCert.CellFormula.CellLayout.modeOf","Breakdown.CellCert.CellFormula.CellLayout.partSign","Breakdown.CellCert.CellFormula.CellLayout.realPart","Breakdown.CellCert.CellFormula.CellLayout.shiftedData","Breakdown.CellCert.CellFormula.ShiftedRealReduction.Internal.conj_of_modeOf_zero","Breakdown.CellCert.CellFormula.ShiftedRealReduction.Internal.modeOf_conj","Breakdown.CellCert.CellFormula.ShiftedRealReduction.Internal.modeOf_of_gauge","Breakdown.CellCert.CellFormula.ShiftedRealReduction.Internal.plane_conj","Breakdown.CellCert.CellFormula.ShiftedRealReduction.Internal.shift_im","Breakdown.CellCert.CellFormula.ShiftedRealReduction.Internal.shift_of_modeOf_ne","Breakdown.CellCert.CellFormula.ShiftedRealReduction.Internal.shift_of_plane"],"protected":false,"short":"shiftedRealReduction_of","signature_end_line":68,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CellCert.CellFormula.ConjugateDataStatement","Breakdown.CellCert.CellFormula.PlaneDeletedStatement","Breakdown.CellCert.CellFormula.ShiftedRealReductionStatement"],"used_by":["Breakdown.CellCert.CellFormula.shiftedRealReduction_of_leaves","Breakdown.CellCert.CellFormula.shiftedRealReduction_of_plane"],"uses":["Breakdown.CellCert.CellFormula.CellLayout.IsGaugeDeleted","Breakdown.CellCert.CellFormula.CellLayout.IsPlaneDeleted","Breakdown.CellCert.CellFormula.CellLayout.conjDatum","Breakdown.CellCert.CellFormula.CellLayout.expandSystem","Breakdown.CellCert.CellFormula.CellLayout.modeOf","Breakdown.CellCert.CellFormula.CellLayout.partSign","Breakdown.CellCert.CellFormula.CellLayout.realPart","Breakdown.CellCert.CellFormula.CellLayout.shiftedData","Breakdown.CellCert.CellFormula.ConjugateDataStatement","Breakdown.CellCert.CellFormula.PlaneDeletedStatement","Breakdown.CellCert.CellFormula.ShiftedRealReduction.Internal.conj_of_modeOf_zero","Breakdown.CellCert.CellFormula.ShiftedRealReduction.Internal.modeOf_conj","Breakdown.CellCert.CellFormula.ShiftedRealReduction.Internal.modeOf_of_gauge","Breakdown.CellCert.CellFormula.ShiftedRealReduction.Internal.plane_conj","Breakdown.CellCert.CellFormula.ShiftedRealReduction.Internal.shift_im","Breakdown.CellCert.CellFormula.ShiftedRealReduction.Internal.shift_of_modeOf_ne","Breakdown.CellCert.CellFormula.ShiftedRealReduction.Internal.shift_of_plane","Breakdown.CellCert.CellFormula.ShiftedRealReductionStatement"],"written":"shiftedRealReduction_of"}],"imports":["Breakdown.FracCell.FormulaDataDefs"],"module":"Breakdown.FracCell.ShiftedRealReduction","path":"Breakdown/FracCell/ShiftedRealReduction.lean","sha256":"e08d2dc9944e2560fada74651bc1bf75e6721a13b403d8a18a97370cf97b982d","source":"import Breakdown.FracCell.FormulaDataDefs\n\nopen MeasureTheory Matrix\n\nnoncomputable section\n\nnamespace Breakdown.CellCert.CellFormula\n\nopen SteadyCert Assembly CellAnalysis\n\nnamespace ShiftedRealReduction.Internal\n\nvariable (L : CellLayout)\n\ntheorem negMode_val (hs : ∀ n ∈ L.modes, -n ∈ L.modes) (n : L.modes) : (L.negMode n).1 = -n.1 := by\n  unfold CellLayout.negMode\n  rw [dif_pos (hs _ n.2)]\n\ntheorem negMode_of_zero (n : L.modes) (h : n.1 = 0) : L.negMode n = n := by\n  unfold CellLayout.negMode\n  have hm : -n.1 ∈ L.modes := by rw [h, neg_zero, ← h]; exact n.2\n  rw [dif_pos hm]\n  exact Subtype.ext (by simp [h])\n\ntheorem modeOf_conj (hs : ∀ n ∈ L.modes, -n ∈ L.modes) (d : L.Datum) :\n    L.modeOf (L.conjDatum d) = -L.modeOf d := by\n  rcases d with i | i | i | i | i | i | i | i <;>\n    simp [CellLayout.modeOf, CellLayout.conjDatum, negMode_val L hs]\n\ntheorem conj_of_modeOf_zero (d : L.Datum) (h : L.modeOf d = 0) : L.conjDatum d = d := by\n  rcases d with i | i | i | i | i | i | i | i <;>\n    simp only [CellLayout.modeOf, CellLayout.conjDatum, Sum.elim_inl, Sum.elim_inr, Sum.map_inl,\n      Sum.map_inr, id] at h ⊢\n  all_goals first\n    | rfl\n    | rw [negMode_of_zero L _ h]\n\ntheorem plane_conj (d : L.Datum) : L.IsPlaneDeleted (L.conjDatum d) ↔ L.IsPlaneDeleted d := by\n  rcases d with i | i | i | i | i | i | i | i <;>\n    simp [CellLayout.IsPlaneDeleted, CellLayout.conjDatum]\n\ntheorem modeOf_of_gauge (d : L.Datum) (h : L.IsGaugeDeleted d) : L.modeOf d = 0 := by\n  rcases d with i | i | i | i | i | i | i | i <;>\n    simp [CellLayout.IsGaugeDeleted, CellLayout.modeOf] at h ⊢\n  exact h.1\n\ntheorem shift_im {k : ℕ} (g : GaugeShift k) (x : FieldTuple k) (d : L.Datum) :\n    (L.pressureShift g x d).im = 0 := by\n  rcases d with i | i | i | i | i | i | i | i <;>\n    simp only [CellLayout.pressureShift, Sum.elim_inl, Sum.elim_inr, Complex.zero_im]\n  split_ifs <;> simp\n\ntheorem shift_of_modeOf_ne {k : ℕ} (g : GaugeShift k) (x : FieldTuple k) (d : L.Datum)\n    (h : L.modeOf d ≠ 0) : L.pressureShift g x d = 0 := by\n  rcases d with i | i | i | i | i | i | i | i <;>\n    simp only [CellLayout.pressureShift, CellLayout.modeOf, Sum.elim_inl, Sum.elim_inr] at h ⊢\n  rw [if_neg h]\n\ntheorem shift_of_plane {k : ℕ} (g : GaugeShift k) (x : FieldTuple k) (d : L.Datum)\n    (h : L.IsPlaneDeleted d) : L.pressureShift g x d = 0 := by\n  rcases d with i | i | i | i | i | i | i | i <;>\n    simp only [CellLayout.pressureShift, CellLayout.IsPlaneDeleted, Sum.elim_inl, Sum.elim_inr] at h ⊢\n\nend ShiftedRealReduction.Internal\n\nopen ShiftedRealReduction.Internal in\ntheorem shiftedRealReduction_of (h1 : ConjugateDataStatement) (h2 : PlaneDeletedStatement) :\n    ShiftedRealReductionStatement := by\n  intro k N c K S B L g hL hg x hx hgd\n  have hs := hL.modes_symm\n  have hconj := h1 c K S B L hL x hx\n  have hplane := h2 c K S B L hL x hx\n  have hsh_plane : ∀ d, L.IsPlaneDeleted d → L.shiftedData g x d = 0 := fun d hd => by\n    simp [CellLayout.shiftedData, hplane d hd, shift_of_plane L g x d hd]\n  funext p\n  obtain ⟨d, i⟩ := p\n  unfold CellLayout.expandSystem\n  split_ifs with hr hn\n  · rfl\n  · obtain ⟨hneg, -⟩ := hn\n    have hm1 : L.modeOf d ≠ 0 := hneg.ne\n    have hm2 : L.modeOf (L.conjDatum d) ≠ 0 := by rw [modeOf_conj L hs]; omega\n    have e1 : L.shiftedData g x (L.conjDatum d) = (starRingEnd ℂ) (L.shiftedData g x d) := by\n      simp only [CellLayout.shiftedData, shift_of_modeOf_ne L g x _ hm1, shift_of_modeOf_ne L g x _ hm2,\n        hconj, add_zero]\n    simp only [CellLayout.realPart, e1, CellLayout.partSign]\n    by_cases hi : i = 0\n    · simp [hi]\n    · simp [hi]\n  · by_cases hp : L.IsPlaneDeleted d\n    · simp [CellLayout.realPart, hsh_plane d hp]\n    by_cases hG : L.IsGaugeDeleted d\n    · simp [CellLayout.realPart, hgd d hG]\n    have hr' : ¬ (0 < L.modeOf d ∨ (L.modeOf d = 0 ∧ i = 0)) := fun h => hr ⟨h, hp, hG⟩\n    rcases lt_trichotomy (L.modeOf d) 0 with hlt | heq | hgt\n    · exfalso\n      apply hn\n      refine ⟨hlt, ?_, ?_, ?_⟩\n      · left\n        show 0 < L.modeOf (L.conjDatum d)\n        rw [modeOf_conj L hs]\n        omega\n      · rw [plane_conj]\n        exact hp\n      · intro hG'\n        have h3 : L.modeOf (L.conjDatum d) = 0 := modeOf_of_gauge L _ hG'\n        rw [modeOf_conj L hs] at h3\n        exact hlt.ne (neg_eq_zero.mp h3)\n    · have hi : i ≠ 0 := fun hi => hr' (Or.inr ⟨heq, hi⟩)\n      have hc := hconj d\n      rw [conj_of_modeOf_zero L d heq] at hc\n      have him : (L.trueData x d).im = 0 := Complex.conj_eq_iff_im.mp hc.symm\n      simp [CellLayout.realPart, hi, CellLayout.shiftedData, Complex.add_im, him, shift_im L g x d]\n    · exact absurd (Or.inl hgt) hr'\n\nend Breakdown.CellCert.CellFormula\n"}