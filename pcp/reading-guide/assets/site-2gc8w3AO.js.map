 "topics": [
  {
   "id": "pcp-characterization",
   "name": "PCP theorem",
   "description": "Polynomial-time verification with logarithmic randomness and a constant number of proof-bit queries characterizes NP.",
   "family": "np-and-pcp"
  },
  {
   "id": "polynomial-distance",
   "name": "Polynomial distance",
   "description": "The Schwartz–Zippel bound limits the fraction of points where a nonzero polynomial vanishes.",
   "family": "polynomials-and-grids"
  },
  {
   "id": "grid-interpolation",
   "name": "Low-degree extension",
   "description": "Interpolation represents a table on a grid by a unique polynomial with a degree bound in each variable.",
   "family": "polynomials-and-grids"
  },
  {
   "id": "hadamard-labels",
   "name": "Labels and encoding",
   "description": "Polynomial labels turn field values and their polynomial expressions into bits and distinguish full, affine and homogeneous observations.",
   "family": "hadamard-encoding"
  },
  {
   "id": "verifier-model",
   "name": "Verifier and query trees",
   "description": "A verifier selects an adaptive query tree from its input and random seed, with explicit acceptance probabilities and proof-address bounds.",
   "family": "verifier-model-and-resources"
  },
  {
   "id": "machine-implementation",
   "name": "Polynomial-time implementation",
   "description": "A finite multi-stack machine implements the verifier or witness checker with polynomial running time.",
   "family": "verifier-model-and-resources"
  },
  {
   "id": "colouring-constraints",
   "name": "Colouring constraints",
   "description": "Vertex values and edge differences satisfy polynomial equations exactly when they define a proper three-colouring.",
   "family": "three-colouring-verifier"
  },
  {
   "id": "vanishing-certificates",
   "name": "Vanishing certificates",
   "description": "A polynomial vanishing on a grid admits a decomposition using the coordinate vanishing polynomials and a certificate expressed by two identities.",
   "family": "polynomials-and-grids"
  },
  {
   "id": "linearity-self-correction",
   "name": "Linearity and self-correction",
   "description": "Linearity testing finds a nearby linear word, and two randomly shifted queries recover a requested value with controlled error.",
   "family": "hadamard-encoding"
  },
  {
   "id": "resource-bounds",
   "name": "Queries, randomness and repetition",
   "description": "Query counts, fair-bit sampling, proof length and independent repetition give the resource bounds and final soundness error.",
   "family": "verifier-model-and-resources"
  },
  {
   "id": "proof-tables-checks",
   "name": "Proof tables and checks",
   "description": "Four pairs of points and lines tables supply the answers read by four low-degree tests, two grid tests and a difference check.",
   "family": "three-colouring-verifier"
  },
  {
   "id": "binary-low-degree-test",
   "name": "Binary low-degree test",
   "description": "Small rejection gives one polynomial whose encoding is close to the points table on both full and homogeneous labels.",
   "family": "binary-low-degree-testing"
  },
  {
   "id": "zero-on-grid-test",
   "name": "Zero-on-grid test",
   "description": "Corrected certificate queries test vanishing identities at prescribed points and relate failure on the grid to rejection.",
   "family": "local-correction-and-grid-testing"
  },
  {
   "id": "colouring-guarantees",
   "name": "Completeness and soundness",
   "description": "An honest colouring passes every check, while sufficiently small rejection forces four nearby polynomials to describe a proper colouring.",
   "family": "three-colouring-verifier"
  },
  {
   "id": "np-reduction",
   "name": "Reduction to three-colouring",
   "description": "Accepting computations become finite constraints, Boolean clauses and graphs while preserving the existence of a witness.",
   "family": "np-and-pcp"
  },
  {
   "id": "np-witnesses",
   "name": "NP witness verification",
   "description": "A language belongs to NP when membership is witnessed by a polynomial-length string accepted by a polynomial-time checker.",
   "family": "np-and-pcp"
  },
  {
   "id": "standard-low-degree-test",
   "name": "Standard low-degree test",
   "description": "Weighted interpolation at generator powers tests low degree, with plurality correction turning small rejection into polynomial agreement.",
   "family": "field-low-degree-testing"
  },
  {
   "id": "field-local-correction",
   "name": "Local correction over fields",
   "description": "Random line queries recover a polynomial value at a prescribed point or bound the probability of accepting a wrong value.",
   "family": "local-correction-and-grid-testing"
  },
  {
   "id": "bivariate-agreement",
   "name": "Bivariate agreement",
   "description": "Agreement between low-degree row and column polynomials produces a nearby bivariate polynomial and consistent values at selected crossings.",
   "family": "field-low-degree-testing"
  },
  {
   "id": "point-line-test",
   "name": "Point-versus-line test",
   "description": "Agreement with supplied line polynomials at random points yields one nearby polynomial of bounded total degree.",
   "family": "field-low-degree-testing"
  },
  {
   "id": "set-multilinear-encoding",
   "name": "Set-multilinear encoding",
   "description": "Writing exponents in a fixed number of base digits replaces a line polynomial by a polynomial of fixed total degree.",
   "family": "binary-low-degree-testing"
  },
  {
   "id": "hadamard-testing",
   "name": "Hadamard test",
   "description": "Linearity, unit, product and affine consistency checks test whether a word is close to the encoding of one field value.",
   "family": "hadamard-encoding"
  },
  {
   "id": "inner-low-degree-test",
   "name": "Inner low-degree test",
   "description": "A random choice between Hadamard testing and a binary weighted identity tests one encoded line entry for low degree.",
   "family": "binary-low-degree-testing"
  },
  {
   "id": "binary-local-correction",
   "name": "Local correction on bits",
   "description": "Weighted bit queries and tests of encoded line entries recover a homogeneous observation at a prescribed point, allowing rejection.",
   "family": "local-correction-and-grid-testing"
  }
 ],
