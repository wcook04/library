.Parser.Rebuild.yields_switch","BSmtLibSpec.Facts.Proofs.Reader.Requests.recordCommands_none","BSmtLibSpec.Parser.Properties.Takes","BSmtLibSpec.Parser.Properties.Takes.refused","BSmtLibSpec.Parser.Traversal.switchVersion","BSmtLibSpec.Parser.VersionPolicy.check"],"uses":["BSmtLibSpec.Parser.VersionPolicy.Error"],"written":"unsupportedVersion"},{"axioms":[],"dependency_source":"lean_report","doc":"The script has already made as many declarations as the policy allows\n  (`TooManyVersionDeclarations`).","end_line":45,"kind":"def","line":45,"module":"BSmtLibSpec.Parser.VersionPolicy","name":"BSmtLibSpec.Parser.VersionPolicy.Error.tooManyDeclarations","namespace":"BSmtLibSpec.Parser.VersionPolicy.Error","noncomputable":false,"parent":"BSmtLibSpec.Parser.VersionPolicy.Error","private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"tooManyDeclarations","signature_end_line":45,"sorry":false,"statement_used_by":["BSmtLibSpec.Parser.VersionPolicy.Error","BSmtLibSpec.Parser.VersionPolicy.check"],"statement_uses":["BSmtLibSpec.Parser.VersionPolicy.Error"],"used_by":["BSmtLibSpec.Parser.VersionPolicy.Error","BSmtLibSpec.Parser.VersionPolicy.check"],"uses":["BSmtLibSpec.Parser.VersionPolicy.Error"],"written":"tooManyDeclarations"},{"axioms":["propext"],"dependency_source":"lean_report","doc":"The check of a version declaration against the policy, given the number of declarations\nthe script made before it: first the number of declarations, then the version.\n\nA declaration that breaks both rules is rejected for the number of declarations.","end_line":59,"kind":"def","line":53,"module":"BSmtLibSpec.Parser.VersionPolicy","name":"BSmtLibSpec.Parser.VersionPolicy.check","namespace":"BSmtLibSpec.Parser.VersionPolicy","noncomputable":false,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"check","signature_end_line":54,"sorry":false,"statement_used_by":["BSmtLibSpec.Parser.Traversal.switchVersion"],"statement_uses":["BSmtLibSpec.Lexicon.Version","BSmtLibSpec.Parser.VersionPolicy","BSmtLibSpec.Parser.VersionPolicy.Error","BSmtLibSpec.Parser.VersionPolicy.Error.tooManyDeclarations","BSmtLibSpec.Parser.VersionPolicy.Error.unsupportedVersion","BSmtLibSpec.Parser.VersionPolicy.allowed","BSmtLibSpec.Parser.VersionPolicy.maxDeclarations"],"used_by":["BSmtLibSpec.Facts.Proofs.Parser.Equations.switchVersion_eq","BSmtLibSpec.Facts.Proofs.Parser.Rebuild.unrestricted_ok","BSmtLibSpec.Facts.Proofs.Parser.Recording.unrestricted_check","BSmtLibSpec.Parser.Traversal.switchVersion"],"uses":["BSmtLibSpec.Lexicon.Version","BSmtLibSpec.Parser.VersionPolicy","BSmtLibSpec.Parser.VersionPolicy.Error","BSmtLibSpec.Parser.VersionPolicy.Error.tooManyDeclarations","BSmtLibSpec.Parser.VersionPolicy.Error.unsupportedVersion","BSmtLibSpec.Parser.VersionPolicy.allowed","BSmtLibSpec.Parser.VersionPolicy.maxDeclarations"],"written":"VersionPolicy.check"}],"imports":["BSmtLibSpec.Grammar"],"module":"BSmtLibSpec.Parser.VersionPolicy","path":"BSmtLibSpec/Parser/VersionPolicy.lean","sha256":"0ddc9e04ebb7f8f806cf96dbaf99743f70922b9d1462f77101b7b04aee9bfacb","source":"module\n\npublic import BSmtLibSpec.Grammar\n\n@[expose] public section\n\n/-!\n# Version policies\n\nA policy restricts which versions a script may declare, and how often. A parser checks a version\ndeclaration against its policy after the declaration's `)`, when the declaration is complete; a\ndeclaration that breaks the policy stops the parse there.\n-/\n\nnamespace BSmtLibSpec.Parser\n\nopen BSmtLibSpec.Lexicon BSmtLibSpec.Grammar\n\n/--\nA policy on the versions that a script declares: which versions it may declare, and how many\ndeclarations it may make (`none`: any number).\n-/\nstructure VersionPolicy where\n  allowed : List Version\n  maxDeclarations : Option Nat\n\n/--\nThe policy that restricts nothing: every version may be declared, any number of times.\n-/\ndef VersionPolicy.unrestricted : VersionPolicy :=\n  { allowed := [.v2_0, .v2_5, .v2_6, .v2_7], maxDeclarations := none }\n\n/--\nThe syntax errors with which a parse rejects a version declaration.\n\nA version that the policy does not allow and a version that the producer refuses to switch to\nare the same error: what refused the version is not told.\n-/\ninductive VersionPolicy.Error where\n  /-- The version is not among those the policy allows, or the producer refused it\n  (`UnsupportedVersion`). -/\n  | unsupportedVersion\n  /-- The script has already made as many declarations as the policy allows\n  (`TooManyVersionDeclarations`). -/\n  | tooManyDeclarations (limit : Nat)\n\n/--\nThe check of a version declaration against the policy, given the number of declarations\nthe script made before it: first the number of declarations, then the version.\n\nA declaration that breaks both rules is rejected for the number of declarations.\n-/\ndef VersionPolicy.check (policy : VersionPolicy) (declarations : Nat) (version : Version) :\n    Except VersionPolicy.Error Unit :=\n  match policy.maxDeclarations with\n  | some limit =>\n    if limit ≤ declarations then .error (.tooManyDeclarations limit)\n    else if version ∉ policy.allowed then .error .unsupportedVersion else .ok ()\n  | none => if version ∉ policy.allowed then .error .unsupportedVersion else .ok ()\n\nend BSmtLibSpec.Parser\n"}