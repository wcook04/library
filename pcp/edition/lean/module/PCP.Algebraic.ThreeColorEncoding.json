braic.ThreeColorEncoding.adjacencyBits","PCP.Algebraic.ThreeColorEncoding.encode"],"written":"length_encode"},{"dependency_source":"source_text","doc":null,"end_line":84,"kind":"theorem","line":80,"module":"PCP.Algebraic.ThreeColorEncoding","name":"PCP.Algebraic.ThreeColorEncoding.payload_encode","namespace":"PCP.Algebraic.ThreeColorEncoding","noncomputable":false,"private":false,"protected":false,"short":"payload_encode","signature_end_line":81,"used_by":["PCP.Algebraic.ThreeColorEncoding.edgeBit_encode"],"uses":["PCP.Algebraic.ThreeColorEncoding.adjacencyBits","PCP.Algebraic.ThreeColorEncoding.encode","PCP.Algebraic.ThreeColorEncoding.payload","PCP.Algebraic.ThreeColorEncoding.vertexCount_encode"],"written":"payload_encode"},{"dependency_source":"source_text","doc":"The finite coordinate transport caused solely by reading the size header.","end_line":88,"kind":"def","line":87,"module":"PCP.Algebraic.ThreeColorEncoding","name":"PCP.Algebraic.ThreeColorEncoding.vertexEquiv","namespace":"PCP.Algebraic.ThreeColorEncoding","noncomputable":false,"private":false,"protected":false,"short":"vertexEquiv","signature_end_line":88,"used_by":["PCP.Algebraic.ThreeColorEncoding.decodeEncodeIso","PCP.Algebraic.ThreeColorEncoding.edgeBit_encode"],"uses":["PCP.Algebraic.ThreeColorEncoding.encode","PCP.Algebraic.ThreeColorEncoding.vertexCount","PCP.Algebraic.ThreeColorEncoding.vertexCount_encode"],"written":"vertexEquiv"},{"dependency_source":"source_text","doc":null,"end_line":102,"kind":"theorem","line":90,"module":"PCP.Algebraic.ThreeColorEncoding","name":"PCP.Algebraic.ThreeColorEncoding.adjacencyBits_getD","namespace":"PCP.Algebraic.ThreeColorEncoding","noncomputable":false,"private":true,"protected":false,"short":"adjacencyBits_getD","signature_end_line":92,"used_by":["PCP.Algebraic.ThreeColorEncoding.edgeBit_encode"],"uses":["PCP.Algebraic.ThreeColorEncoding.adjacencyBits"],"written":"adjacencyBits_getD"},{"dependency_source":"source_text","doc":"Each decoded bit of an honest encoding is precisely its original adjacency bit.","end_line":111,"kind":"theorem","line":105,"module":"PCP.Algebraic.ThreeColorEncoding","name":"PCP.Algebraic.ThreeColorEncoding.edgeBit_encode","namespace":"PCP.Algebraic.ThreeColorEncoding","noncomputable":false,"private":false,"protected":false,"short":"edgeBit_encode","signature_end_line":107,"used_by":["PCP.Algebraic.ThreeColorEncoding.decodeEncodeIso"],"uses":["PCP.Algebraic.ThreeColorEncoding.adjacencyBits_getD","PCP.Algebraic.ThreeColorEncoding.edgeBit","PCP.Algebraic.ThreeColorEncoding.encode","PCP.Algebraic.ThreeColorEncoding.payload_encode","PCP.Algebraic.ThreeColorEncoding.vertexCount","PCP.Algebraic.ThreeColorEncoding.vertexCount_encode","PCP.Algebraic.ThreeColorEncoding.vertexEquiv"],"written":"edgeBit_encode"},{"dependency_source":"source_text","doc":"The decoded graph is isomorphic to the original graph by the header's coordinate cast.","end_line":127,"kind":"def","line":114,"module":"PCP.Algebraic.ThreeColorEncoding","name":"PCP.Algebraic.ThreeColorEncoding.decodeEncodeIso","namespace":"PCP.Algebraic.ThreeColorEncoding","noncomputable":false,"private":false,"protected":false,"short":"decodeEncodeIso","signature_end_line":115,"used_by":["PCP.Algebraic.ThreeColorEncoding.decode_encode_colorable_iff"],"uses":["PCP.Algebraic.ThreeColorEncoding.edgeBit","PCP.Algebraic.ThreeColorEncoding.edgeBit_encode","PCP.Algebraic.ThreeColorEncoding.encode","PCP.Algebraic.ThreeColorEncoding.graph","PCP.Algebraic.ThreeColorEncoding.vertexEquiv"],"written":"decodeEncodeIso"},{"dependency_source":"source_text","doc":"In particular, encoding and decoding preserve every finite colorability question.","end_line":132,"kind":"theorem","line":130,"module":"PCP.Algebraic.ThreeColorEncoding","name":"PCP.Algebraic.ThreeColorEncoding.decode_encode_colorable_iff","namespace":"PCP.Algebraic.ThreeColorEncoding","noncomputable":false,"private":false,"protected":false,"short":"decode_encode_colorable_iff","signature_end_line":131,"used_by":["PCP.Algebraic.ThreeColorAmplifiedVerifier.completeAt_encode","PCP.Algebraic.ThreeColorAmplifiedVerifier.soundAt_encode","PCP.Reduction.ThreeSATGraphEncoding.decode_colorable_iff","PCP.Reduction.ThreeSATNumericClauses.decoded_colorable_iff"],"uses":["PCP.Algebraic.ThreeColorEncoding.decodeEncodeIso","PCP.Algebraic.ThreeColorEncoding.encode","PCP.Algebraic.ThreeColorEncoding.graph"],"written":"decode_encode_colorable_iff"}],"imports":["Mathlib.Combinatorics.SimpleGraph.Coloring.Vertex","Mathlib.Data.List.TakeWhile","Mathlib.Data.List.OfFn","Mathlib.Data.List.GetD","Mathlib.Logic.Equiv.Fin.Basic"],"module":"PCP.Algebraic.ThreeColorEncoding","path":"PCP/Algebraic/ThreeColorEncoding.lean","sha256":"d323474a9b12c013ed6be3ab8f3e239e81ac147bf6b366fe1325e93f2f27d175","source":"/-\nCopyright (c) 2026 Troy Lee. All rights reserved.\nReleased under Apache 2.0 license as described in the file LICENSE.\nAuthors: Troy Lee\n-/\nimport Mathlib.Combinatorics.SimpleGraph.Coloring.Vertex\nimport Mathlib.Data.List.TakeWhile\nimport Mathlib.Data.List.OfFn\nimport Mathlib.Data.List.GetD\nimport Mathlib.Logic.Equiv.Fin.Basic\n\n/-!\n# A concrete bitstring format for finite graphs\n\nThe header is `N` true bits followed by one false bit. The payload lists the\n`N*N` adjacency bits in row-major order. Decoding is total: missing payload\nbits are false, either orientation supplies an edge, and loops are discarded.\nThus every input string denotes an actual finite simple graph.\n\nThe definitions are computable and the encoder round-trips exactly. No\nmachine-level running-time certificate is asserted here.\n-/\n\nnamespace PCP.Algebraic.ThreeColorEncoding\n\n/-- The number of leading true bits is the decoded vertex count. -/\ndef vertexCount (x : List Bool) : ℕ := (x.takeWhile id).length\n\ntheorem size_le_length (x : List Bool) : vertexCount x ≤ x.length :=\n  (List.takeWhile_prefix id).length_le\n\n/-- Everything after the unary header and its separator is adjacency data. -/\ndef payload (x : List Bool) : List Bool := x.drop (vertexCount x + 1)\n\n/-- Missing adjacency bits are false. -/\ndef edgeBit (x : List Bool) (i j : Fin (vertexCount x)) : Bool :=\n  (payload x).getD (i.val * vertexCount x + j.val) false\n\n/-- A total graph decoder, symmetrizing the two stored orientations and removing loops. -/\ndef graph (x : List Bool) : SimpleGraph (Fin (vertexCount x)) where\n  Adj i j := i ≠ j ∧ (edgeBit x i j = true ∨ edgeBit x j i = true)\n  symm := ⟨by\n    intro i j h\n    exact ⟨h.1.symm, h.2.symm⟩⟩\n  loopless := ⟨by\n    intro i h\n    exact h.1 rfl⟩\n\ninstance graphDecidableAdj (x : List Bool) : DecidableRel (graph x).Adj := by\n  intro i j\n  change Decidable (i ≠ j ∧ (edgeBit x i j = true ∨ edgeBit x j i = true))\n  infer_instance\n\n/-- Ordered adjacency bits, indexed by the standard finite-product equivalence. -/\ndef adjacencyBits {N : ℕ} (G : SimpleGraph (Fin N)) [DecidableRel G.Adj] : List Bool :=\n  List.ofFn (fun k : Fin (N * N) =>\n    decide (G.Adj (finProdFinEquiv.symm k).1 (finProdFinEquiv.symm k).2))\n\n/-- The unary size header, separator, and full row-major adjacency matrix. -/\ndef encode {N : ℕ} (G : SimpleGraph (Fin N)) [DecidableRel G.Adj] : List Bool :=\n  List.replicate N true ++ false :: adjacencyBits G\n\nprivate theorem takeWhile_header (N : ℕ) (bits : List Bool) :\n    (List.replicate N true ++ false :: bits).takeWhile id = List.replicate N true := by\n  induction N with\n  | zero => simp\n  | succ N ih => simp [List.replicate_succ, ih]\n\n@[simp] theorem vertexCount_encode {N : ℕ} (G : SimpleGraph (Fin N))\n    [DecidableRel G.Adj] : vertexCount (encode G) = N := by\n  simp only [vertexCount, encode, takeWhile_header, List.length_replicate]\n\n/-- The precise length includes the one-bit header terminator. -/\n@[simp] theorem length_encode {N : ℕ} (G : SimpleGraph (Fin N)) [DecidableRel G.Adj] :\n    (encode G).length = N + 1 + N ^ 2 := by\n  simp only [encode, adjacencyBits, List.length_append, List.length_replicate,\n    List.length_cons, List.length_ofFn, pow_two]\n  omega\n\n@[simp] theorem payload_encode {N : ℕ} (G : SimpleGraph (Fin N)) [DecidableRel G.Adj] :\n    payload (encode G) = adjacencyBits G := by\n  unfold payload\n  rw [vertexCount_encode]\n  simp [encode, List.drop_append]\n\n/-- The finite coordinate transport caused solely by reading the size header. -/\ndef vertexEquiv {N : ℕ} (G : SimpleGraph (Fin N)) [DecidableRel G.Adj] :\n    Fin (vertexCount (encode G)) ≃ Fin N := finCongr (vertexCount_encode G)\n\nprivate theorem adjacencyBits_getD {N : ℕ} (G : SimpleGraph (Fin N))\n    [DecidableRel G.Adj] (i j : Fin N) :\n    (adjacencyBits G).getD (i.val * N + j.val) false = decide (G.Adj i j) := by\n  let k : Fin (N * N) := finProdFinEquiv (i, j)\n  have hk : k.val = i.val * N + j.val := by\n    change j.val + N * i.val = i.val * N + j.val\n    ac_rfl\n  rw [← hk]\n  unfold adjacencyBits\n  rw [List.getD_eq_getElem _ _ (by simpa only [List.length_ofFn] using k.isLt)]\n  simp only [List.getElem_ofFn]\n  change decide (G.Adj (finProdFinEquiv.symm k).1 (finProdFinEquiv.symm k).2) = _\n  simp [k]\n\n/-- Each decoded bit of an honest encoding is precisely its original adjacency bit. -/\ntheorem edgeBit_encode {N : ℕ} (G : SimpleGraph (Fin N)) [DecidableRel G.Adj]\n    (i j : Fin (vertexCount (encode G))) :\n    edgeBit (encode G) i j = decide (G.Adj (vertexEquiv G i) (vertexEquiv G j)) := by\n  unfold edgeBit\n  rw [payload_encode]\n  have h := adjacencyBits_getD G (vertexEquiv G i) (vertexEquiv G j)\n  simpa only [vertexEquiv, finCongr_apply, Fin.val_cast, vertexCount_encode] using h\n\n/-- The decoded graph is isomorphic to the original graph by the header's coordinate cast. -/\ndef decodeEncodeIso {N : ℕ} (G : SimpleGraph (Fin N)) [DecidableRel G.Adj] :\n    graph (encode G) ≃g G where\n  toEquiv := vertexEquiv G\n  map_rel_iff' := by\n    intro i j\n    change G.Adj (vertexEquiv G i) (vertexEquiv G j) ↔\n      i ≠ j ∧ (edgeBit (encode G) i j = true ∨ edgeBit (encode G) j i = true)\n    rw [edgeBit_encode, edgeBit_encode, decide_eq_true_eq, decide_eq_true_eq]\n    constructor\n    · intro h\n      exact ⟨fun he => h.ne (congrArg (vertexEquiv G) he), Or.inl h⟩\n    · rintro ⟨_, h | h⟩\n      · exact h\n      · exact h.symm\n\n/-- In particular, encoding and decoding preserve every finite colorability question. -/\ntheorem decode_encode_colorable_iff {N : ℕ} (G : SimpleGraph (Fin N))\n    [DecidableRel G.Adj] (k : ℕ) : (graph (encode G)).Colorable k ↔ G.Colorable k :=\n  SimpleGraph.colorable_congr (decodeEncodeIso G)\n\nend PCP.Algebraic.ThreeColorEncoding\n"}