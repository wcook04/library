putable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"LowFrequencyRemovalStatement","signature_end_line":29,"sorry":false,"statement_used_by":["Breakdown.FracCert.lowFrequencyRemoval","Breakdown.FracCert.weakProfileRegular_of","Breakdown.SteadyCert.ChainInternal.lowFrequencyRemoval_holds"],"statement_uses":["Breakdown.Freq.CSpace","Breakdown.Freq.conjVec","Breakdown.SmoothFlow.physField","Breakdown.Space"],"used_by":["Breakdown.FracCert.lowFrequencyRemoval","Breakdown.FracCert.weakProfileRegular_of","Breakdown.SteadyCert.ChainInternal.lowFrequencyRemoval_holds"],"uses":["Breakdown.Freq.CSpace","Breakdown.Freq.conjVec","Breakdown.SmoothFlow.physField","Breakdown.Space"],"written":"LowFrequencyRemovalStatement"}],"imports":["Breakdown.FracCert.StWeak","Breakdown.FracCert.StatementsSmooth"],"module":"Breakdown.FracCert.StWeakRegular","path":"Breakdown/FracCert/StWeakRegular.lean","sha256":"fbdead1a8f37baeada9cbeaee38dfd7b7e3a287ea7d760faaa5ac64ebfc39833","source":"import Breakdown.FracCert.StWeak\nimport Breakdown.FracCert.StatementsSmooth\n\nopen MeasureTheory Set Real\nopen scoped ENNReal ContDiff\n\nnoncomputable section\n\nnamespace Breakdown.FracCert\n\nopen Breakdown.Freq Breakdown.SmoothFlow\n\ndef HasAllSymbolL1Moments (f : Space → CSpace) : Prop :=\n  ∀ j : ℕ, Integrable (fun ξ => (1 + ‖ξ‖) ^ j * ‖f ξ‖)\n\ndef SymbolL1OfMomentsStatement : Prop :=\n  ∀ x : X, HasAllMoments x → HasAllSymbolL1Moments (symbolX x) ∧\n    (velocity x : Space → Space) =ᵐ[volume] physField (symbolX x)\n\ndef FieldSmoothOfMomentsStatement : Prop :=\n  ∀ f : Space → CSpace, HasAllSymbolL1Moments f → (∀ ξ, f (-ξ) = conjVec (f ξ)) →\n    ContDiff ℝ ∞ (physField f) ∧ ∀ j : ℕ, ∃ C : ℝ, ∀ y, ‖iteratedFDeriv ℝ j (physField f) y‖ ≤ C\n\ndef WeakProfileRegularStatement : Prop :=\n  ∀ α : ℝ, 1 < α → α < 5 / 4 → ∀ (a : ℝ) (U : X), IsWeakRotatingProfile α a U → HasAllMoments U →\n    ContDiff ℝ ∞ (physField (symbolX U)) ∧ (∀ y, divergenceAt (physField (symbolX U)) y = 0) ∧\n    ∃ P : Space → ℝ, ContDiff ℝ ∞ P ∧ ∀ y, rotatingProfileResidual α a 1 (physField (symbolX U)) P y = 0\n\ndef LowFrequencyRemovalStatement : Prop :=\n  ∀ Θ : Space → Space, Continuous Θ → MemLp (fun y => (1 + ‖y‖)⁻¹ • Θ y) 2 volume →\n    (∀ m : Space → CSpace, (∀ ξ, m (-ξ) = conjVec (m ξ)) → ContDiff ℝ ∞ m →\n      HasCompactSupport m → (∃ r : ℝ, 0 < r ∧ ∀ ξ, ‖ξ‖ < r → m ξ = 0) →\n      ∫ y, inner ℝ (Θ y) (physField m y) = 0) → ∀ y, Θ y = 0\n\nend Breakdown.FracCert\n"}