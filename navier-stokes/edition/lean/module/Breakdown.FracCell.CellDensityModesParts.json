lice_holds","Breakdown.CellCert.CellAnalysis.densitySlice_of","Breakdown.CellCert.CellCoordinates.cellBound_of_final","Breakdown.CellCert.CellCoordinates.cellBound_of_remaining"],"uses":["Breakdown.CellCert.Assembly.CellSplit.localDensity","Breakdown.CellCert.Assembly.FieldTuple","Breakdown.CellCert.Assembly.IsAdmissible","Breakdown.CellCert.Assembly.IsFormData","Breakdown.CellCert.CellAnalysis.CellBox","Breakdown.CellCert.CellAnalysis.CellBox.rect","Breakdown.CellCert.CellAnalysis.CellBox.solid","Breakdown.CellCert.CellAnalysis.IsAxisymmetricWeight","Breakdown.CellCert.CellAnalysis.IsCellBox","Breakdown.CellCert.CellAnalysis.IsModelMirror","Breakdown.CellCert.CellAnalysis.cylPoint","Breakdown.CellCert.CellAnalysis.modeCoupling","Breakdown.CellCert.CellAnalysis.modeFieldPair","Breakdown.CellCert.CellAnalysis.modeLocalDensity","Breakdown.CellCert.FracCellData","Breakdown.CellCert.FracCellData.cellRegion","Breakdown.CellCert.FracCellData.modelActuatorGrad","Breakdown.CellCert.FracCellData.modelPinField","Breakdown.Space","Breakdown.SteadyCert.entryInner"],"written":"DensitySliceStatement"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":61,"kind":"theorem","line":43,"module":"Breakdown.FracCell.CellDensityModesParts","name":"Breakdown.CellCert.CellAnalysis.cellDensityModes_of_parts","namespace":"Breakdown.CellCert.CellAnalysis","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CellCert.CellAnalysis.cellDensityModes_of"],"proof_uses":["Breakdown.FracInternal.CellDensityModesSolid.solid_formula"],"protected":false,"short":"cellDensityModes_of_parts","signature_end_line":44,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CellCert.CellAnalysis.CellDensityModesStatement","Breakdown.CellCert.CellAnalysis.DensityIntegrableStatement","Breakdown.CellCert.CellAnalysis.DensityMirrorStatement","Breakdown.CellCert.CellAnalysis.DensitySliceStatement"],"used_by":["Breakdown.CellCert.CellAnalysis.cellDensityModes_of"],"uses":["Breakdown.CellCert.CellAnalysis.CellDensityModesStatement","Breakdown.CellCert.CellAnalysis.DensityIntegrableStatement","Breakdown.CellCert.CellAnalysis.DensityMirrorStatement","Breakdown.CellCert.CellAnalysis.DensitySliceStatement","Breakdown.FracInternal.CellDensityModesSolid.solid_formula"],"written":"cellDensityModes_of_parts"}],"imports":["Breakdown.FracCell.StCellBound","Breakdown.FracCell.CellDensityModesSolid"],"module":"Breakdown.FracCell.CellDensityModesParts","path":"Breakdown/FracCell/CellDensityModesParts.lean","sha256":"732b7b70e77ef04bf29dc5cb772d51c99f055ac7086aa1e44f31d7c9cd5cb5c0","source":"import Breakdown.FracCell.StCellBound\nimport Breakdown.FracCell.CellDensityModesSolid\n\nopen MeasureTheory Real\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace CellCert\n\nnamespace CellAnalysis\n\nopen SteadyCert Assembly\n\ndef DensityIntegrableStatement : Prop :=\n  ∀ (α : ℝ), 1 < α → α < 5 / 4 → ∀ {k N : ℕ} (c : FracCellData k N), IsFormData α c →\n    ∀ (K : CellBox), IsCellBox K → IsAxisymmetricWeight c K → IsModelMirror c K → K.solid ⊆ c.cellRegion →\n    ∀ x : FieldTuple k, IsAdmissible c x →\n      IntegrableOn (CellSplit.localDensity c α x) K.solid ∧\n        ∀ i, IntegrableOn (fun y => entryInner (x.2.1 y) (c.modelPinField i y)) K.solid\n\ndef DensityMirrorStatement : Prop :=\n  ∀ (α : ℝ), 1 < α → α < 5 / 4 → ∀ {k N : ℕ} (c : FracCellData k N), IsFormData α c →\n    ∀ (K : CellBox), IsCellBox K → IsAxisymmetricWeight c K → IsModelMirror c K → K.solid ⊆ c.cellRegion →\n    ∀ x : FieldTuple k, IsAdmissible c x →\n      (∀ᵐ y ∂volume, y ∈ K.solid → CellSplit.localDensity c α x (mirror y) = CellSplit.localDensity c α x y) ∧\n        ∀ i, ∀ᵐ y ∂volume, y ∈ K.solid → entryInner (x.2.1 (mirror y)) (c.modelPinField i (mirror y))\n          = entryInner (x.2.1 y) (c.modelPinField i y)\n\ndef DensitySliceStatement : Prop :=\n  ∀ (α : ℝ), 1 < α → α < 5 / 4 → ∀ {k N : ℕ} (c : FracCellData k N), IsFormData α c →\n    ∀ (K : CellBox), IsCellBox K → IsAxisymmetricWeight c K → IsModelMirror c K → K.solid ⊆ c.cellRegion →\n    ∀ x : FieldTuple k, IsAdmissible c x →\n      (∀ᵐ p ∂(volume.restrict K.rect),\n        (∫ θ in (0 : ℝ)..(2 * π), CellSplit.localDensity c α x (cylPoint p.1 θ p.2))\n          = 2 * π * ((∑' n : ℤ, modeLocalDensity c α x n p) + modeCoupling c x p\n            + ∑ i, x.2.2.2.1 i * modeFieldPair c x.2.1 (c.modelActuatorGrad i) p)) ∧\n      ∀ i, ∀ᵐ p ∂(volume.restrict K.rect),\n        (∫ θ in (0 : ℝ)..(2 * π), entryInner (x.2.1 (cylPoint p.1 θ p.2)) (c.modelPinField i (cylPoint p.1 θ p.2)))\n          = 2 * π * modeFieldPair c x.2.1 (c.modelPinField i) p\n\ntheorem cellDensityModes_of_parts (h₁ : DensityIntegrableStatement) (h₂ : DensityMirrorStatement)\n    (h₃ : DensitySliceStatement) : CellDensityModesStatement := by\n  intro α hα₁ hα₂ k N c hc K hK hw hmm hsub x hx\n  obtain ⟨hi₁, hi₂⟩ := h₁ α hα₁ hα₂ c hc K hK hw hmm hsub x hx\n  obtain ⟨hm₁, hm₂⟩ := h₂ α hα₁ hα₂ c hc K hK hw hmm hsub x hx\n  obtain ⟨hs₁, hs₂⟩ := h₃ α hα₁ hα₂ c hc K hK hw hmm hsub x hx\n  refine ⟨?_, fun i => ?_⟩\n  · rw [FracInternal.CellDensityModesSolid.solid_formula K hK _ hi₁ hm₁,\n      integral_congr_ae (hs₁.mono fun p hp => congrArg (fun t => p.1 * t) hp)]\n    have e : ∀ p : ℝ × ℝ, ∀ t : ℝ, p.1 * (2 * π * t) = 2 * π * (p.1 * t) := fun p t => by ring\n    simp only [e]\n    rw [integral_const_mul]\n    ring\n  · rw [FracInternal.CellDensityModesSolid.solid_formula K hK _ (hi₂ i) (hm₂ i),\n      integral_congr_ae ((hs₂ i).mono fun p hp => congrArg (fun t => p.1 * t) hp)]\n    have e : ∀ p : ℝ × ℝ, ∀ t : ℝ, p.1 * (2 * π * t) = 2 * π * (p.1 * t) := fun p t => by ring\n    simp only [e]\n    rw [integral_const_mul]\n    ring\n\n\nend CellAnalysis\n\nend CellCert\n\nend Breakdown\n"}