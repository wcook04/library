ace":"Breakdown.CertCell.Certificate","noncomputable":false,"noncomputable_section":true,"private":true,"proof_used_by":["Breakdown.CertCell.Certificate.coordinateSlack"],"proof_uses":["Breakdown.CertCell.Certificate.optionValue_sq"],"protected":false,"short":"owned_sum","signature_end_line":44,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CertCell.Certificate.CoordinateRealification","Breakdown.CertCell.Certificate.CoordinateRealification.Owns","Breakdown.CertCell.Certificate.CoordinateRealification.imagIndex","Breakdown.CertCell.Certificate.CoordinateRealification.realIndex","Breakdown.CertCell.Certificate.optionValue"],"used_by":["Breakdown.CertCell.Certificate.coordinateSlack"],"uses":["Breakdown.CertCell.Certificate.CoordinateRealification","Breakdown.CertCell.Certificate.CoordinateRealification.Owns","Breakdown.CertCell.Certificate.CoordinateRealification.imagIndex","Breakdown.CertCell.Certificate.CoordinateRealification.realIndex","Breakdown.CertCell.Certificate.optionValue","Breakdown.CertCell.Certificate.optionValue_sq"],"written":"owned_sum"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":70,"kind":"theorem","line":53,"module":"Breakdown.CertCell.CertCoordinateSlack","name":"Breakdown.CertCell.Certificate.coordinateSlack","namespace":"Breakdown.CertCell.Certificate","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CertCell.Certificate.complexNodeRealBound","Breakdown.CertCell.stateEnclosureCertificateNonneg_holds"],"proof_uses":["Breakdown.CertCell.Certificate.CoordinateRealification.Owns","Breakdown.CertCell.Certificate.CoordinateRealification.pivotImage","Breakdown.CertCell.Certificate.CoordinateRealification.slackOn","Breakdown.CertCell.Certificate.IsCoordinateOn.real_ne_imag","Breakdown.CertCell.Certificate.matrix_mulVec_apply","Breakdown.CertCell.Certificate.norm_sq_coordinate","Breakdown.CertCell.Certificate.ofRealVec","Breakdown.CertCell.Certificate.owned_sum"],"protected":false,"short":"coordinateSlack","signature_end_line":53,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CertCell.Certificate.CoordinateSlack"],"used_by":["Breakdown.CertCell.Certificate.complexNodeRealBound","Breakdown.CertCell.stateEnclosureCertificateNonneg_holds"],"uses":["Breakdown.CertCell.Certificate.CoordinateRealification.Owns","Breakdown.CertCell.Certificate.CoordinateRealification.pivotImage","Breakdown.CertCell.Certificate.CoordinateRealification.slackOn","Breakdown.CertCell.Certificate.CoordinateSlack","Breakdown.CertCell.Certificate.IsCoordinateOn.real_ne_imag","Breakdown.CertCell.Certificate.matrix_mulVec_apply","Breakdown.CertCell.Certificate.norm_sq_coordinate","Breakdown.CertCell.Certificate.ofRealVec","Breakdown.CertCell.Certificate.owned_sum"],"written":"coordinateSlack"}],"imports":["Mathlib","Breakdown.CertCell.CertificateStatements"],"module":"Breakdown.CertCell.CertCoordinateSlack","path":"Breakdown/CertCell/CertCoordinateSlack.lean","sha256":"459a070b1f936a3ae3b3f337311acdc5334af92d68a0ce0232fd1b8697ad16bb","source":"import Mathlib\nimport Breakdown.CertCell.CertificateStatements\n\nopen Matrix\n\nnoncomputable section\n\nnamespace Breakdown.CertCell.Certificate\n\nprivate def optionValue {m : Type} [Fintype m] [DecidableEq m] (y : m → ℝ) (o : Option m) : ℝ :=\n  ∑ k, if o = some k then y k else 0\n\nprivate lemma optionValue_sq {m : Type} [Fintype m] [DecidableEq m] (y : m → ℝ) (o : Option m) :\n    optionValue y o ^ 2 = ∑ k, if o = some k then y k ^ 2 else 0 := by\n  cases o with\n  | none => simp [optionValue]\n  | some a => simp [optionValue]\n\nprivate lemma matrix_mulVec_apply {n m : Type} [Fintype m] [DecidableEq m]\n    (R : CoordinateRealification n m) (y : m → ℝ) (j : n) :\n    (R.matrix *ᵥ ofRealVec y) j\n      = ((optionValue y (R.realIndex j) : ℝ) : ℂ)\n        + (R.imagSign j : ℂ) * Complex.I * ((optionValue y (R.imagIndex j) : ℝ) : ℂ) := by\n  simp only [Matrix.mulVec, dotProduct, CoordinateRealification.matrix, ofRealVec, optionValue,\n    Complex.ofReal_sum, Finset.mul_sum]\n  rw [← Finset.sum_add_distrib]\n  refine Finset.sum_congr rfl fun k _ => ?_\n  split_ifs <;> push_cast <;> ring\n\nprivate lemma norm_sq_coordinate (a b s : ℝ) (hs : s ^ 2 = 1) :\n    ‖(a : ℂ) + (s : ℂ) * Complex.I * (b : ℂ)‖ ^ 2 = a ^ 2 + b ^ 2 := by\n  have h : (a : ℂ) + (s : ℂ) * Complex.I * (b : ℂ) = (a : ℂ) + ((s * b : ℝ) : ℂ) * Complex.I := by\n    push_cast\n    ring\n  rw [h, ← Complex.normSq_eq_norm_sq, Complex.normSq_add_mul_I]\n  have h' : (s * b) ^ 2 = s ^ 2 * b ^ 2 := by ring\n  rw [h', hs, one_mul]\n\nopen Classical in\nprivate lemma owned_sum {n m : Type} [Fintype m] [DecidableEq m]\n    (R : CoordinateRealification n m) (y : m → ℝ) (j : n)\n    (h : ∀ k, R.realIndex j = some k → R.imagIndex j ≠ some k) :\n    optionValue y (R.realIndex j) ^ 2 + optionValue y (R.imagIndex j) ^ 2\n      = ∑ k, if R.Owns j k then y k ^ 2 else 0 := by\n  rw [optionValue_sq, optionValue_sq, ← Finset.sum_add_distrib]\n  refine Finset.sum_congr rfl fun k _ => ?_\n  by_cases h1 : R.realIndex j = some k <;> by_cases h2 : R.imagIndex j = some k\n  · exact absurd h2 (h k h1)\n  · simp [CoordinateRealification.Owns, h1, h2]\n  · simp [CoordinateRealification.Owns, h1, h2]\n  · simp [CoordinateRealification.Owns, h1, h2]\n\ntheorem coordinateSlack : CoordinateSlack := by\n  intro n m _ _ _ R pivot s y hR\n  classical\n  have hnorm : ∀ j ∈ pivot, s j * ‖(R.matrix *ᵥ ofRealVec y) j‖ ^ 2\n      = ∑ k, s j * if R.Owns j k then y k ^ 2 else 0 := by\n    intro j hj\n    rw [matrix_mulVec_apply, norm_sq_coordinate _ _ _ (hR.sign_sq j hj),\n      owned_sum R y j (hR.real_ne_imag j hj), Finset.mul_sum]\n  rw [Finset.sum_congr rfl hnorm, Finset.sum_comm, CoordinateRealification.pivotImage,\n    Finset.sum_filter]\n  refine Finset.sum_congr rfl fun k _ => ?_\n  rw [CoordinateRealification.slackOn, Finset.sum_mul]\n  split_ifs with hk\n  · refine Finset.sum_congr rfl fun j _ => ?_\n    split_ifs <;> simp\n  · push Not at hk\n    refine Finset.sum_eq_zero fun j hj => ?_\n    simp [hk j hj]\n\nend Breakdown.CertCell.Certificate\n"}