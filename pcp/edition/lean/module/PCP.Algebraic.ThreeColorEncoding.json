{"declarations":[{"dependency_source":"source_text","doc":"The number of leading true bits is the decoded vertex count.","end_line":27,"kind":"def","line":27,"module":"PCP.Algebraic.ThreeColorEncoding","name":"PCP.Algebraic.ThreeColorEncoding.vertexCount","namespace":"PCP.Algebraic.ThreeColorEncoding","noncomputable":false,"private":false,"protected":false,"short":"vertexCount","signature_end_line":27,"used_by":["PCP.Algebraic.ThreeColorAmplifiedVerifier.completeAt","PCP.Algebraic.ThreeColorAmplifiedVerifier.soundAt","PCP.Algebraic.ThreeColorAmplifiedVerifier.verification_guarantees","PCP.Algebraic.ThreeColorCanonicalVerifier.graphOrder","PCP.Algebraic.ThreeColorCanonicalVerifier.graphOrder_eq","PCP.Algebraic.ThreeColorCanonicalVerifier.vertexCode","PCP.Algebraic.ThreeColorCanonicalVerifier.vertexCode_val","PCP.Algebraic.ThreeColorEncoding.edgeBit","PCP.Algebraic.ThreeColorEncoding.edgeBit_encode","PCP.Algebraic.ThreeColorEncoding.graph","PCP.Algebraic.ThreeColorEncoding.payload","PCP.Algebraic.ThreeColorEncoding.size_le_length","PCP.Algebraic.ThreeColorEncoding.vertexCount_encode","PCP.Algebraic.ThreeColorEncoding.vertexEquiv","PCP.Lang.GraphAdjacency.bit_correct","PCP.Lang.GraphAdjacency.source_bit","PCP.Lang.GraphHeader.count_bits","PCP.Lang.GraphHeader.program_bits","PCP.Lang.GridEdge.Budget","PCP.Lang.GridEdge.Context","PCP.Lang.GridEdge.budget_spec","PCP.Lang.GridEdge.header_run","PCP.Lang.ThreeColorBaseBranches.BranchCost","PCP.Lang.ThreeColorBaseBranches.allQueries_input_eq","PCP.Lang.ThreeColorBaseBranches.allQueries_size","PCP.Lang.ThreeColorBaseBranches.allVerdict_input_eq","PCP.Lang.ThreeColorBaseBranches.branch_history_cost","PCP.Lang.ThreeColorBaseBranches.branch_run","PCP.Lang.ThreeColorBaseBranches.correct","PCP.Lang.ThreeColorBaseBranches.discover_cost","PCP.Lang.ThreeColorBaseBranches.discover_run","PCP.Lang.ThreeColorBaseBranches.pass_cost","PCP.Lang.ThreeColorBaseBranches.pass_run","PCP.Lang.ThreeColorBaseBranches.polynomial_allQueries_size","PCP