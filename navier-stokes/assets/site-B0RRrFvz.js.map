 "topics": [
  {
   "id": "statement",
   "name": "The blow-up statements",
   "description": "Smooth solutions, breakdown on space and on the torus, and the theorems that state them (Theorem 1.1, Theorem 7.1).",
   "family": "theorems"
  },
  {
   "id": "fractional",
   "name": "The fractional extension",
   "description": "The authors' separate extension with dissipation exponent between 1 and 5/4, outside the classical paper.",
   "family": "theorems"
  },
  {
   "id": "mild",
   "name": "Heat flow and mild solutions",
   "description": "The heat semigroup, the bilinear Duhamel term, mild solutions, restarting and uniqueness (§3).",
   "family": "profile-to-blowup"
  },
  {
   "id": "profile",
   "name": "Recurrent profiles",
   "description": "Self-similar time-periodic profiles, their slices and orbits, and weak profiles read as physical fields (§2, §4.1, §7.11).",
   "family": "profile-to-blowup"
  },
  {
   "id": "monodromy",
   "name": "Monodromy and the correction",
   "description": "The period map, its compact-plus-small splitting, the spectral projection and the fixed point that corrects a profile to an exact solution (§4).",
   "family": "profile-to-blowup"
  },
  {
   "id": "torus",
   "name": "Passing to the torus",
   "description": "The solenoidal cutoff, periodization and the periodic right inverse that move the construction onto the torus (§5–6).",
   "family": "torus"
  },
  {
   "id": "certificate",
   "name": "From certificate to profile",
   "description": "Certificate data, the free operator, convection, held solutions and the smoothing of the weak profile they produce (§7).",
   "family": "certificate-to-profile"
  },
  {
   "id": "coercive",
   "name": "The coercive multiplier estimate",
   "description": "The multiplier, its five density coefficients and lower bound, and the a priori estimate it gives (Appendix B.1 and B.2).",
   "family": "certificate-to-profile"
  },
  {
   "id": "encoding",
   "name": "Encoded cell data",
   "description": "The finitely represented inputs: coordinates and harmonics, the profile representation, splines and jets, physical cells, rows, weights and potentials.",
   "family": "cell-data"
  },
  {
   "id": "quarter-plane",
   "name": "Reduction to the quarter plane",
   "description": "Symmetry reduction of the density to the meridian quarter plane (B.3).",
   "family": "cell-data"
  },
  {
   "id": "cells-tails",
   "name": "Cells, traces and tails",
   "description": "Integrability, the common vector of unknowns, resolved modes, the tail budget and the exterior estimate (B.4).",
   "family": "cell-data"
  },
  {
   "id": "angular",
   "name": "Angular and ray-exterior tests",
   "description": "The angular inequalities, the pointwise test and the integrated test on ray exteriors (B.5 and B.6).",
   "family": "cell-estimates"
  },
  {
   "id": "tree",
   "name": "The matrix tree lower bound",
   "description": "The tree conditions on the cell matrices and the passage from all cells to the global inequality (B.7 and B.8).",
   "family": "cell-estimates"
  },
  {
   "id": "profile-change",
   "name": "Changing the profile",
   "description": "Bounds for moving estimates from the reference field to the actual profile (B.9).",
   "family": "cell-estimates"
  },
  {
   "id": "adjoint",
   "name": "The adjoint pairing and its error",
   "description": "The quadratic adjoint pairing, the azimuthal dual norm and the linear adjoint error with potentials and pins (B.10 to B.12).",
   "family": "cell-certificate"
  },
  {
   "id": "offset-certificate",
   "name": "The offset and the certificate",
   "description": "Enclosing the constant, linear and quadratic offset, and the fifteen fields of CellSystemCondition that make the data a certificate (B.13 and B.14).",
   "family": "cell-certificate"
  }
 ],
