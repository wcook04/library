Breakdown.Periodic.FracForcedPeriodicIsMild"],"uses":["Breakdown.Periodic.Coef","Breakdown.Periodic.Lattice","Breakdown.Periodic.Seq","Breakdown.Periodic.V","Breakdown.Periodic.fracTorusForce","Breakdown.Periodic.fracTorusHeat","Breakdown.Periodic.fracTorusKernel","Breakdown.Space"],"written":"IsFracTorusForcedMildOnIcc"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":48,"kind":"def","line":40,"module":"Breakdown.Frac.StTorusForce","name":"Breakdown.Periodic.IsFracForcedPeriodicSolution","namespace":"Breakdown.Periodic","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"IsFracForcedPeriodicSolution","signature_end_line":41,"sorry":false,"statement_used_by":["Breakdown.Periodic.FracApproxForcedSolution","Breakdown.Periodic.FracForcedPeriodicIsMild","Breakdown.Periodic.FracTorusForcedModes.Internal.mode_deriv","Breakdown.Periodic.FracTorusForcedModes.Internal.mode_identity"],"statement_uses":["Breakdown.Periodic.IsPeriodic","Breakdown.Space","Breakdown.advectionAt","Breakdown.divergenceAt","Breakdown.fractionalPowerAt","Breakdown.gradientAt"],"used_by":["Breakdown.Periodic.FracApproxForcedSolution","Breakdown.Periodic.FracForcedPeriodicIsMild","Breakdown.Periodic.FracTorusForcedModes.Internal.mode_deriv","Breakdown.Periodic.FracTorusForcedModes.Internal.mode_identity"],"uses":["Breakdown.Periodic.IsPeriodic","Breakdown.Space","Breakdown.advectionAt","Breakdown.divergenceAt","Breakdown.fractionalPowerAt","Breakdown.gradientAt"],"written":"IsFracForcedPeriodicSolution"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":52,"kind":"def","line":50,"module":"Breakdown.Frac.StTorusForce","name":"Breakdown.Periodic.FracForcedPeriodicIsMild","namespace":"Breakdown.Periodic","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"FracForcedPeriodicIsMild","signature_end_line":50,"sorry":false,"statement_used_by":["Breakdown.Periodic.TorusBlowupAssembly.Internal.fracForcedPeriodicIsMild_holds","Breakdown.Periodic.fracApproxResidualSmall","Breakdown.Periodic.fracForcedPeriodicIsMild_of"],"statement_uses":["Breakdown.Periodic.IsFracForcedPeriodicSolution","Breakdown.Periodic.IsFracTorusForcedMildOnIcc","Breakdown.Periodic.toV","Breakdown.Space"],"used_by":["Breakdown.Periodic.TorusBlowupAssembly.Internal.fracForcedPeriodicIsMild_holds","Breakdown.Periodic.fracApproxResidualSmall","Breakdown.Periodic.fracForcedPeriodicIsMild_of"],"uses":["Breakdown.Periodic.IsFracForcedPeriodicSolution","Breakdown.Periodic.IsFracTorusForcedMildOnIcc","Breakdown.Periodic.toV","Breakdown.Space"],"written":"FracForcedPeriodicIsMild"}],"imports":["Breakdown.Frac.StTorusReduce"],"module":"Breakdown.Frac.StTorusForce","path":"Breakdown/Frac/StTorusForce.lean","sha256":"122eb4b18a775db83368923e48be8b24ae3fee3936756e8b3b694f1a7f49b06d","source":"import Breakdown.Frac.StTorusReduce\n\nopen MeasureTheory Set Real\nopen scoped ContDiff\n\nnoncomputable section\n\nnamespace Breakdown.Periodic\n\ndef fracTorusForceCoef (α τ : ℝ) (F : Space → Space) (k : Lattice) : Coef :=\n  if 0 < τ then fracLatticeFactor α τ k • divFree k (freqTrCoef F k) else 0\n\ndef FracTorusForceSpec (α τ : ℝ) (F : Space → Space) (w : V) : Prop :=\n  ∀ k, coeff w k = fracTorusForceCoef α τ F k\n\nopen Classical in\ndef fracTorusForce (α τ : ℝ) (F : Space → Space) : V :=\n  if h : ∃ w, FracTorusForceSpec α τ F w then h.choose else 0\n\ndef FracTorusForceExists (α : ℝ) : Prop :=\n  ∀ (τ : ℝ) (F : Space → Space), ∃ w, FracTorusForceSpec α τ F w\n\ndef FracTorusForceAlgebra (α : ℝ) : Prop :=\n  (∀ τ F k, coeff (fracTorusForce α τ F) k = fracTorusForceCoef α τ F k) ∧\n  (∀ σ τ : ℝ, 0 < σ → σ ≤ τ → ∀ F,\n    fracTorusForce α τ F = fracTorusHeat α (τ - σ) (fracTorusForce α σ F)) ∧\n  ∀ F, ContinuousOn (fun τ => fracTorusForce α τ F) (Ioi 0)\n\ndef FracForceSmoothing (α : ℝ) : Prop :=\n  ∃ C : ℝ, 0 < C ∧ ∀ τ : ℝ, 0 < τ → τ ≤ 1 → ∀ F : Space → Space, Continuous F → IsPeriodic F →\n    ‖fracTorusForce α τ F‖ ≤ C * τ ^ (-(1 / (2 * α))) * Real.sqrt (∫ x in cell, ‖F x‖ ^ 2)\n\ndef IsFracTorusForcedMildOnIcc (α : ℝ) (u : ℝ → V) (F : ℝ → Space → Space) (a b : ℝ) : Prop :=\n  ContinuousOn u (Icc a b) ∧\n    ∀ t ∈ Icc a b, IntervalIntegrable (fun s => fracTorusKernel α (t - s) (u s) (u s)) volume a t ∧\n      IntervalIntegrable (fun s => fracTorusForce α (t - s) (F s)) volume a t ∧\n      u t = fracTorusHeat α (t - a) (u a) + (∫ s in a..t, fracTorusKernel α (t - s) (u s) (u s)) +\n        ∫ s in a..t, fracTorusForce α (t - s) (F s)\n\ndef IsFracForcedPeriodicSolution (α : ℝ) (u : ℝ → Space → Space) (p : ℝ → Space → ℝ)\n    (F : ℝ → Space → Space) (a b : ℝ) : Prop :=\n  ContDiffOn ℝ ∞ (fun z : ℝ × Space => u z.1 z.2) (Icc a b ×ˢ univ) ∧\n    ContDiffOn ℝ ∞ (fun z : ℝ × Space => p z.1 z.2) (Icc a b ×ˢ univ) ∧\n    ContinuousOn (fun z : ℝ × Space => F z.1 z.2) (Icc a b ×ˢ univ) ∧\n    (∀ t ∈ Icc a b, IsPeriodic (u t) ∧ IsPeriodic (p t) ∧ IsPeriodic (F t)) ∧\n    (∀ t ∈ Icc a b, ∀ x, divergenceAt (u t) x = 0) ∧\n    ∀ t ∈ Ioo a b, ∀ x, deriv (fun τ => u τ x) t + advectionAt (u t) x\n      + fractionalPowerAt α (u t) x + gradientAt (p t) x = F t x\n\ndef FracForcedPeriodicIsMild (α : ℝ) : Prop :=\n  ∀ (u : ℝ → Space → Space) (p : ℝ → Space → ℝ) (F : ℝ → Space → Space) (a b : ℝ), a < b →\n    IsFracForcedPeriodicSolution α u p F a b → IsFracTorusForcedMildOnIcc α (fun t => toV (u t)) F a b\n\nend Breakdown.Periodic\n"}