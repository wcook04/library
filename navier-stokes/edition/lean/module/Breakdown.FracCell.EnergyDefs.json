ergy.LowIndex","Breakdown.CellCert.CellEnergy.LowIndex.radialFaceRow","Breakdown.CellCert.CellEnergy.Represents","Breakdown.CellCert.CellEnergy.rowApply","Breakdown.CellCert.CellFormula.radialFaceMoment","Breakdown.Space"],"used_by":[],"uses":["Breakdown.CellCert.CellAnalysis.CellBases","Breakdown.CellCert.CellAnalysis.CellBases.heightPoly","Breakdown.CellCert.CellAnalysis.CellBox","Breakdown.CellCert.CellAnalysis.CellBox.r₁","Breakdown.CellCert.CellAnalysis.gradMode","Breakdown.CellCert.CellAnalysis.radialGradMode","Breakdown.CellCert.CellEnergy.LowIndex","Breakdown.CellCert.CellEnergy.LowIndex.radialFaceRow","Breakdown.CellCert.CellEnergy.Represents","Breakdown.CellCert.CellEnergy.rowApply","Breakdown.CellCert.CellFormula.radialFaceMoment","Breakdown.Space"],"written":"radial_face"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":57,"kind":"def","line":56,"module":"Breakdown.FracCell.EnergyDefs","name":"Breakdown.CellCert.CellEnergy.Represents.height_face","namespace":"Breakdown.CellCert.CellEnergy.Represents","noncomputable":false,"parent":"Breakdown.CellCert.CellEnergy.Represents","private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"height_face","signature_end_line":56,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CellCert.CellAnalysis.CellBases","Breakdown.CellCert.CellAnalysis.CellBases.radialPoly","Breakdown.CellCert.CellAnalysis.CellBox","Breakdown.CellCert.CellAnalysis.gradMode","Breakdown.CellCert.CellAnalysis.heightGradMode","Breakdown.CellCert.CellEnergy.LowIndex","Breakdown.CellCert.CellEnergy.LowIndex.heightFaceRow","Breakdown.CellCert.CellEnergy.Represents","Breakdown.CellCert.CellEnergy.rowApply","Breakdown.CellCert.CellFormula.heightFaceMoment","Breakdown.Space"],"used_by":[],"uses":["Breakdown.CellCert.CellAnalysis.CellBases","Breakdown.CellCert.CellAnalysis.CellBases.radialPoly","Breakdown.CellCert.CellAnalysis.CellBox","Breakdown.CellCert.CellAnalysis.gradMode","Breakdown.CellCert.CellAnalysis.heightGradMode","Breakdown.CellCert.CellEnergy.LowIndex","Breakdown.CellCert.CellEnergy.LowIndex.heightFaceRow","Breakdown.CellCert.CellEnergy.Represents","Breakdown.CellCert.CellEnergy.rowApply","Breakdown.CellCert.CellFormula.heightFaceMoment","Breakdown.Space"],"written":"height_face"}],"imports":["Breakdown.FracCell.FormulaDataDefs","Breakdown.FracCell.StatementDefs"],"module":"Breakdown.FracCell.EnergyDefs","path":"Breakdown/FracCell/EnergyDefs.lean","sha256":"4477fed30d9af5e4ff94441e66febb410dc9fc661e6d70cf8e1496f1f201d532","source":"import Breakdown.FracCell.FormulaDataDefs\nimport Breakdown.FracCell.StatementDefs\n\nopen MeasureTheory Matrix\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace CellCert\n\nnamespace CellEnergy\n\nopen CellAnalysis CellFormula\n\nsection Rows\n\nvariable {D : Type} [Fintype D] [DecidableEq D]\n\ndef rowApply (row : D → ℂ) (u : D → ℂ) : ℂ := ∑ d, row d * u d\n\nend Rows\n\nsection Cell\n\nvariable {D : Type} [Fintype D] [DecidableEq D] {modes : Finset ℤ} {Q q : ℕ}\n  (K : CellBox) (B : CellBases) (I : LowIndex D modes Q q)\n\nend Cell\n\nsection Low\n\nvariable {D : Type} [Fintype D] [DecidableEq D] {modes : Finset ℤ} {Q q : ℕ} (I : LowIndex D modes Q q)\n\nend Low\n\nsection Forms\n\nopen SteadyCert Assembly\n\nvariable {D : Type} [Fintype D] [DecidableEq D] {k N : ℕ} (c : FracCellData k N) (K : CellBox) (B : CellBases)\n  (S : CellScalars) (Cl : CellClasses) {modes : Finset ℤ} {Q q : ℕ} (I : LowIndex D modes Q q)\n\ndef dataVector (u : D → ℂ) (κ ζ : Fin k → ℝ) : D ⊕ (Fin k ⊕ Fin k) → ℂ :=\n  Sum.elim u (Sum.elim (fun i => ((κ i : ℝ) : ℂ)) (fun i => ((ζ i : ℝ) : ℂ)))\n\nend Forms\n\nstructure Represents {D : Type} [Fintype D] [DecidableEq D] {modes : Finset ℤ} {Q q : ℕ}\n    (K : CellBox) (B : CellBases) (I : LowIndex D modes Q q) (m : ℕ) (v : Space → Space)\n    (G : Space → (Space →L[ℝ] Space)) (H : Space → (Space →L[ℝ] Space →L[ℝ] Space)) (u : D → ℂ) : Prop where\n  strain : ∀ n a b j l, u (I.strainSlot n a b j l) = B.coef K (gradMode m n G a b) j l\n  velocity : ∀ n a j l, u (I.velocitySlot n a j l) = B.coef K (fun p => modeVec m n v p.1 p.2 a) j l\n  radial_face : ∀ n e a b l, (e = 0 → K.r₁ ≠ 0) → rowApply (I.radialFaceRow n e a b l) u =\n    radialFaceMoment K (gradMode m n G a b) (radialGradMode m n H a b) e (B.heightPoly l)\n  height_face : ∀ n e a b j, rowApply (I.heightFaceRow n e a b j) u =\n    heightFaceMoment K (gradMode m n G a b) (heightGradMode m n H a b) e (B.radialPoly j)\n\nend CellEnergy\n\nend CellCert\n\nend Breakdown\n"}