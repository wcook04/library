me":"PCP.Lang.BooleanCoefficientList.encode_bits","namespace":"PCP.Lang.BooleanCoefficientList","noncomputable":false,"private":false,"protected":false,"short":"encode_bits","signature_end_line":28,"used_by":["PCP.Lang.BinaryCubicObservation.observe_cost","PCP.Lang.BooleanLabelAddition.add_cost","PCP.Lang.BooleanLabelKernel.evaluate_cost","PCP.Lang.BooleanLabelTransform.embed_cost","PCP.Lang.DerivedPrimary.decode_cost","PCP.Lang.HadamardLabel.decode_cost","PCP.Lang.HadamardLabel.encode_size","PCP.Lang.StandardCorrection.label_cost"],"uses":["PCP.Lang.BooleanCoefficientList.encode"],"written":"encode_bits"},{"dependency_source":"source_text","doc":"Missing coefficients are zero, so the scalar kernel is defined for all stored lists.","end_line":37,"kind":"def","line":34,"module":"PCP.Complexity.BooleanCoefficientList","name":"PCP.Lang.BooleanCoefficientList.terms","namespace":"PCP.Lang.BooleanCoefficientList","noncomputable":false,"private":false,"protected":false,"short":"terms","signature_end_line":34,"used_by":["PCP.Lang.BooleanCoefficientEvaluation.evaluate_run","PCP.Lang.BooleanCoefficientEvaluation.iterate_result","PCP.Lang.BooleanCoefficientList.recoverBits","PCP.Lang.BooleanCoefficientList.terms_eq","PCP.Lang.BooleanCoefficientList.terms_mod_eq","PCP.Lang.BooleanCoefficientList.terms_ofFn","PCP.Lang.BooleanCoefficientList.terms_recover","PCP.Lang.BooleanCoefficientRecoveryLang.body_step","PCP.Lang.BooleanCoefficientRecoveryLang.eval16_run","PCP.Lang.BooleanCoefficientRecoveryLang.iterate_result","PCP.Lang.BooleanCoefficientRecoveryLang.recover_cost","PCP.Lang.BooleanCoefficientRecoveryLang.recover_run"],"uses":["PCP.Lang.BooleanLoops.truth","PCP.Lang.BooleanMaskSubset.Contains"],"written":"terms"},{"dependency_source":"source_text","doc":null,"end_line":46,"kind":"theorem","line":39,"module":"PCP.Complexity.BooleanCoefficientList","name":"PCP.Lang.BooleanCoefficientList.terms_ofFn","namespace":"PCP.Lang.BooleanCoefficientList","noncomputable":false,"private":f