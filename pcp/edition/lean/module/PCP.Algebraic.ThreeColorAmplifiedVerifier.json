unt","PCP.Verifier.SoundAt"],"used_by":["PCP.Algebraic.ThreeColorAmplifiedVerifier.soundAt_encode","PCP.Algebraic.ThreeColorAmplifiedVerifier.verification_guarantees"],"uses":["PCP.Algebraic.ThreeColorAmplifiedVerifier.acceptance_pow_le_half","PCP.Algebraic.ThreeColorAmplifiedVerifier.repetitions","PCP.Algebraic.ThreeColorAmplifiedVerifier.verifier","PCP.Algebraic.ThreeColorCanonicalVerifier.soundAt","PCP.Algebraic.ThreeColorEncoding.graph","PCP.Algebraic.ThreeColorEncoding.vertexCount","PCP.Verifier.SoundAt","PCP.Verifier.repeat_soundAt"],"written":"soundAt"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":"Encoding an ordinary finite graph gives the intended completeness statement.","end_line":63,"kind":"theorem","line":61,"module":"PCP.Algebraic.ThreeColorAmplifiedVerifier","name":"PCP.Algebraic.ThreeColorAmplifiedVerifier.completeAt_encode","namespace":"PCP.Algebraic.ThreeColorAmplifiedVerifier","noncomputable":false,"private":false,"proof_used_by":[],"proof_uses":["PCP.Algebraic.ThreeColorAmplifiedVerifier.completeAt","PCP.Algebraic.ThreeColorEncoding.decode_encode_colorable_iff"],"protected":false,"short":"completeAt_encode","signature_end_line":62,"sorry":false,"statement_used_by":[],"statement_uses":["PCP.Algebraic.ThreeColorAmplifiedVerifier.verifier","PCP.Algebraic.ThreeColorEncoding.encode","PCP.Verifier.CompleteAt"],"used_by":[],"uses":["PCP.Algebraic.ThreeColorAmplifiedVerifier.completeAt","PCP.Algebraic.ThreeColorAmplifiedVerifier.verifier","PCP.Algebraic.ThreeColorEncoding.decode_encode_colorable_iff","PCP.Algebraic.ThreeColorEncoding.encode","PCP.Verifier.CompleteAt"],"written":"completeAt_encode"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":"Encoding an ordinary finite graph gives the intended soundness statement.","end_line":68,"kind":"theorem","line":66,"module":"PCP.Algebraic.ThreeColorAmplifiedVerifier","name":"PCP.Algebraic.ThreeColorAmplifiedVerifier.soundAt_encode","namespace":"PCP.Algebraic.ThreeColorAmplifiedVerifier","noncomputable":false,"private":false,"proof_used_by":[],"proof_uses":["PCP.Algebraic.ThreeColorAmplifiedVerifier.soundAt","PCP.Algebraic.ThreeColorEncoding.decode_encode_colorable_iff"],"protected":false,"short":"soundAt_encode","signature_end_line":67,"sorry":false,"statement_used_by":[],"statement_uses":["PCP.Algebraic.ThreeColorAmplifiedVerifier.verifier","PCP.Algebraic.ThreeColorEncoding.encode","PCP.Verifier.SoundAt"],"used_by":[],"uses":["PCP.Algebraic.ThreeColorAmplifiedVerifier.soundAt","PCP.Algebraic.ThreeColorAmplifiedVerifier.verifier","PCP.Algebraic.ThreeColorEncoding.decode_encode_colorable_iff","PCP.Algebraic.ThreeColorEncoding.encode","PCP.Verifier.SoundAt"],"written":"soundAt_encode"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":"One actual verifier has all mathematical resource and probability properties,\nincluding the standard soundness target. Efficiency and NP transfer are not asserted.","end_line":78,"kind":"theorem","line":72,"module":"PCP.Algebraic.ThreeColorAmplifiedVerifier","name":"PCP.Algebraic.ThreeColorAmplifiedVerifier.verification_guarantees","namespace":"PCP.Algebraic.ThreeColorAmplifiedVerifier","noncomputable":false,"private":false,"proof_used_by":[],"proof_uses":["PCP.Algebraic.ThreeColorAmplifiedVerifier.canonicalRandomness","PCP.Algebraic.ThreeColorAmplifiedVerifier.completeAt","PCP.Algebraic.ThreeColorAmplifiedVerifier.queries_eq","PCP.Algebraic.ThreeColorAmplifiedVerifier.readsBelow","PCP.Algebraic.ThreeColorAmplifiedVerifier.repetitions_pos","PCP.Algebraic.ThreeColorAmplifiedVerifier.soundAt"],"protected":false,"short":"verification_guarantees","signature_end_line":77,"sorry":false,"statement_used_by":[],"statement_uses":["PCP.Algebraic.ThreeColorAmplifiedVerifier.repetitions","PCP.Algebraic.ThreeColorAmplifiedVerifier.verifier","PCP.Algebraic.ThreeColorCanonicalVerifier.proofBound","PCP.Algebraic.ThreeColorEncoding.graph","PCP.Algebraic.ThreeColorEncoding.vertexCount","PCP.Verifier.CanonicalRandomness","PCP.Verifier.CompleteAt","PCP.Verifier.ReadsBelow","PCP.Verifier.SoundAt","PCP.Verifier.queries"],"used_by":["PCP.Algebraic.ComputableThreeColorAmplifiedVerifier.verification_guarantees"],"uses":["PCP.Algebraic.ThreeColorAmplifiedVerifier.canonicalRandomness","PCP.Algebraic.ThreeColorAmplifiedVerifier.completeAt","PCP.Algebraic.ThreeColorAmplifiedVerifier.queries_eq","PCP.Algebraic.ThreeColorAmplifiedVerifier.readsBelow","PCP.Algebraic.ThreeColorAmplifiedVerifier.repetitions","PCP.Algebraic.ThreeColorAmplifiedVerifier.repetitions_pos","PCP.Algebraic.ThreeColorAmplifiedVerifier.soundAt","PCP.Algebraic.ThreeColorAmplifiedVerifier.verifier","PCP.Algebraic.ThreeColorCanonicalVerifier.proofBound","PCP.Algebraic.ThreeColorEncoding.graph","PCP.Algebraic.ThreeColorEncoding.vertexCount","PCP.Verifier.CanonicalRandomness","PCP.Verifier.CompleteAt","PCP.Verifier.ReadsBelow","PCP.Verifier.SoundAt","PCP.Verifier.queries"],"written":"verification_guarantees"}],"imports":["PCP.Algebraic.ThreeColorCanonicalVerifier","PCP.Algebraic.ThreeColorGap","PCP.Algebraic.RationalRepetitionBound","PCP.Verifier.Repetition"],"module":"PCP.Algebraic.ThreeColorAmplifiedVerifier","path":"PCP/Algebraic/ThreeColorAmplifiedVerifier.lean","sha256":"f3447d6eb968b83534637e3ad8590f0c839cacf8c7b436fe3f44c342ecdb272a","source":"/-\nCopyright (c) 2026 Troy Lee. All rights reserved.\nReleased under Apache 2.0 license as described in the file LICENSE.\nAuthors: Troy Lee\n-/\nimport PCP.Algebraic.ThreeColorCanonicalVerifier\nimport PCP.Algebraic.ThreeColorGap\nimport PCP.Algebraic.RationalRepetitionBound\nimport PCP.Verifier.Repetition\n\n/-!\n# Soundness one half for the encoded three-color verifier\n\nA single positive repetition count depends only on the already proved rational\ngap. It gives soundness at most one half while preserving perfect completeness,\na fixed polynomial proof-address bound, and canonical logarithmic randomness.\n\nThis file proves the semantic verifier guarantees. The concrete implementation\nis certified by `PCP.Lang.ThreeColorRuntime.polyTimeAlg`, and\n`PCP.Algebraic.ThreeColorFinalAssembly.of_runtime` combines it with the certified\nNP reduction to obtain the final PCP theorem.\n-/\n\nnamespace PCP.Algebraic.ThreeColorAmplifiedVerifier\n\n/-- A fixed positive repetition count, independent of every input and proof. -/\ndef repetitions : ℕ := RationalRepetitionBound.repetitions ThreeColorBinaryVerifier.gap\n\ntheorem repetitions_pos : 0 < repetitions :=\n  RationalRepetitionBound.repetitions_pos ThreeColorBinaryVerifier.gap_pos\n\ntheorem acceptance_pow_le_half : (1 - ThreeColorBinaryVerifier.gap) ^ repetitions ≤ 1 / 2 :=\n  RationalRepetitionBound.acceptance_pow_le_half ThreeColorBinaryVerifier.gap_pos\n    ThreeColorGap.gap_le_one\n\n/-- The same canonical verifier repeated a fixed number of times on the same proof. -/\nnoncomputable def verifier : Verifier := ThreeColorCanonicalVerifier.verifier.repeat repetitions\n\ntheorem queries_eq : verifier.queries = repetitions * 187 := rfl\n\ntheorem canonicalRandomness :\n    verifier.CanonicalRandomness (repetitions * 32000000) (repetitions * 32000000) :=\n  Verifier.repeat_canonicalRandomness _ _ ThreeColorCanonicalVerifier.canonicalRandomness\n\ntheorem readsBelow (x : List Bool) :\n    verifier.ReadsBelow x (ThreeColorCanonicalVerifier.proofBound.eval x.length) :=\n  Verifier.repeat_readsBelow _ _ _ (ThreeColorCanonicalVerifier.readsBelow x)\n\ntheorem completeAt (x : List Bool) (hx : (ThreeColorEncoding.graph x).Colorable 3) :\n    verifier.CompleteAt x :=\n  Verifier.repeat_completeAt _ _ _ (ThreeColorCanonicalVerifier.completeAt x hx)\n\n/-- Standard constant soundness for every proof oracle. -/\ntheorem soundAt (x : List Bool) (hx : ¬ (ThreeColorEncoding.graph x).Colorable 3) :\n    verifier.SoundAt x (1 / 2) := by\n  have h := Verifier.repeat_soundAt _ repetitions x (ThreeColorCanonicalVerifier.soundAt x hx)\n  intro π\n  exact (h π).trans acceptance_pow_le_half\n\n/-- Encoding an ordinary finite graph gives the intended completeness statement. -/\ntheorem completeAt_encode {N : ℕ} (G : SimpleGraph (Fin N)) [DecidableRel G.Adj]\n    (hG : G.Colorable 3) : verifier.CompleteAt (ThreeColorEncoding.encode G) :=\n  completeAt _ ((ThreeColorEncoding.decode_encode_colorable_iff G 3).mpr hG)\n\n/-- Encoding an ordinary finite graph gives the intended soundness statement. -/\ntheorem soundAt_encode {N : ℕ} (G : SimpleGraph (Fin N)) [DecidableRel G.Adj]\n    (hG : ¬ G.Colorable 3) : verifier.SoundAt (ThreeColorEncoding.encode G) (1 / 2) :=\n  soundAt _ (fun h => hG ((ThreeColorEncoding.decode_encode_colorable_iff G 3).mp h))\n\n/-- One actual verifier has all mathematical resource and probability properties,\nincluding the standard soundness target. Efficiency and NP transfer are not asserted. -/\ntheorem verification_guarantees :\n    0 < repetitions ∧ verifier.queries = repetitions * 187 ∧\n      verifier.CanonicalRandomness (repetitions * 32000000) (repetitions * 32000000) ∧\n      (∀ x, verifier.ReadsBelow x (ThreeColorCanonicalVerifier.proofBound.eval x.length)) ∧\n      (∀ x, (ThreeColorEncoding.graph x).Colorable 3 → verifier.CompleteAt x) ∧\n      (∀ x, ¬ (ThreeColorEncoding.graph x).Colorable 3 → verifier.SoundAt x (1 / 2)) :=\n  ⟨repetitions_pos, queries_eq, canonicalRandomness, readsBelow, completeAt, soundAt⟩\n\nend PCP.Algebraic.ThreeColorAmplifiedVerifier\n"}