ng.ThreeColorBaseDerived.branch_list","namespace":"PCP.Lang.ThreeColorBaseDerived","noncomputable":false,"private":false,"protected":false,"short":"branch_list","signature_end_line":58,"used_by":["PCP.Lang.ThreeColorBaseDerived.program_list","PCP.Lang.ThreeColorBaseDerived.program_run"],"uses":["PCP.Lang.LocalCorrection.Certificate","PCP.Lang.State","PCP.Lang.Stmt.run_rename_list_outside","PCP.Lang.ThreeColorBaseDerived.branch","PCP.Lang.ThreeColorBaseDerived.lists"],"written":"branch_list"},{"dependency_source":"source_text","doc":null,"end_line":70,"kind":"def","line":65,"module":"PCP.Complexity.ThreeColorBaseDerivedState","name":"PCP.Lang.ThreeColorBaseDerived.rawSample","namespace":"PCP.Lang.ThreeColorBaseDerived","noncomputable":false,"private":false,"protected":false,"short":"rawSample","signature_end_line":67,"used_by":["PCP.Lang.ThreeColorBaseDerived.load_input","PCP.Lang.ThreeColorBaseDerived.sample","PCP.Lang.ThreeColorBaseDerived.validSample"],"uses":["PCP.Lang.DerivedGrid.RawSample","PCP.Lang.LocalCorrection.Certificate","PCP.Lang.ThreeColorBaseSeed.sample"],"written":"rawSample"},{"dependency_source":"source_text","doc":null,"end_line":76,"kind":"theorem","line":72,"module":"PCP.Complexity.ThreeColorBaseDerivedState","name":"PCP.Lang.ThreeColorBaseDerived.validSample","namespace":"PCP.Lang.ThreeColorBaseDerived","noncomputable":false,"private":false,"protected":false,"short":"validSample","signature_end_line":73,"used_by":["PCP.Lang.ThreeColorBaseDerived.sample"],"uses":["PCP.Lang.LocalCorrection.Certificate","PCP.Lang.ThreeColorBaseDerived.rawSample","PCP.Lang.ThreeColorBaseSeed.sample"],"written":"validSample"},{"dependency_source":"source_text","doc":null,"end_line":82,"kind":"def","line":78,"module":"PCP.Complexity.ThreeColorBaseDerivedState","name":"PCP.Lang.ThreeColorBaseDerived.sample","namespace":"PCP.Lang.ThreeColorBaseDerived","noncomputable":false,"private":false,"protected":false,"short":"sample","signature_end_line":81,"used_by":["PCP.Lang.ThreeColorBaseBranches.derivedQueries","PCP.Lang.ThreeColorBaseBranches.derivedVerdict","PCP.Lang.ThreeColorBaseBranches.querySegments_eq","PCP.Lang.ThreeColorBaseBranches.weight_eq","PCP.Lang.ThreeColorBaseDerived.branch_run","PCP.Lang.ThreeColorBaseDerived.load_input","PCP.Lang.ThreeColorBaseDerived.program_input_cost","PCP.Lang.ThreeColorBaseDerived.program_run"],"uses":["PCP.Lang.DerivedGrid.Sample","PCP.Lang.LocalCorrection.Certificate","PCP.Lang.ThreeColorBaseDerived.rawSample","PCP.Lang.ThreeColorBaseDerived.validSample","PCP.Lang.ThreeColorBaseSeed.sample"],"written":"sample"}],"imports":["PCP.Complexity.ThreeColorBaseCardinal","PCP.Complexity.ThreeColorBaseSeed","PCP.Complexity.NumericDerivedLang"],"module":"PCP.Complexity.ThreeColorBaseDerivedState","path":"PCP/Complexity/ThreeColorBaseDerivedState.lean","sha256":"d704dce54adfde009f906a92eb396571137f7f8c84953f8bb94366f4574c7f3e","source":"import PCP.Complexity.ThreeColorBaseCardinal\nimport PCP.Complexity.ThreeColorBaseSeed\nimport PCP.Complexity.NumericDerivedLang\n\n/-! # Preserving source words around the larger numeric derived-grid workspace -/\n\nset_option maxRecDepth 1024\n\nnamespace PCP.Lang.ThreeColorBaseDerived\n\nopen PCP.Algebraic ThreeColorParameterChoice ThreeColorParameters ThreeColorFullFieldSampling\n  LocalCorrection DerivedGrid ThreeColorBaseSetup\n\ndef index : Certificate → Fin 7\n  | .valid => 4\n  | .proper => 5\n\ndef factor : Certificate → ℕ\n  | .valid => 1\n  | .proper => 2\n\ndef resultPort : Certificate → Fin 400\n  | .valid => 305\n  | .proper => 306\n\n/-- The three public source words lie in the gap between the callee's work and protected tapes. -/\ndef lists (L : Fin 112) : Fin 128 :=\n  ⟨if L.val < 100 then L.val else L.val+3, by split_ifs <;> omega⟩\n\ntheorem lists_injective : Function.Injective lists := by\n  intro i j h\n  apply Fin.ext\n  have he := congrArg Fin.val h\n  simp only [lists] at he\n  split_ifs at he <;> omega\n\ndef branch (k : Certificate) : Stmt 400 128 :=\n  (NumericDerived.program k).rename (Fin.castLE (by decide)) lists\n\ndef view (st : State 400 128) : State 300 112 :=\n  st.restrict (Fin.castLE (by decide)) lists\n\ntheorem branch_result (k : Certificate) (st : State 400 128) :\n    (view ((branch k).run st).1, ((branch k).run st).2) =\n      (NumericDerived.program k).run (view st) :=\n  (NumericDerived.program k).run_rename _ _ (Fin.castLE_injective _) lists_injective st\n\ntheorem branch_reg (k : Certificate) (st : State 400 128) (i : Fin 400) (hi : 300 ≤ i.val) :\n    ((branch k).run st).1.regs i = st.regs i := by\n  apply Stmt.run_rename_reg_outside\n  intro j hj\n  have := congrArg Fin.val hj\n  simp only [Fin.val_castLE] at this\n  omega\n\ntheorem branch_list (k : Certificate) (st : State 400 128) (L : Fin 128)\n    (hL : 115 ≤ L.val ∨ (100 ≤ L.val ∧ L.val < 103)) :\n    ((branch k).run st).1.lists L = st.lists L := by\n  apply Stmt.run_rename_list_outside\n  intro j hj\n  have := congrArg Fin.val hj\n  simp only [lists] at this\n  split_ifs at this <;> omega\n\ndef rawSample (k : Certificate) (N : ℕ) (bits : List Bool) :\n    DerivedGrid.RawSample k (binaryDimension (exponent N))\n      (size (exponent N)) (size (exponent N)) :=\n  match k with\n  | .valid => ThreeColorBaseSeed.sample N bits 4\n  | .proper => ThreeColorBaseSeed.sample N bits 5\n\ntheorem validSample (k : Certificate) (N : ℕ) (bits : List Bool)\n    (h : Valid (ThreeColorBaseSeed.sample N bits)) : ValidDerived (rawSample k N bits) := by\n  cases k\n  · exact h 4\n  · exact h 5\n\ndef sample (k : Certificate) (N : ℕ) (bits : List Bool)\n    (h : Valid (ThreeColorBaseSeed.sample N bits)) :\n    DerivedGrid.Sample k (binaryDimension (exponent N))\n      (size (exponent N)) (size (exponent N)) :=\n  unpadDerived (rawSample k N bits) (validSample k N bits h)\n\nend PCP.Lang.ThreeColorBaseDerived\n"}