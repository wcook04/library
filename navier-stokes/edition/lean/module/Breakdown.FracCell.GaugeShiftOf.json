rmula.GaugeShiftOf.Internal.negMode_zero","Breakdown.CellCert.CellFormula.IsPressureLayout","Breakdown.CellCert.FracCellData"],"written":"true_real"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":84,"kind":"theorem","line":46,"module":"Breakdown.FracCell.GaugeShiftOf","name":"Breakdown.CellCert.CellFormula.gaugeShiftOf_of","namespace":"Breakdown.CellCert.CellFormula","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CellCert.CellFormula.gaugeShiftOf_holds"],"proof_uses":["Breakdown.CellCert.CellFormula.CellDatum.sidePressure","Breakdown.CellCert.CellFormula.CellLayout.IsGaugeDeleted","Breakdown.CellCert.CellFormula.CellLayout.gaugeJump","Breakdown.CellCert.CellFormula.CellLayout.gaugeShiftOf","Breakdown.CellCert.CellFormula.CellLayout.pressureDatumValue","Breakdown.CellCert.CellFormula.CellLayout.pressureShift","Breakdown.CellCert.CellFormula.CellLayout.rootShifted","Breakdown.CellCert.CellFormula.CellLayout.shiftCoefLeft","Breakdown.CellCert.CellFormula.CellLayout.shiftCoefRight","Breakdown.CellCert.CellFormula.GaugeShiftOf.Internal.pdv_eq","Breakdown.CellCert.CellFormula.GaugeShiftOf.Internal.shift_eq","Breakdown.CellCert.CellFormula.GaugeShiftOf.Internal.true_real","Breakdown.CellCert.CellFormula.IsGaugeSpec.box_ne","Breakdown.CellCert.CellFormula.IsGaugeSpec.deleted_eq","Breakdown.CellCert.CellFormula.IsGaugeSpec.edge_balanced","Breakdown.CellCert.CellFormula.IsGaugeSpec.edge_right_ne","Breakdown.CellCert.CellFormula.IsGaugeSpec.zero_mode"],"protected":false,"short":"gaugeShiftOf_of","signature_end_line":46,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CellCert.CellFormula.ConjugateDataStatement","Breakdown.CellCert.CellFormula.GaugeShiftOfStatement"],"used_by":["Breakdown.CellCert.CellFormula.gaugeShiftOf_holds"],"uses":["Breakdown.CellCert.CellFormula.CellDatum.sidePressure","Breakdown.CellCert.CellFormula.CellLayout.IsGaugeDeleted","Breakdown.CellCert.CellFormula.CellLayout.gaugeJump","Breakdown.CellCert.CellFormula.CellLayout.gaugeShiftOf","Breakdown.CellCert.CellFormula.CellLayout.pressureDatumValue","Breakdown.CellCert.CellFormula.CellLayout.pressureShift","Breakdown.CellCert.CellFormula.CellLayout.rootShifted","Breakdown.CellCert.CellFormula.CellLayout.shiftCoefLeft","Breakdown.CellCert.CellFormula.CellLayout.shiftCoefRight","Breakdown.CellCert.CellFormula.ConjugateDataStatement","Breakdown.CellCert.CellFormula.GaugeShiftOf.Internal.pdv_eq","Breakdown.CellCert.CellFormula.GaugeShiftOf.Internal.shift_eq","Breakdown.CellCert.CellFormula.GaugeShiftOf.Internal.true_real","Breakdown.CellCert.CellFormula.GaugeShiftOfStatement","Breakdown.CellCert.CellFormula.IsGaugeSpec.box_ne","Breakdown.CellCert.CellFormula.IsGaugeSpec.deleted_eq","Breakdown.CellCert.CellFormula.IsGaugeSpec.edge_balanced","Breakdown.CellCert.CellFormula.IsGaugeSpec.edge_right_ne","Breakdown.CellCert.CellFormula.IsGaugeSpec.zero_mode"],"written":"gaugeShiftOf_of"}],"imports":["Breakdown.FracCell.FormulaDataDefs"],"module":"Breakdown.FracCell.GaugeShiftOf","path":"Breakdown/FracCell/GaugeShiftOf.lean","sha256":"0e5c380f4382928a3dbd7060a2a737e2976dec1fe6cf1886e53ab2fb64ab4e5f","source":"import Breakdown.FracCell.FormulaDataDefs\n\nopen MeasureTheory\n\nnoncomputable section\n\nnamespace Breakdown.CellCert.CellFormula\n\nopen SteadyCert Assembly CellAnalysis\n\nnamespace GaugeShiftOf.Internal\n\nvariable (L : CellLayout)\n\ntheorem negMode_zero (n : L.modes) (h : (n : ℤ) = 0) : L.negMode n = n := by\n  unfold CellLayout.negMode\n  have hm : -(n : ℤ) ∈ L.modes := by rw [h, neg_zero, ← h]; exact n.2\n  rw [dif_pos hm]\n  exact Subtype.ext (by simp [h])\n\ntheorem shift_eq {k : ℕ} (left right : FieldTuple k → ℝ) (x : FieldTuple k)\n    (n : L.modes) (s : Fin L.presCount) (j : Fin L.degSide) (h0 : (n : ℤ) = 0) :\n    L.pressureShift (L.gaugeShiftOf left right) x (CellDatum.sidePressure n s j) =\n      ((L.shiftCoefLeft (s, j) * left x + L.shiftCoefRight (s, j) * right x : ℝ) : ℂ) := by\n  simp only [CellLayout.pressureShift, CellDatum.sidePressure, Sum.elim_inl, Sum.elim_inr, if_pos h0]\n  simp only [CellLayout.shiftCoefLeft, CellLayout.shiftCoefRight, CellLayout.gaugeShiftOf]\n  split_ifs <;> push_cast <;> ring\n\ntheorem pdv_eq {k : ℕ} (hz : (0 : ℤ) ∈ L.modes) (x : FieldTuple k) (s : Fin L.presCount) (j : Fin L.degSide) :\n    L.pressureDatumValue x (s, j) = (L.trueData x (CellDatum.sidePressure ⟨0, hz⟩ s j)).re := by\n  simp only [CellLayout.pressureDatumValue, CellLayout.zeroMode, dif_pos hz]\n\ntheorem true_real (hc : ConjugateDataStatement) {k N : ℕ} {c : FracCellData k N} {K : CellBox} {S : CellScalars}\n    {B : CellBases} (hL : IsPressureLayout c K S B L) {x : FieldTuple k} (hx : IsAdmissible c x)\n    (n : L.modes) (h : (n : ℤ) = 0) (s : Fin L.presCount) (j : Fin L.degSide) :\n    L.trueData x (CellDatum.sidePressure n s j) = ((L.trueData x (CellDatum.sidePressure n s j)).re : ℂ) := by\n  have hcj := hc c K S B L hL x hx (CellDatum.sidePressure n s j)\n  have hd : L.conjDatum (CellDatum.sidePressure n s j) = CellDatum.sidePressure n s j := by\n    simp only [CellLayout.conjDatum, CellDatum.sidePressure, Sum.map_inr, Sum.map_inl, negMode_zero L n h]\n  rw [hd] at hcj\n  exact (Complex.conj_eq_iff_re.mp hcj.symm).symm\n\nend GaugeShiftOf.Internal\n\nopen GaugeShiftOf.Internal in\ntheorem gaugeShiftOf_of (hc : ConjugateDataStatement) : GaugeShiftOfStatement := by\n  intro k N c K S B L sp hL hsp left right hlin hedge hroot\n  refine ⟨⟨?_, ?_, ?_⟩, ?_⟩\n  · intro x y a b hx hy\n    obtain ⟨h1, h2⟩ := hlin x y a b hx hy\n    refine ⟨h1, h2, fun r => ?_⟩\n    simp only [CellLayout.gaugeShiftOf]\n    split_ifs\n    · exact h2\n    · exact h1\n  · intro _ x\n    simp only [CellLayout.gaugeShiftOf, if_neg hsp.box_ne]\n  · intro x\n    simp only [CellLayout.gaugeShiftOf, if_true]\n  · intro x hx d hd\n    rcases d with i | i | i | i | ⟨n, s, j⟩ | i | i | i <;>\n      simp only [CellLayout.IsGaugeDeleted, Sum.elim_inl, Sum.elim_inr] at hd\n    obtain ⟨hn0, hmem⟩ := hd\n    have hn : n = ⟨0, hsp.zero_mode⟩ := Subtype.ext hn0\n    subst hn\n    have hshift := shift_eq L left right x ⟨0, hsp.zero_mode⟩ s j rfl\n    have hreal := true_real L hc hL hx ⟨0, hsp.zero_mode⟩ rfl s j\n    have hpdv := pdv_eq L hsp.zero_mode x s j\n    change L.trueData x (CellDatum.sidePressure _ s j) +\n      L.pressureShift (L.gaugeShiftOf left right) x (CellDatum.sidePressure _ s j) = 0\n    rw [hshift, hreal, ← hpdv, ← Complex.ofReal_add, Complex.ofReal_eq_zero]\n    rcases (hsp.deleted_eq (s, j)).mp hmem with he | hr\n    · have hb := hsp.edge_balanced _ he\n      have hne := hsp.edge_right_ne _ he\n      have hj := hedge _ he x hx\n      have hg : L.gaugeJump sp x = -(L.pressureDatumValue x (s, j)) / L.shiftCoefRight (s, j) := by\n        simp only [CellLayout.gaugeJump, he]\n      have hl : L.shiftCoefLeft (s, j) = -L.shiftCoefRight (s, j) := by linarith\n      rw [hj, hg, hl]\n      field_simp\n      ring\n    · have hz := hroot _ hr x hx\n      unfold CellLayout.rootShifted at hz\n      linarith\n\nend Breakdown.CellCert.CellFormula\n"}