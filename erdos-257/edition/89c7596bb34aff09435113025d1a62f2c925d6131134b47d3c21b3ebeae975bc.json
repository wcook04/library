ction=consumers&assumptions=true","direct_passages":"/api/v1/papers/query?manifest=8634d96f2643f13a5df640f66e9affa4d4ccfe6fd956bfdc981e788a24eac460&node=short.thm-variable-fractional-cover&relation=direct","prerequisite_uses":"/api/v1/papers/query?manifest=8634d96f2643f13a5df640f66e9affa4d4ccfe6fd956bfdc981e788a24eac460&node=short.thm-variable-fractional-cover&relation=prerequisites","prerequisites":"/api/v1/graph?manifest=8634d96f2643f13a5df640f66e9affa4d4ccfe6fd956bfdc981e788a24eac460&view=arguments&node=short.thm-variable-fractional-cover&assumptions=true"},"neighborhood_href":"/api/v1/neighborhood?manifest=8634d96f2643f13a5df640f66e9affa4d4ccfe6fd956bfdc981e788a24eac460&ref=sha256%3A57133a32273c39019ea3f4ba3de79281b7177858848a9345731e250a68a8c176%2Fnodes%2Fshort.thm-variable-fractional-cover","record":{"assumption_ids":[],"boundary":"The evidence mapping records a Lean proof of exactly this statement. The evidence mapping records a Lean statement that implies the printed one. Lean status per paper is kept in authored/evidence-status.json.","citation_ids":["cite.long.thm-257-variable-fractional-cover","cite.short.thm-variable-fractional-cover"],"evidence_ids":["mapping.short.thm-variable-fractional-cover"],"id":"short.thm-variable-fractional-cover","kind":"goal","label":"Theorem 3.1 (a summable divisor-cover criterion)","locator":"Short paper Theorem 3.1, p. 6, label thm:variable-fractional-cover; Long record Theorem 1.3, p. 16, label thm:257-variable-fractional-cover","source_id":"paper.short.pdf","statement":"*For each $j\\ge1$, let $F_j\\subseteq\\mathbb{N}_{>0}$ be finite, let $0<\\alpha_j\\le1$, and let $c_{j,d}\\ge0$ satisfy\n$$\nf_{F_j}(n)^{\\alpha_j}\\le\\sum_{d\\mid n}c_{j,d}\\quad(n\\ge1).\n$$\nSet $C_j=\\sum_{d\\ge1}c_{j,d}/d$. If\n$$\n\n \\sum_{j\\ge1}\\frac{C_j2^{j\\alpha_j}}{2^{\\alpha_j}-1}<\\infty,\n \\tag{V}\n$$\nthen $X_A(b)$ is irrational for every infinite $A\\subseteq\\bigcup_jF_j$ and every integer $b\\ge2$.*","status":"unverified"},"ref":"s