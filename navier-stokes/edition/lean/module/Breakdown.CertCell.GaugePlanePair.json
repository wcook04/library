nternal.PlaneTraceFacts"],"written":"flip"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":88,"kind":"theorem","line":31,"module":"Breakdown.CertCell.GaugePlanePair","name":"Breakdown.CertCell.TreeEntry.fieldPlanePairZero_of","namespace":"Breakdown.CertCell.TreeEntry","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CertCell.fieldGauge_closed"],"proof_uses":["Breakdown.CertCell.GaugeKey.KeyInHalfPlane","Breakdown.CertCell.GaugeKey.keyMode","Breakdown.CertCell.GaugeKey.planeSign","Breakdown.CertCell.PlanePairInternal.PlaneTraceFacts.square","Breakdown.CertCell.PlanePairInternal.corner_key_conj","Breakdown.CertCell.PlanePairInternal.gradient_key_conj","Breakdown.CertCell.PlanePairInternal.keyHarmonic_at_zero","Breakdown.CertCell.PlanePairInternal.keyPart_zero_of_conj","Breakdown.CertCell.PlanePairInternal.pressure_key_conj","Breakdown.CertCell.PlanePairInternal.velocity_key_conj","Breakdown.CertCell.TreeEntry.keyLayout","Breakdown.CertCell.labelTime"],"protected":false,"short":"fieldPlanePairZero_of","signature_end_line":31,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CertCell.CellCalculus.CellCalculusEntry","Breakdown.CertCell.CellLayerData","Breakdown.CertCell.PlanePairInternal.PlaneTraceFacts","Breakdown.CertCell.TreeEntry","Breakdown.CertCell.TreeEntry.FieldPlanePairZero"],"used_by":["Breakdown.CertCell.fieldGauge_closed"],"uses":["Breakdown.CertCell.CellCalculus.CellCalculusEntry","Breakdown.CertCell.CellLayerData","Breakdown.CertCell.GaugeKey.KeyInHalfPlane","Breakdown.CertCell.GaugeKey.keyMode","Breakdown.CertCell.GaugeKey.planeSign","Breakdown.CertCell.PlanePairInternal.PlaneTraceFacts","Breakdown.CertCell.PlanePairInternal.PlaneTraceFacts.square","Breakdown.CertCell.PlanePairInternal.corner_key_conj","Breakdown.CertCell.PlanePairInternal.gradient_key_conj","Breakdown.CertCell.PlanePairInternal.keyHarmonic_at_zero","Breakdown.CertCell.PlanePairInternal.keyPart_zero_of_conj","Breakdown.CertCell.PlanePairInternal.pressure_key_conj","Breakdown.CertCell.PlanePairInternal.velocity_key_conj","Breakdown.CertCell.TreeEntry","Breakdown.CertCell.TreeEntry.FieldPlanePairZero","Breakdown.CertCell.TreeEntry.keyLayout","Breakdown.CertCell.labelTime"],"written":"fieldPlanePairZero_of"}],"imports":["Breakdown.CertCell.GaugePlanePairKeys"],"module":"Breakdown.CertCell.GaugePlanePair","path":"Breakdown/CertCell/GaugePlanePair.lean","sha256":"0b8315982f052b8aedeed3088515b39c3eba8b159ea1e692fde8d788c2dec6c0","source":"import Breakdown.CertCell.GaugePlanePairKeys\n\nopen MeasureTheory ComplexConjugate\n\nnoncomputable section\n\nnamespace Breakdown.CertCell\n\nnamespace PlanePairInternal\n\nopen PlaneFlipFacts\n\nstructure PlaneTraceFacts : Prop where\n  lift : CellCalculus.HarmonicLiftStatement\n  second : PeriodicSecondOrderHolds\n  strip : StripDataFlipAxisHolds\n  corner : CornerDataFlipAxisHolds\n  pressure : PressureStripFlipHolds\n  shift : PotentialShiftHolds\n  square : HarmonicPressureSquareHolds\n  flip : HarmonicPressureFlipHolds\n\nend PlanePairInternal\n\nnamespace TreeEntry\n\nopen CellCert.CellCoordinates PlanePairInternal\n\nvariable {k : ℕ} {C : Type} {nE nM : ℕ} {D : CellLayerData k C nE nM} {R : CellCalculus.CellCalculusEntry D}\n\ntheorem fieldPlanePairZero_of (hF : PlaneTraceFacts) (T : TreeEntry D R) : T.FieldPlanePairZero := by\n  intro q v G H g Pg hyp ι key imag hom hhalf\n  obtain ⟨-, hmc, hp, hPP, hPf⟩ := hyp\n  obtain ⟨h12, hl, hmode, hsign⟩ := hom\n  have ht : labelTime ι = 0 := by simp only [labelTime]; omega\n  rw [ht, keyHarmonic_at_zero]\n  cases key with\n  | velocity n rad lev lo hi t a d =>\n      have hn : n = 2 * ι.2 := by simp only [GaugeKey.keyMode, Option.some.injEq] at hmode; omega\n      subst hn\n      by_cases hc : rad = false ∧ lev = 0\n      · obtain ⟨rfl, rfl⟩ := hc\n        simp only [GaugeKey.planeSign, true_and, if_true, Option.some.injEq] at hsign\n        simp only [GaugeKey.KeyInHalfPlane, Bool.false_eq_true, if_false] at hhalf\n        exact keyPart_zero_of_conj (velocity_key_conj hF.lift hF.second Pg hp hmc.flip T.keyLayout ι.2 hF.strip\n          hi t a d hhalf) hsign\n      · exfalso\n        simp [GaugeKey.planeSign, hc] at hsign\n  | gradient n rad lev lo hi t a d =>\n      have hn : n = 2 * ι.2 := by simp only [GaugeKey.keyMode, Option.some.injEq] at hmode; omega\n      subst hn\n      by_cases hc : rad = false ∧ lev = 0\n      · obtain ⟨rfl, rfl⟩ := hc\n        simp only [GaugeKey.planeSign, true_and, if_true, Option.some.injEq] at hsign\n        simp only [GaugeKey.KeyInHalfPlane, Bool.false_eq_true, if_false] at hhalf\n        exact keyPart_zero_of_conj (gradient_key_conj hF.lift hF.second Pg hp hmc.flip T.keyLayout ι.2 hF.strip\n          hi t a d hhalf) hsign\n      · exfalso\n        simp [GaugeKey.planeSign, hc] at hsign\n  | pressure n rad lev lo hi t d =>\n      by_cases hc : rad = false ∧ lev = 0\n      · obtain ⟨rfl, rfl⟩ := hc\n        simp only [GaugeKey.planeSign, true_and, if_true, Option.some.injEq] at hsign\n        simp only [GaugeKey.KeyInHalfPlane, Bool.false_eq_true, if_false] at hhalf\n        refine keyPart_zero_of_conj (s := 1) ?_ (hsign.imp_left fun h => ⟨rfl, h⟩)\n        rw [Complex.ofReal_one, one_mul]\n        exact pressure_key_conj hF.pressure hF.shift hF.square hF.flip hPP hPf T.keyLayout n hi t d hhalf\n      · exfalso\n        simp [GaugeKey.planeSign, hc] at hsign\n  | corner n p a =>\n      have hn : n = 2 * ι.2 := by simp only [GaugeKey.keyMode, Option.some.injEq] at hmode; omega\n      subst hn\n      obtain ⟨pr, pz⟩ := p\n      by_cases hc : pz = 0\n      · subst hc\n        simp only [GaugeKey.planeSign, if_true, Option.some.injEq] at hsign\n        simp only [GaugeKey.KeyInHalfPlane] at hhalf\n        exact keyPart_zero_of_conj (corner_key_conj hF.lift hF.second Pg hp hmc.flip T.keyLayout ι.2 hF.corner a\n          hhalf) hsign\n      · exfalso\n        simp [GaugeKey.planeSign, hc] at hsign\n  | stream p =>\n      exfalso\n      simp only [GaugeKey.keyMode, Option.some.injEq] at hmode\n      omega\n  | private_ =>\n      exfalso\n      simp [GaugeKey.keyMode] at hmode\n\nend TreeEntry\n\nend Breakdown.CertCell\n\n"}