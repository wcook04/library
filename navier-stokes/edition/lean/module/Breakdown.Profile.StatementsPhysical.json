oof_used_by":[],"proof_uses":[],"protected":false,"short":"PhysicalDifference","signature_end_line":37,"sorry":false,"statement_used_by":["Breakdown.physicalDifference_holds","Breakdown.physicalL2_holds"],"statement_uses":["Breakdown.IsSimilarityProfile","Breakdown.Space","Breakdown.physicalField"],"used_by":["Breakdown.physicalDifference_holds","Breakdown.physicalL2_holds"],"uses":["Breakdown.IsSimilarityProfile","Breakdown.Space","Breakdown.physicalField"],"written":"PhysicalDifference"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":49,"kind":"def","line":42,"module":"Breakdown.Profile.StatementsPhysical","name":"Breakdown.PhysicalL2","namespace":"Breakdown","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"PhysicalL2","signature_end_line":42,"sorry":false,"statement_used_by":["Breakdown.physicalL2_holds","Breakdown.physicalMild_holds"],"statement_uses":["Breakdown.IsSimilarityProfile","Breakdown.Space","Breakdown.physicalField"],"used_by":["Breakdown.physicalL2_holds","Breakdown.physicalMild_holds"],"uses":["Breakdown.IsSimilarityProfile","Breakdown.Space","Breakdown.physicalField"],"written":"PhysicalL2"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":57,"kind":"def","line":51,"module":"Breakdown.Profile.StatementsPhysical","name":"Breakdown.PhysicalPairingDeriv","namespace":"Breakdown","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"PhysicalPairingDeriv","signature_end_line":51,"sorry":false,"statement_used_by":["Breakdown.physicalPairingDeriv_holds","Breakdown.physicalWeak_holds"],"statement_uses":["Breakdown.IsSimilarityProfile","Breakdown.IsTestField","Breakdown.Space","Breakdown.advectionAt","Breakdown.fieldPairing","Breakdown.gradientAt","Breakdown.physicalField","Breakdown.physicalPressure","Breakdown.sumSecondPartialsAt"],"used_by":["Breakdown.physicalPairingDeriv_holds","Breakdown.physicalWeak_holds"],"uses":["Breakdown.IsSimilarityProfile","Breakdown.IsTestField","Breakdown.Space","Breakdown.advectionAt","Breakdown.fieldPairing","Breakdown.gradientAt","Breakdown.physicalField","Breakdown.physicalPressure","Breakdown.sumSecondPartialsAt"],"written":"PhysicalPairingDeriv"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":64,"kind":"def","line":59,"module":"Breakdown.Profile.StatementsPhysical","name":"Breakdown.PhysicalWeak","namespace":"Breakdown","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"PhysicalWeak","signature_end_line":59,"sorry":false,"statement_used_by":["Breakdown.physicalMild_holds","Breakdown.physicalWeak_holds"],"statement_uses":["Breakdown.IsSimilarityProfile","Breakdown.IsTestField","Breakdown.Space","Breakdown.advectionPairing","Breakdown.fieldPairing","Breakdown.gradientPairing","Breakdown.physicalField"],"used_by":["Breakdown.physicalMild_holds","Breakdown.physicalWeak_holds"],"uses":["Breakdown.IsSimilarityProfile","Breakdown.IsTestField","Breakdown.Space","Breakdown.advectionPairing","Breakdown.fieldPairing","Breakdown.gradientPairing","Breakdown.physicalField"],"written":"PhysicalWeak"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":71,"kind":"def","line":66,"module":"Breakdown.Profile.StatementsPhysical","name":"Breakdown.PhysicalMild","namespace":"Breakdown","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"PhysicalMild","signature_end_line":66,"sorry":false,"statement_used_by":["Breakdown.EmbeddedOrbitOfParts","Breakdown.OrbitOfParts","Breakdown.physicalMild_holds","Breakdown.physicalMild_unconditional"],"statement_uses":["Breakdown.IsSimilarityProfile","Breakdown.MildFramework.IsMildOnIcc","Breakdown.Realization","Breakdown.Realization.F","Breakdown.Realization.embed","Breakdown.Space","Breakdown.physicalField"],"used_by":["Breakdown.EmbeddedOrbitOfParts","Breakdown.OrbitOfParts","Breakdown.physicalMild_holds","Breakdown.physicalMild_unconditional"],"uses":["Breakdown.IsSimilarityProfile","Breakdown.MildFramework.IsMildOnIcc","Breakdown.Realization","Breakdown.Realization.F","Breakdown.Realization.embed","Breakdown.Space","Breakdown.physicalField"],"written":"PhysicalMild"}],"imports":["Breakdown.Profile.StatementsSlice"],"module":"Breakdown.Profile.StatementsPhysical","path":"Breakdown/Profile/StatementsPhysical.lean","sha256":"cc3de9ab19691e18e77500276a2b6a17ba42b20c063114401ec4d52bb7783720","source":"import Breakdown.Profile.StatementsSlice\n\nopen scoped ContDiff\nopen MeasureTheory Set Real\n\nnoncomputable section\n\nnamespace Breakdown\n\ndef physicalScale (t : ℝ) : ℝ := Real.sqrt ((1 - t)⁻¹)\n\ndef physicalTime (s₀ t : ℝ) : ℝ := s₀ - Real.log (1 - t)\n\ndef physicalField (W : ℝ → Space → Space) (s₀ t : ℝ) : Space → Space :=\n  dilateField ((1 - t)⁻¹) (W (physicalTime s₀ t))\n\ndef physicalPressure (q : ℝ → Space → ℝ) (s₀ t : ℝ) : Space → ℝ :=\n  fun x => (1 - t)⁻¹ * q (physicalTime s₀ t) (physicalScale t • x)\n\ndef PhysicalTimeDeriv : Prop :=\n  ∀ W : ℝ → Space → Space, ContDiff ℝ ∞ (fun z : ℝ × Space => W z.1 z.2) →\n    ∀ s₀ t : ℝ, t < 1 → ∀ x : Space,\n      HasDerivAt (fun τ => physicalField W s₀ τ x)\n        (physicalScale t ^ 3 •\n          (deriv (fun σ => W σ (physicalScale t • x)) (physicalTime s₀ t)\n            + (1 / 2 : ℝ) • W (physicalTime s₀ t) (physicalScale t • x)\n            + (1 / 2 : ℝ) • fderiv ℝ (W (physicalTime s₀ t)) (physicalScale t • x)\n                (physicalScale t • x))) t\n\ndef PhysicalMomentum : Prop :=\n  ∀ (W : ℝ → Space → Space) (q : ℝ → Space → ℝ) (C : ℝ), IsSimilarityProfile W q C →\n    ∀ s₀ t : ℝ, t < 1 → ∀ x : Space,\n      HasDerivAt (fun τ => physicalField W s₀ τ x)\n        (sumSecondPartialsAt (physicalField W s₀ t) x - advectionAt (physicalField W s₀ t) x\n          - gradientAt (physicalPressure q s₀ t) x) t\n\ndef PhysicalDifference : Prop :=\n  ∀ (W : ℝ → Space → Space) (q : ℝ → Space → ℝ) (C : ℝ), IsSimilarityProfile W q C →\n    ∀ s₀ T : ℝ, T < 1 → ∃ K : ℝ, ∀ t ∈ Icc 0 T, ∀ t' ∈ Icc 0 T, ∀ x : Space,\n      ‖physicalField W s₀ t x - physicalField W s₀ t' x‖ ≤ K * |t - t'| / (1 + ‖x‖) ^ 3\n\ndef PhysicalL2 : Prop :=\n  ∀ (W : ℝ → Space → Space) (q : ℝ → Space → ℝ) (C : ℝ), IsSimilarityProfile W q C →\n    ∀ s₀ T : ℝ, T < 1 →\n      (∀ t ∈ Icc 0 T, ∀ t' ∈ Icc 0 T,\n        Integrable (fun x => ‖physicalField W s₀ t x - physicalField W s₀ t' x‖ ^ 2)) ∧\n      (∀ t₀ ∈ Icc 0 T, Filter.Tendsto\n        (fun t => ∫ x, ‖physicalField W s₀ t x - physicalField W s₀ t₀ x‖ ^ 2)\n        (nhdsWithin t₀ (Icc 0 T)) (nhds 0))\n\ndef PhysicalPairingDeriv : Prop :=\n  ∀ (W : ℝ → Space → Space) (q : ℝ → Space → ℝ) (C : ℝ), IsSimilarityProfile W q C →\n    ∀ s₀ t : ℝ, t < 1 → ∀ φ, IsTestField φ →\n      HasDerivAt (fun τ => fieldPairing (physicalField W s₀ τ) φ)\n        (∫ x, inner ℝ (sumSecondPartialsAt (physicalField W s₀ t) x\n          - advectionAt (physicalField W s₀ t) x\n          - gradientAt (physicalPressure q s₀ t) x) (φ x)) t\n\ndef PhysicalWeak : Prop :=\n  ∀ (W : ℝ → Space → Space) (q : ℝ → Space → ℝ) (C : ℝ), IsSimilarityProfile W q C →\n    ∀ s₀ t : ℝ, t < 1 → ∀ φ, IsTestField φ →\n      HasDerivAt (fun τ => fieldPairing (physicalField W s₀ τ) φ)\n        (-gradientPairing (physicalField W s₀ t) φ\n          - advectionPairing (physicalField W s₀ t) φ) t\n\ndef PhysicalMild : Prop :=\n  ∀ (X : Type) [NormedAddCommGroup X] [InnerProductSpace ℝ X] [CompleteSpace X]\n    (Rlz : Realization X) (W : ℝ → Space → Space) (q : ℝ → Space → ℝ) (C : ℝ),\n    IsSimilarityProfile W q C → Continuous (fun s => Rlz.embed (W s)) →\n    ∀ s₀ T : ℝ, 0 < T → T < 1 →\n      Rlz.F.IsMildOnIcc (fun t => Rlz.embed (physicalField W s₀ t)) 0 T\n\nend Breakdown\n"}