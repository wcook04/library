kdown.WeakProfile.VarConstGood","Breakdown.WeakProfile.VarConstInner"],"statement_uses":["Breakdown.Freq.CSpace","Breakdown.Freq.IsSspOf","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Space","Breakdown.WeakProfile.sspRate"],"used_by":["Breakdown.WeakProfile.GoodTimes","Breakdown.WeakProfile.IsGoodSet.null","Breakdown.WeakProfile.IsGoodSet.sub","Breakdown.WeakProfile.IsGoodSet.weak","Breakdown.WeakProfile.VarConstGood","Breakdown.WeakProfile.VarConstInner"],"uses":["Breakdown.Freq.CSpace","Breakdown.Freq.IsSspOf","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Space","Breakdown.WeakProfile.sspRate"],"written":"IsGoodSet"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":55,"kind":"def","line":55,"module":"Breakdown.Weak.Basic","name":"Breakdown.WeakProfile.IsGoodSet.sub","namespace":"Breakdown.WeakProfile.IsGoodSet","noncomputable":false,"parent":"Breakdown.WeakProfile.IsGoodSet","private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"sub","signature_end_line":55,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.Freq.CSpace","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Space","Breakdown.WeakProfile.IsGoodSet"],"used_by":[],"uses":["Breakdown.Freq.CSpace","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Space","Breakdown.WeakProfile.IsGoodSet"],"written":"sub"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":56,"kind":"def","line":56,"module":"Breakdown.Weak.Basic","name":"Breakdown.WeakProfile.IsGoodSet.null","namespace":"Breakdown.WeakProfile.IsGoodSet","noncomputable":false,"parent":"Breakdown.WeakProfile.IsGoodSet","private":false,"proof_used_by":["Breakdown.WeakProfile.localMild","Breakdown.WeakProfile.varConstInner_holds"],"proof_uses":[],"protected":false,"short":"null","signature_end_line":56,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.Freq.CSpace","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Space","Breakdown.WeakProfile.IsGoodSet"],"used_by":["Breakdown.WeakProfile.localMild","Breakdown.WeakProfile.varConstInner_holds"],"uses":["Breakdown.Freq.CSpace","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Space","Breakdown.WeakProfile.IsGoodSet"],"written":"null"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":59,"kind":"def","line":57,"module":"Breakdown.Weak.Basic","name":"Breakdown.WeakProfile.IsGoodSet.weak","namespace":"Breakdown.WeakProfile.IsGoodSet","noncomputable":false,"parent":"Breakdown.WeakProfile.IsGoodSet","private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"weak","signature_end_line":57,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.Freq.CSpace","Breakdown.Freq.IsSspOf","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Space","Breakdown.WeakProfile.IsGoodSet","Breakdown.WeakProfile.sspRate"],"used_by":[],"uses":["Breakdown.Freq.CSpace","Breakdown.Freq.IsSspOf","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Space","Breakdown.WeakProfile.IsGoodSet","Breakdown.WeakProfile.sspRate"],"written":"weak"}],"imports":["Breakdown.Defs","Breakdown.FreqTr.Realization"],"module":"Breakdown.Weak.Basic","path":"Breakdown/Weak/Basic.lean","sha256":"0fb4439697c277c57414476502542266f2946dd61d37116f954f9f02d593774a","source":"import Breakdown.Defs\nimport Breakdown.FreqTr.Realization\n\nopen MeasureTheory Set Real\nopen scoped ENNReal ContDiff\n\nnoncomputable section\n\nnamespace Breakdown.WeakProfile\n\nopen Freq\n\ndef spaceScale (b : ℝ) (φ : Space → Space) : Space → Space := fun y => φ (b • y)\n\ndef gradComponent (g : Space → (Space →L[ℝ] Space)) (j : Fin 3) : Space → Space :=\n  fun y => g y (unitVector j)\n\ndef similarityScale (s₀ σ : ℝ) : ℝ := Real.exp (-(σ - s₀) / 2)\n\ndef physicalCurve (x : ℝ → X) (s₀ t : ℝ) : X := dilX (1 - t)⁻¹ (x (s₀ - Real.log (1 - t)))\n\ndef scaledTest (α : ℝ → ℝ) (s₀ : ℝ) (φ : Space → Space) : ℝ → Space → Space :=\n  fun σ y => (α σ * similarityScale s₀ σ ^ 2) • negSsp φ (similarityScale s₀ σ • y)\n\ndef weakRate (u : X) (φ : Space → Space) : ℝ :=\n  inner ℝ u (embedX (negSsp φ)) + trilinear u u (negSsp φ)\n\ndef sspRate (u h : X) : ℝ := inner ℝ u h + trilinear u u (velocity h)\n\ndef similarityRate (x : ℝ → X) (α : ℝ → ℝ) (s₀ : ℝ) (φ : Space → Space) (σ : ℝ) : ℝ :=\n  -deriv α σ * inner ℝ (x σ) (embedX (spaceScale (similarityScale s₀ σ) φ)) +\n    α σ * weakRate (x σ) (spaceScale (similarityScale s₀ σ) φ)\n\ndef varConst (y : ℝ → X) (t₀ t : ℝ) : X :=\n  heatX (t - t₀) (y t₀) + ∫ τ in t₀..t, bilinX (t - τ) (y τ) (y τ)\n\nstructure IsSlice (f : Space → Space) (g : Space → (Space →L[ℝ] Space)) (C : ℝ) : Prop where\n  grad : IsWeakGradient f g\n  div : ∀ᵐ y, ∑ i : Fin 3, (g y (unitVector i)) i = 0\n  six : ∫⁻ y, ENNReal.ofReal (‖f y‖ ^ 6) ≤ ENNReal.ofReal C\n  two : ∫⁻ y, ENNReal.ofReal (‖g y‖ ^ 2) ≤ ENNReal.ofReal C\n\nstructure IsSliceCurve (x : ℝ → X) (W : ℝ → Space → Space)\n    (G : ℝ → Space → (Space →L[ℝ] Space)) (M : ℝ) : Prop where\n  vel : ∀ s, (velocity (x s) : Space → Space) =ᵐ[volume] W s\n  part : ∀ s j, (partialX j (x s) : Space → Space) =ᵐ[volume] gradComponent (G s) j\n  bound : ∀ s, ‖x s‖ ≤ M\n\ndef IsTensorWeak (y : ℝ → X) (l r : ℝ) : Prop :=\n  ∀ (θ : ℝ → ℝ) (φ : Space → Space), ContDiff ℝ ∞ θ → HasCompactSupport θ →\n    tsupport θ ⊆ Ioo l r → IsTestField φ →\n      ∫ t, deriv θ t * inner ℝ (y t) (embedX φ) = ∫ t, θ t * weakRate (y t) φ\n\nstructure IsGoodSet (y : ℝ → X) (l r : ℝ) (E : Set ℝ) : Prop where\n  sub : E ⊆ Ioo l r\n  null : volume (Ioo l r \\ E) = 0\n  weak : ∀ s ∈ E, ∀ t ∈ E, s ≤ t → ∀ χ h : X, IsSspOf χ h →\n    IntervalIntegrable (fun τ => sspRate (y τ) h) volume s t ∧\n      inner ℝ (y t) χ - inner ℝ (y s) χ = -∫ τ in s..t, sspRate (y τ) h\n\nend Breakdown.WeakProfile\n"}