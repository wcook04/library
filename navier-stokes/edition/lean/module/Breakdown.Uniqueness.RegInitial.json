Vec","Breakdown.IsTestField","Breakdown.SmoothFlow.contDiff_complexifyComp","Breakdown.SmoothFlow.fderiv_complexifyComp","Breakdown.SmoothFlow.hasCompactSupport_complexifyComp","Breakdown.SmoothFlow.symbolOf","Breakdown.SmoothFlow.testRapid","Breakdown.SmoothFlow.traceMap","Breakdown.SmoothFlow.traceMap_apply","Breakdown.Space","Breakdown.divergenceAt","Breakdown.unitVector"],"written":"divergence_symbolOf"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":99,"kind":"theorem","line":97,"module":"Breakdown.Uniqueness.RegInitial","name":"Breakdown.SmoothFlow.isSolenoidalSymbol_symbolOf","namespace":"Breakdown.SmoothFlow","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.SmoothFlow.mildRegular_of_freq","Breakdown.fracMildRegular_of"],"proof_uses":["Breakdown.SmoothFlow.divergence_symbolOf","Breakdown.SmoothFlow.freqTr_neg_complexify"],"protected":false,"short":"isSolenoidalSymbol_symbolOf","signature_end_line":98,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.IsTestField","Breakdown.SmoothFlow.IsSolenoidalSymbol","Breakdown.SmoothFlow.symbolOf","Breakdown.Space"],"used_by":["Breakdown.SmoothFlow.mildRegular_of_freq","Breakdown.fracMildRegular_of"],"uses":["Breakdown.IsTestField","Breakdown.SmoothFlow.IsSolenoidalSymbol","Breakdown.SmoothFlow.divergence_symbolOf","Breakdown.SmoothFlow.freqTr_neg_complexify","Breakdown.SmoothFlow.symbolOf","Breakdown.Space"],"written":"isSolenoidalSymbol_symbolOf"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":102,"kind":"theorem","line":101,"module":"Breakdown.Uniqueness.RegInitial","name":"Breakdown.SmoothFlow.hasTemperateGrowth_hsWeight","namespace":"Breakdown.SmoothFlow","noncomputable":false,"noncomputable_section":true,"private":true,"proof_used_by":["Breakdown.SmoothFlow.hsNormSq_symbolOf_lt_top"],"proof_uses":[],"protected":false,"short":"hasTemperateGrowth_hsWeight","signature_end_line":101,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.SmoothFlow.hsWeight","Breakdown.Space"],"used_by":["Breakdown.SmoothFlow.hsNormSq_symbolOf_lt_top"],"uses":["Breakdown.SmoothFlow.hsWeight","Breakdown.Space"],"written":"hasTemperateGrowth_hsWeight"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":123,"kind":"theorem","line":104,"module":"Breakdown.Uniqueness.RegInitial","name":"Breakdown.SmoothFlow.hsNormSq_symbolOf_lt_top","namespace":"Breakdown.SmoothFlow","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.SmoothFlow.hsNormSq_symbolOf_all","Breakdown.embedX_physField_eq_of_powerFlow","Breakdown.fracMildRegular_of"],"proof_uses":["Breakdown.Freq.CSpace","Breakdown.SmoothFlow.hasTemperateGrowth_hsWeight","Breakdown.SmoothFlow.hsWeight","Breakdown.SmoothFlow.symbolOf_eq_freqTr","Breakdown.SmoothFlow.testSymbol"],"protected":false,"short":"hsNormSq_symbolOf_lt_top","signature_end_line":105,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.IsTestField","Breakdown.SmoothFlow.hsNormSq","Breakdown.SmoothFlow.symbolOf","Breakdown.Space"],"used_by":["Breakdown.SmoothFlow.hsNormSq_symbolOf_all","Breakdown.embedX_physField_eq_of_powerFlow","Breakdown.fracMildRegular_of"],"uses":["Breakdown.Freq.CSpace","Breakdown.IsTestField","Breakdown.SmoothFlow.hasTemperateGrowth_hsWeight","Breakdown.SmoothFlow.hsNormSq","Breakdown.SmoothFlow.hsWeight","Breakdown.SmoothFlow.symbolOf","Breakdown.SmoothFlow.symbolOf_eq_freqTr","Breakdown.SmoothFlow.testSymbol","Breakdown.Space"],"written":"hsNormSq_symbolOf_lt_top"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":134,"kind":"theorem","line":125,"module":"Breakdown.Uniqueness.RegInitial","name":"Breakdown.SmoothFlow.physField_symbolOf","namespace":"Breakdown.SmoothFlow","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.SmoothFlow.embedX_physField_eq_of_flow","Breakdown.SmoothFlow.mildRegular_of_freq","Breakdown.embedX_physField_eq_of_powerFlow","Breakdown.fracMildRegular_of"],"proof_uses":["Breakdown.Freq.complexifyVec","Breakdown.Freq.realVec","Breakdown.SmoothFlow.contDiff_complexifyComp","Breakdown.SmoothFlow.symbolOf_eq_freqTr","Breakdown.SmoothFlow.testRapid","Breakdown.SmoothFlow.testSymbol"],"protected":false,"short":"physField_symbolOf","signature_end_line":125,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.IsTestField","Breakdown.SmoothFlow.physField","Breakdown.SmoothFlow.symbolOf","Breakdown.Space"],"used_by":["Breakdown.SmoothFlow.embedX_physField_eq_of_flow","Breakdown.SmoothFlow.mildRegular_of_freq","Breakdown.embedX_physField_eq_of_powerFlow","Breakdown.fracMildRegular_of"],"uses":["Breakdown.Freq.complexifyVec","Breakdown.Freq.realVec","Breakdown.IsTestField","Breakdown.SmoothFlow.contDiff_complexifyComp","Breakdown.SmoothFlow.physField","Breakdown.SmoothFlow.symbolOf","Breakdown.SmoothFlow.symbolOf_eq_freqTr","Breakdown.SmoothFlow.testRapid","Breakdown.SmoothFlow.testSymbol","Breakdown.Space"],"written":"physField_symbolOf"}],"imports":["Breakdown.Uniqueness.RegDefs"],"module":"Breakdown.Uniqueness.RegInitial","path":"Breakdown/Uniqueness/RegInitial.lean","sha256":"4653ed2e67a6fcb1b945a4e4a75ed155d851eac464d31603e29df86af31ee332","source":"import Breakdown.Uniqueness.RegDefs\n\nopen scoped ContDiff ENNReal FourierTransform Topology SchwartzMap RealInnerProductSpace\nopen MeasureTheory Set Real Filter\n\nnoncomputable section\n\nnamespace Breakdown.SmoothFlow\n\nopen Breakdown.Freq\n\nprivate theorem hasCompactSupport_complexifyComp {φ : Space → Space} (hφ : IsTestField φ) :\n    HasCompactSupport (fun x => complexifyVec (φ x)) :=\n  hφ.2.1.comp_left (map_zero complexifyVec)\n\nprivate theorem contDiff_complexifyComp {φ : Space → Space} (hφ : IsTestField φ) :\n    ContDiff ℝ ∞ (fun x => complexifyVec (φ x)) :=\n  complexifyVec.contDiff.comp hφ.1\n\nprivate def testRapid {φ : Space → Space} (hφ : IsTestField φ) : 𝓢(Space, CSpace) :=\n  (hasCompactSupport_complexifyComp hφ).toSchwartzMap (contDiff_complexifyComp hφ)\n\nprivate theorem testRapid_coe {φ : Space → Space} (hφ : IsTestField φ) :\n    (testRapid hφ : Space → CSpace) = fun x => complexifyVec (φ x) := rfl\n\nprivate def testSymbol {φ : Space → Space} (hφ : IsTestField φ) : 𝓢(Space, CSpace) :=\n  𝓕 (testRapid hφ)\n\nprivate theorem symbolOf_eq_freqTr {φ : Space → Space} (hφ : IsTestField φ) :\n    symbolOf φ = ⇑(testSymbol hφ) := by\n  rw [testSymbol, SchwartzMap.fourier_coe, testRapid_coe]\n  rfl\n\ntheorem aestronglyMeasurable_symbolOf {φ : Space → Space} (hφ : IsTestField φ) :\n    AEStronglyMeasurable (symbolOf φ) volume := by\n  rw [symbolOf_eq_freqTr hφ]\n  exact (testSymbol hφ).continuous.aestronglyMeasurable\n\nprivate theorem freqTr_neg_complexify {φ : Space → Space} (hφ : IsTestField φ) (ξ : Space) :\n    symbolOf φ (-ξ) = conjVec (symbolOf φ ξ) := by\n  have hint : Integrable (fun x => complexifyVec (φ x)) := (testRapid hφ).integrable\n  have hi : Integrable (fun v : Space => 𝐞 (-⟪v, ξ⟫) • complexifyVec (φ v)) := by\n    rw [Real.fourierIntegral_convergent_iff]\n    exact hint\n  rw [symbolOf, Real.fourier_eq, Real.fourier_eq, ← conjVec.integral_comp_comm hi]\n  congr 1\n  ext v i\n  simp [conjVec, complexifyVec, Circle.smul_def, Real.fourierChar_apply]\n  left\n  rw [← Complex.exp_conj]\n  congr 1\n  simp [map_mul, Complex.conj_ofReal, Complex.conj_I]\n  exact Or.inl (map_ofNat _ 2).symm\n\nprivate def traceMap : (Space →L[ℝ] CSpace) →L[ℝ] ℂ :=\n  ∑ i : Fin 3, ((EuclideanSpace.proj i : CSpace →L[ℂ] ℂ).restrictScalars ℝ).comp\n    (ContinuousLinearMap.apply ℝ CSpace (unitVector i))\n\nprivate theorem traceMap_apply (A : Space →L[ℝ] CSpace) : traceMap A = ∑ i : Fin 3, A (unitVector i) i := by\n  simp [traceMap]\n\nprivate theorem fderiv_complexifyComp {φ : Space → Space} (hφ : IsTestField φ) (x : Space) :\n    fderiv ℝ (fun x => complexifyVec (φ x)) x = complexifyVec.comp (fderiv ℝ φ x) :=\n  (complexifyVec.hasFDerivAt.comp x ((hφ.1.differentiable (by simp)) x).hasFDerivAt).fderiv\n\nprivate theorem divergence_symbolOf {φ : Space → Space} (hφ : IsTestField φ) (ξ : Space) :\n    ∑ i, ((ξ i : ℝ) : ℂ) * symbolOf φ ξ i = 0 := by\n  set g : Space → CSpace := fun x => complexifyVec (φ x)\n  have hint : Integrable g := (testRapid hφ).integrable\n  have hdiff : Differentiable ℝ g := (contDiff_complexifyComp hφ).differentiable (by simp)\n  have hdint : Integrable (fderiv ℝ g) :=\n    ((contDiff_complexifyComp hφ).continuous_fderiv (by simp)).integrable_of_hasCompactSupport\n      ((hasCompactSupport_complexifyComp hφ).fderiv ℝ)\n  have hF := congrFun (Real.fourier_fderiv hint hdiff hdint) ξ\n  have hi : Integrable (fun v : Space => 𝐞 (-⟪v, ξ⟫) • fderiv ℝ g v) := by\n    rw [Real.fourierIntegral_convergent_iff]\n    exact hdint\n  have hL := congrArg traceMap hF\n  rw [Real.fourier_eq, ← traceMap.integral_comp_comm hi] at hL\n  have hzero : ∀ v, traceMap (𝐞 (-⟪v, ξ⟫) • fderiv ℝ g v) = 0 := by\n    intro v\n    have h0 := hφ.2.2 v\n    rw [traceMap_apply]\n    simp only [g, fderiv_complexifyComp hφ v]\n    simp [complexifyVec, Circle.smul_def, divergenceAt] at h0 ⊢\n    rw [← Finset.mul_sum, ← Complex.ofReal_sum, h0, Complex.ofReal_zero, mul_zero]\n  simp only [hzero, integral_zero] at hL\n  rw [traceMap_apply] at hL\n  simp [unitVector] at hL\n  simp only [innerSL_apply_apply ℝ, EuclideanSpace.inner_single_right, one_mul,\n    conj_trivial] at hL\n  rw [← Finset.mul_sum] at hL\n  have hne : (2 * (π : ℂ) * Complex.I) ≠ 0 := by simp [Real.pi_ne_zero, Complex.I_ne_zero]\n  have hs := (mul_eq_zero.mp hL.symm).resolve_left hne\n  exact hs\n\ntheorem isSolenoidalSymbol_symbolOf {φ : Space → Space} (hφ : IsTestField φ) :\n    IsSolenoidalSymbol (symbolOf φ) := fun ξ =>\n  ⟨divergence_symbolOf hφ ξ, freqTr_neg_complexify hφ ξ⟩\n\nprivate theorem hasTemperateGrowth_hsWeight (m : ℕ) : Function.HasTemperateGrowth (hsWeight m) :=\n  ((Function.HasTemperateGrowth.const (1 : ℝ)).add (Function.hasTemperateGrowth_norm_sq Space)).pow m\n\ntheorem hsNormSq_symbolOf_lt_top {φ : Space → Space} (hφ : IsTestField φ) (m : ℕ) :\n    hsNormSq m (symbolOf φ) < ⊤ := by\n  rw [symbolOf_eq_freqTr hφ]\n  set g := testSymbol hφ\n  set h := SchwartzMap.smulLeftCLM CSpace (hsWeight m) g\n  obtain ⟨C, -, hC⟩ := g.decay 0 0\n  have hbd : ∀ ξ, ‖g ξ‖ ≤ C := fun ξ => by simpa using hC ξ\n  have hint : Integrable (fun ξ => ‖h ξ‖ * ‖g ξ‖) :=\n    h.integrable.norm.mul_bdd g.continuous.norm.aestronglyMeasurable\n      (Eventually.of_forall fun ξ => by simpa using hbd ξ)\n  have hw : ∀ ξ, 0 ≤ hsWeight m ξ := fun ξ => by unfold hsWeight; positivity\n  have heq : ∀ ξ, ENNReal.ofReal (hsWeight m ξ) * ‖g ξ‖ₑ ^ 2 =\n      ENNReal.ofReal (‖h ξ‖ * ‖g ξ‖) := by\n    intro ξ\n    rw [SchwartzMap.smulLeftCLM_apply_apply (hasTemperateGrowth_hsWeight m), norm_smul,\n      Real.norm_of_nonneg (hw ξ), mul_assoc, ENNReal.ofReal_mul (hw ξ), ← ofReal_norm, sq,\n      ← ENNReal.ofReal_mul (norm_nonneg _)]\n  unfold hsNormSq\n  simp_rw [heq]\n  exact hint.lintegral_lt_top\n\ntheorem physField_symbolOf {φ : Space → Space} (hφ : IsTestField φ) : physField (symbolOf φ) = φ := by\n  have hint : Integrable (fun x => complexifyVec (φ x)) := (testRapid hφ).integrable\n  have hFint : Integrable (symbolOf φ) := by\n    rw [symbolOf_eq_freqTr hφ]\n    exact (testSymbol hφ).integrable\n  have hinv := Continuous.fourierInv_fourier_eq (contDiff_complexifyComp hφ).continuous hint hFint\n  funext x\n  rw [physField, symbolOf, hinv]\n  ext i\n  simp [realVec, complexifyVec]\n\nend Breakdown.SmoothFlow\n"}