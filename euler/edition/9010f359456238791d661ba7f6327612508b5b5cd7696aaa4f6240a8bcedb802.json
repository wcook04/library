744fcb4b93bcda04477bee2da2695fe54e3be79f53a/papers/expository.md/sha256:f190626832e3c56f3907a8c7c3e84f3a28a0e261f4f85a27357ae5d2c1759ce3/papers/expository.json/passages/front","query_href":"/api/v1/papers/query?manifest=ac896a539f10846f0bc432315cd49673d3a9329fde7fcca6b8fa72dff6202bfe&paper=expository&passage=front","reading_href":"/api/v1/papers/reading?manifest=ac896a539f10846f0bc432315cd49673d3a9329fde7fcca6b8fa72dff6202bfe&paper=expository&passage=front","span":{"end_byte":529,"end_line":5,"start_byte":23,"start_line":2},"stage":"expository"}],"lenses":{"consumers":"/api/v1/graph?manifest=ac896a539f10846f0bc432315cd49673d3a9329fde7fcca6b8fa72dff6202bfe&view=arguments&node=euler.theorem-1.1&direction=consumers&assumptions=true","direct_passages":"/api/v1/papers/query?manifest=ac896a539f10846f0bc432315cd49673d3a9329fde7fcca6b8fa72dff6202bfe&node=euler.theorem-1.1&relation=direct","prerequisite_uses":"/api/v1/papers/query?manifest=ac896a539f10846f0bc432315cd49673d3a9329fde7fcca6b8fa72dff6202bfe&node=euler.theorem-1.1&relation=prerequisites","prerequisites":"/api/v1/graph?manifest=ac896a539f10846f0bc432315cd49673d3a9329fde7fcca6b8fa72dff6202bfe&view=arguments&node=euler.theorem-1.1&assumptions=true"},"neighborhood_href":"/api/v1/neighborhood?manifest=ac896a539f10846f0bc432315cd49673d3a9329fde7fcca6b8fa72dff6202bfe&ref=sha256%3Adb48fdd5ba2604749972848ed79e43c2768fdab18b46be5a44ed5375dec0afe1%2Fnodes%2Feuler.theorem-1.1","record":{"assumption_ids":[],"boundary":"A result as the authors number it. Its links to the Lean were made with AI for Proof Reader and have not been reviewed by the authors.","citation_ids":["cite.euler.theorem-1.1"],"evidence_ids":["link.euler.theorem-1.1"],"id":"euler.theorem-1.1","kind":"goal","label":"Theorem 1.1","locator":"Theorem 1.1, Section 1","source_id":"paper","statement":"**Theorem 1.1.** There is an odd divergence-free $u_0\\in C^\\infty(\\mathbb T^3;\\mathbb R^3)$ whose maximal classical solution $u$ of (1.1) is smooth and odd on $\\mathbb T^3\\times[0,T_*)$ for a finite $T_*>0$, and satisfies $$\\begin{equation}\n \\int_0^{T_*}\\|\\nabla u(t)\\|_{L^\\infty}\\,\\mathrm dt=\\infty,\n \\qquad\n \\int_0^{T_*}\\|\\operatorname{curl}u(t)\\|_{L^\\infty}\\,\\mathrm dt=\\infty. \\tag{1.2}\n\\end{equation}$$ Moreover, $$\\begin{equation}\n \\sup_{0\\le t<T_*}\\|u(t)\\|_{L^\\infty}<\\infty,\n \\qquad \\lim_{t\\uparrow T_*}|\\operatorname{curl}u(t,0)|=\\infty. \\tag{1.3}\n\\end{equation}$$ For every compact $K\\subset\\mathbb T^3\\setminus\\{0\\}$ and every integer $m\\ge0$, both $u(t)$ and $\\partial_tu(t)$ converge in $C^m(K)$ as $t\\uparrow T_*$.","status":"unverified"},"ref":"sha256:db48fdd5ba2604749972848ed79e43c2768fdab18b46be5a44ed5375dec0afe1/nodes/euler.theorem-1.1","relations":[{"derived":false,"family":"arguments","from":"sha256:db48fdd5ba2604749972848ed79e43c2768fdab18b46be5a44ed5375dec0afe1/nodes/euler.corollary-8.3","id":"sha256:db48fdd5ba2604749972848ed79e43c2768fdab18b46be5a44ed5375dec0afe1/edges/%5B%22euler.corollary-8.3%22%2C%22euler.theorem-1.1%22%2C%22supports%22%5D","kind":"supports","record_ref":"sha256:db48fdd5ba2604749972848ed79e43c2768fdab18b46be5a44ed5375dec0afe1/edges/%5B%22euler.corollary-8.3%22%2C%22euler.theorem-1.1%22%2C%22supports%22%5D","semantic_class":"curated_argument_support","to":"sha256:db48fdd5ba2604749972848ed79e43c2768fdab18b46be5a44ed5375dec0afe1/nodes/euler.theorem-1.1"},{"derived":false,"family":"arguments","from":"sha256:db48fdd5ba2604749972848ed79e43c2768fdab18b46be5a44ed5375dec0afe1/nodes/euler.proposition-8.1","id":"sha256:db48fdd5ba2604749972848ed79e43c2768fdab18b46be5a44ed5375dec0afe1/edges/%5B%22euler.proposition-8.1%22%2C%22euler.theorem-1.1%22%2C%22supports%22%5D","kind":"supports","record_ref":"sha256:db48fdd5ba2604749972848ed79e43c2768fdab18b46be5a44ed5375dec0afe1/edges/%5B%22euler.proposition-8.1%22%2C%22euler.theorem-1.1%22%2C%22supports%22%5D","semantic_class":"curated_argument_support","to":"sha256:db48fdd5ba2604749972848ed79e43c2768fdab18b46be5a4