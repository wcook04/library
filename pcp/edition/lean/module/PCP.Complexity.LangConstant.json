ng.Prog"],"written":"program"},{"dependency_source":"source_text","doc":null,"end_line":38,"kind":"theorem","line":37,"module":"PCP.Complexity.LangConstant","name":"PCP.Lang.Constant.program_run","namespace":"PCP.Lang.Constant","noncomputable":false,"private":false,"protected":false,"short":"program_run","signature_end_line":37,"used_by":["PCP.Reduction.NPThreeColorRuntime.checker_program_reduction","PCP.Reduction.NPThreeColorRuntime.polyTimeMap_constant"],"uses":["PCP.Lang.Constant.program","PCP.Lang.Constant.write_output"],"written":"program_run"},{"dependency_source":"source_text","doc":null,"end_line":41,"kind":"theorem","line":40,"module":"PCP.Complexity.LangConstant","name":"PCP.Lang.Constant.program_cost","namespace":"PCP.Lang.Constant","noncomputable":false,"private":false,"protected":false,"short":"program_cost","signature_end_line":41,"used_by":["PCP.Reduction.NPThreeColorRuntime.checker_program_reduction","PCP.Reduction.NPThreeColorRuntime.polyTimeMap_constant"],"uses":["PCP.Lang.Constant.program","PCP.Lang.Constant.write_cost","PCP.Lang.listSize"],"written":"program_cost"}],"imports":["PCP.Complexity.Lang"],"module":"PCP.Complexity.LangConstant","path":"PCP/Complexity/LangConstant.lean","sha256":"5bb429555b378d83b7f8a113b52438cf2501041b98e03ed551b9891447f302bc","source":"/-\nCopyright (c) 2026 Troy Lee. All rights reserved.\nReleased under Apache 2.0 license as described in the file LICENSE.\nAuthors: Troy Lee\n-/\nimport PCP.Complexity.Lang\n\n/-! # Fixed-list output programs with exact charged cost -/\n\nnamespace PCP.Lang.Constant\n\ndef write : List ℕ → Stmt 1 2\n  | [] => .skip\n  | a :: xs => .seq (write xs) (.seq (.assign 0 (.const a)) (.push 1 0))\n\ntheorem write_output (xs : List ℕ) (st : State 1 2) :\n    ((write xs).run st).1.lists 1 = xs ++ st.lists 1 := by\n  induction xs with\n  | nil => rfl\n  | cons a xs ih => simp [write, Stmt.run, Expr.eval, ih]\n\ntheorem write_cost (xs : List ℕ) (st : State 1 2) :\n    ((write xs).run st).2 = 3 * listSize xs + xs.length + 1 := by\n  induction xs with\n  | nil => simp [write, Stmt.run, listSize]\n  | cons a xs ih =>\n      simp only [write, Stmt.run, Expr.cost, Expr.readSize, Expr.eval, ih,\n        setReg, Function.update_self, listSize, List.map_cons, List.sum_cons, List.length_cons]\n      omega\n\ndef program (xs : List ℕ) : Prog where\n  R := 1\n  Q := 2\n  hQ := by decide\n  body := write xs\n\ntheorem program_run (xs input : List ℕ) : (program xs).run input = xs := by\n  exact (write_output xs ((program xs).init input)).trans (List.append_nil xs)\n\ntheorem program_cost (xs input : List ℕ) :\n    (program xs).cost input = 3 * listSize xs + xs.length + 1 := write_cost xs _\n\nend PCP.Lang.Constant\n"}