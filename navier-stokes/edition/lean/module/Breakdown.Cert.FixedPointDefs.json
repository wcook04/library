d"],"dependency_source":"lean_report","doc":null,"end_line":52,"kind":"theorem","line":48,"module":"Breakdown.Cert.FixedPointDefs","name":"Breakdown.GridSimplex.mem_boundaryDoorSet","namespace":"Breakdown.GridSimplex","noncomputable":false,"private":false,"proof_used_by":["Breakdown.GridSimplex.card_boundaryDoorSet"],"proof_uses":["Breakdown.GridSimplex.doorSet"],"protected":false,"short":"mem_boundaryDoorSet","signature_end_line":50,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.GridSimplex.IsDoor","Breakdown.GridSimplex.OnBoundary","Breakdown.GridSimplex.boundaryDoorSet"],"used_by":["Breakdown.GridSimplex.card_boundaryDoorSet"],"uses":["Breakdown.GridSimplex.IsDoor","Breakdown.GridSimplex.OnBoundary","Breakdown.GridSimplex.boundaryDoorSet","Breakdown.GridSimplex.doorSet"],"written":"mem_boundaryDoorSet"},{"axioms":["propext","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":58,"kind":"theorem","line":54,"module":"Breakdown.Cert.FixedPointDefs","name":"Breakdown.GridSimplex.vertex_le","namespace":"Breakdown.GridSimplex","noncomputable":false,"private":false,"proof_used_by":["Breakdown.GridSimplex.FaceInternal.boundary_shape","Breakdown.GridSimplex.FaceInternal.isDoor_cons_iff","Breakdown.GridSimplex.card_doorSet_mod_two","Breakdown.GridSimplex.odd_card_fullSet","Breakdown.exists_fixedPoint_box"],"proof_uses":[],"protected":false,"short":"vertex_le","signature_end_line":55,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.GridSimplex.vertex"],"used_by":["Breakdown.GridSimplex.FaceInternal.boundary_shape","Breakdown.GridSimplex.FaceInternal.isDoor_cons_iff","Breakdown.GridSimplex.card_doorSet_mod_two","Breakdown.GridSimplex.odd_card_fullSet","Breakdown.exists_fixedPoint_box"],"uses":["Breakdown.GridSimplex.vertex"],"written":"vertex_le"}],"imports":["Breakdown.Cert.FixedPointCount"],"module":"Breakdown.Cert.FixedPointDefs","path":"Breakdown/Cert/FixedPointDefs.lean","sha256":"5b57b237776b97bbd849ba5179daf24661023017e3c324103a7a5c9f48ff0304","source":"import Breakdown.Cert.FixedPointCount\n\nnamespace Breakdown\nnamespace GridSimplex\n\ndef vertex {k p : ℕ} (v : Fin k → Fin p) (τ : Equiv.Perm (Fin k)) (j : ℕ) : Fin k → ℕ :=\n  fun i => (v i : ℕ) + if (τ i : ℕ) < j then 1 else 0\n\ndef IsFull {k p : ℕ} (L : (Fin k → ℕ) → ℕ) (v : Fin k → Fin p) (τ : Equiv.Perm (Fin k)) : Prop :=\n  Covers (fun j : Fin (k + 1) => L (vertex v τ (j : ℕ))) k\n\ndef IsDoor {k p : ℕ} (L : (Fin (k + 1) → ℕ) → ℕ) (v : Fin (k + 1) → Fin p)\n    (τ : Equiv.Perm (Fin (k + 1))) (j : Fin (k + 2)) : Prop :=\n  CoversFrom (fun t : Fin (k + 2) => L (vertex v τ (t : ℕ))) j (k + 1)\n\ndef OnBoundary {k p : ℕ} (v : Fin (k + 1) → Fin p) (τ : Equiv.Perm (Fin (k + 1)))\n    (j : Fin (k + 2)) : Prop :=\n  (j = 0 ∧ (v (τ.symm 0) : ℕ) + 1 = p) ∨\n    (j = Fin.last (k + 1) ∧ (v (τ.symm (Fin.last k)) : ℕ) = 0)\n\nopen Classical in\nnoncomputable def fullSet {k p : ℕ} (L : (Fin k → ℕ) → ℕ) :\n    Finset ((Fin k → Fin p) × Equiv.Perm (Fin k)) :=\n  Finset.univ.filter fun s => IsFull L s.1 s.2\n\nopen Classical in\nnoncomputable def doorSet {k p : ℕ} (L : (Fin (k + 1) → ℕ) → ℕ) :\n    Finset ((Fin (k + 1) → Fin p) × Equiv.Perm (Fin (k + 1)) × Fin (k + 2)) :=\n  Finset.univ.filter fun s => IsDoor L s.1 s.2.1 s.2.2\n\nopen Classical in\nnoncomputable def boundaryDoorSet {k p : ℕ} (L : (Fin (k + 1) → ℕ) → ℕ) :\n    Finset ((Fin (k + 1) → Fin p) × Equiv.Perm (Fin (k + 1)) × Fin (k + 2)) :=\n  (doorSet L).filter fun s => OnBoundary s.1 s.2.1 s.2.2\n\ntheorem mem_fullSet {k p : ℕ} (L : (Fin k → ℕ) → ℕ)\n    (s : (Fin k → Fin p) × Equiv.Perm (Fin k)) :\n    s ∈ fullSet L ↔ IsFull L s.1 s.2 := by\n  classical\n  simp [fullSet]\n\ntheorem mem_doorSet {k p : ℕ} (L : (Fin (k + 1) → ℕ) → ℕ)\n    (s : (Fin (k + 1) → Fin p) × Equiv.Perm (Fin (k + 1)) × Fin (k + 2)) :\n    s ∈ doorSet L ↔ IsDoor L s.1 s.2.1 s.2.2 := by\n  classical\n  simp [doorSet]\n\ntheorem mem_boundaryDoorSet {k p : ℕ} (L : (Fin (k + 1) → ℕ) → ℕ)\n    (s : (Fin (k + 1) → Fin p) × Equiv.Perm (Fin (k + 1)) × Fin (k + 2)) :\n    s ∈ boundaryDoorSet L ↔ IsDoor L s.1 s.2.1 s.2.2 ∧ OnBoundary s.1 s.2.1 s.2.2 := by\n  classical\n  simp [boundaryDoorSet, doorSet]\n\ntheorem vertex_le {k p : ℕ} (v : Fin k → Fin p) (τ : Equiv.Perm (Fin k)) (j : ℕ) (i : Fin k) :\n    vertex v τ j i ≤ p := by\n  have h := (v i).isLt\n  unfold vertex\n  split_ifs <;> omega\n\nend GridSimplex\nend Breakdown\n"}