Internal.OffAxisCoreGrad.shapeGrad_core","Breakdown.CellCert.Spectral.offAxisCore_of_weak","Breakdown.CellCert.Spectral.shapeGrad_of_weak","Breakdown.CellCert.Spectral.shapeWeak_of_parts"],"uses":["Breakdown.CellCert.Spectral.CellBlock","Breakdown.CellCert.Spectral.CellBlock.innerRadius","Breakdown.CellCert.Spectral.CellBlock.lowerHeight","Breakdown.CellCert.Spectral.CellBlock.outerRadius","Breakdown.CellCert.Spectral.CellBlock.upperHeight","Breakdown.CellCert.Spectral.shapeField","Breakdown.CellCert.Spectral.shapeGradCoef","Breakdown.CellCert.Spectral.shapeGradField","Breakdown.CellCert.Spectral.solidLower","Breakdown.CellCert.Spectral.solidUpper","Breakdown.SteadyCert.IsWeakGradientOf"],"written":"ShapeWeakStatement"}],"imports":["Breakdown.FracCell.OffAxisCoreSt"],"module":"Breakdown.FracCell.OffAxisCoreWeakSt","path":"Breakdown/FracCell/OffAxisCoreWeakSt.lean","sha256":"666b563334a1f92070053a38686ac92f7363befde864eff1687976f415ecf57e","source":"import Breakdown.FracCell.OffAxisCoreSt\n\nopen MeasureTheory\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace CellCert\n\nnamespace Spectral\n\nopen SteadyCert\n\ndef shapeGradField (g : CellBlock) (f : Fin 2 → Fin 3 → Fin 3 → Fin 2 → ℝ → ℝ → ℝ) (y : Space) :\n    Space →L[ℝ] Space :=\n  ∑ s : Fin 2, Set.indicator (cellSolid g s)\n    (fun w => ∑ c : Fin 3, ∑ d : Fin 3, (∑ t : Fin 2, trigMode t (g.mode * angleCoord w)\n      * f s c d t (radialCoord w) (w 2)) • (innerSL ℝ (frameVector d w)).smulRight (frameVector c w)) y\n\ndef angularCoef (m : ℕ) (Q : Fin 2 → Fin 3 → Fin 2 → ℝ → ℝ → ℝ) (s : Fin 2) (c : Fin 3) (t : Fin 2)\n    (r z : ℝ) : ℝ :=\n  (if t = 0 then (m : ℝ) * Q s c 1 r z else -((m : ℝ) * Q s c 0 r z))\n    + (if c = 0 then -Q s 1 t r z else if c = 1 then Q s 0 t r z else 0)\n\ndef shapeGradCoef (g : CellBlock) (Q : Fin 2 → Fin 3 → Fin 2 → ℝ → ℝ → ℝ) :\n    Fin 2 → Fin 3 → Fin 3 → Fin 2 → ℝ → ℝ → ℝ :=\n  fun s c d t r z =>\n    if d = 0 then deriv (fun x => Q s c t x z) r\n    else if d = 1 then (max r g.innerRadius)⁻¹ * angularCoef g.mode Q s c t r z\n    else deriv (fun x => Q s c t r x) z\n\ndef ShapeWeakStatement : Prop :=\n  ∀ (g : CellBlock) (Q : Fin 2 → Fin 3 → Fin 2 → ℝ → ℝ → ℝ), 0 < g.innerRadius →\n    g.innerRadius < g.outerRadius → g.lowerHeight < g.upperHeight → 0 ≤ g.lowerHeight →\n    (∀ s c t, ContDiff ℝ 1 (Function.uncurry (Q s c t))) →\n    (∀ s c t z, Q s c t g.innerRadius z = 0) → (∀ s c t z, Q s c t g.outerRadius z = 0) →\n    (∀ s c t r, Q s c t r (solidLower g s) = 0) → (∀ s c t r, Q s c t r (solidUpper g s) = 0) →\n      IsWeakGradientOf (shapeField g Q) (shapeGradField g (shapeGradCoef g Q))\n\nend Spectral\n\nend CellCert\n\nend Breakdown\n"}