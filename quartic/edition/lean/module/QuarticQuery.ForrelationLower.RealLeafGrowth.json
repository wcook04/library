iveExpectationLinear_apply","QuarticQuery.ForrelationLower.sum_abs_ext_Dl_le_real_leaves"],"uses":["QuarticQuery.ForrelationLower.differencesLinear","QuarticQuery.ForrelationLower.extensionLinear"],"written":"derivativeExpectationLinear"},{"dependency_source":"lean_report","doc":null,"end_line":62,"kind":"theorem","line":58,"module":"QuarticQuery.ForrelationLower.RealLeafGrowth","name":"QuarticQuery.ForrelationLower.derivativeExpectationLinear_apply","namespace":"QuarticQuery.ForrelationLower","noncomputable":false,"private":false,"proof_used_by":["QuarticQuery.ForrelationLower.sum_abs_ext_Dl_le_real_leaves"],"proof_uses":["QuarticQuery.ForrelationLower.differencesLinear","QuarticQuery.ForrelationLower.differencesLinear_apply"],"protected":false,"short":"derivativeExpectationLinear_apply","signature_end_line":60,"statement_used_by":[],"statement_uses":["QuarticQuery.ForrelationLower.Dl","QuarticQuery.ForrelationLower.derivativeExpectationLinear","QuarticQuery.ForrelationLower.ext"],"used_by":["QuarticQuery.ForrelationLower.sum_abs_ext_Dl_le_real_leaves"],"uses":["QuarticQuery.ForrelationLower.Dl","QuarticQuery.ForrelationLower.derivativeExpectationLinear","QuarticQuery.ForrelationLower.differencesLinear","QuarticQuery.ForrelationLower.differencesLinear_apply","QuarticQuery.ForrelationLower.ext"],"written":"derivativeExpectationLinear_apply"},{"dependency_source":"lean_report","doc":null,"end_line":82,"kind":"theorem","line":64,"module":"QuarticQuery.ForrelationLower.RealLeafGrowth","name":"QuarticQuery.ForrelationLower.sum_abs_ext_Dl_le_real_leaves","namespace":"QuarticQuery.ForrelationLower","noncomputable":false,"private":false,"proof_used_by":["QuarticQuery.ForrelationLower.sum_abs_ext_Dl_le_real_leaves_explicit"],"proof_uses":["QuarticQuery.BitInput","QuarticQuery.ForrelationLower.RealQueryTree.abs_answerSign","QuarticQuery.ForrelationLower.RealQueryTree.answerSign","QuarticQuery.ForrelationLower.RealQueryTree.sum_linear_bound","QuarticQuery.ForrelationLower.derivativeExpectationLinear","QuarticQuery.ForrelationLower.derivativeExpectationLinear_apply","QuarticQuery.ForrelationLower.sum_abs_ext_Dl_le","QuarticQuery.QueryTree","QuarticQuery.QueryTree.depth","QuarticQuery.QueryTree.eval"],"protected":false,"short":"sum_abs_ext_Dl_le_real_leaves","signature_end_line":75,"statement_used_by":[],"statement_uses":["QuarticQuery.ForrelationLower.Dl","QuarticQuery.ForrelationLower.RealQueryTree","QuarticQuery.ForrelationLower.RealQueryTree.Bounded","QuarticQuery.ForrelationLower.RealQueryTree.depth","QuarticQuery.ForrelationLower.RealQueryTree.eval","QuarticQuery.ForrelationLower.ext"],"used_by":["QuarticQuery.ForrelationLower.sum_abs_ext_Dl_le_real_leaves_explicit","QuarticQuery.Independent.RealLeaves.Compare.growth"],"uses":["QuarticQuery.BitInput","QuarticQuery.ForrelationLower.Dl","QuarticQuery.ForrelationLower.RealQueryTree","QuarticQuery.ForrelationLower.RealQueryTree.Bounded","QuarticQuery.ForrelationLower.RealQueryTree.abs_answerSign","QuarticQuery.ForrelationLower.RealQueryTree.answerSign","QuarticQuery.ForrelationLower.RealQueryTree.depth","QuarticQuery.ForrelationLower.RealQueryTree.eval","QuarticQuery.ForrelationLower.RealQueryTree.sum_linear_bound","QuarticQuery.ForrelationLower.derivativeExpectationLinear","QuarticQuery.ForrelationLower.derivativeExpectationLinear_apply","QuarticQuery.ForrelationLower.ext","QuarticQuery.ForrelationLower.sum_abs_ext_Dl_le","QuarticQuery.QueryTree","QuarticQuery.QueryTree.depth","QuarticQuery.QueryTree.eval"],"written":"sum_abs_ext_Dl_le_real_leaves"}],"imports":["QuarticQuery.ForrelationLower.RealLeaves","QuarticQuery.ForrelationLower.TreeGrowth"],"module":"QuarticQuery.ForrelationLower.RealLeafGrowth","path":"QuarticQuery/ForrelationLower/RealLeafGrowth.lean","sha256":"7b210e7566682746d6ed455d84ea9736562734a67f79e1926a1772a31b7f04a5","source":"module\n\npublic import QuarticQuery.ForrelationLower.RealLeaves\npublic import QuarticQuery.ForrelationLower.TreeGrowth\n\n/-!\n# Derivative growth for arbitrary bounded-real decision-tree leaves\n\nThe independently specified real tree is transferred to the maintained\nBoolean-tree estimate by a finite convex decomposition.  The analytical\nconstant and every derivative, bias, dimension and depth hypothesis are\npreserved verbatim.\n-/\n\n@[expose] public section\nset_option autoImplicit false\n\nopen Finset\n\nnamespace QuarticQuery.ForrelationLower\n\nvariable {ι : Type} [Fintype ι] [DecidableEq ι]\n\nnoncomputable def differenceLinear (a : ι) :\n    ((ι → Bool) → ℝ) →ₗ[ℝ] ((ι → Bool) → ℝ) where\n  toFun g := D a g\n  map_add' g h := by\n    funext x\n    simp only [D, Pi.add_apply]\n    ring\n  map_smul' c g := by\n    funext x\n    simp only [D, Pi.smul_apply, smul_eq_mul, RingHom.id_apply]\n    ring\n\nnoncomputable def differencesLinear : List ι →\n    ((ι → Bool) → ℝ) →ₗ[ℝ] ((ι → Bool) → ℝ)\n  | [] => LinearMap.id\n  | a :: L => (differencesLinear L).comp (differenceLinear a)\n\ntheorem differencesLinear_apply (L : List ι) (g : (ι → Bool) → ℝ) :\n    differencesLinear L g = Dl L g := by\n  induction L generalizing g with\n  | nil => rfl\n  | cons a L ih =>\n      change differencesLinear L (D a g) = Dl L (D a g)\n      exact ih _\n\nnoncomputable def extensionLinear (μ : ι → ℝ) : ((ι → Bool) → ℝ) →ₗ[ℝ] ℝ where\n  toFun g := ext g μ\n  map_add' g h := ext_add g h μ\n  map_smul' c g := ext_smul c g μ\n\nnoncomputable def derivativeExpectationLinear (L : List ι) (μ : ι → ℝ) :\n    ((ι → Bool) → ℝ) →ₗ[ℝ] ℝ :=\n  (extensionLinear μ).comp (differencesLinear L)\n\ntheorem derivativeExpectationLinear_apply (L : List ι) (μ : ι → ℝ)\n    (g : (ι → Bool) → ℝ) :\n    derivativeExpectationLinear L μ g = ext (Dl L g) μ := by\n  change ext (differencesLinear L g) μ = _\n  rw [differencesLinear_apply]\n\ntheorem sum_abs_ext_Dl_le_real_leaves {P : Type} [Fintype P] [DecidableEq P]\n    (Lp : P → List ι) (hnd : ∀ p, (Lp p).Nodup) {k : ℕ}\n    (hlen : ∀ p, (Lp p).length = k)\n    (hinj : Function.Injective fun p => (Lp p).toFinset)\n    {μ : ι → ℝ} (hμ : ∀ a, |μ a| ≤ 1 / 2)\n    {Λ K : ℝ} {d : ℕ} (hd : 0 < d) (hK : 0 < K)\n    (hKsq : K ^ 2 = 2 * d * 2 ^ 2 * Λ)\n    (hn : 1 ≤ Fintype.card ι) (T : RealQueryTree ι)\n    (hT : T.depth ≤ d) (hbounded : T.Bounded) :\n    ∑ p, |ext (Dl (Lp p) T.eval) μ| ≤\n      K ^ k + (Fintype.card ι * 2) ^ k *\n        ((4 * Fintype.card ι : ℝ) ^ k * Real.exp (-Λ)) := by\n  simp_rw [← derivativeExpectationLinear_apply]\n  apply T.sum_linear_bound hbounded (fun p => derivativeExpectationLinear (Lp p) μ)\n  intro S hS\n  simp_rw [derivativeExpectationLinear_apply]\n  exact sum_abs_ext_Dl_le Lp hnd hlen hinj hμ hd hK hKsq hn S\n    (hS.trans hT) RealQueryTree.answerSign\n    (fun b => (RealQueryTree.abs_answerSign b).le)\n\nend QuarticQuery.ForrelationLower\n"}