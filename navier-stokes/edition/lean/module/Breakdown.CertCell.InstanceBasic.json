tio","Breakdown.CertCell.Instance.BasicFactsInternal.chartT_measurable","Breakdown.CertCell.Instance.BasicFactsInternal.heightRatio_measurable","Breakdown.FarDecayInternal.FarDecay.prodMk","Breakdown.Space"],"written":"half_measurable"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":160,"kind":"theorem","line":154,"module":"Breakdown.CertCell.InstanceBasic","name":"Breakdown.CertCell.Instance.BasicFactsInternal.values_measurable","namespace":"Breakdown.CertCell.Instance.BasicFactsInternal","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CertCell.Instance.stepBasicFacts","Breakdown.CertCell.ScalarShape.Internal.PlaneMin.lowerValue_measurable","Breakdown.CertCell.ScalarShape.Internal.PlaneMin.upperValue_measurable"],"proof_uses":["Breakdown.CellCert.GivenFields.DualPartsInternal.cellIndex_measurable","Breakdown.CertCell.Instance.BasicFactsInternal.chartT_measurable","Breakdown.CertCell.Instance.BasicFactsInternal.heightRatio_measurable","Breakdown.FarDecayInternal.FarDecay.prodMk"],"protected":false,"short":"values_measurable","signature_end_line":156,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CellCert.GivenFields.ChartParams","Breakdown.CellCert.GivenFields.TensorMesh","Breakdown.CellCert.GivenFields.TensorMesh.tBreaks","Breakdown.CellCert.GivenFields.TensorMesh.xBreaks","Breakdown.CellCert.GivenFields.cellIndex","Breakdown.CellCert.GivenFields.chartT","Breakdown.CellCert.GivenFields.heightRatio","Breakdown.Space"],"used_by":["Breakdown.CertCell.Instance.stepBasicFacts","Breakdown.CertCell.ScalarShape.Internal.PlaneMin.lowerValue_measurable","Breakdown.CertCell.ScalarShape.Internal.PlaneMin.upperValue_measurable"],"uses":["Breakdown.CellCert.GivenFields.ChartParams","Breakdown.CellCert.GivenFields.DualPartsInternal.cellIndex_measurable","Breakdown.CellCert.GivenFields.TensorMesh","Breakdown.CellCert.GivenFields.TensorMesh.tBreaks","Breakdown.CellCert.GivenFields.TensorMesh.xBreaks","Breakdown.CellCert.GivenFields.cellIndex","Breakdown.CellCert.GivenFields.chartT","Breakdown.CellCert.GivenFields.heightRatio","Breakdown.CertCell.Instance.BasicFactsInternal.chartT_measurable","Breakdown.CertCell.Instance.BasicFactsInternal.heightRatio_measurable","Breakdown.FarDecayInternal.FarDecay.prodMk","Breakdown.Space"],"written":"values_measurable"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":187,"kind":"theorem","line":166,"module":"Breakdown.CertCell.InstanceBasic","name":"Breakdown.CertCell.Instance.scalarBasicFacts","namespace":"Breakdown.CertCell.Instance","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CertCell.instanceParts_holds"],"proof_uses":["Breakdown.CellCert.GivenFields.chartT","Breakdown.CertCell.Instance.BasicFactsInternal.axialRot_third","Breakdown.CertCell.Instance.BasicFactsInternal.chartT_axialRot","Breakdown.CertCell.Instance.BasicFactsInternal.chartT_lt_one","Breakdown.CertCell.Instance.BasicFactsInternal.chartT_measurable","Breakdown.CertCell.Instance.BasicFactsInternal.chartT_nonneg","Breakdown.CertCell.Instance.BasicFactsInternal.half_measurable","Breakdown.CertCell.Instance.BasicFactsInternal.heightRatio_axialRot","Breakdown.CertCell.Instance.BasicFactsInternal.heightRatio_le_one","Breakdown.CertCell.Instance.BasicFactsInternal.heightRatio_nonneg_of","Breakdown.CertCell.Instance.BasicFactsInternal.neg_heightRatio_le_one","Breakdown.CertCell.Instance.BasicFactsInternal.neg_heightRatio_nonneg_of","Breakdown.CertCell.Instance.ChartScalar.eval","Breakdown.Space"],"protected":false,"short":"scalarBasicFacts","signature_end_line":166,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CertCell.Instance.ScalarBasicFacts"],"used_by":["Breakdown.CertCell.instanceParts_holds"],"uses":["Breakdown.CellCert.GivenFields.chartT","Breakdown.CertCell.Instance.BasicFactsInternal.axialRot_third","Breakdown.CertCell.Instance.BasicFactsInternal.chartT_axialRot","Breakdown.CertCell.Instance.BasicFactsInternal.chartT_lt_one","Breakdown.CertCell.Instance.BasicFactsInternal.chartT_measurable","Breakdown.CertCell.Instance.BasicFactsInternal.chartT_nonneg","Breakdown.CertCell.Instance.BasicFactsInternal.half_measurable","Breakdown.CertCell.Instance.BasicFactsInternal.heightRatio_axialRot","Breakdown.CertCell.Instance.BasicFactsInternal.heightRatio_le_one","Breakdown.CertCell.Instance.BasicFactsInternal.heightRatio_nonneg_of","Breakdown.CertCell.Instance.BasicFactsInternal.neg_heightRatio_le_one","Breakdown.CertCell.Instance.BasicFactsInternal.neg_heightRatio_nonneg_of","Breakdown.CertCell.Instance.ChartScalar.eval","Breakdown.CertCell.Instance.ScalarBasicFacts","Breakdown.Space"],"written":"scalarBasicFacts"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":218,"kind":"theorem","line":189,"module":"Breakdown.CertCell.InstanceBasic","name":"Breakdown.CertCell.Instance.stepBasicFacts","namespace":"Breakdown.CertCell.Instance","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CertCell.instanceParts_holds"],"proof_uses":["Breakdown.CellCert.GivenFields.chartT","Breakdown.CertCell.Instance.BasicFactsInternal.axialRot_third","Breakdown.CertCell.Instance.BasicFactsInternal.chartT_axialRot","Breakdown.CertCell.Instance.BasicFactsInternal.chartT_lt_one","Breakdown.CertCell.Instance.BasicFactsInternal.chartT_measurable","Breakdown.CertCell.Instance.BasicFactsInternal.heightRatio_axialRot","Breakdown.CertCell.Instance.BasicFactsInternal.index_lt_count","Breakdown.CertCell.Instance.BasicFactsInternal.values_measurable","Breakdown.CertCell.Instance.StepDatum.eval","Breakdown.CertCell.Instance.StepDatum.lowerValue","Breakdown.CertCell.Instance.StepDatum.upperValue","Breakdown.Space"],"protected":false,"short":"stepBasicFacts","signature_end_line":189,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CertCell.Instance.StepBasicFacts"],"used_by":["Breakdown.CertCell.instanceParts_holds"],"uses":["Breakdown.CellCert.GivenFields.chartT","Breakdown.CertCell.Instance.BasicFactsInternal.axialRot_third","Breakdown.CertCell.Instance.BasicFactsInternal.chartT_axialRot","Breakdown.CertCell.Instance.BasicFactsInternal.chartT_lt_one","Breakdown.CertCell.Instance.BasicFactsInternal.chartT_measurable","Breakdown.CertCell.Instance.BasicFactsInternal.heightRatio_axialRot","Breakdown.CertCell.Instance.BasicFactsInternal.index_lt_count","Breakdown.CertCell.Instance.BasicFactsInternal.values_measurable","Breakdown.CertCell.Instance.StepBasicFacts","Breakdown.CertCell.Instance.StepDatum.eval","Breakdown.CertCell.Instance.StepDatum.lowerValue","Breakdown.CertCell.Instance.StepDatum.upperValue","Breakdown.Space"],"written":"stepBasicFacts"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":242,"kind":"theorem","line":220,"module":"Breakdown.CertCell.InstanceBasic","name":"Breakdown.CertCell.Instance.mirrorEval","namespace":"Breakdown.CertCell.Instance","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CertCell.instanceParts_holds"],"proof_uses":["Breakdown.CellCert.GivenFields.heightRatio","Breakdown.CertCell.Instance.BasicFactsInternal.chartT_flipPoint","Breakdown.CertCell.Instance.BasicFactsInternal.flipPoint_third","Breakdown.CertCell.Instance.BasicFactsInternal.halves_agree_on_plane","Breakdown.CertCell.Instance.BasicFactsInternal.heightRatio_flipPoint","Breakdown.CertCell.Instance.ChartScalar.eval","Breakdown.CertCell.Instance.ChartScalar.mirror","Breakdown.CertCell.Instance.StepDatum.eval","Breakdown.CertCell.Instance.StepDatum.lowerValue","Breakdown.CertCell.Instance.StepDatum.mirror","Breakdown.CertCell.Instance.StepDatum.upperValue"],"protected":false,"short":"mirrorEval","signature_end_line":220,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CertCell.Instance.MirrorEval"],"used_by":["Breakdown.CertCell.instanceParts_holds"],"uses":["Breakdown.CellCert.GivenFields.heightRatio","Breakdown.CertCell.Instance.BasicFactsInternal.chartT_flipPoint","Breakdown.CertCell.Instance.BasicFactsInternal.flipPoint_third","Breakdown.CertCell.Instance.BasicFactsInternal.halves_agree_on_plane","Breakdown.CertCell.Instance.BasicFactsInternal.heightRatio_flipPoint","Breakdown.CertCell.Instance.ChartScalar.eval","Breakdown.CertCell.Instance.ChartScalar.mirror","Breakdown.CertCell.Instance.MirrorEval","Breakdown.CertCell.Instance.StepDatum.eval","Breakdown.CertCell.Instance.StepDatum.lowerValue","Breakdown.CertCell.Instance.StepDatum.mirror","Breakdown.CertCell.Instance.StepDatum.upperValue"],"written":"mirrorEval"}],"imports":["Breakdown.CertCell.InstanceStatements","Breakdown.FracCell.GivenAuxDualParts"],"module":"Breakdown.CertCell.InstanceBasic","path":"Breakdown/CertCell/InstanceBasic.lean","sha256":"cdeb2ce28f036e80eb27a1781d1779b09753c60fed30d1bc714b00a2e9ec27f5","source":"import Breakdown.CertCell.InstanceStatements\nimport Breakdown.FracCell.GivenAuxDualParts\n\nopen MeasureTheory\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace CertCell\n\nnamespace Instance\n\nopen CellCert.GivenFields (ChartParams IsChartParams chartT heightRatio Spline TensorMesh IsTensorMesh\n  cellCount cellIndex atSecond xDeriv)\n\nnamespace BasicFactsInternal\n\ntheorem flipPoint_third (y : Space) : flipPoint y 2 = -y 2 := by\n  simp [flipPoint, unitVector]\n\ntheorem flipPoint_norm_eq (y : Space) : ‖flipPoint y‖ = ‖y‖ := by\n  rw [EuclideanSpace.norm_eq, EuclideanSpace.norm_eq]\n  congr 1\n  simp [Fin.sum_univ_three, flipPoint, unitVector]\n\ntheorem axialRot_third (φ : ℝ) (y : Space) : axialRot φ y 2 = y 2 := by\n  simp [axialRot, unitVector]\n\ntheorem axialRot_norm_eq (φ : ℝ) (y : Space) : ‖axialRot φ y‖ = ‖y‖ := by\n  rw [EuclideanSpace.norm_eq, EuclideanSpace.norm_eq]\n  congr 1\n  simp only [Fin.sum_univ_three, Real.norm_eq_abs, sq_abs]\n  simp [axialRot, unitVector]\n  linear_combination (y 0 ^ 2 + y 1 ^ 2) * Real.sin_sq_add_cos_sq φ\n\ntheorem chartT_axialRot (P : ChartParams) (φ : ℝ) (y : Space) : chartT P (axialRot φ y) = chartT P y := by\n  unfold chartT\n  rw [axialRot_norm_eq]\n\ntheorem heightRatio_axialRot (φ : ℝ) (y : Space) : heightRatio (axialRot φ y) = heightRatio y := by\n  unfold heightRatio\n  rw [axialRot_norm_eq, axialRot_third]\n\ntheorem chartT_flipPoint (P : ChartParams) (y : Space) : chartT P (flipPoint y) = chartT P y := by\n  unfold chartT\n  rw [flipPoint_norm_eq]\n\ntheorem heightRatio_flipPoint (y : Space) : heightRatio (flipPoint y) = -heightRatio y := by\n  unfold heightRatio\n  rw [flipPoint_norm_eq, flipPoint_third, neg_div]\n\ntheorem chartT_nonneg (P : ChartParams) (hP : IsChartParams P) (y : Space) : 0 ≤ chartT P y := by\n  unfold chartT\n  have := hP.L0_pos\n  positivity\n\ntheorem chartT_lt_one (P : ChartParams) (hP : IsChartParams P) (y : Space) : chartT P y < 1 := by\n  unfold chartT\n  have h := hP.L0_pos\n  rw [div_lt_one (by positivity)]\n  linarith [norm_nonneg y]\n\ntheorem abs_third_le_norm (y : Space) : |y 2| ≤ ‖y‖ := by\n  have := PiLp.norm_apply_le y 2\n  simpa [Real.norm_eq_abs] using this\n\ntheorem heightRatio_nonneg_of (y : Space) (h : 0 ≤ y 2) : 0 ≤ heightRatio y := by\n  unfold heightRatio\n  exact div_nonneg h (norm_nonneg y)\n\ntheorem heightRatio_le_one (y : Space) : heightRatio y ≤ 1 := by\n  unfold heightRatio\n  rcases (norm_nonneg y).eq_or_lt with h | h\n  · rw [← h, div_zero]\n    exact zero_le_one\n  · rw [div_le_one h]\n    exact (le_abs_self _).trans (abs_third_le_norm y)\n\ntheorem neg_heightRatio_nonneg_of (y : Space) (h : y 2 < 0) : 0 ≤ -heightRatio y := by\n  unfold heightRatio\n  rw [← neg_div]\n  exact div_nonneg (by linarith) (norm_nonneg y)\n\ntheorem neg_heightRatio_le_one (y : Space) : -heightRatio y ≤ 1 := by\n  unfold heightRatio\n  rw [← neg_div]\n  rcases (norm_nonneg y).eq_or_lt with h | h\n  · rw [← h, div_zero]\n    exact zero_le_one\n  · rw [div_le_one h]\n    exact (neg_le_abs _).trans (abs_third_le_norm y)\n\ntheorem index_lt_count (l : List ℝ) (hf : l.head? = some 0) (hl : l.getLast? = some 1) (u : ℝ) :\n    cellIndex l u < cellCount l := by\n  have hle : cellIndex l u ≤ ((l.drop 1).dropLast).length := List.length_filter_le _ _\n  rw [List.length_dropLast, List.length_drop] at hle\n  unfold cellCount\n  rcases l with _ | ⟨a, _ | ⟨b, rest⟩⟩\n  · simp at hf\n  · simp at hf hl\n    linarith\n  · simp only [List.length_cons] at hle ⊢\n    omega\n\ntheorem index_at_zero (l : List ℝ) (hs : l.Pairwise (· < ·)) (hf : l.head? = some 0) :\n    cellIndex l 0 = 0 := by\n  unfold cellIndex\n  rcases l with _ | ⟨a, rest⟩\n  · simp at hf\n  · simp only [List.head?_cons, Option.some.injEq] at hf\n    subst hf\n    rw [List.pairwise_cons] at hs\n    rw [List.length_eq_zero_iff, List.filter_eq_nil_iff]\n    intro c hc\n    have hc' : c ∈ rest := by\n      simpa using List.dropLast_subset _ hc\n    simpa using hs.1 c hc'\n\ntheorem eval_atSecond_zero (t : ℝ) (p : MvPolynomial (Fin 2) ℂ) :\n    MvPolynomial.eval ![(t : ℂ), ((0 : ℝ) : ℂ)] (atSecond 0 p) = MvPolynomial.eval ![(t : ℂ), ((0 : ℝ) : ℂ)] p := by\n  unfold atSecond\n  change MvPolynomial.eval₂Hom (RingHom.id ℂ) ![(t : ℂ), ((0 : ℝ) : ℂ)] _ =\n    MvPolynomial.eval₂Hom (RingHom.id ℂ) ![(t : ℂ), ((0 : ℝ) : ℂ)] _\n  rw [MvPolynomial.eval₂Hom_bind₁]\n  congr 2\n  funext k\n  fin_cases k <;> simp\n\ntheorem halves_agree_on_plane (S : ChartScalar) (hS : IsJoinedScalar 0 S) (t : ℝ) :\n    S.upper.evalHalf t 0 = S.lower.evalHalf t 0 := by\n  unfold Spline.evalHalf\n  rw [index_at_zero _ hS.upper.mesh.x_sorted hS.upper.mesh.x_first,\n    index_at_zero _ hS.lower.mesh.x_sorted hS.lower.mesh.x_first, ← hS.same_t]\n  have hi := index_lt_count _ hS.upper.mesh.t_first hS.upper.mesh.t_last t\n  have hp := hS.plane_joins _ hi 0 le_rfl\n  simp only [xDeriv, Function.iterate_zero, id, pow_zero, map_one, one_mul] at hp\n  rw [← eval_atSecond_zero, hp, eval_atSecond_zero]\n\ntheorem chartT_measurable (P : ChartParams) : Measurable (fun y : Space => chartT P y) := by\n  unfold chartT\n  fun_prop\n\ntheorem heightRatio_measurable : Measurable (fun y : Space => heightRatio y) := by\n  unfold heightRatio\n  fun_prop\n\ntheorem half_measurable (P : ChartParams) (S : Spline) (sgn : ℝ) :\n    Measurable (fun y : Space => (S.evalHalf (chartT P y) (sgn * heightRatio y)).re) := by\n  have h := (CellCert.GivenFields.DualPartsInternal.evalHalf_measurable S).comp\n    ((chartT_measurable P).prodMk (heightRatio_measurable.const_mul sgn))\n  exact Complex.measurable_re.comp h\n\ntheorem values_measurable (P : ChartParams) (M : TensorMesh) (f : ℕ → ℕ → ℝ) (sgn : ℝ) :\n    Measurable (fun y : Space =>\n      f (cellIndex M.tBreaks (chartT P y)) (cellIndex M.xBreaks (sgn * heightRatio y))) := by\n  have hf : Measurable (fun q : ℕ × ℕ => f q.1 q.2) := measurable_of_countable _\n  exact hf.comp (((CellCert.GivenFields.DualPartsInternal.cellIndex_measurable _).comp (chartT_measurable P)).prodMk\n    ((CellCert.GivenFields.DualPartsInternal.cellIndex_measurable _).comp\n      (heightRatio_measurable.const_mul sgn)))\n\nend BasicFactsInternal\n\nopen BasicFactsInternal\n\ntheorem scalarBasicFacts : ScalarBasicFacts := by\n  intro P S hP\n  refine ⟨?_, ?_, ?_⟩\n  · have hu := half_measurable P S.upper 1\n    have hl := half_measurable P S.lower (-1)\n    simp only [one_mul, neg_one_mul] at hu hl\n    have hz : MeasurableSet {y : Space | 0 ≤ y 2} :=\n      measurableSet_le measurable_const (by fun_prop)\n    have hd : Measurable (fun y : Space => (1 - chartT P y) ^ S.decay) :=\n      (measurable_const.sub (chartT_measurable P)).pow_const _\n    exact hd.mul (Measurable.ite hz hu hl)\n  · intro φ y\n    unfold ChartScalar.eval\n    rw [chartT_axialRot, heightRatio_axialRot, axialRot_third]\n  · intro hN y\n    unfold ChartScalar.eval\n    have h0 := chartT_nonneg P hP y\n    have h1 := chartT_lt_one P hP y\n    refine mul_nonneg (pow_nonneg (by linarith) _) ?_\n    split_ifs with h\n    · exact (hN _ _ h0 h1.le (heightRatio_nonneg_of y h) (heightRatio_le_one y)).1\n    · exact (hN _ _ h0 h1.le (neg_heightRatio_nonneg_of y (not_le.mp h)) (neg_heightRatio_le_one y)).2\n\ntheorem stepBasicFacts : StepBasicFacts := by\n  intro P S hP\n  refine ⟨?_, ?_, ?_⟩\n  · have hu := values_measurable P S.mesh S.upper 1\n    have hl := values_measurable P S.mesh S.lower (-1)\n    simp only [one_mul, neg_one_mul] at hu hl\n    have hz : MeasurableSet {y : Space | 0 ≤ y 2} :=\n      measurableSet_le measurable_const (by fun_prop)\n    have hb : Measurable (fun y : Space => 1 - chartT P y) := measurable_const.sub (chartT_measurable P)\n    have hd : Measurable (fun y : Space => (1 - chartT P y) ^ S.decay) := by\n      generalize S.decay = d\n      cases d with\n      | ofNat n =>\n        simp only [Int.ofNat_eq_natCast, zpow_natCast]\n        exact hb.pow_const n\n      | negSucc n =>\n        simp only [zpow_negSucc]\n        exact (hb.pow_const (n + 1)).inv\n    exact hd.mul (Measurable.ite hz hu hl)\n  · intro φ y\n    unfold StepDatum.eval StepDatum.upperValue StepDatum.lowerValue\n    rw [chartT_axialRot, heightRatio_axialRot, axialRot_third]\n  · intro hS y\n    unfold StepDatum.eval StepDatum.upperValue StepDatum.lowerValue\n    have h1 := chartT_lt_one P hP y\n    have ht := index_lt_count _ hS.1.t_first hS.1.t_last (chartT P y)\n    refine mul_pos (zpow_pos (by linarith) _) ?_\n    split_ifs\n    · exact (hS.2 _ _ ht (index_lt_count _ hS.1.x_first hS.1.x_last _)).1\n    · exact (hS.2 _ _ ht (index_lt_count _ hS.1.x_first hS.1.x_last _)).2\n\ntheorem mirrorEval : MirrorEval := by\n  intro P _\n  refine ⟨fun S hS y => ?_, fun S y hy => ?_⟩\n  · unfold ChartScalar.eval ChartScalar.mirror\n    simp only [chartT_flipPoint, heightRatio_flipPoint, flipPoint_third, neg_neg]\n    congr 1\n    rcases lt_trichotomy (y 2) 0 with h | h | h\n    · have h' : 0 ≤ -y 2 := by linarith\n      rw [if_pos h', if_neg (not_le.mpr h)]\n    · have hr : heightRatio y = 0 := by\n        unfold heightRatio\n        rw [h, zero_div]\n      rw [if_pos (by rw [h, neg_zero]), if_pos h.ge, hr, neg_zero, halves_agree_on_plane S hS]\n    · have h' : ¬ (0 ≤ -y 2) := by linarith\n      rw [if_neg h', if_pos h.le]\n  · unfold StepDatum.eval StepDatum.mirror StepDatum.upperValue StepDatum.lowerValue\n    simp only [chartT_flipPoint, heightRatio_flipPoint, flipPoint_third, neg_neg]\n    congr 1\n    rcases lt_or_gt_of_ne hy with h | h\n    · have h' : 0 ≤ -y 2 := by linarith\n      rw [if_pos h', if_neg (not_le.mpr h)]\n    · have h' : ¬ (0 ≤ -y 2) := by linarith\n      rw [if_neg h', if_pos h.le]\n\nend Instance\n\nend CertCell\n\nend Breakdown\n"}