ctral.CellBlock","Breakdown.CellCert.Spectral.liftRad"],"used_by":["Breakdown.CellCert.Spectral.Internal.AxisLift.integrand_meas","Breakdown.CellCert.Spectral.Internal.AxisLiftParts.coef_meas"],"uses":["Breakdown.CellCert.Spectral.CellBlock","Breakdown.CellCert.Spectral.Internal.AxisLiftParts.val_cont","Breakdown.CellCert.Spectral.liftRad"],"written":"rad_meas"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":67,"kind":"theorem","line":65,"module":"Breakdown.FracCell.AxisLiftParts","name":"Breakdown.CellCert.Spectral.Internal.AxisLiftParts.hgt_cont","namespace":"Breakdown.CellCert.Spectral.Internal.AxisLiftParts","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CellCert.Spectral.Internal.AxisLift.integrand_meas","Breakdown.CellCert.Spectral.Internal.AxisLiftParts.coef_meas"],"proof_uses":["Breakdown.CellCert.Spectral.Internal.AxisLiftParts.val_cont"],"protected":false,"short":"hgt_cont","signature_end_line":66,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CellCert.Spectral.CellBlock","Breakdown.CellCert.Spectral.liftHgt"],"used_by":["Breakdown.CellCert.Spectral.Internal.AxisLift.integrand_meas","Breakdown.CellCert.Spectral.Internal.AxisLiftParts.coef_meas"],"uses":["Breakdown.CellCert.Spectral.CellBlock","Breakdown.CellCert.Spectral.Internal.AxisLiftParts.val_cont","Breakdown.CellCert.Spectral.liftHgt"],"written":"hgt_cont"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":82,"kind":"theorem","line":69,"module":"Breakdown.FracCell.AxisLiftParts","name":"Breakdown.CellCert.Spectral.Internal.AxisLiftParts.coef_meas","namespace":"Breakdown.CellCert.Spectral.Internal.AxisLiftParts","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CellCert.Spectral.liftGrad_mode"],"proof_uses":["Breakdown.CellCert.Spectral.Internal.AxisLiftParts.hgt_cont","Breakdown.CellCert.Spectral.Internal.AxisLiftParts.rad_meas","Breakdown.CellCert.Spectral.Internal.AxisLiftParts.val_cont","Breakdown.CellCert.Spectral.liftVal"],"protected":false,"short":"coef_meas","signature_end_line":71,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CellCert.Spectral.CellBlock","Breakdown.CellCert.Spectral.liftCoef"],"used_by":["Breakdown.CellCert.Spectral.liftGrad_mode"],"uses":["Breakdown.CellCert.Spectral.CellBlock","Breakdown.CellCert.Spectral.Internal.AxisLiftParts.hgt_cont","Breakdown.CellCert.Spectral.Internal.AxisLiftParts.rad_meas","Breakdown.CellCert.Spectral.Internal.AxisLiftParts.val_cont","Breakdown.CellCert.Spectral.liftCoef","Breakdown.CellCert.Spectral.liftVal"],"written":"coef_meas"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":89,"kind":"theorem","line":87,"module":"Breakdown.FracCell.AxisLiftParts","name":"Breakdown.CellCert.Spectral.liftGrad_mode","namespace":"Breakdown.CellCert.Spectral","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CellCert.Spectral.axisLift_of_grad"],"proof_uses":["Breakdown.CellCert.Spectral.Internal.AxisLiftParts.coef_meas","Breakdown.CellCert.Spectral.liftCoef"],"protected":false,"short":"liftGrad_mode","signature_end_line":88,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CellCert.Spectral.CellBlock","Breakdown.CellCert.Spectral.ModeGradient","Breakdown.CellCert.Spectral.liftGrad"],"used_by":["Breakdown.CellCert.Spectral.axisLift_of_grad"],"uses":["Breakdown.CellCert.Spectral.CellBlock","Breakdown.CellCert.Spectral.Internal.AxisLiftParts.coef_meas","Breakdown.CellCert.Spectral.ModeGradient","Breakdown.CellCert.Spectral.liftCoef","Breakdown.CellCert.Spectral.liftGrad"],"written":"liftGrad_mode"}],"imports":["Breakdown.FracCell.OnAxisNorm"],"module":"Breakdown.FracCell.AxisLiftParts","path":"Breakdown/FracCell/AxisLiftParts.lean","sha256":"19e7fecd5d8915ff37a1afe2e98040175a3740aa5f64c01c6cd107b37d87d813","source":"import Breakdown.FracCell.OnAxisNorm\n\nopen MeasureTheory Real\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace CellCert\n\nnamespace Spectral\n\nopen SteadyCert Internal.SpectralBlocksMode\n\ndef liftVal (g : CellBlock) (χ : ℝ → ℝ) (v : ℕ → ℝ → ℝ) (r z : ℝ) : ℝ :=\n  χ (r / g.outerRadius) * ∑ j ∈ Finset.range (g.degree + 1), r ^ j * v j z\n\ndef liftRad (g : CellBlock) (χ : ℝ → ℝ) (v : ℕ → ℝ → ℝ) (r z : ℝ) : ℝ :=\n  deriv (fun t => χ (t / g.outerRadius) * ∑ j ∈ Finset.range (g.degree + 1), t ^ j * v j z) r\n\ndef liftHgt (g : CellBlock) (χ : ℝ → ℝ) (v : ℕ → ℝ → ℝ) (r z : ℝ) : ℝ :=\n  χ (r / g.outerRadius) * ∑ j ∈ Finset.range (g.degree + 1), r ^ j * deriv (v j) z\n\ndef liftCoef (g : CellBlock) (χ : ℝ → ℝ) (u : Fin 2 → Fin 3 → ℕ → ℝ → ℝ) (s : Fin 2) (c d : Fin 3) (t : Fin 2)\n    (r z : ℝ) : ℝ :=\n  if t = 0 then\n    (if d = 0 then liftRad g χ (u s c) r z\n      else if d = 2 then liftHgt g χ (u s c) r z\n      else if c = 1 then liftVal g χ (u s 0) r z / r\n      else if c = 0 then -(liftVal g χ (u s 1) r z / r) else 0)\n  else 0\n\ndef liftGrad (g : CellBlock) (χ : ℝ → ℝ) (u : Fin 2 → Fin 3 → ℕ → ℝ → ℝ) (y : Space) : Space →L[ℝ] Space :=\n  ∑ s : Fin 2, Set.indicator (cellSolid g s)\n    (fun w => ∑ c : Fin 3, ∑ d : Fin 3, (∑ t : Fin 2, trigMode t (g.mode * angleCoord w)\n      * liftCoef g χ u s c d t (radialCoord w) (w 2)) • (innerSL ℝ (frameVector d w)).smulRight (frameVector c w)) y\n\ndef LiftGradStatement : Prop :=\n  ∀ (g : CellBlock) (χ : ℝ → ℝ) (u : Fin 2 → Fin 3 → ℕ → ℝ → ℝ) (ψ : Space → Space),\n    g.innerRadius = 0 → g.mode = 0 → 0 < g.outerRadius → g.lowerHeight < g.upperHeight → 0 ≤ g.lowerHeight →\n    χ 1 = 0 → (∃ K, LipschitzWith K χ) → (∀ s c j, ContDiff ℝ 1 (u s c j)) →\n    (∀ s c j, u s c j (if s = 0 then g.lowerHeight else -g.upperHeight) = 0 ∧\n      u s c j (if s = 0 then g.upperHeight else -g.lowerHeight) = 0) →\n    (∀ s c, c ≠ 2 → u s c 0 = 0) →\n    (∀ y, ψ y = ∑ s : Fin 2, Set.indicator (cellSolid g s)\n      (fun w => ∑ c : Fin 3, (χ (radialCoord w / g.outerRadius)\n        * ∑ j ∈ Finset.range (g.degree + 1), radialCoord w ^ j * u s c j (w 2)) • frameVector c w) y) →\n    MemLp ψ 2 volume ∧ AEStronglyMeasurable (liftGrad g χ u) volume ∧\n      Integrable (fun y => entrySq (liftGrad g χ u y)) ∧ IsWeakGradientOf ψ (liftGrad g χ u)\n\nnamespace Internal.AxisLiftParts\n\ntheorem val_cont (g : CellBlock) {χ : ℝ → ℝ} (hχ : Continuous χ) {v : ℕ → ℝ → ℝ} (hv : ∀ j, Continuous (v j)) :\n    Continuous (fun p : ℝ × ℝ => χ (p.1 / g.outerRadius) * ∑ j ∈ Finset.range (g.degree + 1), p.1 ^ j * v j p.2) := by\n  refine (hχ.comp (continuous_fst.div_const _)).mul (continuous_finset_sum _ fun j _ => ?_)\n  exact (continuous_fst.pow j).mul ((hv j).comp continuous_snd)\n\ntheorem rad_meas (g : CellBlock) {χ : ℝ → ℝ} (hχ : Continuous χ) {v : ℕ → ℝ → ℝ} (hv : ∀ j, Continuous (v j)) :\n    Measurable (fun p : ℝ × ℝ => liftRad g χ v p.1 p.2) := by\n  have hc : Continuous (Function.uncurry fun (z t : ℝ) =>\n      χ (t / g.outerRadius) * ∑ j ∈ Finset.range (g.degree + 1), t ^ j * v j z) :=\n    (val_cont g hχ hv).comp continuous_swap\n  exact (measurable_deriv_with_param hc).comp measurable_swap\n\ntheorem hgt_cont (g : CellBlock) {χ : ℝ → ℝ} (hχ : Continuous χ) {v : ℕ → ℝ → ℝ}\n    (hv : ∀ j, ContDiff ℝ 1 (v j)) : Continuous (fun p : ℝ × ℝ => liftHgt g χ v p.1 p.2) :=\n  val_cont g hχ (v := fun j => deriv (v j)) fun j => (hv j).continuous_deriv le_rfl\n\ntheorem coef_meas (g : CellBlock) {χ : ℝ → ℝ} (hχ : Continuous χ) {u : Fin 2 → Fin 3 → ℕ → ℝ → ℝ}\n    (hu : ∀ s c j, ContDiff ℝ 1 (u s c j)) (s : Fin 2) (c d : Fin 3) (t : Fin 2) :\n    Measurable (Function.uncurry (liftCoef g χ u s c d t)) := by\n  have hv : ∀ c j, Continuous (u s c j) := fun c j => (hu s c j).continuous\n  have hval : ∀ c, Measurable (fun p : ℝ × ℝ => liftVal g χ (u s c) p.1 p.2 / p.1) := fun c =>\n    ((val_cont g hχ (hv c)).measurable).div measurable_fst\n  unfold liftCoef\n  split_ifs\n  · exact rad_meas g hχ (hv c)\n  · exact (hgt_cont g hχ (hu s c)).measurable\n  · exact hval 0\n  · exact (hval 1).neg\n  · exact measurable_const\n  · exact measurable_const\n\nend Internal.AxisLiftParts\n\nopen Internal.AxisLiftParts in\ntheorem liftGrad_mode (g : CellBlock) {χ : ℝ → ℝ} (hχ : Continuous χ) {u : Fin 2 → Fin 3 → ℕ → ℝ → ℝ}\n    (hu : ∀ s c j, ContDiff ℝ 1 (u s c j)) : ModeGradient g (liftGrad g χ u) :=\n  ⟨liftCoef g χ u, fun s c d t => coef_meas g hχ hu s c d t, fun _ => rfl⟩\n\nend Spectral\n\nend CellCert\n\nend Breakdown\n"}