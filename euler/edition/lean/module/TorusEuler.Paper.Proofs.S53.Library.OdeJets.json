ed_by":["TorusEuler.Paper.Lib.S53.OdeData.equation_fst","TorusEuler.Paper.Lib.S53.OdeData.hasDeriv_xj","TorusEuler.Paper.Lib.S53.OdeData.xj_symm","TorusEuler.Paper.Lib.S53.odeIdx"],"uses":["TorusEuler.Paper.Lib.S53.OdeData","TorusEuler.Paper.Lib.S53.OdeData.d","TorusEuler.Paper.Lib.S53.OdeData.l","TorusEuler.Paper.Lib.S53.OdeData.p","TorusEuler.Paper.Lib.S53.OdeData.r","TorusEuler.Paper.Lib.S53.OdeData.x","TorusEuler.Paper.Lib.S53.OdeData.xj","TorusEuler.phaseOperatorWord"],"written":"xj_of_mem"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":"Auxiliary fact `aj_of_mem` on the jet spaces of the linear ODE (instance of Lemma D.3).","end_line":93,"kind":"theorem","line":91,"module":"TorusEuler.Paper.Proofs.S53.Library.OdeJets","name":"TorusEuler.Paper.Lib.S53.OdeData.aj_of_mem","namespace":"TorusEuler.Paper.Lib.S53.OdeData","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["TorusEuler.Paper.Lib.S53.OdeData.aj_symm","TorusEuler.Paper.Lib.S53.OdeData.equation_fst","TorusEuler.Paper.Lib.S53.OdeData.zeroOrder","TorusEuler.Paper.Lib.S53.odeIdx"],"proof_uses":[],"protected":false,"short":"aj_of_mem","signature_end_line":92,"sorry":false,"statement_used_by":[],"statement_uses":["TorusEuler.Paper.Lib.S53.OdeData","TorusEuler.Paper.Lib.S53.OdeData.A","TorusEuler.Paper.Lib.S53.OdeData.aj","TorusEuler.Paper.Lib.S53.OdeData.d","TorusEuler.Paper.Lib.S53.OdeData.l","TorusEuler.Paper.Lib.S53.OdeData.p","TorusEuler.Paper.Lib.S53.OdeData.r","TorusEuler.phaseOperatorWord"],"used_by":["TorusEuler.Paper.Lib.S53.OdeData.aj_symm","TorusEuler.Paper.Lib.S53.OdeData.equation_fst","TorusEuler.Paper.Lib.S53.OdeData.zeroOrder","TorusEuler.Paper.Lib.S53.odeIdx"],"uses":["TorusEuler.Paper.Lib.S53.OdeData","TorusEuler.Paper.Lib.S53.OdeData.A","TorusEuler.Paper.Lib.S53.OdeData.aj","TorusEuler.Paper.Lib.S53.OdeData.d","TorusEuler.Paper.Lib.S53.OdeData.l","TorusEuler.Paper.Lib.S53.OdeData.p","TorusEuler.Paper.Lib.S53.OdeData.r","TorusEuler.phaseOperatorWord"],"written":"aj_of_mem"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":"The jets are symmetric under permutations of the derivative words (`xj_symm`).","end_line":106,"kind":"theorem","line":96,"module":"TorusEuler.Paper.Proofs.S53.Library.OdeJets","name":"TorusEuler.Paper.Lib.S53.OdeData.xj_symm","namespace":"TorusEuler.Paper.Lib.S53.OdeData","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":["TorusEuler.Paper.Lib.S53.OdeData.d","TorusEuler.Paper.Lib.S53.OdeData.hx","TorusEuler.Paper.Lib.S53.OdeData.xj_of_mem","TorusEuler.Paper.Lib.S53.contDiff_slabSlice","TorusEuler.phaseOperatorWord_constantDirections_perm"],"protected":false,"short":"xj_symm","signature_end_line":96,"sorry":false,"statement_used_by":[],"statement_uses":["TorusEuler.Paper.Lib.S53.IsSymm","TorusEuler.Paper.Lib.S53.OdeData","TorusEuler.Paper.Lib.S53.OdeData.xj"],"used_by":[],"uses":["TorusEuler.Paper.Lib.S53.IsSymm","TorusEuler.Paper.Lib.S53.OdeData","TorusEuler.Paper.Lib.S53.OdeData.d","TorusEuler.Paper.Lib.S53.OdeData.hx","TorusEuler.Paper.Lib.S53.OdeData.xj","TorusEuler.Paper.Lib.S53.OdeData.xj_of_mem","TorusEuler.Paper.Lib.S53.contDiff_slabSlice","TorusEuler.phaseOperatorWord_constantDirections_perm"],"written":"xj_symm"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":"The jets are symmetric under permutations of the derivative words (`aj_symm`).","end_line":119,"kind":"theorem","line":109,"module":"TorusEuler.Paper.Proofs.S53.Library.OdeJets","name":"TorusEuler.Paper.Lib.S53.OdeData.aj_symm","namespace":"TorusEuler.Paper.Lib.S53.OdeData","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":["TorusEuler.Paper.Lib.S53.OdeData.aj_of_mem","TorusEuler.Paper.Lib.S53.OdeData.d","TorusEuler.Paper.Lib.S53.OdeData.hA","TorusEuler.Paper.Lib.S53.contDiff_slabSlice","TorusEuler.phaseOperatorWord_constantDirections_perm"],"protected":false,"short":"aj_symm","signature_end_line":109,"sorry":false,"statement_used_by":[],"statement_uses":["TorusEuler.Paper.Lib.S53.IsSymm","TorusEuler.Paper.Lib.S53.OdeData","TorusEuler.Paper.Lib.S53.OdeData.aj"],"used_by":[],"uses":["TorusEuler.Paper.Lib.S53.IsSymm","TorusEuler.Paper.Lib.S53.OdeData","TorusEuler.Paper.Lib.S53.OdeData.aj","TorusEuler.Paper.Lib.S53.OdeData.aj_of_mem","TorusEuler.Paper.Lib.S53.OdeData.d","TorusEuler.Paper.Lib.S53.OdeData.hA","TorusEuler.Paper.Lib.S53.contDiff_slabSlice","TorusEuler.phaseOperatorWord_constantDirections_perm"],"written":"aj_symm"}],"imports":["TorusEuler.Paper.Proofs.S53.Library.OdeD3","TorusEuler.Paper.Proofs.S53.Library.OdeTime","TorusEuler.HierarchySourceBounds","TorusEuler.HierarchyProductEstimates"],"module":"TorusEuler.Paper.Proofs.S53.Library.OdeJets","path":"TorusEuler/Paper/Proofs/S53/Library/OdeJets.lean","sha256":"1b9c9e06ecb1eb1a99dd0d8dd03b57ddf5dbe71db979d9026ad8fe87075914f3","source":"import TorusEuler.Paper.Proofs.S53.Library.OdeD3\nimport TorusEuler.Paper.Proofs.S53.Library.OdeTime\nimport TorusEuler.HierarchySourceBounds\nimport TorusEuler.HierarchyProductEstimates\n\n/-!\n# S53 library: the jets of the actual solution as elements of the jet spaces\n-/\n\nopen Set\nopen scoped ContDiff\n\n\nnamespace TorusEuler.Paper.Lib.S53\n\nnoncomputable section\n\nopen TorusEuler\n\n/-- The sum over splits only depends on the terms whose word lengths add up to the word length. -/\ntheorem lsum_congr_len {Idx X : Type} [AddCommMonoid X] (w : List Idx)\n    {F G : List Idx → List Idx → X}\n    (h : ∀ a b, a.length + b.length = w.length → F a b = G a b) : lsum w F = lsum w G := by\n  induction w generalizing F G with\n  | nil =>\n    simp only [lsum]\n    exact h [] [] rfl\n  | cons i w ih =>\n    simp only [lsum]\n    rw [ih (fun a b hab => h (i :: a) b (by simp only [List.length_cons]; omega)),\n      ih (fun a b hab => h a (i :: b) (by simp only [List.length_cons]; omega))]\n\n/-- The data of the linear ODE `x' = A x + f` on `[l, r]` at a fixed point `p`. -/\nstructure OdeData (Idx P E : Type) [NormedAddCommGroup P] [NormedSpace ℝ P] [FiniteDimensional ℝ P]\n    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] where\n  d : Idx → P\n  A : ℝ → P → E →L[ℝ] E\n  f : ℝ → P → E\n  x : ℝ → P → E\n  g : ℝ → ℝ\n  dg : ℝ → ℝ\n  l : ℝ\n  r : ℝ\n  K : ℝ\n  p : P\n  hlr : l < r\n  hA : ContDiffOn ℝ ∞ (Function.uncurry A) (Icc l r ×ˢ (univ : Set P))\n  hf : ContDiffOn ℝ ∞ (Function.uncurry f) (Icc l r ×ˢ (univ : Set P))\n  hx : ContDiffOn ℝ ∞ (Function.uncurry x) (Icc l r ×ˢ (univ : Set P))\n  hxt : ∀ p t, t ∈ Icc l r →\n    HasDerivWithinAt (fun s => x s p) (A t p (x t p) + f t p) (Icc l r) t\n  hg0 : ∀ u ∈ Icc l r, 0 < g u\n  hg : ∀ u ∈ Icc l r, HasDerivWithinAt g (dg u) (Icc l r) u\n  hdg : ContinuousOn dg (Icc l r)\n  hStable : ∀ y : ℝ → E,\n    (∀ u ∈ Icc l r, HasDerivWithinAt y (A u p (y u)) (Icc l r) u) →\n    ∀ u ∈ Icc l r, ∀ v ∈ Icc u r, ‖y v‖ / g v ≤ K * (‖y u‖ / g u)\n\nvariable {Idx P E : Type} [NormedAddCommGroup P] [NormedSpace ℝ P] [FiniteDimensional ℝ P]\n  [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]\n\nnamespace OdeData\n\nvariable (D : OdeData Idx P E)\n\n/-- The slab of the data. -/\ndef slab : Slab where\n  l := D.l\n  r := D.r\n  g := D.g\n  hlr := D.hlr\n  hg0 := D.hg0\n  hgc := fun t ht => (D.hg t ht).continuousWithinAt\n\n/-- The jets `∂^w x(t, p)` of order `≤ n` (zero otherwise and outside the slab). -/\ndef xj (n : ℕ) : List Idx → ℝ → E := fun w t =>\n  if w.length ≤ n ∧ t ∈ Icc D.l D.r then\n    phaseOperatorWord (fun i _ => D.d i) w (D.x t) D.p else 0\n\n/-- The jets `∂^w A(t, p)` of order `≤ n` (zero otherwise and outside the slab). -/\ndef aj (n : ℕ) : List Idx → ℝ → E →L[ℝ] E := fun w t =>\n  if w.length ≤ n ∧ t ∈ Icc D.l D.r then\n    phaseOperatorWord (fun i _ => D.d i) w (D.A t) D.p else 0\n\n/-- Auxiliary fact `xj_of_mem` on the jet spaces of the linear ODE (instance of Lemma D.3). -/\ntheorem xj_of_mem {n : ℕ} {w : List Idx} (hw : w.length ≤ n) {t : ℝ} (ht : t ∈ Icc D.l D.r) :\n    D.xj n w t = phaseOperatorWord (fun i _ => D.d i) w (D.x t) D.p := by\n  simp [xj, hw, ht]\n\n/-- Auxiliary fact `aj_of_mem` on the jet spaces of the linear ODE (instance of Lemma D.3). -/\ntheorem aj_of_mem {n : ℕ} {w : List Idx} (hw : w.length ≤ n) {t : ℝ} (ht : t ∈ Icc D.l D.r) :\n    D.aj n w t = phaseOperatorWord (fun i _ => D.d i) w (D.A t) D.p := by\n  simp [aj, hw, ht]\n\n/-- The jets are symmetric under permutations of the derivative words (`xj_symm`). -/\ntheorem xj_symm (n : ℕ) : IsSymm (D.xj n) := by\n  intro w w' h\n  funext t\n  by_cases ht : t ∈ Icc D.l D.r\n  · by_cases hw : w.length ≤ n\n    · rw [xj_of_mem D hw ht, xj_of_mem D (h.length_eq ▸ hw) ht]\n      exact congrFun (phaseOperatorWord_constantDirections_perm D.d\n        (contDiff_slabSlice D.hx ht) h) D.p\n    · have : ¬ w'.length ≤ n := h.length_eq ▸ hw\n      simp [xj, hw, this]\n  · simp [xj, ht]\n\n/-- The jets are symmetric under permutations of the derivative words (`aj_symm`). -/\ntheorem aj_symm (n : ℕ) : IsSymm (D.aj n) := by\n  intro w w' h\n  funext t\n  by_cases ht : t ∈ Icc D.l D.r\n  · by_cases hw : w.length ≤ n\n    · rw [aj_of_mem D hw ht, aj_of_mem D (h.length_eq ▸ hw) ht]\n      exact congrFun (phaseOperatorWord_constantDirections_perm D.d\n        (contDiff_slabSlice D.hA ht) h) D.p\n    · have : ¬ w'.length ≤ n := h.length_eq ▸ hw\n      simp [aj, hw, this]\n  · simp [aj, ht]\n\nend OdeData\n\nend\n\nend TorusEuler.Paper.Lib.S53\n"}