CP.Algebraic.Hadamard.multiplicativityDefect_apply","PCP.Algebraic.Hadamard.productRejection_le_testRejection","PCP.Algebraic.Hadamard.test_soundness"],"uses":["PCP.Algebraic.BinaryPolynomialSpace.Coefficients","PCP.Algebraic.BinaryPolynomialSpace.coefficients","PCP.Algebraic.BinaryPolynomialSpace.polynomial","PCP.Algebraic.multilinearReduction"],"written":"mixedProduct"},{"dependency_source":"source_text","doc":null,"end_line":75,"kind":"theorem","line":68,"module":"PCP.Algebraic.BinaryPolynomialEmbedding","name":"PCP.Algebraic.BinaryPolynomialSpace.polynomial_mixedProduct","namespace":"PCP.Algebraic.BinaryPolynomialSpace","noncomputable":false,"private":false,"protected":false,"short":"polynomial_mixedProduct","signature_end_line":71,"used_by":["PCP.Algebraic.BinaryPolynomialSpace.evaluate_mixedProduct"],"uses":["PCP.Algebraic.BinaryPolynomialSpace.Coefficients","PCP.Algebraic.BinaryPolynomialSpace.mixedProduct","PCP.Algebraic.BinaryPolynomialSpace.polynomial","PCP.Algebraic.BinaryPolynomialSpace.polynomial_coefficients","PCP.Algebraic.BinaryPolynomialSpace.totalDegree_polynomial_le","PCP.Algebraic.multilinearReduction","PCP.Algebraic.multilinearReduction_isMultilinear","PCP.Algebraic.totalDegree_multilinearReduction_le"],"written":"polynomial_mixedProduct"},{"dependency_source":"source_text","doc":null,"end_line":80,"kind":"theorem","line":77,"module":"PCP.Algebraic.BinaryPolynomialEmbedding","name":"PCP.Algebraic.BinaryPolynomialSpace.evaluate_mixedProduct","namespace":"PCP.Algebraic.BinaryPolynomialSpace","noncomputable":false,"private":false,"protected":false,"short":"evaluate_mixedProduct","signature_end_line":79,"used_by":["PCP.Algebraic.BinaryPolynomialSpace.mixedProduct_add_left","PCP.Algebraic.BinaryPolynomialSpace.mixedProduct_add_right","PCP.Algebraic.Hadamard.testAccepts_encode"],"uses":["PCP.Algebraic.BinaryPolynomialSpace.Coefficients","PCP.Algebraic.BinaryPolynomialSpace.evaluate","PCP.Algebraic.BinaryPolynomialSpace.evaluate_apply","PCP.Algebraic.BinaryPolynomialSpace.mixedProduct","PCP.Algebraic.BinaryPolynomialSpace.polynomial_mixedProduct","PCP.Algebraic.eval_multilinearReduction"],"written":"evaluate_mixedProduct"},{"dependency_source":"source_text","doc":null,"end_line":87,"kind":"theorem","line":82,"module":"PCP.Algebraic.BinaryPolynomialEmbedding","name":"PCP.Algebraic.BinaryPolynomialSpace.mixedProduct_add_left","namespace":"PCP.Algebraic.BinaryPolynomialSpace","noncomputable":false,"private":false,"protected":false,"short":"mixedProduct_add_left","signature_end_line":84,"used_by":["PCP.Algebraic.Hadamard.multiplicativityDefect"],"uses":["PCP.Algebraic.BinaryPolynomialSpace.Coefficients","PCP.Algebraic.BinaryPolynomialSpace.evaluate_mixedProduct","PCP.Algebraic.BinaryPolynomialSpace.evaluation_injective","PCP.Algebraic.BinaryPolynomialSpace.mixedProduct"],"written":"mixedProduct_add_left"},{"dependency_source":"source_text","doc":null,"end_line":94,"kind":"theorem","line":89,"module":"PCP.Algebraic.BinaryPolynomialEmbedding","name":"PCP.Algebraic.BinaryPolynomialSpace.mixedProduct_add_right","namespace":"PCP.Algebraic.BinaryPolynomialSpace","noncomputable":false,"private":false,"protected":false,"short":"mixedProduct_add_right","signature_end_line":91,"used_by":["PCP.Algebraic.Hadamard.multiplicativityDefect"],"uses":["PCP.Algebraic.BinaryPolynomialSpace.Coefficients","PCP.Algebraic.BinaryPolynomialSpace.evaluate_mixedProduct","PCP.Algebraic.BinaryPolynomialSpace.evaluation_injective","PCP.Algebraic.BinaryPolynomialSpace.mixedProduct"],"written":"mixedProduct_add_right"}],"imports":["PCP.Algebraic.BinaryPolynomialProduct"],"module":"PCP.Algebraic.BinaryPolynomialEmbedding","path":"PCP/Algebraic/BinaryPolynomialEmbedding.lean","sha256":"4ca0e259d56cd2251bdb140e9b842e2d7b378bee46eb55f447b98fa36f2152f7","source":"/-\nCopyright (c) 2026 Troy Lee. All rights reserved.\nReleased under Apache 2.0 license as described in the file LICENSE.\nAuthors: Troy Lee\n-/\nimport PCP.Algebraic.BinaryPolynomialProduct\n\n/-!\n# Changing degree bounds for binary polynomial queries\n\nThe inclusions preserve the formal multilinear representative. Products between\ndifferent degree bounds are reduced before taking coefficients, and have the\nexpected pointwise evaluation on the Boolean cube.\n-/\n\nnamespace PCP.Algebraic.BinaryPolynomialSpace\n\nopen MvPolynomial\n\nvariable {t a b c r : ℕ}\n\n/-- Include a query in a larger degree space, padding its coefficients by zero. -/\nnoncomputable def embed (_h : a ≤ b) : Coefficients t a →ₗ[ZMod 2] Coefficients t b where\n  toFun p := coefficients (polynomial t a p)\n  map_add' p q := by ext s; simp [coefficients]\n  map_smul' z p := by ext s; simp [coefficients]\n\n@[simp] theorem polynomial_embed (h : a ≤ b) (p : Coefficients t a) :\n    polynomial t b (embed h p) = polynomial t a p :=\n  polynomial_coefficients _ (polynomial_isMultilinear p)\n    ((totalDegree_polynomial_le p).trans h)\n\n@[simp] theorem evaluate_embed (h : a ≤ b) (x : Fin t → ZMod 2)\n    (p : Coefficients t a) : evaluate x (embed h p) = evaluate x p := by\n  simp only [evaluate_apply, polynomial_embed]\n\ntheorem embed_injective (h : a ≤ b) : Function.Injective (embed (t := t) h) := by\n  intro p q hpq\n  apply polynomial_injective\n  simpa only [polynomial_embed] using congrArg (polynomial t b) hpq\n\n@[simp] theorem embed_refl (p : Coefficients t a) : embed (le_refl a) p = p := by\n  apply polynomial_injective\n  exact polynomial_embed _ p\n\n@[simp] theorem embed_embed (hab : a ≤ b) (hbc : b ≤ c) (p : Coefficients t a) :\n    embed hbc (embed hab p) = embed (hab.trans hbc) p := by\n  apply polynomial_injective\n  simp only [polynomial_embed]\n\n@[simp] theorem embed_constant (h : a ≤ b) (z : ZMod 2) :\n    embed (t := t) h (constant z) = constant z := by\n  apply evaluation_injective\n  funext x\n  simp\n\n@[simp] theorem embed_variableCoeff (h : a ≤ b) (ha : 1 ≤ a) (i : Fin t) :\n    embed h (variableCoeff ha i) = variableCoeff (ha.trans h) i := by\n  apply evaluation_injective\n  funext x\n  simp\n\n/-- A product of queries from two degree spaces, included in a common target space. -/\nnoncomputable def mixedProduct (_h : a + b ≤ r)\n    (p : Coefficients t a) (q : Coefficients t b) : Coefficients t r :=\n  coefficients (multilinearReduction (polynomial t a p * polynomial t b q))\n\ntheorem polynomial_mixedProduct (h : a + b ≤ r)\n    (p : Coefficients t a) (q : Coefficients t b) :\n    polynomial t r (mixedProduct h p q) =\n      multilinearReduction (polynomial t a p * polynomial t b q) := by\n  apply polynomial_coefficients _ (multilinearReduction_isMultilinear _)\n  exact (totalDegree_multilinearReduction_le _).trans\n    ((totalDegree_mul _ _).trans\n      ((Nat.add_le_add (totalDegree_polynomial_le p) (totalDegree_polynomial_le q)).trans h))\n\n@[simp] theorem evaluate_mixedProduct (h : a + b ≤ r) (x : Fin t → ZMod 2)\n    (p : Coefficients t a) (q : Coefficients t b) :\n    evaluate x (mixedProduct h p q) = evaluate x p * evaluate x q := by\n  simp only [evaluate_apply, polynomial_mixedProduct, eval_multilinearReduction, map_mul]\n\ntheorem mixedProduct_add_left (h : a + b ≤ r)\n    (p p' : Coefficients t a) (q : Coefficients t b) :\n    mixedProduct h (p + p') q = mixedProduct h p q + mixedProduct h p' q := by\n  apply evaluation_injective\n  funext x\n  simp only [evaluate_mixedProduct, map_add, add_mul]\n\ntheorem mixedProduct_add_right (h : a + b ≤ r)\n    (p : Coefficients t a) (q q' : Coefficients t b) :\n    mixedProduct h p (q + q') = mixedProduct h p q + mixedProduct h p q' := by\n  apply evaluation_injective\n  funext x\n  simp only [evaluate_mixedProduct, map_add, mul_add]\n\nend PCP.Algebraic.BinaryPolynomialSpace\n"}