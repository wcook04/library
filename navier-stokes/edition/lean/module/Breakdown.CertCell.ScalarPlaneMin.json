ance.BasicFactsInternal.axialRot_norm_eq"],"protected":false,"short":"axialRot_eq_zero_iff","signature_end_line":75,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.Space","Breakdown.axialRot"],"used_by":["Breakdown.CertCell.ScalarShape.chartBoundFacts"],"uses":["Breakdown.CertCell.Instance.BasicFactsInternal.axialRot_norm_eq","Breakdown.Space","Breakdown.axialRot"],"written":"axialRot_eq_zero_iff"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":79,"kind":"theorem","line":78,"module":"Breakdown.CertCell.ScalarPlaneMin","name":"Breakdown.CertCell.ScalarShape.Internal.PlaneMin.flipPoint_eq_zero_iff","namespace":"Breakdown.CertCell.ScalarShape.Internal.PlaneMin","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CertCell.ScalarShape.chartBoundFacts"],"proof_uses":["Breakdown.CertCell.Instance.BasicFactsInternal.flipPoint_norm_eq"],"protected":false,"short":"flipPoint_eq_zero_iff","signature_end_line":78,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CertCell.flipPoint","Breakdown.Space"],"used_by":["Breakdown.CertCell.ScalarShape.chartBoundFacts"],"uses":["Breakdown.CertCell.Instance.BasicFactsInternal.flipPoint_norm_eq","Breakdown.CertCell.flipPoint","Breakdown.Space"],"written":"flipPoint_eq_zero_iff"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":86,"kind":"theorem","line":85,"module":"Breakdown.CertCell.ScalarPlaneMin","name":"Breakdown.CertCell.ScalarShape.planeMinEvalFacts","namespace":"Breakdown.CertCell.ScalarShape","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":["Breakdown.CertCell.ScalarShape.Internal.PlaneMin.planeMinEval_axialRot","Breakdown.CertCell.ScalarShape.Internal.PlaneMin.planeMinEval_flip","Breakdown.CertCell.ScalarShape.Internal.PlaneMin.planeMinEval_measurable"],"protected":false,"short":"planeMinEvalFacts","signature_end_line":85,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CertCell.ScalarShape.PlaneMinEvalFacts"],"used_by":[],"uses":["Breakdown.CertCell.ScalarShape.Internal.PlaneMin.planeMinEval_axialRot","Breakdown.CertCell.ScalarShape.Internal.PlaneMin.planeMinEval_flip","Breakdown.CertCell.ScalarShape.Internal.PlaneMin.planeMinEval_measurable","Breakdown.CertCell.ScalarShape.PlaneMinEvalFacts"],"written":"planeMinEvalFacts"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":100,"kind":"theorem","line":88,"module":"Breakdown.CertCell.ScalarPlaneMin","name":"Breakdown.CertCell.ScalarShape.chartBoundFacts","namespace":"Breakdown.CertCell.ScalarShape","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.CertCell.cellJunctions_of_parts","Breakdown.CertCell.extendedCoerciveClause_of_parts","Breakdown.CertCell.rowRestClause_of_bridge_initial_cellForm","Breakdown.CertCell.rowRestClause_of_parts"],"proof_uses":["Breakdown.CertCell.Instance.BasicFactsInternal.chartT_axialRot","Breakdown.CertCell.Instance.BasicFactsInternal.chartT_flipPoint","Breakdown.CertCell.Instance.BasicFactsInternal.chartT_measurable","Breakdown.CertCell.ScalarShape.ChartBound.eval","Breakdown.CertCell.ScalarShape.ChartBound.originValue","Breakdown.CertCell.ScalarShape.ChartBound.tPower","Breakdown.CertCell.ScalarShape.Internal.PlaneMin.axialRot_eq_zero_iff","Breakdown.CertCell.ScalarShape.Internal.PlaneMin.flipPoint_eq_zero_iff","Breakdown.CertCell.ScalarShape.Internal.PlaneMin.planeMinEval_axialRot","Breakdown.CertCell.ScalarShape.Internal.PlaneMin.planeMinEval_flip","Breakdown.CertCell.ScalarShape.Internal.PlaneMin.planeMinEval_measurable","Breakdown.Space"],"protected":false,"short":"chartBoundFacts","signature_end_line":88,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.CertCell.ScalarShape.ChartBoundFacts"],"used_by":["Breakdown.CertCell.cellJunctions_of_parts","Breakdown.CertCell.extendedCoerciveClause_of_parts","Breakdown.CertCell.rowRestClause_of_bridge_initial_cellForm","Breakdown.CertCell.rowRestClause_of_parts"],"uses":["Breakdown.CertCell.Instance.BasicFactsInternal.chartT_axialRot","Breakdown.CertCell.Instance.BasicFactsInternal.chartT_flipPoint","Breakdown.CertCell.Instance.BasicFactsInternal.chartT_measurable","Breakdown.CertCell.ScalarShape.ChartBound.eval","Breakdown.CertCell.ScalarShape.ChartBound.originValue","Breakdown.CertCell.ScalarShape.ChartBound.tPower","Breakdown.CertCell.ScalarShape.ChartBoundFacts","Breakdown.CertCell.ScalarShape.Internal.PlaneMin.axialRot_eq_zero_iff","Breakdown.CertCell.ScalarShape.Internal.PlaneMin.flipPoint_eq_zero_iff","Breakdown.CertCell.ScalarShape.Internal.PlaneMin.planeMinEval_axialRot","Breakdown.CertCell.ScalarShape.Internal.PlaneMin.planeMinEval_flip","Breakdown.CertCell.ScalarShape.Internal.PlaneMin.planeMinEval_measurable","Breakdown.Space"],"written":"chartBoundFacts"}],"imports":["Breakdown.CertCell.ShapeScalarStatements","Breakdown.CertCell.InstanceBasic"],"module":"Breakdown.CertCell.ScalarPlaneMin","path":"Breakdown/CertCell/ScalarPlaneMin.lean","sha256":"7b6cebc8ea2a2274e47819ad96d2e33a43b5a973afc21c6daef222401ab13d52","source":"import Breakdown.CertCell.ShapeScalarStatements\nimport Breakdown.CertCell.InstanceBasic\n\nopen MeasureTheory\n\nnoncomputable section\n\nnamespace Breakdown\n\nnamespace CertCell\n\nnamespace ScalarShape\n\nopen CellCert.GivenFields (ChartParams chartT heightRatio)\nopen Instance (StepDatum)\nopen Instance.BasicFactsInternal (flipPoint_third flipPoint_norm_eq axialRot_third axialRot_norm_eq\n  chartT_axialRot heightRatio_axialRot chartT_flipPoint heightRatio_flipPoint chartT_measurable values_measurable)\n\nnamespace Internal.PlaneMin\n\ntheorem upperValue_measurable (P : ChartParams) (S : StepDatum) :\n    Measurable (fun y : Space => StepDatum.upperValue P S y) := by\n  have h := values_measurable P S.mesh S.upper 1\n  simp only [one_mul] at h\n  exact h\n\ntheorem lowerValue_measurable (P : ChartParams) (S : StepDatum) :\n    Measurable (fun y : Space => StepDatum.lowerValue P S y) := by\n  have h := values_measurable P S.mesh S.lower (-1)\n  simp only [neg_one_mul] at h\n  exact h\n\ntheorem upperValue_axialRot (P : ChartParams) (S : StepDatum) (φ : ℝ) (y : Space) :\n    StepDatum.upperValue P S (axialRot φ y) = StepDatum.upperValue P S y := by\n  simp only [StepDatum.upperValue, chartT_axialRot, heightRatio_axialRot]\n\ntheorem lowerValue_axialRot (P : ChartParams) (S : StepDatum) (φ : ℝ) (y : Space) :\n    StepDatum.lowerValue P S (axialRot φ y) = StepDatum.lowerValue P S y := by\n  simp only [StepDatum.lowerValue, chartT_axialRot, heightRatio_axialRot]\n\ntheorem mirror_upperValue_flip (P : ChartParams) (S : StepDatum) (y : Space) :\n    StepDatum.upperValue P S.mirror (flipPoint y) = StepDatum.lowerValue P S y := by\n  simp only [StepDatum.upperValue, StepDatum.lowerValue, StepDatum.mirror, chartT_flipPoint,\n    heightRatio_flipPoint]\n\ntheorem mirror_lowerValue_flip (P : ChartParams) (S : StepDatum) (y : Space) :\n    StepDatum.lowerValue P S.mirror (flipPoint y) = StepDatum.upperValue P S y := by\n  simp only [StepDatum.upperValue, StepDatum.lowerValue, StepDatum.mirror, chartT_flipPoint,\n    heightRatio_flipPoint, neg_neg]\n\ntheorem planeMinEval_measurable (P : ChartParams) (S : StepDatum) : Measurable (planeMinEval P S) := by\n  have hd : Measurable (fun y : Space => (1 - chartT P y) ^ S.decay) :=\n    (measurable_const.sub (chartT_measurable P)).pow_const _\n  have h2 : Measurable (fun y : Space => y 2) := by fun_prop\n  have hz : MeasurableSet {y : Space | y 2 = 0} := measurableSet_eq_fun h2 measurable_const\n  have hp : MeasurableSet {y : Space | 0 < y 2} := measurableSet_lt measurable_const h2\n  exact hd.mul (Measurable.ite hz ((upperValue_measurable P S).min (lowerValue_measurable P S))\n    (Measurable.ite hp (upperValue_measurable P S) (lowerValue_measurable P S)))\n\ntheorem planeMinEval_axialRot (P : ChartParams) (S : StepDatum) (φ : ℝ) (y : Space) :\n    planeMinEval P S (axialRot φ y) = planeMinEval P S y := by\n  simp only [planeMinEval, chartT_axialRot, axialRot_third, upperValue_axialRot, lowerValue_axialRot]\n\ntheorem planeMinEval_flip (P : ChartParams) (S : StepDatum) (y : Space) :\n    planeMinEval P S.mirror (flipPoint y) = planeMinEval P S y := by\n  have hd : S.mirror.decay = S.decay := rfl\n  unfold planeMinEval\n  rw [hd, chartT_flipPoint, flipPoint_third, mirror_upperValue_flip, mirror_lowerValue_flip]\n  congr 1\n  rcases lt_trichotomy (y 2) 0 with h | h | h\n  · rw [if_neg (neg_ne_zero.mpr h.ne), if_pos (neg_pos.mpr h), if_neg h.ne, if_neg (not_lt.mpr h.le)]\n  · rw [if_pos (by rw [h, neg_zero]), if_pos h, min_comm]\n  · rw [if_neg (neg_ne_zero.mpr h.ne'), if_neg (not_lt.mpr (neg_nonpos.mpr h.le)), if_neg h.ne', if_pos h]\n\ntheorem axialRot_eq_zero_iff (φ : ℝ) (y : Space) : axialRot φ y = 0 ↔ y = 0 := by\n  rw [← norm_eq_zero, axialRot_norm_eq, norm_eq_zero]\n\ntheorem flipPoint_eq_zero_iff (y : Space) : flipPoint y = 0 ↔ y = 0 := by\n  rw [← norm_eq_zero, flipPoint_norm_eq, norm_eq_zero]\n\nend Internal.PlaneMin\n\nopen Internal.PlaneMin\n\ntheorem planeMinEvalFacts : PlaneMinEvalFacts := fun P S =>\n  ⟨planeMinEval_measurable P S, fun φ y => planeMinEval_axialRot P S φ y, fun y => planeMinEval_flip P S y⟩\n\ntheorem chartBoundFacts : ChartBoundFacts := by\n  intro P B\n  refine ⟨?_, ?_, ?_⟩\n  · have hz : MeasurableSet {y : Space | y = 0} := measurableSet_singleton 0\n    exact Measurable.ite hz measurable_const\n      (((chartT_measurable P).pow_const _).mul (planeMinEval_measurable P B.data))\n  · intro φ y\n    simp only [ChartBound.eval, axialRot_eq_zero_iff, chartT_axialRot, planeMinEval_axialRot]\n  · intro y\n    have hd : B.mirror.data = B.data.mirror := rfl\n    have ht : B.mirror.tPower = B.tPower := rfl\n    have ho : B.mirror.originValue = B.originValue := rfl\n    simp only [ChartBound.eval, flipPoint_eq_zero_iff, chartT_flipPoint, hd, ht, ho, planeMinEval_flip]\n\nend ScalarShape\n\nend CertCell\n\nend Breakdown\n"}