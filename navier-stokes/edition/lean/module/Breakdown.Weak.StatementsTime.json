source":"lean_report","doc":null,"end_line":79,"kind":"def","line":75,"module":"Breakdown.Weak.StatementsTime","name":"Breakdown.WeakProfile.VarConstGood","namespace":"Breakdown.WeakProfile","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"VarConstGood","signature_end_line":75,"sorry":false,"statement_used_by":["Breakdown.WeakProfile.WeakOrbitOfParts","Breakdown.WeakProfile.localMild","Breakdown.WeakProfile.varConstGood_holds"],"statement_uses":["Breakdown.Freq.CSpace","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Space","Breakdown.WeakProfile.BilinIntegrable","Breakdown.WeakProfile.IsGoodSet","Breakdown.WeakProfile.VarConstInner","Breakdown.WeakProfile.varConst"],"used_by":["Breakdown.WeakProfile.WeakOrbitOfParts","Breakdown.WeakProfile.localMild","Breakdown.WeakProfile.varConstGood_holds"],"uses":["Breakdown.Freq.CSpace","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Space","Breakdown.WeakProfile.BilinIntegrable","Breakdown.WeakProfile.IsGoodSet","Breakdown.WeakProfile.VarConstInner","Breakdown.WeakProfile.varConst"],"written":"VarConstGood"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":85,"kind":"def","line":81,"module":"Breakdown.Weak.StatementsTime","name":"Breakdown.WeakProfile.ContinuousVarConst","namespace":"Breakdown.WeakProfile","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"ContinuousVarConst","signature_end_line":81,"sorry":false,"statement_used_by":["Breakdown.WeakProfile.WeakOrbitOfParts","Breakdown.WeakProfile.continuousVarConst_holds","Breakdown.WeakProfile.localMild"],"statement_uses":["Breakdown.Freq.CSpace","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Space","Breakdown.WeakProfile.BilinIntegrable","Breakdown.WeakProfile.varConst"],"used_by":["Breakdown.WeakProfile.WeakOrbitOfParts","Breakdown.WeakProfile.continuousVarConst_holds","Breakdown.WeakProfile.localMild"],"uses":["Breakdown.Freq.CSpace","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Space","Breakdown.WeakProfile.BilinIntegrable","Breakdown.WeakProfile.varConst"],"written":"ContinuousVarConst"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":93,"kind":"def","line":87,"module":"Breakdown.Weak.StatementsTime","name":"Breakdown.WeakProfile.MildFromGood","namespace":"Breakdown.WeakProfile","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"MildFromGood","signature_end_line":87,"sorry":false,"statement_used_by":["Breakdown.WeakProfile.WeakOrbitOfParts","Breakdown.WeakProfile.localMild","Breakdown.WeakProfile.mildFromGood_holds"],"statement_uses":["Breakdown.Freq.CSpace","Breakdown.Freq.IsMildX","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Space","Breakdown.WeakProfile.BilinIntegrable","Breakdown.WeakProfile.varConst"],"used_by":["Breakdown.WeakProfile.WeakOrbitOfParts","Breakdown.WeakProfile.localMild","Breakdown.WeakProfile.mildFromGood_holds"],"uses":["Breakdown.Freq.CSpace","Breakdown.Freq.IsMildX","Breakdown.Freq.L2C","Breakdown.Freq.X","Breakdown.Space","Breakdown.WeakProfile.BilinIntegrable","Breakdown.WeakProfile.varConst"],"written":"MildFromGood"}],"imports":["Breakdown.Weak.StatementsSlice"],"module":"Breakdown.Weak.StatementsTime","path":"Breakdown/Weak/StatementsTime.lean","sha256":"6960959107bc9ab67df836f18dab798868f8574b1d2918a5cfd10cbefefd35b7","source":"import Breakdown.Weak.StatementsSlice\n\nopen MeasureTheory Set Real\nopen scoped ENNReal ContDiff\n\nnoncomputable section\n\nnamespace Breakdown.WeakProfile\n\nopen Freq\n\ndef SliceMeasurable : Prop :=\n  PairingVelocity →\n  ∀ (x : ℝ → X) (W : ℝ → Space → Space) (G : ℝ → Space → (Space →L[ℝ] Space)) (M : ℝ),\n    IsSliceCurve x W G M → AEStronglyMeasurable (fun z : ℝ × Space => W z.1 z.2) volume →\n    AEStronglyMeasurable x volume\n\ndef ScaledTestField : Prop :=\n  ∀ (α : ℝ → ℝ) (s₀ : ℝ) (φ : Space → Space), ContDiff ℝ ∞ α → HasCompactSupport α →\n    IsTestField φ → IsSpaceTimeTestField (scaledTest α s₀ φ)\n\ndef SliceIntegrand : Prop :=\n  PairingVelocity → AdvectionByParts →\n  ∀ (w : X) (f : Space → Space) (g : Space → (Space →L[ℝ] Space)) (C : ℝ), IsSlice f g C →\n    (velocity w : Space → Space) =ᵐ[volume] f →\n    (∀ j, (partialX j w : Space → Space) =ᵐ[volume] gradComponent g j) →\n    ∀ (α : ℝ → ℝ) (s₀ σ : ℝ) (φ : Space → Space), ContDiff ℝ ∞ α → HasCompactSupport α →\n      IsTestField φ →\n      ∫ y, weakSimilarityIntegrand (fun _ => f) (fun _ => g) (scaledTest α s₀ φ) (σ, y) =\n        similarityRate (fun _ => w) α s₀ φ σ\n\ndef SimilarityIdentity : Prop :=\n  SliceIntegrand → ScaledTestField → PairingVelocity → AdvectionByParts →\n  ∀ (x : ℝ → X) (W : ℝ → Space → Space) (G : ℝ → Space → (Space →L[ℝ] Space)) (M C : ℝ),\n    IsSliceCurve x W G M → (∀ s, IsSlice (W s) (G s) C) →\n    (∀ φ, IsSpaceTimeTestField φ →\n      Integrable (weakSimilarityIntegrand W G φ) ∧ ∫ z, weakSimilarityIntegrand W G φ z = 0) →\n    ∀ (α : ℝ → ℝ) (s₀ : ℝ) (φ : Space → Space), ContDiff ℝ ∞ α → HasCompactSupport α →\n      IsTestField φ →\n      Integrable (similarityRate x α s₀ φ) ∧ ∫ σ, similarityRate x α s₀ φ σ = 0\n\ndef PhysicalIdentity : Prop :=\n  PairingDilate → TrilinearDilate →\n  ∀ (x : ℝ → X) (M s₀ : ℝ), (∀ σ, ‖x σ‖ ≤ M) → AEStronglyMeasurable x volume →\n    (∀ (α : ℝ → ℝ) (φ : Space → Space), ContDiff ℝ ∞ α → HasCompactSupport α → IsTestField φ →\n      Integrable (similarityRate x α s₀ φ) ∧ ∫ σ, similarityRate x α s₀ φ σ = 0) →\n    IsTensorWeak (physicalCurve x s₀) (-1) 1\n\ndef ConstOfWeakDeriv : Prop :=\n  ∀ (a b : ℝ → ℝ) (l r : ℝ), l < r → IntegrableOn a (Ioo l r) → IntegrableOn b (Ioo l r) →\n    (∀ θ : ℝ → ℝ, ContDiff ℝ ∞ θ → HasCompactSupport θ → tsupport θ ⊆ Ioo l r →\n      ∫ t, deriv θ t * a t = ∫ t, θ t * b t) →\n    ∃ c : ℝ, ∀ᵐ t ∂(volume.restrict (Ioo l r)), a t = c - ∫ τ in l..t, b τ\n\ndef GoodTimes : Prop :=\n  ConstOfWeakDeriv →\n  ∀ (y : ℝ → X) (l r M : ℝ), l < r → (∀ t ∈ Ioo l r, ‖y t‖ ≤ M) →\n    AEStronglyMeasurable y (volume.restrict (Ioo l r)) → IsTensorWeak y l r →\n    ∃ E, IsGoodSet y l r E\n\ndef BilinIntegrable : Prop :=\n  ∀ (y : ℝ → X) (l r M : ℝ), (∀ t ∈ Ioo l r, ‖y t‖ ≤ M) →\n    AEStronglyMeasurable y (volume.restrict (Ioo l r)) →\n    ∀ t₀ t ε : ℝ, l < t₀ → t₀ ≤ t → t < r → 0 ≤ ε →\n      IntervalIntegrable (fun τ => bilinX (t - τ + ε) (y τ) (y τ)) volume t₀ t\n\ndef VarConstInner : Prop :=\n  BilinIntegrable →\n  ∀ (y : ℝ → X) (l r M : ℝ) (E : Set ℝ), (∀ t ∈ Ioo l r, ‖y t‖ ≤ M) →\n    AEStronglyMeasurable y (volume.restrict (Ioo l r)) → IsGoodSet y l r E →\n    ∀ t₀ ∈ E, ∀ t ∈ E, t₀ ≤ t → ∀ ε : ℝ, 0 < ε → ∀ ψ : X,\n      inner ℝ (y t) (heatX ε ψ) = inner ℝ (y t₀) (heatX (t - t₀ + ε) ψ) +\n        ∫ τ in t₀..t, inner ℝ (bilinX (t - τ + ε) (y τ) (y τ)) ψ\n\ndef VarConstGood : Prop :=\n  BilinIntegrable → VarConstInner →\n  ∀ (y : ℝ → X) (l r M : ℝ) (E : Set ℝ), (∀ t ∈ Ioo l r, ‖y t‖ ≤ M) →\n    AEStronglyMeasurable y (volume.restrict (Ioo l r)) → IsGoodSet y l r E →\n    ∀ t₀ ∈ E, ∀ t ∈ E, t₀ ≤ t → varConst y t₀ t = y t\n\ndef ContinuousVarConst : Prop :=\n  BilinIntegrable →\n  ∀ (y : ℝ → X) (l r M : ℝ), (∀ t ∈ Ioo l r, ‖y t‖ ≤ M) →\n    AEStronglyMeasurable y (volume.restrict (Ioo l r)) →\n    ∀ t₀ ∈ Ioo l r, ContinuousOn (varConst y t₀) (Ico t₀ r)\n\ndef MildFromGood : Prop :=\n  BilinIntegrable →\n  ∀ (y : ℝ → X) (l r M t₀ : ℝ) (E : Set ℝ), (∀ t ∈ Ioo l r, ‖y t‖ ≤ M) →\n    AEStronglyMeasurable y (volume.restrict (Ioo l r)) → E ⊆ Ioo l r →\n    volume (Ioo l r \\ E) = 0 → t₀ ∈ Ioo l r → ContinuousOn (varConst y t₀) (Ico t₀ r) →\n    (∀ t ∈ E, t₀ ≤ t → varConst y t₀ t = y t) →\n    ∀ a b, t₀ ≤ a → a < b → b < r → IsMildX (varConst y t₀) a b\n\nend Breakdown.WeakProfile\n"}