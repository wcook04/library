,"SpinGlass.Targets.section4U_interpolation_slope_lower_bound_of_factor_eq","SpinGlass.Targets.section4U_le_supportingLine","SpinGlass.Targets.section4U_sub_eq_integral","SpinGlass.Targets.section4U_sub_ge_supportingLine","SpinGlass.Targets.section4_endpointQ_le_overlap_of_min","SpinGlass.Targets.section4_overlap_le_endpointQ_of_min","SpinGlass.Targets.section4_terminal_endpointQ_le_overlap_of_min","SpinGlass.Targets.section5InterleavedScalarV_time_zero_lambda_gain_Q","SpinGlass.Targets.section5InterleavedScalarV_time_zero_lambda_gain_of_min","SpinGlass.Targets.section5Interpolation_zero_lambda_gain_Q","SpinGlass.Targets.section5LeftSlope","SpinGlass.Targets.section5LeftSlope_ge_local_of_endpoint_curvature","SpinGlass.Targets.section5LeftSlope_initial_ge_of_endpoint_curvature","SpinGlass.Targets.section5V_baseline_lambda_gain_Q"],"uses":["SpinGlass.Targets.RSBScheme","SpinGlass.Targets.section4VarianceQ"],"written":"section4TVarianceQ"},{"axioms":["Classical.choice","Quot.sound","propext"],"dependency_source":"elaborated","doc":null,"end_line":112,"kind":"theorem","line":109,"module":"Targets.Section4VarianceFactor","name":"SpinGlass.Targets.section4TVarianceD_eq_massGap_mul","namespace":"SpinGlass.Targets","noncomputable":false,"private":false,"proof_used_by":["SpinGlass.Targets.hasDerivAt_section4T_variance_factor"],"proof_uses":["SpinGlass.Targets.section4VarianceD_eq_massGap_mul"],"protected":false,"short":"section4TVarianceD_eq_massGap_mul","signature_end_line":111,"statement_used_by":[],"statement_uses":["SpinGlass.Targets.RSBScheme","SpinGlass.Targets.section4TVarianceD","SpinGlass.Targets.section4TVarianceQ"],"used_by":["SpinGlass.Targets.hasDerivAt_section4T_variance_factor"],"uses":["SpinGlass.Targets.RSBScheme","SpinGlass.Targets.section4TVarianceD","SpinGlass.Targets.section4TVarianceQ","SpinGlass.Targets.section4VarianceD_eq_massGap_mul"],"written":"section4TVarianceD_eq_massGap_mul"},{"axioms":["Classical.choice","Quot.sound","propext"],"dependency_sou