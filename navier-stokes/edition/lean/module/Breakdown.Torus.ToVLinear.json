ic.Lattice","Breakdown.Periodic.Seq","Breakdown.Periodic.V","Breakdown.Periodic.toV","Breakdown.Space","Breakdown.divergenceAt"],"used_by":["Breakdown.Periodic.ApproxClose.Internal.toV_sub_sum","Breakdown.Periodic.ApproxClose.Internal.toV_sum","Breakdown.Periodic.fracApproxClose"],"uses":["Breakdown.Periodic.Coef","Breakdown.Periodic.IsPeriodic","Breakdown.Periodic.Lattice","Breakdown.Periodic.Seq","Breakdown.Periodic.ToVLinear.Internal.coeff_smul","Breakdown.Periodic.ToVLinear.Internal.divergenceAt_smul","Breakdown.Periodic.ToVLinear.Internal.freqTrCoef_smul","Breakdown.Periodic.ToVLinear.Internal.isPeriodic_smul","Breakdown.Periodic.V","Breakdown.Periodic.coefDeriv","Breakdown.Periodic.coeff_injective","Breakdown.Periodic.freqTrSeriesSpec","Breakdown.Periodic.toV","Breakdown.Space","Breakdown.divergenceAt"],"written":"toV_smul"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":85,"kind":"theorem","line":76,"module":"Breakdown.Torus.ToVLinear","name":"Breakdown.Periodic.toVAdd","namespace":"Breakdown.Periodic","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":["Breakdown.Periodic.ApproxClose.Internal.toV_sub_sum","Breakdown.Periodic.ApproxClose.Internal.toV_sum","Breakdown.Periodic.TorusBlowupAssembly.Internal.fracDatumClose_holds","Breakdown.Periodic.breakdownOnTorus_of_profile","Breakdown.Periodic.fracTorusBlowup_holds"],"proof_uses":["Breakdown.Periodic.ToVLinear.Internal.coeff_add","Breakdown.Periodic.ToVLinear.Internal.divergenceAt_add","Breakdown.Periodic.ToVLinear.Internal.freqTrCoef_add","Breakdown.Periodic.ToVLinear.Internal.isPeriodic_add","Breakdown.Periodic.coefDeriv","Breakdown.Periodic.coeff_injective","Breakdown.Periodic.freqTrSeriesSpec","Breakdown.divergenceAt"],"protected":false,"short":"toVAdd","signature_end_line":76,"sorry":false,"statement_used_by":[],"statement_uses":["Breakdown.Periodic.ToVAdd"],"used_by":["Breakdown.Periodic.ApproxClose.Internal.toV_sub_sum","Breakdown.Periodic.ApproxClose.Internal.toV_sum","Breakdown.Periodic.TorusBlowupAssembly.Internal.fracDatumClose_holds","Breakdown.Periodic.breakdownOnTorus_of_profile","Breakdown.Periodic.fracTorusBlowup_holds"],"uses":["Breakdown.Periodic.ToVAdd","Breakdown.Periodic.ToVLinear.Internal.coeff_add","Breakdown.Periodic.ToVLinear.Internal.divergenceAt_add","Breakdown.Periodic.ToVLinear.Internal.freqTrCoef_add","Breakdown.Periodic.ToVLinear.Internal.isPeriodic_add","Breakdown.Periodic.coefDeriv","Breakdown.Periodic.coeff_injective","Breakdown.Periodic.freqTrSeriesSpec","Breakdown.divergenceAt"],"written":"toVAdd"}],"imports":["Breakdown.Torus.StatementsApproxSteps","Breakdown.Torus.FreqTrSeries","Breakdown.Torus.CoefCalculus","Breakdown.Torus.Basic"],"module":"Breakdown.Torus.ToVLinear","path":"Breakdown/Torus/ToVLinear.lean","sha256":"fb535f0c51c4aadae1363e81e5b5d056e4e5ee544f4bec472f985b027e4a8e69","source":"import Breakdown.Torus.StatementsApproxSteps\nimport Breakdown.Torus.FreqTrSeries\nimport Breakdown.Torus.CoefCalculus\nimport Breakdown.Torus.Basic\n\nopen MeasureTheory Set Real\nopen scoped ContDiff\n\nnoncomputable section\n\nnamespace Breakdown.Periodic\n\nnamespace ToVLinear.Internal\n\ntheorem complexify_add (a b : Space) : complexify (a + b) = complexify a + complexify b := by\n  ext i\n  simp [complexify]\n\ntheorem complexify_smul (c : ℝ) (a : Space) : complexify (c • a) = c • complexify a := by\n  ext i\n  simp [complexify, Complex.real_smul]\n\ntheorem freqTrCoef_add {f g : Space → Space} (hf : Continuous f) (hg : Continuous g) (k : Lattice) :\n    freqTrCoef (f + g) k = freqTrCoef f k + freqTrCoef g k := by\n  unfold freqTrCoef\n  rw [← integral_add (FreqTrSeries.Internal.integrableOn_coef hf k)\n    (FreqTrSeries.Internal.integrableOn_coef hg k)]\n  congr 1\n  funext x\n  rw [Pi.add_apply, complexify_add, smul_add]\n\ntheorem freqTrCoef_smul (c : ℝ) (f : Space → Space) (k : Lattice) :\n    freqTrCoef (c • f) k = c • freqTrCoef f k := by\n  unfold freqTrCoef\n  rw [← integral_smul]\n  congr 1\n  funext x\n  rw [Pi.smul_apply, complexify_smul, smul_comm]\n\ntheorem coeff_add (u v : V) (k : Lattice) : coeff (u + v) k = coeff u k + coeff v k := by\n  simp [coeff, smul_add]\n\ntheorem coeff_smul (c : ℝ) (u : V) (k : Lattice) : coeff (c • u) k = c • coeff u k := by\n  rw [coeff, coeff, Submodule.coe_smul, lp.coeFn_smul, Pi.smul_apply, smul_comm]\n\ntheorem isPeriodic_add {f g : Space → Space} (hf : IsPeriodic f) (hg : IsPeriodic g) :\n    IsPeriodic (f + g) := by\n  intro i x\n  simp only [Pi.add_apply, hf i x, hg i x]\n\ntheorem isPeriodic_smul (c : ℝ) {f : Space → Space} (hf : IsPeriodic f) : IsPeriodic (c • f) := by\n  intro i x\n  simp only [Pi.smul_apply, hf i x]\n\ntheorem divergenceAt_add {f g : Space → Space} {x : Space} (hf : DifferentiableAt ℝ f x)\n    (hg : DifferentiableAt ℝ g x) : divergenceAt (f + g) x = divergenceAt f x + divergenceAt g x := by\n  simp only [divergenceAt, fderiv_add hf hg, add_apply, PiLp.add_apply,\n    Finset.sum_add_distrib]\n\ntheorem divergenceAt_smul (c : ℝ) (f : Space → Space) (x : Space) :\n    divergenceAt (c • f) x = c * divergenceAt f x := by\n  simp [divergenceAt, fderiv_const_smul_field, Finset.mul_sum]\n\nend ToVLinear.Internal\n\nopen ToVLinear.Internal\n\ntheorem toV_smul (c : ℝ) {f : Space → Space} (hf : ContDiff ℝ ∞ f) (hp : IsPeriodic f)\n    (hdiv : ∀ x, divergenceAt f x = 0) : toV (c • f) = c • toV f := by\n  have hdc : ∀ x, divergenceAt (c • f) x = 0 := fun x => by rw [divergenceAt_smul, hdiv x, mul_zero]\n  apply coeff_injective\n  intro k\n  rw [(freqTrSeriesSpec coefDeriv (c • f) (hf.const_smul c) (isPeriodic_smul c hp) hdc).1 k, coeff_smul,\n    (freqTrSeriesSpec coefDeriv _ hf hp hdiv).1 k, freqTrCoef_smul]\n\ntheorem toVAdd : ToVAdd := by\n  intro f g hf hg hpf hpg hdf hdg\n  have hd : ∀ x, divergenceAt (f + g) x = 0 := fun x => by\n    rw [divergenceAt_add ((hf.differentiable (by simp)) x) ((hg.differentiable (by simp)) x), hdf x,\n      hdg x, add_zero]\n  apply coeff_injective\n  intro k\n  rw [(freqTrSeriesSpec coefDeriv (f + g) (hf.add hg) (isPeriodic_add hpf hpg) hd).1 k, coeff_add,\n    (freqTrSeriesSpec coefDeriv _ hf hpf hdf).1 k, (freqTrSeriesSpec coefDeriv _ hg hpg hdg).1 k,\n    freqTrCoef_add hf.continuous hg.continuous]\n\nend Breakdown.Periodic\n"}