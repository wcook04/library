tsZeroHeldHolds_of","Breakdown.Cert.extended_certificate_orbit_of_nodes","Breakdown.Cert.extended_normal_orbit_of_nodes","Breakdown.Held.testSetZero","Breakdown.Held.testSetZero_of"],"uses":["Breakdown.Held.testSet"],"written":"TestSetZeroStatement"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":23,"kind":"def","line":21,"module":"Breakdown.Held.Statements","name":"Breakdown.Held.ConvexCompactFixedPointStatement","namespace":"Breakdown.Held","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"ConvexCompactFixedPointStatement","signature_end_line":21,"sorry":false,"statement_used_by":["Breakdown.Held.convexCompactFixedPoint","Breakdown.Held.testSetZero_of"],"statement_uses":[],"used_by":["Breakdown.Held.convexCompactFixedPoint","Breakdown.Held.testSetZero_of"],"uses":[],"written":"ConvexCompactFixedPointStatement"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":35,"kind":"def","line":25,"module":"Breakdown.Held.Statements","name":"Breakdown.Held.AdjointEnclosureStatement","namespace":"Breakdown.Held","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"AdjointEnclosureStatement","signature_end_line":25,"sorry":false,"statement_used_by":["Breakdown.Cert.extendedAdjointEnclosureHolds_of","Breakdown.Cert.extended_certificate_orbit_of_nodes","Breakdown.Cert.extended_normal_orbit_of_nodes","Breakdown.Held.adjointEnclosure"],"statement_uses":[],"used_by":["Breakdown.Cert.extendedAdjointEnclosureHolds_of","Breakdown.Cert.extended_certificate_orbit_of_nodes","Breakdown.Cert.extended_normal_orbit_of_nodes","Breakdown.Held.adjointEnclosure"],"uses":[],"written":"AdjointEnclosureStatement"}],"imports":["Mathlib"],"module":"Breakdown.Held.Statements","path":"Breakdown/Held/Statements.lean","sha256":"5b0ee4fd523a34785fcd2b6e357b02fa61bf14808d962357bdb9124346725d88","source":"import Mathlib\n\nopen Matrix\n\nnoncomputable section\n\nnamespace Breakdown.Held\n\ndef testSet {k : ℕ} (Ja : Finset (Fin k)) (rad s : Fin k → ℝ) (εs : ℝ) : Set (Fin k → ℝ) :=\n  {p | (∀ j ∈ Ja, |p j| ≤ rad j) ∧ ∑ j ∈ Jaᶜ, (s j * p j) ^ 2 ≤ εs ^ 2}\n\ndef TestSetZeroStatement : Prop :=\n  ∀ {k : ℕ} (Ja : Finset (Fin k)) (rad s : Fin k → ℝ) (εs : ℝ) (U : Matrix (Fin k) (Fin k) ℝ)\n    (Φ : (Fin k → ℝ) → Fin k → ℝ),\n    (∀ j ∈ Ja, 0 ≤ rad j) → 0 ≤ εs → (∀ j, s j ≠ 0) → IsUnit U.det →\n    ContinuousOn Φ (testSet Ja rad s εs) →\n    (∀ p ∈ testSet Ja rad s εs, ∀ j ∈ Ja, |(Uᵀ *ᵥ Φ p) j - s j * p j| ≤ |s j| * rad j) →\n    (∀ p ∈ testSet Ja rad s εs, ∑ j ∈ Jaᶜ, ((Uᵀ *ᵥ Φ p) j - s j * p j) ^ 2 ≤ εs ^ 2) →\n    ∃ p ∈ testSet Ja rad s εs, Φ p = 0\n\ndef ConvexCompactFixedPointStatement : Prop :=\n  ∀ {k : ℕ} (K : Set (Fin k → ℝ)), Convex ℝ K → IsCompact K → K.Nonempty →\n    ∀ f : (Fin k → ℝ) → Fin k → ℝ, ContinuousOn f K → Set.MapsTo f K K → ∃ x ∈ K, f x = x\n\ndef AdjointEnclosureStatement : Prop :=\n  ∀ {Y V : Type} [NormedAddCommGroup Y] [InnerProductSpace ℝ Y] [AddCommGroup V] [Module ℝ V]\n    {k : ℕ} (E : V → ℝ) (L : V →ₗ[ℝ] Y) (Q : V → Y) (b : Fin k → Y) (pin : V →ₗ[ℝ] Fin k → ℝ)\n    (ζ : Y) (c : Fin k → ℝ) (u₀ : Fin k → ℝ) (δ l μ r : ℝ),\n    (∀ v, 0 ≤ E v) → 0 < μ → 0 ≤ δ → 0 ≤ l →\n    (∀ v, |inner ℝ (L v) ζ - ∑ j, c j * pin v j| ≤ δ * Real.sqrt (E v)) →\n    ∀ (u : V) (κ : Fin k → ℝ) (R : Y), |inner ℝ (Q u) ζ| ≤ l * E u →\n    L u + ∑ j, κ j • b j + Q u = -R →\n    Real.sqrt (E u + μ ^ 2 * ∑ j, κ j ^ 2) ≤ r →\n    |∑ j, u₀ j * κ j + inner ℝ R ζ + ∑ j, c j * pin u j| ≤\n      l * r ^ 2 + r * Real.sqrt (δ ^ 2 + (∑ j, (inner ℝ (b j) ζ - u₀ j) ^ 2) / μ ^ 2)\n\nend Breakdown.Held\n"}