ler.odd_curl_of_even","TorusEuler.phaseJetBound_scaled_slowCurl"],"uses":["TorusEuler.Vec3","TorusEuler.curlOfDerivative"],"written":"curlOfDerivative_smul"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":"The spatial curl of the affine plane-wave perturbation in §2.1.","end_line":24,"kind":"theorem","line":16,"module":"TorusEuler.WaveCurl","name":"TorusEuler.curl_planeWave","namespace":"TorusEuler","noncomputable":false,"private":false,"proof_used_by":["TorusEuler.initialLocalizedCompletedWave_properties"],"proof_uses":["TorusEuler.coordinateCurl_rankOne","TorusEuler.curlOfDerivative","TorusEuler.curlOfDerivative_smul","TorusEuler.hasFDerivAt_planeWave"],"protected":false,"short":"curl_planeWave","signature_end_line":18,"sorry":false,"statement_used_by":[],"statement_uses":["TorusEuler.Vec3","TorusEuler.cross3","TorusEuler.curl"],"used_by":["TorusEuler.initialLocalizedCompletedWave_properties"],"uses":["TorusEuler.Vec3","TorusEuler.coordinateCurl_rankOne","TorusEuler.cross3","TorusEuler.curl","TorusEuler.curlOfDerivative","TorusEuler.curlOfDerivative_smul","TorusEuler.hasFDerivAt_planeWave"],"written":"curl_planeWave"}],"imports":["TorusEuler.AffineWave","TorusEuler.CurlProjection","TorusEuler.Statement","Mathlib.Tactic.FinCases"],"module":"TorusEuler.WaveCurl","path":"TorusEuler/WaveCurl.lean","sha256":"d75962d6ef64878b050266056be9aa5d52296eab8f91dfb90334327e11be95cc","source":"import TorusEuler.AffineWave\nimport TorusEuler.CurlProjection\nimport TorusEuler.Statement\nimport Mathlib.Tactic.FinCases\n\nopen scoped InnerProductSpace\n\nnamespace TorusEuler\n\ntheorem curlOfDerivative_smul (c : ℝ) (D : Vec3 →L[ℝ] Vec3) :\n    curlOfDerivative (c • D) = c • curlOfDerivative D := by\n  ext i\n  fin_cases i <;> simp [curlOfDerivative, mul_sub]\n\n/-- The spatial curl of the affine plane-wave perturbation in §2.1. -/\ntheorem curl_planeWave (F : ℝ → ℝ) (a k x : Vec3) (dF : ℝ)\n    (hF : HasDerivAt F dF ⟪k, x⟫_ℝ) :\n    curl (fun y => F ⟪k, y⟫_ℝ • a) x = dF • cross3 k a := by\n  rw [curl, (hasFDerivAt_planeWave F a k x dF hF).fderiv]\n  have h : ((dF • innerSL ℝ k).smulRight a) = dF • (innerSL ℝ k).smulRight a := by\n    ext y\n    simp [smul_smul]\n  rw [h, curlOfDerivative_smul]\n  exact congrArg (dF • ·) (coordinateCurl_rankOne a k)\n\nend TorusEuler\n"}