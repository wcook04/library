":18,"sorry":false,"statement_used_by":["Breakdown.expChangeOfVariables_holds","Breakdown.flowOfMild_holds"],"statement_uses":[],"used_by":["Breakdown.expChangeOfVariables_holds","Breakdown.flowOfMild_holds"],"uses":[],"written":"ExpChangeOfVariables"},{"axioms":["propext","Classical.choice","Quot.sound"],"dependency_source":"lean_report","doc":null,"end_line":32,"kind":"def","line":26,"module":"Breakdown.Profile.StatementsFlow","name":"Breakdown.FlowOfMild","namespace":"Breakdown","noncomputable":false,"noncomputable_section":true,"private":false,"proof_used_by":[],"proof_uses":[],"protected":false,"short":"FlowOfMild","signature_end_line":26,"sorry":false,"statement_used_by":["Breakdown.EmbeddedOrbitOfParts","Breakdown.OrbitOfParts","Breakdown.flowOfMild_holds","Breakdown.flowOfMild_unconditional"],"statement_uses":["Breakdown.MildFramework","Breakdown.MildFramework.D","Breakdown.MildFramework.IsMildOnIcc","Breakdown.MildFramework.Ks","Breakdown.MildFramework.S"],"used_by":["Breakdown.EmbeddedOrbitOfParts","Breakdown.OrbitOfParts","Breakdown.flowOfMild_holds","Breakdown.flowOfMild_unconditional"],"uses":["Breakdown.MildFramework","Breakdown.MildFramework.D","Breakdown.MildFramework.IsMildOnIcc","Breakdown.MildFramework.Ks","Breakdown.MildFramework.S"],"written":"FlowOfMild"}],"imports":["Breakdown.Base.Framework"],"module":"Breakdown.Profile.StatementsFlow","path":"Breakdown/Profile/StatementsFlow.lean","sha256":"d3eb602dbae71d62dfa75b20ea68778180acce6080fc5b2172d6f4bfb8ae3dc3","source":"import Breakdown.Base.Framework\n\nopen MeasureTheory Set Real\n\nnoncomputable section\n\nnamespace Breakdown\n\ndef DilateJointContinuous : Prop :=\n  ∀ (X : Type) [NormedAddCommGroup X] [InnerProductSpace ℝ X] [CompleteSpace X]\n    (F : MildFramework X), ContinuousOn (fun p : ℝ × X => F.D p.1 p.2) (Ioi 0 ×ˢ univ)\n\ndef KernelDilate : Prop :=\n  ∀ (X : Type) [NormedAddCommGroup X] [InnerProductSpace ℝ X] [CompleteSpace X]\n    (F : MildFramework X) (a b τ : ℝ) (x : X), 0 < a → 0 < b → 0 < τ →\n    F.D a (F.K (b * τ) (F.D b⁻¹ x) (F.D b⁻¹ x)) = b⁻¹ • F.D (a * b⁻¹) (F.K τ x x)\n\ndef ExpChangeOfVariables : Prop :=\n  ∀ (E : Type) [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]\n    (g : ℝ → E) (s₀ s : ℝ), s₀ < s →\n    IntervalIntegrable g volume 0 (1 - exp (-(s - s₀))) →\n      IntervalIntegrable (fun σ => exp (-(σ - s₀)) • g (1 - exp (-(σ - s₀)))) volume s₀ s ∧\n      ∫ σ in s₀..s, exp (-(σ - s₀)) • g (1 - exp (-(σ - s₀)))\n        = ∫ r in (0 : ℝ)..(1 - exp (-(s - s₀))), g r\n\ndef FlowOfMild : Prop :=\n  ∀ (X : Type) [NormedAddCommGroup X] [InnerProductSpace ℝ X] [CompleteSpace X]\n    (F : MildFramework X) (w u : ℝ → X) (s₀ s : ℝ), s₀ < s →\n    F.IsMildOnIcc u 0 (1 - exp (-(s - s₀))) →\n    (∀ r ∈ Icc 0 (1 - exp (-(s - s₀))), u r = F.D (1 - r)⁻¹ (w (s₀ - Real.log (1 - r)))) →\n      IntervalIntegrable (fun σ => F.Ks (s - σ) (w σ) (w σ)) volume s₀ s ∧\n      w s = F.S (s - s₀) (w s₀) + ∫ σ in s₀..s, F.Ks (s - σ) (w σ) (w σ)\n\nend Breakdown\n"}