:"lean_report","doc":"Run all N complete trial registers under one fixed schedule, retaining\nthe output register and flag register in basis states.","end_line":63,"kind":"def","line":57,"module":"QuarticQuery.Upper.LiftTrials","name":"QuarticQuery.Upper.rawAmpCircuit","namespace":"QuarticQuery.Upper","noncomputable":true,"private":false,"proof_used_by":["QuarticQuery.Upper.ampCircuit_isCirc","QuarticQuery.Upper.ampCircuit_state"],"proof_uses":[],"protected":false,"short":"rawAmpCircuit","signature_end_line":61,"statement_used_by":["QuarticQuery.Upper.ampCircuit","QuarticQuery.Upper.rawAmpCircuit_state"],"statement_uses":["QuarticQuery.Paper.TensorBasis","QuarticQuery.Paper.tensorBasisFintype","QuarticQuery.Paper.tensorPreparation","QuarticQuery.Upper.AmpFlags","QuarticQuery.Upper.AmpRaw","QuarticQuery.Upper.AmpTrial","QuarticQuery.Upper.Reg","QuarticQuery.Upper.ampTrialGate","QuarticQuery.Upper.sigmaOp"],"used_by":["QuarticQuery.Upper.ampCircuit","QuarticQuery.Upper.ampCircuit_isCirc","QuarticQuery.Upper.ampCircuit_state","QuarticQuery.Upper.rawAmpCircuit_state"],"uses":["QuarticQuery.Paper.TensorBasis","QuarticQuery.Paper.tensorBasisFintype","QuarticQuery.Paper.tensorPreparation","QuarticQuery.Upper.AmpFlags","QuarticQuery.Upper.AmpRaw","QuarticQuery.Upper.AmpTrial","QuarticQuery.Upper.Reg","QuarticQuery.Upper.ampTrialGate","QuarticQuery.Upper.sigmaOp"],"written":"rawAmpCircuit"},{"dependency_source":"lean_report","doc":"The very same circuit, with reversible flag marking and routing.\nThe output coordinate still belongs to W=selector×original state.","end_line":75,"kind":"def","line":67,"module":"QuarticQuery.Upper.LiftTrials","name":"QuarticQuery.Upper.ampCircuit","namespace":"QuarticQuery.Upper","noncomputable":true,"private":false,"proof_used_by":["QuarticQuery.Upper.finalB_isCirc","QuarticQuery.Upper.finalB_state"],"proof_uses":[],"protected":false,"short":"ampCircuit","signature_end_line":71,"statement_used_by":["QuarticQuery.Upper.ampCircuit_isCirc","QuarticQuery.Upper.ampCircuit_state","QuarticQuery.Upper.finalB"],"statement_uses":["QuarticQuery.Paper.TensorBasis","QuarticQuery.Paper.tensorBasisFintype","QuarticQuery.Upper.AmpFlags","QuarticQuery.Upper.AmpRaw","QuarticQuery.Upper.AmpTrial","QuarticQuery.Upper.MarkRouteBasis","QuarticQuery.Upper.Reg","QuarticQuery.Upper.RouteData","QuarticQuery.Upper.markWholeGate","QuarticQuery.Upper.rawAmpCircuit","QuarticQuery.Upper.rawToRoute","QuarticQuery.Upper.regCongr","QuarticQuery.Upper.routeFlagsGate"],"used_by":["QuarticQuery.Upper.ampCircuit_isCirc","QuarticQuery.Upper.ampCircuit_state","QuarticQuery.Upper.finalB","QuarticQuery.Upper.finalB_isCirc","QuarticQuery.Upper.finalB_state"],"uses":["QuarticQuery.Paper.TensorBasis","QuarticQuery.Paper.tensorBasisFintype","QuarticQuery.Upper.AmpFlags","QuarticQuery.Upper.AmpRaw","QuarticQuery.Upper.AmpTrial","QuarticQuery.Upper.MarkRouteBasis","QuarticQuery.Upper.Reg","QuarticQuery.Upper.RouteData","QuarticQuery.Upper.markWholeGate","QuarticQuery.Upper.rawAmpCircuit","QuarticQuery.Upper.rawToRoute","QuarticQuery.Upper.regCongr","QuarticQuery.Upper.routeFlagsGate"],"written":"ampCircuit"},{"dependency_source":"lean_report","doc":null,"end_line":102,"kind":"theorem","line":77,"module":"QuarticQuery.Upper.LiftTrials","name":"QuarticQuery.Upper.ampCircuit_isCirc","namespace":"QuarticQuery.Upper","noncomputable":false,"private":false,"proof_used_by":["QuarticQuery.Upper.finalB_isCirc"],"proof_uses":["QuarticQuery.Paper.TensorBasis","QuarticQuery.Paper.tensorBasisFintype","QuarticQuery.Paper.tensorPreparation","QuarticQuery.Paper.tensorPreparation_isCirc","QuarticQuery.Upper.AmpFlags","QuarticQuery.Upper.AmpRaw","QuarticQuery.Upper.IsCirc.congr","QuarticQuery.Upper.IsCirc.post","QuarticQuery.Upper.IsCirc.sigma","QuarticQuery.Upper.ampTrialGate","QuarticQuery.Upper.ampTrialGate_isCirc","QuarticQuery.Upper.markWholeGate","QuarticQuery.Upper.rawAmpCircuit","QuarticQuery.Upper.rawToRoute","QuarticQuery.Upper.regCongr","QuarticQuery.Upper.routeFlagsGate","QuarticQuery.Upper.sigmaOp"],"protected":false,"short":"ampCircuit_isCirc","signature_end_line":82,"statement_used_by":[],"statement_uses":["QuarticQuery.BitInput","QuarticQuery.Upper.AmpTrial","QuarticQuery.Upper.IsCirc","QuarticQuery.Upper.MarkRouteBasis","QuarticQuery.Upper.Reg","QuarticQuery.Upper.RouteData","QuarticQuery.Upper.ampCircuit"],"used_by":["QuarticQuery.Upper.finalB_isCirc"],"uses":["QuarticQuery.BitInput","QuarticQuery.Paper.TensorBasis","QuarticQuery.Paper.tensorBasisFintype","QuarticQuery.Paper.tensorPreparation","QuarticQuery.Paper.tensorPreparation_isCirc","QuarticQuery.Upper.AmpFlags","QuarticQuery.Upper.AmpRaw","QuarticQuery.Upper.AmpTrial","QuarticQuery.Upper.IsCirc","QuarticQuery.Upper.IsCirc.congr","QuarticQuery.Upper.IsCirc.post","QuarticQuery.Upper.IsCirc.sigma","QuarticQuery.Upper.MarkRouteBasis","QuarticQuery.Upper.Reg","QuarticQuery.Upper.RouteData","QuarticQuery.Upper.ampCircuit","QuarticQuery.Upper.ampTrialGate","QuarticQuery.Upper.ampTrialGate_isCirc","QuarticQuery.Upper.markWholeGate","QuarticQuery.Upper.rawAmpCircuit","QuarticQuery.Upper.rawToRoute","QuarticQuery.Upper.regCongr","QuarticQuery.Upper.routeFlagsGate","QuarticQuery.Upper.sigmaOp"],"uses_modules":{"QuarticQuery.BitInput":"QuarticQuery.Statement"},"written":"ampCircuit_isCirc"}],"imports":["QuarticQuery.Upper.OpaqueSlot","QuarticQuery.Upper.GateStateDefs","QuarticQuery.Paper.TensorCoordinates"],"module":"QuarticQuery.Upper.LiftTrials","path":"QuarticQuery/Upper/LiftTrials.lean","sha256":"cb1e800ed8efd9907b86f39b68710ff023825016e0384c7716896361db1da3b3","source":"module\n\npublic import QuarticQuery.Upper.OpaqueSlot\npublic import QuarticQuery.Upper.GateStateDefs\npublic import QuarticQuery.Paper.TensorCoordinates\n\n/-!\nOne globally named, uniform coherent amplifier circuit on the fixed enlarged\nregister. The whole selector+original register is one trial basis W. The\nsuccess predicate tests only its original Z component. The final output\nreassociation into a literal fixed Z subsystem is in a downstream theorem.\n-/\n\n@[expose] public section\n\nnamespace QuarticQuery.Upper\n\nopen QuarticQuery.Paper\n\nabbrev AmpTrial (M : ℕ) (Z : Type) := Σ _ : Fin M, Z\nabbrev AmpFlags (N : ℕ) := Fin N → Bool\nabbrev AmpRaw (N : ℕ) (W : Type) :=\n  Σ _ : AmpFlags N, Σ _ : W, TensorBasis W N\n\ndef rawToRoute {N : ℕ} {W : Type} :\n    AmpRaw N W ≃ MarkRouteBasis N W where\n  toFun p := (p.1, (p.2.1, (tensorCoordEquiv N).toFun p.2.2))\n  invFun p := ⟨p.1, ⟨p.2.1, (tensorCoordEquiv N).symm.toFun p.2.2⟩⟩\n  left_inv p := by cases p with | mk b q => cases q; simp\n  right_inv p := by cases p with | mk b q => cases q; simp\n\nvariable {ι Z : Type} [Fintype Z] [Nonempty ι]\n\n/-- The fixed, label-uniform opaque schedule after a fixed selector gate. -/\nnoncomputable def ampTrialGate {M : ℕ}\n    (V : Reg (Fin M) ≃ₗᵢ[ℂ] Reg (Fin M))\n    (U : Reg Z ≃ₗᵢ[ℂ] Reg Z) (o : Z) (S : Z → Prop) :\n    Reg (AmpTrial M Z) ≃ₗᵢ[ℂ] Reg (AmpTrial M Z) :=\n  (leftOp V).trans (opaquePrefix U o S (fun r a => r < a.val) (M - 1))\n\ntheorem ampTrialGate_isCirc {M n : ℕ}\n    (V : Reg (Fin M) ≃ₗᵢ[ℂ] Reg (Fin M))\n    (F : BitInput ι → Reg Z ≃ₗᵢ[ℂ] Reg Z)\n    (hF : IsCirc n F) (o : Z) (S : Z → Prop) :\n    IsCirc ((2 * (M - 1) + 1) * n)\n      (fun x => ampTrialGate V (F x) o S) := by\n  have hV : IsCirc 0 (fun _ : BitInput ι => leftOp (W := Z) V) := IsCirc.gate _\n  have h := hV.comp (opaquePrefix_isCirc F hF o S\n    (fun (r : ℕ) (a : Fin M) => r < a.val) (M - 1))\n  change IsCirc ((2 * (M - 1) + 1) * n)\n    (fun x => (leftOp V).trans\n      (opaquePrefix (F x) o S (fun (r : ℕ) (a : Fin M) => r < a.val) (M - 1)))\n  simpa only [Nat.zero_add] using h\n\n/-- Run all N complete trial registers under one fixed schedule, retaining\nthe output register and flag register in basis states. -/\nnoncomputable def rawAmpCircuit {M N : ℕ}\n    (V : Reg (Fin M) ≃ₗᵢ[ℂ] Reg (Fin M))\n    (U : Reg Z ≃ₗᵢ[ℂ] Reg Z) (o : Z) (S : Z → Prop) :\n    Reg (AmpRaw N (AmpTrial M Z)) ≃ₗᵢ[ℂ]\n      Reg (AmpRaw N (AmpTrial M Z)) :=\n  sigmaOp fun _ : AmpFlags N => sigmaOp fun _ : AmpTrial M Z =>\n    tensorPreparation (fun _ => ampTrialGate V U o S) N\n\n/-- The very same circuit, with reversible flag marking and routing.\nThe output coordinate still belongs to W=selector×original state. -/\nnoncomputable def ampCircuit {M N : ℕ}\n    (V : Reg (Fin M) ≃ₗᵢ[ℂ] Reg (Fin M))\n    (U : Reg Z ≃ₗᵢ[ℂ] Reg Z) (o : Z) (S : Z → Bool) :\n    Reg (MarkRouteBasis N (AmpTrial M Z)) ≃ₗᵢ[ℂ]\n      Reg (MarkRouteBasis N (AmpTrial M Z)) :=\n  ((regCongr (rawToRoute (N := N) (W := AmpTrial M Z))).symm.trans\n      ((rawAmpCircuit V U o (fun z => S z = true)).trans\n        (regCongr (rawToRoute (N := N) (W := AmpTrial M Z))))).trans\n    (markWholeGate (fun p => S p.2)) |>.trans routeFlagsGate\n\ntheorem ampCircuit_isCirc {M N n : ℕ}\n    (V : Reg (Fin M) ≃ₗᵢ[ℂ] Reg (Fin M))\n    (F : BitInput ι → Reg Z ≃ₗᵢ[ℂ] Reg Z)\n    (hF : IsCirc n F) (o : Z) (S : Z → Bool) :\n    IsCirc (N * ((2 * (M - 1) + 1) * n))\n      (fun x => ampCircuit (N := N) V (F x) o S) := by\n  let q := (2 * (M - 1) + 1) * n\n  have ht : IsCirc q (fun x => ampTrialGate V (F x) o (fun z => S z = true)) :=\n    ampTrialGate_isCirc V F hF o _\n  have hT : IsCirc (N * q) (fun x =>\n      tensorPreparation (fun _ => ampTrialGate V (F x) o (fun z => S z = true)) N) :=\n    tensorPreparation_isCirc\n      (fun _ x => ampTrialGate V (F x) o (fun z => S z = true))\n      (fun _ => ht) N\n  have hRaw : IsCirc (N * q) (fun x =>\n      rawAmpCircuit (N := N) V (F x) o (fun z => S z = true)) := by\n    change IsCirc (N * q) (fun x => sigmaOp fun _ : AmpFlags N =>\n      sigmaOp fun _ : AmpTrial M Z =>\n        tensorPreparation (fun _ => ampTrialGate V (F x) o (fun z => S z = true)) N)\n    exact IsCirc.sigma (fun _ : AmpFlags N =>\n      IsCirc.sigma (fun _ : AmpTrial M Z => hT))\n  have hRoute := hRaw.congr (rawToRoute (N := N) (W := AmpTrial M Z))\n  have hMark := hRoute.post (markWholeGate (fun p : AmpTrial M Z => S p.2))\n  have hFinal := hMark.post (routeFlagsGate (N := N) (Z := AmpTrial M Z))\n  change IsCirc (N * q) (fun x => ampCircuit (N := N) V (F x) o S)\n  exact hFinal\n\nend QuarticQuery.Upper\n"}